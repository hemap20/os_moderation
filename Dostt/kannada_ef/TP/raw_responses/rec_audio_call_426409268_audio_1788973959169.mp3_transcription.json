{"segments":[{"t":"00:00","text":"हाँ"},{"t":"00:05","text":"हेलो"},{"t":"00:06","text":"हाय कैसे हैं आप"},{"t":"00:08","text":"हाय वेयर आर यू फ्रॉम"},{"t":"00:11","text":"आई एम फ्रॉम दिल्ली"},{"t":"00:13","text":"ओह दिल्ली के लिए वार"},{"t":"00:15","text":"यस"},{"t":"00:17","text":"व्हाट डू यू डू"},{"t":"00:19","text":"आई एम स्टडिंग"},{"t":"00:21","text":"यू नो आई लाइक दिल्ली गर्ल्स"},{"t":"00:24","text":"ओके वेयर आर यू फ्रॉम"},{"t":"00:27","text":"आई एम फ्रॉम बैंगलोर"},{"t":"00:30","text":"सो व्हाट डू यू डू"},{"t":"00:32","text":"आई एम वर्किंग एस ए सॉफ्टवेयर इंजीनियर"},{"t":"00:35","text":"ओके ओके"},{"t":"00:37","text":"वेयर डू यू स्टे यू आर स्टेइंग इन होम और हॉस्टल"},{"t":"00:41","text":"होम फ्रॉम द्वारका"},{"t":"00:44","text":"ओके बट यू आर इन दिल्ली"},{"t":"00:49","text":"सो व्हाट आर यू डूइंग हियर"},{"t":"00:52","text":"आई एम स्लीपिंग आई एम डूइंग मास्टर बट यू"},{"t":"00:56","text":"ओके बट व्हाट आर यू डूइंग हियर"},{"t":"1:00","text":"हियर जस्ट आई वांट सम गर्ल टू मेक डेट"},{"t":"1:05","text":"मेक सम सेक्स"},{"t":"1:09","text":"ओके ओके"},{"t":"1:10","text":"सो व्हाट अबाउट यू व्हाई यू केम"}]}