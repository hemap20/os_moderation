{"segments":[{"t":"00:00","text":"हेलो"},{"t":"00:06","text":"क्या हुआ?"},{"t":"00:08","text":"क्या करने लग गई?"},{"t":"00:11","text":"कुछ नहीं"},{"t":"00:14","text":"किस लिए ओढ़ लिया? ऊपर से उतार लो चद्दर को"},{"t":"00:18","text":"अच्छा"},{"t":"00:23","text":"पहले अपना फेस तो दिखाओ यार"},{"t":"00:26","text":"दिखाओ ना, उतारो ना चद्दर"},{"t":"00:30","text":"अपना फेस"},{"t":"00:32","text":"अपना फेस दिखाओ"},{"t":"00:35","text":"फेस भी दिखा देंगे"},{"t":"00:40","text":"अब तो दिखाओ, थोड़ा नीचे करो ना चद्दर को"},{"t":"00:51","text":"चद्दर को नीचे करो ना"},{"t":"00:54","text":"चद्दर तो नीचे हो जाएगी, फेस तो दिखाओ"},{"t":"01:07","text":"सैंडो बनियान पहन रखी है बिल्कुल"},{"t":"01:10","text":"जी"},{"t":"01:17","text":"बड़ी मस्त हो यार आप"},{"t":"01:21","text":"क्या कह रहे हो?"},{"t":"01:23","text":"बड़ी मस्त हो"},{"t":"01:26","text":"थैंक यू"},{"t":"01:33","text":"साइड भी साफ कर रखी है एकदम"},{"t":"01:37","text":"हां"},{"t":"01:39","text":"साइड भी साफ कर रखी है एकदम"},{"t":"01:42","text":"हां"},{"t":"01:48","text":"दिखा दे थोड़ा 32"},{"t":"01:54","text":"क्या कह रहे हो?"},{"t":"01:55","text":"ऐसे नहीं, सैंडो बनियान को नीचे करो ना थोड़ा"},{"t":"02:01","text":"रुक ना एक बार, एक मिनट रुक"}]}