{"segments": [{"t": "00:00", "text": "Hello, hi."}, {"t": "00:03", "text": "Hi, kahan se hai?"}, {"t": "00:05", "text": "Hyderabad se, aap kahan se?"}, {"t": "00:07", "text": "Bangalore, kya karte ho?"}, {"t": "00:10", "text": "Main, main job kar rahi hoon."}, {"t": "00:14", "text": "Kab se job kar rahe ho aap?"}, {"t": "00:18", "text": "Naya hai, just 15-20 days, aap?"}, {"t": "00:24", "text": "Just one day, okay."}, {"t": "00:27", "text": "Okay, okay."}, {"t": "00:29", "text": "Kya job karte ho?"}, {"t": "00:32", "text": "Aapka purpose?"}, {"t": "00:34", "text": "Main bhi job kar raha hoon, no more extra talks."}, {"t": "00:38", "text": "Okay."}, {"t": "00:40", "text": "Aur bataiye."}]}