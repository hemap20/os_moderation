      {
        "t": "07:41",
        "text": "ఉమ్"
      },
      {
        "t": "07:43",
        "text": "నువ్వు అర్థం కాలేదు నీకు"
      },
      {
        "t": "07:49",
        "text": "ఉమ్"
      },
      {
        "t": "07:50",
        "text": "నెంబర్ ఇస్తున్నా ఇస్తా లే"
      },
      {
        "t": "07:53",
        "text": "దేనికి"
      },
