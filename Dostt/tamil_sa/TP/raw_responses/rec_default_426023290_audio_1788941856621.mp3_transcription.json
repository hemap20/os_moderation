{"segments": [{"t": "00:00", "text": "ஹலோ"}, {"t": "00:05", "text": "ஹலோ ஹாய்"}, {"t": "00:07", "text": "சொல்லுங்க"}, {"t": "00:09", "text": "சொல்லுங்க நீங்க எங்கிருந்து பேசுறீங்க"}, {"t": "00:12", "text": "நான் சென்னைங்க நீங்க"}, {"t": "00:14", "text": "நான் கோயம்புத்தூர்"}, {"t": "00:16", "text": "என்ன பண்றீங்க"}, {"t": "00:18", "text": "நான் வொர்க் பண்ணிட்டு இருக்கேன் நீங்க என்ன பண்றீங்க"}, {"t": "00:21", "text": "நான் பிசினஸ் பண்றேன்"}, {"t": "00:26", "text": "எப்படி போகுது லைஃப் எல்லாம்"}, {"t": "00:28", "text": "நல்லா போகுது"}, {"t": "00:31", "text": "வாட்ஸ்அப்ல பேசலாமா இன்ட்ரஸ்டடா"}, {"t": "00:34", "text": "எவ்வளவு"}, {"t": "00:36", "text": "300 ரூபாய்"}]}