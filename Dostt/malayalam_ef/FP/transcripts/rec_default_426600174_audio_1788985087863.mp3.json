  "transcript": {
    "segments": [
      {
        "t": "00:04",
        "text": "ഹലോ"
      },
      {
        "t": "00:06",
        "text": "ഹലോ അസ്സലാമു"
      },
      {
        "t": "00:08",
        "text": "എന്തൊക്കെയുണ്ട് വിശേഷം"
      },
      {
        "t": "00:10",
        "text": "സുഖം കോഴിക്കോട് എവിടെ"
      },
      {
        "t": "00:12",
        "text": "ഞാൻ ഇരിക്കുകയാണ് കട്ടപ്പനയിൽ"
      },
      {
        "t": "00:15",
        "text": "ഓ എന്താ ചെയ്യുന്നത്"
      },
      {
        "t": "00:18",
        "text": "ഞാൻ വർക്ക് ചെയ്യുന്നു ഹോസ്പിറ്റലിലാണ് വർക്ക് ചെയ്യുന്നത്"
      },
      {
        "t": "00:21",
        "text": "കേൾക്കാമോ"
      },
      {
        "t": "00:24",
        "text": "കേൾക്കാം"
      },
      {
        "t": "00:26",
        "text": "ഹലോ"
      },
      {
        "t": "00:28",
        "text": "കുറെ ആയില്ലേ"
      },
      {
        "t": "00:30",
        "text": "ഇല്ല കുറെ ആയില്ല ഒരു മാസം ഒക്കെ ആയി വല്ലപ്പോഴും"
      },
      {
        "t": "00:33",
        "text": "അതുപോലെ കട്ടപ്പനയിൽ"
      },
      {
        "t": "00:35",
        "text": "അപ്പൊ ഫ്രണ്ട്സ് ഒക്കെ ഉണ്ടോ"
      },
      {
        "t": "00:37",
        "text": "ഇല്ല"
      },
      {
        "t": "00:38",
        "text": "എപ്പോഴും കേററില്ലല്ലോ"
      },
      {
        "t": "00:40",
        "text": "അത് ശരി"
      },
      {
        "t": "00:42",
        "text": "എവിടെയാ വീട്ടിലാ"
      },
      {
        "t": "00:44",
        "text": "നാട്ടിലെ ഉള്ളത് ഏതോ"
      },
      {
        "t": "00:47",
        "text": "ഞാൻ നാട്ടിലാണ്"
      },
      {
        "t": "00:50",
        "text": "പിന്നെ"
      },
      {
        "t": "00:52",
        "text": "എന്തൊക്കെയുണ്ട്"
      },
      {
        "t": "00:54",
        "text": "സുഖമായിട്ട് പോകുന്നു"
      },
      {
        "t": "00:55",
        "text": "വീട്ടിലാണോ അപ്പൊ"
      },
      {
        "t": "00:57",
        "text": "വീട്ടിലാ ഉള്ളത്"
      },
      {
        "t": "00:59",
        "text": "ആരൊക്കെയാ ഉള്ളത്"
      },
      {
        "t": "01:01",
        "text": "വീട്ടില് മക്കളുണ്ട് ഞാനുണ്ട്"
      },
      {
        "t": "01:04",
        "text": "അപ്പൊ മാരീഡ് ആണ്"
      },
      {
        "t": "01:07",
        "text": "ഇപ്പൊ ഞാൻ തന്നെ ഉള്ളൂ"
      },
      {
        "t": "01:09",
        "text": "ഹസ്ബൻഡ് ജോലിക്ക് പോയി"
      },
      {
        "t": "01:13",
        "text": "മക്കളോ"
      },
      {
        "t": "01:15",
        "text": "മക്കളൊക്കെ ഉറക്കമാണ്"
      },
      {
        "t": "01:17",
        "text": "ഇപ്പൊ കുറച്ചു വർക്ക് ഉണ്ടായിരുന്നു അതൊക്കെ കഴിഞ്ഞ് ഇങ്ങനെ ഇരിക്കുന്നുള്ളൂ"
      },
      {
        "t": "01:20",
        "text": "ഓ ശരി"
      },
      {
        "t": "01:23",
        "text": "ഉറക്കം വന്നില്ല അപ്പൊ ചുമ്മാ കേറി ഉറങ്ങണം"
      },
      {
        "t": "01:26",
        "text": "ഡ്യൂട്ടി ഉണ്ട് രാവിലെ"
      },
      {
        "t": "01:28",
        "text": "ഞാൻ ഉറങ്ങി എണീറ്റ് വരികയാണ് ഉറക്കം പോയപ്പോൾ കേറി"
      },
      {
        "t": "01:33",
        "text": "എനിക്ക് കുറച്ച് എഴുതാൻ ഉണ്ടായിരുന്നു"
      },
      {
        "t": "01:35",
        "text": "അതൊക്കെ കഴിഞ്ഞപ്പോൾ ഇങ്ങനെ"
      },
      {
        "t": "01:38",
        "text": "ഇന്ന് ഫ്രണ്ട്സിനെ കിട്ടിയ"
      },
      {
        "t": "01:40",
        "text": "ഇല്ലടാ ഇത് കേറുന്നതേ ഉള്ളൂ"
      },
      {
        "t": "01:43",
        "text": "അതല്ല പത്തു മാസമായി എന്ന് പറഞ്ഞില്ലേ"
      },
      {
        "t": "01:46",
        "text": "അല്ലല്ല വൺ മന്ത് ഒരു മാസമായി"
      },
      {
        "t": "01:49",
        "text": "ഒരു മാസമായി"
      },
      {
        "t": "01:51",
        "text": "അത് ശരി"
      },
      {
        "t": "01:53",
        "text": "ഇനി ഫ്രണ്ട്സിനെ കിട്ടിയോ"
      },
      {
        "t": "01:54",
        "text": "എങ്ങനെ"
      },
      {
        "t": "01:57",
        "text": "എന്താ വായുടെ ചവയ്ക്കുന്നേ"
      },
      {
        "t": "02:00",
        "text": "ഒന്നുമില്ല"
      },
      {
        "t": "02:05",
        "text": "ഞാൻ ഒരു ചൂയിംഗം രാത്രി ചവയ്ക്കുകയാണോ"
      },
      {
        "t": "02:09",
        "text": "ഏയ് ചവയ്ക്കാറില്ല"
      },
      {
        "t": "02:11",
        "text": "പിന്നെ"
      },
      {
        "t": "02:12",
        "text": "പിന്നെ"
      },
      {
        "t": "02:13",
        "text": "എന്താ വർക്ക്"
      },
      {
        "t": "02:17",
        "text": "അക്കൗണ്ടന്റ്"
      },
      {
        "t": "02:20",
        "text": "പിന്നെ"
      },
      {
        "t": "02:22",
        "text": "നാളെ ഇല്ലേ"
      },
      {
        "t": "02:24",
        "text": "ഉണ്ട് ഉണ്ട്"
      },
      {
        "t": "02:25",
        "text": "പിന്നെ"
      },
      {
        "t": "02:27",
        "text": "ഫുഡ് ഒക്കെ അടിച്ചോ"
      },
      {
        "t": "02:30",
        "text": "ഓ ഫുഡ് അടിച്ച് കിടന്നു ഞാൻ പിന്നെ എണീറ്റാണ്"
      },
      {
        "t": "02:33",
        "text": "ഒരു ഉറക്കം കഴിഞ്ഞു അല്ലേ"
      },
      {
        "t": "02:35",
        "text": "ആ ഉറക്കം കഴിഞ്ഞു"
      },
      {
        "t": "02:39",
        "text": "പിന്നെ"
      },
      {
        "t": "02:40",
        "text": "പിന്നെ"
      },
      {
        "t": "02:42",
        "text": "പറ"
      },
      {
        "t": "02:43",
        "text": "പറ"
      },
      {
        "t": "02:46",
        "text": "ഇങ്ങനെ കൂട്ടുകാരൊക്കെ കിട്ടിയോ"
      },
      {
        "t": "02:49",
        "text": "ഇല്ലല്ല ഞാൻ അങ്ങനെ ആരെയും"
      },
      {
        "t": "02:52",
        "text": "സംസാരിക്കു അത്രയേ ഉള്ളൂ"
      },
      {
        "t": "02:57",
        "text": "ഇന്ന് ഫസ്റ്റ് കോള"
      },
      {
        "t": "03:00",
        "text": "ആ ഫസ്റ്റ് കോള"
      },
      {
        "t": "03:04",
        "text": "എന്തൊക്കെയാ സംസാരിക്കാറ്"
      },
      {
        "t": "03:07",
        "text": "എന്താ സംസാരിക്കാറ് വർത്തമാനം പറഞ്ഞിരിക്കും"
      },
      {
        "t": "03:10",
        "text": "അല്ലെങ്കിൽ എന്തെങ്കിലും സംസാരിച്ചുകൊണ്ടിരിക്കും"
      },
      {
        "t": "03:14",
        "text": "എന്തോ"
      },
      {
        "t": "03:18",
        "text": "എന്താ സംസാരിച്ചുകൊണ്ടിരിക്കാറ്"
      },
      {
        "t": "03:20",
        "text": "എനിക്ക് ഇഷ്ടമാ"
      },
      {
        "t": "03:22",
        "text": "എനിക്ക് അങ്ങനെ ഒന്നുമില്ല ഞാൻ സംസാരിക്കാറില്ല"
      },
      {
        "t": "03:25",
        "text": "എനിക്ക്"
      },
      {
        "t": "03:27",
        "text": "കുറച്ചുപേർ ഇങ്ങനെ ചോദിക്കും നോർമൽ കോൾ ആണോ ഓപ്പൺ ടോക്ക് ആണോ അങ്ങനെയൊക്കെ ചോദിക്കും"
      },
      {
        "t": "03:32",
        "text": "പിന്നെ നമ്മൾ ചിലപ്പോൾ മൂഡ് പോലെ സംസാരിക്കും"
      },
      {
        "t": "03:35",
        "text": "ഇല്ല ഓപ്പൺ ടോക്ക് ഒന്നും ഞാൻ സംസാരിച്ചിട്ടില്ല"
      },
      {
        "t": "03:38",
        "text": "സംസാരിക്കും എന്റെ ഫ്രണ്ട്ലി ആയിട്ട് സംസാരിക്കും"
      },
      {
        "t": "03:43",
        "text": "ഓപ്പൺ ടോക്ക് ചെയ്തിട്ടില്ല അപ്പൊ ഇതില്"
      },
      {
        "t": "03:45",
        "text": "ഓപ്പൺ ടോക്ക് അങ്ങനെ ചെയ്തിട്ടില്ല ഞാൻ ഇങ്ങനെ ഓരോരുത്തരും"
      },
      {
        "t": "03:49",
        "text": "പറഞ്ഞൊക്കെ പറയുന്നതൊക്കെ കേട്ടോണ്ടൊക്കെ ഇരുന്നിട്ടുണ്ട്"
      },
      {
        "t": "03:52",
        "text": "അതായത്"
      },
      {
        "t": "03:54",
        "text": "കപ്പിൾസ് ഒക്കെ ആയിട്ടൊക്കെ ഇങ്ങനെ"
      },
      {
        "t": "03:57",
        "text": "അതൊക്കെ ഇങ്ങനെ കേട്ടോണ്ടിരുന്നിട്ടുണ്ട്"
      },
      {
        "t": "03:59",
        "text": "അല്ലാതെ"
      },
      {
        "t": "04:01",
        "text": "വേറൊന്നുമില്ല"
      },
      {
        "t": "04:03",
        "text": "അത് ശരി"
      },
      {
        "t": "04:05",
        "text": "പിന്നെ"
      },
      {
        "t": "04:07",
        "text": "പറ"
      },
      {
        "t": "04:09",
        "text": "ഇപ്പൊ ഒക്കെ ഇപ്പൊ ഈ ഡ്യൂട്ടി ഒക്കെ കഴിഞ്ഞു വരുന്നവരൊക്കെ ഉണ്ട് പുറത്തൊക്കെ ഉള്ളവരൊക്കെ"
      },
      {
        "t": "04:15",
        "text": "അപ്പൊ അങ്ങനെയുള്ളവരുടെ ഒക്കെ സംസാരിക്കാൻ എനിക്ക് ഇഷ്ടമാണ്"
      },
      {
        "t": "04:19",
        "text": "അങ്ങനെ"
      },
      {
        "t": "04:21",
        "text": "ആ"
