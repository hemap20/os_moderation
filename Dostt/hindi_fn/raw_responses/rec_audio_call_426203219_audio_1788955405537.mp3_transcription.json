{"segments":[{"t":"00:00","text":"हेलो।"},{"t":"00:02","text":"हेलो, क्या हाल है?"},{"t":"00:04","text":"हाल सब बढ़िया है, आपका क्या हाल है?"},{"t":"00:07","text":"बस बढ़िया, कहाँ से हो आप?"},{"t":"00:10","text":"लखनऊ से।"},{"t":"00:12","text":"ओके।"},{"t":"00:14","text":"और सुनाओ क्या कर रहे हो?"},{"t":"00:16","text":"क्या?"},{"t":"00:17","text":"क्या कर रहे हो?"},{"t":"00:19","text":"कॉलेज।"},{"t":"00:21","text":"ओके।"},{"t":"00:22","text":"जी, आप कहाँ से?"},{"t":"00:24","text":"मैं पंजाब, लुधियाना से।"},{"t":"00:28","text":"अच्छा, आप क्या करते हो?"},{"t":"00:30","text":"वेल्ले।"},{"t":"00:32","text":"क्या?"},{"t":"00:33","text":"वेल्ले।"}]}