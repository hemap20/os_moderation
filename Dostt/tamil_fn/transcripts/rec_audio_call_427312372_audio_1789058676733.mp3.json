      {
        "t": "00:49",
        "text": "ஹலோ"
      },
      {
        "t": "00:51",
        "text": "அவர் சொல்ல மாட்டாரா?"
      },
      {
        "t": "00:54",
        "text": "தெரியாம தான் பண்றேன்."
      },
      {
        "t": "00:56",
        "text": "ஏன் பண்ணலையா அவரு?"
      },
      {
        "t": "01:02",
        "text": "வெயிட்டா இருக்காரா?"
