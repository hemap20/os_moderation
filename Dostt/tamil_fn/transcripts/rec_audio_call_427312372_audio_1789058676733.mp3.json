      {
        "t": "00:00",
        "text": "ஹலோ"
      },
      {
        "t": "00:06",
        "text": "என்ன சொல்றீங்க?"
      },
      {
        "t": "00:08",
        "text": "என்ன பண்றீங்க?"
      },
      {
        "t": "00:10",
        "text": "ஆ சரி பண்றேன்."
      },
      {
        "t": "00:12",
        "text": "ஓகே ஓகே எங்கன்னு பேசுறீங்க?"
      },
      {
        "t": "00:15",
        "text": "என்ன?"
      },
      {
        "t": "00:17",
        "text": "ஓகே ஓகே"
      },
      {
        "t": "00:20",
        "text": "அப்புறம் சாப்பிட்டாச்சா?"
      },
      {
        "t": "00:25",
        "text": "சாப்பிட்டாச்சா?"
      },
      {
        "t": "00:26",
        "text": "சாப்பிட்டேன்."
      },
      {
        "t": "00:29",
        "text": "மிஸ் பண்ணல எப்படி இருக்காரு?"
      },
      {
        "t": "00:32",
        "text": "நல்லா இருக்காரா?"
      },
      {
        "t": "00:36",
        "text": "மிஸ் பண்ணி தெரியுமா போன் யூஸ் பண்றது எல்லாம்?"
      },
      {
        "t": "00:39",
        "text": "தெரியாது."
      },
      {
        "t": "00:40",
        "text": "தெரியாம போன் யூஸ் பண்ணிட்டு இருக்கீங்களா?"
      },
      {
        "t": "00:45",
        "text": "ம்ம்"
