{"segments": [{"t": "00:00", "text": "ஹலோ"}, {"t": "00:05", "text": "ஹலோ"}, {"t": "00:07", "text": "துளசி"}, {"t": "00:09", "text": "ம்"}, {"t": "00:12", "text": "எப்படி இருக்கீங்க?"}, {"t": "00:14", "text": "ம்?"}, {"t": "00:15", "text": "எப்படி இருக்கீங்க?"}, {"t": "00:17", "text": "சூப்பரா இருக்கேன்."}, {"t": "00:19", "text": "நீங்க எப்படி இருக்கீங்க?"}, {"t": "00:21", "text": "எந்த ஊரு?"}, {"t": "00:23", "text": "சென்னை."}, {"t": "00:25", "text": "சென்னை?"}, {"t": "00:26", "text": "ம்."}, {"t": "00:27", "text": "நான் திருப்பூர்."}, {"t": "00:32", "text": "ம்."}, {"t": "00:33", "text": "சென்னையில என்ன பண்றீங்க?"}, {"t": "00:34", "text": "ஹவுஸ் வைஃப். ரெண்டு பசங்க இருக்காங்க."}, {"t": "00:38", "text": "ரெண்டு பசங்க இருக்காங்க, எனக்கு 35 வயசு ஆகுது."}, {"t": "00:44", "text": "ம்."}, {"t": "00:46", "text": "உங்க ஹஸ்பண்ட் என்ன பண்றாப்ல?"}, {"t": "00:48", "text": "அவரு கன்ஸ்ட்ரக்ஷன் வேலை."}, {"t": "00:50", "text": "ம்."}, {"t": "00:55", "text": "வேலைக்கு போயிட்டாரா?"}, {"t": "00:56", "text": "ம்."}, {"t": "00:58", "text": "நீங்க வேலை பாக்கலையா?"}, {"t": "1:00", "text": "ம்ஹும்."}, {"t": "1:01", "text": "ஏன்?"}]}