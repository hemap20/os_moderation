    {
      "t": "00:00",
      "text": "ஹலோ, மை"
    },
    {
      "t": "00:00",
      "text": "ஹலோ, நீங்க டீச்சிட்றீங்க?"
    },
    {
      "t": "00:00",
      "text": "நான் சென்னை-யா நின்னை?"
    },
    {
      "t": "00:00",
      "text": "நான் போயன் நாட்டு."
    },
    {
      "t": "00:00",
      "text": "ம்ம், நான் பண்றேன்."
    },
    {
      "t": "00:00",
      "text": "ஆ, ஹோர் கூட, ட்ரெய்னிங் என்ன பண்றீங்க?"
    },
    {
      "t": "00:00",
      "text": "ம்ம், நான் பிசினஸ் பண்றேன்."
    },
    {
      "t": "00:00",
      "text": "இது ஃபார் லைஃப் லாங்."
    },
