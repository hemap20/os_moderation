      "text": "ஹலோ"
    },
    {
      "t": "00:06",
      "text": "என்ன பண்றீங்க?"
    },
    {
      "t": "00:08",
      "text": "நல்லா இருக்கேன் நீங்க?"
    },
    {
      "t": "00:09",
      "text": "ஆ வேலூர் என்ன பண்றீங்க?"
    },
    {
      "t": "00:12",
      "text": "ஸ்டேட்டஸ் மட்டும் பார்த்துட்டு வெயிட்ல இருக்கேன்."
    },
    {
      "t": "00:14",
      "text": "வீடியோ கால்ல வருவீங்களா?"
    },
    {
      "t": "00:17",
      "text": "எஸ் சார்."
    },
    {
      "t": "00:19",
      "text": "ஓகே ஜி வீடியோ கால்ல வரீங்களா?"
    },
    {
      "t": "00:27",
      "text": "என்ன செக்ஸ் டாபிக்கா?"
    },
    {
      "t": "00:31",
      "text": "உங்களுக்கு பிடிக்காதா?"
    },
    {
      "t": "00:34",
      "text": "நான் ஒன்லி பே அண்ட் சர்வீஸ் மட்டும்தாங்க எடுப்பேன் வீடியோ கால் சர்வீஸ் இந்த மாதிரி பேச எல்லாம் மாட்டேன் தயவு செஞ்சு இந்த மாதிரி பேசலாம் பேசலாம்னு வராதீங்க."
    },
    {
      "t": "00:40",
      "text": "வீடியோ கால்."
    }
  ]
