    {
      "t": "11:54",
      "text": "ಹ್ಮ್ ಮಾಡಬಾರದು ಅವಾಗೆಲ್ಲ ಪಾಪು ಇರುತ್ತಲ್ಲ ಮಾಡಬಾರದು"
    },
    {
      "t": "11:58",
      "text": "ಅದಕ್ಕೆ ಏನಾಗುತ್ತೆ ರೀ"
    },
    {
      "t": "12:01",
      "text": "ಏನಪ್ಪಾ ಗೊತ್ತಿಲ್ಲ ಯಾಕೆ ಸುಮ್ನೆ ರಿಸ್ಕ್"
    },
    {
      "t": "12:04",
      "text": "ಏ ರಿಸ್ಕ್ ಅಂತ ಏನ್ರೀ ನೀವು ಇವಾಗ ಮಾಡಿದ್ರೆ ಅದು ಮಗು ಬರೋದಿದ್ದಾರೆ"
    },
    {
      "t": "12:09",
      "text": "ಏನ್ ಬಾರಿ ಎಕ್ಸ್ಪೀರಿಯನ್ಸ್ ಇದ್ದಂಗೆ ಹೇಳ್ತೀರಿ ನೀವು"
    },
    {
      "t": "12:13",
      "text": "ಅಂದ್ರೆ ಬಿಕಾಂ ಅಲ್ಲ ಸ್ವಲ್ಪ ಅಲ್ಪ ಸ್ವಲ್ಪ ಅಕೌಂಟ್ ಕಲಿತರೆ ಇನ್ನೊಂದು ಸ್ವಲ್ಪ"
    },
    {
      "t": "12:20",
      "text": "ಅದು ಔಟ್ ಸೈಡ್ ನಾಲೆಡ್ಜ್ ಗೊತ್ತಿರುತ್ತೆ ಅಂತ"
    },
    {
      "t": "12:25",
      "text": "ಯಾರನ್ನ ಫ್ರೆಂಡ್ ಮಾಡ್ಸ್ಕೊಂಡಿದ್ದೀರಾ"
    },
    {
      "t": "12:28",
      "text": "ಇಲ್ಲರೀ"
    },
    {
      "t": "12:31",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "12:32",
      "text": "ಮಾಡ್ಕೋಬೇಕಂದ್ರೆ ಅದು ನನ್ನ ತಾಳಿ ಕಟ್ಟಿದ ಗಂಡನ ಹತ್ರ ಮಾತ್ರ"
    },
    {
      "t": "12:37",
      "text": "ಬೇರೆ ಯಾವ ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "12:40",
      "text": "ಏ ಬೇಡರೀ ಪವಿತ್ರವಾದದ್ದು ಸ್ಥಳ ಅದು"
    },
    {
      "t": "12:44",
      "text": "ಏನಾಗುತ್ತೆ ಕ್ಯಾಶುವಲ್ ಆಗಿ"
    },
    {
      "t": "12:47",
      "text": "ಏ ಕ್ಯಾಶುವಲ್ ಆಗಿ ಮಾಡಿದ್ರೆ ಅದನ್ನೇ ಎಲ್ಲದರಿಂದ ಮಾಡಿದ್ರು ಅದಕ್ಕೆ ಏನ್ರೀ ಇದು ಓಡಿತಿದ್ದಿ"
    },
    {
      "t": "12:53",
      "text": "ಓನ್ಲಿ ಅದು ಮದುವೆ ಆಗಿದ್ದ ಗಂಡನಿಗೆ ಮಾತ್ರ ಸೀಮಿತ"
    },
    {
      "t": "12:57",
      "text": "ನನಗೇನಿಲ್ಲ"
    },
    {
      "t": "13:00",
      "text": "ಏ ಇಲ್ಲರೀ"
    },
    {
      "t": "13:03",
      "text": "ಅದು ಇಲ್ಲ ಅಂತೀರಾ"
    },
    {
      "t": "13:05",
      "text": "ಅಂದ್ರೆ ಡ್ರೆಸ್ ಹಾಕೊಂಡಾಗ ಮೇಲೆ ಎಕ್ಸ್ಪೋಸ್ ಆಗುತ್ತೆ ಹಾಗಂತ ಒಂದು ಅವರ ಕೈಗೆಲ್ಲ ಕೊಡಕಾಗುತ್ತಾ"
    },
    {
      "t": "13:14",
      "text": "ಹೌದು"
    },
    {
      "t": "13:16",
      "text": "ಸ್ವಲ್ಪ ಮುಖ ತೋರಿಸಿರಿ ಮುಖ ತೋರಿಸಿರಿ ಇಲ್ಲ ವಾಟ್ಸಪ್ ನ ಬರ್ತೀರಾ"
    },
    {
      "t": "13:19",
      "text": "ವಾಟ್ಸಪ್ ಗೆ ಬರ್ತಿದ್ದೆ ಬಟ್ ನೀವೇನು ಮುಖ ತೋರಿಸಿ ತೋರಿಸಿ ಹೇಗೆ ಪೋಸ್ ಮಾಡ್ತೀರಾ ಮಾತಾಡಲಿಕ್ಕೆ ಮುಗಿತಾ ಇಂಟರೆಸ್ಟ್ ಮುಗಿತಾ"
    },
    {
      "t": "13:28",
      "text": "ಇಂಟರೆಸ್ಟ್ ಅಂತ ಅಂದ್ರೆ ಅಟ್ಲೀಸ್ಟ್ ಫೇಸ್ ಟು ಫೇಸ್ ಮಾತಾಡ್ಕೊಂಡ್ರೆ ನಮಗೂ ಒಂತರ ಮೂಡ್ ಬರ್ತೈತಿ"
    },
    {
      "t": "13:34",
      "text": "ಫೇಸ್ ತೋರಿಸಿ ಮಾತಾಡೋದು ಯಾಕೋ ಡೇಂಜರ್ ಅಂತ"
    },
    {
      "t": "13:41",
      "text": "ಅದರಲ್ಲಿ ಏನೈತ್ರಿ ಅಟ್ಲೀಸ್ಟ್ ನೀವು ಮಾತಾಡ್ತೀರಿ ನಾನು ಇಲ್ಲಿರ್ತೀನಿ ಅಟ್ಲೀಸ್ಟ್ ನಮಗೂ ಯಾರ ಜೊತೆ ಮಾತಾಡಕತ್ತೀವಿ ಅನ್ಸುತ್ತೆ ಇದು ಒಳ್ಳೆ ಕತ್ತಲಾಗ ನಾನು ಏನೋ ಮಾತಾಡಕತ್ತೀನಿ ನಾನು ಯಾರ ಜೊತೆ ಮಾತಾಡಕತ್ತೀನಿ ಅಂತ ಗೊತ್ತಾಗಲ್ಲ ಹಂಗೆ ಅನ್ಸುತ್ತೆ"
    },
    {
      "t": "13:54",
      "text": "ನಾನು ಹುಡುಗಿನೇ ತಾನೇ ಮಾತಾಡ್ತಿರೋದು"
    },
    {
      "t": "13:57",
      "text": "ಕರೆಕ್ಟ್ ರೀ ಹಂಗೆ ಜಸ್ಟ್ ಒಂದು ಸಲ ಆಗಲೇ ತೋರಿಸಿದ್ರಲ್ಲ ಹಂಗೆ ಹಿಡ್ಕೊಂಡು ತೋರಿಸ್ತಾರಲ್ಲ ಮಾತಾಡೋದು ಏನಾಗುತ್ತೆ"
    },
    {
      "t": "14:02",
      "text": "ಇವಾಗ ಏನು ನಿಮ್ಮ ಹತ್ರ ಬರಬೇಕಾ ನಾನು"
    },
    {
      "t": "14:05",
      "text": "ಹ್ಮ್ ಬಾ"
    },
    {
      "t": "14:07",
      "text": "ಅಲ್ರೀ ಹೆಂಡತಿ ಬಿಟ್ಟು ಮತ್ತೆ ಬೇರೆದಾದ್ರೆ ಏನಾದ್ರೂ ಮಾಡಿದ್ರಾ"
    },
    {
      "t": "14:11",
      "text": "ಹಂಗೇನೂ ಮಾಡಿಲ್ಲ ಏನು ಕಥೆ"
    },
    {
      "t": "14:14",
      "text": "ಅಂದ್ರೆ ಹೋಗಿದ್ದೀರಾ ಅಂದೆ"
    },
    {
      "t": "14:17",
      "text": "ಹ್ಮ್ ಹೋಗಿಲ್ಲ ಹೋಗಬೇಕು"
    },
    {
      "t": "14:20",
      "text": "ಯಾವಾಗ"
    },
    {
      "t": "14:22",
      "text": "ಹೋಗಿಲ್ಲರೀ ಮದುವೆಗಿಂತ ಮೊದಲು ಅಷ್ಟೇ"
    },
    {
      "t": "14:25",
      "text": "ಮದುವೆಗಿಂತ ಮೊದಲು ಹೋಗಿದ್ರಿ"
    },
    {
      "t": "14:28",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "14:30",
      "text": "ಮದುವೆ ಆದ್ಮೇಲೆ"
    },
    {
      "t": "14:32",
      "text": "ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "14:34",
      "text": "ಮದುವೆಗಿಂತ ಮೊದಲು ಎಷ್ಟು ಸರಿ ಹೋಗಿದ್ದೀರಾ"
    },
    {
      "t": "14:37",
      "text": "ನಾಲ್ಕು ಸರಿ"
    },
    {
      "t": "14:39",
      "text": "ದುಡ್ಡು ಕೊಟ್ಟು ಹೋಗಿದ್ದೀರಾ"
    },
    {
      "t": "14:42",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "14:44",
      "text": "ಎಷ್ಟು ಒಂದು ನೈಟ್ ಡೇನಾ"
    },
    {
      "t": "14:47",
      "text": "ನೈಟ್"
    },
    {
      "t": "14:49",
      "text": "ಎಷ್ಟು"
    },
    {
      "t": "14:50",
      "text": "ಎರಡು ಹವರ್"
    },
    {
      "t": "14:52",
      "text": "ಡಿಪೆಂಡ್ಸ್ ರೀ ಅದು ಇವರ ಮೇಲೆ ಹೋಗುತ್ತೆ"
    },
    {
      "t": "14:55",
      "text": "ಅದು ಎಷ್ಟು ನನಗೆ ಒಂದು ಚೂರು ಎಕ್ಸ್ಪ್ಲೈನ್ ಮಾಡಿ"
    },
    {
      "t": "14:59",
      "text": "ಯಾಕ್ರಿ ನಿಮಗೆ"
    },
    {
      "t": "15:01",
      "text": "ಮಾಡಿ ನೋಡೋಣ"
    },
    {
      "t": "15:03",
      "text": "ಯಾಕೆ ಬರ್ತೀರಾ ನೀವು"
    },
    {
      "t": "15:06",
      "text": "ಅಂದ್ರೆ ಸುಮಾರು ಜನ ಹೋಗಿ ಬಂದು ಮಾಡ್ತಾರೆ ಲಾರ್ಜ್ ಗೆ ಎಲ್ಲಾ"
    },
    {
      "t": "15:11",
      "text": "ಪ್ಲೇಡಿಸ್ ಬಟ್ ಅವರು ಕತ್ತಲಿ ತಾಳಿ ಒಬ್ಬರು ಕತ್ತಲಲ್ಲಿ ತಾಳಿ ಇದ್ರೆ ಅವರ ಕತ್ತಲಲ್ಲಿ ತಾಳಿ ಇರೋದಿಲ್ಲ"
    },
    {
      "t": "15:16",
      "text": "ಸೋ ಹಾಗಾಗಿ ಡೌಟ್"
    },
    {
      "t": "15:20",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "15:22",
      "text": "ನಿಮ್ಮ ಫ್ರೆಂಡ್ಸ್ ಯಾರೋ ಹೋಗ್ತಾರೇನೋ"
    },
    {
      "t": "15:25",
      "text": "ಒಬ್ಬರು ಹೋಗಿದ್ದಾರೆ ಬಟ್ ಮದುವೆ ಆಗಿದೆ ಅವರಿಗೆ"
    },
    {
      "t": "15:28",
      "text": "ಹೌದಾ"
    },
    {
      "t": "15:30",
      "text": "ಎಷ್ಟು ಇರ್ತೀರಾ ಎಷ್ಟು ಹವರ್ ಅದು ಅಂತ ಎಕ್ಸ್ಪ್ಲೈನ್ ಮಾಡಿ"
    },
    {
      "t": "15:34",
      "text": "ಅದು ಡಿಪೆಂಡ್ ಅವರ ಇದರ ಮೇಲೆ ಹೋಗುತ್ತೆ ಒಳ್ಳೆ ಚಲೋ ಫಿಗರ್ ಇದ್ರೆ ಮಸ್ತ್ ಇದ್ರೆ"
    },
    {
      "t": "15:39",
      "text": "ನಾಲ್ಕು ಐದು ಸಾವಿರ ರೂಪಾಯಿ ಚಾರ್ಜ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "15:43",
      "text": "ಒನ್ ಹವರ್ ಟೂ ಹವರ್ಸ್ ಗೆ"
    },
    {
      "t": "15:46",
      "text": "ಓಕೆ"
    },
    {
      "t": "15:48",
      "text": "ನಾರ್ಮಲ್ ಇದ್ರೆ ಒಂದು ಎರಡು ಸಾವಿರ ರೂಪಾಯಿ ಟೂ ಹವರ್ಸ್"
    },
    {
      "t": "15:52",
      "text": "ಫುಲ್ ಡೇ ಇತ್ತು ಅಂತಂದ್ರೆ ನೈಟ್ ಇತ್ತು ಅಂದ್ರೆ"
    },
    {
      "t": "15:56",
      "text": "ಆರು ಸಾವಿರ ರೂಪಾಯಿ ಏಳು ಸಾವಿರ ರೂಪಾಯಿ ಎಂಟು ಸಾವಿರ ರೂಪಾಯಿ ಹತ್ತು ಸಾವಿರ ರೂಪಾಯಿ"
    },
    {
      "t": "16:00",
      "text": "ಅಷ್ಟೆಲ್ಲ ಕೊಟ್ಟು ನೀವು ಹೋಗಿದ್ದೀರಾ"
    },
    {
      "t": "16:03",
      "text": "ನಾನು ಹೋಗಿದ್ದೀನಿ"
    },
    {
      "t": "16:06",
      "text": "ಎಷ್ಟು ಹೋಗಿದೆ ನಿಮ್ಮ ಅಮೌಂಟ್"
    },
    {
      "t": "16:10",
      "text": "ಒಂದು ಹತ್ತು ಸಾವಿರ ಆಗಿರಬಹುದು ಹತ್ತು ಹದಿನೈದು ಸಾವಿರ"
    },
    {
      "t": "16:14",
      "text": "ಫಸ್ಟ್ ಅಮೌಂಟ್ ಕಳ್ಕೊಂಡಿದ್ದೀರಾ ನೋಡ್ರಿ ಪವಿತ್ರವಾದ ಜಾಗ ನಾನು ಹೆಂಡತಿ ಕೊಡೋದು ಬಿಟ್ಟು ಇನ್ಯಾರಿಗೋ ಕೊಟ್ಟಿದ್ದೀರಾ"
    },
    {
      "t": "16:19",
      "text": "ಏ ಮದುವೆಗಿಂತ ಮೊದಲು ಅಂತ ಹೇಳಕತ್ತೀನಿ ಅಲ್ರೀ"
    },
    {
      "t": "16:22",
      "text": "ಹಂಗೆ ಮದುವೆಗಿಂತ ಮಾಡಿದ್ರೆ ಅದೇನು ಮುಗಿತಲ್ಲ ನಿಂದು"
    },
    {
      "t": "16:26",
      "text": "ಏನಿಲ್ಲ"
    },
    {
      "t": "16:28",
      "text": "ಮದುವೆಗಿಂತ ಮೊದಲು ಇನ್ಯಾರಿಗೋ ತೋರಿಸಿದ್ದೀಯಾ"
    },
    {
      "t": "16:32",
      "text": "ಸೋ ಮುಖನಾದ್ರೂ ತೋರಿಸಿರಿ"
    },
    {
      "t": "16:35",
      "text": "ಗಂಡು ಮಕ್ಕಳದು ನೋಡಿ ಅವರಿಗೆ ಎಷ್ಟು ಪೇಷನ್ಸ್ ಇರಲ್ಲ"
    },
    {
      "t": "16:40",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "16:42",
      "text": "ನಿಮಗೆ ಕಾಯಿ ಎಷ್ಟು ಪೇಷನ್ಸ್ ಇರಲ್ಲ ಯಾವುದಾದರೂ ಒಂದು ಚೆನ್ನಾಗಿರೋ ಚಟ ಸಿಕ್ಕಿಬಿಟ್ರೆ ಮುಗಿತು ಬೆನ್ನತ್ತಿಕೊಂಡು ಹೋಗ್ಬಿಡ್ತೀರಾ"
    },
    {
      "t": "16:47",
      "text": "ಏನಿಲ್ಲ"
    },
    {
      "t": "16:49",
      "text": "ಕಳ್ಳನ"
    },
    {
      "t": "16:51",
      "text": "ನಿಮ್ಮ ಹೆಂಡತಿ ಗೊತ್ತಾ ಇದು"
    },
    {
      "t": "16:54",
      "text": "ಅಲ್ಲ ತೋರಿಸಿ ಮುಖನಾದ್ರೂ ತೋರಿಸಿರಿ ಅಂದೆ"
    },
    {
      "t": "16:57",
      "text": "ಅಲ್ಲ ನಿಮ್ಮ ಹೆಂಡತಿ ಗೊತ್ತಾ ಇದು ಅಂದೆ"
    },
    {
      "t": "17:01",
      "text": "ಮೊದಲಿಂದ ಹೇಳಿದ್ದು ಮೊದಲಿಗೆ ಮದುವೆಗಿಂತ ಮೊದಲು ಏನಾದರೂ ಇದ್ರೂನು ಅದೇ ನಿಂದು ನಾನು ಕೇಳೋಕೆ ಹೋಗಲ್ಲ ನಂದು ಕೇಳೋಕೆ ಹೋಗಬೇಡ ಅಂತ"
    },
    {
      "t": "17:07",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "17:09",
      "text": "ಅಂದ್ರೆ ಅದಕ್ಕೆ ಎದಕ್ಕೆ ಉಪಯೋಗ ಇಲ್ಲ ಅಲ್ರೀ ಸುಮ್ನೆ ಯಾಕೆ ಒಬ್ಬರು ಎಲ್ಲರಿಗೂ ಪಾಸ್ಟ್ ಅಂತ ಇರುತ್ತೆ ಪಾಸ್ಟ್ ಅಂತ ಇರುತ್ತೆ"
    },
    {
      "t": "17:15",
      "text": "ಮನಸ್ತಾಪ ಜಗಳ"
    },
    {
      "t": "17:17",
      "text": "ಈಗ ಎಲ್ಲರಿಗೂ ಒಂದು ಪಾಸ್ಟ್ ಇದ್ದೆ ಇರುತ್ತಲ್ಲ"
    },
    {
      "t": "17:20",
      "text": "ಅದೊಂದು ಮತ್ತೆ ಇವಾಗ ಡೆಲಿವರಿ ಹೋಗಿದ್ದಾಳ ಅಂತ ಮತ್ತೆ ಇನ್ಯಾರನ್ನೋ ಹುಡುಕೊಂಡು ಹೋಗ್ಬಿಟ್ಟಿದ್ದೀರಾ"
    },
    {
      "t": "17:25",
      "text": "ಇಲ್ಲ ಅದಕ್ಕೆ ಆಪ್ ಅಷ್ಟೇ ಯೂಸ್ ಮಾಡೋದು"
    },
    {
      "t": "17:28",
      "text": "ಹಾಯ್ ರೀ ಆದ್ರೆ ಏನು ಆಗಲ್ಲ ಹೆಂಡತಿಗೋಸ್ಕರ ಕೈ ಇರ"
    },
    {
      "t": "17:33",
      "text": "ಹ್ಮ್ ಸ್ವಲ್ಪ ಮುಖನಾದ್ರೂ ತೋರಿಸಿರಿ"
    },
    {
      "t": "17:38",
      "text": "ಹ್ಮ್ ಯಾಕೆ ಎಲ್ಲಾ ಬಂದು ಬಂದ್ ಮಾಡಿ ಮಾತಾಡಕತ್ತೀರಿ"
    },
    {
      "t": "17:43",
      "text": "ಆ"
    },
    {
      "t": "17:46",
      "text": "ಸೋ ಮುಖನಾದ್ರೂ ತೋರಿಸಿರಿ ಅಂದೆ"
    },
    {
      "t": "17:49",
      "text": "ತೋರಿಸಿದ್ನಲ್ಲ"
    },
    {
      "t": "17:52",
      "text": "ನೆಟ್ ತೋರಿಸಿರಿ ಅದೇನಂಗ ಬಂದ ಎರಡು ಸಲ ತೋರಿಸಂಗ ಬಂದ್ ಮಾಡಿದ್ರ"
    },
    {
      "t": "17:57",
      "text": "ಒಂದು ನಮಸ್ಕಾರ ಆಗುತ್ತೆ ರೀ"
    },
    {
      "t": "18:00",
      "text": "ತೋರಿಸಿರಿ"
    },
    {
      "t": "18:03",
      "text": "ಏನಮ್ಮ"
    },
    {
      "t": "18:05",
      "text": "ತೋರ್ಸು"
    },
    {
      "t": "18:09",
      "text": "ಲೈಟ್ ಆಗಿ ಇಟ್ಕೋ ನೀನು ಏನ್ ಮಾಡ್ತೀಯಾ"
    },
    {
      "t": "18:13",
      "text": "ಓಕೆ"
    },
    {
      "t": "18:18",
      "text": "ಸ್ವಲ್ಪ ಲೈಟ್ ಆಗಿ ಇಟ್ಕೋ"
    },
    {
      "t": "18:21",
      "text": "ಸಾಕು"
    },
    {
      "t": "18:23",
      "text": "ಇಟ್ಕೋ"
    },
    {
      "t": "18:27",
      "text": "ತೋರ್ಸು"
    },
    {
      "t": "18:31",
      "text": "ಹ್ಮ್ ಇರು ಇರು"
    },
    {
      "t": "18:34",
      "text": "ಇನ್ನೊಂದನ್ನ ಇವಾಗ ಹೋಗಿದ್ದವರು ಯಾವಾಗ ಬರ್ತಾರೆ ಅವರು ಡೆಲಿವರಿ ಮುಗಿಸಿಕೊಂಡು"
    },
    {
      "t": "18:40",
      "text": "ಹ್ಮ್ ಒಂದು ತಿಂಗಳು ಒಂದು ಐದು ಆರು ತಿಂಗಳು"
    },
    {
      "t": "18:44",
      "text": "ಐದು ಆರು ತಿಂಗಳು ಬಿಟ್ಟಿರ್ತೀರಾ ನೀವು"
    },
    {
      "t": "18:48",
      "text": "ನೋಡೋಣ ನೀನು ಸಿಗ್ತಿಯೇನ"
    },
    {
      "t": "18:51",
      "text": "ಅಲ್ಲ ಐದು ಆರು ತಿಂಗಳ ಒಳಗಡೆ ನೀವು ನಿಮ್ಮ ಹೆಂಡತಿ ಮೀಟ್ ಆದಾಗೆಲ್ಲ ಹೋಗಿ ಮಾಡಲ್ವಾ ನೀವು"
    },
    {
      "t": "18:57",
      "text": "ಹೋಗ್ತಿರ್ತೀವಿ ಅಲ್ಲ ನೀವು ನೀನು ಸಿಗ್ತಿಯ ಅಂದೆ"
    },
    {
      "t": "19:01",
      "text": "ಯಾವ ರೆಡ್ ನಿಮ್ದು"
    },
    {
      "t": "19:04",
      "text": "ದಾವಣಗೆರೆ"
    },
    {
      "t": "19:06",
      "text": "ಮತ್ತೆ ಆವಾಗ್ಲೇ ಬೆಂಗಳೂರು ಅಂದರಿ"
    },
    {
      "t": "19:09",
      "text": "ಇಲ್ಲ ಸರಿ"
    },
    {
      "t": "19:11",
      "text": "ದಾವಣಗೆರೆನಾ"
    },
    {
      "t": "19:13",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "19:14",
      "text": "ಎಲ್ಲಿ ಬರುತ್ತೆ ಹೇಳಿ ದಾವಣಗೆರೆಯಲ್ಲಿ"
    },
    {
      "t": "19:17",
      "text": "ಹುಬ್ಬಳಿಯಿಂದ ಮುಂದೆ ನೆಕ್ಸ್ಟ್"
    },
    {
      "t": "19:20",
      "text": "ಓಕೆ ಅದೇ ಅಡ್ರೆಸ್ ಹೇಳಿ"
    },
    {
      "t": "19:23",
      "text": "ಏನಿಲ್ಲರಿ ಹುಬ್ಬಳಿ ಆದ್ಮೇಲಿಂದ"
    },
    {
      "t": "19:27",
      "text": "ದಾವಣಗೆರೆ ಕೇಳಿದ್ದೀನಿ ನಾನು ಆ ದಾವಣಗೆರೆಯಲ್ಲಿ ದುರ್ಗಮ್ಮ ದೇವರಿ ಇದ್ದಾರೆ ತಾನೇ"
    },
    {
      "t": "19:32",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "19:34",
      "text": "ಅದೇ ದುರ್ಗಮ್ಮ ದೇವಿ ಅಂದ್ರೆ ನಿಮ್ಮ ದಾವಣಗೆರೆಯಲ್ಲಿ ಮಣ್ಣೆ ನಿಮ್ಮ ಏರಿಯಾ ಹೆಸರೇನು ಅಂದೆ"
    },
    {
      "t": "19:39",
      "text": "ವಿದ್ಯಾನಗರ ವಿದ್ಯಾನಗರ"
    },
    {
      "t": "19:42",
      "text": "ಓ ವಿದ್ಯಾನಗರ"
    },
    {
      "t": "19:44",
      "text": "ಓಕೆ ಬರ್ತೀನಿ ಎಷ್ಟು ಕೊಡ್ತೀರಾ"
    },
    {
      "t": "19:47",
      "text": "ನಾನೇ ಗುಲ್ಬರ್ಗ ಬರ್ತೀನಿ ಅಂದರಿ ಬಂದಾಗ ಆಕಡೆ ಬರ್ತೈತಿ"
    },
    {
      "t": "19:50",
      "text": "ಏನು"
    },
    {
      "t": "19:52",
      "text": "ನಾನೇ ಗುಲ್ಬರ್ಗ ಕಡೆ ಬರ್ತಿರ್ತೀನಿ"
    },
    {
      "t": "19:55",
      "text": "ಓಕೆ"
    },
    {
      "t": "19:57",
      "text": "ಸಿಗ್ತೀರಾ ಬಂದಾಗ"
    },
    {
      "t": "20:00",
      "text": "ಸಿಗ್ತೀನಿ ಅಂತೆ ಏನು ಕೊಡ್ತೀರಿ ಒಂದೇ ಕೇಳ್ದೆ"
    },
    {
      "t": "20:03",
      "text": "ಫುಲ್ ನೈಟ್ ಏನು"
    },
    {
      "t": "20:06",
      "text": "ಫುಲ್ ನೈಟ್ ಅಂದ್ರೆ ಫುಲ್ ಟು ಡೇ ಫುಲ್ ಡೇ ಅಂಡ್ ಫುಲ್ ಡೇ"
    },
    {
      "t": "20:11",
      "text": "ಹ್ಮ್ ಅದು ಐದು ಸಾವಿರ"
    },
    {
      "t": "20:14",
      "text": "ಹ್ಮ್ ಕಡಿಮೆ ಆಗ್ಲಿಲ್ವಾ ಫುಲ್ ನೈಟ್ ಅಂತೀಯಾ ಇಲ್ಲ ಫುಲ್ ಡೇ ಅಂತೀಯಾ"
    },
    {
      "t": "20:19",
      "text": "ನೀನು ಫಸ್ಟ್ ನೋಡೋಣ ಬಾ ನೀನು ನಿಂದೆ ನೀನು ಹೆಂಗೆ ಕೋ ಆಪರೇಟ್ ಮಾಡ್ತೀಯಾ"
    },
    {
      "t": "20:24",
      "text": "ಓ ನಿನ್ನನ್ನು ನೋಡಿ ಸರಿಯಾಗಿ ಅವಶ್ಯಕತೆನೇ ಇಲ್ಲ ಅಲ್ಲಿ ಫಿದಾ ಆಗ್ಬಿಡ್ತೀಯಾ"
    },
    {
      "t": "20:28",
      "text": "ಏನಿಲ್ಲ ನಿನ್ನ ಮುಖಾನ ತೋರಿಸಂಗಿಲ್ಲ ನೆಟ್ ಅಲ್ಲಿ"
    },
    {
      "t": "20:32",
      "text": "ಅದು ಒಂದು ಸೆಕೆಂಡ್ ಅಲ್ಲಿ ಮುಖ ನೋಡ್ಲಿಲ್ವಾ ನೀನು ಹೇಗಿದ್ದೀನಿ ಅಂದೆ"
    },
    {
      "t": "20:36",
      "text": "ಇಲ್ಲ ಗೊತ್ತಾಗಲ್ಲ ಸೋ ತೋರಿಸಬೇಕು ನೀನು"
    },
    {
      "t": "20:40",
      "text": "ಇರು"
    },
    {
      "t": "20:44",
      "text": "ಹಲೋ"
    },
    {
      "t": "20:47",
      "text": "ಅಲ್ಲ ಬಂದ್ರೆ ಎಷ್ಟು ಸಾರಿ ಮಾಡಬಹುದು ಹೇಳು"
    },
    {
      "t": "20:52",
      "text": "ಯಾರು"
    },
    {
      "t": "20:54",
      "text": "ನೀನು"
    },
    {
      "t": "20:56",
      "text": "ಹೇಳ್ವಾ ಮೂರು ಸಲ"
    },
    {
      "t": "20:59",
      "text": "ಎಷ್ಟೊತ್ತಿಗೆ ಎಷ್ಟೊತ್ತಿಗೆ"
    },
    {
      "t": "21:03",
      "text": "ನೋಡೋಣ ಅಂತ ಫಸ್ಟ್ ಮುಖ ಮುಖ ತೋರಿಸು"
    },
    {
      "t": "21:08",
      "text": "ಮನೆಗೆ ಮೂಡ್ ಬರಬೇಕು ಅವಾಗಿದ್ರೆ ಬರ್ತೀನಿ ಅವಾಗ"
    },
    {
      "t": "21:15",
      "text": "ಹಲೋ"
    },
    {
      "t": "21:22",
      "text": "ಸೈಜ್ ತೋರಿಸಂಗಿದೆ ನೋಡೋಣ"
    },
    {
      "t": "21:26",
      "text": "ಹಲೋ"
    },
    {
      "t": "21:29",
      "text": "ನೋಡಿದ್ಯಾ"
    },
    {
      "t": "21:31",
      "text": "ಅಲ್ಲ ನನಗೂ ಸ್ವಲ್ಪ ತೋರಿಸಲ್ಲ ಮಲ್ಲಿ"
    },
    {
      "t": "21:35",
      "text": "ಏ ಮರೆಗೆ ತೋರಿಸಿದ್ರೆ ನಾನು ನಿನ್ನ ಹತ್ರ ಬಂದಾಗ ನಿನಗೆ ಏನು ಗೊತ್ತಾಗುತ್ತೆ"
    },
    {
      "t": "21:40",
      "text": "ಫೋನೇ ನೋಡಿದೀನಿ ಮತ್ತೆ ನೋಡೋದು ಅಂದೀಯ"
    },
    {
      "t": "21:44",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "21:46",
      "text": "ತೋರ್ಸು"
    },
    {
      "t": "21:48",
      "text": "ತೋರ್ಸನ"
    },
    {
      "t": "21:50",
      "text": "ಬರ್ತೀನಿ ವಿಡಿಯೋ ಕಾಲ್ ವಿಡಿಯೋ ಕಾಲ್ ಅಲ್ಲಿ ಬರ್ತೀನಿ"
    },
    {
      "t": "21:53",
      "text": "ನಾನು ಬರ್ಬೇಕಂದ್ರೆ ನನಗೆ ಎಕ್ಸ್ಪ್ಲೈನ್ ಮಾಡು ಹೆಂಗ್ ಮಾಡ್ತೀಯಾ ಏನೇನು ಮಾಡ್ತೀಯಾ ಎಷ್ಟು ಸಾರಿ ಮಾಡ್ತೀಯಾ ಅಂದೆ"
    },
    {
      "t": "21:59",
      "text": "ಹಂಗಲ್ಲ"
    },
    {
      "t": "22:01",
      "text": "ಇವಾಗ ವಿಡಿಯೋ ಕಾಲ್ ಅಲ್ಲಿ ಬರ್ತೀಯ ವಾಟ್ಸಪ್ ನಾಗ"
    },
    {
      "t": "22:05",
      "text": "ಬರ್ತೀನಿ ಇನ್ನೊಂದು ಎರಡು ಮೂರು ನಿಮಿಷದೊಳಗೆ ನಾನು ಅಲ್ಲಿ ಬರ್ತೀನಿ"
    },
    {
      "t": "22:10",
      "text": "ತೋರ್ಸು ಫುಲ್ ಬಿಚ್ಚಿ"
    },
    {
      "t": "22:13",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "22:16",
      "text": "ಮತ್ತೆ ತೋರ್ಸು"
    },
    {
      "t": "22:18",
      "text": "ಬಿಚ್ಚಿ ತೋರಿಸಿದ್ರೆ ಇನ್ಯೇನು ಮಾಡ್ದಂಗೆ ಆಯ್ತು ನೀನು"
    },
    {
      "t": "22:22",
      "text": "ಅಷ್ಟು ತೋರ್ಸು ಸಾಕು"
    },
    {
      "t": "22:25",
      "text": "ಅಷ್ಟೆಲ್ಲ ಬೇಡ ಇಲ್ಲೇ ನೋಡು ನಿಂತಿಯಲ್ಲ"
    },
    {
      "t": "22:28",
      "text": "ಇಲ್ಲ ಹಂಗೇನಿಲ್ಲ"
    },
    {
      "t": "22:30",
      "text": "ಆ ಮತ್ತೆ"
    },
    {
      "t": "22:33",
      "text": "ತೋರ್ಸು ಮಾಡೋಣ"
    },
    {
      "t": "22:37",
      "text": "ಫುಲ್ ಬಿಚ್ಚಿ ತೋರ್ಸು"
    },
    {
      "t": "22:39",
      "text": "ಎಷ್ಟು ಸಾರಿ ಮಾಡ್ತೀಯಾ ಅಂತ ಹೇಳಲಿಲ್ಲ"
    },
    {
      "t": "22:42",
      "text": "ಹೇಳಿದ್ನಲ್ಲ ಮೂರು ಸತಿ"
    },
    {
      "t": "22:45",
      "text": "ಒಂದು ನೈಟ್ ಫುಲ್ಲಾ"
    },
    {
      "t": "22:48",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "22:50",
      "text": "ಮತ್ತೆ ಡೇ"
    },
    {
      "t": "22:52",
      "text": "ಆ"
    },
    {
      "t": "22:54",
      "text": "ನೈಟ್ ಎಲ್ಲಾ ಮಲಗೋದ್ರು ಎದ್ದೆದ್ದು ಹೆಂಗೆ ಮಾಡ್ತೀಯಾ ನೀನು ಒಂದ್ಸಲ ನಿದ್ದೆ ಮಾಡಿದ್ರೆ ಮುಗಿತು ಔಟ್ ಮಾಡ್ಕೊಂಡು"
    },
    {
      "t": "23:00",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "23:02",
      "text": "ಮತ್ತೆ ಹೆಂಗೆ ಇದು ಮಾಡ್ತೀಯಾ ಡೇ ಮಾಡೋಣ ಇಲ್ಲ"
    },
    {
      "t": "23:06",
      "text": "ಹ್ಮ್ ಆಯ್ತು ನೋಡು ಏನೋ ಮಾಡೋಣ ಅಂತ"
    },
    {
      "t": "23:09",
      "text": "ಹ್ಮ್ ಎಷ್ಟು ಫುಲ್ ಬರಿ ಓನ್ಲಿ ಐದು ಸಾವಿರ ಅಂದ್ರೆ ಆಗಲ್ಲ ನನಿಗೆ"
    },
    {
      "t": "23:14",
      "text": "ನೋಡೋಣ ತಗೋ ಅಲ್ಲಿ ಬಂದಾಗ ನಿನಗೆ ನಿನಗೆ ಪಸಂದ್ ಆಗ್ತೀನಿ ಅಂದ್ರೆ ಅವಾಗ ಹೇಳ್ತೀನಿ"
    },
    {
      "t": "23:19",
      "text": "ನೀನೇನು ದಪ್ಪ ಇದೀಯಾ"
    },
    {
      "t": "23:22",
      "text": "ಆ ಮೀಡಿಯಂ ಇದೀನಿ"
    },
    {
      "t": "23:25",
      "text": "ಬಟ್ ಮುಖ ನೋಡಿದ್ರೆ ಫುಲ್ ದಪ್ಪ ಆಗ್ತಾರೆ"
    },
    {
      "t": "23:29",
      "text": "ತೋರಿಸ್ತೀಯಾ"
    },
    {
      "t": "23:32",
      "text": "ಹ್ಮ್ ಅಲ್ಲಿ ಬಂದಾಗ ಗೊತ್ತಾಗುತ್ತಲ್ಲ ಹೆಂಗ್ ಮಾಡ್ತೀವಿ ಏನ್ ಮಾಡ್ತೀವಿ ಅಂತ ಯಾವಾಗ ಬರ್ತೀಯ ಹೇಳು ಡೇಟು"
    },
    {
      "t": "23:39",
      "text": "ನಾನು ಬಂದಾಗ ಹೇಳ್ತೀನಿ ಅಂತ ಆ ಕಡೆಗೆ"
    },
    {
      "t": "23:43",
      "text": "ನೀವು ಬಂದಾಗ ಹೇಳ್ದಂಗೆ ಬಂದಾಗ ಹೇಳ್ತೀನಿ ಅಂದ್ರೆ ಕಾಲ್ ಕಟ್ ಆದ್ರೆ ಇನ್ನು ಯಾವಾಗ ಬಂದು ಹೇಳ್ತೀಯಾ"
    },
    {
      "t": "23:48",
      "text": "ಅದೇ ಹೇಳಿದ್ನಲ್ಲ ವಾಟ್ಸಪ್ ನಾಗೆ ಇರು ಟಚ್ ಒಳಗಿರು"
    },
    {
      "t": "23:53",
      "text": "ಫಸ್ಟ್ ಒಂದ್ಸಲ ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡೋಣ"
    },
    {
      "t": "23:57",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "23:59",
      "text": "ನೀನು ಎಲ್ಲಾ ಪೂರ್ತಿ ತೋರ್ಸು"
    },
    {
      "t": "24:03",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "24:05",
      "text": "ಲೈಕ್ ಆಗುತ್ತೆ ನೋಡೋಣ ಆಮೇಲೆ ನೆಕ್ಸ್ಟ್ ಬಂದಾಗ ನಾನು ಹೇಳ್ತೀನಿ"
    },
    {
      "t": "24:11",
      "text": "ಹುಬ್ಬಳಿ ಬರ್ತೀಯ"
    },
    {
      "t": "24:14",
      "text": "ನೀನು ದಪ್ಪ ಇದೀಯಾ ಅನ್ಸುತ್ತಾ"
    },
    {
      "t": "24:17",
      "text": "ಹುಬ್ಬಳಿ ಬರ್ತೀಯ"
    },
    {
      "t": "24:20",
      "text": "ಹ್ಮ್ ಬರು"
    },
    {
      "t": "24:23",
      "text": "ಬಂದು ಹೋಗೋ ಖರ್ಚು ಎಷ್ಟು ನಿಂದು"
    },
    {
      "t": "24:27",
      "text": "ನಮ್ಮೂರಿಂದ ಬರಬೇಕಂದ್ರೆ"
    },
    {
      "t": "24:32",
      "text": "ಹುಬ್ಬಳಿ ಹತ್ರ ಆಗುತ್ತೆ ಅನ್ಸುತ್ತೆ ದೂರ ಆಗುತ್ತೆ"
    },
    {
      "t": "24:36",
      "text": "ಏ ರಾತ್ರಿ ಟ್ರೈನ್ ಟ್ರೈನ್ ಹತ್ತಿದ್ರೆ ಬೆಳಿಗ್ಗೆ ಬಂದಿರ್ತೀವಿ ಹುಬ್ಬಳಿ"
    },
    {
      "t": "24:41",
      "text": "ಹ್ಮ್ ಇರುತ್ತೆ ಅಂದ್ರೆ ಹೋಗೋ ಬರೋ ಖರ್ಚು ಕೊಡ್ತೀಯಾ"
    },
    {
      "t": "24:46",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "24:48",
      "text": "ಎಷ್ಟಿದೆ ನಿಂದು ಸ್ಯಾಲರಿ"
    },
    {
      "t": "24:52",
      "text": "ಅದನ್ನ ತಗೊಂಡು ಏನ್ ಮಾಡ್ತೀಯಾ ನೀನು"
    },
    {
      "t": "24:55",
      "text": "ಹೇಳಿ ನೋಡೋಣ ನಾನೇ ನೋಡಿ ತಗೊಂಡು ಬರ್ತೀನಿ"
    },
    {
      "t": "24:59",
      "text": "ಜೈ ಮಾತಾ"
    },
    {
      "t": "25:01",
      "text": "ಹೋಗ್ಲಿ ಬಿಡು ಇವಾಗ ಬಾ ಏನಿಗ ಮುಂದೆ ಈಗ ತೋರಿಸ್ತೀಯಾ ಹೆಂಗ ಇಲ್ಲ"
    },
    {
      "t": "25:07",
      "text": "ಏನು"
    },
    {
      "t": "25:10",
      "text": "ವಿಡಿಯೋದಾಗ ವಿಡಿಯೋ ಕಾಲ್"
    },
    {
      "t": "25:13",
      "text": "ನೀನು ಸಿಗ್ತಿಯ"
    },
    {
      "t": "25:16",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "25:18",
      "text": "ಯಾವ ತರ"
    },
    {
      "t": "25:21",
      "text": "ತೋರ್ಸ್ತೀನಿ ವಿಡಿಯೋ ಕಾಲ್ ನಾಗೆಲ್ಲ"
    },
    {
      "t": "25:25",
      "text": "ನಾನು ತೋರ್ಸ್ತೀನಿ ರಿಯಲ್ ಆಗಿ ಬಂದಾಗ ನೀನು ಸಿಗ್ತಿಯ ಅಂದೆ"
    },
    {
      "t": "25:30",
      "text": "ಹೂ ಸಿಗ್ತೀನಿ"
    },
    {
      "t": "25:33",
      "text": "ಯಾವ ತರ ಯಾವ ತರ ಸೌಂಡು"
    },
    {
      "t": "25:37",
      "text": "ಏನಿಲ್ಲ ನಿನ್ ತುಲ್ ಸಿಗ್ತೀನಿ ಮಸ್ತ್"
    },
    {
      "t": "25:41",
      "text": "ಅದು ಸೌಂಡ್ ಯಾವ ತರ"
    },
    {
      "t": "25:44",
      "text": "ಹೇಳ್ತೀನಿ ಬಾ ಅದಕ್ಕೆ ವಿಡಿಯೋ ಕಾಲ್ ಗೆ ಬಾ"
    },
    {
      "t": "25:48",
      "text": "ಯಾರು ಚಿಪ್ಪಿ ಇಲ್ಲಿ ನಿನ್ ತುಲ್ಲ"
    },
    {
      "t": "25:51",
      "text": "ಏನು"
    },
    {
      "t": "25:53",
      "text": "ನಿನ್ ತುಲ್ಲ ಯಾರು ಚಿಪ್ಪಿ ಇಲ್ಲ ಅಂದೆ"
    },
    {
      "t": "25:56",
      "text": "ನಾನು ಯಾರಿಗೆ ಕೊಟ್ಟಿಲ್ಲ ಅಂತ ಆವಾಗ್ಲೇ ಅಂದೆ ಅದಕ್ಕೆ ರೇಟು ಜಾಸ್ತಿ ಇದೆ"
    },
    {
      "t": "26:01",
      "text": "ಹೌದಾ"
    },
    {
      "t": "26:03",
      "text": "ಸುಳ್ಳು ಹೇಳ್ತೀನಿ"
    },
    {
      "t": "26:06",
      "text": "ನಿನ್ನ ಹತ್ರ ಎಲ್ಲಾ ನಾನು ಕೇಳಾಯ್ತೀನಿ ಅಂದ್ರೆ ನೀನು ರೊಮ್ಯಾಂಟಿಕ್ ಆಗಿ ಮಾತಾಡ್ತಿದ್ದೀಯಾ ಸೋ ಹಾಗಾಗಿ ನಿನ್ನ ಹತ್ರ ಕೇಳ್ತಿದ್ದೀನಿ ಬರೋದರ ಬಗ್ಗೆ ಇನ್ನು ವಿಚಾರ ಮಾಡ್ತೀನಿ ನಾನು ಬಟ್ ಇನ್ನು ಯಾರಿಗೆ ಕೊಟ್ಟಿಲ್ಲ ನಾನು"
    },
    {
      "t": "26:15",
      "text": "ಫಸ್ಟ್ ಟೈಮ್ ಅಲ್ವಾ ಅಮೌಂಟ್ ಜಾಸ್ತಿ ಆಗುತ್ತೆ"
    },
    {
      "t": "26:21",
      "text": "ಹ್ಮ್ ಬಾ ನೋಡೋಣ ಅಂತ"
    },
    {
      "t": "26:25",
      "text": "ನೀನು ಕೋ ಆಪರೇಟ್ ಮಾಡು ಇಲ್ಲ"
    },
    {
      "t": "26:28",
      "text": "ಬರೋಕು ಮುಂಚೆ ನಾನು ವಿಚಾರ ಮಾಡಿ ಮಾತಾಡಬೇಕಲ್ವಾ ಅಮೌಂಟ್ ಎಷ್ಟು ಅಂತ"
    },
    {
      "t": "26:33",
      "text": "ಅದೇ ಹೇಳೋಣ ತಡಿ ಫಸ್ಟ್ ಒಂದ್ ಸತಿ ವಿಡಿಯೋ ಕಾಲ್ ವಾಟ್ಸಪ್ ನಾಗ ಬಾ ಮಾತಾಡೋಣ ವಿಡಿಯೋ ಕಾಲ್"
    },
    {
      "t": "26:40",
      "text": "ಇಬ್ಬರಿಗೂ ಆಮೇಲೆ ಹೊಂದಿಕೆ ಆಗ್ತದೆ ಚಲೋ ಅನಿಸ್ತಾರೆ ಮುಂದೆ ಹೇಳೋಕೆ ಬರ್ತೈತೆ"
    },
    {
      "t": "26:45",
      "text": "ಒನ್ ಕೆ ಹಾಗೆ ಆಗುತ್ತೆ ರೀ ಯಾಕಂದ್ರೆ ನನಗೆ ಕ್ರಶ್ ಗಳು ಜಾಸ್ತಿ ಇದ್ದಾರೆ"
    },
    {
      "t": "26:51",
      "text": "ನಂಗೆಲ್ಲ ಅನ್ಕೋಬೇಡ ನಾವು ಬಹಳ ಜನ ನೋಡಿವಿ"
    },
    {
      "t": "26:55",
      "text": "ಸೋ ನೋಡೋಣ ಇಬ್ಬರಿಗೂ ಆಯ್ತು ಅಂದ್ರೆ ಸರಿ ಹೋಗುತ್ತೆ ಅಂದ್ರೆ ನಾನು ಒಂದು ನೋಡೋಣ ಇಲ್ಲ ಅಂದ್ರೆ ಬೇಡ"
    },
    {
      "t": "27:01",
      "text": "ಓಕೆ ಆಯ್ತು ಈ ಫೋನ್ ಇಂತ ಆಪ್ ಅಲ್ಲಿ ಸುಮಾರು ಜನ ಹುಡುಗಿಯರು ಎಕ್ಸ್ಪೋಸ್ ಮಾಡ್ತಾರೆ ಮಾಡಿದ್ದಾರ ನಿನಗೆ"
    },
    {
      "t": "27:08",
      "text": "ಮಾಡಾರಲ್ಲ"
    },
    {
      "t": "27:10",
      "text": "ಮಾಡಾರ"
    },
    {
      "t": "27:13",
      "text": "ಮಾಡಾರ ನೀನು ಯಾಕೆ ಮಾಡಲ್ಲ"
    },
    {
      "t": "27:17",
      "text": "ಅಂದ್ರೆ ಓನ್ಲಿ ನಾನು ಆವಾಗ್ಲೇ ನಿನಗೆ ಹೇಳಿಲ್ವಾ ಎಲ್ಲಾ ತೋರಿಸಬೇಕಾದ್ರೆ ಓನ್ಲಿ ನನ್ನ ಗಂಡನಿಗೆ ಅಂತ"
    },
    {
      "t": "27:24",
      "text": "ಮತ್ತೆ ಅದೆಲ್ಲ ಹೇಳಕತ್ತೀನಿ ಏನ್ ಎಲ್ಲ ಮಾತಾಡ್ತೀನಿ ನೀನು"
    },
    {
      "t": "27:29",
      "text": "ಎಲ್ಲಾ ಮಾತಾಡ್ತೀನಿ ಅಂದ್ರೆ ಇವಾಗ ನಾನು ಬರ್ತೀನಿ"
    },
    {
      "t": "27:33",
      "text": "ಒಮ್ಮೆ ಎಲ್ಲಾ ಗಂಡಗ ಅಂತೀನಿ ಮತ್ತೆ ಆಮೇಲೆ ಇದಕ್ಕೂ ಬರ್ತೀನಿ ಅಂತೀನಿ ಏನು ಅರ್ಥ ಆಗಲ್ಲ"
    },
    {
      "t": "27:39",
      "text": "ಓಕೆ ಹಂಗಂತ ಒಂದು ಬಂದು ಬಂದು ಫೋನ್ ಮಾಡಿದವರಿಗೆ ಎಲ್ಲಾ ತೋರಿಸ್ಕೊಂತಾ ಹೋಗಬೇಕಾ ಅದೇನು ಬ್ರೀ ಶೋನಾ"
    },
    {
      "t": "27:46",
      "text": "ಮಾತು ಅದಕ್ಕೆ ಹೇಳಿದ್ನಲ್ಲ ವಾಟ್ಸಪ್ ಅಲ್ಲಿ ಬಂದು ತೋರಿಸಲ್ಲ ಅಂದೆ ಇಲ್ಲ ತೋರಿಸಲ್ಲ ಅಲ್ಲಿ ತೋರಿಸು"
    },
    {
      "t": "27:52",
      "text": "ಬಟ್ ನೀನು ಮಾತಾಡೋದು ಏನೋ ಒಂತರ ಡಿಫರೆಂಟ್ ಆಗಿತ್ತಲ್ಲ ಅಟ್ರಾಕ್ಷನ್ ಇತ್ತು ಸೋ ಹಾಗಾಗಿ ಹೂ ಬರೋಣ ಅಂತ ಒಪ್ಕೊಂಡೆ ಬೇಡ ಅಂದ್ರೆ ಬೇಡ"
    },
    {
      "t": "28:00",
      "text": "ಅಲ್ಲ ಇಲ್ಲಾದರೂ ತೋರ್ಸು ಇಲ್ಲ ಅಲ್ಲಿಯಾದರೂ ತೋರ್ಸು ಎರಡರಲ್ಲಿ ಒಂದು ಎಲ್ಲ ಇಲ್ಲಿ ಇಲ್ಲೇ ತೋರಿಸೋಕೆ ಏನು ಪ್ರಾಬ್ಲಮ್ ಆಯ್ತು ನಿನಗೆ ಇಲ್ಲಿ"
    },
    {
      "t": "28:07",
      "text": "ಇಲ್ಲಿ ತೋರಿಸಿದ್ರೆ ಏನು ಮಜಾ ಉಳಿದು ಬರ್ತೀಯ ಅಲ್ವಾ ಅಮೌಂಟ್ ಕಳಿಸಿಕೊಳ್ಳೋದು ಮುಂದಿನ ಕಾರ್ಯ ಮಾಡೋದು"
    },
    {
      "t": "28:15",
      "text": "ಅದು ಆಮೇಲೆ ನೋಡೋಣ ಅಂತ ಫಿಸಿಕಲ್ ಹೇಳಕತ್ತೀನಲ್ಲ ಆಮೇಲೆ ನೋಡೋಣ ಫಸ್ಟ್ ವಾಟ್ಸಪ್ ನಾಗ ಇದ್ರಾಗರ ಒಂದ್ ಸತಿ ಬಾ"
    },
    {
      "t": "28:22",
      "text": "ವರ್ಚುವಲ್ ಇದು ನೋಡೋಣ ವಿಡಿಯೋ ಕಾಲ್ ಆಮೇಲೆ ಓಕೆ ಅಂದ್ರೆ ಹಂಗೆ ಒಂದು ಹೇಳ್ತೀನಿ"
    },
    {
      "t": "28:28",
      "text": "ವಿಡಿಯೋ ಕಾಲ್ ಅಲ್ಲಿ ನೋಡ್ಬಿಟ್ಟು ಆಮೇಲೆ ಬೇಡ ಅಂದ್ರೆ ರಿಜೆಕ್ಟ್ ಮಾಡೋದು ಏನ್ ಮಾಡೋದು"
    },
    {
      "t": "28:33",
      "text": "ಏ ವಿಡಿಯೋ ಕಾಲ್ ಮಾತಾಡೋದು ಇಬ್ಬರಿಗೂ ಸೆಟ್ ಆಗ್ಬೇಕಲ್ಲ ನಾನೇ ಸುಮ್ನೆ ನಾನು ಕರೆದರೆ ನೀನು ಬರಬಾರದು ನಿನಗೂ ಟೈಮ್ ವೇಸ್ಟ್"
    },
    {
      "t": "28:40",
      "text": "ಬಟ್ ನನಗೆ ಅಷ್ಟೇ ಅನ್ನಿಸ್ತಂಗೆ ನೀನು ದಪ್ಪ ಇದೀಯಾ ಅಲ್ಲಿ ಸ್ವಲ್ಪ"
    },
    {
      "t": "28:45",
      "text": "ಹೌದು ನಾನು ದಪ್ಪ ಇದೀನಿ ಅದಕ್ಕೆ ಹೇಳಕತ್ತೀನಿ ಒಂದು ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡೋಣ"
    },
    {
      "t": "28:50",
      "text": "ಅವಾಗ ನಿನಗೆ ಏನು ಡೌಟ್ ಅದಾವೋ ನೀನು ನೋಡು ನಿನಗೆ ಓಕೆ ಅಂದ್ರೆ ಆಮೇಲೆ ನೋಡೋಣ"
    },
    {
      "t": "28:55",
      "text": "ಓಕೆ ಓಕೆ ಮತ್ತೆ"
    },
    {
      "t": "28:59",
      "text": "ನೀನು ಹೆಂಗೆ ವಿಡಿಯೋ ಕಾಲ್ ಬರ್ತೀಯಾ ಇಲ್ಲ"
    },
    {
      "t": "29:03",
      "text": "ನಾನು ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡ್ಲಾ"
    },
    {
      "t": "29:06",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "29:08",
      "text": "ವೇಟ್ ಮಾಡ್ತೀಯಾ ನಾನು ಬರ್ತೀನಿ ಮಾಡ್ಕೊಂಡು ಹಾಯ್ ಅಂತ ಮೆಸೇಜ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "29:13",
      "text": "ಹ್ಮ್ ಮಾಡು"
    },
    {
      "t": "29:16",
      "text": "ಕಾಲ್ ಅಲ್ಲೇ ವೇಟ್ ಮಾಡು ಕಾಲ್ ಕಟ್ ಮಾಡಿದ್ರೆ ನಾನು ಮಾಡೋದಿಲ್ಲ"
    },
    {
      "t": "29:21",
      "text": "ಮೆಸೇಜ್ ಮಾಡು ಮತ್ತೆ ಕಾಲ್ ಮಾಡು"
    },
    {
      "t": "29:24",
      "text": "ಏನು"
    },
    {
      "t": "29:26",
      "text": "ಆಯ್ತು ಮೆಸೇಜ್ ಮಾಡು"
    },
    {
      "t": "29:29",
      "text": "ನಾನು ವೇಟ್ ಮಾಡ್ತೀನಿ ಫೈವ್ ಮಿನಿಟ್ಸ್ ಬಂದು"
    },
    {
      "t": "29:33",
      "text": "ಫೈವ್ ಮಿನಿಟ್ಸ್"
    },
    {
      "t": "29:36",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "29:38",
      "text": "ಯಾಕೆ"
    },
    {
      "t": "29:40",
      "text": "ಔಟ್ ಸೈಡ್ ಹೋಗಿ ಬರ್ತೀನಿ"
    },
    {
      "t": "29:43",
      "text": "ನೀವು ಹೋಗ್ಬಾರೋ ಮೆಸೇಜ್ ನಂಬರ್ ಕೊಟ್ಟಿದ್ದೀನಲ್ಲ ಮೆಸೇಜ್ ಮಾಡು"
    },
    {
      "t": "29:47",
