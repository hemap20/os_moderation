    },
    {
      "t": "00:14",
      "text": "ஹலோ"
    },
    {
      "t": "00:16",
      "text": "கேக்குதா?"
    },
    {
      "t": "00:17",
      "text": "ஆமா கேக்குது, எங்க இருந்து பேசுறீங்க?"
    },
    {
      "t": "00:22",
      "text": "நான் சென்னை, நீங்க?"
    },
    {
      "t": "00:24",
      "text": "நான் பெங்களூர்"
    },
    {
      "t": "00:27",
      "text": "என்ன பேருங்க?"
    },
    {
      "t": "00:30",
      "text": "என் பேரு அசோக், உங்க பேரு?"
    },
    {
      "t": "00:32",
      "text": "என் பேரு நிலா"
    },
    {
      "t": "00:34",
      "text": "அசோக் மேரிடா? அன்மேரிடா?"
    },
    {
      "t": "00:40",
      "text": "அன்மேரிட்"
    },
    {
      "t": "00:45",
      "text": "சிக்னல் கிடைக்கலையா அசோக்? நீங்க பேசுறது ஸ்டக் ஆகுது."
    },
    {
      "t": "00:51",
      "text": "ஹலோ"
    },
    {
      "t": "00:54",
      "text": "பேஸ் கட் தான் தெரியல, உங்க வாய்ஸ்"
    },
    {
      "t": "00:58",
      "text": "ஆ சொல்லுங்க"
    },
    {
      "t": "1:00",
      "text": "அசோக் எவ்வளவு நல்லா இருக்கீங்க?"
    },
    {
      "t": "1:05",
      "text": "நான் ஃபோர் டேஸ்"
    },
    {
      "t": "1:07",
      "text": "எப்படி பேசலாம்னு வந்தீங்க?"
    },
    {
      "t": "1:14",
      "text": "எப்படி வேணாலும் ஓகே"
    },
    {
      "t": "1:15",
      "text": "எப்படி வேணாலும் ஓகே"
    },
    {
      "t": "1:17",
      "text": "ஃபோர் டேஸ்ல யார்ட்டயும் ரியல் மீட் பண்ணிருக்கீங்களா?"
    },
    {
      "t": "1:24",
      "text": "புரியல"
    },
    {
      "t": "1:25",
      "text": "ஃபோர் டேஸா பேசி யாரையாவது கரெக்ட் பண்ணிருக்கீங்களான்னு கேட்டேன்."
    },
    {
      "t": "1:32",
      "text": "இதுக்கு அப்புறம் தான் பண்ணனும்"
    },
    {
      "t": "1:34",
      "text": "இதுக்கு அப்புறம் தான் பண்ணனும்"
    },
    {
      "t": "1:37",
      "text": "பிசிக்கல் ரிலேஷன்ஷிப் இருந்ததே இல்லையா?"
    },
    {
      "t": "1:43",
      "text": "இதுவரைக்கும் இல்ல"
    },
    {
      "t": "1:44",
      "text": "வாவ் பியூர் வெர்ஜினா?"
    },
    {
      "t": "1:49",
      "text": "ஏஜ் என்னாச்சு?"
    },
    {
      "t": "1:53",
      "text": "27"
    },
    {
      "t": "1:54",
      "text": "ஓகே ஓகே, மிஸ் பண்ணிட்டீங்களேப்பா லைஃப்"
    },
    {
      "t": "1:59",
      "text": "அப்புறம்"
    },
    {
      "t": "2:01",
      "text": "நீங்க யாரு?"
    },
    {
      "t": "2:02",
      "text": "ஆ?"
    },
    {
      "t": "2:04",
      "text": "என்ஜாய்மென்ட் மிஸ் பண்ணிட்டீங்களேன்னு, இப்ப எல்லாம் கமிட்மென்ட் தான் இருக்கும், என்ஜாய்மென்ட் இருக்காதே."
    },
    {
      "t": "2:14",
      "text": "என்ன?"
    },
    {
      "t": "2:19",
      "text": "நான் அதெல்லாம் சொல்லல"
    },
    {
      "t": "2:23",
      "text": "சரி நான் இன்னைக்கு தான் இன்ஸ்டால் பண்ணேன் இந்த ஆப், எனக்கு அதிகமா தெரியாது, எப்படி பேசணும்னு சொல்லுங்க பேசிரலாம்."
    },
    {
      "t": "2:35",
      "text": "ஓகே தாங்க"
    },
    {
      "t": "2:38",
      "text": "நீங்க ஓப்பனா பேசலாம்னு தானே வந்திருக்கீங்க, இப்ப நீங்க ஓப்பனாவே எதுனாலும் கேட்கலாம்."
    },
    {
      "t": "2:47",
      "text": "ஏன் நீங்க கேளுங்க"
    },
    {
      "t": "2:51",
      "text": "எனக்கு தெரிஞ்ச வரை கேட்டாச்சுடா, சரி ரியல் மீட் பண்ணலாம் மீட் பண்ணலாமா?"
    },
    {
      "t": "3:00",
      "text": "புரியல ரியல் மீட்டா?"
    },
    {
      "t": "3:02",
      "text": "ஆமா"
    },
    {
      "t": "3:03",
      "text": "நீங்க எந்த ஊரு சொன்னா சென்னை யா?"
    },
    {
      "t": "3:07",
      "text": "ம்ம் நான் வரேன், அமௌன்ட் எதுவும் தேவையில்லை"
    },
    {
      "t": "3:12",
      "text": "புல்பில் சாட்டிஸ்பேக்ஷன் ஒன்லி"
    },
    {
      "t": "3:18",
      "text": "பயப்படாத கடத்திட்டு எல்லாம் போகமாட்டேன்"
    },
    {
      "t": "3:20",
      "text": "புரியல"
    },
    {
      "t": "3:21",
      "text": "அமௌன்ட் எதுவும் தேவையில்லைடா, புல்பில் பண்ணா போதும், நானே வரேன் சென்னை"
    },
    {
      "t": "3:28",
      "text": "உனக்கு ஓகேவான்னு கேட்டேன்"
    },
    {
      "t": "3:34",
      "text": "அங்க மீட் பண்ற இடம் எது இருக்கா? இல்ல நீ பெங்களூர் வரியா?"
    },
    {
      "t": "3:39",
      "text": "நான் டிக்கெட் போட்டுறேன்"
    },
    {
      "t": "3:43",
      "text": "நீங்க ஒன்னுமே கேக்கலங்க, டிங் ஹேங் ஆகுது"
    },
    {
      "t": "3:46",
      "text": "நான் டிக்கெட் போட்டுறேன், நீ பெங்களூர் வரியான்னு கேட்டேன்"
    },
    {
      "t": "3:53",
      "text": "ம்ம் வரேன்"
    },
    {
      "t": "3:56",
      "text": "ஓகே"
    },
    {
      "t": "4:00",
      "text": "அப்புறம் நம்பர் தரேன் உனக்கு"
    },
    {
      "t": "4:06",
      "text": "ஹலோ"
    },
    {
      "t": "4:10",
      "text": "ம்ம் சொல்லுங்க சொல்லுங்க"
    },
    {
      "t": "4:13",
      "text": "பெங்களூர்ல எங்க?"
    },
    {
      "t": "4:16",
      "text": "ஹலோ"
    },
    {
      "t": "4:52",
      "text": "ஹலோ"
    },
    {
      "t": "4:53",
      "text": "தெரியுதா?"
    },
    {
      "t": "4:55",
      "text": "ஆ கேக்குது கேக்குது"
    },
    {
      "t": "4:58",
      "text": "ஓகே"
    },
    {
      "t": "5:00",
      "text": "உங்க நம்பர் குடுங்க, நான் வாட்ஸ்அப்ல ஹாய்னு மெசேஜ் பண்றேன், மத்த டீடைல் வாட்ஸ்அப் கால் பண்றேன்."
    },
    {
      "t": "5:08",
      "text": "ஓகே நம்பர் நோட் பண்ணிக்கோங்க"
    },
    {
      "t": "5:11",
      "text": "ஆமா சொல்லுங்க"
    },
    {
      "t": "5:13",
      "text": "அப்படியே லைன்ல இருங்க வாட்ஸ்அப் வைக்கிறேன்"
    },
    {
      "t": "5:20",
      "text": "புல்பில் பண்ணனும்னா என்ன பண்ணனும்? நம்பர் நோட் பண்ணிக்கோங்க ஃபர்ஸ்ட்."
    },
    {
      "t": "5:25",
      "text": "சொல்லுங்க"
