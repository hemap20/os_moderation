    {
      "t": "1:23",
      "text": "ಯಾ?"
    },
    {
      "t": "1:25",
      "text": "ಫ್ರೆಂಡ್"
    },
    {
      "t": "1:26",
      "text": "ಯಾ ಐ ಆಮ್ ಗುಡ್ ಫ್ರೆಂಡ್"
