      "text": "ஆமா"
    },
    {
      "t": "08:41",
      "text": "எப்படி எல்லாம் உங்கள ஊக்கணும்"
    },
    {
      "t": "08:44",
      "text": "ம்"
    },
    {
      "t": "08:46",
      "text": "எப்படி எல்லாம் உங்கள ஊக்கணும்"
    },
    {
      "t": "08:50",
      "text": "நீ ஊக்குறதுல எப்படி ஊத்தாலும் வந்து கோஆப்பரேட் பண்ணனும்"
    },
    {
      "t": "08:56",
      "text": "தூக்கி வச்சு அடிக்கணும்"
    },
    {
      "t": "08:59",
      "text": "ஆக்சன் பண்ணனும்"
    },
    {
      "t": "09:05",
      "text": "ரெண்டு கால மடிச்சு மேல தூக்கி சுன்னி எத்துக்கு"
    },
    {
      "t": "09:10",
      "text": "ம்"
    },
    {
      "t": "09:15",
      "text": "நல்லா ஊக்கணும்"
    },
    {
      "t": "09:17",
      "text": "ரொம்ப வெறி"
    },
    {
      "t": "09:19",
      "text": "ரொம்ப வெறித்தனமா இருக்கீங்க போல"
    },
    {
      "t": "09:22",
      "text": "ஆமா"
    },
    {
      "t": "09:27",
      "text": "எப்படி பண்ணனும்"
    },
    {
      "t": "09:30",
      "text": "ம்"
    },
    {
      "t": "09:32",
      "text": "உங்க மேல ரெண்டையும் கசக்கி நல்லா பால் குடிக்கணும்"
    },
    {
      "t": "09:37",
      "text": "அப்படியே சப்பி சப்பி பால் குடிக்கணும்"
    },
    {
      "t": "09:41",
      "text": "எனக்கு 38 சைஸ்"
    },
    {
      "t": "09:45",
      "text": "புரியல 38 ஆ"
    },
    {
      "t": "09:49",
      "text": "நல்ல சைஸ் தான் நல்லா பால் குடிக்கலாம்"
    },
    {
      "t": "09:52",
      "text": "வாயில பத்தாது"
    },
    {
      "t": "09:56",
      "text": "புரியல வாய் பத்தாதா"
    },
    {
      "t": "09:58",
      "text": "ம்"
    },
    {
      "t": "10:01",
      "text": "வாய் பத்தலனா என்ன"
    },
    {
      "t": "10:04",
      "text": "முடிஞ்ச வரைக்கும் உள்ள தள்ள வேண்டியதுதான்"
    },
    {
      "t": "10:11",
      "text": "நல்லா கசக்கி கசக்கி பால் குடிச்சு"
    },
    {
      "t": "10:16",
      "text": "அப்படியே பொறுமையா கீழ வந்து"
    },
    {
      "t": "10:20",
      "text": "வாய் வச்சு நல்லா நக்கும்"
    },
    {
      "t": "10:24",
      "text": "அப்படியே எடுக்கணும்"
    },
    {
      "t": "10:29",
      "text": "ம்"
    },
    {
      "t": "10:31",
      "text": "உனக்கு என்ன வாய்ஸ்னு சொன்னேன்"
    },
    {
      "t": "10:34",
      "text": "ஓட்டத்துக்குள்ள"
    },
    {
      "t": "10:36",
      "text": "என்னது"
    },
    {
      "t": "10:38",
      "text": "வாய்ஸ் என்னடா"
    },
    {
      "t": "10:41",
      "text": "என் வயசா"
    },
    {
      "t": "10:43",
      "text": "ம்"
    },
    {
      "t": "10:45",
      "text": "30"
    },
    {
      "t": "10:49",
      "text": "ஏன் எதுக்கு வயசு"
    },
    {
      "t": "10:53",
      "text": "ம்"
    },
    {
      "t": "10:55",
      "text": "சுன்னி எப்படி இருக்கும்னு யோசிக்கிறேன்"
    },
    {
      "t": "10:59",
      "text": "ம்"
    },
    {
      "t": "11:01",
      "text": "ரொம்ப பெருசா"
    },
    {
      "t": "11:03",
      "text": "சரி மாடி பொடின்னு சொல்லி குடு"
    },
    {
      "t": "11:04",
      "text": "எல்லாம்"
    },
    {
      "t": "11:07",
      "text": "என்னது"
    },
    {
      "t": "11:08",
      "text": "மாடி பொடின்னு சொல்லி குடுக்குறா சுன்னி"
    },
    {
      "t": "11:13",
      "text": "சரிடி"
    },
    {
      "t": "11:16",
      "text": "அசிங்கமா பேசுறது"
    },
    {
      "t": "11:19",
      "text": "இங்க வா பேசலாம்"
    },
    {
      "t": "11:21",
      "text": "ம்"
    },
    {
      "t": "11:23",
      "text": "எவ்வளவு அசிங்கம்"
    },
    {
      "t": "11:26",
      "text": "உன்னால எவ்வளவு முடியுதோ அவ்வளவு"
    },
    {
      "t": "11:32",
      "text": "நம்மள எவ்வளவு முடியுமோ அவ்வளவு"
    },
    {
      "t": "11:41",
      "text": "ம் தூக்கி கீழ கீழ ஊக்கணும்டி"
    },
    {
      "t": "11:44",
      "text": "ம்"
    },
    {
      "t": "11:46",
      "text": "தூக்கி கீழ கீழ ஊக்கணும்டி"
    },
    {
      "t": "11:49",
      "text": "ஆ நான் விரிப்பேன்டா"
    },
    {
      "t": "11:54",
      "text": "என்னது"
    },
    {
      "t": "11:57",
      "text": "நான் நல்லா விரிச்சு காமிப்பேன்"
    },
    {
      "t": "12:01",
      "text": "நீ நல்லா விரிச்சு காட்டுவியா"
    },
    {
      "t": "12:03",
      "text": "ஆமா"
    },
    {
      "t": "12:05",
      "text": "நீ எதுக்கு வரைக்கும் நான் ஊத்துட்டே இருப்பேன்"
    },
    {
      "t": "12:11",
      "text": "எனக்கு ஆனா இப்படி எல்லாம் பேசினா மூடு ஆகுது கல்லு எனக்கு டக்குனு வெளிய வராது"
    },
    {
      "t": "12:17",
      "text": "கஞ்சியா"
    },
    {
      "t": "12:21",
      "text": "உள்ள விட்டு செய்யணும்"
    },
    {
      "t": "12:24",
      "text": "செய்ய செய்ய தான் இது வரும்"
    },
    {
      "t": "12:28",
      "text": "சூப்பரா"
    },
    {
      "t": "12:32",
      "text": "ம்"
    },
    {
      "t": "12:34",
      "text": "அப்ப நல்லா ஊரு"
    },
    {
      "t": "12:35",
      "text": "கூடவா"
    },
    {
      "t": "12:37",
      "text": "எங்க இருக்குன்னு சொல்லு வந்து ஊத்துறேன்"
    },
    {
      "t": "12:41",
      "text": "ம்"
    },
    {
      "t": "12:48",
      "text": "சொல்லுடி"
    },
    {
      "t": "12:50",
      "text": "என்ன சொல்லணும்"
    },
    {
      "t": "12:53",
      "text": "நீ எங்க இருக்குன்னு சொல்லு வந்து ஒருத்தர் பாக்குறேன்"
    },
    {
      "t": "12:58",
      "text": "ஆமா நான் சொன்னேன்ல சுன்னி"
    },
    {
      "t": "13:02",
      "text": "கிருஷ்ணகிரி"
    },
    {
      "t": "13:06",
      "text": "என்னது சுன்னி"
    },
    {
      "t": "13:08",
      "text": "கிருஷ்ணகிரி"
    },
    {
      "t": "13:11",
      "text": "கிருஷ்ணகிரியா"
    },
    {
      "t": "13:13",
      "text": "ம்"
    },
    {
      "t": "13:14",
      "text": "கிருஷ்ணகிரி நான் வந்திருக்கேன்டி"
    },
    {
      "t": "13:17",
      "text": "ம்"
    },
    {
      "t": "13:26",
      "text": "அடுத்த வாட்டி வரும்போது வரேன்டி"
    },
    {
      "t": "13:28",
      "text": "ஓகே"
    },
    {
      "t": "13:33",
      "text": "இந்த ஒன்னு ஓகே"
    },
    {
      "t": "13:36",
      "text": "ம்"
    },
    {
      "t": "13:38",
      "text": "ஓகே"
    },
    {
      "t": "13:41",
      "text": "கிருஷ்ணகிரி"
    },
    {
      "t": "13:42",
      "text": "புரியல"
    },
    {
      "t": "13:44",
      "text": "சரிடா சுன்னி"
    },
    {
      "t": "13:48",
      "text": "ம்"
    },
    {
      "t": "13:49",
      "text": "சரி ரெடி பண்ணு"
    },
    {
      "t": "13:52",
      "text": "பண்ணு எவ்ளோ வேணாலும் நல்லா ஊத்து"
    },
    {
      "t": "13:57",
      "text": "நீ நல்லா விரிக்க விரிக்க நான் உன்ன ஊத்துட்டே இருப்பேன்"
    },
    {
      "t": "14:01",
      "text": "நீ ஊக்குறதுக்காக தான் என் பொண்டைய நான் நல்லா விரிப்பேன்"
    },
    {
      "t": "14:09",
      "text": "ம்"
    },
    {
      "t": "14:10",
      "text": "நீ விரிச்சு விரிச்சா நான் ஊத்துட்டே இருப்பேன்"
    },
    {
      "t": "14:14",
      "text": "அப்படியே விரிச்சு விரிச்சுனா"
    },
    {
      "t": "14:17",
      "text": "எடுத்து அப்படியே சுருணும்டா"
    },
    {
      "t": "14:20",
      "text": "எடுத்து எடுத்து தான் செய்வேன்"
    },
    {
      "t": "14:22",
      "text": "ஐயோ"
    },
    {
      "t": "14:24",
      "text": "அப்படியே வேகமா"
    },
    {
      "t": "14:26",
      "text": "லபக்குன்னு உள்ள விட்டு விட்டு எடுப்பேன்"
    },
    {
      "t": "14:28",
      "text": "ஐயோ"
    },
    {
      "t": "14:30",
      "text": "செமையா இருக்கும்"
    },
    {
      "t": "14:33",
      "text": "அப்படியே எடுத்து எடுத்து விடுவேன்"
    },
    {
      "t": "14:38",
      "text": "ம்"
    },
    {
      "t": "14:39",
      "text": "வேகமா குத்து குத்துன்னு குத்துவேன்"
    },
    {
      "t": "14:42",
      "text": "ம்"
    },
    {
      "t": "14:44",
      "text": "வேகமா குத்து குத்துன்னு குத்துவேன்"
    },
    {
      "t": "14:47",
      "text": "என்ன கத்தியே இருக்கீங்க"
    },
    {
      "t": "14:51",
      "text": "அப்படியே உன்ன குத்திக்கிட்டே"
    },
    {
      "t": "14:54",
      "text": "உன் பருப்பு இருக்குல்ல"
    },
    {
      "t": "14:56",
      "text": "ம்"
    },
    {
      "t": "14:57",
      "text": "கீழ"
    },
    {
      "t": "14:59",
      "text": "அந்த விரல்ல வச்சு சீண்டி சீண்டிக்கிட்டே தேய்ச்சுக்கிட்டே நான் குத்த வேண்டியது"
    },
    {
      "t": "15:04",
      "text": "ஐயோ"
    },
    {
      "t": "15:07",
      "text": "ஆமா"
    },
    {
      "t": "15:10",
      "text": "நல்லா தேய்ச்சு தேய்ச்சு குத்து குத்துன்னு குத்துவேன்"
    },
    {
      "t": "15:13",
      "text": "ம்"
    },
    {
      "t": "15:14",
      "text": "அப்படியே நெளிய நெளிய குத்திக்கிட்டே"
    },
    {
      "t": "15:18",
      "text": "ம்"
    },
    {
      "t": "15:25",
      "text": "பொண்டையில இருந்து தண்ணி வருமே"
    },
    {
      "t": "15:28",
      "text": "ஆமா"
    },
    {
      "t": "15:30",
      "text": "தண்ணி வரும்டா"
    },
    {
      "t": "15:32",
      "text": "நக்கிடு"
    },
    {
      "t": "15:34",
      "text": "ம்"
    },
    {
      "t": "15:35",
      "text": "நக்கிடு"
    },
    {
      "t": "15:36",
      "text": "நக்கிட்டு அப்படியே ஊக்கணும்"
    },
    {
      "t": "15:39",
      "text": "நக்கிட்டு எடுத்துட்டு ஊக்க"
    },
    {
      "t": "15:43",
      "text": "ஊங்குறியா"
    },
    {
      "t": "15:47",
      "text": "ம்"
    },
    {
      "t": "15:51",
      "text": "புரியல"
    },
    {
      "t": "15:53",
      "text": "ஆமா"
    },
    {
      "t": "15:58",
      "text": "நீ என்கிட்ட ஊங்குறதுக்கு நான் நக்குவேன்"
    },
    {
      "t": "16:03",
      "text": "ம்"
    },
    {
      "t": "16:04",
      "text": "நான் நல்லா ஊம்புவேன்"
    },
    {
      "t": "16:08",
      "text": "வாயில வச்சனா விடவே மாட்டேன் சுன்னியவே"
    },
    {
      "t": "16:13",
      "text": "நல்லா விடவே மாட்டேன் சொல்ற"
    },
    {
      "t": "16:17",
      "text": "ம்"
    },
    {
      "t": "16:18",
      "text": "ஒன் ஹவர்க்கு அப்படியே படுத்துகிட்டே"
    },
    {
      "t": "16:22",
      "text": "ஊதி நக்கிட்டே"
    },
    {
      "t": "16:24",
      "text": "ஐயோ"
    },
    {
      "t": "16:28",
      "text": "எப்படி"
    },
    {
      "t": "16:29",
      "text": "எப்படி கத்திக்கிட்டே இருக்க வேண்டியதுதான்"
    },
    {
      "t": "16:33",
      "text": "ம்"
    },
    {
      "t": "16:37",
      "text": "இன்னும் கத்த கத்த நான் வாய வச்சு சப்பி சப்பி"
    },
    {
      "t": "16:42",
      "text": "ம்"
    },
    {
      "t": "16:44",
      "text": "நல்லா இருக்கும்"
    },
    {
      "t": "16:47",
      "text": "நல்லா இருக்கும்டா"
    },
    {
      "t": "16:49",
      "text": "பேசும்போதே நல்லா இருக்கு"
    },
    {
      "t": "16:52",
      "text": "பண்ணா இன்னும் நல்லா இருக்கும்"
    },
    {
      "t": "16:54",
      "text": "ஆமா"
    },
    {
      "t": "17:01",
      "text": "எப்ப பண்ணலாம்"
    },
    {
      "t": "17:04",
      "text": "நிறைய எக்ஸ்ப்ளோர் பண்ணனும்"
    },
    {
      "t": "17:07",
      "text": "என்னெல்லாம்"
    },
    {
      "t": "17:08",
      "text": "என்னெல்லாம் பண்ணனும்"
    },
    {
      "t": "17:18",
      "text": "நீ வாழ்நாள்ல நினைச்சு பாக்க முடியாத மாதிரி செய்யணும்டி"
    },
    {
      "t": "17:23",
      "text": "ம் ஹும்"
    },
    {
      "t": "17:29",
      "text": "ஒரு நாளைக்கு அஞ்சு ரவுண்டு ஆறு ரவுண்டு போகணும்"
    },
    {
      "t": "17:33",
      "text": "ம்"
    },
    {
      "t": "17:37",
      "text": "ம்"
    },
    {
      "t": "17:38",
      "text": "டயர்ட் ஆயிடுவ"
    },
    {
      "t": "17:41",
      "text": "ம்"
    },
    {
      "t": "17:44",
      "text": "சும்மா சொல்லாத டயர்ட் ஆயிடுவ"
    },
    {
      "t": "17:48",
      "text": "ஒரு வாட்டி உனக்கு வெளிய வந்தாலே டயர்டு தான்"
    },
    {
      "t": "17:54",
      "text": "ம்"
    },
    {
      "t": "18:00",
      "text": "ஹஸ்பண்ட் வந்தா ஒரு நாளைக்கு எத்தனை வாட்டி பண்ணுவாரு"
    },
    {
      "t": "18:06",
      "text": "ம் மூணு"
    },
    {
      "t": "18:10",
      "text": "டெய்லியும் மூணு மூணு வாட்டியா"
    },
    {
      "t": "18:14",
      "text": "ம்"
    },
    {
      "t": "18:20",
      "text": "என்ன"
    },
    {
      "t": "18:27",
      "text": "என்ன கைய விட்டு நோண்டுறியா"
    },
    {
      "t": "18:31",
      "text": "ம் ஹும்"
    },
    {
      "t": "18:33",
      "text": "ம்"
    },
    {
      "t": "18:35",
      "text": "ம்"
    },
    {
      "t": "18:36",
      "text": "என்ன தேய்க்கிறியா"
    },
    {
      "t": "18:39",
      "text": "ம் ஹும்"
    },
    {
      "t": "18:40",
      "text": "தேய்க்கிறியா"
    },
    {
      "t": "18:43",
      "text": "ம் ஹும்"
    },
    {
      "t": "18:44",
      "text": "வேற என்ன பண்ற"
    },
    {
      "t": "18:47",
      "text": "என்ன ஆசை"
    },
    {
      "t": "18:52",
      "text": "சொல்லுடி"
    },
    {
      "t": "18:54",
      "text": "என்ன பண்ற"
    },
    {
      "t": "18:58",
      "text": "ம் ஹும்"
    },
    {
      "t": "19:00",
      "text": "என்ன"
    },
    {
      "t": "19:03",
      "text": "ம் ஹும்"
    },
    {
      "t": "19:05",
      "text": "தப்போ"
    },
    {
      "t": "19:10",
      "text": "புரியல"
    },
    {
      "t": "19:13",
      "text": "ஒன்னும் இல்லடா"
    },
    {
      "t": "19:15",
      "text": "ஹலோ"
    },
    {
      "t": "19:18",
      "text": "ம்"
    },
    {
      "t": "19:19",
      "text": "போதுமா"
    },
    {
      "t": "19:21",
      "text": "எனக்கு பத்தாது"
    },
    {
      "t": "19:24",
      "text": "ம்"
    },
    {
      "t": "19:26",
      "text": "எப்போ பத்தற அளவுக்கு எவ்ளோ வேணுமோ அப்போ அதுவரைக்கும் செய்ய வேண்டியதுதான்"
    },
    {
      "t": "19:35",
      "text": "ம்"
    },
    {
      "t": "19:37",
      "text": "உனக்கு என்ன ஆசை எது மாதிரி பண்ணனும்னு ஆசை"
    },
    {
      "t": "19:44",
      "text": "நான் வாய் வச்சே உனக்கு வரவேற்கணுமா"
    },
    {
      "t": "19:55",
      "text": "ஏய்"
    },
    {
      "t": "19:58",
      "text": "கேக்குதா"
    },
    {
      "t": "20:05",
      "text": "ஹலோ"
    },
    {
      "t": "20:10",
      "text": "அது கேக்குதா"
    }
  ]
}