  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:02",
      "text": "ഹലോ ഹലോ"
    },
    {
      "t": "00:04",
      "text": "കേൾക്കുന്നുണ്ടോ"
    },
    {
      "t": "00:06",
      "text": "കേൾക്കുന്നുണ്ടോ ഇത് ആരാ"
    },
    {
      "t": "00:08",
      "text": "എന്റെ പേര് അർജുൻ എന്നാണ്"
    },
    {
      "t": "00:10",
      "text": "മലപ്പുറത്തുനിന്നാണ് നിങ്ങള്"
    },
    {
      "t": "00:12",
      "text": "എന്റെ പേര് അശ്വതി എന്റെ സ്ഥലം കൊല്ലത്താണ് ഞാൻ കൊല്ലത്തുനിന്നാണ് സംസാരിക്കുന്നത്"
    },
    {
      "t": "00:19",
      "text": "ഓ എത്ര വയസ്സുണ്ട് നിങ്ങൾക്ക്"
    },
    {
      "t": "00:21",
      "text": "എനിക്ക് 36 കഴിഞ്ഞു"
    },
    {
      "t": "00:24",
      "text": "ഓ മാരീഡ് ആണോ അപ്പോ"
    },
    {
      "t": "00:26",
      "text": "ആ ഇപ്പൊ മാരീഡ് ആണ്"
    },
    {
      "t": "00:29",
      "text": "ഹസ്ബൻഡ് എന്താ ചെയ്യുന്നത്"
    },
    {
      "t": "00:31",
      "text": "ഹസ്ബൻഡ് ഡ്രൈവർ ആണ്"
    },
    {
      "t": "00:33",
      "text": "ഉം"
    },
    {
      "t": "00:34",
      "text": "അപ്പൊ ഇപ്പൊ എന്ത് പറയാ"
    },
    {
      "t": "00:36",
      "text": "ഇല്ല"
    },
    {
      "t": "00:37",
      "text": "ഇന്ന് ഇന്നലെ എടുത്തിട്ടിട്ടുണ്ടായിരുന്നു"
    },
    {
      "t": "00:40",
      "text": "ഇന്ന് അവര് വിളിച്ചല്ലോ ഓക്കെ ആക്കിയിട്ട്"
    },
    {
      "t": "00:42",
      "text": "സംഭവം എന്താണെന്ന് എനിക്ക് അറിയില്ല സംഭവം എന്താ"
    },
    {
      "t": "00:45",
      "text": "ഇതിനകത്ത് സംസാരിക്കുമ്പോൾ എന്താ കിട്ടുക"
    },
    {
      "t": "00:48",
      "text": "പേയ്മെന്റ് കിട്ടും നിങ്ങൾക്ക് പെർ മിനിറ്റിന്"
    },
    {
      "t": "00:52",
      "text": "എങ്ങനെ നമുക്ക് പേയ്മെന്റ് നമ്മുടെ അക്കൗണ്ടിൽ വരും"
    },
    {
      "t": "00:55",
      "text": "ഇതിനകത്ത് കോയിൻ ആയിട്ടായിരിക്കും നിങ്ങൾക്ക് കേറുന്നത് എനിക്ക് അറിയില്ല അതിനെപ്പറ്റി"
    },
    {
      "t": "00:59",
      "text": "ഓ"
    },
    {
      "t": "01:01",
      "text": "എങ്ങനെയാ"
    },
    {
      "t": "01:03",
      "text": "പിന്നെ"
    },
    {
      "t": "01:04",
      "text": "അപ്പൊ എല്ലാവർക്കും അറിയോ അപ്പുറത്തുള്ളവർക്ക്"
    },
    {
      "t": "01:07",
      "text": "ഉം"
    },
    {
      "t": "01:08",
      "text": "അപ്പുറത്തുള്ളവർക്ക് വേറെ ആർക്കെങ്കിലും അറിയോ അപ്പുറത്തുള്ളവർക്ക്"
    },
    {
      "t": "01:11",
      "text": "ഇല്ലില്ല ഇത് ഓൺ ആക്കിയാലല്ലേ മറ്റേ"
    },
    {
      "t": "01:14",
      "text": "ഓഡിയോ കോൾ ഓൺ ആക്കിയാലല്ലേ കോൾ വരുത്തുള്ളൂ"
    },
    {
      "t": "01:18",
      "text": "ഉം"
    },
    {
      "t": "01:19",
      "text": "പിന്നെ ഹസ്ബൻഡ് ഹസ്ബൻഡ് വിളിക്കില്ല ഹസ്ബൻഡ് ഞാൻ ഇട്ടു ശകടാ"
    },
    {
      "t": "01:22",
      "text": "മിണ്ടും ഇപ്പൊ രണ്ടു ദിവസം കൊണ്ട് മിണ്ടും ശകടാ ശകടാ പുള്ളി ഇങ്ങോട്ട് വരത്തില്ല"
    },
    {
      "t": "01:27",
      "text": "ഓക്കേ"
    },
    {
      "t": "01:29",
      "text": "ഇതിനകത്ത് ഓപ്പൺ ടോക്ക് എന്ന് പറയുന്ന സംഭവം ഉണ്ട്"
    },
    {
      "t": "01:31",
      "text": "ഏ"
    },
    {
      "t": "01:33",
      "text": "അതായത് ഇതിനകത്തുള്ള ഒരുപാട് ആൾക്കാരൊക്കെ ഓപ്പൺ ടോക്ക് ചോദിച്ചിട്ടാണ് വരിക"
    },
    {
      "t": "01:37",
      "text": "അതെന്നുവെച്ചാൽ"
    },
    {
      "t": "01:39",
      "text": "അതെന്നുവെച്ചാൽ നമ്മൾ ഓപ്പൺ ആയിട്ട് എല്ലാം സംസാരിക്കാൻ പറ്റണം"
    },
    {
      "t": "01:43",
      "text": "അതിപ്പോ സത്യം പറഞ്ഞാൽ"
    },
    {
      "t": "01:45",
      "text": "മൂഷായിട്ട് പറഞ്ഞാൽ ഇതിനകത്ത് നമ്മളെ വിളിച്ച് അവരുടെ അവരോട് പറഞ്ഞാൽ മതി എന്നാ പറഞ്ഞേ"
    },
    {
      "t": "01:50",
      "text": "അങ്ങനെയല്ല"
    },
    {
      "t": "01:52",
      "text": "ആ അത് എനിക്ക് അറിയില്ല"
    },
    {
      "t": "01:54",
      "text": "ആ അങ്ങനെ മോസ്റ്റ് ഓഫ് ദി ആൾക്കാരും അങ്ങനെയാ വരിക ഓപ്പൺ ടോക്ക് ചോദിച്ചിട്ടാണ് വരിക"
    },
    {
      "t": "02:00",
      "text": "ഓ"
    },
    {
      "t": "02:02",
      "text": "അപ്പൊ നിങ്ങൾക്ക് താല്പര്യം ഇല്ല എന്നുണ്ടെങ്കിൽ താല്പര്യം ഇല്ല എന്ന് പറയാം"
    },
    {
      "t": "02:05",
      "text": "ആ ഞാൻ കട്ട് ആക്കി വിട്ടു നേരത്തെ ഒരു ചെറുക്കനാണോ എന്ന് എനിക്ക് അറിയില്ല ഒരാൾ ചോദിച്ചിട്ട്"
    },
    {
      "t": "02:11",
      "text": "എത്രയാ നീളം വണ്ണം ഉണ്ടോ"
    },
    {
      "t": "02:14",
      "text": "എന്നെ ഒന്ന് കാണിച്ചു തരുമോ എന്നൊക്കെ ചോദിച്ചു അപ്പൊ ഞാൻ അത് കട്ട് ആക്കി വിട്ടു ബ്ലോക്ക് എനിക്ക് അറിയില്ല കട്ട് ആക്കി വിട്ടു"
    },
    {
      "t": "02:21",
      "text": "അതാ പറഞ്ഞേ ഇതിനകത്ത് അങ്ങനത്തെ കുറച്ചു പ്രശ്നങ്ങൾ ഉണ്ട്"
    },
    {
      "t": "02:24",
      "text": "ശ്രദ്ധിച്ചു യൂസ് ചെയ്യുക കേട്ടോ"
    },
    {
      "t": "02:26",
      "text": "ഉം"
    },
    {
      "t": "02:29",
      "text": "ഫുഡ് കഴിച്ചോ"
    }
  ]
}