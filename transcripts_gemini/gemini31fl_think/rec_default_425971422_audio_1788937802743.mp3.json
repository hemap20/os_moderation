  "segments": [
    {
      "t": "00:07",
      "text": "എവിടെന്നാണ്?"
    },
    {
      "t": "00:09",
      "text": "ഇതമാലി"
    },
    {
      "t": "00:11",
      "text": "എന്താ പരിപാടി?"
    },
    {
      "t": "00:13",
      "text": "ഒരു പരിപാടിയുമില്ല വെറുതെ ഇരിക്കുകയാണ്"
    },
    {
      "t": "00:16",
      "text": "ഓക്കേ ഓക്കേ ഓക്കേ"
    },
    {
      "t": "00:18",
      "text": "ബാക്കിയുള്ളവരൊക്കെ എവിടെയാ? വീട്ടിൽ ആരൊക്കെയുണ്ട്?"
    },
    {
      "t": "00:20",
      "text": "ഹസ്ബൻഡ് കുട്ടികൾ"
    },
    {
      "t": "00:22",
      "text": "അവരൊക്കെ എവിടെയാ?"
    },
    {
      "t": "00:24",
      "text": "കുട്ടികൾ സ്കൂളിൽ പോയി"
    },
    {
      "t": "00:27",
      "text": "ചേട്ടൻ?"
    },
    {
      "t": "00:29",
      "text": "ജോലിക്ക് പോയി"
    },
    {
      "t": "00:31",
      "text": "അപ്പൊ ചുമ്മാ ബോറടിച്ചു ഇരിക്കുകയാണ്"
    },
    {
      "t": "00:36",
      "text": "അവിടെ ആരൊക്കെയുണ്ട്?"
    },
    {
      "t": "00:38",
      "text": "ഇവിടെ അച്ഛൻ അമ്മ അനിയൻ അനിയത്തി അത്രേ ഉള്ളൂ"
    },
    {
      "t": "00:41",
      "text": "അനിയത്തി"
    },
    {
      "t": "00:43",
      "text": "അച്ഛൻ അമ്മ അനിയൻ അനിയത്തി"
    },
    {
      "t": "00:46",
      "text": "മേരിയുടെ?"
    },
    {
      "t": "00:48",
      "text": "അല്ലല്ലല്ല"
    },
    {
      "t": "00:51",
      "text": "എന്താ?"
    },
    {
      "t": "00:54",
      "text": "വർക്കില്ലേ എന്ന്"
    },
    {
      "t": "00:56",
      "text": "ഇന്നലെ ഇവിടുത്തെ"
    },
    {
      "t": "00:58",
      "text": "അവിടെ സ്ഥലം എവിടെയാ?"
    },
    {
      "t": "1:00",
      "text": "തൃശ്ശൂർ തൃശ്ശൂർ തൃശ്ശൂർ"
    },
    {
      "t": "1:03",
      "text": "തൃശ്ശൂർ ആണ്"
    },
    {
      "t": "1:05",
      "text": "എന്തായാലും കുഴപ്പമില്ല"
    },
    {
      "t": "1:07",
      "text": "എന്തായാലും വല്ല ഫ്രണ്ട്സിനെ കിട്ടിയോ?"
    },
    {
      "t": "1:10",
      "text": "നിങ്ങൾ എത്ര കാലമായി ഇതിൽ?"
    },
    {
      "t": "1:13",
      "text": "രണ്ടാഴ്ച"
    },
    {
      "t": "1:16",
      "text": "ഞാൻ ഏകദേശം അത്ര തന്നെ ആയിട്ടുള്ളൂ"
    },
    {
      "t": "1:20",
      "text": "രണ്ടാഴ്ച"
    },
    {
      "t": "1:22",
      "text": "ഓക്കേ എങ്ങനെയുണ്ട് ചേട്ടന്മാരൊക്കെ വന്നിട്ട് എന്തെങ്കിലും ഒക്കെ ചോദിച്ചായിരുന്നോ?"
    },
    {
      "t": "1:27",
      "text": "ചേട്ടന്മാർ പണിയില്ലാണ്ടല്ലേ വരുന്നത് ചോദിക്കാൻ വേണ്ടിയിട്ടല്ലേ വരുന്നേ"
    },
    {
      "t": "1:32",
      "text": "കുറെ ചേച്ചിമാരും കുഴപ്പമൊന്നുമില്ല"
    },
    {
      "t": "1:35",
      "text": "ഞാനൊക്കെ നേരിട്ട് അനുഭവിച്ചതാണ്"
    },
    {
      "t": "1:38",
      "text": "നേരിട്ട് അനുഭവിച്ചോ?"
    },
    {
      "t": "1:40",
      "text": "നേരിട്ട് അനുഭവിച്ചു എന്ന് പറഞ്ഞാൽ"
    },
    {
      "t": "1:43",
      "text": "ഒരെണ്ണം കിട്ടി"
    },
    {
      "t": "1:46",
      "text": "ഒരെണ്ണം നേരിട്ടോ?"
    },
    {
      "t": "1:49",
      "text": "കൊച്ചിയിലേക്ക് വന്നു"
    },
    {
      "t": "1:52",
      "text": "ആഹാ"
    },
    {
      "t": "1:54",
      "text": "അത് വലിയ കാര്യമില്ല"
    },
    {
      "t": "1:57",
      "text": "എന്താ പറ്റി?"
    },
    {
      "t": "2:00",
      "text": "ഒരു ചെറിയ ഒരു കുറവ്"
    },
    {
      "t": "2:04",
      "text": "എന്ത് കുറവ്?"
    },
    {
      "t": "2:07",
      "text": "എന്താ പറയുക ഒരു"
    },
    {
      "t": "2:10",
      "text": "പഞ്ചിങ് കുറവ്"
    },
    {
      "t": "2:12",
      "text": "ഉന്മേഷക്കുറവ്"
    },
    {
      "t": "2:14",
      "text": "ഉന്മേഷക്കുറവ്"
    },
    {
      "t": "2:16",
      "text": "കുഴപ്പമില്ല എന്തായാലും കാര്യം"
    },
    {
      "t": "2:20",
      "text": "പിന്നെ ഫ്രണ്ട്സ് ഒക്കെ ആയോ നോർമലി?"
    },
    {
      "t": "2:23",
      "text": "ആ കുറച്ചു ആൾക്കാര്"
    },
    {
      "t": "2:25",
      "text": "വിളിക്കാറുണ്ടോ?"
    },
    {
      "t": "2:27",
      "text": "ടെലിഗ്രാമിൽ ചാറ്റ് ചെയ്യും"
    },
    {
      "t": "2:31",
      "text": "എന്താ വർക്ക് ചെയ്യുന്നത്?"
    },
    {
      "t": "2:33",
      "text": "എനിക്ക് സ്വന്തമായിട്ട് ഷോപ്പാണ്"
    },
    {
      "t": "2:36",
      "text": "തൃശ്ശൂർ തന്നെയാ?"
    },
    {
      "t": "2:38",
      "text": "തൃശ്ശൂർ"
    },
    {
      "t": "2:40",
      "text": "എന്തിന്റെയാ?"
    },
    {
      "t": "2:42",
      "text": "എന്തിന്റെ ഷോപ്പാണ്?"
    },
    {
      "t": "2:44",
      "text": "ബുള്ളറ്റിന്റെ സ്പെയർ പാർട്സ് ബൈക്കിന്റെ സ്പെയർ പാർട്സുകൾ ഹോൾസെയിൽ റീട്ടെയിൽ"
    },
    {
      "t": "2:49",
      "text": "ഹോൾസെയിൽ ആണോ?"
    },
    {
      "t": "2:51",
      "text": "ഹോൾസെയിലും ഉണ്ട് റീട്ടെയിലും ഉണ്ട്"
    },
    {
      "t": "2:54",
      "text": "എന്തായാലും നടക്കട്ടെ"
    },
    {
      "t": "2:57",
      "text": "എന്താ?"
    },
    {
      "t": "2:58",
      "text": "ഇന്ന് പോയില്ലേ എന്ന്"
    },
    {
      "t": "3:00",
      "text": "ഇല്ല ഇന്ന് പോയില്ല ഞാൻ കുറച്ചു പരിപാടി ഉണ്ട് അതുകൊണ്ട് പോയില്ല"
    },
    {
      "t": "3:04",
      "text": "എന്തായാലും കാര്യങ്ങൾ ഒക്കെ കേട്ട പരിചയപ്പെട്ടതിൽ വളരെ സന്തോഷം നോർമൽ ചാറ്റ് അല്ലേ നിങ്ങൾ ഉദ്ദേശിക്കുന്നത്"
    },
    {
      "t": "3:10",
      "text": "നല്ലതാ നന്നായി അത്"
    }
  ]
}