  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:04",
      "text": "എവിടുന്നാ?"
    },
    {
      "t": "00:06",
      "text": "ഞാൻ ട്രിവാൻഡ്രം ആണ്. ഇത് എവിടെയാ?"
    },
    {
      "t": "00:09",
      "text": "ഇത് കൊല്ലം"
    },
    {
      "t": "00:12",
      "text": "ഓക്കേ എന്ത് ചെയ്യുന്നു?"
    },
    {
      "t": "00:14",
      "text": "ഞാന് ഒത്തുറ്റി വർക്ക് ചെയ്യുമായിരുന്നു. ഇപ്പോ ഒന്നും ചെയ്യുന്നില്ല."
    },
    {
      "t": "00:20",
      "text": "ഓക്കേ ഒരുങ്ങിയൊക്കെ ആണല്ലോ ഇരിക്കുന്നത്. രാത്രി ഉറക്കമില്ലേ?"
    },
    {
      "t": "00:24",
      "text": "രാവിലെ ഇനിയിപ്പോ അയ്യോ ഇത് ഞാൻ ഇന്നലെ രാവിലെ ഛേ സോറി ഇന്നലെ നൈറ്റ്"
    },
    {
      "t": "00:30",
      "text": "ആണോ?"
    },
    {
      "t": "00:34",
      "text": "പിന്നെന്താ പരിപാടി ഉറങ്ങാതെ ഇരുന്നത്?"
    },
    {
      "t": "00:36",
      "text": "എനിക്ക് രാവിലെ കുറച്ച് പൈസ വേണം ടോ"
    },
    {
      "t": "00:39",
      "text": "ആണോ?"
    },
    {
      "t": "00:41",
      "text": "അതിന്"
    },
    {
      "t": "00:44",
      "text": "അതിനിരിക്കുകയാണ്"
    },
    {
      "t": "00:45",
      "text": "ഉണ്ട് ഓപ്പൺ ഉണ്ട് വാട്സാപ്പിലാണ് പെയ്ഡ് സർവീസ് ആണ്"
    },
    {
      "t": "00:50",
      "text": "അതെന്താ അങ്ങനെ?"
    },
    {
      "t": "00:52",
      "text": "ഇതിൽ നിന്ന് അഞ്ചു രൂപ വെച്ച് കിട്ടുന്നുണ്ട് നമുക്ക് ഒരു മിനിറ്റിന്"
    },
    {
      "t": "00:55",
      "text": "സോ ഫ്രീ ആയിട്ട് ചെയ്യേണ്ട കാര്യം നമുക്കില്ലല്ലോ"
    },
    {
      "t": "00:59",
      "text": "ഇതിൽ കിട്ടുന്നുണ്ടല്ലോ"
    },
    {
      "t": "01:01",
      "text": "ഇതിൽ കിട്ടുന്നുണ്ടെങ്കിൽ"
    },
    {
      "t": "01:03",
      "text": "യുവർ ചോയ്സ്"
    },
    {
      "t": "01:05",
      "text": "ഞാൻ പറഞ്ഞന്നേയുള്ളൂ ഞാൻ ചെയ്യുന്നെങ്കിൽ ഞാൻ വാട്സാപ്പിൽ ചെയ്യാറുള്ളൂ"
    },
    {
      "t": "01:08",
      "text": "എനിക്ക് സേഫ്റ്റി ഇഷ്യൂ കാരണം പേടിയാണ്"
    },
    {
      "t": "01:15",
      "text": "ഓക്കേ"
    },
    {
      "t": "01:18",
      "text": "ബൈ ബൈ വേറെ നോക്കിക്കോ"
    }
  ]
}