    },
    {
      "t": "00:05",
      "text": "ஹாய்"
    },
    {
      "t": "00:06",
      "text": "நீங்க எங்க இருந்து கல் பண்றீங்க?"
    },
    {
      "t": "00:08",
      "text": "நான் ஆம்பூர்"
    },
    {
      "t": "00:10",
      "text": "ஆம்பூர்"
    },
    {
      "t": "00:11",
      "text": "ம்"
    },
    {
      "t": "00:12",
      "text": "ஓகே ஓகே நான் கோயம்புத்தூர்."
    },
    {
      "t": "00:15",
      "text": "ஓகே சொல்லுங்க"
    },
    {
      "t": "00:17",
      "text": "என்ன பண்றீங்க?"
    },
    {
      "t": "00:19",
      "text": "நான் ஒர்க் பண்ணிட்டு இருக்கேன் இப்போ சும்மாதான் ரூம்ல இருக்கேன்."
    },
    {
      "t": "00:23",
      "text": "லீவா இன்னைக்கு?"
    },
    {
      "t": "00:24",
      "text": "இல்ல லீவு."
    },
    {
      "t": "00:26",
      "text": "சரி சரி ஓகே நானும் ஒரு பிரைவேட் கம்பெனில ஒர்க் பண்ணிட்டு இருக்கேன்."
    },
    {
      "t": "00:29",
      "text": "சரி"
    },
    {
      "t": "00:30",
      "text": "இன்னைக்கு நானும் லீவு."
    },
    {
      "t": "00:32",
      "text": "ஓகே ஓகே ஓகே"
    },
    {
      "t": "00:35",
      "text": "அப்புறம் சொல்லுங்க லஞ்ச் முடிஞ்சுச்சா?"
    },
    {
      "t": "00:37",
      "text": "முடிஞ்சிச்சு முடிஞ்சிட்டு தான் பாத்துட்டு இருக்கேன்."
    },
    {
      "t": "00:40",
      "text": "ஓகே ஓகே என்ன சாப்டீங்க?"
    },
    {
      "t": "00:43",
      "text": "சாதம்தான் சாதம் தயிர்."
    },
    {
      "t": "00:45",
      "text": "சாதம் தயிர்."
    },
    {
      "t": "00:49",
      "text": "அப்புறம்"
    },
    {
      "t": "00:50",
      "text": "அப்புறம் சொல்லுங்க லைஃப் எல்லாம் எப்படி போகுது?"
    },
    {
      "t": "00:53",
      "text": "ஏதோ போகுது உங்களுக்கு?"
    },
    {
      "t": "00:55",
      "text": "ஆ போகுது."
    },
    {
      "t": "01:00",
      "text": "அப்புறம் சொல்லுங்க வேற"
    },
    {
      "t": "01:04",
      "text": "வேற என்ன சொல்றது?"
    },
    {
      "t": "01:07",
      "text": "வேற என்ன சொல்றது இந்த ஆப் எத்தனை நாளா யூஸ் பண்ணிட்டு இருக்கீங்க?"
    },
    {
      "t": "01:10",
      "text": "இந்த ஆப் இப்பதான் ஜஸ்ட் ஒரு ஒன் வீக்கா?"
    },
    {
      "t": "01:12",
      "text": "ஒன் வீக் ஓகே எப்படி பேசுறாங்க?"
    },
    {
      "t": "01:15",
      "text": "ஒவ்வொருத்தரும் ஜாலியா பேசுறாங்க ஒவ்வொருத்தரும் செக்ஸியா பேசுறாங்க."
    },
    {
      "t": "01:21",
      "text": "யாரை எப்படி பேசுறாங்களோ அப்படி பேசிட்டு போயிட வேண்டியதுதான்."
    },
    {
      "t": "01:25",
      "text": "சூப்பர்."
    },
    {
      "t": "01:28",
      "text": "அவங்களுக்கு ஜாலியா பேசறது புடிச்சிருக்கா இல்ல செக்ஸியா பேசறது புடிச்சிருக்கா?"
    },
    {
      "t": "01:32",
      "text": "ரெண்டுமே தான்."
    },
    {
      "t": "01:34",
      "text": "ரெண்டுமே ஏதோ ஒன்னுதான் சொல்லணும் ரெண்டுமேன்னா எப்படி?"
    },
    {
      "t": "01:37",
      "text": "ஜாலியா பேசுறேங்க கிட்ட ஜாலியா பேசவேண்டியதுதான் செக்ஸியா பேசுறேங்க கிட்ட செக்ஸியா பேசவேண்டியதுதான்."
    },
    {
      "t": "01:45",
      "text": "சொல்லுங்க சொந்த ஊரே ஆம்பூரா இல்ல"
    },
    {
      "t": "01:51",
      "text": "சொந்த ஊரே ஆம்பூர்தான்."
    },
    {
      "t": "01:53",
      "text": "ஓகே வீட்ல வீட்ல மம்மி டாடி."
    },
    {
      "t": "01:59",
      "text": "அப்புறம் கேர்ள் பிரண்ட்ஸ் எல்லாம் இருக்காங்களா?"
    },
    {
      "t": "02:02",
      "text": "கேர்ள் பிரண்ட் இருந்தா எதுக்கு இந்த ஆப்ல வரோம்."
    },
    {
      "t": "02:04",
      "text": "அதை ஏன்ங்க எல்லாரும் இதே டயலாக் சொல்றீங்க கேர்ள் பிரண்ட் இருந்தா ஏங்க நாங்க இந்த ஆப்புக்கு வரோம் அப்படின்னு."
    },
    {
      "t": "02:09",
      "text": "உண்மையான விஷயம் தானே கேர்ள் பிரண்ட் இருந்தா அவங்ககிட்ட பேசிட்டு இருக்கறதுக்கே டைம் சரியா போயிடும்ல."
    },
    {
      "t": "02:14",
      "text": "ஆமா."
    },
    {
      "t": "02:19",
      "text": "சொல்லுங்க."
    },
    {
      "t": "02:21",
      "text": "அப்புறம் வேற"
    },
    {
      "t": "02:24",
      "text": "வேற என்ன சொல்றது வேற என்ன சொல்றது வேற என்ன கேட்கறதுன்னு தெரியலையே."
    },
    {
      "t": "02:29",
      "text": "ஏதாச்சும் கேளுங்க நான் சொல்றேன்."
    },
    {
      "t": "02:32",
      "text": "புரிஞ்சில."
    },
    {
      "t": "02:33",
      "text": "ஏதாச்சும் கேளுங்க நல்லா சொல்லுங்க."
    },
    {
      "t": "02:40",
      "text": "நீங்க ஏதாச்சும் கேளுங்க நான் பதில் சொல்றேன்."
    },
    {
      "t": "02:45",
      "text": "நீங்க எப்படி பேசுவீங்க?"
    },
    {
      "t": "02:49",
      "text": "நான் ஜாலியாதான் பேசுறேன் ஆனா செக்ஸியா பேச மாட்டேன் நார்மல்."
    },
    {
      "t": "02:51",
      "text": "ஓகே ஜாலியா பேசுனா போதும்."
    }
  ]
}