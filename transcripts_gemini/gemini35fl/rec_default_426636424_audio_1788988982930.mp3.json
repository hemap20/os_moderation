  "segments": [
    {
      "t": "00:01",
      "text": "ಹಲೋ."
    },
    {
      "t": "00:03",
      "text": "ಹಲೋ."
    },
    {
      "t": "00:05",
      "text": "ಎಲ್ಲಿಂದ?"
    },
    {
      "t": "00:07",
      "text": "ಬೆಂಗಳೂರಿಂದ ನೀವು."
    },
    {
      "t": "00:10",
      "text": "ನಾನು ಬೆಂಗಳೂರು ಯಾವ ಊರು?"
    },
    {
      "t": "00:14",
      "text": "ಶಂಕರಘಟ್ಟೆ."
    },
    {
      "t": "00:17",
      "text": "ಹೌದಾ."
    },
    {
      "t": "00:19",
      "text": "ಅಕ್ಕ ಕಾಲೇಜ್ ಅಲ್ಲಿ ಓದಿಸಬೇಕು."
    },
    {
      "t": "00:25",
      "text": "ಶಂಕರಘಟ್ಟೆನಾ?"
    },
    {
      "t": "00:29",
      "text": "ಹೌದು."
    },
    {
      "t": "00:31",
      "text": "ಮದುವೆ ಆಗಿದೆಯಾ?"
    },
    {
      "t": "00:33",
      "text": "ಹಾಗಿದೆ."
    },
    {
      "t": "00:36",
      "text": "ನಮ್ಮ ಮದುವೆ ಆದ್ಮೇಲೆ ಇವರೇ ಕಾಣೋದಿಲ್ಲರಿ."
    },
    {
      "t": "00:40",
      "text": "ನಮಗೂ ಸ್ವಲ್ಪ ಇಷ್ಟ ಆಗುತ್ತೆ ಮದುವೆ ಆದ್ಮೇಲೆ."
    },
    {
      "t": "00:43",
      "text": "ಓಕೆ."
    },
    {
      "t": "00:46",
      "text": "ಗಂಡ ಏನ್ ಮಾಡೋದು?"
    },
    {
      "t": "00:48",
      "text": "ಅ."
    },
    {
      "t": "00:49",
      "text": "ಗಂಡ ಏನ್ ಮಾಡೋದು ಅಂದ್ರೆ."
    },
    {
      "t": "00:51",
      "text": "ಡ್ರೈವಿಂಗ್."
    },
    {
      "t": "00:53",
      "text": "ಹೌದಾ?"
    },
    {
      "t": "00:56",
      "text": "ಲಂಗ್ ಟ್ರೀಪ್ ಹೋಗ್ತಾರಾ ಅಥವಾ ಏನೋ?"
    },
    {
      "t": "00:59",
      "text": "ನೈಟ್ ಲಾಂಗ್ ಹೋಗ್ತಾರೆ ನೈಟ್."
    },
    {
      "t": "01:11",
      "text": "ಮಕ್ಕಳಾಗಿಲ್ವಾ ಅಂದ್ರೆ?"
    },
    {
      "t": "01:13",
      "text": "ಇಲ್ಲ."
    },
    {
      "t": "01:17",
      "text": "ಮಕ್ಕಳಾಗಿದ್ರೆ ಎಷ್ಟು ನೂರು"
    },
    {
      "t": "01:23",
      "text": "ನೋಡೋದು ನೋಡಬೇಡಿ."
    },
    {
      "t": "01:28",
      "text": "ನೋಡದೆ ಇರೋಕೆ ಆಗಲ್ಲ"
    },
    {
      "t": "01:31",
      "text": "ಶೇಪ್ ಮಾಡ್ಕೊಳ್ತಾರೆ."
    },
    {
      "t": "01:35",
      "text": "ಶೇಪ್ ಮಾಡಿ ಲಾಂಗ್."
    },
    {
      "t": "01:38",
      "text": "ಏನು?"
    },
    {
      "t": "01:40",
      "text": "ಬಂದು ಹೋಗಿ ಶೇಪ್ ಮಾಡ್ಕೊಳ್ಳೋದು ಅಂದ್ರೆ."
    },
    {
      "t": "01:48",
      "text": "ಗಂಡ ಏನ್ ಮಾಡೋದು?"
    },
    {
      "t": "01:50",
      "text": "ಅದರ ಬಗ್ಗೆ ನನಗೆ ಇಂಟರೆಸ್ಟ್ ಇಲ್ಲ ನಾರ್ಮಲ್ ಟಾಕ್ ಅಷ್ಟೇ."
    },
    {
      "t": "01:55",
      "text": "ಹೆಲ್ತ್ ಪ್ರೆಸ್ ಅಂತ."
    },
    {
      "t": "01:58",
      "text": "ನನ್ನ ಫ್ರೆಂಡ್ಸ್"
    },
    {
      "t": "02:04",
      "text": "ಕೆಲವರ ಪಾರ್ಟ್ ಅಲ್ಲಿ ಇಟ್ಟು ಮಾಡೋದು."
    },
    {
      "t": "02:09",
      "text": "ಅಲ್ಲಕ ಹಾಕೋದು ಇಷ್ಟ ಆಗ್ತಾ ಇರುತ್ತಲ್ಲ."
    },
    {
      "t": "02:13",
      "text": "ನನಗೆ ಅವೆಲ್ಲ ಇಷ್ಟ ಇಲ್ಲ."
    },
    {
      "t": "02:15",
      "text": "ಮದುವೆ ಆದ್ಮೇಲೆ ಮಾಡಿದ್ ಮಾತ."
    },
    {
      "t": "02:19",
      "text": "ಮಾಡಿದ್ವಾ?"
    },
    {
      "t": "02:22",
      "text": "ಯಾಕೆ?"
    },
    {
      "t": "02:25",
      "text": "ಅವರಿಗೆ ಇಷ್ಟ ಇಲ್ವಾ ಮದುವೆ ಮಾಡಿಲ್ವಾ."
    },
    {
      "t": "02:30",
      "text": "ಮತ್ತೆ ಏನ್ ಮಾಡ್ತಾರೆ?"
    },
    {
      "t": "02:33",
      "text": "ನಂಗೆ ಇಷ್ಟ ಇಲ್ಲ."
    },
    {
      "t": "02:35",
      "text": "ಮತ್ತೆ ಏನ್ ಮಾಡ್ತೀರಾ ಸೆಕ್ಸ್ ಮಾಡಲ್ವಾ?"
    },
    {
      "t": "02:41",
      "text": "ಯಾಕೆ?"
    },
    {
      "t": "02:43",
      "text": "ನಂಗೆ ಇಷ್ಟ ಇಲ್ಲ."
    },
    {
      "t": "02:46",
      "text": "ಮಾಡ್ಲಿ ಇಷ್ಟ ಆಗೋತರ ಮಾಡ್ತೀನಿ."
    },
    {
      "t": "02:50",
      "text": "ಮಾಡ್ಲಿ ಇಷ್ಟ ಆಗೋತರ ಮಾಡ್ತೀನಿ ಅಂದ್ರೆ."
    },
    {
      "t": "02:54",
      "text": "ಅಲ್ಲೇ ಬಾಯಿ ಹಾಕೊಂಡಿರ್ತೀನಿ."
    },
    {
      "t": "02:56",
      "text": "ಅಲ್ಲೇ ನಾಲಿಗೆ ಹಾಕಿ."
    },
    {
      "t": "02:58",
      "text": "ರಸ ಎಲ್ಲ ಬರುತ್ತಲ್ಲ ಅದನ್ನೆಲ್ಲ ಕುಡಿಬೇಕು."
    },
    {
      "t": "03:02",
      "text": "ತುಂಬಾ ಚೆನ್ನಾಗಿರುತ್ತೆ."
    },
    {
      "t": "03:05",
      "text": "ಕಂಡ ಮಾಡ್ಲಿಲ್ವಾ ಇನ್ನುವರೆಗೆ ನಮಗೆ."
    },
    {
      "t": "03:14",
      "text": "ಮಾಡಿದ್ರೆ ನೀವು ಮತ್ತೆ ಸೆಕ್ಸ್ ಮಾಡ್ಲಿಲ್ವಾ?"
    },
    {
      "t": "03:18",
      "text": "ಸುಮ್ನೆ ಹೇಳೋದಿಕ್ಕೆ."
    },
    {
      "t": "03:22",
      "text": "ಏನಪ್ಪಾ?"
    },
    {
      "t": "03:25",
      "text": "ಆಚೆ."
    },
    {
      "t": "03:27",
      "text": "ಮದುವೆಗಿಂತ ಮುಂಚೆ ಯಾರ ಜೊತೆನಾದ್ರೂ ಇರ್ತಾರಾ ಲವರ್."
    },
    {
      "t": "03:32",
      "text": "ತುಂಬಾ ಫ್ರೆಶ್ ಏನಾಗುತ್ತೆ."
    },
    {
      "t": "03:37",
      "text": "ಕಾಣಿಸ್ತಾ ಮೊಲೆ ಕಾಣಿಸ್ತಿರುತ್ತೆ."
    },
    {
      "t": "03:41",
      "text": "ತುಂಬಾ ಕಣ್ಣು ಬರುತ್ತೆ."
    },
    {
      "t": "03:44",
      "text": "ಎಚ್ ಎಚ್ ಟ್ರಾವೆಲ್."
    },
    {
      "t": "03:46",
      "text": "ಮೊಲೆ ಒಂದುಸಲ ನೋಡೋದು."
    },
    {
      "t": "03:49",
      "text": "ಸ್ವಲ್ಪ ಟಾಪ್ ಎತ್ತಿ."
    },
    {
      "t": "03:51",
      "text": "ಇಲ್ಲ ಇಲ್ಲ."
    },
    {
      "t": "03:53",
      "text": "ಟಾಪ್ ಎತ್ತಿ ನೋಡ್ತೀನಿ."
    },
    {
      "t": "03:55",
      "text": "ಓಕೆ ಓಕೆ ಅಂತ ಹೇಳಿ ಸಾಕು ಓಕೆ."
    },
    {
      "t": "03:58",
      "text": "ಒಕ್ಕ ಕಾಣ್ಸುತ್ತೆ."
    },
    {
      "t": "04:00",
      "text": "ಒಕ್ಕ ಕಾಣ್ಸುತ್ತೆ ಶೇಪ್ ಮಾಡ್ಕೊಳ್ತಿರೋ."
    },
    {
      "t": "04:04",
      "text": "ಓಕೆ."
    },
    {
      "t": "04:06",
      "text": "ಸ್ವಲ್ಪ ಟೀ ಶರ್ಟ್ ಎತ್ತಿ."
    },
    {
      "t": "04:09",
      "text": "ಸ್ವಲ್ಪ ಟೀ ಶರ್ಟ್ ಎತ್ತಿ."
    },
    {
      "t": "04:12",
      "text": "ಒಕ್ಕ ಕಾಣಿಸ್ತಾ ಸಾಕು."
    },
    {
      "t": "04:15",
      "text": "ನಮ್ ನೋಡ್ತಿಯಾ ಕಡೆ ನೋಡ್ತಿಯಾ."
    },
    {
      "t": "04:18",
      "text": "ಕಡೆ ನೋಡಿ."
    },
    {
      "t": "04:22",
      "text": "ಒಕ್ಕ ಕಾಣಿಸ್ತಾ ಇದೆ."
    },
    {
      "t": "04:25",
      "text": "ಪ್ಲೀಸ್ ಕಣೋ ಒಕ್ಕ ಕಾಣಿಸ್ತಾ ಪ್ಲೀಸ್."
    },
    {
      "t": "04:28",
      "text": "ಮೊದಲು ನೀವು ಕಳೋಲ್ಲ ಒಕ್ಕ ಎಷ್ಟು ಕಾಣ್ಸುತ್ತೆ."
    },
    {
      "t": "04:32",
      "text": "ಅದು ಜಾಸ್ತಿ ಕಂಟ್ರೋಲ್ ಮಾಡ್ಕೊಂಡು ಟೀ ಶರ್ಟ್ ಹಾಕಿ."
    },
    {
      "t": "04:39",
      "text": "ಗುಡ್ ಬಾಯ್."
    }
  ]
}