    },
    {
      "t": "00:05",
      "text": "హాయ్, ఎలా ఉన్నారు?"
    },
    {
      "t": "00:06",
      "text": "హాయ్, వేర్ ఆర్ యూ ఫ్రొమ్?"
    },
    {
      "t": "00:10",
      "text": "ఐ యామ్ ఫ్రొమ్ డాలియాండ్ యు?"
    },
    {
      "t": "00:12",
      "text": "ఓ, ఢిల్లీ కేలియవార్?"
    },
    {
      "t": "00:15",
      "text": "ఎస్ సర్."
    },
    {
      "t": "00:16",
      "text": "வாட் யூ டூ?"
    },
    {
      "t": "00:18",
      "text": "ఐ యామ్ స్టడీయింగ్."
    },
    {
      "t": "00:20",
      "text": "యు నో ఐ లైక్ ఢిల్లీ గర్ల్స్."
    },
    {
      "t": "00:24",
      "text": "ఓకే."
    },
    {
      "t": "00:25",
      "text": "వేర్ ఆర్ యూ ఫ్రొమ్?"
    },
    {
      "t": "00:27",
      "text": "ఐ యామ్ ఫ్రొమ్ బెంగళూర్."
    },
    {
      "t": "00:29",
      "text": "సో వాట్ యూ டூ?"
    },
    {
      "t": "00:31",
      "text": "ఐ యామ్ వర్కింగ్ యాజ్ ఏ సాఫ్ట్వేర్ ఇంజనీర్."
    },
    {
      "t": "00:35",
      "text": "ఓకే ఓకే."
    },
    {
      "t": "00:37",
      "text": "వేర్ డు యూ స్టే? యు ఆర్ స్టేయింగ్ ఇన్ హోమ్ ఆర్ హాస్టల్?"
    },
    {
      "t": "00:41",
      "text": "హోమ్ ఫ్రొమ్ ద్వారక."
    },
    {
      "t": "00:44",
      "text": "ఓకే, బట్ యు ఆర్ ఇన్ ఢిల్లీ?"
    },
    {
      "t": "00:49",
      "text": "వాట్ ఆర్ యూ డూయింగ్ హియర్?"
    },
    {
      "t": "00:52",
      "text": "అవును, ఐ యామ్ స్లీపింగ్ అండ్ ఐ యామ్ డూయింగ్ మాస్టర్ బేట్ యూ."
    },
    {
      "t": "00:55",
      "text": "ఓకే బట్ వాట్ ఆర్ యూ డూయింగ్ హియర్?"
    },
    {
      "t": "01:00",
      "text": "ఇయర్?"
    },
    {
      "t": "01:01",
      "text": "జస్ట్ ఐ వాంట్ సం గర్ల్ టు మేక్ డేట్, మేక్ సం సేక్స్."
    },
    {
      "t": "01:09",
      "text": "ఓకే ఓకే."
    },
    {
      "t": "01:10",
      "text": "సో వాట్ అబౌట్ యు? వై యు కేమ్?"
    }
  ]
