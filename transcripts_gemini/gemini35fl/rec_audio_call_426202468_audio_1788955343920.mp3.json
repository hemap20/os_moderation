    },
    {
      "t": "00:15",
      "text": "हाँ जी।"
    },
    {
      "t": "00:16",
      "text": "हाँ जी कहाँ से बोल रहे हैं?"
    },
    {
      "t": "00:20",
      "text": "मैं हरियाणा से बोल रहा हूँ, आप कहाँ से?"
    },
    {
      "t": "00:23",
      "text": "जी, मैं कोलकाता से।"
    },
    {
      "t": "00:26",
      "text": "ओके, कैसे हो पूजा?"
    },
    {
      "t": "00:30",
      "text": "मैं बिल्कुल ठीक हूँ, आप सुनाइए।"
    },
    {
      "t": "00:34",
      "text": "बस बढ़िया है, ईश्वर की माली"
    },
    {
      "t": "00:37",
      "text": "अच्छा अच्छा"
    },
    {
      "t": "00:40",
      "text": "आप कब से है ये साथ में?"
    },
    {
      "t": "00:43",
      "text": "मुझे तो एक हफ्ता हुआ है।"
    },
    {
      "t": "00:47",
      "text": "अच्छा एक हफ्ता"
    },
    {
      "t": "00:50",
      "text": "चलिए बढ़िया है, तो कोई मिली क्या यहाँ पे ऐसा?"
    },
    {
      "t": "00:53",
      "text": "नहीं, अभी तक तो कोई मिली नहीं।"
    },
    {
      "t": "00:55",
      "text": "नहीं मिली"
    },
    {
      "t": "00:58",
      "text": "मैं तो आस-पास ढूँढ रहा हूँ, आस-पास कोई है ही नहीं, बहुत दूर-दूर से है।"
    },
    {
      "t": "01:04",
      "text": "अच्छा तो कैसी लड़की पसंद है आपको?"
    },
    {
      "t": "01:09",
      "text": "अच्छी हो, नेचर वाइज़ बढ़िया हो, एक-दूसरे की फीलिंग्स समझते हो।"
    },
