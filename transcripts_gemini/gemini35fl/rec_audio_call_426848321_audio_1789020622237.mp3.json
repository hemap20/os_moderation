    {
      "t": "00:13",
      "text": "आवाज बहुत स्लो है डियर।"
    },
    {
      "t": "00:18",
      "text": "किस सुबह से हुई है खोलना मैं तुझे जाने"
    },
    {
      "t": "00:24",
      "text": "हेलो।"
    },
    {
      "t": "00:28",
      "text": "हेलो आवाज क्यों नहीं आ रही है? तेज है।"
    },
    {
      "t": "00:32",
      "text": "हाँ, अभी-अभी आ रही है।"
    },
    {
      "t": "00:35",
      "text": "है ना? कहाँ से हो आप?"
    },
    {
      "t": "00:37",
      "text": "अभी-अभी अभी"
    },
    {
      "t": "00:39",
      "text": "अभी आ रही है।"
    },
    {
      "t": "00:40",
      "text": "और सुनाओ"
    },
    {
      "t": "00:42",
      "text": "और तबीयत कैसी है? आपकी? नाश्ता-वाशता हो गया।"
    },
    {
      "t": "00:47",
      "text": "और आप"
    },
    {
      "t": "00:50",
      "text": "बहुत बढ़िया है। नाश्ता हो गया। और आप बताओ।"
    },
    {
      "t": "00:53",
      "text": "कहाँ से हो आप?"
    },
    {
      "t": "00:55",
      "text": "आप कहाँ से?"
    },
    {
      "t": "00:56",
      "text": "मैं कर्नाटका से।"
    },
    {
      "t": "00:57",
      "text": "मैं एमपी से हूँ। आप"
    },
    {
      "t": "01:00",
      "text": "कर्नाटका से। और क्या करती हैं आप?"
    },
    {
      "t": "01:03",
      "text": "मैं ब्यूटीशियन का कोर्स कर रही हूँ।"
    },
    {
      "t": "01:07",
      "text": "कोर्स कर रही हो।"
    },
    {
      "t": "01:09",
      "text": "हाँ।"
    },
    {
      "t": "01:13",
      "text": "चलो अच्छी बात है।"
    },
    {
      "t": "01:14",
      "text": "और सुनाओ।"
    },
    {
      "t": "01:16",
      "text": "हाँ।"
    },
    {
      "t": "01:16",
      "text": "आप सुनाओ।"
    },
    {
      "t": "01:17",
      "text": "फिर कोई मिल गया आपको?"
    },
    {
      "t": "01:21",
      "text": "कौन हो आप? क्या पहले बात हुई है आपसे?"
    },
    {
      "t": "01:27",
      "text": "हाँ।"
    },
    {
      "t": "01:28",
      "text": "कब यार आज ही? थोड़ा याद दिलाओ ना।"
    },
    {
      "t": "01:34",
      "text": "अब दो-तीन बार हो चुकी है भाई।"
    },
    {
      "t": "01:36",
      "text": "दो-तीन बार हो चुकी है? और मुझे याद नहीं है।"
    },
    {
      "t": "01:39",
      "text": "ये क्या बात हुई फिर?"
    },
    {
      "t": "01:44",
      "text": "अब जी क्या बात हुई? ये तो आपको पता होगा क्या बात हुई है।"
    },
    {
      "t": "01:49",
      "text": "कुछ याद तो दिलाओ कि हमने क्या बातें की थी तो शायद मुझे याद आ जाएगा।"
