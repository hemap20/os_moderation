  "segments": [
    {
      "t": "00:03",
      "text": "ഹലോ."
    },
    {
      "t": "00:04",
      "text": "[inaudible]"
    },
    {
      "t": "00:05",
      "text": "എവിടുന്നാ?"
    },
    {
      "t": "00:06",
      "text": "ഞാൻ ട്രിവാൻഡ്രമാണ്. ഇത് എവിടെയാ?"
    },
    {
      "t": "00:09",
      "text": "ഇത് കൊല്ലം."
    },
    {
      "t": "00:12",
      "text": "എന്ത് ചെയ്യുന്നു?"
    },
    {
      "t": "00:14",
      "text": "ഞാൻ ഒത്തുകൂട്ടി വർക്ക് ചെയ്തു എന്നുണ്ടായിരുന്നു. ഇപ്പോൾ ഒന്നും ചെയ്യുന്നില്ല."
    },
    {
      "t": "00:20",
      "text": "ഓക്കെ. ഉറങ്ങിയ ഒക്കെ ആണല്ലോ ആയിരിക്കുന്നത്. രാത്രി ഉറക്കം ഇല്ലേ?"
    },
    {
      "t": "00:24",
      "text": "രാവിലെ ഇനി ഇത് ഞാൻ ഇന്നലെ രാവിലെ ചീ സോറി ഇന്നലെ രാത്രി ഒരു ജോലി"
    },
    {
      "t": "00:32",
      "text": "ആണോ?"
    },
    {
      "t": "00:34",
      "text": "പിന്നെ എന്താ പരിപാടി ഉറങ്ങാതിരുന്നു?"
    },
    {
      "t": "00:36",
      "text": "എനിക്ക് രാവിലെ കുറച്ച് പൈസ വേണോടോ?"
    },
    {
      "t": "00:40",
      "text": "ആണോ?"
    },
    {
      "t": "00:41",
      "text": "ആ."
    },
    {
      "t": "00:42",
      "text": "അതിന്?"
    },
    {
      "t": "00:43",
      "text": "അതിന് എടുക്കുകയാണ്."
    },
    {
      "t": "00:46",
      "text": "ഉണ്ട് ഓപ്പൺ ഒക്കെ ഉണ്ട് വാട്സാപ്പിലാണ് പെയ്ഡ് സർവീസാണ്."
    },
    {
      "t": "00:50",
      "text": "അതെന്താ അങ്ങനെ?"
    },
    {
      "t": "00:52",
      "text": "ഇതിൽനിന്ന് അഞ്ചു രൂപ വെച്ച് കിട്ടുന്നുണ്ട് നമുക്ക് ഒരു മിനിറ്റിന്. സോ ഫ്രീ ആയിട്ട് ചെയ്യേണ്ട കാര്യം നമുക്കില്ലല്ലോ."
    },
    {
      "t": "00:59",
      "text": "ലിമിറ്റ് കിട്ടുന്നുണ്ടല്ലോ."
    },
    {
      "t": "01:02",
      "text": "ഇതിൽ കിട്ടുന്നുണ്ടെങ്കിൽ യുവർ ചോയ്സ്."
    },
    {
      "t": "01:05",
      "text": "ഞാൻ പറഞ്ഞെന്നേയുള്ളൂ. ഞാൻ ചെയ്യുന്നെങ്കിൽ ഞാൻ വാട്സാപ്പിൽ ചെയ്യാറുള്ളൂ. എനിക്ക് സേഫ്റ്റി ഇഷ്യൂ കാരണം പേടിയാണ്."
    },
    {
      "t": "01:15",
      "text": "ഓക്കെ."
    },
    {
      "t": "01:18",
      "text": "ബൈ ബൈ വേറെ നോക്കിക്കോ."
    }
  ]
}