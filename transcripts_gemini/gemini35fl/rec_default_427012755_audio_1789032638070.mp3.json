    {
      "t": "00:15",
      "text": "ആ കഹാ സേ ഹോ ആപ്"
    },
    {
      "t": "00:18",
      "text": "ഒന്നും ചെയ്യാനില്ല"
    },
    {
      "t": "00:20",
      "text": "ആപ് ബോലോ നാ ക്യാ കഹാ സേ ഹോ"
    },
    {
      "t": "00:26",
      "text": "കഹാ സേ ഹോ ഒന്നും ചെയ്യാനില്ല"
    },
    {
      "t": "00:30",
      "text": "ചേർത്തലയോ?"
    },
    {
      "t": "00:32",
      "text": "ചേർത്തലയോ അല്ല ബംഗാളി ഞാൻ ചേർത്തലത്ത്"
    },
    {
      "t": "00:37",
      "text": "മംഗേ ബംഗാളി"
    },
    {
      "t": "00:39",
      "text": "ആ മംഗേ നീ എങ്ങേയ്ക്ക്"
    },
    {
      "t": "00:43",
      "text": "തമിഴ്നാട്ടിൽ അയ്യോ"
    },
    {
      "t": "00:46",
      "text": "ഹലോ അത് മോനെ എവിടെയാ സ്ഥലം"
    },
    {
      "t": "00:51",
      "text": "പൈസ ഒന്നുമില്ല"
    },
    {
      "t": "00:53",
      "text": "എവിടെ"
    },
    {
      "t": "00:55",
      "text": "കാണും"
    },
    {
      "t": "00:58",
      "text": "നിങ്ങൾ എവിടെയാണ് സ്ഥലം"
    },
    {
      "t": "01:00",
      "text": "ഫേസ് കാണിച്ചു"
    },
    {
      "t": "01:02",
      "text": "ഏഹ്?"
    },
    {
      "t": "01:03",
      "text": "ഫേസ് കാണിക്കേ"
    },
    {
      "t": "01:05",
      "text": "എന്തിനാ"
    },
    {
      "t": "01:07",
      "text": "കാണാൻ"
    },
    {
      "t": "01:09",
      "text": "ഇനി അവിടെയാണ് എന്ത്"
    },
    {
      "t": "01:10",
      "text": "എന്റെ ഫേസ് കാണണോ"
    },
    {
      "t": "01:12",
      "text": "ഇല്ല"
    },
    {
      "t": "01:13",
      "text": "വേണ്ട"
    },
    {
      "t": "01:14",
      "text": "ഇല്ല"
    },
    {
      "t": "01:16",
      "text": "എന്റെ ഫേസ് കാണണോ വേണ്ടയോ"
    },
    {
      "t": "01:21",
      "text": "കാണിക്കേണ്ട വലിയ കാര്യമില്ലല്ലോ"
    },
    {
      "t": "01:26",
      "text": "അതെന്താ"
    },
    {
      "t": "01:28",
      "text": "ഇജ്ജ് എവിടെയാ സ്ഥലം എവിടെയാ?"
    },
    {
      "t": "01:31",
      "text": "അതെന്താ കോൺടാക്ട് വലിയ കാര്യമില്ലാ എന്ന് പറഞ്ഞേന്താ"
    },
    {
      "t": "01:35",
      "text": "എന്റെ മുഖം കാണാൻ കൊള്ളൂല"
    },
    {
      "t": "01:37",
      "text": "എന്റെ മുഖം കണ്ടിട്ടില്ല കാണിക്ക്"
    },
    {
      "t": "01:40",
      "text": "കണ്ടില്ലേ നാളെ വരിണ്ട കേട്ടോ"
    },
    {
      "t": "01:44",
      "text": "പഠിക്കാലോ വർക്ക് ചെയ്യാം"
    },
    {
      "t": "01:47",
      "text": "ഇയാൾ എന്നെ വിളിച്ചിട്ടുണ്ട് ഇയാൾക്ക് എന്നെ അറിയാം അതാണ്"
    },
    {
      "t": "01:51",
      "text": "എനിക്കാ?"
    },
    {
      "t": "01:52",
      "text": "ആ"
    },
    {
      "t": "01:54",
      "text": "ഞാൻ ഉദ്ദേശിച്ച ആളാണോന്ന് നോക്കട്ടെ"
    },
    {
      "t": "01:57",
      "text": "നീ ഉദ്ദേശിച്ച ആള് അല്ല ഞാൻ ഈ ദുനിയാവിലേ ഇല്ലതാരാ"
    },
    {
      "t": "02:02",
      "text": "ഒരു താടിക്കാരൻ"
    },
    {
      "t": "02:04",
      "text": "അള്ളാ എന്റെ മോനെ"
    },
    {
      "t": "02:06",
      "text": "താടിയുമില്ല മീശയുമില്ല"
    },
    {
      "t": "02:09",
      "text": "ഇയാൾ എന്നെ വിളിച്ചിട്ടുണ്ട്"
    },
    {
      "t": "02:11",
      "text": "എനിക്ക് 17 വയസ്സ്"
    },
    {
      "t": "02:14",
      "text": "പതിനേഴാ?"
    },
    {
      "t": "02:16",
      "text": "മധുരം 17 ൽ ഇരിക്കുകയാണ്"
    },
    {
      "t": "02:19",
      "text": "ഹലോ"
    },
    {
      "t": "02:22",
      "text": "നിങ്ങൾ എവിടെയാണ്"
    },
    {
      "t": "02:24",
      "text": "ഞാൻ മധുരപ്പെന്തന്ന്"
    },
    {
      "t": "02:29",
      "text": "എന്തോ"
    },
    {
      "t": "02:30",
      "text": "നിങ്ങളവിടെയാ?"
    },
    {
      "t": "02:32",
      "text": "എടാ അത് ഫേസ് കാണിക്കുന്നിട്ടല്ല"
    },
    {
      "t": "02:34",
      "text": "നിങ്ങൾ എവിടെയാന്ന് പറ"
    },
    {
      "t": "02:36",
      "text": "പാലക്കാട്"
    },
    {
      "t": "02:37",
      "text": "എന്ത് ചെയ്യാ?"
    },
    {
      "t": "02:39",
      "text": "അതൊന്നും ചെയ്യാനില്ല"
    },
    {
      "t": "02:40",
      "text": "ഹൗസ് വൈഫാ?"
    },
    {
      "t": "02:42",
      "text": "അല്ല"
    },
    {
      "t": "02:43",
      "text": "പിന്നെ വൈഫ് ഫോഴ്സാ?"
    },
    {
      "t": "02:45",
      "text": "വൈഫ് ഫോഴ്സാ"
    },
    {
      "t": "02:48",
      "text": "മകനൊക്കെ വെച്ചില്ലേ"
    },
    {
      "t": "02:50",
      "text": "ഞാൻ പോകുകയാണ്"
    }
  ]
}