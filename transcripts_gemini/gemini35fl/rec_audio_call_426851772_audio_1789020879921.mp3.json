    },
    {
      "t": "00:34",
      "text": "उत्तर प्रदेश में कहां से हो आप?"
    },
    {
      "t": "00:37",
      "text": "मैं सीतापुर"
    },
    {
      "t": "00:40",
      "text": "उत्तर प्रदेश में, आगरा से हूं"
    },
    {
      "t": "00:43",
      "text": "मैं सीतापुर से"
    },
    {
      "t": "00:45",
      "text": "अच्छा मैरिड हो या अनमैरिड हो?"
    },
    {
      "t": "00:48",
      "text": "जी?"
    },
    {
      "t": "00:49",
      "text": "मैरिड हो कि अनमैरिड हो?"
    },
    {
      "t": "00:51",
      "text": "अनमैरिड हूं"
    },
    {
      "t": "00:55",
      "text": "एक्सेप्ट कब से?"
    },
    {
      "t": "00:58",
      "text": "यही हो गए हैं थोड़े दिन, 10-12 दिन"
    },
    {
      "t": "01:03",
      "text": "इतने ही दिन हुए हैं"
    },
    {
      "t": "01:05",
      "text": "और और बढ़िया, आप कौन हो? मैरिड हो या अनमैरिड?"
    },
    {
      "t": "01:11",
      "text": "हाँ, मैं अनमैरिड हूं"
    },
    {
      "t": "01:13",
      "text": "यार, आवाज़ तुम्हारी कैसी इसी लड़कील लग रही है?"
    },
    {
      "t": "01:17",
      "text": "अनमैरिड हूं, कैसे लग रही है?"
    },
    {
      "t": "01:20",
      "text": "नहीं, लड़की हो या लड़का हो यार?"
    },
    {
      "t": "01:23",
      "text": "ओह भगवान! मेरी आवाज़ लड़कों जैसी लग रही है क्या?"
    },
    {
      "t": "01:27",
      "text": "क्या?"
    },
    {
      "t": "01:29",
      "text": "मेरी आवाज़ लड़कों जैसी लग रही है क्या?"
    },
    {
      "t": "01:31",
      "text": "हाँ, आवाज़ भारी-भारी लग रही है आपकी यार"
    },
    {
      "t": "01:34",
      "text": "हाँ, मेरी आवाज़ है ही भारी"
    },
    {
      "t": "01:37",
      "text": "[inaudible]"
    },
