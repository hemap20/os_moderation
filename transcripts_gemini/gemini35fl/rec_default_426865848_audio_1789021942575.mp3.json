  "segments": [
    {
      "t": "00:04",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:05",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:05",
      "text": "ನೀವೇನು ಮಾಡ್ತಾ ಇದ್ರಿ?"
    },
    {
      "t": "00:09",
      "text": "ನಾನು ಸಿವಿಲ್ ಇಂಜಿನಿಯರ್."
    },
    {
      "t": "00:10",
      "text": "ಸಿವಿಲ್ ಇಂಜಿನಿಯರ್."
    },
    {
      "t": "00:13",
      "text": "ಅಲ್ವಾ? ವರ್ಕ್ ಫ್ರಮ್ ಹೋಮ್?"
    },
    {
      "t": "00:16",
      "text": "ವರ್ಕ್ ಎಲ್ಲಾ ಇದೆ. ಈಗ ಸ್ವಲ್ಪ ಫ್ರೀ ಇದೆ ಅದಕ್ಕೆ ಆನ್ಲೈನ್ ಬಂದೆ."
    },
    {
      "t": "00:22",
      "text": "ತುಮಕೂರಲ್ಲಿ ವರ್ಕ್ ಮಾಡ್ತೀರಾ?"
    },
    {
      "t": "00:26",
      "text": "ಹೌದು."
    },
    {
      "t": "00:29",
      "text": "ನೀವು ಯಾವಾಗಿಂದ ಯೂಸ್ ಮಾಡ್ತಿದ್ದೀರಾ?"
    },
    {
      "t": "00:32",
      "text": "ನಾನೊಂದು ಥ್ರೀ ಡೇಸ್ ಆಯ್ತು."
    },
    {
      "t": "00:34",
      "text": "ಥ್ರೀ ಡೇಸ್?"
    },
    {
      "t": "00:35",
      "text": "ಆ ಸಂಡೆ ಇನ್ಸ್ಟಾಲ್ ಮಾಡಿದ್ದು."
    },
    {
      "t": "00:40",
      "text": "ಸಿಕ್ಕಿದ್ರು ಯಾರಾದ್ರೂ ಫ್ರೆಂಡ್?"
    },
    {
      "t": "00:43",
      "text": "ಇನ್ನ ಇಲ್ಲ."
    },
    {
      "t": "00:45",
      "text": "ಗೊತ್ತಿಲ್ಲ ಇದರಲ್ಲಿ ಫ್ರೆಂಡ್ಸ್ ಜಿನುಯಿನ್ ಇರುತ್ತೋ ಇಲ್ವೋ ಗೊತ್ತಿಲ್ಲ. ಅದಕ್ಕೆ ಫ್ರೆಂಡ್ ಮಾಡ್ಕೊಂಡಿಲ್ಲ."
    },
    {
      "t": "00:53",
      "text": "ಇದರಲ್ಲಿ ಏನು ಇಲ್ಲರಿ ಆಲ್ಮೋಸ್ಟ್ ನಾನು ನಿಮಗೆ ಫ್ರೆಂಡ್ ಆಗಿ ಹೇಳ್ತಾ ಇದೀನಿ."
    },
    {
      "t": "00:56",
      "text": "ಸೊ ನಾನು ತುಂಬಾ ತಿಂಗಳಿನಿಂದ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ ಸುಮಾರು ನೈನ್ ಮಂತ್ಸ್ ಬ್ಯಾಕ್ ಇಂದ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "01:03",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:04",
      "text": "ಒಂಬತ್ತು ತಿಂಗಳಿಂದ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "01:07",
      "text": "ಓಕೆ."
    },
    {
      "t": "01:09",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:09",
      "text": "ಅಂದ್ರೆ ಅದೇ ಬಿಟ್ಟು ಬಿಟ್ಟು ಬರ್ತೀನಿ ಅಷ್ಟೇನೆನೇ ವರ್ಕ್ ಇದ್ದಾಗ ಬರಲ್ಲ ವರ್ಕ್ ಇಲ್ಲ ಅಂದ್ರೆ ಬರ್ತೀನಿ."
    },
    {
      "t": "01:14",
      "text": "ಸೊ ಶೇರ್ ಮಾಡ್ಕೊಳ್ತೀವಿ."
    },
    {
      "t": "01:16",
      "text": "ಮಾತಾಡ್ತೀವಿ."
    },
    {
      "t": "01:18",
      "text": "ಟೈಮ್ ಎಲ್ಲಾದರೂ ಸಿಕ್ಕಿದ್ರೆ ನಾನು ಯಾರನ್ನು ಮೀಟ್ ಮಾಡಿಲ್ಲ."
    },
    {
      "t": "01:21",
      "text": "ತುಂಬಾ ಜನ ಮಾತಾಡ್ತಾರೆ ಮೀಟ್ ಮಾಡ್ತಾರೆ."
    },
    {
      "t": "01:24",
      "text": "ಕೆಲವೆಲ್ಲ ಹೋಗ್ತಾರೆ."
    },
    {
      "t": "01:26",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:27",
      "text": "ಆದ್ರೆ ನಾನು ಹೋಗಿಲ್ಲ ನಂದು ಕೆಲಸ ಅಲ್ವಾ?"
    },
    {
      "t": "01:30",
      "text": "ಮುಂಚೆನೇ."
    },
    {
      "t": "01:32",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:33",
      "text": "ನಿಮಗೆ ಯಾವ ತರ ಬೇಕು?"
    },
    {
      "t": "01:36",
      "text": "ನಿಮಗೆ ಫ್ರೆಂಡ್ ಹೇಗಾದ್ರೂ ಸರಿ."
    },
    {
      "t": "01:39",
      "text": "ಫ್ರೆಂಡ್ಸ್ ಹುಡ್ಕುತ್ತಾ ಇದ್ದೆ."
    },
    {
      "t": "01:41",
      "text": "ಹೌದಾ? ಲೈಕ್ ನೋಡೋಣ."
    },
    {
      "t": "01:44",
      "text": "ಬಟ್ ಎಲ್ಲಾ ರೀತಿನೂ."
    },
    {
      "t": "01:47",
      "text": "ನಿಮ್ಮ ಹೆಸರೇನು?"
    },
    {
      "t": "01:48",
      "text": "ಹರ್ಷ."
    },
    {
      "t": "01:51",
      "text": "ಹರ್ಷ ಎಲ್ಲಾ ರೀತಿನೂ ಫ್ರೆಂಡ್ ಸಿಕ್ತಾರೆ ಕಣ್ರಿ."
    },
    {
      "t": "01:54",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ನಿಮಗೆ ನಿಮಗೆ ಆಗಿದ್ದಾರಾ ಫ್ರೆಂಡ್ಸ್?"
    },
    {
      "t": "01:58",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ಬಟ್ ಎಲ್ಲೋ ಆಚೆ ಹೋಗಿ."
    },
    {
      "t": "02:00",
      "text": "ನಾನು ಅವಾಗ ಅವಾಗ ಬರ್ತೀನಿ ಅಲ್ವಾ?"
    },
    {
      "t": "02:02",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "02:03",
      "text": "ನಾನು ಬರೋದೇ ಅಪರೂಪ ಅಂದ್ರೆ."
    },
    {
      "t": "02:05",
      "text": "ಕೆಲಸ ಇದ್ದಾಗ ಬರೋದು ಸೋ ನನಗೆ ಒಂದು ಇಬ್ಬರು ತುಂಬಾ ಬೆಸ್ಟ್ ಫ್ರೆಂಡ್ ಆಗಿದ್ದಾರೆ."
    },
    {
      "t": "02:09",
      "text": "ಸೊ ಅವರು ಯಾರು ಇರಲಿಲ್ಲ ಅವರೆಲ್ಲ ಬಳ್ಳಾರಿ ಆ ಸೈಡ್ ಇರೋದು ಅಲ್ವಾ?"
    },
    {
      "t": "02:13",
      "text": "ಸೊ ಜಸ್ಟ್ ಕಾಲ್ ಅಲ್ಲಿ ಬಂದು ಮಾತಾಡ್ತಾರೆ ಅಷ್ಟೇ."
    },
    {
      "t": "02:15",
      "text": "ಓಕೆ."
    },
    {
      "t": "02:17",
      "text": "ಯಾರಿಗೂ ಫೋನ್ ನಂಬರ್ಸ್ ಏನು ಶೇರ್ ಮಾಡಿಲ್ಲ ನೀವು."
    },
    {
      "t": "02:19",
      "text": "ನೀವು ತುಮಕೂರು ಅಂತೀರಾ."
    },
    {
      "t": "02:22",
      "text": "ನಾನೇನು ಕೊಟ್ಟಿಲ್ಲ."
    },
    {
      "t": "02:24",
      "text": "ಹ್ಮ್ ಹ್ಮ್."
    },
    {
      "t": "02:25",
      "text": "ನಾನು ಫೋನ್ ನಂಬರ್ ಕೊಟ್ಟಿಲ್ಲ ಮತ್ತೆ ಇನ್ನ ಆಲ್ಮೋಸ್ಟ್."
    },
    {
      "t": "02:30",
      "text": "ನಾನು."
    },
    {
      "t": "02:33",
      "text": "ನಂಬರ್ ಇಸ್ಕೊಂಡಿಲ್ಲ ಕೊಟ್ಟಿಲ್ಲ."
    },
    {
      "t": "02:35",
      "text": "ಹ್ಮ್ ಹ್ಮ್."
    }
  ]
}