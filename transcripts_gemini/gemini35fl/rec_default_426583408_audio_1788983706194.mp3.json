    {
      "t": "04:54",
      "text": "ಅಂದ್ರೆ ಫ್ಯಾಮಿಲಿ ಇಂದಾನೆ ಹುಡುಗ ಫ್ರೆಂಡ್ಸ್ ಜೊತೆ ಎಲ್ಲಾ ಇರುವಾಗ ಫ್ಯಾಮಿಲಿ ಇಂದಾನೆ ತುಂಬಾ ನಿಮಗೆ ಇದು ಮಾಡಿರ್ತಾರೆ ಇನ್ಸಲ್ಟ್ ಮಾಡಿರ್ತಾರೆ ಅನ್ಸುತ್ತೆ ಅದಕ್ಕೆ."
    },
    {
      "t": "05:02",
      "text": "ಆತರ ಏನು ಮಾಡಿಲ್ಲ ಬಟ್ ನನ್ನ ಪರ್ಸನಾಲಿಟಿ ಹೇಳೋದು ಅಷ್ಟೇ ನನ್ನ ಮೈಂಡ್ ಸೆಟ್ ಹಂಗೆ."
    },
    {
      "t": "05:07",
      "text": "ಒಳ್ಳೇದು ಇದೆ ತುಂಬಾ ಒಳ್ಳೆ ಒಳ್ಳೆ ಮೈಂಡ್ ಸೆಟ್ ನನ್ನ ಮೈಂಡ್ ಸೆಟ್ ಅಷ್ಟೇ ಅದು."
    },
    {
      "t": "05:13",
      "text": "ಸೊ ಎಲ್ಲೂ ಹೋಗಿಲ್ಲ ರಿಸೆಂಟ್ ಗೆ ಎಲ್ಲೂ ಆಚೆ."
    },
    {
      "t": "05:18",
      "text": "ನಾನಾ?"
    },
    {
      "t": "05:19",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "05:21",
      "text": "ಇಲ್ಲರೀ ಒನ್ ಇಲ್ಲ ಮೊನ್ನೆ ಹೋಗಿದ್ದು ಎಲ್ಲಿ ಹೋಗಿದೆ?"
    },
    {
      "t": "05:24",
      "text": "ಉಡುಪಿ ಮತ್ತೆ ಒಂದೆರಡು ಟೆಂಪಲ್ಸ್ ಗೆ ಹೋಗಿ ಬಂದ್ವಿ."
    },
    {
      "t": "05:27",
      "text": "ಮಂಗಳೂರ ಅಂದ್ರೆ ನೀವು?"
    },
    {
      "t": "05:29",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "05:30",
      "text": "ನಿಮ್ಮ ಆಕ್ಸೆಂಟ್ ಅಲ್ಲಿ ಗೊತ್ತಾಗುತ್ತೆ."
    },
    {
      "t": "05:32",
      "text": "ಓಹೋ."
    },
    {
      "t": "05:34",
      "text": "ಓಕೆ."
    },
    {
      "t": "05:35",
      "text": "ನಿಮ್ದು ನೇಟಿವ್?"
    },
    {
      "t": "05:37",
      "text": "ನಮ್ದು ಬೆಂಗಳೂರೇ."
    },
    {
      "t": "05:41",
      "text": "ಸೊ ಹಂಗೆ ಪರ್ಸನಲ್ ಚಾಟ್ ಆಗ್ಬಹುದಾ?"
    },
    {
      "t": "05:46",
      "text": "ಸಿಗೋಣ ಫ್ರಮ್ ನೇ ಸಿಗೋಣ ಅಂತ ಹೇಳ್ತಿದ್ದೀರಾ? ಹ್ಮ್ ಸಿಗೋಣ."
    },
    {
      "t": "05:49",
      "text": "ನಾಳೆ? ಆಮೇಲೆ ಯೋಚನೆ ಮಾಡೋಣ ಹ್ಮ್."
    },
    {
      "t": "05:53",
      "text": "ನಾಳೆ? ಹಾ ಆಮೇಲೆ ನಿಮಗೆ ಹೆಂಗೆ ಅನ್ಸುತ್ತೆ ಹಂಗೆ."
    },
    {
      "t": "05:57",
      "text": "ಅದು ಯಾಕೆಂದ್ರೆ ನಾನೇನು ಗೊತ್ತಾ ರೀ? ಯಾಕಂದ್ರೆ ನೋಡಿ ನನಗೆ ಸೀದಾ ಇಂಗೆ ಇವಾಗ ಹೆಂಗೆ ನುಡಿಗೆ ಸಿಕ್ಕಿದ್ರಿ ಅಂತ ಅಂದ್ಬಿಟ್ಟು ನನಗೆ"
    },
    {
      "t": "06:05",
      "text": "ಅದಕ್ಕೆ ಇದಕ್ಕೆ ಅನ್ನೋದು ಕರೆಯೋದು. ನನಗಂತೂ ಅದು ಇಷ್ಟ ಇಲ್ಲ ನನಗೆ ನನ್ನ ಕ್ಯಾರೆಕ್ಟರ್ ಅದಲ್ಲ."
    },
    {
      "t": "06:10",
      "text": "ಖಂಡಿತ."
    },
    {
      "t": "06:11",
      "text": "ಯಾಕಂದ್ರೆ ಅದು ಎನ್ ಆಗಿರ್ಲಿ ಗಂಡ್ ಆಗಿರಲಿ ಒಬ್ಬರಿಗೆ ಕಂಫರ್ಟ್ ಇರಬೇಕು ಒಬ್ಬರಿಗೆ ಅನಿಸಬೇಕು."
    },
    {
      "t": "06:16",
      "text": "ಹೌದು."
    },
    {
      "t": "06:17",
      "text": "ಅನ್ಸೋ ತನಕ ಅದು ಯಾರು ಕರ್ದಿ ಹೇಳೋದಲ್ಲ ಅದು. ಅನ್ಸಿದ್ರೆ ಮಾತ್ರ ಆ ಮುಂದ ಆ ಬೆಳವಣಿಗೆ ಇರಬೇಕು."
    },
    {
      "t": "06:27",
      "text": "ನಂಗೂ ಅಷ್ಟೇ ಒಂದು ರಿಲೇಷನ್ಶಿಪ್ ಅಂತ ಅಂದ್ರೆ ಅದಕ್ಕೊಂದು ವ್ಯಾಲ್ಯೂ ಇರಬೇಕು. ಒಂದು ರೇಸ್ಪೆಕ್ಟ್ ಇರಬೇಕು. ಅಂಡರ್ಸ್ಟ್ಯಾಂಡಿಂಗ್ ಇರಬೇಕು."
    },
    {
      "t": "06:35",
      "text": "ಬಟ್ ನಿಮಗೆ ಇಷ್ಟ ಇದೆ ತಾನೇ ಆತರ ಸಪೋರ್ಟ್ ಆಗಿರೋದಕ್ಕೆ?"
    },
    {
      "t": "06:39",
      "text": "ಇದು ಯಾಕಕ್ಕೋಸ್ಕರ ನಾನು ಒಂದು ಫ್ರೆಂಡ್ ಬೇಕು ಅಂತಾನೆ ಬಂದಿರೋದು."
    },
    {
      "t": "06:44",
      "text": "ಬಟ್ ಅಂಡರ್ಸ್ಟ್ಯಾಂಡಿಂಗ್ ಕೂಡ ಇಂಪಾರ್ಟೆಂಟ್. ಫ್ರೆಂಡ್ ಅಂದ ಮಾತ್ರಕ್ಕೆ ಯಾರೋ ಸಿಕ್ಕಿದ್ರು ಯಾರ ಜೊತೆನೂ ಹೋದೆ ಆತರ ಎಲ್ಲಾ ಇಲ್ಲ."
    },
    {
      "t": "06:49",
      "text": "ಅಂಡರ್ಸ್ಟ್ಯಾಂಡಿಂಗ್ ಇರ್ಬೇಕು ಅದರ ಜೊತೆ ಒಂದು ಸೀಕ್ರೆಟ್ ಇದರಲ್ಲೂ ಇರ್ಬೇಕು."
    },
    {
      "t": "06:54",
      "text": "ಇರ್ಬೇಕು."
    },
    {
      "t": "06:55",
      "text": "ನಿಮ್ ಸೇಫ್ಟಿ ಇದರಲ್ಲೂ ಇರ್ಬೇಕು."
    },
    {
      "t": "06:57",
      "text": "ಹೌದು. ಯಾರೋ ಸಿಕ್ಕಿದ್ರು ನಾನು ಹೋದೆ ಒಂದು ಸಲ ಹೋದೆ ಎರಡು ಸಲ ಹೋದೆ ಇದೆಲ್ಲ ನನಗೆ ಬೇಡ."
    },
    {
      "t": "07:01",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ನನಗೆ ನನಗೆ ಚೆನ್ನಾಗಿ"
    },
    {
      "t": "07:04",
      "text": "ಅದಲ್ಲದೆ ಏನಿದು ಒಂದು ಟೆಂಪಲ್ ಗೆ ಹೋಗ್ಲಿ ನಂಗೆ ಒಬ್ಬಳೇ ಹೋಗ್ಬೇಕು ತುಂಬಾನೇ ಬೇಜಾರಾಗುತ್ತೆ. ಇವಾಗ ನನಗೆ ನನಗೂ ಟೆಂಪಲ್ ಗೆ ಹೋಗೋಕೆ ಇಷ್ಟ ಆದ್ರೆ ಒಬ್ಬನೇ ಹೋಗ್ತಾನೆ ಇರ್ತೀನಿ."
    },
    {
      "t": "07:11",
      "text": "ಹ್ಮ್ ನಾನೂ ಅದೇ ಮಾಡೋದು. ನಾನು ಒಬ್ಬನೇ ಹೋಗ್ತೀನಿ."
    },
    {
      "t": "07:16",
      "text": "ನನಗೆ ಒಬ್ಬನೇ ಇದ್ದು ಇದ್ದು ತುಂಬಾ ಅಭ್ಯಾಸ ಜೀವನದಲ್ಲಿ."
    },
    {
      "t": "07:21",
      "text": "ಜಾಸ್ತಿ ಹೋಗ್ತೀನಿ ಇದ್ದೆ ಅಭ್ಯಾಸ."
    },
    {
      "t": "07:23",
      "text": "ಮುಂದೆ ಐದಾರು ವರ್ಷ ಆಯಿತು."
    },
    {
      "t": "07:27",
      "text": "ಅದು ಒಂದು ಸಲ ತುಂಬಾ ಚೆನ್ನಾಗಿರುತ್ತೆ. ಆರು ವರ್ಷ ಆಯ್ತು ಆರು ವರ್ಷ ಆಯ್ತು ಎಲ್ಲಾ ಸವಾಸ ಬಿಟ್ಟಿ."
    },
    {
      "t": "07:29",
      "text": "ಆಗಿನಿಂದನು ಒಬ್ಬನೇ ಮೂವಿಗೆ ಹೋದ್ರು ಒಬ್ಬನೇ ಎಲ್ಲೋದ್ರು ಒಬ್ಬನೇ."
    },
    {
      "t": "07:35",
      "text": "ಸೋಲೋ ಟ್ರಿಪ್ ಹೋಗಿದ್ದೀರಾ?"
    },
    {
      "t": "07:37",
      "text": "ಹಾ ಒಬ್ಬೊಬ್ಬನೇ ಹೋಗ್ತೀನಿ."
    },
    {
      "t": "07:40",
      "text": "ಏನ್ ಹೇಳಿ ಮೈಸೂರು. ಎಂತ ಕೇಳಿ?"
    },
    {
      "t": "07:43",
      "text": "ಎಂತಕ್ಕೆ?"
    },
    {
      "t": "07:44",
      "text": "ದೇವರಿಗೆ."
    },
    {
      "t": "07:45",
      "text": "ಮೈಸೂರಿಗೆ ಚಾಮುಂಡೇಶ್ವರಿ."
    },
    {
      "t": "07:48",
      "text": "ಹ್ಮ್ ನಾವು ಮುನ್ನ ನೋಡೋಕೆ ಹೋಗ್ತಾನೆ ಇರ್ತೀನಿ."
    },
    {
      "t": "07:54",
      "text": "ಅಷ್ಟೇ."
    },
    {
      "t": "07:55",
      "text": "ಅಮ್ಮ ಒಳ್ಳೇದು ಮಾಡ್ಲಿ ನಂಗೆ."
    },
    {
      "t": "07:58",
      "text": "ನಾನು ಹೋಗ್ತೀನಿ ನಾನು ನಾನು ಹೋಗ್ತಾನೆ ಇರ್ತೀನಿ ನನಗ ನಂಗೆ ಮನಸ್ಸಿಗೆ ನೆಮ್ಮದಿ ಬೇಕಂದ್ರೆ ನನಗೆ ಜೀವನದಲ್ಲಿ ನೆಮ್ಮದಿ ಕೊಡೋ ಜಾಗ ಅಂದ್ರೆ ಅದು ಒಂದೇ."
    },
    {
      "t": "08:06",
      "text": "ಓಕೆ."
    },
    {
      "t": "08:07",
      "text": "ಸೊ ನಾನು ಒಬ್ಬನೇ ಹೋಗ್ತೀನಿ."
    },
    {
      "t": "08:09",
      "text": "ಬೈಕ್ ಹತ್ಕೊಂಡು ಹೋಗ್ತಾ ಇರ್ತೀನಿ."
    },
    {
      "t": "08:14",
      "text": "ಯಾರ್ಯಾರಿದ್ದೀರಾ ಮನೆಯಲ್ಲಿ?"
    },
    {
      "t": "08:17",
      "text": "ಮನೇಲಿ ತಂದೆ ತಾಯಿ ಅಕ್ಕ ಎಲ್ಲ ಇರ್ತಾರೆ."
    },
    {
      "t": "08:19",
      "text": "ತಾಕಾ ಬಾಬು ಎಲ್ಲಾ."
    },
    {
      "t": "08:22",
      "text": "ಸಿಕ್ಕೋದಾ ನೀವು?"
    },
    {
      "t": "08:26",
      "text": "ಇನ್ನೊಂದು ಸಲ ಮಾತಾಡೋಣ."
    },
    {
      "t": "08:28",
      "text": "ಹ ನಂಬರ್ ಎಕ್ಸ್ಚೇಂಜ್ ಮಾಡಿಕೊಳ್ಳೋಣ ತೊಂದರೆ ಇಲ್ಲ. ಒಂದೆರಡು ಸಲ ಕಾಲಲ್ಲೂ ಮಾತಾಡೋಣ."
    },
    {
      "t": "08:32",
      "text": "ಓಕೆ ಕಂಫರ್ಟಬಲ್ ಇದೆ ಇಲ್ಲ ಅಂತಲ್ಲ. ಬಟ್ ಇನ್ನು ಸ್ವಲ್ಪ ಕಂಫರ್ಟಬಲ್ ಅನ್ಸುತ್ತೆ ಅಂತ ನೋಡೋಣ."
    },
    {
      "t": "08:40",
      "text": "ನಿಮ್ ರಿಕ್ವೈರ್ಮೆಂಟ್ ಹೇಳಿ ಏನು ತೊಂದರೆ ಇಲ್ಲ."
    },
    {
      "t": "08:43",
      "text": "ಅಂದ್ರೆ ರಿಕ್ವೈರ್ಮೆಂಟ್ ಅಂದ್ರೆ ಯಾವ ತರ?"
    },
    {
      "t": "08:47",
      "text": "ಅಂದ್ರೆ ನಿಮಗೆ ಹೆಂಗೆ ಬೇಕು ಏನು ಅಂತ ಅಂದ್ಬಿಟ್ಟು ಯಾಕಂದ್ರೆ ನಾನು ಯಾವುದುಕ್ಕೂ ನಿಮಗೆ ಫೋರ್ಸ್ ಫುಲ್ಲಿ ಅಂತ ಹೇಳೋಕೆ ಆಗಲ್ಲ."
    },
    {
      "t": "08:52",
      "text": "ಅಂಡ್ ನನಗೇನು ಎಕ್ಸ್ಪೀರಿಯನ್ಸ್ ಇಲ್ಲ ನನಗೆ ನಾರ್ಮಲ್ ಮೀಟ್ ಅಪ್"
    },
    {
      "t": "08:57",
      "text": "ಅಂದ್ರೆ ಹೊಸಬರು ಅಂದ್ರೆ ಹೊಸಬರನ್ನ ಎಕ್ಸ್ಪ್ಲೋರ್ ಮಾಡೋಕೆ ಮಾತಾಡಿಕೊಂಡಿರೋದಕ್ಕೆ ನನಗೆ ಇಷ್ಟ."
    },
    {
      "t": "09:02",
      "text": "ಅವರ ಬಗ್ಗೆ ಪರಿಚಯ ಮಾಡಿಕೊಂಡು ತಿಳ್ಕೊಳೋಕೆ ಮಾತುಕಥೆ ಮಾಡೋಕೆ ನನಗೆ ಇಷ್ಟ."
    },
    {
      "t": "09:07",
      "text": "ಇದು ನನ್ನ ಪಾಯಿಂಟ್ ಆಫ್ ವ್ಯೂ."
    },
    {
      "t": "09:09",
      "text": "ಅವರಿಂದ ಅದು ಬೇಕು ಇದು ಬೇಕು ಅಂತ ನನಗೆ"
    },
    {
      "t": "09:13",
      "text": "ಆ ಆಸೆಗಳಿಗಿಂತನು ಮಾತಾಡಬೇಕು ಅನ್ನೋದು ನನಗೆ."
    },
    {
      "t": "09:16",
      "text": "ಚೆನ್ನಾಗಿರಬೇಕು."
    },
    {
      "t": "09:17",
      "text": "ಆತರ ಹೊಸಬರ ಜೊತೆ ಮಾತಾಡಬೇಕು ಅಂದ್ರೆ ಆಪ್ ಅಲ್ಲಿ ಮಾತಾಡಬೇಕು ಚೆನ್ನಾಗಿರುತ್ತೆ ಅಲ್ವಾ? ಒಂದು ನ್ಯೂ ಪರ್ಸನ್ ಸಿಕ್ತಾರೆ ನಿಮಗೆ ಅಂತ."
    },
    {
      "t": "09:23",
      "text": "ಅಲ್ಲ ಹಂಗಲ್ಲ ಅಂದ್ರೆ ಒಬ್ಬರ ಜೊತೆ ಇದ್ದರೆ ಲೈಕ್ ಒಂದು ಆ ಬಾಂಡಿಂಗ್ ಇರಬೇಕು. ಒಂದು ಫ್ರೆಂಡ್ಶಿಪ್ ದು."
    },
    {
      "t": "09:29",
      "text": "ಓಕೆ."
    },
    {
      "t": "09:32",
      "text": "ಅರ್ಥ ಆಯ್ತು ಅನ್ಕೋತೀನಿ."
    },
    {
      "t": "09:36",
      "text": "ಸೊ ವಾಟ್ಸಾಪ್ ಅಲ್ಲಿ ಪಿಂಗ್ ಮಾಡ್ತಾ."
    },
    {
      "t": "09:39",
      "text": "ಹಾ ಮಾಡಿ."
    },
    {
      "t": "09:40",
      "text": "ನಂಬರ್"
    },
    {
      "t": "09:42",
      "text": "ತ್ರಿಬಲ್ ಎಟ್ ನಾಳೆ ಮಾತಾಡೋಣ. ಓಕೆನಾ ಈಗ ಬೇಡ."
    },
    {
      "t": "09:45",
      "text": "ಓಕೆನಾ ಓಕೆ ನಾನ್ ನಿಮಗೆ."
    },
    {
      "t": "09:48",
      "text": "ಓಕೆ ಓಕೆ ಓಕೆ ಏನು ತೊಂದರೆ ಇಲ್ಲ ನಿಮಗೆ ಇಷ್ಟ."
    },
    {
      "t": "09:52",
      "text": "ತ್ರಿಬಲ್ ಎಟ್ ಯಾಕಂದ್ರೆ."
    },
    {
      "t": "09:54",
      "text": "ತ್ರಿಬಲ್ ಎಟ್"
    },
    {
      "t": "09:55",
      "text": "ತ್ರಿಬಲ್ ಎಟ್ ಓಕೆ."
    },
    {
      "t": "09:57",
      "text": "ಫೋರ್ ಫೈವ್."
    },
    {
      "t": "09:58",
      "text": "ಓಕೆ."
    },
    {
      "t": "09:59",
      "text": "89."
    },
    {
      "t": "10:02",
      "text": "ಫೈವ್ ಸೆವೆನ್ ಫೋರ್."
    },
    {
      "t": "10:07",
      "text": "ತ್ರಿಬಲ್ ಎಟ್ ಫೋರ್ ಫೈವ್."
    },
    {
      "t": "10:09",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "10:10",
      "text": "85."
    },
    {
      "t": "10:13",
      "text": "89."
    },
    {
      "t": "10:16",
      "text": "89574."
    },
    {
      "t": "10:20",
      "text": "89."
    },
    {
      "t": "10:23",
      "text": "574."
    },
    {
      "t": "10:29",
      "text": "ಬಂತಾ ನೋಡಿ ಮೆಸೇಜ್."
    },
    {
      "t": "10:33",
      "text": "ಬಂದಿಲ್ಲವೇ? ನಾ ಬಂತು."
    },
    {
      "t": "10:37",
      "text": "ಇಂದು"
    },
    {
      "t": "10:39",
      "text": "ಡಬಲ್ ಝೀರೋ ಫೋರ್ ಅಲ್ಲ."
    },
    {
      "t": "10:41",
      "text": "ಹೌದು."
    },
    {
      "t": "10:43",
      "text": "ನಿಮ್ ನೇಮ್?"
    },
    {
      "t": "10:45",
      "text": "ಶಿವರಾಜ್."
    },
    {
      "t": "10:46",
      "text": "ಗೌಡ."
    },
    {
      "t": "10:48",
      "text": "ಓಹ್ ಗೌಡ ಅಂತ."
    },
    {
      "t": "10:50",
      "text": "ನೈಟ್ ಗೌಡ ಬಾರ ಅಲ್ಲ ಬಾರ."
    },
    {
      "t": "10:52",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ನಾವು ಗೌಡ ಅಷ್ಟೇ."
    },
    {
      "t": "10:55",
      "text": "ಗೌಡ ನೀವು."
    },
    {
      "t": "10:57",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "11:00",
      "text": "ನಾವು ಗೌಡ ಅಷ್ಟೇ."
    },
    {
      "t": "11:02",
      "text": "ನಮ್ಮ ಗೌಡ."
    },
    {
      "t": "11:03",
      "text": "ಸ್ವಲ್ಪ ಹೆಂಗಾಕೆ ಕಾಣಿಸ್ತೀರಾ?"
    },
    {
      "t": "11:05",
      "text": "ಆಕ್ಚುಲಿ."
    },
    {
      "t": "11:07",
      "text": "ಹೌದಾ."
    },
    {
      "t": "11:10",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "11:12",
      "text": "ಸಿಕ್ಕಬಹುದ ನಾಳೆ?"
    },
    {
      "t": "11:14",
      "text": "ನಾಳೆ."
    },
    {
      "t": "11:16",
      "text": "ಮೇ ಬಿ ಆಗೋಣ. ನಾಳೆ ಹೇಳ್ತೀನಿ ಅಂದ್ರೆ."
    },
    {
      "t": "11:18",
      "text": "ಹೇಳ್ತೀನಿ ನಾಳೆ."
    },
    {
      "t": "11:21",
      "text": "ಸದ್ಯಕ್ಕೆ ನಾವು ಸ್ಯಾಟರ್ಡೇ ನೋ ಯಾವತ್ತು ನಾಳೆ ಹೇಳ್ತೀನಿ ಅದು ಕಂಫರ್ಟ್ ಮಾಡ್ಕೊಂಡು ನಂದು ವರ್ಕ್ ಏನಿರುತ್ತೆ ಅಂದ್ರೆ ನನಗೊಂದು ನಾಲ್ಕು ಪರ್ಮಿಷನ್ ಸಿಗಬಹುದಾ ಬೇಗ ಬರಲಿಕ್ಕೆ ಹಾಗೆ. ಎಲ್ಲಿಗೆ ಹೋಗ್ತೀರಾ ಕೆಲಸಕ್ಕೆ?"
    },
    {
      "t": "11:30",
      "text": "ಸಿನ್ಯಾ."
    },
    {
      "t": "11:32",
      "text": "ಎಲ್ಲಾಂಕಂದೆ?"
    },
    {
      "t": "11:34",
      "text": "ಹ್ಮ್ ಅಂದ್ರೆ ಎಲ್ಲಂಕ ಅಂದ್ರೆ ಎಲ್ಲಂಕದಲ್ಲಿ ಇಲ್ಲ."
    },
    {
      "t": "11:37",
      "text": "ಪಟ್ಟು ಲೈಟ್ ಇನ್ನು ಸ್ಟಾರ್ಟಿಂಗ್ ಅಲ್ಲೇ ಇರೋದು."
    },
    {
      "t": "11:41",
      "text": "ಓಕೆ ಏನ್ ಏನ್ ಕೆಲಸ?"
    },
    {
      "t": "11:43",
      "text": "ನಾನು ಫಸ್ಟ್ ಜುವೆಲರಿ ಶೋರೂಮ್ ಅಲ್ಲೇ ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೆ ಕಂದ್ರೆ. ಮಂಗಳ ಸ್ಯಾಟಲ್ ಎಲ್ಲಾ ಚೆನ್ನಾಗಿತ್ತು."
    },
    {
      "t": "11:49",
      "text": "ಬಟ್ ತುಂಬಾ ಟೈಮಿಂಗ್ಸ್. ಟೆನ್ ಸೆಂಟಿ ಟು ಏಟ್ ಓ ಕ್ಲಾಕ್ ಹಾಗೆ."
    },
    {
      "t": "11:53",
      "text": "ಮನೇಲಿ ಮಗನ ಜೊತೆ ಟೈಮ್ ಸ್ಪೆಂಡ್ ಮಾಡ್ಲಿಕ್ಕೆ ಆಗ್ತಾ ಇರ್ಲಿಲ್ಲ ನನಗೆ."
    },
    {
      "t": "11:58",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "11:59",
      "text": "ಹಾಗಾಗಿ ಅದು ಬಿಟ್ಟಿದೀನಿ. ಈಗ ನೀವು ಜನವರಿಯಿಂದ ಮಾತ್ರ ಸೇರ್ಕೊಂಡಿದೀನಿ. ಒನ್ ಇಯರ್ ಆಗ್ಬೇಕು. ಸ್ವಲ್ಪ ವರ್ಕ್ ತಗೋ ಎಕ್ಸ್ಪೀರಿಯನ್ಸ್ ತಗೋತಾ ಇದೀನಿ ಇವಾಗ."
    },
    {
      "t": "12:07",
      "text": "ಹಾಗಾಗಿ ಈ ಕಡೆ ಬಂದಿದ್ದೀನಿ."
    },
    {
      "t": "12:12",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "12:13",
      "text": "ಏನಾದ್ರು ಡ್ರಿಂಕಿಂಗ್ ಮಾಡ್ತೀರಾ?"
    },
    {
      "t": "12:15",
      "text": "ಇಲ್ಲಪ್ಪ ಯಾಕೆ?"
    },
    {
      "t": "12:17",
      "text": "ಹೇಳಿ ಕೇಳ್ದೆ."
    },
    {
      "t": "12:18",
      "text": "ಗೌಡರಲ್ಲಿ ನೋಡ್ಕೋ ಕೂಡ ಮಾಡ್ತಾನೆ ನಿಮಗೆ ಗೊತ್ತೋದು."
    },
    {
      "t": "12:21",
      "text": "ಇಲ್ಲ ನಮ್ಮ ಫ್ಯಾಮಿಲಿ ಇದರಲ್ಲಿ ಮಾಡ್ತಾರೆ."
    },
    {
      "t": "12:24",
      "text": "ಹೌರ ಅಲ್ಲ."
    },
    {
      "t": "12:25",
      "text": "ಮಾಡೋದು ಹ್ಮ್."
    },
    {
      "t": "12:27",
      "text": "ನಿಮಗೆ ಗೊತ್ತಾ ಅದು?"
    },
    {
      "t": "12:29",
      "text": "ನಮ್ಮ ಫ್ಯಾಮಿಲಿಯಲ್ಲಿ ಯಾರು ಮಾಡಲ್ಲ. ನಮ್ಮ ನಮ್ದು ಅಜ್ಜಿ ಮನೆಯಲ್ಲಿ ಚಿಕ್ಕಮಗಳು ಅದು ಮನೆ ನಾಡು."
    },
    {
      "t": "12:35",
      "text": "ಅಲ್ಲೆಲ್ಲ ಹಾಗ ನಮ್ಮ ಫ್ಯಾಮಿಲಿ ಬ್ಯಾಕ್ಗ್ರೌಂಡ್ ಅಂದ್ರೆ ಮಾಡ್ತಾರೆ ಎಲ್ಲರೂ ಅಲ್ಲ."
    },
    {
      "t": "12:40",
      "text": "ಹೇಳಿದ್ದು ಅಷ್ಟೇ."
    },
    {
      "t": "12:43",
      "text": "ತಪ್ಪು ತಿಳ್ಕೊಬೇಡಿ."
    },
    {
      "t": "12:44",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ತಪ್ಪು ತಿಳ್ಕೊಳೋಣ. ಅದ್ರಲ್ಲಿ ಏನು ಈಗ ಅದು ಕಾಮನ್ ಆಗಿದೆ. ಬಟ್ ನಮಗೆ ಇದು ಅಭ್ಯಾಸ ಇಲ್ಲ. ನಮ್ಮ ಜೂನಿಯರ್ಸ್ ಗೆಲ್ಲ ಮೇ ಬಿ ಅದು ಸ್ವಲ್ಪ ಮೇ ಬಿ ಕಾಮನ್ ಅಂತ ಅನ್ಸುತ್ತೇನೋ."
    },
    {
      "t": "12:54",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "12:55",
      "text": "ಒನ್ ಸೆಕೆಂಡ್ ನಂಬರ್ ಸೇವ್ ಮಾಡ್ಕೊಂಡ್ರೆ."
    },
    {
      "t": "13:00",
      "text": "ಯಾವುದೇ ಮಾಡ್ಕೊಂಡಿಲ್ಲ. ಆಮೇಲೆ ಮಾಡ್ಕೊಂತೀನಿ ಶಿವರಾಜ್."
    },
    {
      "t": "13:04",
      "text": "ಆಮೇಲೆ ಮರೆತು ಹೋಗ್ಬಿಡ್ತೀರಾ ಬೆಳಗಡೆ ಬೆಳಗ್ಗೆ."
    },
    {
      "t": "13:08",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ಹಾಗೇನಿಲ್ಲ ನಿಮಗೆ ನಂಬರ್ ಕೊಟ್ಟಿದೀನಿ. ಅಕಸ್ಮಾತ್ ಮರೆತು ಹೋದ್ರೆ ನೀವಾದರೂ ಮಾಡಬಹುದು ಅಲ್ವಾ ನಂಬರ್ ಇದೆಯಲ್ಲ ಅಲ್ವಾ ನನ್ನ ಹತ್ರ."
    },
    {
      "t": "13:17",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "13:19",
      "text": "ಸಿಗೋದ್ ನಾಳೆ?"
    },
    {
      "t": "13:21",
      "text": "ನಾರ್ಮಲ್ ಕ್ಯಾಶುಯಲ್ ಕಾಫಿ?"
    },
    {
      "t": "13:23",
      "text": "ಇರಬಹುದು ಅದೇ ಬಟ್ ನಾಳೆನೇ ಆಗಲ್ಲ ಅದೇ."
    },
    {
      "t": "13:27",
      "text": "ನಾಳೆನೇ ಆಗಲ್ಲ. ನಾಳೆ ನಿಮಗೆ ಕನ್ಫರ್ಮ್ ಮಾಡ್ತೀನಿ. ಯಾವಾಗ ಸಿಗ್ತೀನಿ ಅಂತ."
    },
    {
      "t": "13:30",
      "text": "ಆಯ್ತು."
    },
    {
      "t": "13:31",
      "text": "ನಾನು ಸ್ವಲ್ಪ ಮಲ್ಲೇಶ್ವರಂ ಹೋಗ್ಬೇಕು ಅಂತ ಅನ್ಕೊಂಡಿದೀನಿ. ನೋಡೋಣ ನಾನು ಯಾವಾಗ ಬರ್ತೀನಿ ಅಂತ ಹೇಳ್ತೀನಿ."
    },
    {
      "t": "13:34",
      "text": "ಮಲ್ಲೇಶ್ವರಂ."
    },
    {
      "t": "13:35",
      "text": "ಹ್ಮ್ ನೀವು ಯಾವ ಏರಿಯಾದಲ್ಲಿ ಇರೋದು?"
    },
    {
      "t": "13:37",
      "text": "ಇಂದಿರಾನಗರ."
    },
    {
      "t": "13:39",
      "text": "ಓಕೆ."
    },
    {
      "t": "13:41",
      "text": "ಯಾರ್ಬಿ."
    },
    {
      "t": "13:43",
      "text": "ಮಲ್ಲೇಶ್ವರಂ ಹತ್ರ."
    },
    {
      "t": "13:44",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "13:45",
      "text": "ಆ ನೋಡೋಣ ಅಲ್ಲೇ ಅಲ್ಲೇ ಬೇಕಾದ್ರೆ ಸಿಗ್ತೀನಿ. ನನಗೆ ಸ್ವಲ್ಪ ಬರಬೇಕು ಅಲ್ಲಿಗೆ ಬರ್ತೀನಿ."
    },
    {
      "t": "13:50",
      "text": "ನಾಳೆ ಬನ್ನಿ ಸಿಗೋಣ."
    },
    {
      "t": "13:51",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "13:53",
      "text": "ನಾಳೆ ಬನ್ನಿ ಸಿಗೋಣ ಅಷ್ಟೇ ನಾವು ಮಳೆಗೆ."
    },
    {
      "t": "13:56",
      "text": "ಇಲ್ಲ."
    },
    {
      "t": "13:57",
      "text": "ಇಲ್ಲ ನಾಳೆನೇ ಆಗಲ್ಲ ಯಾಕಂದ್ರೆ."
    },
    {
      "t": "13:59",
      "text": "ಸರಿ ಆಯ್ತು ಯಾವುದು ನಿಮ್ಮ ಇಷ್ಟ."
    },
    {
      "t": "14:02",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "14:03",
      "text": "ಆಯ್ತು ಫೋನ್ ಮಾಡ್ತೀನಿ ನಾಳೆ ಓಕೆ?"
    },
    {
      "t": "14:05",
      "text": "ಸೊ ಓಕೆ ಕಣ್ರಿ."
    },
    {
      "t": "14:07",
      "text": "ನೈಸ್ ಮೀಟಿಂಗ್."
    },
    {
      "t": "14:09",
      "text": "ನಮಗೂ ಕೂಡ."
    },
    {
      "t": "14:10",
      "text": "ಖುಷಿ ಆಯ್ತು."
    },
    {
      "t": "14:13",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "14:14",
      "text": "ಟ್ವಿಸ್ಟ್ ಓಕೆ ಅನ್ಸುತ್ತಾ? ಖುಷಿ ಆಯ್ತು ನಿಮಗೇನು ಅನ್ಸುತ್ತೆ? ಖಂಡಿತ ಖುಷಿ ಆಯ್ತು."
    },
    {
      "t": "14:18",
      "text": "ಖಂಡಿತ ಖುಷಿ ಆಯ್ತು ಯಾಕೆ ಗೊತ್ತಾ?"
    },
    {
      "t": "14:20",
      "text": "ಆಪ್ ಅಲ್ಲಿ ಬರೋವರೆಲ್ಲ ಬೇರೆ ಬೇರೆ ತರ ಮಾತಾಡ್ತಾರೆ. ಬಟ್ ಅದು ನನಗೆ ಇಷ್ಟ ಆಗಲ್ಲ."
    },
    {
      "t": "14:25",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "14:26",
      "text": "ಆಂಗಂತ ಅದು ತಪ್ಪು ಅಂತ ನಾನು ಹೇಳಲ್ಲ. ಬಟ್ ಅವರು ಅದು ಗೊತ್ತಿಲ್ದೆ ಇರೋ ವ್ಯಕ್ತಿಗಳ ಹತ್ತಿರ ನಮ್ಮ ಪರ್ಸನಲ್ ಮಾತಾಡೋದು ತುಂಬಾ ಕಷ್ಟ. ಬಟ್ ಅವರಿಗೆ ಅದು ಕಷ್ಟ ಆಗ್ತಿಲ್ಲ ಅನ್ಸುತ್ತೆ ಬೇರೆ ಜನಗಳಿಗೆ."
    },
    {
      "t": "14:38",
      "text": "ನನಗೆ ಅದು ಆಶ್ಚರ್ಯ."
    },
    {
      "t": "14:41",
      "text": "ಏನು ತೊಂದರೆ ಇಲ್ಲ. ನಿಮಗೆ ನಾರ್ಮಲ್ ಆಗಿ ಸಿಗಿ. ಅದಾದ್ಮೇಲೆ ಮುಂದಕ್ಕೆ ಮಾತುಕಥೆ. ಏನಂತೀರಾ?"
    },
    {
      "t": "14:46",
      "text": "ಅದೇನೆ ಬಟ್ ಇದರಲ್ಲಿ ಈಗ ನೀವು ಈಗ ನೀವು ಆರಾಮಾಗಿ ಮಾತಾಡ್ರಿ. ಒಂದು ಫ್ರೆಂಡ್ಲಿ ಆಗಿ ಮಾತಾಡ್ರಿ. ಇದು ಒಂದು ಇದು ಚೆನ್ನಾಗಿರುತ್ತೆ. ಬಟ್ ಯಾರೋ ಬರ್ತಾರಂತೆ ಏನೋ ಅವರು ಹೆಂಗೆ ಬರ್ತಾರೆ ಏನ್ ವಿಚಿತ್ರವಾಗಿ ಬರ್ತಾರೆ ಏನೆಲ್ಲಾ ವರ್ಡ್ಸ್ ಕೆಲವೊಬ್ಬರು ಎಲ್ಲರೂ ಅಲ್ಲ."
    },
    {
      "t": "15:02",
      "text": "ಹ್ಮ್ ಹ್ಮ್."
    },
    {
      "t": "15:03",
      "text": "ಹಂಗಿರುತ್ತೆ."
    },
    {
      "t": "15:05",
      "text": "ಓಕೆ ಇಂಗೆ ಎನಿವೇ ಖುಷಿ ಆಯ್ತು ಸಿಕ್ಕಿ."
    },
    {
      "t": "15:09",
      "text": "ಖಂಡಿತ ಖುಷಿ ಆಯ್ತು. ಯಾಕಂದ್ರೆ ನಾನು ನಂಬರ್ ಯಾಕ್ರಿ ಕೊಡ್ತಾ ಇದ್ದೆ? ನಾನು ಹೆಂಗೆ ಅಂದ್ರೆ ನಂಬರ್ ಕೊಡಲ್ಲ. ನಂಬರ್ ಕೊಡೋದು"
    },
    {
      "t": "15:15",
      "text": "ನೋಡೋಣ ಇಲ್ಲ."
    },
    {
      "t": "15:17",
      "text": "ಆಯ್ತು ಸಿಗೋಣ ಹಾಗಿದ್ರೆ."
    },
    {
      "t": "15:19",
      "text": "ಖಂಡಿತ ಖಂಡಿತ."
    },
    {
      "t": "15:20",
      "text": "ಸೊ ಎಲ್ಲಾ ಹಂಗೆ ಅನ್ಕೊಳ್ಳುವ ಹಾಗಿದ್ರೆ ಮುಂದಕ್ಕೆ ಹೋಗೋಣ."
    },
    {
      "t": "15:25",
      "text": "ನೋಡೋಣ ಮುಂದಿನ ನಮ್ಮ ನಾವಿಬ್ಬರು ಹೇಗಿರ್ತೀವಿ ನಮ್ಮ ಅಂಡರ್ಸ್ಟ್ಯಾಂಡಿಂಗ್ ಹೇಗಿರುತ್ತೆ?"
    },
    {
      "t": "15:30",
      "text": "ಅದರ ಮೇಲೆ ಡಿಪೆಂಡ್ ಆಗುತ್ತೆ. ಕೊನೆಗೆ ಅದೇ. ಕೊನೆಗೆ ಅದೇ."
    },
    {
      "t": "15:35",
      "text": "ನಾರ್ಮಲ್ ಆಗಿ ಸಿಗೋಣ ಫಸ್ಟ್ ಓಕೆ."
    },
    {
      "t": "15:38",
      "text": "ಓಕೆ ಅಪ್ಪ."
    },
    {
      "t": "15:39",
      "text": "ಸರಿ ಅಮ್ಮ ಓಕೆ ಗುಡ್ ನೈಟ್. ಯಾ."
    },
    {
      "t": "15:42",
      "text": "ಎಲ್ಲರಿಗೂ ಟೇಕ್ ಕೇರ್."
    },
    {
