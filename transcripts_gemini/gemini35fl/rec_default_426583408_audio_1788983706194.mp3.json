      "text": "ಬೆಂಗಳೂರಾ"
    },
    {
      "t": "00:06",
      "text": "ಬೆಂಗಳೂರಾ ಕಂದ್ರೆ ಏನು ಬೆಂಗಳೂ"
    },
    {
      "t": "00:08",
      "text": "ಬೆಂಗಳೂರು ಯಾವಾಗಿನ"
    },
    {
      "t": "00:09",
      "text": "ಬೆಂಗಳೂರಾನ್ಸಲ್ ಇಗೋ"
    },
    {
      "t": "00:11",
      "text": "ಎಲ್ಲಿ?"
    },
    {
      "t": "00:13",
      "text": "ಎಲ್ಲೋ ಹಂಗೆ"
    },
    {
      "t": "00:15",
      "text": "ಒಮ್ಮೆ ಇಟ್ರೆ."
    },
    {
      "t": "00:17",
      "text": "ಎಲ್ಲರೀ ನಾನು ಹೋಗಲ್ಲ ಮದುವೆಗೆ ಅಂತ ಇರೋದು."
    },
    {
      "t": "00:20",
      "text": "ಎಂತ ಕೇಳ್ಕೊ."
    },
    {
      "t": "00:23",
      "text": "ಒಂದು ಫ್ರೆಂಡ್ ಸಿಕ್ತಾನೆ ಅಂತ ಬರ್ತಾ ಇದೀನಿ."
    },
    {
      "t": "00:25",
      "text": "ಯಾವ ತರ ಫ್ರೆಂಡ್ ಇಷ್ಟು?"
    },
    {
      "t": "00:29",
      "text": "ಯಾವ ತರ ಅಂದ್ರೆ ನನ್ನ ಹಸ್ಬೆಂಡ್ ಒಬ್ಬನೇ ತಗೊಂಡು ಹೋದ್ನು ಅಲ್ಲಿ"
    },
    {
      "t": "00:34",
      "text": "ಒಬ್ಬಳೇ ನನಗೆ ಬೇಜಾರ್ ಆಗ್ತಾ ಇದೆ. ಎಲ್ಲಾದರೂ ಹೋದರೆ ಬಂದ್ರೆ"
    },
    {
      "t": "00:39",
      "text": "ಒಬ್ಬಳೇ ಹೋಗ್ಬೇಕು."
    },
    {
      "t": "00:41",
      "text": "ಸೊ ಅದುಕ್ಕೋಸ್ಕರ"
    },
    {
      "t": "00:43",
      "text": "ಸ್ಯಾಟಿಸ್ಫ್ಯಾಕ್ಷನ್ ಇಲ್ಲ ಅಂತರ."
    },
    {
      "t": "00:45",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ನನ್ನ ಹಸ್ಬೆಂಡ್ ಬಂದು ಅದೊಂದಕ್ಕೆ ಅಂತ ಇಲ್ಲರೀ."
    },
    {
      "t": "00:48",
      "text": "ಊರಲ್ಲಿ ಇರೋದು."
    },
    {
      "t": "00:49",
      "text": "ಹ ಒಂದು ಟೆಂಪಲ್ ಗೆ ಹೋಗ್ಲಿ, ಒಂದು ಶಾಪಿಂಗ್ ಗೆ ಹೋಗ್ಲಿ, ಔಟಿಂಗ್ ಗೆ ಹೋಗ್ಲಿ, ಒನ್ ಡೇ ಟ್ರಿಪ್ ಗೆ ಹೋಗ್ಲಿ ಒಬ್ಬಳೇ ಹೋಗ್ಬೇಕು. ಹಾಗಾಗಿ ತುಂಬಾ ಬೇಜಾರಿದೆ."
    },
    {
      "t": "00:58",
      "text": "ಬಟ್ ನನ್ನ ಪರ್ಸನಲ್ ಗೂ ಕೂಡ ನನ್ನ ಹಸ್ಬೆಂಡ್ ಗೂ ಕೂಡ ಬೇಕು."
    },
    {
      "t": "01:02",
      "text": "ಅದಕ್ಕೋಸ್ಕರ ಒಂದು ಒಳ್ಳೆ ಫ್ರೆಂಡ್ ಸಿಕ್ತಾನೆ ಅಂತ ಬಂದಿದ್ದೀನಿ. ಬಟ್ ಇಲ್ಲಿ ಬೇರೆ ಬೇರೆ ಕಮ್ಯುನಿಕೇಶನ್ ಜಾಸ್ತಿ ಇದೆ ನೋಡಬೇಕು."
    },
    {
      "t": "01:09",
      "text": "ನಾವು ನಾರ್ಮಲ್ ಆಗಿ ಸಿಗಬಹುದಾ?"
    },
    {
      "t": "01:13",
      "text": "ನಾರ್ಮಲ್ ಆಗಿ ಅಂದ್ರೆ ಹೇಗೆ ರೀ?"
    },
    {
      "t": "01:16",
      "text": "ನಿಮಗೆ ಶಾಪಿಂಗ್ ಅಂದ್ರೆ ಶಾಪಿಂಗ್ ಎಲ್ಲಾ, ಮೂವಿ"
    },
    {
      "t": "01:19",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:20",
      "text": "ಆತರ"
    },
    {
      "t": "01:21",
      "text": "ಯಾವ ರೆಸ್ಟೋರೆಂಟ್ ಅಂದ್ರೆ"
    },
    {
      "t": "01:23",
      "text": "ನಾರ್ಮಲ್ ಆಂಕಲ್ ತರ ಅಲ್ಲ."
    },
    {
      "t": "01:25",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:26",
      "text": "ನಿಮಗೆ ಏನಾದರೂ ಹಂಗೆ ಕೇಳಿದ್ರೆ"
    },
    {
      "t": "01:29",
      "text": "ಅಥವಾ ನಿಮ್ಮ ನಿಮ್ಮ ಕಡೆಯಿಂದ ಅಷ್ಟೇ."
    },
    {
      "t": "01:34",
      "text": "ನಿಮಗೆ ಅನ್ಸಿದ್ರೆ ಮುಂದಕ್ಕೆ"
    },
    {
      "t": "01:37",
      "text": "ನನಗಿಂತ ತುಂಬಾ ಚಿಕ್ಕವರು ಅನ್ಕೊಂಡಿದ್ದೀರಾ ನೀವು."
    },
    {
      "t": "01:39",
      "text": "ಎಷ್ಟು ನಿಮಗೆ ಏಜ್?"
