      "text": "ಇಲ್ವಾ"
    },
    {
      "t": "00:39",
      "text": "ಏನ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ"
    },
    {
      "t": "00:41",
      "text": "ಹೌಸ್ ವೈಫ್"
    },
    {
      "t": "00:42",
      "text": "ಹೌಸ್ ವೈಫ್ ಆ"
    },
    {
      "t": "00:45",
      "text": "ಆ?"
    },
    {
      "t": "00:48",
      "text": "ಅಯ್ಯೋ"
    },
    {
      "t": "00:54",
      "text": "ಸರಿ ಏನೋ ಮಾಡಿ ಹೋಗ್ಲಿ"
    },
    {
      "t": "00:57",
      "text": "ನೀವೇನ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಿ ಅಂದೆ"
    },
    {
      "t": "00:59",
      "text": "ನಾನು ಕೆಲಸ ಮಾಡ್ಕೊಂಡಿದೀನಿ"
    },
    {
      "t": "01:00",
      "text": "ಏನು?"
    },
    {
      "t": "01:02",
      "text": "ಕೆಲಸ ಬಿಡಿ ಯಾವದೋ ಒಂದು ಕೆಲಸ ಏನ್ ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "01:10",
      "text": "ಏನ್ ಮಾಡಬೇಕು ನೀವ್ ಹೇಳ್ಬೇಕು ಏನ್ ಮಾಡ್ತೀರಾ ಯಾಕೆ ನೀವು"
    },
    {
      "t": "01:16",
      "text": "ಟೈಮ್ ಪಾಸ್ ಗೆ ಮಾಡ್ಕೋತೀನಿ ಅಪ್ಪ"
    },
    {
      "t": "01:19",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:23",
      "text": "ಸರಿ ಸರಿ ಕಣ್ರಿ ಟೈಮ್ ಪಾಸ್ ಮಾಡಿ"
    },
    {
      "t": "01:27",
      "text": "ಯಾಕ್ರಿ"
    },
    {
      "t": "01:28",
      "text": "ಸುಮ್ನೆ ಹೇಳು"
    },
    {
      "t": "01:30",
      "text": "ಹೇಳಬಾರದು ಹೇಳಬಾರದು"
    },
    {
      "t": "01:31",
      "text": "ಆ?"
    },
    {
      "t": "01:32",
      "text": "ಯಾಕೆ ಮಾಡಬಾರದು ಅಂತ ಅಂದೆ"
    },
    {
      "t": "01:34",
      "text": "ನಾನೇನು ಹೇಳಿಲ್ವಲ್ಲ ಮಾಡಬಾರದು ಅಂತ ಅವರವರ ಇಷ್ಟ"
    },
    {
      "t": "01:40",
      "text": "ಬಂದು"
    },
    {
      "t": "01:41",
      "text": "ನಾನು ಬಂದು ಒಂದು ವರ್ಷ ಆಯ್ತು"
    },
    {
      "t": "01:44",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:45",
      "text": "ಎಷ್ಟು ಖರ್ಚು ಮಾಡಿದ್ದೀರಾ?"
    },
    {
      "t": "01:48",
      "text": "ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "01:50",
      "text": "ಅಪ್ಪ ದೇವರೇ"
    },
    {
      "t": "01:53",
      "text": "ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "01:56",
      "text": "ಹೂ"
    },
    {
      "t": "01:57",
      "text": "ಕಾರ್ ಮಾಡ್ಕೋ"
    },
    {
      "t": "01:59",
      "text": "ತಲೆ ಇಲ್ಲ ಏನು ಏನು ಇಲ್ಲ ಸುಮ್ನೆ ಒಂದು ಲಕ್ಷ ಖರ್ಚು ಮಾಡೋಣ ಅಂತ ಬೈಕೊತಾ ಇದ್ದೀಯಾ"
    },
    {
      "t": "02:03",
      "text": "ಅಲ್ಲ ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "02:05",
      "text": "ಅದು ಅಪ್ಪ ಮಗು ಕೊಟ್ಟಿದ್ದು ಎಷ್ಟು ಖುಷಿ ಪಡೋರು ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "02:09",
      "text": "ಅದು ಕರೆಕ್ಟ್ ಅಲ್ವಾ ಇವಾಗ ಇಮ್ಮಿಡಿಯೇಟ್ ಆಗಿ ಅನ್ಇನ್ಸ್ಟಾಲ್ ಮಾಡ್ತೀನಿ ಆಪ್ ನ"
    },
    {
      "t": "02:14",
      "text": "ಅದೇ ದುಡ್ಡಿದ್ರೆ ಅಪ್ಪ, ಅಮ್ಮ, ಅಕ್ಕ, ತಂಗಿ, ಅಣ್ಣ, ತಮ್ಮ ಏನಾದ್ರೂ ಕೊಡ್ಸಬಹುದು"
    },
    {
      "t": "02:20",
      "text": "ಅಲ್ವಾ ಇರಿ ಅಷ್ಟು ತೆಗಿತೀನಿ ಆಪ್ ನ ಇವಾಗ"
    },
    {
      "t": "02:23",
      "text": "ನಿಮ್ ಇಷ್ಟ ಅದು ನಂದು ನಾನು ಲೆಕ್ಕಕ್ಕೆ ನಾನು ಹೇಳ್ದೆ"
    },
    {
      "t": "02:26",
      "text": "ಕರೆಕ್ಟ್ ಕರೆಕ್ಟ್"
    },
    {
      "t": "02:28",
      "text": "ನನ್ನ ಕಡೆ ಏನಾದರೂ ಇದ್ದಿದ್ರೆ ಅಷ್ಟು"
    },
    {
      "t": "02:30",
      "text": "ಹಾ"
    },
    {
      "t": "02:32",
      "text": "ಇಷ್ಟೊತ್ತಿಗೆ ನಾನು ನನ್ನ ಮಗಳಿಗೆ ಬಂಗಾರ ಮಾಡಿಸಿ ಆಗ್ತಿತ್ತು"
    },
    {
      "t": "02:35",
      "text": "ಅಯ್ಯಯ್ಯೋ"
    },
    {
      "t": "02:38",
      "text": "ಇಲ್ಲ ನಾನು ಎಕ್ಸ್ ಗೆ ಏನಾದ್ರೂ ಚೈನ್ ಕೊಡುಸ್ತಾ ಇದ್ದೆ ನಾನು"
    },
    {
      "t": "02:41",
      "text": "ನಿಮ್ಮ ಎಕ್ಸ್ ಆ?"
    },
    {
      "t": "02:43",
      "text": "ಹೂ"
    },
    {
      "t": "02:44",
      "text": "ಹಾಗೆ ಪ್ರೆಸೆಂಟ್ ಇಲ್ವಾ?"
    },
    {
      "t": "02:47",
      "text": "ಪ್ರೆಸೆಂಟ್ ಅಂದ್ರೆ"
    },
    {
      "t": "02:49",
      "text": "ಸಿಂಗಲ್ ಪೇರೆಂಟ್"
    },
    {
      "t": "02:51",
      "text": "ಸಿಂಗಲ್ ಪೇರೆಂಟ್ ಆ?"
    },
    {
      "t": "02:53",
      "text": "ಹೂ"
    },
    {
      "t": "02:54",
      "text": "ಸಿಂಗಲ್ ಪೇರೆಂಟ್ ಆಗಿದ್ರೆ ಎಕ್ಸ್ ಗೇನು ಕೊಡ್ಸುತ್ತೀರಾ?"
    },
    {
      "t": "02:57",
      "text": "ಕೊಡ್ಸ್ತೀನಿ"
    },
    {
      "t": "02:59",
      "text": "ಅವನು ಕೇಳಿದಾಚೆ ನಾನು ಕೊಡೋದು ಹೆಚ್ಚು"
    },
    {
      "t": "03:01",
      "text": "ಛೀ ನಿಮ್ಮಂತವರು ಇರೋದ್ರಿಂದಾನೆ ಪ್ರಪಂಚ ಇವತ್ತು ಉಳಿದಿರೋದು"
    },
    {
      "t": "03:04",
      "text": "ಯಾಕ್ರಿ?"
    },
    {
      "t": "03:06",
      "text": "ಏನೋ ಸುಮ್ನೆ ಹಂಗೆ"
    },
    {
      "t": "03:08",
      "text": "ಯಾಕೆ ಹೇಳ್ರಿ"
    },
    {
      "t": "03:10",
      "text": "ಸುಮ್ನೆ ಹಂಗೆ"
    },
    {
      "t": "03:12",
      "text": "ಹೂ"
    },
    {
      "t": "03:13",
      "text": "ನನ್ನ ಮಕ್ಕಳಿಗೆ ಆದ್ರೆ ನನ್ನ ಮಗಳು ಎಕ್ಸ್ ಗೆ ಏನಾದ್ರೂ ಕೊಡ್ಸುತ್ತಿದ್ನಪ್ಪ"
    },
    {
      "t": "03:17",
      "text": "ಇಲ್ಲ ಅಂದ್ರೆ ಒಂದು ರೆಸಾರ್ಟ್ ಗೆ ಹೋಗಿ ಸಕ್ಕತ್ತಾಗಿ ಪಾರ್ಟಿ ಮಾಡ್ತಿದ್ದು"
    },
    {
      "t": "03:21",
      "text": "ದುಡ್ಡು ಇದ್ದಿದ್ರೆ"
    },
    {
      "t": "03:22",
      "text": "ಎಲ್ಲಿಗೆ ಹೋಗಿದ್ರೆ?"
    },
    {
      "t": "03:24",
      "text": "ರೆಸಾರ್ಟ್ ಗೆ ಹೋಗಿ ಪಾರ್ಟಿ ಮಾಡ್ತಿದ್ದು ಅಂದೆ"
    },
    {
      "t": "03:26",
      "text": "ಏನ್ ಮಾಡ್ತೀರಾ ರೆಸಾರ್ಟ್ ಗೆ ಹೋಗಿ ಬಿಡಿ ಹೆಂಗೆ ಪಾರ್ಟಿ ಮಾಡ್ತೀರಾ?"
    },
    {
      "t": "03:29",
      "text": "ಪಾರ್ಟಿ ಅಂದ್ರೆ ಮಾಮೂಲಿ ಪಾರ್ಟಿ ಉಣ್ಣೋದು ತಿನ್ನೋದು"
    },
    {
      "t": "03:32",
      "text": "ಹೂ"
    },
    {
      "t": "03:33",
      "text": "ಹೂ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "03:34",
      "text": "ಕುಡಿಯೋದು?"
    },
    {
      "t": "03:35",
      "text": "ಇಲ್ಲಪ್ಪ ಅದು ಅಭ್ಯಾಸ ಇಲ್ಲ"
    },
    {
      "t": "03:38",
      "text": "ಯಾಕೆ ಅಭ್ಯಾಸ ಇಲ್ಲ ಮಾಡ್ಕೊಳ್ಳಿ"
    },
    {
      "t": "03:40",
      "text": "ಅಪ್ಪ ಅದು ಸಹವಾಸನೇ ಬೇಡ"
    },
    {
      "t": "03:43",
      "text": "ಏನೇ ರಿಂಗ್ ಅಂತೀರಾ"
    },
    {
      "t": "03:48",
      "text": "ಒಂದು ಲಕ್ಷ ಅಂದ್ರೆ ನನಗೆ ಆಶ್ಚರ್ಯ ಆಗ್ತಿದೆ"
    },
    {
      "t": "03:52",
      "text": "ನನ್ನ ಹತ್ರ ಕೋಟ್ಯಾನುಗಟ್ಟಲೆ ದುಡ್ಡಿದೆ ಏನ್ ಮಾಡೋಣ"
    },
    {
      "t": "03:55",
      "text": "ಕೊಡಿ ಅಂದ್ರೆ 5 ಲಕ್ಷ ಒಂದು 5-6 ಸಾವಿರ"
    },
    {
      "t": "03:58",
      "text": "ಸಾಕಾ?"
    },
    {
      "t": "03:59",
      "text": "ಸಾಕು"
    },
    {
      "t": "04:00",
      "text": "ಏನ್ ಮಾಡ್ತೀರಾ 5000 ಇಟ್ಕೊಂಡು"
    },
    {
      "t": "04:02",
      "text": "ನನ್ನ ಎಕ್ಸ್ ಗೆ ಏನಾದ್ರೂ ಕೊಡ್ತೀನಿ ಅತ್ತಿಗೆ"
    },
    {
      "t": "04:05",
      "text": "ಏ ನೀವೇನ್ ರಿ ಕೊಡ್ಸೀರಾ ಅವರೇ ಕೊಡ್ಸ್ತಾರೆ ಹೋಗ್ಲಿ ಸುಮ್ನೆ"
    },
    {
      "t": "04:09",
      "text": "ಅವರು ಕೊಡ್ಸ್ತಾರೆ ಆದ್ರೆ ನಮಗೆ ನಮ್ದು ಒಂತರ ಹಠ"
    },
    {
      "t": "04:14",
      "text": "ನಾವು ಅವರಿಗೆ ಕೊಡ್ಸಬೇಕು ಅವರ ಕಡೆಯಿಂದ ನಮಗೆ ಏನು ಬೇಡ"
    },
    {
      "t": "04:18",
      "text": "ನಮಗೆ ಆತರ ಡ್ರೀಮ್ ಇಲ್ಲ"
    },
    {
      "t": "04:21",
      "text": "ಹಂಗೆ"
    },
    {
      "t": "04:22",
      "text": "ಕರೆಕ್ಟ್ ಕಣ್ರಿ ಫಸ್ಟ್ ಆಪ್ ನ ಇನ್ಸ್ಟಾಲ್ ಮಾಡ್ಬಿಟ್ಟು ಯಾವುದಾದರೂ ಹುಡುಗಿಗೆ ಹೋಗ್ಬಿಟ್ಟು ಚೆನ್ನಾಗಿ ಏನಾದ್ರೂ ಕೊಡ್ಸ್ತೀನಿ ಇರಿ"
    },
    {
      "t": "04:30",
      "text": "ಹುಡುಗಿ ಬಯಸೋದು ಜಾಸ್ತಿ, ಟೈಮ್"
    },
    {
      "t": "04:33",
      "text": "ಟೈಮ್"
    },
    {
      "t": "04:34",
      "text": "ದುಡ್ಡು"
    },
    {
      "t": "04:35",
      "text": "ಗಿಫ್ಟ್ ಅಲ್ಲ"
    },
    {
      "t": "04:37",
      "text": "ಅಂಥವರು ಇದ್ದಾರೆ ಸುಮಾರು ಜನ"
    },
    {
      "t": "04:41",
      "text": "ಹೂ"
    },
    {
      "t": "04:42",
      "text": "ನಾನು ನೋಡಿರೋ ಪ್ರಕಾರ"
    },
    {
      "t": "04:44",
      "text": "ಹೂ"
    },
    {
      "t": "04:45",
      "text": "ಟೈಮ್"
    },
    {
      "t": "04:47",
      "text": "ಒಂಚೂರು ಪ್ರೀತಿ"
    }
  ]
