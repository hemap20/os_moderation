    },
    {
      "t": "00:16",
      "text": "ಕೂತ್ಕೊಂಡಿದ್ದೀವಿ"
    },
    {
      "t": "00:18",
      "text": "ಕೂತ್ಕೊಂಡು ಏನ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "00:20",
      "text": "ಏನು ಮಾಡಲ್ಲ"
    },
    {
      "t": "00:22",
      "text": "ಸುಮ್ನೆ ಕೂತ್ಕೊಂಡಿದ್ದೀವಿ"
    },
    {
      "t": "00:24",
      "text": "ಎಲ್ಲಿ ನಿಮ್ಮ ಊರು ನಿಮ್ದು"
    },
    {
      "t": "00:27",
      "text": "ಆ?"
    },
    {
      "t": "00:28",
      "text": "ಹುಬ್ಬಳ್ಳಿ"
    },
    {
      "t": "00:30",
      "text": "ಹುಬ್ಬಳ್ಳಿನಾ"
    },
    {
      "t": "00:31",
      "text": "ನಿನ್ನೆ ಮಾತಾಡಿದ್ರಾ ನನ್ನ ಹತ್ರ ನೀವು"
    },
    {
      "t": "00:35",
      "text": "ಆ?"
    },
    {
      "t": "00:36",
      "text": "ಇಲ್ಲ"
