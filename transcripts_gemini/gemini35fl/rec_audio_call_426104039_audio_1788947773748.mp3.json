    {
      "t": "00:03",
      "text": "ஹலோ"
    },
    {
      "t": "00:05",
      "text": "ஹலோ"
    },
    {
      "t": "00:13",
      "text": "ஹலோ கேட்குதா?"
    },
    {
      "t": "00:14",
      "text": "ஆ கேட்குது சொல்லுங்க."
    },
    {
      "t": "00:16",
      "text": "ம் சாப்டாச்சா? என்ன பண்ணிட்டு இருக்கீங்க?"
    },
    {
      "t": "00:20",
      "text": "சாப்ட்டாச்சுங்க நீங்க ஒரு"
    },
    {
      "t": "00:23",
      "text": "நான் புதுக்கோட்டை."
    },
    {
      "t": "00:25",
      "text": "ஓ சரி சரிங்க."
    },
    {
      "t": "00:29",
      "text": "உங்க பேரு?"
    },
    {
      "t": "00:31",
      "text": "ஜாஸ்மின்."
    },
    {
      "t": "00:33",
      "text": "ஓ நைஸ் நேம்."
    },
    {
      "t": "00:35",
      "text": "ம் தேங்க்யூ என்ன பண்ணிட்டு இருக்கீங்க?"
    },
    {
      "t": "00:40",
      "text": "ஒன்னும் இல்ல ஒரு ரெஸ்ட் ஹவுஸ் தான் இருக்கேன்."
    },
    {
      "t": "00:43",
      "text": "ம் சரி சரி."
    },
    {
      "t": "00:45",
      "text": "என்ன ஊருக்கு?"
    },
    {
      "t": "00:49",
      "text": "நானா என்னத்த கேக்குறீங்க?"
    },
    {
      "t": "00:51",
      "text": "சாப்ட்டீங்களான்னு கேக்குறீங்களா என்னன்னு கேட்டீங்க."
    },
    {
      "t": "00:54",
      "text": "நான் என்ன பண்றீங்க? ஹவுஸ் நான் ஹவுஸ் வைஃப் தான் வீட்டு வேலை பாத்துட்டு இருக்கறேன்."
    },
    {
      "t": "01:01",
      "text": "சரி சரி."
    },
    {
      "t": "01:05",
      "text": "அப்புறம் வீட்ல எல்லாரும் நல்லா இருக்காங்களா? இன்னைக்கு என்ன ஸ்பெஷல்?"
    },
    {
      "t": "01:10",
      "text": "ஸ்பெஷலா இன்னைக்கு என்ன ஸ்பெஷல் சாப்பாடு? ஏன் இவ்வளவு சலப்போ சொல்றீங்களே?"
    },
    {
      "t": "01:17",
      "text": "ஆமா எப்பவும் போல தயிர் சாப்பாடுதான்."
    },
    {
      "t": "01:19",
      "text": "அச்சச்சா"
    },
    {
      "t": "01:21",
      "text": "அதெல்லாம் சாப்பிடாதீங்கன்னா அய்யர் வீட்டு பையனா?"
    },
    {
      "t": "01:25",
      "text": "இல்ல இல்லைங்க."
    },
    {
      "t": "01:26",
      "text": "அப்போ ஏன் தயிர் சாப்பாடு? இந்த வெயிலுக்கு தயிர் சாப்பாடு தான் நல்லது. என்னதான் தயிர் சாப்பாடும் அது ஒரு இதாதான் டென்ஷன் ஆகும்."
    },
    {
      "t": "01:34",
      "text": "ம்ம் ம்ம் அப்ப பார்த்தா தயிர் தயிர்தான்."
    },
    {
      "t": "01:40",
      "text": "பேச்சிலர் தான் ரெகுலர் தயிர் சாப்பாடு தான் சாப்பிட முடியும்."
    },
    {
      "t": "01:44",
      "text": "கடையில போய் பிரியாணி வாங்கி தின்ன வேண்டியதுதானே?"
    },
    {
      "t": "01:48",
      "text": "அப்படியெல்லாம் அதுக்கு பட்ஜெட் வேணும்ல?"
    },
    {
      "t": "01:50",
      "text": "ஆமா அதுவும் வேணும்தான். ₹200 ₹300-ன்னு விக்குது சாப்பாடு."
    },
    {
      "t": "01:54",
      "text": "ஆமா."
    },
    {
      "t": "01:56",
      "text": "சரி எப்படி எங்க கூட வீட்ல யூஸ் பண்றீங்க?"
    },
    {
      "t": "02:02",
      "text": "நான் நேத்து தான் இதை டவுன்லோட் பண்ணேன்."
    },
    {
      "t": "02:04",
      "text": "ம்ம் இந்த ஆர்டர் பண்ணி இப்பதான் வெரிஃபிகேஷனுக்கு போன் அடிச்சாங்க அவங்க."
    },
    {
      "t": "02:09",
      "text": "வெரிஃபிகேஷன் பண்ணவும் இப்ப கால்ஸ் வருது."
    },
    {
      "t": "02:13",
      "text": "ஓ."
    },
    {
      "t": "02:16",
      "text": "ம்ம் இன்னைக்கு கேக்குறாங்க கால்ஸ் பேசுனீங்களான்னு ஒரு கால் பேசுனா ஒரு பத்து கால் பேசி இருப்பே அப்படின்னு."
    },
    {
      "t": "02:24",
      "text": "ம்ம் நான் சும்மாதான் டவுன்லோட் பண்ணேன். ஒரு அக்கா சொன்னாங்க இந்த ஆப்ப ஏத்து அப்படின்னு."
    },
    {
      "t": "02:30",
      "text": "ம்ம் சும்மாதான் டவுன்லோட் பண்ணி பார்த்தா அது வருது கால் வருது."
    },
    {
      "t": "02:38",
      "text": "என்கிட்ட அது ஒரு போனஸ்."
    },
    {
      "t": "02:43",
      "text": "ஒவ்வொருத்தவங்களும் நல்லா பேசுறாங்க."
    },
    {
      "t": "02:46",
      "text": "ஆனா 100% உங்களை மட்டும் பேச மாட்டறாங்க."
    },
    {
      "t": "02:50",
      "text": "ம்ம் எப்படி வேணும் அப்படித்தான் பேசுறாங்க."
    },
    {
      "t": "02:53",
      "text": "ஏன் ரூடா பேசுறாங்களா?"
    },
    {
      "t": "02:55",
      "text": "ஆமா."
    },
    {
      "t": "02:59",
      "text": "ரொம்பதான் இதா பேசுறாங்க."
    },
    {
      "t": "03:01",
      "text": "ஏன் என்ன சொன்னாங்க?"
    },
    {
      "t": "03:04",
      "text": "அதான் அந்த செக்ஸ் பண்றது பிடிக்குமா போய் அப்படி பண்ணலாமா?"
    },
    {
      "t": "03:08",
      "text": "அதான் கேக்குறாங்க வேற என்னத்த பேசுவாங்க?"
    },
    {
      "t": "03:13",
      "text": "சரி இருக்கட்டும் என்ன பண்றது?"
    },
    {
      "t": "03:18",
      "text": "ஆமா எதுதான் பண்ணனும்."
    },
    {
      "t": "03:22",
      "text": "வந்துட்டோம். இப்படித்தான் பேசுவாங்கன்னு தெரியும்."
    },
    {
      "t": "03:26",
      "text": "அப்புறம் என்ன பண்றது?"
    },
    {
      "t": "03:28",
      "text": "பேசிட்டு போக வேண்டியதுதான்."
    },
    {
      "t": "03:30",
      "text": "பேசலைன்னா வரப்போகுது ஒன்னும் வரப்போறது இல்லை."
    },
    {
      "t": "03:33",
      "text": "பேசிட்டு போக வேண்டியதுதான்."
    },
    {
      "t": "03:36",
      "text": "செம்மையா தான்"
    }
  ]
}