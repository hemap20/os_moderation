      "text": "ಹೆಂಗೆ ಇದ್ದೀರಾ"
    },
    {
      "t": "00:06",
      "text": "ಬೆಂಗಳೂರಲ್ಲಿ ಇದ್ದೀರಾ?"
    },
    {
      "t": "00:08",
      "text": "ನಾವು ಬೆಂಗಳೂರಲ್ಲಿ ಇದ್ದೀವಿ."
    },
    {
      "t": "00:10",
      "text": "ಜೇಪ್ ನಗರದಲ್ಲಿ ಇದ್ದೀವಿ"
    },
    {
      "t": "00:14",
      "text": "ನಾವು ಪಿ.ಜಿ.ನಲ್ಲಿದ್ದೀವಿ ಸ್ಟೇ ಆಗ್ಬಿಟ್ಟು"
    },
    {
      "t": "00:17",
      "text": "ಬಡಕದರು ಇರೋದು"
    },
    {
      "t": "00:20",
      "text": "ಗವರ್ಮೆಂಟ್ ಓಕೆ"
    },
    {
      "t": "00:22",
      "text": "ಆಯ್ತಾ ತಿಂಡಿ ಹೋಗಿಲ್ವಾ ಇವತ್ತು?"
    },
    {
      "t": "00:26",
      "text": "[inaudible] ಹೋಗಿಲ್ಲ"
    },
    {
      "t": "00:28",
      "text": "ಗೇಮ್"
    },
    {
      "t": "00:30",
      "text": "ತುಮ್"
    },
    {
      "t": "00:32",
      "text": "ಆಯ್ತಾ ತಿಂಡಿ ಊಟ"
    },
    {
      "t": "00:36",
      "text": "ಇನ್ನು ತಿಂಡಿ ಆಗಿಲ್ಲ ಇವಾಗ ಮಾಡ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "00:40",
      "text": "ಇನ್ನು"
    },
    {
      "t": "00:41",
      "text": "ತಿಂಡಿ ಆದ್ಮೇಲೆ ಊಟ ಮಾಡಬೇಕು."
    },
    {
      "t": "00:44",
      "text": "ಹೌದು"
    },
    {
      "t": "00:45",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "00:47",
      "text": "ಯಾವ ಅಪ್ಲಿಕೇಶನ್?"
    },
    {
      "t": "00:50",
      "text": "ನೀವೇ ಹೇಳಿ ಕೇಳೋಣ"
    },
    {
      "t": "00:51",
      "text": "ಯಾವ ಅಪ್ಲಿಕೇಶನ್ ಯೂಸ್ ಮಾಡ್ತೀರಾ ಆಪ್?"
    },
    {
      "t": "00:55",
      "text": "ನಾವು ಒಂದು 15 ದಿನ ಆಯ್ತು ನೀವು"
    },
    {
      "t": "00:58",
      "text": "ನಾಲ್ಕು ದಿನ ಆಯ್ತು"
    },
    {
      "t": "01:00",
      "text": "ಚೆನ್ನಾಗಿ ಆಪ್"
    },
    {
      "t": "01:05",
      "text": "ಮತ್ತೆ ಯಾರು ಮ್ಯಾಗ್ ಮಾಡಿದ್ದೀರಾ ಆಪ್ ಅಲ್ಲಿ?"
    },
    {
      "t": "01:11",
      "text": "ಇನ್ನೆಲ್ಲ ಇನ್ನು ಸಿಕ್ಕಿಲ್ಲ"
    },
    {
      "t": "01:24",
      "text": "ರೆಗ್ಯುಲರ್ ಆಗಿ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದಾರೆ ಸಿಗ್ತಾರೆ ನಾನು ಅವಾಗಾವಾಗ ಯೂಸ್ ಮಾಡ್ತೀನಿ ಅಷ್ಟೇ"
    },
    {
      "t": "01:36",
      "text": "ಮತ್ತೆ ನೀವು ಯಾಕೆ ಮ್ಯಾರೇಜ್ ಮಾಡಿಲ್ಲ?"
    },
    {
      "t": "01:49",
      "text": "ಮತ್ತೆ ಇನ್ನು ಇನ್ಸ್ಟಾ"
    },
    {
      "t": "02:02",
      "text": "ನಾನು ಸಿಂಗಲ್ ನೀವು"
    },
    {
      "t": "02:11",
      "text": "ಮತ್ತೆ ಇನ್ನೇನು ಸಮಾಚಾರ ಏನಾದ್ರೂ ಚಾಟಿಂಗ್ ಮಾಡ್ತಾ ಇರ್ತೀರಾ?"
    },
    {
      "t": "02:34",
      "text": "ಹಾ ಹೇಳಿ"
    },
    {
      "t": "02:42",
      "text": "ನಿಮ್ದೆನ ನೀವು?"
    },
    {
      "t": "02:51",
      "text": "ಯಾಕೆ ಕ್ಯಾರೆಕ್ಟರಿಲ್ಲ?"
    },
    {
      "t": "03:00",
      "text": "ಹೌದು ಡೈಲಿ ಯೂಸ್ ಮಾಡಬೇಕಲ್ವಾ ನೀವು"
    },
    {
      "t": "03:13",
      "text": "ಮನೆಗೆ ಅಂತ ಯಾರು ಸಿಕ್ಕಿಲ್ಲ ಒಳ್ಳೆ ಫ್ರೆಂಡ್"
    },
    {
      "t": "03:22",
      "text": "ಹೇಳು"
    },
    {
      "t": "03:29",
      "text": "ನೀವು ಮ್ಯಾರಿಡ್?"
    },
    {
      "t": "03:36",
      "text": "ನಾವು ಮ್ಯಾರಿಡ್"
    },
    {
      "t": "03:45",
      "text": "ಹಿಂಗೆಲ್ಲ ಮಾತನಾಡಲೇ ಆಪ್ ಅಲ್ಲಿ"
