      "text": "ம்?"
    },
    {
      "t": "00:10",
      "text": "கேக்குது."
    },
    {
      "t": "00:12",
      "text": "பச்சை வந்து உன் பெஸ்ட் மாமா."
    },
    {
      "t": "00:15",
      "text": "ம்."
    },
    {
      "t": "00:18",
      "text": "கொஞ்சம் நம்பர் சொல்றியா?"
    },
    {
      "t": "00:20",
      "text": "அதெல்லாம் வாய்பில்ல."
    },
    {
      "t": "00:22",
      "text": "ஏன்? இதுல காயின் இல்லையே."
    },
    {
      "t": "00:25",
      "text": "ம்?"
    },
    {
      "t": "00:26",
      "text": "நானா பாத்துட்டேன்."
    },
    {
      "t": "00:29",
      "text": "மூடா இருக்குது."
    },
    {
      "t": "00:31",
      "text": "நானும் செம மூடிலதான் இருக்கேன்."
    },
    {
      "t": "00:34",
      "text": "ம்?"
    },
    {
      "t": "00:35",
      "text": "நானும் செம மூடிலதான் இருக்கேன்."
    },
    {
      "t": "00:38",
      "text": "அதான் ஒரு நம்பர் சொல்லு."
    },
    {
      "t": "00:40",
      "text": "நம்பர்லாம் சொல்ல மாட்டேன்."
    },
    {
      "t": "00:42",
      "text": "ஏன்?"
    },
    {
      "t": "00:44",
      "text": "நான் சும்மா இங்க ஒருத்தன் பேசிட்டு போறேன் அவ்வளவுதான்."
    },
    {
      "t": "00:48",
      "text": "சரி உங்களுக்கு கூட விரலை போட்டா கஞ்சு ஊருமா?"
    },
    {
      "t": "00:52",
      "text": "ம் கஞ்சியெல்லாம் போகாது."
    },
    {
      "t": "00:54",
      "text": "ம்."
    },
    {
      "t": "00:56",
      "text": "இல்ல வர வேண்டியதுதான்."
    },
    {
      "t": "00:59",
      "text": "புரியுதா?"
    },
    {
      "t": "1:00",
      "text": "வர வேண்டியது வரணும்."
    },
    {
      "t": "1:04",
      "text": "உங்களுக்கு விட்டா உள்ள விடும்போது எப்படி இருக்கும் ஃபீலு?"
    },
    {
      "t": "1:09",
      "text": "சொல்றதுக்கே போற மாதிரி இருக்கும்."
    },
    {
      "t": "1:12",
      "text": "வாயில விடும்போது?"
    },
    {
      "t": "1:15",
      "text": "நம்மளோட இது இருந்த மாதிரி இருக்கும்."
    },
    {
      "t": "1:20",
      "text": "ப்ளீஸ் நம்பர் சொல்லு."
    },
    {
      "t": "1:22",
      "text": "கை இடி போகுது."
    },
    {
      "t": "1:24",
      "text": "ம்ம்."
    },
    {
      "t": "1:25",
      "text": "கொஞ்சம் சீக்கிரம் சொல்றேன் ப்ளீஸ்."
    },
    {
      "t": "1:28",
      "text": "காய் நான் நம்பர் சொல்ல மாட்டேன்."
    },
    {
      "t": "1:33",
      "text": "நீ எந்த ஊரு?"
    },
    {
      "t": "1:37",
      "text": "திருவண்ணாமலை."
    },
    {
      "t": "1:38",
      "text": "ம்?"
    },
    {
      "t": "1:40",
      "text": "திருவண்ணாமலை."
    },
    {
      "t": "1:42",
      "text": "பக்கத்துலதான் எந்த திருவண்ணாமலைங்க?"
    },
    {
      "t": "1:46",
      "text": "போலூர்."
    },
    {
      "t": "1:47",
      "text": "ஹான்?"
    },
    {
      "t": "1:48",
      "text": "போலூர்."
    },
    {
      "t": "1:49",
      "text": "மேல வேலைக்கு வருவியா?"
    },
    {
      "t": "1:53",
      "text": "ஏன் நீ போலூர் வரமாட்டியா?"
    },
    {
      "t": "1:54",
      "text": "அவ்வளவோ தூரம் வர முடியாது நான் வேலை ஊரு."
    }
