    {
      "t": "00:01",
      "text": "హలో"
    },
    {
      "t": "00:03",
      "text": "హలో ఎక్కడి నుంచి?"
    },
    {
      "t": "00:06",
      "text": "నేను లీవర్ అండి."
    },
    {
      "t": "00:08",
      "text": "ఆ, ఎక్కడ?"
    },
    {
      "t": "00:11",
      "text": "నేను యుఎస్ లండన్."
    },
    {
      "t": "00:15",
      "text": "యుఎస్ లండన్."
    },
    {
      "t": "00:17",
      "text": "మ్యారీడా?"
    },
    {
      "t": "00:19",
      "text": "నో."
    },
    {
      "t": "00:20",
      "text": "జాబ్ చేస్తుంటావ్."
    },
    {
      "t": "00:22",
      "text": "యా."
    },
    {
      "t": "00:23",
      "text": "సింగిల్ ఏనా?"
    },
    {
      "t": "00:25",
      "text": "సింగిల్ అండి."
    },
    {
      "t": "00:28",
      "text": "మ్."
    },
    {
      "t": "00:29",
      "text": "అయితే ఎన్ని డేస్ అవుతుంది?"
    },
    {
      "t": "00:32",
      "text": "ఇది సెకండ్ డే."
    },
    {
      "t": "00:34",
      "text": "ఎలా ఉంది బాగుందా?"
    },
    {
      "t": "00:37",
      "text": "ఉ బాగుందండి."
    },
    {
      "t": "00:39",
      "text": "ఏం?"
    },
    {
      "t": "00:40",
      "text": "బాగుంది."
    },
    {
      "t": "00:42",
      "text": "ఎన్జాయ్ చేస్తున్నా."
    },
    {
      "t": "00:45",
      "text": "కైండ్ ఆఫ్."
    },
    {
      "t": "00:47",
      "text": "మీకు మీకు నచ్చిందా ఇక్కడ ఉండడం?"
    },
    {
      "t": "00:53",
      "text": "నేను మొన్న ఇన్స్టాల్ చేశా."
    },
    {
      "t": "00:57",
      "text": "ఎక్కువ లేను ఆన్లైన్."
    },
    {
      "t": "01:00",
      "text": "ఓకే."
    },
    {
      "t": "01:02",
      "text": "మీ హస్బెండ్ ఉన్నారా?"
    },
    {
      "t": "01:04",
      "text": "ఆ."
    },
    {
      "t": "01:05",
      "text": "మీ హస్బెండ్ ఉన్నారా అంటున్నా."
    },
    {
      "t": "01:08",
      "text": "లేరు ఇప్పుడు."
    },
    {
      "t": "01:10",
      "text": "ఓకే."
    },
    {
      "t": "01:12",
      "text": "ఉంటారా లేము కదా ఆన్లైన్?"
    },
    {
      "t": "01:14",
      "text": "ఓకే."
    },
    {
      "t": "01:15",
      "text": "ఓపెన్ గా ఉంటారా మరి ఇప్పుడు?"
    },
    {
      "t": "01:18",
      "text": "ఆ."
    },
    {
      "t": "01:19",
      "text": "ఓపెన్ గా ఉంటావా అంటున్నావ్?"
    },
    {
      "t": "01:21",
      "text": "ఓపెన్ గా మాట్లాడాలా?"
    },
    {
      "t": "01:23",
      "text": "మ్."
    },
    {
      "t": "01:26",
      "text": "చెప్పు மேடம்."
    },
    {
      "t": "01:30",
      "text": "ఉంటే ఇంకొంచెం ఎలా ఉందాం?"
    },
    {
      "t": "01:40",
      "text": "ఆ సెక్షுవల్ గా మాట్లాడాలి అంటావ్."
    },
    {
      "t": "01:46",
      "text": "సారీ ఎప్పటి నుంచి మాట్లాడలేను."
    },
    {
      "t": "01:52",
      "text": "కొంచెం చూడొచ్చు కదా."
    },
    {
      "t": "01:56",
      "text": "సరే ఏంటి?"
    },
    {
      "t": "01:59",
      "text": "ఉమ్."
    },
    {
      "t": "02:00",
      "text": "నేను మాట్లాడలేను."
    },
    {
      "t": "02:05",
      "text": "ఏం ఎందుకని?"
    },
    {
      "t": "02:07",
      "text": "ఆ?"
    },
    {
      "t": "02:09",
      "text": "ఏమి?"
    },
    {
      "t": "02:12",
      "text": "దొరికితే ఎన్ని కాల్స్ మాట్లాడావు మరి పడుకోలే? ఇప్పుడు టైం ఎంత అవుతుంది అక్కడ?"
    },
    {
      "t": "02:16",
      "text": "నాకు 4:00 అవుతుంది ఈవినింగ్ 5:00 అవుతుంది."
    },
    {
      "t": "02:20",
      "text": "ఈవినింగ్ 5:00 ఆ?"
    },
    {
      "t": "02:22",
      "text": "మ్."
    },
    {
      "t": "02:24",
      "text": "జాబ్ వర్క్ అయిపోయిందా?"
    },
    {
      "t": "02:27",
      "text": "యా."
    },
    {
      "t": "02:29",
      "text": "జాబ్ అయిపోయింది ఇంకో జాబ్ మిగిలింది."
    },
    {
      "t": "02:35",
      "text": "అది కూడా అయిపోతే హాయిగా పడుకుంటావా?"
    },
    {
      "t": "02:38",
      "text": "మ్."
    },
    {
      "t": "02:41",
      "text": "ఏం చూపించొచ్చు కదా?"
    },
    {
      "t": "02:44",
      "text": "ఆ?"
    },
    {
      "t": "02:45",
      "text": "ఏం చూపియొచ్చు కదా?"
    },
    {
      "t": "02:48",
      "text": "చూపియను అండి."
    },
    {
      "t": "02:50",
      "text": "ఉమ్."
    },
    {
      "t": "02:52",
      "text": "చూపియను మాట్లాడతా అంతే."
    },
    {
      "t": "02:55",
      "text": "ఒకటి చూపించు ప్లీజ్."
    },
    {
      "t": "03:00",
      "text": "ఒకటే ఒకటి."
    },
    {
      "t": "03:02",
      "text": "ఆ?"
    },
    {
      "t": "03:03",
      "text": "నువ్వు చాలా బాగున్నావు, నాకు చూడాలని ఉంది."
    },
    {
      "t": "03:08",
      "text": "చూపియను, జస్ట్ మాట్లాడతా."
    },
    {
      "t": "03:14",
      "text": "ఇంకా గర్ల్ ఫ్రెండ్ ఎవరైనా ఉన్నారా?"
    },
    {
      "t": "03:17",
      "text": "ఉంటే తనే చూసుకునేది కదా."
    },
    {
      "t": "03:21",
      "text": "నువ్వు రావச்சு మాట్లాడతారు కదా."
    },
    {
      "t": "03:25",
      "text": "ఏమో."
    },
    {
      "t": "03:27",
      "text": "ఉమ్ చూపివా?"
    },
    {
      "t": "03:33",
      "text": "సారీ అలా అన్నా."
    }
  ]
}