    {
      "t": "00:10",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:13",
      "text": "ಹೇಗಿದ್ದೀರಾ?"
    },
    {
      "t": "00:15",
      "text": "ನಾನು ಚೆನ್ನಾಗಿದ್ದೀನಿ ಅಲ್ನಾ ಮಚಾಲ್ತಾ ಇರೋದು."
    },
    {
      "t": "00:17",
      "text": "ಬೆಂಗಳೂರಿಂದ ನೀವು?"
    },
    {
      "t": "00:20",
      "text": "ನಾನು ಬೆಂಗಳೂರು."
    },
    {
      "t": "00:21",
      "text": "ಯಾವ ಊರು ಇವರೇ?"
    },
    {
      "t": "00:23",
      "text": "ನಮ್ದು ವೈಟ್ ಫೀಲ್ಡ್ ನಿಮ್ಮದು?"
    },
    {
      "t": "00:25",
      "text": "ನಮ್ದು ಬೀನಿಯಾ."
    },
    {
      "t": "00:28",
      "text": "ಮದುವೆ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ?"
    },
    {
      "t": "00:30",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "00:32",
      "text": "ಆಯ್ತು ಡಿಫೆನ್ಸ್ ಅವನು."
    },
    {
      "t": "00:33",
      "text": "ಹ್ಮ್ ಮದುವೆ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ?"
    },
    {
      "t": "00:36",
      "text": "ನಾನು ಸದ್ಯಕ್ಕೆ ಮದುವೆ ಆಗಿದ್ದೀನಿ ಹೌಸ್ ವೈಫ್ ಮನೆಯಲ್ಲೇ ಇದೀನಿ."
    },
    {
      "t": "00:41",
      "text": "ಎಲ್ಲ ನರ್ಸಿಂಗ್ ಕಂಪ್ಲೀಟ್ ಆಗಿದೆ."
    },
    {
      "t": "00:44",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "00:46",
      "text": "ಮದುವೆ ಆಯ್ತು ಮನೆಯಲ್ಲೇ ಇದೀನಿ ಅಷ್ಟೇ."
    },
    {
      "t": "00:51",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "00:53",
      "text": "ಮತ್ತೆ ಹೇಳ್ಬೇಕು ನೀವು."
    },
    {
      "t": "00:55",
      "text": "ನಿಮ್ಮ ನೇಮ್?"
    },
    {
      "t": "00:58",
      "text": "ನನ್ನ ಹೆಸರು ಗಣೇಶ್."
    },
    {
      "t": "01:00",
      "text": "ಹಾಯ್ ಗಣೇಶ್ ಮತ್ತೆ."
    },
    {
      "t": "01:05",
      "text": "ಹಲೋ ಕೇಳಿಸ್ತಾ ಇಲ್ವಾ ಮಾತಾಡಿ ಯಾಕೆ?"
    },
    {
      "t": "01:08",
      "text": "ಇಲ್ಲ ಕೇಳಿಸ್ತಿದೆ ಯಾಕೋ ಸೌಂಡ್ ಬ್ರೇಕ್ ಆಗ್ತಾ ಇದೆ ಮಿಡಲ್ ಅಲ್ಲಿ."
    },
    {
      "t": "01:12",
      "text": "ಇವಾಗ ಕೇಳಿಸ್ತಾ ಇದೆಯಾ ನೀವು ಸಿಂಗಲ್ ಮೇರಿಡ್?"
    },
    {
      "t": "01:15",
      "text": "ನಾನು ಮೇರಿಡ್."
    },
    {
      "t": "01:17",
      "text": "ಓ ಮೇರಿಡ್ ಏಜ್ ನಿಮಗೆ?"
    },
    {
      "t": "01:20",
      "text": "ನಮ್ದು 32 ನಿಮ್ಮದು?"
    },
    {
      "t": "01:22",
      "text": "ನಮ್ದು 27."
    },
    {
      "t": "01:25",
      "text": "ಮಕ್ಕಳು?"
    },
    {
      "t": "01:27",
      "text": "ಒಂದು ಪಾಪ ಇದೆ ಒನ್ ಅಂಡ್ ಹಾಫ್ ಇಯರ್."
    },
    {
      "t": "01:29",
      "text": "ಓಕೆ ಓಕೆ."
    },
    {
      "t": "01:31",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:33",
      "text": "ಮತ್ತೆ ಹ್ಯಾಪಿಗೆ ಬಂದಿರೋದು ದೇಶ ಟೈಮ್ ಪಾಸ್?"
    },
    {
      "t": "01:35",
      "text": "ಸುಮ್ನೆ ಟೈಮ್ ಪಾಸ್."
    },
    {
      "t": "01:40",
      "text": "ನೀವು?"
    },
    {
      "t": "01:42",
      "text": "ನಾನು ಹಂಗೆ ಟೈಮ್ ಪಾಸ್."
    },
    {
      "t": "01:44",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:46",
      "text": "ನಿಮ್ಮ ಇರ್ಸಸ್ ಇಲ್ಲೇ ಇರೋದು ಬೆಂಗಳೂರಲ್ಲೇನಾ?"
    },
    {
      "t": "01:50",
      "text": "ಹಲೋ?"
    },
    {
      "t": "01:52",
      "text": "ಅಲ್ಲ ಬೆಂಗಳೂರಲ್ಲೇ."
    },
    {
      "t": "01:54",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:57",
      "text": "ಅದೇ ನೀವು ವರ್ಕ್ ಏನ್ ಮಾಡ್ತೀರಾ?"
    },
    {
      "t": "02:00",
      "text": "ಅಂತ ಅಂದ್ರೆ ಪ್ರೈವೇಟ್ ಜಾಬ್ ಮಾಡ್ತೀನಿ."
    },
    {
      "t": "02:03",
      "text": "ಓಕೆ."
    },
    {
      "t": "02:04",
      "text": "ಪ್ರಾಪರ್ ಯಾವ ಊರು ನಿಮ್ದು?"
    },
    {
      "t": "02:08",
      "text": "ಪ್ರಾಪರ್ ಗುಲ್ಬರ್ಗಾ."
    },
    {
      "t": "02:11",
      "text": "ಓಹೋ ಹಾಗೆ."
    },
    {
      "t": "02:14",
      "text": "ಮತ್ತೆ?"
    },
    {
      "t": "02:17",
      "text": "ಮತ್ತೆ ಹೇಳ್ಬೇಕು."
    },
    {
      "t": "02:20",
      "text": "ನೀವೇ ಹೇಳಿ ಕೇಳೋಣ ಏನಾದ್ರು."
    }
  ]
