    {
      "t": "00:34",
      "text": "என் பேரு பிரசாந்த், உங்க பேரு?"
    },
    {
      "t": "00:38",
      "text": "என்னோட பேரு அர்ச்சனா."
    },
    {
      "t": "00:40",
      "text": "ம் கல்யாணம் ஆயிடுச்சா?"
    },
    {
      "t": "00:43",
      "text": "ம் சிங்கிள் தான்."
    },
    {
      "t": "00:47",
      "text": "சிங்கிள் தான்."
    },
    {
      "t": "00:51",
      "text": "கொஞ்சம் ஒரு மாதிரி டவுட் எல்லாம் கேட்கணும், கேட்கலாமா?"
    },
    {
      "t": "00:55",
      "text": "ம் கேளுங்க."
    },
    {
      "t": "01:00",
      "text": "கேட்கலாமா வேணாமா?"
    },
    {
      "t": "01:03",
      "text": "கேளுங்க."
    },
    {
      "t": "01:05",
      "text": "இல்ல என்ன மாதிரி டவுட்ன்னு உங்களுக்கு தெரியும்."
    },
    {
      "t": "01:11",
      "text": "ம் கேட்கவா வேணாமா?"
    },
    {
      "t": "01:13",
      "text": "கேளுங்க."
    },
    {
      "t": "01:18",
      "text": "எனக்கு கேட்டா கொஞ்சம் ஒரு மாதிரியா இருக்கு."
    },
    {
      "t": "01:21",
      "text": "எப்படி கேட்கிறதுன்னு தெரியல."
    },
    {
      "t": "01:26",
      "text": "ஹலோ."
    },
    {
      "t": "01:28",
      "text": "ம்"
    },
    {
      "t": "01:30",
      "text": "சொல்லுங்க, ஒன்னு சொல்றீங்க சொல்லுங்க."
    },
    {
      "t": "01:33",
      "text": "கேளுங்க, நீங்க கேட்டாதான் தெரியும்."
    },
    {
      "t": "01:37",
      "text": "நீங்க உங்க வாய்ஸை பார்த்தா கல்யாணம் ஆன மாதிரி தெரியுது."
    },
    {
      "t": "01:42",
      "text": "ம்"
    },
    {
      "t": "01:43",
      "text": "ஹலோ."
    },
    {
      "t": "01:45",
      "text": "ஹலோ."
    },
    {
      "t": "01:47",
      "text": "சொல்லுங்க."
    },
    {
      "t": "01:51",
      "text": "ஹலோ."
    },
    {
      "t": "01:53",
      "text": "ஹலோ."
    },
    {
      "t": "01:55",
      "text": "கேக்குதா?"
    },
    {
      "t": "01:57",
      "text": "ம் கேக்குதுங்க."
    },
    {
      "t": "02:00",
      "text": "இல்ல நீங்க எப்படி ஆரம்பிக்கிறதுன்னு தெரியலையே, நீங்களே கொஞ்சம் ஆரம்பிக்கிறீங்களா?"
    },
    {
      "t": "02:11",
      "text": "என்னென்ன பிடிக்கும் உங்களுக்கு?"
    },
    {
      "t": "02:13",
      "text": "ம்"
    },
    {
      "t": "02:15",
      "text": "என்ன பிடிக்கும் உங்களுக்கு?"
    },
    {
      "t": "02:17",
      "text": "என்ன சாப்பிட்டீங்க?"
    },
    {
      "t": "02:18",
      "text": "எல்லாமே பிடிக்கும், உங்களுக்கு?"
    },
    {
      "t": "02:23",
      "text": "எனக்கு எல்லாம் பிடிக்கும்."
    },
    {
      "t": "02:26",
      "text": "என்ன கலர் டிரஸ் போட்டு இருக்கீங்க?"
    },
    {
      "t": "02:30",
      "text": "நம்ம ரெட் கலர், எல்லாமே கலரும் மிக்ஸ்."
    },
    {
      "t": "02:32",
      "text": "ரெட் கலரா?"
    },
    {
      "t": "02:34",
      "text": "ரெட், எல்லோ, ரெட் பிளவர்ஸ் எல்லாமே."
    },
    {
      "t": "02:39",
      "text": "கோவமா கோவமா பேசுற மாதிரி இருக்கே."
    },
    {
      "t": "02:44",
      "text": "என்னங்க? கோவமா"
    },
    {
      "t": "02:47",
      "text": "கோவமா பேசுறீங்களா?"
    },
    {
      "t": "02:50",
      "text": "இல்லைங்க நார்மலா தான் பேசிட்டு இருக்கேன்."
    },
    {
      "t": "02:55",
      "text": "சாரில இருக்கீங்களா, நைட்டில இருக்கீங்களா?"
    },
    {
      "t": "03:00",
      "text": "நைட்டில தான் இருக்கு."
    },
    {
      "t": "03:07",
      "text": "ஓகே சூப்பர்."
    },
    {
      "t": "03:08",
      "text": "என்ன கலர் நைட்டி?"
    },
    {
      "t": "03:10",
      "text": "என்ன சொன்னிங்க, எல்லோ கலர் வித் ரெட்"
    },
    {
      "t": "03:15",
      "text": "கோவமா பேசாதீங்க, கோவமா பேசாதீங்க."
    },
    {
      "t": "03:18",
      "text": "வேற அடுத்த கேள்வி கேட்கவா?"
    },
    {
      "t": "03:21",
      "text": "ம் கேளுங்க."
    },
    {
      "t": "03:23",
      "text": "என்ன கலர் போட்டு இருக்கீங்க?"
    },
    {
      "t": "03:28",
      "text": "எல்லோ கலர் நைட்டி."
    },
    {
      "t": "03:35",
      "text": "வேற?"
    },
    {
      "t": "03:38",
      "text": "வேற?"
    },
    {
      "t": "03:40",
      "text": "வேற என்ன கலர் போட்டு இருக்கீங்க?"
    },
    {
      "t": "03:43",
      "text": "வேற என்ன கலர், வேற என்ன போட்டு இருக்கீங்கன்னு கேக்குறீங்களா?"
    },
    {
      "t": "03:48",
      "text": "ம்"
    },
    {
      "t": "03:49",
      "text": "வேற என்ன பரா போட்டு இருக்கீங்க உள்ள?"
    },
    {
      "t": "03:52",
      "text": "ம் சொல்லுங்க."
    },
    {
      "t": "03:54",
      "text": "கீழ பாவாடை கட்டிருக்கேன்."
    },
    {
      "t": "03:58",
      "text": "ஓகே."
    },
    {
      "t": "04:00",
      "text": "என்ன கலர் போட்டு இருக்கீங்க ரெண்டும்?"
    },
    {
      "t": "04:03",
      "text": "பாவாடை கூட எல்லோ கலரு."
    },
    {
      "t": "04:08",
      "text": "அப்புறம்?"
    },
    {
      "t": "04:15",
      "text": "ஹலோ."
    },
    {
      "t": "04:17",
      "text": "ம்"
    },
    {
      "t": "04:18",
      "text": "அது என்ன கலர்?"
    },
    {
      "t": "04:20",
      "text": "அதுவும் எல்லோ கலர் சொன்னேன்."
    },
    {
      "t": "04:24",
      "text": "மேல?"
    },
    {
      "t": "04:26",
      "text": "மேலவும் எல்லாம் எல்லாமே எல்லோ கலர்."
    },
    {
      "t": "04:30",
      "text": "உள்ளயும் எல்லோ தானா?"
    },
    {
      "t": "04:33",
      "text": "ம் ஃபுல்லா எல்லோ கலர்."
    },
    {
      "t": "04:36",
      "text": "உள்ளாவே எல்லோவா?"
    },
    {
      "t": "04:38",
      "text": "ம்"
    },
    {
      "t": "04:42",
      "text": "உங்களுக்கு எத்தனை வயசு ஆகுது?"
    },
    {
      "t": "04:46",
      "text": "எனக்கு 25."
    },
    {
      "t": "04:49",
      "text": "25."
    },
    {
      "t": "04:51",
      "text": "இதுவரைக்கும் யாரு கூட எதுவும் பண்ணி இருக்கீங்களா?"
    },
    {
      "t": "04:55",
      "text": "ரெண்டு வருஷத்துக்கு முன்னால வரும்போது, பிரெண்ட் இருந்தாங்க."
    },
    {
      "t": "05:00",
      "text": "அவங்க கூட ஹக்கிங், கிஸ்ஸிங் எல்லாம் பண்ணிருக்கு."
    },
    {
      "t": "05:05",
      "text": "என்ன பண்ணிருக்கீங்க?"
    },
    {
      "t": "05:08",
      "text": "ஹக்கிங், கிஸ்ஸிங் எல்லாம் பண்ணிருக்கு."
    },
    {
      "t": "05:11",
      "text": "ஓகே."
    },
    {
      "t": "05:13",
      "text": "பண்ணிருக்கீங்களா, செக்ஸ் பண்ணிருக்கீங்களா?"
    },
    {
      "t": "05:15",
      "text": "ம் செக்ஸ் எல்லாம் பண்ணது இல்ல. மேரேஜ் பண்ணிடுவோம்ன்னு இருந்தோம்."
    },
    {
      "t": "05:19",
      "text": "வீட்ல பேசி இருந்தாங்க."
    },
    {
      "t": "05:22",
      "text": "பேச்சுவார்த்தை நடந்துட்டு இருந்துச்சு."
    },
    {
      "t": "05:24",
      "text": "அதுக்கப்புறம் முதல்ல ஒத்துக்கிட்டாங்க, அதுக்கப்புறமா ரெண்டாவது வாட்டி அவங்க"
    },
    {
      "t": "05:29",
      "text": "மாப்பிள்ளை வீட்ல பேரண்ட்ஸ் எல்லாம் வேண்டாம்ன்னு சொல்லிட்டாங்க. அவங்க கிறிஸ்டியன் நாங்க ஹிந்துன்னால"
    },
    {
      "t": "05:34",
      "text": "அவங்க கிறிஸ்டியன் பொண்ணுதான் தேவைன்னு சொல்லி அவங்க ரிஜெக்ட் பண்ணிட்டாங்க."
    },
    {
      "t": "05:40",
      "text": "சரி ஓகே."
    },
    {
      "t": "05:46",
      "text": "சரி உங்க வாட்ஸ்அப் நம்பர் கிடைக்குமா?"
    },
    {
      "t": "05:50",
      "text": "வேண்டாம், இதுலயே பேசுங்க."
    },
    {
      "t": "05:53",
      "text": "இதுல எப்படி பேசினா உங்களுக்கு பே பண்ண முடியும்? நான் ஏதோ உங்களுக்கு ஏதோ பே பண்ணிவிட்டு உங்கள வீடியோ கால்ல பார்த்துக்கலாம்."
    },
    {
      "t": "05:59",
      "text": "ம்"
    },
    {
      "t": "06:01",
      "text": "ஏதாவது அமௌன்ட் பே பண்ணிட்டு வீடியோ கால்ல பார்க்கிறேனே."
    },
    {
      "t": "06:05",
      "text": "வீடியோ கால்ல யார் பேச சொன்னா? பேசுவேன், நார்மலா தான் பேசிட்டு இருக்கேன்."
    },
    {
      "t": "06:11",
      "text": "இல்லைங்க வேண்டாம்."
    },
    {
      "t": "06:12",
      "text": "இப்போ ஒரு 200 ரூபாய் 500 ரூபாய் பே பண்ணிட்டு உங்கள வீடியோ கால்ல பார்க்கலாமா? அதான்."
    },
    {
      "t": "06:18",
      "text": "ம் வேண்டாம்."
    },
    {
      "t": "06:20",
      "text": "சும்மா பேசிறேன்னா நார்மல் கால்ல பேசுவோம். அந்த மாதிரி பண்ண"
    },
    {
      "t": "06:24",
      "text": "நான் அந்த மாதிரி பண்ண மாட்டீங்களா?"
    },
    {
      "t": "06:29",
      "text": "ம் இல்லங்க."
    },
    {
      "t": "06:31",
      "text": "ஹலோ."
    },
    {
      "t": "06:33",
      "text": "இந்த மாதிரிலாம் இல்லைங்கன்னு சொன்னேனே."
    },
    {
      "t": "06:36",
      "text": "அந்த மாதிரி இல்லையா?"
    },
    {
      "t": "06:42",
      "text": "சரி, நீங்க கொஞ்ச நேரத்துக்காவது பண்ணலாமா? ராமாசா, இப்ப பேசும்போது வேற மாதிரி பேசினேன்."
    },
    {
      "t": "06:48",
      "text": "சரி, யாரு கூடயாவது பண்ணிருக்கீங்களா?"
    },
    {
      "t": "06:50",
      "text": "அதான் சொன்னேனே, பண்ணது இல்லன்னுட்டு."
    },
    {
      "t": "06:53",
      "text": "செக்ஸ் பண்ணதுதான், பிளெக்சர் வேற வேற இடத்துல பண்ணீங்களா?"
    },
    {
      "t": "06:57",
      "text": "ம் பண்றதுக்கு ஆசை இருக்கு."
    },
    {
      "t": "07:00",
      "text": "ம்"
    },
    {
      "t": "07:01",
      "text": "பண்ணலாமா? பண்ண உங்களுக்கு ஆசை இருக்கா?"
    },
    {
      "t": "07:04",
      "text": "ம் இல்லைங்க."
    },
    {
      "t": "07:08",
      "text": "ம்"
    },
    {
      "t": "07:09",
      "text": "இல்லைங்க, சும்மா பேசுவேன். ஜாலியா பேசுவேன், ராமாசா பேசுவேன், அவ்ளோதான்."
    },
    {
      "t": "07:14",
      "text": "சரி."
    },
    {
      "t": "07:16",
      "text": "அதான் நீங்க ஒல்லியா இருக்கீங்களா? குண்டா இருக்கீங்களா? உங்களை பத்தி நான் வர்ணிப்பேன்."
    },
    {
      "t": "07:20",
      "text": "நாங்க மீடியமாதான் இருக்கோம்."
    },
    {
      "t": "07:23",
      "text": "ம் சரி."
    },
    {
      "t": "07:26",
      "text": "என்ன சைஸ் போடுறீங்க? உள்ள."
    },
    {
      "t": "07:29",
      "text": "சைஸ் 34."
    },
    {
      "t": "07:33",
      "text": "கீழ?"
    },
    {
      "t": "07:34",
      "text": "கீழ 30."
    },
    {
      "t": "07:36",
      "text": "ம்?"
    },
    {
      "t": "07:37",
      "text": "30."
    },
    {
      "t": "07:40",
      "text": "30 ஓகே."
    },
    {
      "t": "07:43",
      "text": "எனக்கு ஒரே மூடா இருக்குங்க."
    },
    {
      "t": "07:45",
      "text": "ம்"
    },
    {
      "t": "07:46",
      "text": "எனக்கு கொஞ்சம் மூடா இருக்கு."
    },
    {
      "t": "07:49",
      "text": "மூடா இருக்கா?"
    },
    {
      "t": "07:51",
      "text": "ம்"
    },
    {
      "t": "07:53",
      "text": "ம்"
    },
    {
      "t": "07:55",
      "text": "அப்படி பேசணும்ன்னு சொல்லல, சாரிங்க."
    },
    {
      "t": "07:58",
      "text": "இன்னும் கொஞ்சம் அந்த மூடு வந்துச்சுன்னா, ஒரு மாதிரி விஸ்தே பண்ணுவாங்க, அந்த மாதிரி பண்றேன்னா மன்னிச்சுக்கோங்க."
    },
    {
      "t": "08:03",
      "text": "ம் பேசுறேன்."
    },
    {
      "t": "08:07",
      "text": "உங்களை எனக்கு ரொம்ப பிடிச்சிருக்குங்க."
    },
    {
      "t": "08:11",
      "text": "ம்"
    },
    {
      "t": "08:12",
      "text": "ம்"
    },
    {
      "t": "08:13",
      "text": "ம் தேங்க்யூ, புடிச்சிருக்கு."
    },
    {
      "t": "08:17",
      "text": "I love you."
    },
    {
      "t": "08:19",
      "text": "I love you too."
    },
    {
      "t": "08:21",
      "text": "ம்"
    },
    {
      "t": "08:22",
      "text": "ம்"
    },
    {
      "t": "08:25",
      "text": "ஹலோ."
    },
    {
      "t": "08:27",
      "text": "ஹலோ."
    },
    {
      "t": "08:28",
      "text": "உங்களுக்கு கற்பனை பண்ணிட்டு இருக்கேன் நான், எப்படி இருப்பீங்கன்னு."
    },
    {
      "t": "08:31",
      "text": "ம்"
    },
    {
      "t": "08:33",
      "text": "ம்"
    },
    {
      "t": "08:35",
      "text": "ஹலோ."
    },
    {
      "t": "08:37",
      "text": "ஹலோ."
    },
    {
      "t": "08:38",
      "text": "ஹலோ."
    },
    {
      "t": "08:39",
      "text": "ஹலோ."
    },
    {
      "t": "08:40",
      "text": "கேக்குதா?"
    },
    {
      "t": "08:44",
      "text": "ஹலோ."
    },
    {
      "t": "08:47",
      "text": "ஹலோ."
    },
    {
      "t": "08:49",
      "text": "ம்"
    },
    {
      "t": "08:50",
      "text": "கேக்குதா?"
    },
    {
      "t": "08:52",
      "text": "ம் கேக்குது."
    },
    {
      "t": "08:55",
      "text": "ஐயோ எனக்கு ஒரு மாதிரியா இருக்குங்க. ஏதாவது மூடா பேசணும்."
    },
    {
      "t": "08:59",
      "text": "ம் பேசுங்க."
    },
    {
      "t": "09:01",
      "text": "நீங்க பேசுறீங்களா கொஞ்சம் மூடா?"
    },
    {
      "t": "09:08",
      "text": "ஹலோ."
    },
    {
      "t": "09:17",
      "text": "ஹலோ."
    },
    {
      "t": "09:19",
      "text": "ஹலோ."
    },
    {
      "t": "09:21",
      "text": "ம் சொல்லுங்க."
    },
    {
      "t": "09:25",
      "text": "ஹலோ."
    },
    {
      "t": "09:28",
      "text": "ஹலோ."
    },
    {
      "t": "09:30",
      "text": "கேக்குதா?"
    },
    {
      "t": "09:31",
      "text": "ம் கேக்குது."
    },
    {
      "t": "09:33",
      "text": "உங்க நம்பர் தருவீங்களா ப்ளீஸ்?"
    },
    {
      "t": "09:36",
      "text": "நான் இப்பதான் சொன்னேன், நான் இதுலேயே பேசுறேன்னு சொல்லிட்டு."
    },
    {
      "t": "09:41",
      "text": "இப்போ இதுல பேசணும்ன்னா கொஞ்சம் நல்லா பேச மாட்டறீங்களே."
    },
    {
      "t": "09:45",
      "text": "அது அவ்வளவுதான் சவுண்டே கேட்கறது."
    },
    {
      "t": "09:49",
      "text": "என்னங்க நீங்க?"
    },
    {
      "t": "09:50",
      "text": "சரி ரொம்ப ஓப்பனா கேக்குறேன் உங்கள்ட்ட."
    },
    {
      "t": "09:54",
      "text": "ம்"
    },
    {
      "t": "09:56",
      "text": "₹2000 நான் தாரேன். வீடியோ கால் வரீங்களா?"
    },
    {
      "t": "09:59",
      "text": "என்னங்க?"
    },
    {
      "t": "10:01",
      "text": "₹2000 அமௌன்ட் தாரேன், வீடியோ கால் வரீங்களா?"
    },
    {
      "t": "10:05",
      "text": "₹2000லாம் குடுக்குற மாதிரி இருக்கீங்க. சும்மா யாரு?"
    },
    {
      "t": "10:10",
      "text": "நிஜமா."
    },
    {
      "t": "10:11",
      "text": "யாரு குடுக்க மாட்டாங்க? ₹2000 யாரு குடுப்பாங்க?"
    },
    {
      "t": "10:15",
      "text": "இல்ல நான் தாரேன், எனக்கு வீடியோ கால் வரீங்களா?"
    },
    {
      "t": "10:18",
      "text": "தான் இப்பதான் சொன்னேனே வீடியோ கால்ல இருக்கறதுக்கு, சும்மா பேச பேச நார்மல் கால்லயே பேசுறேன், வேணும்னா பேசுறேன்னு சொன்னேனே."
    },
    {
      "t": "10:27",
      "text": "எனக்கு பார்த்தாதான நல்லா அழகா பார்க்க முடியும் உங்களை."
    },
    {
      "t": "10:31",
      "text": "நான் ஒன்னும் அவ்ளோ அழகா இருக்க மாட்டேங்க. அதுக்காகதான் சொல்றேன்."
    },
    {
      "t": "10:35",
      "text": "இருக்கறதே மாடரேட் கலர்லதான் இருக்கு."
    },
    {
      "t": "10:40",
      "text": "சரி நான் நல்லா கொஞ்சம் ஒரு மாதிரியாவே பேசட்டுமா?"
    },
    {
      "t": "10:44",
      "text": "ம்"
    },
    {
      "t": "10:46",
      "text": "கொஞ்சம் பேட் வேர்ட்ஸ் யூஸ் பண்ணி பேசட்டுமா?"
    },
    {
      "t": "10:50",
      "text": "ம்"
    },
    {
      "t": "10:52",
      "text": "ம் பேச வேணாமா?"
    },
    {
      "t": "10:58",
      "text": "உங்களுக்கு ஆசை பண்றதுன்னா சொல்லுங்க, நான் நம்பர் கொடுக்கிறேன். முதல்ல போடுங்க."
    },
    {
      "t": "11:03",
      "text": "நீங்க இப்படி எல்லாம் பேசுனீங்கன்னா, நான் நீங்க வீடியோ கால்ல ஃபுல்லா வரீங்கன்னா சொல்லுங்க, நான் உங்களுக்கு ரெடி பண்றேன் ₹2000."
    },
    {
      "t": "11:10",
      "text": "சும்மா அப்படி இல்ல இல்ல, சும்மா நான் மேல மட்டும் காமிப்பேன், அவ்ளோதான். சும்மா பேசுவேன், ஜாலியா பேசுவேன், அவ்ளோதான்."
    },
    {
      "t": "11:19",
      "text": "ரொமான்ஸா பேசுவேன், அவ்ளோதான்."
    },
    {
      "t": "11:21",
      "text": "மேல மட்டும் காமிக்கிறதா இருந்தா 500."
    },
    {
      "t": "11:26",
      "text": "ஓகேவா?"
    },
    {
      "t": "11:28",
      "text": "ம் சரி ஓகே."
    },
    {
      "t": "11:31",
      "text": "நிஜமா?"
    },
    {
      "t": "11:33",
      "text": "நீங்க ஃபர்ஸ்ட் பே பண்ணுங்க, நான் காமிக்கிறேன்."
    },
    {
      "t": "11:36",
      "text": "ஏமாத்திட்டீங்கன்னா?"
    },
    {
      "t": "11:39",
      "text": "ஏமாத்த மாட்டேங்க. நீங்க சொன்னாதான் நீங்க சொல்ற நம்பிக்கையிலதான் நானே வர்றேன். இப்ப நல்லவங்ககிட்ட எல்லாருக்கும் வந்து குடுக்குமா? நான் ஸ்டார்டிங்லயே சொல்லிட்டேனே."
    },
    {
      "t": "11:48",
      "text": "எனக்கு கீழ பார்த்தாதாங்க வருவோம். அதுதான் கேட்கிறது கீழ."
    },
    {
      "t": "11:53",
      "text": "வேற ஒன்னும் நடக்குது. சரி, கீழ எல்லாம் இல்லை."
    },
    {
      "t": "11:54",
      "text": "மேல மட்டும்தானா?"
    },
    {
      "t": "11:58",
      "text": "மேல மட்டும்தான் வேணும்னு காமிக்கிறேன், அவ்ளோதான்."
    },
    {
      "t": "12:02",
      "text": "சரி."
    },
    {
      "t": "12:04",
      "text": "மேல, சரி ஒரு நிமிஷம்."
    },
    {
      "t": "12:08",
      "text": "ஹலோ."
    },
    {
      "t": "12:09",
      "text": "ம்"
    },
    {
      "t": "12:13",
      "text": "நீங்க எப்படி இருப்பீங்கன்னு பார்த்து, நான் வந்து பண்ணிட்டு இருக்கேன்."
    },
    {
      "t": "12:16",
      "text": "ம்?"
    },
    {
      "t": "12:18",
      "text": "ஹலோ."
    },
    {
      "t": "12:20",
      "text": "ம்"
    },
    {
      "t": "12:23",
      "text": "உங்களை நான் வந்து"
    },
    {
      "t": "12:25",
      "text": "ஹலோ."
    },
    {
      "t": "12:29",
      "text": "கேட்க மாட்டேங்குது சரியா குரல்."
    },
    {
      "t": "12:31",
      "text": "போயிருச்சு."
    },
    {
      "t": "12:32",
      "text": "I love you. I love you."
    },
    {
      "t": "12:34",
      "text": "ம்?"
    },
    {
      "t": "12:35",
      "text": "Love you."
    },
    {
      "t": "12:37",
      "text": "ம் Love you."
    },
    {
      "t": "12:41",
      "text": "உன்கூட படுக்கணும் போல இருக்கும் உன்கூட."
    },
    {
      "t": "12:47",
      "text": "ஹலோ."
    },
    {
      "t": "12:48",
      "text": "ம்"
    },
    {
      "t": "12:50",
      "text": "உன்கூட படுக்கணும் போல இருக்கு வரியா?"
    },
    {
      "t": "12:59",
      "text": "ஹலோ."
    },
    {
      "t": "13:03",
      "text": "ஹலோ."
    },
    {
      "t": "13:05",
      "text": "ம்"
    },
    {
      "t": "13:07",
      "text": "சாரீங்க, ஹலோ."
    },
    {
      "t": "13:12",
      "text": "போடுறேன்னா சொல்லுங்க, நம்பர் கொடுக்கிறேன்."
    },
    {
      "t": "13:17",
      "text": "நம்பர் சொல்றீங்களா?"
    },
    {
      "t": "13:21",
      "text": "உன்கிட்ட போன் பே இருக்கா?"
    },
    {
      "t": "13:23",
      "text": "உன்கிட்ட ஜிபே ஆக்டிவேட் ஆயிருக்கா?"
    },
    {
      "t": "13:26",
      "text": "ஏன்?"
    },
    {
      "t": "13:28",
      "text": "அது இது கொஞ்சம் ப்ராப்ளம் ஆயிட்டு இருக்கு. ஜிபே ஆக்டிவேட் இல்லாம போயிட்டு இருக்கு."
    },
    {
      "t": "13:33",
      "text": "சரி."
    },
    {
      "t": "13:35",
      "text": "போன் பே இருக்கா?"
    },
    {
      "t": "13:37",
      "text": "போன் பே"
    },
    {
      "t": "13:40",
      "text": "இருக்கு."
    },
    {
      "t": "13:42",
      "text": "சரி இப்ப போன் பேல போய் பண்றீங்களா?"
    },
    {
      "t": "13:45",
      "text": "நம்பர் சொல்லுங்க."
    },
    {
      "t": "13:46",
      "text": "நோட் பண்ணிக்கிறேன்."
    },
    {
      "t": "13:51",
      "text": "97"
    },
    {
      "t": "13:53",
      "text": "97"
    },
    {
      "t": "13:55",
      "text": "390"
    },
    {
      "t": "13:57",
      "text": "390"
    },
    {
      "t": "13:59",
      "text": "64"
    },
    {
      "t": "14:00",
      "text": "64"
    },
    {
      "t": "14:02",
      "text": "911"
    },
    {
      "t": "14:04",
      "text": "911. மறுபடியும் சொல்லுங்க, நோட் பண்ணிக்கிறேன்."
    },
