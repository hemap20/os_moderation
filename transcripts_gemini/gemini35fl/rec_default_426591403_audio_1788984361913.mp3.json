    {
      "t": "00:04",
      "text": "പറ"
    },
    {
      "t": "00:06",
      "text": "എവിടെയാ സ്ഥലം?"
    },
    {
      "t": "00:10",
      "text": "ഷൊർണൂർ"
    },
    {
      "t": "00:12",
      "text": "വീട് എവിടെയാ അറിയാമോ?"
    },
    {
      "t": "00:14",
      "text": "അറിയില്ല"
    },
    {
      "t": "00:15",
      "text": "ഹസ്ബൻഡ്"
    },
    {
      "t": "00:18",
      "text": "ഹസ്ബൻഡ് വിളിക്കണ്ട."
    },
    {
      "t": "00:21",
      "text": "വിളിക്കേണ്ട വിളിച്ചാൽ കുഴപ്പമാകും."
    },
    {
      "t": "00:27",
      "text": "ഹസ്ബൻഡ് എവിടെയാണെന്ന് അറിഞ്ഞോ?"
    },
    {
      "t": "00:30",
      "text": "ഹോട്ടലിൽ ഒക്കെ പോയിട്ടുണ്ട്."
    },
    {
      "t": "00:32",
      "text": "എവിടെ? കാണുന്നില്ല."
    },
    {
      "t": "00:35",
      "text": "അറിയില്ല."
    },
    {
      "t": "00:37",
      "text": "ഞാൻ നിന്നെ കളിക്കേണ്ടേ?"
    },
    {
      "t": "00:46",
      "text": "ഹസ്ബൻഡ് ഉണ്ടെങ്കിൽ ഞാൻ നിന്നെ എങ്ങനെയാ നക്കുന്നത്?"
    },
    {
      "t": "00:52",
      "text": "കണ്ണാ"
    },
    {
      "t": "00:53",
      "text": "ഹസ്ബൻഡ് നക്കാറുള്ളോ?"
    },
    {
      "t": "00:58",
      "text": "ആ?"
    },
    {
      "t": "01:00",
      "text": "പിന്നെ നാട്ടുകാരനാ അവൻ എങ്ങനെയാ ആ ഹസ്ബൻഡ് ഉള്ളപ്പോൾ പിന്നെ"
    },
    {
      "t": "01:05",
      "text": "ഹസ്ബൻഡിനെ അവിടെ കെടുത്ത ഞാൻ നിന്നെ കളിക്കട്ടെ?"
    },
    {
      "t": "01:13",
      "text": "നല്ല മാതിരി അടിക്കട്ടെ?"
    },
    {
      "t": "01:19",
      "text": "പേര്"
    },
    {
      "t": "01:21",
      "text": "ആ?"
    },
    {
      "t": "01:22",
      "text": "പേര്"
    },
    {
      "t": "01:23",
      "text": "റോഷൻ"
    },
    {
      "t": "01:29",
      "text": "മുലയുണ്ടോ?"
    },
    {
      "t": "01:31",
      "text": "ഉണ്ട്."
    },
    {
      "t": "01:32",
      "text": "മുല വലുതാണോ? കാണിച്ചേ."
    }
  ]
