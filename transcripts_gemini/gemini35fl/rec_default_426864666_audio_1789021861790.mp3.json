  "segments": [
    {
      "t": "00:01",
      "text": "ಹಲೋ."
    },
    {
      "t": "00:03",
      "text": "ಹಾಯ್."
    },
    {
      "t": "00:04",
      "text": "ಹಲೋ ಎಲಿಂಡ."
    },
    {
      "t": "00:07",
      "text": "ನೀವೆಲ್ಲಿಂದ ಮುಖ ತೋರಿಸಿ ಮಾತಾಡ್ರಿ."
    },
    {
      "t": "00:11",
      "text": "ನಿಮ್ ಫೇಸ್ ಕಾಣಿಸ್ತಾನೆ ಇಲ್ಲ."
    },
    {
      "t": "00:15",
      "text": "ನೀವೇ ಮಾಸ್ಕ್ ಹಾಕಿರಲ್ಲ ಮಾಸ್ಕ್ ತೆಗೆಯಿರಿ ತೆಗೆದು ಮಾತಾಡ್ರಿ ಅಲ್ವ."
    },
    {
      "t": "00:19",
      "text": "ಇಲ್ಲ ಯಾವ ಏರಿಯಾ ನಿಮ್ದು."
    },
    {
      "t": "00:22",
      "text": "ಬಿಜಾಪುರ."
    },
    {
      "t": "00:24",
      "text": "ಬಿಜಾಪುರ ಓಕೆ ತಿಂಡಿ ಆಯ್ತಾ."
    },
    {
      "t": "00:27",
      "text": "ಆಯ್ತು ನಿಮ್ದು ಯಾವೂರು."
    },
    {
      "t": "00:29",
      "text": "ಬೆಂಗಳೂರು."
    },
    {
      "t": "00:31",
      "text": "ಏನ್ರೀ ಒಡ್ಯಾರಂಗೆ ಮಾತಾಡ್ತೀರಾ."
    },
    {
      "t": "00:35",
      "text": "ಸೀರಿಯಸ್ ಯಾವೂರು ಅಂದ್ರಿ ನಿಮ್ದು."
    },
    {
      "t": "00:37",
      "text": "ಬೆಂಗಳೂರು ಕೇಳಿಸ್ತಾ."
    },
    {
      "t": "00:39",
      "text": "ಮಾಸ್ಕ್ ಮಾಸ್ಕ್ ತೆಗೆಯಲ್ವಾ ನೀವು ಮಾಸ್ಕ್."
    },
    {
      "t": "00:41",
      "text": "ಇಲ್ಲ."
    },
    {
      "t": "00:44",
      "text": "ಏನಾದ್ರೂ ತೋರಿಸ್ತೀರಾ."
    },
    {
      "t": "00:46",
      "text": "ಇಲ್ಲ ಎಷ್ಟು ದಿನದಿಂದ ಯೂಸ್ ಮಾಡ್ತಿರೋದು ನೀವು."
    },
    {
      "t": "00:49",
      "text": "ಮತ್ತೆ ತಿನ್ನಕ್ಕೆ ಯಾಕ್ರಿ ನೀವು ಮಾಸ್ಕ್ ಹಾಕಿದ್ದೀರಾ."
    },
    {
      "t": "00:52",
      "text": "ಸುಮ್ನೆ ಹಂಗೆ."
    }
  ]
}