  "segments": [
    {
      "t": "00:00",
      "text": "ஹாய்."
    },
    {
      "t": "00:06",
      "text": "ஹாய் என்ன ஊரு?"
    },
    {
      "t": "00:09",
      "text": "சேலம். நீங்க எதிலிருந்து?"
    },
    {
      "t": "00:12",
      "text": "நான் நாமக்கல்."
    },
    {
      "t": "00:13",
      "text": "நாமக்களா?"
    },
    {
      "t": "00:14",
      "text": "யோ."
    },
    {
      "t": "00:15",
      "text": "பக்கா திஸ்ட்."
    },
    {
      "t": "00:18",
      "text": "சேலத்துல இருந்தா?"
    },
    {
      "t": "00:20",
      "text": "நாமக்கல்லோடதா சேலனா கம்பட்டி பாய் பாஸ்."
    },
    {
      "t": "00:29",
      "text": "ஓகே ஓகே."
    },
    {
      "t": "00:30",
      "text": "இது டைரக்டா மீட் பண்ணலாமா?"
    },
    {
      "t": "00:32",
      "text": "ரைட் இட் சம் டைம்ஸ்."
    },
    {
      "t": "00:35",
      "text": "சம் டைம்ஸ். இது மேரிடா?"
    },
    {
      "t": "00:36",
      "text": "எஸ்."
    },
    {
      "t": "00:37",
      "text": "யா, டிவோர்சி."
    },
    {
      "t": "00:39",
      "text": "டிவோர்ஸா?"
    },
    {
      "t": "00:40",
      "text": "ம்."
    },
    {
      "t": "00:41",
      "text": "குழந்தைங்க?"
    },
    {
      "t": "00:43",
      "text": "யா, ஐ ஹேவ் எ ஒன் கேர்ள் பேபி."
    },
    {
      "t": "00:45",
      "text": "நீங்க ஒர்க்கிங் ஆர் ஸ்டடிங்? வாட் ஆர் யூ டூயிங்?"
    },
    {
      "t": "00:49",
      "text": "ஒர்க்கிங் தமிழே பேசுங்க."
    },
    {
      "t": "00:54",
      "text": "ஒர்க்கிங் என்ன ஒர்க் பண்றீங்க?"
    },
    {
      "t": "00:56",
      "text": "எச்ஆர்."
    },
    {
      "t": "00:58",
      "text": "எச்ஆர், ஹியூமன் ரிசோர்ஸ்."
    },
    {
      "t": "01:00",
      "text": "நீங்க?"
    },
    {
      "t": "01:02",
      "text": "ஒர்க்கிங் இன் ஐடி."
    },
    {
      "t": "01:04",
      "text": "ஐடியா?"
    },
    {
      "t": "01:05",
      "text": "எஸ்."
    },
    {
      "t": "01:06",
      "text": "பட் நவ் ஐ அம் நாட் ஒர்க்கிங்."
    },
    {
      "t": "01:09",
      "text": "சிலேப்."
    },
    {
      "t": "01:11",
      "text": "இப்ப என்ன பண்றீங்க?"
    },
    {
      "t": "01:13",
      "text": "சும்மாதான் இருக்கேன்."
    },
    {
      "t": "01:16",
      "text": "ஜாப் சர்ச்சிங்."
    },
    {
      "t": "01:19",
      "text": "ஜாப் சர்ச்சிங்கா?"
    },
    {
      "t": "01:20",
      "text": "எஸ்."
    },
    {
      "t": "01:21",
      "text": "இதுல?"
    },
    {
      "t": "01:22",
      "text": "லுக்கிங் பார் தி இன்டர்வியூ."
    },
    {
      "t": "01:25",
      "text": "ஒரு கேர்ள் பேபி இருக்கு."
    },
    {
      "t": "01:29",
      "text": "ஓகே ஓகே. அவங்க என்ன பண்றாங்க?"
    },
    {
      "t": "01:32",
      "text": "ஸ்கூல் போறாங்க."
    },
    {
      "t": "01:33",
      "text": "இப்ப என்ன பண்ணுவோம்? தூங்குறாங்களா?"
    },
    {
      "t": "01:35",
      "text": "ஆமா, இப்ப ஸ்டில் ஸ்லீப்பிங்."
    },
    {
      "t": "01:37",
      "text": "இதுல யார் யார் இருக்கா? வீட்ல யார் யார் இருக்கா?"
    },
    {
      "t": "01:40",
      "text": "யாரும் இல்ல."
    },
    {
      "t": "01:41",
      "text": "நீங்க பேபியோடுதானா?"
    },
    {
      "t": "01:42",
      "text": "ம். ஏன்? நீங்க வரீங்களா?"
    },
    {
      "t": "01:46",
      "text": "அதான் கேட்டேன்."
    },
    {
      "t": "01:48",
      "text": "ஓகே ஐ அம் வெயிட்டிங்."
    },
    {
      "t": "01:50",
      "text": "எவ்வளவு அமௌன்ட்?"
    },
    {
      "t": "01:53",
      "text": "தெரியலையே எனக்கு அப்படியெல்லாம்."
    },
    {
      "t": "01:57",
      "text": "சும்மா சொல்லுங்க."
    },
    {
      "t": "01:59",
      "text": "எவ்வளவு குடுப்பீங்க?"
    },
    {
      "t": "02:02",
      "text": "ஐயா இப்ப ஃபுல் நைட்னா எவ்வளவு?"
    },
    {
      "t": "02:05",
      "text": "புரியல."
    },
    {
      "t": "02:06",
      "text": "இது ஃபுல் நைட்ன்னா எவ்வளவு?"
    },
    {
      "t": "02:09",
      "text": "எனக்கு சத்தியமா தெரியல. நான்லாம் பண்ணது இல்ல."
    },
    {
      "t": "02:13",
      "text": "சும்மா சொல்லாதீங்க சொல்லுங்க."
    },
    {
      "t": "02:15",
      "text": "அட உண்மைதாங்க."
    },
    {
      "t": "02:19",
      "text": "இந்த பண்ண ட்ரிங்ஸ் பண்ணுவீங்களா?"
    },
    {
      "t": "02:22",
      "text": "கீப்பாவே சரக்கு அடிச்சதுதான் இருக்கேன் சொல்லுங்க."
    },
    {
      "t": "02:27",
      "text": "அப்புறம் என்ன?"
    },
    {
      "t": "02:29",
      "text": "இது தம்மு?"
    },
    {
      "t": "02:30",
      "text": "தம்மு ட்ரை பண்ணது இல்ல. மே பி குடுங்க, வேணும்னா ட்ரை பண்றேன்."
    },
    {
      "t": "02:35",
      "text": "இந்தாங்க வாங்கிக்கோங்க."
    },
    {
      "t": "02:37",
      "text": "தெரியலையே."
    },
    {
      "t": "02:39",
      "text": "ஓகே."
    },
    {
      "t": "02:44",
      "text": "ஓகே."
    },
    {
      "t": "02:47",
      "text": "ஓகே."
    },
    {
      "t": "02:49",
      "text": "தம்மு ட்ரை பண்ணது இல்ல. நாட் லைக் தட் ஸ்மோக் ஸ்மெல்."
    },
    {
      "t": "02:54",
      "text": "ஓகே ஓகே."
    },
    {
      "t": "02:55",
      "text": "ட்ரிங்ஸ் மீன்ஸ் ஐ ட்ரிங் வைன்."
    },
    {
      "t": "03:00",
      "text": "ஓ ஓ நீங்க வெறும் வைன் தானா?"
    },
    {
      "t": "03:02",
      "text": "அதுக்கே பாடி தாங்கல பாஸ்."
    },
    {
      "t": "03:05",
      "text": "ஹாப் வைன் குடுத்துட்டேன் ஃபுல்லா. வேற ஒன்னு வருது."
    },
    {
      "t": "03:09",
      "text": "ஓகே ஓகே செகண்ட் டைம்."
    },
    {
      "t": "03:13",
      "text": "எத்தனை பாய்ஃப்ரெண்ட் இருக்காங்க?"
    },
    {
      "t": "03:14",
      "text": "நோ ஐ டோன்ட் ஹேவ் பாய்ஃப்ரெண்ட்ஸ்."
    },
    {
      "t": "03:18",
      "text": "தமிழே பேசுங்கன்னேன்."
    },
    {
      "t": "03:20",
      "text": "ஏங்க நான் ரிமோட்லதாங்க வொர்க் பண்றேன். எனக்கு பாய்ஃப்ரெண்ட்ஸ் எல்லாம் கிடையாது. என் ஒர்க் வந்து சவுதியா, சிங்கப்பூர் அந்த மாதிரிதான்."
    },
    {
      "t": "03:28",
      "text": "எனக்கு லோக்கல்ல யாரையுமே தெரியாது."
    },
    {
      "t": "03:31",
      "text": "ஓகே ஓகே சேலம் வந்தா இது பண்ணலாமா மீட் பண்ணலாமா?"
    },
    {
      "t": "03:34",
      "text": "சேலம் வந்தா மீட் பண்ணா என்ன தருவீங்க?"
    },
    {
      "t": "03:37",
      "text": "என்ன வேணும்?"
    },
    {
      "t": "03:38",
      "text": "நீங்கதான் வேணும்."
    },
    {
      "t": "03:44",
      "text": "தாராளமா."
    },
    {
      "t": "03:47",
      "text": "தாராளமா. என்ன பண்ணுவீங்க சொல்லுங்க?"
    },
    {
      "t": "03:50",
      "text": "என்ன பண்ணனும்? இது வாட்ஸ் அப் நம்பர் குடுப்பீங்களா?"
    },
    {
      "t": "03:54",
      "text": "புரியல."
    },
    {
      "t": "03:54",
      "text": "வாட்ஸ் அப் நம்பர் குடுப்பீங்களா?"
    },
    {
      "t": "03:55",
      "text": "நான் வந்து வாட்ஸ் அப்."
    },
    {
      "t": "03:58",
      "text": "ஆக்சுவலி இந்த வாட்ஸ் அப் அது எல்லாருமே இந்த மாதிரி ஃபேக்கா ஏமாத்துறாங்க."
    },
    {
      "t": "04:03",
      "text": "யு கேன் ரெடி சீ தமிழ்ல பேசணும்ல."
    },
    {
      "t": "04:07",
      "text": "நீங்க பே பண்ணு ஓகேன்னா நான் வாட்ஸ் அப் நம்பர் குடுக்க ரெடி ஓகே?"
    },
    {
      "t": "04:11",
      "text": "எவ்வளவு அமௌன்ட்?"
    },
    {
      "t": "04:13",
      "text": "எவ்வளவு பண்ணுவீங்க? எனக்கு அப்படிலாம் கேட்க தெரியாது."
    },
    {
      "t": "04:19",
      "text": "எனக்கு ஏமாந்துட்டேங்கிற கில்ட் இல்லாம இருந்தா எனக்கு ஓகே."
    },
    {
      "t": "04:26",
      "text": "நான் நம்பிக்கலாமா? கடைசி வரைக்கும் நான் எதிப்பேன்."
    },
    {
      "t": "04:29",
      "text": "எனக்கு இன்னும் வந்து இது ஆகல. மேரிடு ஆகல."
    },
    {
      "t": "04:32",
      "text": "ஓகே."
    },
    {
      "t": "04:33",
      "text": "சங்கில்தா?"
    },
    {
      "t": "04:34",
      "text": "சிங்கிள் ஓகே."
    },
    {
      "t": "04:35",
      "text": "எனக்கு ஆக்சுவலா எனக்கு இந்த மாதிரி ஒரு ரிலேஷன்ஷிப் தேவைப்படுது. அதான் கேட்டேன்."
    },
    {
      "t": "04:39",
      "text": "ஓகே."
    },
    {
      "t": "04:41",
      "text": "எனக்கு நோ பாய்ஃப்ரெண்ட்ஸ். யாரையும் டிரஸ்ட் பண்ண மாட்டேன். எல்லா ஃபேக் பீப்பிள். எல்லாருமே ஏமாத்துறாங்க."
    },
    {
      "t": "04:47",
      "text": "இந்த ஆப்ல முதல் கொண்டு எல்லாருமே யாரும் நம்மளால ஏமாத்துறாங்க."
    },
    {
      "t": "04:51",
      "text": "பேசும்போதே டபக்குன்னு கால் கட் பண்ணிட்டு ஓடிறாங்க."
    },
    {
      "t": "04:54",
      "text": "ட்ரெஸ் ரிமூவ் பண்ண சொல்லுவாங்க. கழட்டுன உடனே ஓடிறாங்க."
    },
    {
      "t": "04:59",
      "text": "சரி நம்பர் உங்களுக்கு நம்பிக்கை இருந்தா நம்பர் குடுங்க."
    },
    {
      "t": "05:01",
      "text": "நான் வாட்ஸ் அப் பண்றேன்."
    },
    {
      "t": "05:02",
      "text": "சேலம் வந்தா மீட் பண்ணலாம்."
    },
    {
      "t": "05:04",
      "text": "சேலம் வந்தா மீட் பண்ணா என்ன பண்ணுவீங்க சொல்லுங்க."
    },
    {
      "t": "05:10",
      "text": "மேட்டரா?"
    },
    {
      "t": "05:13",
      "text": "ஜாலியா இருக்கலாம்."
    },
    {
      "t": "05:15",
      "text": "ஓகே."
    },
    {
      "t": "05:16",
      "text": "மேட்டர்."
    },
    {
      "t": "05:17",
      "text": "மேட்டர் பண்ணிட்டு ஏமாத்திட்டு போகமாட்டீங்களா?"
    },
    {
      "t": "05:19",
      "text": "ஏமாத்தலாம் போகமாட்டேன்."
    },
    {
      "t": "05:22",
      "text": "ஆனா எல்லாருமே ஏமாத்துறாங்களே. இப்ப மை பாடி கவுண்ட் இஸ் த்ரீ."
    },
    {
      "t": "05:30",
      "text": "சரி ஓகே. வாட்ஸ் அப் நம்பர் குடுங்க."
    },
    {
      "t": "05:34",
      "text": "வாட்ஸ் அப் நம்பர் குடுத்தா என்ன பண்ணுவீங்க? இப்ப வீடியோ கால் வருவீங்களா?"
    },
    {
      "t": "05:39",
      "text": "ம் வரேன்."
    },
    {
      "t": "05:40",
      "text": "ஷுவரா?"
    },
    {
      "t": "05:41",
      "text": "இதுவா நியூடா?"
    },
    {
      "t": "05:43",
      "text": "ஓகே."
    },
    {
      "t": "05:45",
      "text": "நம்பர் சொல்லுங்க."
    },
    {
      "t": "05:46",
      "text": "பே பண்ணிட்டு வருவீங்களா?"
    },
    {
      "t": "05:48",
      "text": "எவ்வளவு அமௌன்ட்?"
    },
    {
      "t": "05:49",
      "text": "ஏமாத்த மாட்டீங்களா என்ன?"
    },
    {
      "t": "05:50",
      "text": "எவ்வளவு அமௌன்ட்? எனக்கு வந்து எனக்கு டிரஸ்ட்தான் முக்கியம்."
    },
    {
      "t": "05:54",
      "text": "அதான் அதுதான் நானே சொல்றேன். எனக்கு அமௌன்ட் முக்கியம் இல்ல. எனக்கு டிரஸ்ட்தான் முக்கியம்."
    },
    {
      "t": "05:57",
      "text": "எனக்கும் டிரஸ்ட்தான் முக்கியம்."
    },
    {
      "t": "06:00",
      "text": "எனக்கு வந்து இப்ப நாங்க நேரம் வந்தா எனக்கு இது இருக்கா?"
    },
    {
      "t": "06:03",
      "text": "இது இருக்கா? இடம் இருக்கா?"
    },
    {
      "t": "06:05",
      "text": "புரியல."
    },
    {
      "t": "06:06",
      "text": "இது இடம் இருக்கா? இந்த நேரம் வந்தா?"
    },
    {
      "t": "06:09",
      "text": "நோ."
    },
    {
      "t": "06:10",
      "text": "நோ."
    },
    {
      "t": "06:11",
      "text": "உங்க வீடு?"
    },
    {
      "t": "06:13",
      "text": "திஸ் இஸ் நாட் சேப் பிளேஸ்."
    },
    {
      "t": "06:15",
      "text": "சரி, நம்ம எங்கயாச்சும் விடு போயிடலாம், வெளிய போயிடலாம்."
    },
    {
      "t": "06:19",
      "text": "ஓகே."
    },
    {
      "t": "06:21",
      "text": "இது சொல்லுங்க, இந்த நம்பர் சொல்லுங்க."
    },
    {
      "t": "06:23",
      "text": "இப்போ வீடியோ கால் பண்ணீங்கன்னா எனக்கு என்னை ஏமாத்தாம எனக்கு டிரஸ்ட்தான் எனக்கு ஃபர்ஸ்ட் முக்கியம்."
    },
    {
      "t": "06:30",
      "text": "ம்."
    },
    {
      "t": "06:30",
      "text": "ஓகேவா?"
    },
    {
      "t": "06:32",
      "text": "ஓகே."
    },
    {
      "t": "06:34",
      "text": "ஓகே. டெல் யுவர் வாட்ஸ் அப் நம்பர், தென் ஐ வில் ரியாக்ட் யூ."
    },
    {
      "t": "06:37",
      "text": "புரியல."
    },
    {
      "t": "06:38",
      "text": "நீங்க உங்க வாட்ஸ் அப் நம்பர் சொல்லுங்க. நான் ரியாக்ட் பண்றேன்."
    },
    {
      "t": "06:42",
      "text": "இது டபுள் எயிட்?"
    },
    {
      "t": "06:46",
      "text": "டபுள் எயிட். ஐயோ என்னென்னவோ தப்பு தப்பா போடுறேன் நானு."
    },
    {
      "t": "06:49",
      "text": "இப் யூ டோன்ட் மைண்ட் நான் சொல்லவா?"
    },
    {
      "t": "06:51",
      "text": "டபுள் எயிட். சரி சொல்லுங்க."
    },
    {
      "t": "06:53",
      "text": "9500"
    },
    {
      "t": "06:56",
      "text": "9500"
    },
    {
      "t": "06:58",
      "text": "92"
    },
    {
      "t": "07:00",
      "text": "92"
    },
    {
      "t": "07:01",
      "text": "39"
    },
    {
      "t": "07:03",
      "text": "39"
    },
    {
      "t": "07:04",
      "text": "81"
    },
    {
      "t": "07:06",
      "text": "பேரு?"
    },
    {
      "t": "07:09",
      "text": "என்ன தோணுதோ அதை போட்டுக்கோங்க."
    },
    {
      "t": "07:12",
      "text": "இது நம்பர் சொல்லுங்க."
    },
    {
      "t": "07:14",
      "text": "9500"
    },
    {
      "t": "07:15",
      "text": "ஆ."
    },
    {
      "t": "07:16",
      "text": "92"
    },
    {
      "t": "07:17",
      "text": "ஆ."
    },
    {
      "t": "07:18",
      "text": "39"
    },
    {
      "t": "07:20",
      "text": "ஆ."
    },
    {
      "t": "07:20",
      "text": "81"
    },
    {
      "t": "07:22",
      "text": "ஓகே. நான் கால் பண்ணிட்டா?"
    },
    {
      "t": "07:25",
      "text": "டெக்ஸ்ட் மீ தென் ஐ வில் ரியாக்ட் யூ."
    },
    {
      "t": "07:27",
      "text": "ஓகே."
    }
  ]
}