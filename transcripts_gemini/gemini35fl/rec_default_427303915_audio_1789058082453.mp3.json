      "text": "ஹலோ"
    },
    {
      "t": "00:03",
      "text": "ஹாய்"
    },
    {
      "t": "00:04",
      "text": "உங்கள் பேர் என்ன?"
    },
    {
      "t": "00:07",
      "text": "என் பேரு பவித்ரா, உங்க பேரு?"
    },
    {
      "t": "00:08",
      "text": "என் பேர் மணி."
    },
    {
      "t": "00:10",
      "text": "ஓகே ஓகே என்ன பண்றீங்க?"
    },
    {
      "t": "00:13",
      "text": "சும்மா படுத்துருக்கேன், நீங்க?"
    },
    {
      "t": "00:16",
      "text": "ம் நானும் சும்மாதான் இருக்கேன்."
    },
    {
      "t": "00:19",
      "text": "சாப்பிட்டீங்களா?"
    },
    {
      "t": "00:20",
      "text": "இல்ல."
    },
    {
      "t": "00:22",
      "text": "ம் சாப்பிட்டாச்சா சாப்பிட்டீங்களா ஏதாவது?"
    },
    {
      "t": "00:26",
      "text": "ம் சாப்பிட்டாச்சு."
    },
    {
      "t": "00:28",
      "text": "ம் நீங்க சிங்கிளா மேரிடா?"
    },
    {
      "t": "00:31",
      "text": "சிங்கிள் தாங்க, நீங்க?"
    },
    {
      "t": "00:35",
      "text": "ம் நானும் சிங்கிள் தான்."
    },
    {
      "t": "00:39",
      "text": "ம் என்ன சாப்பிட்டீங்களா? உங்க ஏஜ்?"
    },
    {
      "t": "00:44",
      "text": "புரியல."
    },
    {
      "t": "00:47",
      "text": "28."
    },
    {
      "t": "00:48",
      "text": "28, 28."
    },
    {
      "t": "00:50",
      "text": "ஓகே ஓகே."
    },
    {
      "t": "00:52",
      "text": "ஆ."
    },
    {
      "t": "00:54",
      "text": "ம் என்ன கேட்டீங்க? பிரேக் ஆகுது."
    },
    {
      "t": "00:59",
      "text": "என்ன சாப்பிட்டீங்கன்னு."
    }
  ]
}