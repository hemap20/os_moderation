      "text": "[inaudible]"
    },
    {
      "t": "00:12",
      "text": "मैं प्रशांत, आप कौन?"
    },
    {
      "t": "00:15",
      "text": "मैं पूजा कुमारी।"
    },
    {
      "t": "00:20",
      "text": "कहाँ से हो?"
    },
    {
      "t": "00:25",
      "text": "मैं न्यू दिल्ली से हूँ।"
    },
    {
      "t": "00:27",
      "text": "न्यू दिल्ली से।"
    },
    {
      "t": "00:29",
      "text": "हाँ।"
    },
    {
      "t": "00:31",
      "text": "मैं गुजरात से हूँ।"
    },
    {
      "t": "00:34",
      "text": "क्या करते हो गुजरात में?"
    },
    {
      "t": "00:37",
      "text": "मैं जॉब करता हूँ।"
    },
    {
      "t": "00:40",
      "text": "हाँ तो क्या दोस्ती करोगी मुझसे?"
    },
    {
      "t": "00:43",
      "text": "सॉरी?"
    },
    {
      "t": "00:45",
      "text": "दोस्ती करोगी क्या मुझसे?"
    },
    {
      "t": "00:48",
      "text": "हाँ करूँगा ना क्यों नहीं करूँगा इसी लिए तो कॉल किया है।"
    },
    {
      "t": "00:52",
      "text": "हाँ तो अपना व्हाट्सएप नंबर बोलो।"
    },
    {
      "t": "00:54",
      "text": "व्हाट्सएप पर अभी से एक ही बार पहली बार में।"
    },
    {
      "t": "00:59",
      "text": "क्या?"
    },
    {
      "t": "01:00",
      "text": "अभी से व्हाट्सएप पर।"
    },
    {
      "t": "01:03",
      "text": "हाँ, वही तो।"
    },
    {
      "t": "01:06",
      "text": "फिर आप बता दो नंबर आपका।"
    },
    {
      "t": "01:10",
      "text": "आप अपना बोलो, मैं आपको मैसेज डालती हूँ, ठीक है।"
    },
    {
      "t": "01:15",
      "text": "और वहाँ पर फिर मैं वीडियो कॉल, वीडियो कॉल कुछ भी नहीं होगा, सिर्फ नॉर्मल बात होगी।"
    },
    {
      "t": "01:20",
      "text": "मतलब?"
    },
    {
      "t": "01:22",
      "text": "वीडियो कॉल नहीं करूँगा मैं।"
    },
    {
      "t": "01:25",
      "text": "हाँ तो मुझे कौन सी दिक्कत है, अपना फोटो डाल देना, उसपे देख लूँगी मैं।"
    }
  ]
