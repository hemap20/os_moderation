  "segments": [
    {
      "t": "00:03",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:05",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:06",
      "text": "ಹಾ ಹೇಳಿ ಕೇಳ್ತಾ ಇದೆ."
    },
    {
      "t": "00:09",
      "text": "ಹೇಳ್ತಾ ಇರಿ ಮೇಡಂ."
    },
    {
      "t": "00:11",
      "text": "ತುಮಕೂರು ಇಂದ, ನೀವು?"
    },
    {
      "t": "00:13",
      "text": "ನಮ್ದು ಮಂಡ್ಯ."
    },
    {
      "t": "00:15",
      "text": "ಮಂಡ್ಯನಾ? ಏನ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಿ ನೀವು?"
    },
    {
      "t": "00:18",
      "text": "ನಾವು ಇಂಟೀರಿಯರ್ ವರ್ಕರ್."
    },
    {
      "t": "00:20",
      "text": "ಹೌದಾ, ಓದ್ತೀರದಾ?"
    },
    {
      "t": "00:22",
      "text": "ಇಂಟೀರಿಯರ್ ಅಷ್ಟೇ ಮೇಡಂ ನಮ್ದು."
    },
    {
      "t": "00:24",
      "text": "ಹಾ ಹಾ ಹಾ"
    },
    {
      "t": "00:25",
      "text": "ಟಿಫನ್ ಆಯ್ತಾ?"
    },
    {
      "t": "00:27",
      "text": "ಟಿಫನ್ ಆಯ್ತು ಕಂಟ್ರಿ ನಮ್ದು."
    },
    {
      "t": "00:29",
      "text": "ಆಯ್ತು."
    },
    {
      "t": "00:30",
      "text": "ನೀವೇ ಮಾಡ್ಕೊಂಡಿರೋದು?"
    },
    {
      "t": "00:32",
      "text": "ನಾವು ಮನೇಲಿ ಇರೋದು."
    },
    {
      "t": "00:39",
      "text": "ಮ್ಯಾರಿಡಾ?"
    },
    {
      "t": "00:40",
      "text": "ಸಿಂಗಲ್ ಕಂಟ್ರಿ."
    },
    {
      "t": "00:41",
      "text": "ಹೌದಾ? ಯಾಕೆ ಇನ್ನೂ ಮದುವೆ ಆಗಿಲ್ಲ? ಸೆಟ್ ಆಗಿಲ್ವಾ ಹುಡುಗಿ?"
    },
    {
      "t": "00:45",
      "text": "ಹುಡುಕ್ತಾಯಿದಾರೆ."
    },
    {
      "t": "00:47",
      "text": "ಹುಹು, ಎಷ್ಟು ಏಜು?"
    },
    {
      "t": "00:50",
      "text": "25."
    },
    {
      "t": "00:51",
      "text": "ಓಕೆ ನಾ?"
    },
    {
      "t": "00:52",
      "text": "ಇನ್ನೂ ಟೈಮ್ ಇದೆ ತಗೊಳ್ರಿ."
    },
    {
      "t": "00:55",
      "text": "ಟೈಮ್ ಇದೆ."
    },
    {
      "t": "00:56",
      "text": "ಆದ್ರೆ 25 ಅಲ್ಲ ಇನ್ನು."
    },
    {
      "t": "00:58",
      "text": "ಇನ್ನೂ ಟೈಮ್ ಇದೆ ಮೇಡಂ, ಇವಾಗ್ಲೇ ನೋಡಣ."
    },
    {
      "t": "01:02",
      "text": "ಹಾ?"
    },
    {
      "t": "01:03",
      "text": "ಇವಾಗ್ಲೇ ನೋಡ್ಕೊಂಡವರಣ ಅಂತ."
    },
    {
      "t": "01:05",
      "text": "ಹಾ ಹಾ ಹಾಗೆ."
    },
    {
      "t": "01:08",
      "text": "ಈಗಿಂದ ಹುಡುಕೊಂಡ್ರೆ ಸಿಗುತ್ತೆ ಅಂತಾನ ಏನು?"
    },
    {
      "t": "01:10",
      "text": "ಈಗಿಂದ ಹುಡುಕೋಳೋಣ ಅಂತ."
    },
    {
      "t": "01:12",
      "text": "ಹಾ ಹಾ ಹಾ"
    },
    {
      "t": "01:18",
      "text": "ಮತ್ತೆ?"
    },
    {
      "t": "01:21",
      "text": "ಹೇಳ್ಬೇಕಂದ್ರೆ ವರ್ಕ್ ಏನು ಮಾಡ್ತೀರಾ?"
    },
    {
      "t": "01:23",
      "text": "ಮನೇಲೇ ಇರೋದು ವರ್ಕ್ ಏನು ಹೋಗ್ತಾ ಇಲ್ಲ ಮನೇಲೇ ಇರೋದು."
    }
  ]
}