      "t": "07:48",
      "text": "थैंक यू नहीं, आई लव यू होता है वो वर्ड।"
    },
    {
      "t": "07:52",
      "text": "नहीं।"
    },
    {
      "t": "07:53",
      "text": "अगर आपको कोई अच्छा बोलेगा, आपके कोई तारीफ करेगा, तो उसको वही बोला जाता है।"
    },
    {
      "t": "07:59",
      "text": "उसको आई लव यू बोला जाता है।"
    },
    {
      "t": "08:02",
      "text": "नहीं।"
    },
    {
      "t": "08:03",
      "text": "बोला जाता है आपको।"
    },
    {
      "t": "08:06",
      "text": "क्यों, मुझे पढ़ा रहे हो?"
    },
    {
      "t": "08:11",
      "text": "पढ़ा नहीं रहा हूँ।"
    },
    {
      "t": "08:15",
      "text": "पढ़ना तो मैं चाहता हूँ आपसे।"
    },
    {
      "t": "08:18",
      "text": "मैं अगर मैडम हूँ?"
    },
    {
      "t": "08:21",
      "text": "मेरी मैडम बन जाओ ना।"
    },
    {
      "t": "08:23",
      "text": "अच्छा।"
    },
    {
      "t": "08:29",
      "text": "और बताओ,"
    },
    {
      "t": "08:30",
      "text": "एक बात पूछूँ आपसे?"
    },
    {
      "t": "08:32",
      "text": "हूँ"
    },
    {
      "t": "08:34",
      "text": "आप इंस्टाग्राम यूज़ करते हो?"
    },
    {
      "t": "08:37",
      "text": "मैं इंस्टाग्राम चलाती हूँ, पर मैं आईडी देती नहीं हूँ किसी को भी।"
    },
    {
      "t": "08:42",
      "text": "अब किसी भी हो गया यार, कोई, अरे यार ये बात मत किया करो।"
    },
    {
      "t": "08:48",
      "text": "नहीं नहीं, मेरी बात सुनो पहले,"
    },
    {
      "t": "08:52",
      "text": "और तुम्हें अच्छा लगता है, ठीक है? नहीं, अब आपकी बात क्या सुनूँ? नहीं, मैं आपकी बात समझ रहा हूँ।"
    },
    {
      "t": "08:55",
      "text": "सुनो।"
    },
    {
      "t": "08:56",
      "text": "मेरी बात तो सुनो पहले।"
    },
    {
      "t": "08:58",
      "text": "नहीं पहले, सुनो सुनो, आपकी सुन लेते हैं, नहीं, मैं आपकी सुन लूँगा पहले आप फिर मेरी सुन सकते हो, 1 मिनट पहले।"
    },
    {
      "t": "09:07",
      "text": "हाँ हाँ, सुनाओ।"
    },
    {
      "t": "09:08",
      "text": "आपको नहीं देना है, तो आप ना बोलो।"
    },
    {
      "t": "09:11",
      "text": "बोल रहे हो, लेकिन आप कोई एक्सक्यूज देके ना क्यों बोल रहे हो?"
    },
    {
      "t": "09:16",
      "text": "मेरे को नहीं आता है एक्सक्यूज से एक्सक्यूज समझ में।"
    },
    {
      "t": "09:19",
      "text": "मैं क्या बोल रही हूँ, वो सुनो।"
    },
    {
      "t": "09:22",
      "text": "ओके भाभी जी।"
    },
    {
      "t": "09:24",
      "text": "पहले जो मैं बोल रही हूँ, वो सुनो।"
    },
    {
      "t": "09:26",
      "text": "सुनाइए।"
    },
    {
      "t": "09:27",
      "text": "मैंने तुमसे क्या बोला कि मेरी थोड़ी मजबूरी है जो मैं इस ऐप पे आई हूँ।"
    },
    {
      "t": "09:31",
      "text": "हूँ"
    },
    {
      "t": "09:32",
      "text": "मैं आई हूँ सिर्फ अर्निंग के लिए।"
    },
    {
      "t": "09:35",
      "text": "हूँ"
    },
    {
      "t": "09:36",
      "text": "अब मैं इसमें नंबर दे दूँ या किसी को आईडी दे दूँ, तो उसमें नुकसान तो मेरा ही है ना।"
    },
    {
      "t": "09:41",
      "text": "यहाँ पे जब तक बात करेंगे, जब तक मेरे को थोड़ी बहुत अर्निंग होती रहेगी।"
    },
    {
      "t": "09:44",
      "text": "हूँ"
    },
    {
      "t": "09:47",
      "text": "अब मैं यहाँ से निकल के बाहर चली जाऊँ, यहाँ का टाइम वहाँ बर्बाद करूँ तो मेरे को तो कुछ फायदा नहीं है ना।"
    },
    {
      "t": "09:54",
      "text": "उस अर्निंग की जरूरत ही नहीं पड़ेगी, आप मुझे नंबर दे दोगे तो मैं आपको"
    },
    {
      "t": "09:59",
      "text": "अपना बना लूँगा ना।"
    },
    {
      "t": "10:04",
      "text": "आईडी दे दो।"
    },
    {
      "t": "10:05",
      "text": "हाँ"
    },
    {
      "t": "10:08",
      "text": "तो मेरा खर्चा-पानी कौन उठाएगा? कहाँ से लाऊँगी मैं खर्चा-पानी?"
    },
    {
      "t": "10:12",
      "text": "सच में मैं"
    },
    {
      "t": "10:13",
      "text": "मैं चप-अपना खर्चा उठाती हूँ, अपने बच्चों का खर्चा उठाती हूँ।"
    },
    {
      "t": "10:17",
      "text": "जब मैं"
    },
    {
      "t": "10:18",
      "text": "मैं आपका हो जाऊंगा तो आप भी तो मेरी हो जाओगी ना, तो मैं ही हूँ"
    },
    {
      "t": "10:22",
      "text": "करूंगा।"
    },
    {
      "t": "10:23",
      "text": "पहले तुम पढ़ाई कर रहे हो, पढ़ाई करोगे? जिम्मेदारी उठाओगे अभी।"
    },
    {
      "t": "10:28",
      "text": "जिम्मेदारी क्या है? उसमें सब उठ जाएगी।"
    },
    {
      "t": "10:32",
      "text": "पहले पढ़ाई करो।"
    },
    {
      "t": "10:33",
      "text": "फिर आप ही को तो उठाना है एक बार बस।"
    },
    {
      "t": "10:38",
      "text": "मैं कह रही, पहले पढ़ाई।"
    },
    {
      "t": "10:41",
      "text": "दो बच्चे आपके हैं, दो मैं कर, दो मेरे साथ कर लेना, चार हो जाएंगे।"
    },
    {
      "t": "10:47",
      "text": "बहुत अच्छे।"
    },
    {
      "t": "10:50",
      "text": "क्या बहुत अच्छे?"
    },
    {
      "t": "10:52",
      "text": "चार बच्चों की माँ अच्छी लग।"
    },
    {
      "t": "10:54",
      "text": "संभाल नहीं पाओगे चार बच्चे।"
    },
    {
      "t": "10:59",
      "text": "मैं तो दो से ही करे जानूँ।"
    },
    {
      "t": "11:00",
      "text": "तो फिर मैं"
    },
    {
      "t": "11:01",
      "text": "मैं चार करूँगा तो छह हो जाएंगे।"
    },
    {
      "t": "11:04",
      "text": "तीन तुम संभाल लेना, तीन मैं संभाल लूँगा।"
    },
    {
      "t": "11:08",
      "text": "अच्छा"
    },
    {
      "t": "11:16",
      "text": "फैमिली में कौन-कौन है?"
    },
    {
      "t": "11:20",
      "text": "फैमिली में तो हम दोनों हैं अभी।"
    },
    {
      "t": "11:24",
      "text": "कौन-कौन?"
    },
    {
      "t": "11:25",
      "text": "आप और मैं।"
    },
    {
      "t": "11:28",
      "text": "अरे आपकी फैमिली में कौन-कौन है?"
    },
    {
      "t": "11:32",
      "text": "मम्मी, पापा, मैं और बहन बड़ी बस।"
    },
    {
      "t": "11:35",
      "text": "अच्छा।"
    },
    {
      "t": "11:44",
      "text": "बस वही।"
    },
    {
      "t": "11:45",
      "text": "तीन भाई-बहन हो। हेलो"
    },
    {
      "t": "11:48",
      "text": "आई लव यू।"
    },
    {
      "t": "11:53",
      "text": "मैं क्या बोलूँ?"
    },
    {
      "t": "11:55",
      "text": "आप भी बोल दो।"
    },
    {
      "t": "11:57",
      "text": "क्या बोलूँ?"
    },
    {
      "t": "11:59",
      "text": "आई लव यू टू।"
    },
    {
      "t": "12:02",
      "text": "अच्छा।"
    },
    {
      "t": "12:04",
      "text": "बोलो?"
    },
    {
      "t": "12:06",
      "text": "अच्छा होता है इंग्लिश में वर्ड है, अच्छा वर्ड है ये।"
    },
    {
      "t": "12:09",
      "text": "यह बोला जाता है।"
    },
    {
      "t": "12:15",
      "text": "अरे ऐसे बोला जाता है?"
    },
    {
      "t": "12:17",
      "text": "ये तो वैसे बोला जाता है ना जो एक दूसरे को चाहते हो।"
    },
    {
      "t": "12:21",
      "text": "हाँ तो आ मैं आपको चाहता हूँ ना।"
    },
    {
      "t": "12:24",
      "text": "तो तुम मेरे को चाहते हो, मैं तो नहीं चाहती ना अभी।"
    },
    {
      "t": "12:28",
      "text": "एकदम से आते चाहने लगे।"
    },
    {
      "t": "12:30",
      "text": "बोलो तो एक बार आई लव यू, क्या प्रॉब्लम है?"
    },
    {
      "t": "12:34",
      "text": "बोलने से क्या होगा?"
    },
    {
      "t": "12:36",
      "text": "ऐसा नहीं होता।"
    },
    {
      "t": "12:39",
      "text": "आई लव यू बोलने में क्या प्रॉब्लम है?"
    },
    {
      "t": "12:43",
      "text": "प्रॉब्लम तो कुछ नहीं है।"
    },
    {
      "t": "12:46",
      "text": "तो बोलो ना।"
    },
    {
      "t": "12:53",
      "text": "ठीक है।"
    },
    {
      "t": "12:54",
      "text": "हूँ"
    },
    {
      "t": "12:56",
      "text": "बोलो।"
    },
    {
      "t": "13:00",
      "text": "ठीक है।"
    },
    {
      "t": "13:03",
      "text": "ठीक है, बोल तो दिया।"
    },
    {
      "t": "13:04",
      "text": "बोलो एक बार अच्छे से, मैंने नहीं सुना।"
    },
    {
      "t": "13:10",
      "text": "बोलो।"
    },
    {
      "t": "13:14",
      "text": "ठीक है, ठीक है, बोल तो दिया।"
    },
    {
      "t": "13:17",
      "text": "आई लव यू बोलो।"
    },
    {
      "t": "13:21",
      "text": "बोलो।"
    },
    {
      "t": "13:25",
      "text": "ठीक है, आदत नहीं है तो।"
    },
    {
      "t": "13:29",
      "text": "अब बच्चे करने कब आ जाओ।"
    },
    {
      "t": "13:35",
      "text": "हेलो"
    },
    {
      "t": "13:38",
      "text": "हेलो"
    },
    {
      "t": "13:41",
      "text": "बच्चे करने कब आ जाऊँ? मेरा तो वही होता है।"
    },
    {
      "t": "13:44",
      "text": "बच्चे करने कब आ जाऊँ?"
    },
    {
      "t": "13:47",
      "text": "कभी भी नहीं।"
    },
    {
      "t": "13:49",
      "text": "क्यों?"
    },
    {
      "t": "13:51",
      "text": "मेरे दो ही बहुत हैं।"
    },
    {
      "t": "13:53",
      "text": "चार मैं कर दूंगा।"
    },
    {
      "t": "13:56",
      "text": "बता देना कभी भी।"
    }
  ]
}