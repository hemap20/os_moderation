  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ."
    },
    {
      "t": "00:01",
      "text": "ಹಾಯ್."
    },
    {
      "t": "00:03",
      "text": "ಹಾಯ್ ಯಾವ ಊರಿನಿಂದ ನೀವು?"
    },
    {
      "t": "00:07",
      "text": "ನಾ ಬೆಂಗಳೂರಿಂದ. ನೀವು?"
    },
    {
      "t": "00:09",
      "text": "ನಾ ಬೆಂಗಳೂರಿಂದ."
    },
    {
      "t": "00:10",
      "text": "ನಾ ಇವಾಗ ಎಂಬಿಎ ಕಂಪ್ಲೀಟ್ ಆಗಿದೆ, ಸೋ ಮನೆಯಲ್ಲೇ ಇದ್ದೀನಿ."
    },
    {
      "t": "00:15",
      "text": "ಯಾವ ತರ ಮಾತಾಡ್ಕೊಂತೀರಾ ಶುಭು?"
    },
    {
      "t": "00:18",
      "text": "ಸಾರೀ, ಏನ್ ಅರ್ಥ ಆಗಲಿಲ್ಲ, ಕೇಳಿಸ್ತಿಲ್ಲ ಏನು?"
    },
    {
      "t": "00:22",
      "text": "ಯಾವ ತರ ಮಾತಾಡ್ಕೊಂತೀರಾ ಶುಭು ನಂಗೆ ಏನು ಗೊತ್ತು?"
    },
    {
      "t": "00:26",
      "text": "ನೀವು ಯಾವ ತರ ಮಾತಾಡ್ತೀರಾ?"
    },
    {
      "t": "00:30",
      "text": "ಸೆಕ್ಸೀ."
    },
    {
      "t": "00:32",
      "text": "ಮಾತಾಡಬಹುದು ಬಟ್ ನಂಗೆ ಹೆಂಗೆ ಸಿಗುತ್ತೆ ಮಾತಾಡಿದ್ರೆ."
    },
    {
      "t": "00:37",
      "text": "ಏನ್ರೀ?"
    },
    {
      "t": "00:38",
      "text": "ಮಾತಾಡಬಹುದು ಬಟ್ ಮಾತಾಡಿದ್ರೆ ನಂಗೆ ಹೆಂಗೆ ಸಿಗುತ್ತೆ?"
    },
    {
      "t": "00:46",
      "text": "ಮ್ಯಾಚುರಿಟಿ ಮ್ಯಾಚುರಿಟಿ"
    },
    {
      "t": "00:48",
      "text": "ಹೂ ಯಾರಿಗೆ? ಯಾವ್ ಹಂಗ ನಮ್ಗ?"
    },
    {
      "t": "00:50",
      "text": "ನಂಗೆ."
    },
    {
      "t": "00:52",
      "text": "ಹೆಂಗ್ರೀ ಮಾಡ್ಕೊಳೋದು? ಸರ್ವಿಸ್ ತರಿಸ್ಕೊಂಡು."
    },
    {
      "t": "00:57",
      "text": "ಆಸ್ಟ್ರೇಲಿಯಾ ಮುಗಿಸ್ತೀರಾ?"
    },
    {
      "t": "01:00",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "01:03",
      "text": "ಇಫ್ ನೀವು ಪೇ ಮಾಡ್ತೀನಿ ಅಂದ್ರೆ ನಾನು ವಿಡಿಯೋ ಕಾಲ್ ಆರ್ ವಾಯ್ಸ್ ಕಾಲ್ ಮಾಡ್ತೀನಿ."
    },
    {
      "t": "01:08",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ಸಾರಿ ಸಾರಿ ಆ ತರ ಇಲ್ವಾ."
    },
    {
      "t": "01:11",
      "text": "ಓಕೆ."
    },
    {
      "t": "01:18",
      "text": "ಕನ್ನಡದಲ್ಲಿ ಸುಮ್ಮನೆ ಮಾತಾಡ್ತೀವಿ."
    },
    {
      "t": "01:21",
      "text": "ಸಾರಿ ಫ್ರೀಯಲ್ಲೆಲ್ಲ ಮಾತಾಡ್ಲಿಕ್ಕೆ ಆಗಲ್ಲ."
    },
    {
      "t": "01:25",
      "text": "ಓಕೆ ಸಾರಿ."
    }
  ]
}