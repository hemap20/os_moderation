    {
      "t": "11:45",
      "text": "ಎಷ್ಟು ತಿಂಗಳು ಹೇಳಿ."
    },
    {
      "t": "11:48",
      "text": "ಎಂಟು."
    },
    {
      "t": "11:50",
      "text": "ಎಂಟು ತಿಂಗಳು ಇದ್ರೆ ಬಿಟ್ಬಿಡ್ತೀರಾ ಮಾಡಲ್ವಾ?"
    },
    {
      "t": "11:53",
      "text": "ಹ್ಮ್ ಮಾಡೋದು ಅವಾಗೆಲ್ಲಾ ಪಾಪು ಇರುತ್ತಲ್ಲ ಮಾಡಬಾರದು."
    },
    {
      "t": "11:57",
      "text": "ಅದಕ್ಕೆ ಏನಾಗುತ್ತೆರಿ?"
    },
    {
      "t": "12:00",
      "text": "ಏನಪ್ಪ ಗೊತ್ತಿಲ್ಲ ಯಾಕೆ ಸುಮ್ನೆ ರಿಸ್ಕ್."
    },
    {
      "t": "12:04",
      "text": "ಏನ್ ರಿಸ್ಕ್ ಅಂತ ಏನ್ರೀ ನೀವು ಇವಾಗ ಮಾಡಿದ್ರೆ ಅದು ಮಗು ಬರೋದು ಇದೆ ಗೊತ್ತಾ."
    },
    {
      "t": "12:10",
      "text": "ಏನ್ ಬಾರ್ ಎಕ್ಸ್ಪೀರಿಯನ್ಸ್ ಹಂಗೆ ಹೇಳ್ತೀರಿ ನೀವು."
    },
    {
      "t": "12:13",
      "text": "ಅಂದ್ರೆ ಬಿಕಾಂ ಅಲ್ಲ ಸ್ವಲ್ಪ ಆಲ್ಪ ಸ್ವಲ್ಪ ಅಕೌಂಟ್ ಗೆ ಕಲ್ದ್ರೆ ಇನ್ನೊಂದು ಸ್ವಲ್ಪ."
    },
    {
      "t": "12:21",
      "text": "ಅದು ಔಟ್ಸೈಡ್ ನಾಲೆಡ್ಜ್ ಗೊತ್ತಿರುತ್ತೆ ಅಂತ."
    },
    {
      "t": "12:26",
      "text": "ಯಾರಿಗೆ ನಿಮ್ಮ ಫ್ರೆಂಡ್ ಮಾಡಿಸ್ಕೊಂಡಾರ."
    },
    {
      "t": "12:29",
      "text": "ಇಲ್ಲರೀ."
    },
    {
      "t": "12:31",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "12:32",
      "text": "ಮಾಡಿಸ್ಕೊಬೇಕು ಅಂದ್ರೆ ಅದು ನನ್ನ ತಾಳಿ ಕಟ್ಟಿದ ಗಂಡನ ಹತ್ರ ಮಾತ್ರ."
    },
    {
      "t": "12:38",
      "text": "ಬೇರೆ ಯಾರು ಬೇಡ ಅಂತೀರಾ."
    },
    {
      "t": "12:40",
      "text": "ಏ ಬೇಡರೀ ಪವಿತ್ರವಾದದ್ದು ಸ್ಥಳ ಅದು."
    },
    {
      "t": "12:47",
      "text": "ಏನಾಗುತ್ತೆ ಕ್ಯಾಶುವಲ್ ಹಂಗೆ."
    },
    {
      "t": "12:48",
      "text": "ಏ ಕ್ಯಾಶುವಲ್ ಆಗಿ ಮಾಡಿದ್ರೆ ಅದನ್ನೇ ಎಲ್ಲಾದ್ರಿಂದಲೂ ಮಾಡಿದ್ದೀರಾ ಅದೇನು ಏನ್ರೀ ಇದು ಓಡಿತಿದ್ದಿ."
    },
    {
      "t": "12:54",
      "text": "ಓನ್ಲಿ ಅದು ಮದುವೆ ಆಗಿದ್ದು ಗಂಡನಿಗೆ ಮಾತ್ರ ಸೀಮಿತ."
    },
    {
      "t": "12:58",
      "text": "ಮ್ಯಾಗಿಂದ್ರ."
    },
    {
      "t": "13:00",
      "text": "ಏ ಇಲ್ಲರೀ."
    },
    {
      "t": "13:03",
      "text": "ಅದು ಇಲ್ಲ ಅಂತೀರಾ."
    },
    {
      "t": "13:05",
      "text": "ಅಂದ್ರೆ ಡ್ರೆಸ್ ಹಾಕೊಂಡಾಗ ಮೇಲೆ ಎಕ್ಸ್ಪೋಸ್ ಆಗುತ್ತೆ ಹಾಗಂತ ಅವರ ಕೈಗೆಲ್ಲ ಕೊಡೋಕೆ ಆಗುತ್ತಾ?"
    },
    {
      "t": "13:16",
      "text": "ತೋರ್ಸು ಮಖಾ ತೋರಿಸಿ ಇಲ್ಲ ವಾಟ್ಸಪ್ ನ ಬರ್ತೀರಾ."
    },
    {
      "t": "13:19",
      "text": "WhatsApp ಗೆ ಬರ್ತಿದ್ದೆ ಬಟ್ ನೀವೇನು ಮುಖ ತೋರಿಸಿ ತೋರಿಸಿ ಹೇಗಿ ಫೋರ್ಸ್ ಮಾಡ್ತೀರಾ ಮಾತಾಡಲಿಕ್ಕೆ ಮುಗಿತಾ ಇಂಟರೆಸ್ಟ್ ಮುಗಿತಾ."
    },
    {
      "t": "13:29",
      "text": "ಇಂಟರೆಸ್ಟ್ ಅಂತ ಅಂದ್ರೆ ಅಟ್ಲೀಸ್ಟ್ ಫೇಸ್ ಟು ಫೇಸ್ ಮಾತಾಡ್ಕೊಂಡು ಕುಂದ್ರ ನಮಗೆ ಒಂತರ ಮೂಡ್ ಬರ್ತೈತಿ."
    },
    {
      "t": "13:35",
      "text": "ಫೇಸ್ ಟು ಫೇಸ್ ಮಾತಾಡೋದು ಯಕೋ ಏ ಡೇಂಜರ್ ಅಂತ."
    },
    {
      "t": "13:41",
      "text": "ಅದರಲ್ಲಿ ಏನ್ರಿ ಅಟ್ಲೀಸ್ಟ್ ನೀವು ಮಾತಾಡ್ತೀರಾ ನಾನು ಇಲ್ಲಿರ್ತೀನಿ ಅಟ್ಲೀಸ್ಟ್ ನಮಗೂ ಯಾರ ಜೊತೆಗೆ ಮಾತಾಡಕತ್ತೀವಪ್ಪ ಅನ್ಸುತ್ತೆ."
    },
    {
      "t": "13:47",
      "text": "ಇದು ಒಳ್ಳೆ ಕತ್ತಲಾಗ ನಾನು ಏನೋ ಮಾತಾಡಕತ್ತೀನಿ ಯಾರ ಜೊತೆಗೆ ಮಾತಾಡಕತ್ತೀನಿ ಗೊತ್ತಾಗಲ್ಲ ಹಂಗೆ ಅನಿಸಿಬಿಡ್ತೈತಿ."
    },
    {
      "t": "13:54",
      "text": "ನಾನು ಹುಡುಗಿನೇ ತಾನೇ ಮಾತಾಡ್ತಿರೋದು."
    },
    {
      "t": "13:57",
      "text": "ಕರೆಕ್ಟ್ ರೀ ಹಂಗೆ ಜಸ್ಟ್ ಒಂದು ಸಲ ಆಲಿ ತೋರಿಸಿದ್ರಲ್ಲ ಹಿಂಗೆ ಹಿಡ್ಕೊಂಡು ತೋರಿಸಿದ್ರಲ್ಲ ಮಾತಾಡೋಣಲ್ಲ ಏನಾಗುತ್ತೆ ತಗೋಳೋಣ."
    },
    {
      "t": "14:02",
      "text": "ಇವಾಗ ಏನಿ ನಿಮ್ಮ ಹತ್ರ ಬರಬೇಕು ನಾನು."
    },
    {
      "t": "14:05",
      "text": "ಹ್ಮ್ ಬಾ."
    },
    {
      "t": "14:07",
      "text": "ಅಲ್ರಿ ಹೆಂಡತಿ ಬಿಟ್ಟು ಮತ್ತೆ ಬೇರೆ ಏನಾದ್ರೂ ಏನೋ ಮಾಡಿದ್ರಾ?"
    },
    {
      "t": "14:10",
      "text": "ಹಂಗೆ ಮಾಡಿದ್ದೀರಿ ಏನಾಗುತ್ತೆ."
    },
    {
      "t": "14:14",
      "text": "ಅಂದ್ರೆ ಹೋಗಿದ್ದೀರಾ ಅಂದ್ರೆ."
    },
    {
      "t": "14:17",
      "text": "ಹ್ಮ್ ಹೋಗಿಲ್ಲ ಹೋಗಬೇಕು."
    },
    {
      "t": "14:20",
      "text": "ಯಾವಾಗ?"
    },
    {
      "t": "14:22",
      "text": "ಹೋಗಿಲ್ಲರಿ ಮದುವೆಗಿಂತ ಮೊದಲು ಅಷ್ಟೇ."
    },
    {
      "t": "14:25",
      "text": "ಮದುವೆಗಿಂತ ಮೊದಲು ಹೋಗಿದ್ರಿ."
    },
    {
      "t": "14:28",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "14:30",
      "text": "ಮದುವೆ ಆದ್ಮೇಲೆ?"
    },
    {
      "t": "14:31",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "14:33",
      "text": "ಮದುವೆಗಿಂತ ಮೊದಲು ಎಷ್ಟು ಸರಿ ಹೋಗಿದ್ರಿ?"
    },
    {
      "t": "14:36",
      "text": "ನಾಲ್ಕು ಸರಿ."
    },
    {
      "t": "14:38",
      "text": "ದುಡ್ಡು ಕೊಟ್ಟು ಹೋಗಿದ್ರಾ?"
    },
    {
      "t": "14:40",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "14:41",
      "text": "ಎಷ್ಟು ಒಂದು ನೈಟಾ ದಿನ?"
    },
    {
      "t": "14:45",
      "text": "ನೈಟು."
    },
    {
      "t": "14:47",
      "text": "ಎಷ್ಟು."
    },
    {
      "t": "14:49",
      "text": "ಡಿಪೆಂಡ್ಸ್ ರೀ ಅದು ಇವರ ಮೇಲೆ ಹೋಗುತ್ತೆ."
    },
    {
      "t": "14:52",
      "text": "ಅದು ಎಷ್ಟು ನನಗೆ ಒಂದು ಚೂರು ಎಕ್ಸ್ಪ್ಲೈನ್ ಮಾಡಿ."
    },
    {
      "t": "14:56",
      "text": "ಯಾಕ್ರಿ ನಿಮಗೆ."
    },
    {
      "t": "14:58",
      "text": "ಮಾಡಿ ನೋಡೋಣ."
    },
    {
      "t": "15:00",
      "text": "ಯಾಕೆ ಬರ್ತೀರಾ ನೀವು?"
    },
    {
      "t": "15:03",
      "text": "ಅಂದ್ರೆ ಸುಮಾರು ಜನ ಹೋಗಿ ಬಂದು ಮಾಡ್ತಾರೆ ಲಾರ್ಜ್ ಗೆ ಎಲ್ಲಾ ಲೇಡೀಸ್ ಬಟ್ ಅವರು ಕತ್ತಲಿ ತಾಳಿ ಒಬ್ರು ಕತ್ತಲಿ ತಾಳಿ ಇದ್ರೆ ಅವರ ಕತ್ತಲ ತಾಳಿ ಇರೋದಿಲ್ಲ."
    },
    {
      "t": "15:13",
      "text": "ಸೊ ಹಾಗಾಗಿ ಡೌಟ್."
    },
    {
      "t": "15:18",
      "text": "ನಿಮ್ಮ ಫ್ರೆಂಡ್ಸ್ ರೋಕರೇನ್."
    },
    {
      "t": "15:20",
      "text": "ಹಾ ಒಬ್ಬರು ಹೋಗಿದ್ದಾರೆ ಬಟ್ ಮದುವೆ ಆಗಿದೆ ಅವರದು."
    },
    {
      "t": "15:24",
      "text": "ಹೌದಾ."
    },
    {
      "t": "15:26",
      "text": "ಚೀ ಎಷ್ಟು ಹತ್ತಿರ ಎಷ್ಟು ಹವರ್ ಅದು ಅಂತ ಎಕ್ಸ್ಪ್ಲೈನ್ ಮಾಡಿ."
    },
    {
      "t": "15:30",
      "text": "ಅಂದ್ರೆ ಡಿಪೆಂಡ್ ಅವರು ಇದರ ಮೇಲೆ ಹೋಗುತ್ತೆ ಒಳ್ಳೆ ಚಲೋ ಫಿಗರ್ ಇದ್ರೆ ಮಸ್ತ್ ಇದ್ರೆ ನಾಲ್ಕೈದು ಸಾವಿರ ಖರ್ಚು ಮಾಡ್ತಾರೆ."
    },
    {
      "t": "15:38",
      "text": "ಒನ್ ಹವರ್ ಟು ಹವರ್ಸ್ ಗೆ."
    },
    {
      "t": "15:40",
      "text": "ಓಕೆ."
    },
    {
      "t": "15:42",
      "text": "ನಾರ್ಮಲ್ ಇದ್ರೆ ಒಂದು 2000 ರೂಪಾಯಿ ಟು ಹವರ್ಸ್."
    },
    {
      "t": "15:46",
      "text": "ಫುಲ್ ಡೇ ಇತ್ತು ಅಂತಂದ್ರೆ ನೈಟ್ ಇತ್ತು ಅಂದ್ರೆ 6000 7000 8000 10000 ಕೇಳ್ತಾರೆ."
    },
    {
      "t": "15:52",
      "text": "ಅಷ್ಟೆಲ್ಲಾ ಕೊಟ್ಟು ನೀವು ಹೋಗಿದ್ದೀರಾ?"
    },
    {
      "t": "15:58",
      "text": "ನಾವು ಹೋಗಿದ್ವಿ."
    },
    {
      "t": "16:01",
      "text": "ಎಷ್ಟು ಹೋಗಿದೆ ನಿನ್ ಅಮೌಂಟ್?"
    },
    {
      "t": "16:05",
      "text": "10,000 ಆಗಿರಬಹುದು 10-15 ಸಾವಿರ."
    },
    {
      "t": "16:08",
      "text": "ಫಸ್ಟ್ ಅಮೌಂಟ್ ಕಳ್ಕೊಂಡಿದ್ರಾ ನೋಡ್ರಿ ಪವಿತ್ರವಾದ ಜಾಗ ನಾನು ಹೆಂಡತಿ ಕೊಡೋದು ಬಿಟ್ಟು ಇನ್ನು ಯಾರಿಗೋ ಕೊಟ್ಟಿದ್ದೀರಿ."
    },
    {
      "t": "16:14",
      "text": "ಏ ಮದುವೆಗೆ ಮೊದಲು ಅಂತ ಹೇಳಕತ್ತೀನಿ ಎಲ್ಲರೂ."
    },
    {
      "t": "16:17",
      "text": "ಹ ಮದುವೆಗಿಂತ ಮಾಡಿದ್ರೆ ಅದೇನು ಮುಗಿತಲ್ಲ ನಿಂದು."
    },
    {
      "t": "16:21",
      "text": "ಏನಿರುತ್ತೆ."
    },
    {
      "t": "16:23",
      "text": "ಮದುವೆಗಿಂತ ಮೊದಲು ಇನ್ಯಾರಿಗೂ ತೋರಿಸಿದ್ದೀಯಾ."
    },
    {
      "t": "16:27",
      "text": "ಸ್ವಲ್ಪ ಮುಖ ತೋರಿಸಿ."
    },
    {
      "t": "16:30",
      "text": "ನನ್ನ ಮಕ್ಕಳದು ನೋಡಿ ಯಾವರಿಗೆ ಎಷ್ಟು ಪೇಷೆನ್ಸ್ ಇರಲ್ಲ."
    },
    {
      "t": "16:36",
      "text": "ನಿಮಗೆ ಕಾಯೋಷ್ಟು ಪೇಷೆನ್ಸ್ ಇರಲ್ಲ ಯಾವುದಾದರೂ ಒಂದು ಚೆನ್ನಾಗಿರೋ ಚಿಟ್ಟೆ ಸಿಕ್ಕಬಿಟ್ರೆ ಮುಗಿತು ಬೆನ್ ಹತ್ಕೊಂಡು ಹೋಗ್ಬಿಡ್ತೀರಾ."
    },
    {
      "t": "16:45",
      "text": "ಏನಿಲ್ಲ."
    },
    {
      "t": "16:49",
      "text": "ಅಂದ್ರೆ ಹೆಂಡತಿ ಗೊತ್ತಾ ಇದು?"
    },
    {
      "t": "16:53",
      "text": "ಅಲ್ಲ ತೋರಿಸಿ ಮುಖನಾ ತೋರಿಸಿ ಅಂದ್ರೆ."
    },
    {
      "t": "16:55",
      "text": "ಅಲ್ಲ ನಿಮ್ಮ ಹೆಂಡತಿಗೆ ಗೊತ್ತಾ ಇದು ಅಂದ್ರೆ."
    },
    {
      "t": "17:00",
      "text": "ಮೊದಲಿನಿಂದ ಹೇಳಿದ್ದು ಮೊದಲಿಗೆ ಮದುವೆಗಿಂತ ಮೊದಲು ಏನಾದರೂ ಇದ್ರೂನು ಅದೇ ನಿಮ್ದು ನಾನು ಕೇಳೋಕೆ ಹೋಗಲ್ಲ ನಂದು ಹಿಂಗೆ ಕೇಳೋಕೆ ಹೋಗಬೇಡ ಅಂತ."
    },
    {
      "t": "17:09",
      "text": "ಅಂದ್ರೆ ಅದನ್ನ ಕೆದುಕಿ ಉಪಯೋಗ ಇಲ್ಲರಿ ಸುಮ್ನೆ ಯಾಕೆ ಎಲ್ಲರಿಗೂ ಒಂದು ಪಾಸ್ಟ್ ಅಂತ ಇರುತ್ತೆ ಪಾಸ್ಟ್ ಅಂತ ಇರುತ್ತೆ."
    },
    {
      "t": "17:15",
      "text": "ಅನಸ್ತ ಪವ ಜಗಳ."
    },
    {
      "t": "17:17",
      "text": "ಈಗ ಎಲ್ಲರಿಗೂ ಒಂದು ಪಾಸ್ಟ್ ಇದ್ದೆ ಇರುತ್ತಲ್ಲ."
    },
    {
      "t": "17:21",
      "text": "ಅದೊಂದು ಮತ್ತೆ ಇವಾಗ ಡೆಲಿವರಿ ಹೋಗಿದ್ದಾಳೆ ಅಂತ ಅಂದ್ರೆ ಮತ್ತೆ ಇನ್ಯಾರನ್ನೋ ಹುಡುಕೊಂಡು ಹೋಗ್ಬಿಟ್ಟಿದ್ದೀರಾ?"
    },
    {
      "t": "17:25",
      "text": "ಇಲ್ಲ ಅದಕ್ಕೆ ಆಪ್ಸ್ ಅಷ್ಟೇ ಯೂಸ್ ಮಾಡೋದು."
    },
    {
      "t": "17:28",
      "text": "ಹಾಯ್ ರೀ ಆದ್ರೆ ಏನು ಆಗಲ್ಲ ಹೆಂಡತಿಗೋಸ್ಕರ ಜಸ್ಟ್ ಇರೋ."
    },
    {
      "t": "17:33",
      "text": "ತಿರಿಸಪ್ಪ ನಿಮ್ಮ ಮುಖನಾದರೂ ತೋರಿಸಿ."
    },
    {
      "t": "17:37",
      "text": "ಯಾಕೆ ಎಲ್ಲಾ ಬಂದು ಬಂದು ಮಾಡಿ ಮಾತಾಡಕತ್ತೀರಿ."
    },
    {
      "t": "17:42",
      "text": "ಆ."
    },
    {
      "t": "17:49",
      "text": "ಸುಮ್ ಮುಖಾನಾದರು ತೋರಿಸಿ ಅಂದ್ರೆ."
    },
    {
      "t": "17:51",
      "text": "ತೋರ್ಸಿದ್ನಲ್ಲ."
    },
    {
      "t": "17:53",
      "text": "ನೆಟ್ ತೋರಿಸಿರಿ ಅದೇ ನನಗೆ ಬಂದು ಎರಡು ಸಲ ತೋರಿಸಂಗೆ ಬಂದು ಮಾಡಿದ್ರಾ?"
    },
    {
      "t": "17:59",
      "text": "ನಾನು ಆನ್ಸಿ ಆಗಿದ್ದೀರಿ."
    },
    {
      "t": "18:01",
      "text": "ಯಾವ ತೋರಿಸಿರಿ."
    },
    {
      "t": "18:03",
      "text": "ಏನು."
    },
    {
      "t": "18:04",
      "text": "ತೋರ್ಸು."
    },
    {
      "t": "18:11",
      "text": "ಲೈಟ್ ಆಗಿ ಇಟ್ಕೋ ನೀನು ಏನ್ ಮಾಡ್ತಿ."
    },
    {
      "t": "18:18",
      "text": "ಸ್ವಲ್ಪ ಲೈಟ್ ಆಗಿ ಇಟ್ಕೊಂಡುಕೋ."
    },
    {
      "t": "18:24",
      "text": "ಇಟ್ಕೋಳಾ."
    },
    {
      "t": "18:29",
      "text": "ತೋರ್ಸು."
    },
    {
      "t": "18:33",
      "text": "ಇರು ಇರು."
    },
    {
      "t": "18:36",
      "text": "ಇನ್ನೊಂದ್ನಾ ಇವಾಗ ಹೋಗಿದ್ದರು ಯಾವಾಗ ಬರ್ತಾರೆ ಅವರು ಡೆಲಿವರಿ ಮುಗಿಸಿಕೊಂಡು."
    },
    {
      "t": "18:41",
      "text": "ಒಂದು ತಿಂಗಳು ಒಂದು ಐದು ಆರು ತಿಂಗಳು."
    },
    {
      "t": "18:45",
      "text": "ಐದು ಆರು ತಿಂಗಳು ಬಿಟ್ಟಿರ್ತೀರಾ ನೀವು."
    },
    {
      "t": "18:49",
      "text": "ನೋಡೋಣ ನೀನು ಸಿಕ್ತಿಯೇನ."
    },
    {
      "t": "18:52",
      "text": "ಅಲ್ಲ ಐದು ಆರು ತಿಂಗಳು ಒಳಗಡೆ ನೀವು ನಿಮ್ಮ ಹೆಂಡತಿ ಮೀಟ್ ಆದಾಗೆಲ್ಲ ಹೋಗಿ ಮಾಡಲ್ವಾ ನೀವು?"
    },
    {
      "t": "18:57",
      "text": "ಹೋಗ್ತಿರ್ತೀವಿ ಅಲ್ಲ ನೀವು ನೀನು ಸಿಕ್ತಿಯಾ ಅಂದೆ."
    },
    {
      "t": "19:01",
      "text": "ಯಾವೂರು ನಿಮ್ಮದು?"
    },
    {
      "t": "19:04",
      "text": "ದಾವಣಗೆರೆ."
    },
    {
      "t": "19:06",
      "text": "ಮತ್ತೆ ಆವಾಗ್ಲೇ ಬೆಂಗಳೂರು ಅಂದರಿ."
    },
    {
      "t": "19:09",
      "text": "ಇಲ್ಲ ಸರಿ."
    },
    {
      "t": "19:11",
      "text": "ದಾವಣಗೆರೆ."
    },
    {
      "t": "19:13",
      "text": "ಹ ಎಲ್ಲಿ ಬರುತ್ತೆ ಹೇಳಿ ದಾವಣಗೆರೆಯಲ್ಲಿ."
    },
    {
      "t": "19:17",
      "text": "ಹುಬ್ಬಳ್ಳಿಯಿಂದ ಮುಂದೆ ನೆಕ್ಸ್ಟ್."
    },
    {
      "t": "19:19",
      "text": "ಓಕೆ ಅದೇ ಅಡ್ರೆಸ್ ಹೇಳಿ."
    },
    {
      "t": "19:23",
      "text": "ಏನು ಅಂದ್ರೆ ಹುಬ್ಬಳ್ಳಿ ಆದ್ಮೇಲಿಂದಾ."
    },
    {
      "t": "19:27",
      "text": "ದಾವಣಗೆರೆ ಕೇಳಿದೀವಿ ನಾವು ಆ ದಾವಣಗೆರೆಯಲ್ಲಿ ದುರ್ಗಮ್ಮ ದೇವಿ ಇರುತ್ತೆ."
    },
    {
      "t": "19:32",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "19:33",
      "text": "ಅದೇ ದುರ್ಗಮ್ಮ ದೇವಿ ಅಂದ್ರೆ ನಿಮ್ಮ ದಾವಣಗೆರೆಯಲ್ಲಿ ಮೊನ್ನೆ ನಿಮ್ಮ ಏರಿಯಾ ಹೆಸರು ಏನ್ ಒಂದು."
    },
    {
      "t": "19:40",
      "text": "ವಿದ್ಯಾನಗರ ವಿದ್ಯಾನಗರ."
    },
    {
      "t": "19:42",
      "text": "ಓ ವಿದ್ಯಾನಗರ."
    },
    {
      "t": "19:44",
      "text": "ಓಕೆ ಬರ್ತೀನಿ ಎಷ್ಟು ಕೊಡ್ತೀರಾ?"
    },
    {
      "t": "19:48",
      "text": "ನಾನೇ ಗುಲ್ಬರ್ಗ ಬರ್ತೀನಿ ಅಂತ ಅವರಿ ಬಂದಾಗ ಆ ಕಡೆ ಬರ್ತಿರ್ತೀನಿ."
    },
    {
      "t": "19:50",
      "text": "ಏನು?"
    },
    {
      "t": "19:51",
      "text": "ನಾನೇ ಗುಲ್ಬರ್ಗ ಕಡೆ ಬರ್ತಿರ್ತೀನಿ."
    },
    {
      "t": "19:53",
      "text": "ಓಕೆ."
    },
    {
      "t": "19:55",
      "text": "ಸಿಕ್ತೀರಿ ಬಂದಾಗ."
    },
    {
      "t": "19:57",
      "text": "ಸಿಕ್ತೀನಿ ಅಂತ ಏನ್ ಕೊಡ್ತೀರಿ ಒಂದು ಕೇಳ್ದೆ."
    },
    {
      "t": "20:01",
      "text": "ಫುಲ್ ನೈಟ್ ಏನ್?"
    },
    {
      "t": "20:03",
      "text": "ಫುಲ್ ನೈಟ್ ಅಂದ್ರೆ ಫುಲ್ ಟು ಡೇ ನೈಟ್ ಫುಲ್ ಡೇ ಅಂಡ್ ಫುಲ್ ಡೇ."
    },
    {
      "t": "20:10",
      "text": "ಅದು 5000."
    },
    {
      "t": "20:14",
      "text": "ಕಡಿಮೆ ಆಗಲಿಲ್ವಾ? ಫುಲ್ ನೈಟ್ ಅಂತೀಯಾ ಇಲ್ಲ ಫುಲ್ ಡೇ ಅಂತೀಯಾ."
    },
    {
      "t": "20:20",
      "text": "ನೀನು ಫಸ್ಟ್ ನೋಡೋಣ ಬಾ ನಿನ್ನೆ ನೀನು ಹೆಂಗೆ ಕೋಆಪರೇಟ್ ಮಾಡ್ತೀನಿ."
    },
    {
      "t": "20:23",
      "text": "ನಿನ್ನನ್ನು ನೋಡಿ ಸರಿ ಅವಶ್ಯಕತೆನೇ ಇಲ್ಲ ಅಲ್ಲಿ ಫಿದಾ ಆಗ್ಬಿಡ್ತೀಯಾ."
    },
    {
      "t": "20:28",
      "text": "ಏನು ಇಲ್ಲ ನಿನ್ನ ಮುಖಾನೇ ತೋರಿಸಂಗಿಲ್ಲ ನೆಟ್ಟಗೆ ಇಲ್ಲಿ."
    },
    {
      "t": "20:33",
      "text": "ಅದು ಒಂದು ಸೆಕೆಂಡ್ ಅಲ್ಲ ಮುಖ ನೋಡ್ಲಿಲ್ಲವಾ ನೀನು ಹೇಗಿದ್ದೀನಿ ಅಂದ್ಬಿಟ್ಟು."
    },
    {
      "t": "20:36",
      "text": "ಇಲ್ಲ ಗೊತ್ತಾಗಲ್ಲ ಸ್ವಲ್ಪ ತೋರಿಸಬೇಕು ನೀವೆಲ್ಲ."
    },
    {
      "t": "20:39",
      "text": "ಇರು."
    },
    {
      "t": "20:43",
      "text": "ಹಲೋ."
    },
    {
      "t": "20:48",
      "text": "ಅಲ್ಲ ಬಂದ್ರೆ ಎಷ್ಟು ಸಾರಿ ಮಾಡಬಹುದು ಹೇಳು."
    },
    {
      "t": "20:53",
      "text": "ಯಾರು?"
    },
    {
      "t": "20:55",
      "text": "ನೀನು."
    },
    {
      "t": "20:57",
      "text": "ಹೇಗೆ ಮೂರು ಸಲ?"
    },
    {
      "t": "21:00",
      "text": "ಎಷ್ಟು ಹೊತ್ತು ಎಷ್ಟು ಹೊತ್ತು?"
    },
    {
      "t": "21:05",
      "text": "ನೋಡೋಣಂತೆ ಫಸ್ಟ್ ಮುಖ ಮೊಸ ಮುಖ ತೋರಿಸು."
    },
    {
      "t": "21:09",
      "text": "ಮನೆಗೆ ಮೂಡ್ ಬರಬೇಕು ಅವಾಗಿದ್ರೆ ಬರ್ತೀನಿ ನಾನು ಹೊರಗೆ."
    },
    {
      "t": "21:18",
      "text": "ಹಲೋ."
    },
    {
      "t": "21:24",
      "text": "ಸೈಜ್ ತೋರಿಸು ಹೆಂಗಿದೆ ನೋಡೋಣ."
    },
    {
      "t": "21:28",
      "text": "ಹಲೋ."
    },
    {
      "t": "21:30",
      "text": "ನೋಡಿದಿಯಾ?"
    },
    {
      "t": "21:32",
      "text": "ಅಲ್ಲ ನನಗೂ ಸ್ವಲ್ಪ ತೋರಿಸಲ್ಲ ಮಲ್ಲಿ."
    },
    {
      "t": "21:36",
      "text": "ಮನೆಗೆಲಿ ತೋರಿಸಿದ್ರೆ ನಾನು ನಿನ್ನ ಹತ್ರ ಬಂದ್ರೆ ನಿನಗೆ ಏನು ಗೊತ್ತಾಗುತ್ತೆ?"
    },
    {
      "t": "21:40",
      "text": "ಫೋನೇ ನೋಡಿದೀನಿ ಮತ್ತೆ ನೋಡೋದ ಅನ್ಸೀಯ."
    },
    {
      "t": "21:43",
      "text": "ಇಲ್ಲ."
    },
    {
      "t": "21:46",
      "text": "ತೋರ್ಸು."
    },
    {
      "t": "21:48",
      "text": "ವೀಡಿಯೊ ಕಾಲ್ ವೀಡಿಯೊ ಕಾಲ್ ಮಾಡ್ತೀವಿ."
    },
    {
      "t": "21:52",
      "text": "ನಾನು ಪರ್ಫೆಕ್ಟ್ ಅಂದ್ರೆ ನನಗೆ ಎಕ್ಸ್ಪ್ಲೈನ್ ಮಾಡು ಹೆಂಗೆ ಮಾಡ್ತೀಯಾ ಏನೇನು ಮಾಡ್ತೀಯಾ ಎಷ್ಟು ಸಾರಿ ಮಾಡ್ತೀಯಾ ಅಂದ್ಬಿಟ್ಟು."
    },
    {
      "t": "22:00",
      "text": "ಹಂಗಲ್ಲ."
    },
    {
      "t": "22:02",
      "text": "ಇವಾಗ ವೀಡಿಯೊ ಕಾಲ್ ಮಾಡ್ತಿ ವಾಟ್ಸಪ್ ನಲ್ಲಿ."
    },
    {
      "t": "22:06",
      "text": "ಬರ್ತೀನಿ ಇನ್ನೊಂದು ಎರಡು ಮೂರು ನಿಮಿಷದೊಳಗೆ ನಾನು ಅಲ್ಲಿಗೆ ಬರ್ತೀನಿ."
    },
    {
      "t": "22:11",
      "text": "ತೋರ್ಸು ಫುಲ್ ಬಿಚ್ಚಿ."
    },
    {
      "t": "22:16",
      "text": "ಮತ್ತೆ ತೋರಿಸು."
    },
    {
      "t": "22:18",
      "text": "ಬಿಚ್ಚಿ ತೋರಿಸಿದ್ರೆ ನಿನಗೇನು ಮಾಡಿದಂಗೆ ಆಯ್ತು ನೀನು."
    },
    {
      "t": "22:21",
      "text": "ಅಷ್ಟು ತೋರಿಸು ಸಾಕು."
    },
    {
      "t": "22:23",
      "text": "ಅಷ್ಟೇ ಬೇಡ ಇಲ್ಲೇ ನೋಡಿ ನಿಂತಿ ಅಂದೆ."
    },
    {
      "t": "22:26",
      "text": "ಇಲ್ಲ ಹಂಗೇನಿಲ್ಲ."
    },
    {
      "t": "22:30",
      "text": "ಆ ಮತ್ತೆ."
    },
    {
      "t": "22:32",
      "text": "ತೋರ್ಸು."
    },
    {
      "t": "22:34",
      "text": "ಮಾಡೋಣ."
    },
    {
      "t": "22:35",
      "text": "ಫುಲ್ ಬಿಚ್ಚಿ ತೋರಿಸು."
    },
    {
      "t": "22:38",
      "text": "ಎಷ್ಟು ಸಾರಿ ಮಾಡ್ತೀಯಾ ಅಂತ ಹೇಳಲಿಲ್ಲ."
    },
    {
      "t": "22:40",
      "text": "ಹೇಳಿದ್ನಲ್ಲ ಮೂರು ಸತಿ."
    },
    {
      "t": "22:43",
      "text": "ಒನ್ ನೈಟ್ ಫುಲ್."
    },
    {
      "t": "22:45",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "22:47",
      "text": "ಮತ್ತೆ ಡಿ."
    },
    {
      "t": "22:49",
      "text": "ಹಾ."
    },
    {
      "t": "22:50",
      "text": "ನೈಟ್ ಎಲ್ಲಾ ಮಲಗೋದು ಹೆಂಗೆ ಹೆಂಗೆ ಮಾಡ್ತೀ ನೀನು ಒಂದ್ಸಲ ನಿದ್ದೆಗೆ ಮಾಡಿದ್ರೆ ಮುಗಿತು ಔಟ್ ಮಾಡ್ಕೊಂಡು."
    },
    {
      "t": "22:58",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "22:59",
      "text": "ಮತ್ತೆ ಹೆಂಗೆ ಇದು ಮಾಡ್ತಿ? ಡೇ ಮಾಡೋದು ಹಂಗ."
    },
    {
      "t": "23:03",
      "text": "ಹ್ಮ್ ಆಯ್ತು ನೋಡಿ ಏನಾದ್ರೂ ಮಾಡೋಣ."
    },
    {
      "t": "23:07",
      "text": "ಇಷ್ಟು ಓನ್ಲಿ 5000 ಅಂದ್ರೆ ಆಗಲ್ಲ ನನಗೆ."
    },
    {
      "t": "23:12",
      "text": "ನೋಡೋಣಂತ ಅಲ್ಲಿ ಬಂದಾಗ ನಿನಗೆ ನಿಂಗೆ ಪಸಂದ್ ಆಯ್ತು ಅಂದ್ರೆ ಇವಾಗ ಹೇಳ್ತೀನಿ."
    },
    {
      "t": "23:18",
      "text": "ನೀನೇನು ದಪ್ಪ ಇದ್ದೀಯ."
    },
    {
      "t": "23:20",
      "text": "ಹಾ ಮೀಡಿಯಂ ಇದ್ದೀನಿ."
    },
    {
      "t": "23:22",
      "text": "ಬಟ್ ಮುಖ ನೋಡಿದ್ರೆ ಫುಲ್ ದಪ್ಪ ಆಗೋ ತರ ಕಾಣ್ತೀಯ."
    },
    {
      "t": "23:30",
      "text": "ತುಣಿ ಚಿಪ್ತಿಯಾ ನೀನು?"
    },
    {
      "t": "23:33",
      "text": "ಹ್ಮ್ ಅಲ್ಲಿ ಬಂದಾಗ ಗೊತ್ತಾಗುತ್ತಲ್ಲ ಹೆಂಗೆ ಮಾಡ್ತೀವಿ ಏನ್ ಮಾಡ್ತೀವಿ ಅಂತ ಯಾವಾಗ ಬರ್ತೀಯ ಹೇಳು ಡೇಟ್."
    },
    {
      "t": "23:39",
      "text": "ನಾನು ಬಂದಾಗ ಹೇಳ್ತೀನಿ ಅಂತ ಕಡೆಗೆ."
    },
    {
      "t": "23:42",
      "text": "ನೀನು ಬಂದಾಗ ಹೇಳಿದಂಗೆ ಬಂದಾಗ ಹೇಳ್ತೀನಿ ಅವರು ಕಾಲ್ ಕಟ್ ಆದ್ರೆ ಇನ್ನು ಯಾವಾಗ ಬಂದು ಹೇಳ್ತಿ."
    },
    {
      "t": "23:48",
      "text": "ಅದೇ ಹೇಳಿದ್ನಲ್ಲ ವಾಟ್ಸಪ್ ನಲ್ಲಿ ಇರು ಟಚ್ ಒಳಗೆ ಇರು ಫಸ್ಟ್ ಒಂದು ಸಲ ವೀಡಿಯೊ ಕಾಲ್ ಮಾಡೋಣ."
    },
    {
      "t": "23:55",
      "text": "ನಿನ್ನೆಲ್ಲಾ ಪೂರ್ತಿ ತೋರ್ಸು."
    },
    {
      "t": "24:02",
      "text": "ಲೈಕ್ ಆಗುತ್ತೆ ನೋಡೋಣ ಆಮೇಲೆ ನೆಕ್ಸ್ಟ್ ಬಂದಾಗ ನಾನು ಹೇಳ್ತೀನಿ."
    },
    {
      "t": "24:09",
      "text": "ಹುಬ್ಬಳ್ಳಿ ಬರ್ತೀನ."
    },
    {
      "t": "24:11",
      "text": "ನೀನು ದಪ್ಪ ಇದ್ದೀಯಾ ಅನಿಸುತ್ತಾ."
    },
    {
      "t": "24:14",
      "text": "ಹುಬ್ಬಳ್ಳಿ ಬರ್ತೀನ."
    },
    {
      "t": "24:16",
      "text": "ಹ್ಮ್ ಬರು."
    },
    {
      "t": "24:18",
      "text": "ಬಂದಾಗ ಖರ್ಚು ಎಷ್ಟು ಇರ್ತದೆ?"
    },
    {
      "t": "24:20",
      "text": "ನಮ್ಮ ಮೂವರಿಂದ ಬರಬೇಕು ಅಂದ್ರೆ."
    },
    {
      "t": "24:23",
      "text": "ಹುಬ್ಬಳ್ಳಿ ಹತ್ರ ಆಗುತ್ತೆ ಅನ್ಸುತ್ತೆ ಇದು ದೂರ ಆಗುತ್ತೆ."
    },
    {
      "t": "24:27",
      "text": "ಏ ರಾತ್ರಿ ಟ್ರೈನ್ ಟ್ರೈನ್ ಹತ್ತಿದ್ರೆ ಬೆಳಗ್ಗೆ ಬಂದಿರ್ತೀವಿ ಹುಬ್ಬಳ್ಳಿ."
    },
    {
      "t": "24:32",
      "text": "ಇರುತ್ತೆ ಏನ್ ಅಂದ್ರೆ ಹೋಗೋ ಬರೋ ಖರ್ಚು ಕೊಡ್ತಿಯಾ?"
    },
    {
      "t": "24:36",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "24:38",
      "text": "ಎಷ್ಟು ನಿಮ್ದು ಸ್ಯಾಲರಿ?"
    },
    {
      "t": "24:41",
      "text": "ಅದನ್ನ ತೆಗೆದು ಏನ್ ಮಾಡ್ತೀಯಾ."
    },
    {
      "t": "24:44",
      "text": "ಹೇಳು ನೋಡೋಣ ನಾನೇ ನೋಡು ತಗೊಂಡು ಬಿಡ್ತೀನಿ."
    },
    {
      "t": "24:48",
      "text": "ಅಯ್ಯೋ ಮಾವ."
    },
    {
      "t": "24:49",
      "text": "ಹೋಗ್ಲಿ ಬಿಡು ಇವಾಗ ಬಾ ಏನ್ ಈಗ ಮುಂದೆ ಈಗ ತೋರಿಸ್ತೀಯಾ ಹಂಗ ಇಲ್ಲ."
    },
    {
      "t": "24:54",
      "text": "ಏನು?"
    },
    {
      "t": "24:56",
      "text": "ವಿಡಿಯೋದಲ್ಲಿ ವಿಡಿಯೋ ಕಾಲ್."
    },
    {
      "t": "24:59",
      "text": "ನೀನು ಸಿಕ್ತಿಯಾ ಹಂಗ."
    },
    {
      "t": "25:01",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "25:02",
      "text": "ಯಾವ ತರ?"
    },
    {
      "t": "25:05",
      "text": "ತೋರ್ಸ್ತೀವಿ ವಿಡಿಯೋ ಕಾಲ್ ನಲ್ಲಿ ಎಲ್ಲ."
    },
    {
      "t": "25:08",
      "text": "ನಾ ತೋರಿಸ್ತೀನಿ ರಿಯಲ್ ಆಗಿ ಬಂದಾಗ ನೀನು ಸಿಕ್ತಿಯಾ ಅಂದೆ."
    },
    {
      "t": "25:12",
      "text": "ಹ ತೀರ್ಥನೆ."
    },
    {
      "t": "25:14",
      "text": "ಯಾವತರ ಯಾವತರ ಸೌಂಡು."
    },
    {
      "t": "25:17",
      "text": "ಏನು ನಿನ್ನ ತುಲ್ ಸಿಕ್ತೀನಿ ಮಸ್ತ್."
    },
    {
      "t": "25:21",
      "text": "ಅದು ಸೌಂಡ್ ಯಾವತರ."
    },
    {
      "t": "25:24",
      "text": "ಹೇಳ್ತೀನಿ ಬಾ ಅದಕ್ಕೆ ವಿಡಿಯೋ ಕಾಲ್ ಗೆ ಬಾ."
    },
    {
      "t": "25:26",
      "text": "ಯಾರು ಚಿಪ್ಪಿಲ್ಲ ನಿನ್ನ ತುಲ್ಲನ್ನು."
    },
    {
      "t": "25:29",
      "text": "ಏನು?"
    },
    {
      "t": "25:30",
      "text": "ನಿನ್ನ ತುಲ್ ಯಾರು ಚಿಪ್ಪಿಲ್ಲ ಅಂದೆ."
    },
    {
      "t": "25:31",
      "text": "ನಾನು ಯಾರಿಗೆ ಕೊಟ್ಟಿಲ್ಲ ಅಂತ ಆವಾಗ್ಲೇ ಅಂದೆ ಅದಕ್ಕೆ ರೇಟ್ ಜಾಸ್ತಿ ಇದೆ."
    },
    {
      "t": "25:36",
      "text": "ಸುಳ್ಳು ಹೇಳ್ತೀನಿ."
    },
    {
      "t": "25:39",
      "text": "ನಿನ್ನ ಹತ್ರ ಎಲ್ಲಾ ನಾನು ಕೇಳೋದು ಇದೆ ಅಂದ್ರೆ ನೀನು ರೋಮ್ಯಾಂಟಿಕ್ ಆಗಿ ಮಾತಾಡ್ತಿದ್ದೀಯಾ ಸೋ ಹಾಗಾಗಿ ನಿನ್ನ ಹತ್ರ ಕೇಳ್ತಿದ್ದೀನಿ ಬರೋದ್ರ ಬಗ್ಗೆ ಇನ್ನು ವಿಚಾರ ಮಾಡ್ತೀನಿ ನಾನು ಬಟ್ ಇನ್ನು ಯಾರಿಗೆ ಕೊಟ್ಟಿಲ್ಲ ನಾನು."
    },
    {
      "t": "25:50",
      "text": "ಫಸ್ಟ್ ಟೈಮ್ ಅಲ್ವಾ ಅಮೌಂಟ್ ಜಾಸ್ತಿ ಆಗುತ್ತೆ."
    },
    {
      "t": "25:56",
      "text": "ಬಾ ನೋಡೋಣಂತ."
    },
    {
      "t": "26:00",
      "text": "ನೀ ಕೋಆಪರೇಟ್ ಮಾಡು ಎಲ್ಲಾ ಬರೋಕೆ ಮುಂಚೆ ನಿನ್ನ ವಿಚಾರ ಮಾತಾಡಬೇಕು ಅಲ್ವಾ ಅಮೌಂಟ್ ಎಷ್ಟು ಅಂತ."
    },
    {
      "t": "26:06",
      "text": "ಅದೇ ಹೇಳೋಣ ತಡಿ ಫಸ್ಟ್ ಒಂದು ಸತಿ ವಿಡಿಯೋ ಕಾಲ್ ವಾಟ್ಸಪ್ ನಲ್ಲಿ ಬಾ ಮಾತಾಡೋಣ ವಿಡಿಯೋ ಕಾಲ್ ಇಬ್ಬರಿಗೂ ಆಮೇಲೆ ಹೊಂದಿಕೆ ಹತ್ತು ಚಲೋ ಅನ್ಸಿದ್ರೆ ಮುಂದೆ ಹೇಳೋಕೆ ಬರುತ್ತದೆ."
    },
    {
      "t": "26:15",
      "text": "ಹೊಂದಿಕೆ ಆಗಿರುತ್ತದೆ ರಿ ಯಾಕಂದ್ರೆ ನನಗೆ ಕಶ್ಫುಗಳು ಜಾಸ್ತಿ ಇದ್ದಾರೆ."
    },
    {
      "t": "26:21",
      "text": "ಹಂಗೆಲ್ಲ ಅನ್ನೋಕೆ ಹೋಗ್ಬೇಡ ನಾವು ಬಹಳ ಜನ ನೋಡಿವಿ."
    },
    {
      "t": "26:25",
      "text": "ಸೊ ನೋಡೋಣ ಇಬ್ಬರಿಗೂ ಆಯ್ತು ಅಂದ್ರೆ ಸರಿ ಹೋಯ್ತು ಅಂದ್ರೆ ನಾವು ಬಂದು ನೋಡೋಣ ಅಂತ ಇಲ್ಲ ಅಂದ್ರೆ ಬೇಡ."
    },
    {
      "t": "26:30",
      "text": "ಓಕೆ ಆಯ್ತು ಈ ಫೋನ್ ಇಂತ ಯಾಪ್ ಅಲ್ಲಿ ಸುಮಾರು ಜನ ಹುಡುಗಿಯರು ಎಕ್ಸ್ಪೋಸ್ ಮಾಡ್ತಾರೆ ಮಾಡಿದ್ದಾರಾ ನಿನಗೆ?"
    },
    {
      "t": "26:40",
      "text": "ಮಾಡಾರಲ್ಲ."
    },
    {
      "t": "26:42",
      "text": "ಮಾಡಾರಾ?"
    },
    {
      "t": "26:46",
      "text": "ಮಾಡಾರ ನೀನು ಯಾಕೆ ಮಾಡಲ್ಲ."
    },
    {
      "t": "26:48",
      "text": "ಅಂದ್ರೆ ಒನ್ ಮಿನಿಟ್ ನಾನು ಆವಾಗ್ಲೇ ನಿನಗೆ ಹೇಳಿಲ್ವಾ ಎಲ್ಲ ತೋರಿಸಬೇಕಾದ್ರೆ ಓನ್ಲಿ ನನ್ನ ಗಂಡನಿಗೆ ಅಂತ."
    },
    {
      "t": "26:54",
      "text": "ಮತ್ತೆ ಅದೆಲ್ಲ ಹೇಳಕತ್ತೀನಿ ನೀನು ಎಲ್ಲೆಲ್ಲ ಮಾತಾಡ್ತೀನಿ ನೀನು."
    },
    {
      "t": "26:59",
      "text": "ಎಲ್ಲೋ ಮಾತಾಡ್ತೀನಿ ಅಂದ್ರೆ ಇವಾಗ ನಾನು ಬರ್ತೀನಿ."
    },
    {
      "t": "27:03",
      "text": "ಮತ್ತೆ ಎಲ್ಲಾ ಹಂಗೆ ಗಂಡಗೆ ಅಂತೀವಿ ಮತ್ತೆ ಆಮೇಲೆ ಇದಕ್ಕೂ ಬರ್ತೀನಿ ಅಂತೀವಿ ಏನ್ ಅರ್ಥ ಆಗಲ್ವಾ ಅದು."
    },
    {
      "t": "27:09",
      "text": "ಹಂಗಂತ ಅಂದು ಬಂದು ಬಂದವರು ಫೋನ್ ಮಾಡಿದವರಿಗೆ ಎಲ್ಲಾ ತೋರಿಸ್ತಾ ಹೋಗೋಕೆ ಆಗುತ್ತೆ ಅಂಬರೀ ಶೋರ್."
    },
    {
      "t": "27:16",
      "text": "ಮತ್ತೆ ಅದಕ್ಕೇನು ಹೇಳಿದ್ನಲ್ಲ ವಾಟ್ಸಪ್ ಗೆ ಬಂದು ತೋರಿಸಲ್ಲ ಅಂದ್ರೆ ಇಲ್ಲ ತೋರಿಸಲ್ಲ ಅಲ್ಲಿ ತೋರಿಸು."
    },
    {
      "t": "27:21",
      "text": "ಬಟ್ ನೀನು ಮಾತಾಡೋದು ಏನೋ ಒಂತರ ಡಿಫರೆಂಟ್ ಆಗಿತ್ತಲ್ಲ ಅಟ್ರಾಕ್ಷನ್ ಇತ್ತು ಸೊ ಹಾಗಾಗಿ ಹೂ ಬರೋಣ ಅಂತ ಒಪ್ಕೊಂಡೆ ಬೇಡ ಅಂದ್ರೆ ಬೇಡ."
    },
    {
      "t": "27:30",
      "text": "ಅಲ್ಲ ಇಲ್ಲೇರು ತೋರಿಸು ಇಲ್ಲ ಅಲ್ಲಿಗಾದರೂ ತೋರಿಸು ಎಲ್ಲರೂ ಬಂದು ಎಲ್ಲೆಲ್ಲಿ ಇಲ್ಲಿ ತೋರಿಸೋಕೆ ಏನು ಪ್ರಾಬ್ಲಮ್ ಆಯ್ತು ನಿನಗೆ ಇಲ್ಲಿ."
    },
    {
      "t": "27:35",
      "text": "ಇಲ್ಲಿ ತೋರಿಸಿದ್ರೆ ಏನು ಮಜಾ ಉಳಿದು ಬರ್ತಿಯಲ್ಲ ಅಮೌಂಟ್ ಕಳಿಸಿಕೊಳ್ಳೋದು ಮುಂದಿನ ಕಾರ್ಯ ಮಾಡೋದು."
    },
    {
      "t": "27:44",
      "text": "ಅದು ಆಮೇಲೆ ನೋಡೋಣ ಅಂತ ಫಿಸಿಕಲ್ ಹೇಳಕತ್ತೀನಲ್ಲ ಆಮೇಲೆ ನೋಡೋದು."
    },
    {
      "t": "27:48",
      "text": "ಫಸ್ಟ್ ವಾಟ್ಸಪ್ ನಲ್ಲಿ ಇದರಾಗರ ಒಂದು ಸತಿ ಬಾ."
    },
    {
      "t": "27:52",
      "text": "ವರ್ಚುವಲ್ ಇದು ನೋಡೋಣ ವಿಡಿಯೋ ಕಾಲ್ ಆಮೇಲೆ ಓಕೆ ಅಂದ್ರೆ ಹಂಗೆ ಬಂದು ಹೇಳ್ತೀನಿ."
    },
    {
      "t": "27:56",
      "text": "ವಿಡಿಯೋ ಕಾಲ್ ಅಲ್ಲಿ ನೋಡ್ಬಿಟ್ಟು ಆಮೇಲೆ ಬೇಡ ಅಂತ ರಿಜೆಕ್ಟ್ ಮಾಡಿದ್ರೆ ಏನ್ ಮಾಡೋದು?"
    },
    {
      "t": "28:02",
      "text": "ವಿಡಿಯೋ ಕಾಲ್ ಮತ್ತೆ ಇಬ್ಬರಿಗೂ ಸೆಟ್ ಆಗ್ಬೇಕಲ್ಲ ನಾನೇ ಸುಮ್ನೆ ನಾನು ಕರೆ ನೀನು ಬರಬಾರದು ನಿನಗೂ ಟೈಮ್ ವೇಸ್ಟ್."
    },
    {
      "t": "28:09",
      "text": "ಬಟ್ ನನಗೂ ಅಷ್ಟು ಅನಿಸ್ತಂಗಿಲ್ಲ ನೀನು ದಪ್ಪ ಇದೆ ಅಲ್ಲಿ ಸ್ವಲ್ಪ."
    },
    {
      "t": "28:13",
      "text": "ಹೌದು ನಾನು ದಪ್ಪ ಇದ್ದೀನಿ ಅದಕ್ಕೆ ಹೇಳಕತ್ತೀನಿ ಒಂದು ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡೋಣ."
    },
    {
      "t": "28:17",
      "text": "ನಿನಗೇನು ಡೌಟ್ ಅದಾವ ನೀನು ನೋಡು ನಿನಗೆ ಓಕೆ ಇದ್ರೆ ನಾವು ಬಂದು ನೋಡೋಣ."
    },
    {
      "t": "28:20",
      "text": "ಓಕೆ ಓಕೆ ಮತ್ತೆ ನೀನು ಹೆಂಗೆ ವಿಡಿಯೋ ಕಾಲ್ ಬರ್ತೀಯ ಇಲ್ಲ."
    },
    {
      "t": "28:26",
      "text": "ನಾನು ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡಲಾ?"
    },
    {
      "t": "28:30",
      "text": "ವೇಟ್ ಮಾಡ್ತೀಯಾ ನಂಬರ್ ಸೇವ್ ಮಾಡ್ಕೊಂಡು ಹಾಯ್ ಅಂತ ಮೆಸೇಜ್ ಮಾಡ್ತೀನಿ."
    },
    {
      "t": "28:36",
      "text": "ಹ್ಮ್ ಮಾಡು."
    },
    {
      "t": "28:37",
      "text": "ಕಾಲ್ ಅಲ್ಲೇ ವೇಟ್ ಮಾಡು ಕಾಲ್ ಕಟ್ ಮಾಡಿದ್ಮೇಲೆ ನಾನು ಮಾಡೋದಿಲ್ಲ."
    },
    {
      "t": "28:43",
      "text": "ಮೆಸೇಜ್ ಮಾಡು ಮರೆತು ಮಾಡು."
    },
    {
      "t": "28:46",
      "text": "ಏನು?"
    },
    {
      "t": "28:48",
      "text": "ಆಯ್ತು ಮೆಸೇಜ್ ಮಾಡು."
    },
    {
      "t": "28:51",
      "text": "ನಾನು ವೇಟ್ ಮಾಡ್ತೀನಿ ಫೈವ್ ಮಿನಿಟ್ಸ್ ಬಂದು."
    },
    {
      "t": "28:54",
      "text": "ಫೈವ್ ಮಿನಿಟ್ಸ್."
    },
    {
      "t": "28:56",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "28:59",
      "text": "ಯಾಕೆ?"
    },
    {
      "t": "29:01",
      "text": "ಔಟ್ಸೈಡ್ ಹೋಗಿ ಬರ್ತೀನಿ."
    },
    {
      "t": "29:03",
      "text": "ನೀನು ಹೋಗಿ ಬಾರೋ ಮೆಸೇಜ್ ನಂಬರ್ ಕೊಟ್ಟೊಂದಲ್ಲ ಮೆಸೇಜ್ ಮಾಡಿ."
    },
    {
      "t": "29:07",
      "text": "ನಾನು ಮಾಡಲಿಲ್ಲ ಅಂದ್ರೆ ಏನ್ ಮಾಡ್ತೀಯಾ?"
    },
    {
      "t": "29:10",
      "text": "ಏನ್ ಮಾಡಕಾಗ್ತೈತಿ ಇಷ್ಟ ಇದ್ರೆ ಮಾಡ್ತೀನಿ ನಿನಗೆ ಬೇಡ ಅಂದ್ರೆ ನಾನೇ ಮಾಡ್ಲಿ."
    },
    {
      "t": "29:14",
      "text": "ನನಗೆ ಇಷ್ಟ ಇದಕ್ಕೆ ಮಾಡ್ತೀನಿ ನಂಗೆ ಊರಿಗೆ ವೇಟ್ ಮಾಡ್ತೀನಿ ಅಂದ್ಮೇಲೆ ಗೊತ್ತಾಗುತ್ತೆ ನನಗೆ ವೇಟ್ ಮಾಡೋದು ನಿನಗೆ ಏನಂತ ಅದರ ದುಡ್ಡಿನ ಸಲುವಾಗಿ ಎಕ್ಕತ್ತಾ ಅದರದ್ದು ಹೇಳಕತ್ತೀಯಾ."
    },
    {
      "t": "29:25",
      "text": "ಯಾವ ದುಡ್ಡು?"
    },
    {
      "t": "29:27",
      "text": "ಅಲ್ಲ ವೇಟ್ ಎದಕ್ಕೆ ಇದ್ರಾಗ ಯಾಕೆ ವೇಟ್ ಮಾಡ್ಲಿ ನಾನು ಕಟ್ ಮಾಡ್ತೀನಿ ಇದರಾಗ."
    },
    {
      "t": "29:31",
      "text": "ಯಾರ ಕಟ್ ಮಾಡ್ತಿ."
    },
    {
      "t": "29:34",
      "text": "ಹ್ಮ್ ಮತ್ತೆ ಯಾಕೆ ಸುಮ್ನೆ ಐದು ನಿಮಿಷ ಎಲ್ಲ."
    },
    {
      "t": "29:37",
      "text": "ಐದು ನಿಮಿಷ ಟು ಮಿನಿಟ್ಸ್ ವೇಟ್ ಮಾಡಲ್ವಾ ನೀನು ಇಷ್ಟು ತನಕ ಮಾತಾಡಿದ್ದೀಯಾ ಅಂತ ನನಗೆ ಆಲ್ರೆಡಿ ರಸ್ಟ್ ಬಂದಿದೆ."
    },
    {
      "t": "29:45",
      "text": "ಏನು ಏನು ಎಲ್ಲಿಗೆ ಹೋಗ್ಬೇಕು ನೀನು ಈಗ."
    },
    {
      "t": "29:48",
      "text": "ಔಟ್ಸೈಡ್ ಅಂದ್ರೆ ಇನ್ನೆದಕ್ಕೆ ಹೋಗ್ತಾರೆ ವಾಶ್ರೂಮ್ಗೆ ಹೋಗಿ ಬರ್ತಾರೆ."
    },
    {
      "t": "29:52",
      "text": "ಹುಚ್ಚಿಯಾಗಿ ಹೋಗಬೇಕಾ."
    },
    {
      "t": "29:55",
      "text": "ಅದು ರೆಸ್ಟ್ ರೂಮ್."
    },
    {
      "t": "29:58",
      "text": "ಸರಿ ಆಯ್ತು ಹೋಗ್ ಬಾ ನೀನು."
    },
    {
      "t": "30:01",
      "text": "ಓಕೆ."
    },
    {
      "t": "30:03",
      "text": "ನಿನ್ನ ಹೆಸರು ಏನು ಅಂದ್ರಲ್ಲ ಧನರಾಜ್."
    },
    {
      "t": "30:07",
      "text": "ಧನಂಜಯ್."
