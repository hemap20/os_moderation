      "t": "08:07",
      "text": "ನೀನೇನ್ ಮಾಡ್ತೀಯಾ ಹೇಳು?"
    },
    {
      "t": "08:09",
      "text": "ಕಿಸ್ ಕೊಡ್ಲಾ?"
    },
    {
      "t": "08:11",
      "text": "ಕೊಡು ಮತ್ತೆ."
    },
    {
      "t": "08:18",
      "text": "ಹೂ?"
    },
    {
      "t": "08:23",
      "text": "ಹಲೋ."
    },
    {
      "t": "08:25",
      "text": "ಹಲೋ."
    },
    {
      "t": "08:26",
      "text": "ಹೂ?"
    },
    {
      "t": "08:28",
      "text": "ಹಲೋ."
    },
    {
      "t": "08:30",
      "text": "ನಂದು ಟೇಸ್ಟ್ ಮಾಡ್ತೀಯಾ?"
    },
    {
      "t": "08:33",
      "text": "ತಗೋ ಮತ್ತೆ."
    },
    {
      "t": "08:35",
      "text": "ಎಷ್ಟಿದೆ ನಿಂದು ತಪ್ಪು?"
    },
    {
      "t": "08:38",
      "text": "ಸಿಕ್ಸು."
    },
    {
      "t": "08:42",
      "text": "ಟೆಸ್ಟ್ ಮಾಡು ಬೇಬಿ."
    },
    {
      "t": "08:48",
      "text": "ಟೆಸ್ಟ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "08:50",
      "text": "ಸೌಂಡ್ ಮಾಡು."
    },
    {
      "t": "08:58",
      "text": "ಮೆತ್ತಗೆ ಬೇಬಿ."
    },
    {
      "t": "09:10",
      "text": "ಮೆತ್ತಗೆ."
    },
    {
      "t": "09:12",
      "text": "ಏನ್ ಸಕ್ಕತ್ತಾಗಿದೆ ಅಂತ ಟೇಸ್ಟ್."
    },
    {
      "t": "09:15",
      "text": "ಹೂ ಬೇಬಿ ಮೆತ್ತಗೆ ಮಾಡು."
    },
    {
      "t": "09:19",
      "text": "ನಿನ್ನ ಗಂಟಲು ತನಕ ಹೋಗುತ್ತೆ."
    },
    {
      "t": "09:28",
      "text": "ಹೂ?"
    },
    {
      "t": "09:30",
      "text": "ಹಲೋ."
    },
    {
      "t": "09:34",
      "text": "ಏನ್ ಮಾಡ್ತಿದ್ದೀಯಾ?"
    },
    {
      "t": "09:38",
      "text": "ಸೌಂಡೇ ಬರ್ತಾ ಇಲ್ಲ."
    },
    {
      "t": "09:41",
      "text": "[inaudible]"
    },
    {
      "t": "09:46",
      "text": "ಹೂ?"
    },
    {
      "t": "09:48",
      "text": "ರಿಯಲ್ ಆಗಿದ್ರೆ ಚೆನ್ನಾಗಿರ್ತಿತ್ತು."
    },
    {
      "t": "09:51",
      "text": "ಹೂ ನಿನ್ನ ಗಂಟಲು ತನಕ ಹೋಗುತ್ತೆ ನೋಡು."
    },
    {
      "t": "09:56",
      "text": "ಹಾಕು ಮತ್ತೆ."
    },
    {
      "t": "09:57",
      "text": "ಹಂಗೆ ಹಾಕಿದೀನಲ್ಲ ಫುಲ್ ಬಾಯಲ್ಲಿ."
    },
    {
      "t": "10:04",
      "text": "ಹೂ."
    },
    {
      "t": "10:10",
      "text": "ಚೆನ್ನಾಗಿ ಅನಿಸ್ತಿದೆಯಾ?"
    },
    {
      "t": "10:14",
      "text": "ಹಾ ಬೇಬಿ ಮೆತ್ತಗೆ."
    },
    {
      "t": "10:28",
      "text": "ಮೆತ್ತಗೆ ಬೇಬಿ."
    },
    {
      "t": "10:29",
      "text": "ಹಾಕ್ತಿದಿಯಾ?"
    },
    {
      "t": "10:32",
      "text": "ಹಾ ಮೆತ್ತಗೆ."
    },
    {
      "t": "10:37",
      "text": "ಚೀಸ್."
    },
    {
      "t": "10:39",
      "text": "ಅಪ್ಪ."
    },
    {
      "t": "10:41",
      "text": "ಹಾ ಬೇಬಿ."
    },
    {
      "t": "10:48",
      "text": "ಹೀರೋ."
    },
    {
      "t": "10:50",
      "text": "ನಾನು ನಿನ್ನ ಬೂಪ್ಸ್ ನ ಪ್ರೆಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "10:55",
      "text": "ಹೂ?"
    },
    {
      "t": "10:57",
      "text": "ಮಾಡು."
    },
    {
      "t": "10:59",
      "text": "ಮಾಡ್ತಾ ಇದ್ದೀನಿ ಎರಡು ಬೂಪ್ಸ್ ನ ಇಟ್ಕೊಂಡು ಗಟ್ಟಿಯಾಗಿ."
    },
    {
      "t": "11:08",
      "text": "ನಿನ್ನ ನಿನ್ನ ನೀನು ಹೋಗ್ ಹತ್ರ ಎಲ್ಲಾ ಕಿಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "11:15",
      "text": "ಮೆತ್ತಗೆ ನಿನ್ನ ಸೀರೆ ಮೆತ್ತಗೆ ನಿನ್ನ ಸೀರೆ ಬಿಚ್ಚಿ."
    },
    {
      "t": "11:21",
      "text": "ನಿನ್ನ ಕಾಲ ಹತ್ರ ಇಂದ ಎಲ್ಲಾ ಕಿಸ್ ಮಾಡ್ಕೊಂಡು ಬರ್ತೀನಿ."
    },
    {
      "t": "11:25",
      "text": "ನಿನ್ನ ತೊಡೆ ಹತ್ರ ಎಲ್ಲಾ ಕಿಸ್ ಮಾಡ್ತೀನಿ."
    },
    {
      "t": "11:34",
      "text": "ಹಲೋ."
    },
    {
      "t": "11:36",
      "text": "ಹೇಳು."
    },
    {
      "t": "11:37",
      "text": "ನಿನ್ನ ತೊಡೆ ಹತ್ರ ಎಲ್ಲಾ ಕಿಸ್ ಮಾಡ್ತೀನಿ ಅಂದೆ."
    },
    {
      "t": "11:42",
      "text": "ಹೂ."
    },
    {
      "t": "11:43",
      "text": "ಸಕ್ಕತ್ತಾಗಿದೆ ಕಣೆ."
    },
    {
      "t": "11:46",
      "text": "ಇಷ್ಟ ಆಯ್ತಾ?"
    },
    {
      "t": "11:49",
      "text": "ಹೂ."
    },
    {
      "t": "11:51",
      "text": "ಎಸ್."
    },
    {
      "t": "11:53",
      "text": "ನಿನ್ನ ಪ್ಯಾಂಟಿ ಮೇಲ ಲ್ಲ ಕಿಸ್ ಮಾಡ್ತೀನಿ."
    },
    {
      "t": "11:58",
      "text": "ಮೆತ್ತಗೆ ನಿನ್ನ ಪ್ಯಾಂಟಿ ಬಿಚ್ಚಿ."
    },
    {
      "t": "12:02",
      "text": "ನಿನ್ನ ಎರಡು ಕಾಲು ನಾನು ಭುಜದ ಮೇಲೆ ಹಾಕೊಂಡು."
    },
    {
      "t": "12:07",
      "text": "ಓ ಮೈ ಗಾಡ್."
    },
    {
      "t": "12:09",
      "text": "ಮೆತ್ತಗೆ ಪುಶ್ ಮಾಡ್ಲಿ ಒಳಗಡೆ?"
