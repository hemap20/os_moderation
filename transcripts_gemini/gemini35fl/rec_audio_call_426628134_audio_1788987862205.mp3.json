    {
      "t": "12:14",
      "text": "ಏನ್."
    },
    {
      "t": "12:15",
      "text": "ನಂದು."
    },
    {
      "t": "12:18",
      "text": "ಎಸ್."
    },
    {
      "t": "12:21",
      "text": "ಓ ಬೇಬಿ ಸಲೆವ ಹಾಕು."
    },
    {
      "t": "12:26",
      "text": "ಆಮೇಲೆ ಜೀಪ್ ಹಾಕೊಂಡು ಆಮೇಲೆ ಜೀಪ್."
    },
    {
      "t": "12:29",
      "text": "ಆಮೇಲೆ ಮಾಡ್ತೀನಿ ಇವಾಗ ಡೈರೆಕ್ಟ್."
    },
    {
      "t": "12:31",
      "text": "ಹಾಕು."
    },
    {
      "t": "12:33",
      "text": "ಸಲೆವ ಹಾಕು."
    },
    {
      "t": "12:39",
      "text": "ಹಾ ಬೇಬಿ."
    },
    {
      "t": "12:43",
      "text": "ಮೆತ್ತಗೆ ಹಾಕ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "12:48",
      "text": "ಅಪ್ಪ."
    },
    {
      "t": "12:49",
      "text": "ಎಸ್."
    },
    {
      "t": "12:51",
      "text": "ಎಷ್ಟು ಟೈಟ್ ಇದೆ."
    },
    {
      "t": "12:54",
      "text": "ಏನ್ ಬೇಬಿ?"
    },
    {
      "t": "12:55",
      "text": "ಅಪ್ಪಾ."
    },
    {
      "t": "12:58",
      "text": "ಎಸ್."
    },
    {
      "t": "13:00",
      "text": "ಓ ಬೇಬಿ."
    },
    {
      "t": "13:03",
      "text": "ನಿತಾನಕ ಹಾಕು."
    },
    {
      "t": "13:05",
      "text": "ನಿಧಾನಕ್ಕೆ ಹಾಕು."
    },
    {
      "t": "13:10",
      "text": "ಬೇಬಿ ಹೋಗ್ತಾನೆ ಇಲ್ಲ."
    },
    {
      "t": "13:16",
      "text": "ಅರ್ಧ ಆಯ್ತು ಬೇಬಿ."
