    {
      "t": "13:25",
      "text": "ಅಪ್ಪ."
    },
    {
      "t": "13:27",
      "text": "ಅಪ್ಪ."
    },
    {
      "t": "13:29",
      "text": "ಸಲೆವ ಆಚೆ."
    },
    {
      "t": "13:33",
      "text": "ಹಾ."
    },
    {
      "t": "13:34",
      "text": "ತಳ್ತಾ ಇದ್ದೀನಿ ಮೆತ್ತಗೆ."
    },
    {
      "t": "13:36",
      "text": "ಆಯ್ತಾ?"
    },
    {
      "t": "13:39",
      "text": "ಬೇಬಿ ಫುಲ್ ಹೋಯ್ತು."
    },
    {
      "t": "13:41",
      "text": "ಅಪ್ಪ."
    },
    {
      "t": "13:43",
      "text": "ನಿನ್ ಚೀಸ್ ಮಾಡ್ತಾ ಇಂಜೆಕ್ಟ್ ಆಗ್ತಿದೆ."
    },
    {
      "t": "13:48",
      "text": "ಆಹ್ ಸಕ್ಕತ್ತಾಗಿದೆ ಬೇಬಿ ಫುಲ್ ಟೈಟ್ ಆಗಿ."
    },
    {
      "t": "13:54",
      "text": "ಸಕ್ಕತ್ತಾಗಿದೆ ಬೇಬಿ."
    },
    {
      "t": "13:56",
      "text": "ಮೆತ್ತಗೆ ತೆಗೆದು ಮತ್ತೆ ಹಾಕ್ತೀನಿ ಒಳಗಡೆ."
    },
    {
      "t": "14:03",
      "text": "ಸಕ್ಕತ್ತಾಗಿದೆ ಕಣೆ."
    },
    {
      "t": "14:06",
      "text": "ಹಾಕ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "14:10",
      "text": "ಮಾಡ್ತಾ ಇದ್ದೀನಿ ಬೇಬಿ."
    },
    {
      "t": "14:12",
      "text": "ಎಸ್."
    },
    {
      "t": "14:13",
      "text": "ಹಾ ಬೇಬಿ ಕಮಾನ್."
    },
    {
      "t": "14:16",
      "text": "ಎಸ್ ಎಸ್ ಎಸ್."
    },
    {
      "t": "14:17",
      "text": "ಎಸ್ ಬೇಬಿ."
    },
    {
      "t": "14:19",
      "text": "ಅಪ್ಪಪ್ಪಪ್ಪ."
    },
    {
      "t": "14:21",
      "text": "ಏನ್ ಸಕ್ಕತ್ತಾಗಿದೆ ಬೇಬಿ."
    },
    {
      "t": "14:24",
      "text": "ಮಾಡ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "14:28",
      "text": "ಎಸ್ ಎಸ್ ಎಸ್ ಎಸ್."
    },
    {
      "t": "14:29",
      "text": "ಎಸ್ ಬೇಬಿ ಐ ಆಮ್ ಡೂಯಿಂಗ್ ಇಟ್."
    },
    {
      "t": "14:32",
      "text": "ಕ್ರೇಜಿ."
    },
    {
      "t": "14:34",
      "text": "ಎಸ್ ಬೇಬಿ."
    },
    {
      "t": "14:38",
      "text": "ಐ ಆಮ್ ಡೂಯಿಂಗ್ ಇಟ್."
    },
    {
      "t": "14:41",
      "text": "ಕ್ರೇಜಿ ಬೇಬಿ."
    },
    {
      "t": "14:44",
      "text": "ಹಾಕು."
    },
    {
      "t": "14:46",
      "text": "ತುಂಬಾ ಸೆಕ್ಸಿ ಬೇಬಿ."
    },
    {
      "t": "14:48",
      "text": "ಎಸ್."
    },
    {
      "t": "14:49",
      "text": "ಐ ಆಮ್ ಮೀಟಿಂಗ್ ಯು ಎಸ್."
