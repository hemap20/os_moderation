    {
      "t": "00:06",
      "text": "ಹಾಯ್"
    },
    {
      "t": "00:08",
      "text": "ಹೆಸರೇನು?"
    },
    {
      "t": "00:09",
      "text": "ಮೈಸೂರು?"
    },
    {
      "t": "00:12",
      "text": "ಎವ್ರೆಂಡಾ ಯೂಸ್ ಮಾಡ್ತಿದ್ದೀರಾ?"
    },
    {
      "t": "00:15",
      "text": "ಹಾ?"
    },
    {
      "t": "00:16",
      "text": "ಎವ್ರೆಂಡಾ ಯೂಸ್ ಮಾಡ್ತಿದ್ದೀರಾ?"
    },
    {
      "t": "00:20",
      "text": "ಈಗ"
    },
    {
      "t": "00:24",
      "text": "ಏನ್ ಪರ್ಪಸ್ ಯೂಸ್ ಮಾಡ್ತೀರಾ?"
    },
    {
      "t": "00:27",
      "text": "ಸುಮ್ನೆ"
    },
    {
      "t": "00:30",
      "text": "ಗರ್ಲ್ಫ್ರೆಂಡ್ ಇದ್ದಾರಾ?"
    },
    {
      "t": "00:33",
      "text": "ಯಾರು ಇಲ್ಲ"
    },
    {
      "t": "00:36",
      "text": "ಊಟ ಮಾಡ್ತಿದ್ದೀರಾ?"
    },
    {
      "t": "00:38",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "00:41",
      "text": "ನಿಮ್ದು?"
    },
    {
      "t": "00:43",
      "text": "ಆಯ್ತು"
    },
    {
      "t": "00:44",
      "text": "ನಿಮ್ದು ಸಿಂಗಲ್ ಆ?"
    },
    {
      "t": "00:46",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "00:49",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:51",
      "text": "ಬೇರೆ ಆಡ್ಸ್ ಜೊತೆನು ಮಾತಾಡೆ ಇಲ್ವಾ ನೀವು ಹ್ಯಾಪಿಲಿ"
    },
    {
      "t": "00:54",
      "text": "ಇಲ್ಲ ಇದೆ ಫ್ರೆಶ್ ಮಾಡಿದ್ದು ಈಗ"
    },
    {
      "t": "00:58",
      "text": "ಓಕೆ"
    },
    {
      "t": "01:02",
      "text": "ಏನ್ ಪರ್ಪಸ್ ಕೇಳಿ ನೀವು ಯೂಸ್ ಮಾಡ್ತಿರೋದು?"
    },
    {
      "t": "01:04",
      "text": "ಸುಮ್ನೆ ಫೇಸ್ಬುಕ್ ಅಲ್ಲಿ ಬದಿತಲ್ಲ ಅಂದ್ಬಿಟ್ಟು ಮಾಡ್ದೆ ಯಾವತರ ಏನು ಅಂತ ನೋಡೋಣ ಅಂತ"
    },
    {
      "t": "01:09",
      "text": "ಓಕೆ ಹ್ಯಾಪಿಲಿ ಫಿಸಿಕಲ್ ರಿಲೇಷನ್ಶಿಪ್ ಇರ್ತಾರೆ ಫ್ರೆಂಡ್ಸ್ ಇರ್ತಾರೆ"
    },
    {
      "t": "01:14",
      "text": "ಸೊ ಮೇಟ್ ಟು ಮಾಡ್ತಾರೆ ಆ ತರ"
    },
    {
      "t": "01:16",
      "text": "ಹಾ ಹಾ ಹಾ"
    },
    {
      "t": "01:21",
      "text": "ಫ್ರೆಂಡ್ ಆಯ್ತೀರಾ?"
    },
    {
      "t": "01:24",
      "text": "ಫ್ರೆಂಡ್?"
    },
    {
      "t": "01:27",
      "text": "ಯಾ ಐ ಆಮ್ ಗುಡ್ ಫ್ರೆಂಡ್"
    },
    {
      "t": "01:31",
      "text": "ಊಟ"
    },
    {
      "t": "01:33",
      "text": "ಊಟ ಆಯ್ತು ಯಾಕಿನ್ನು ಲೇಟ್ ಆಗಿ ಮಾಡ್ತಿದ್ದೀರಾ ನೀವು?"
    },
    {
      "t": "01:37",
      "text": "ಹಾ ಲೇಟ್ ಆಯ್ತು ಇವತ್ತು"
    },
    {
      "t": "01:40",
      "text": "ಓಕೆ ಏನ್ ತಿಂತಿದ್ದೀರಾ ಸ್ಪೆಷಲ್ ಆಗಿ?"
    },
    {
      "t": "01:43",
      "text": "ಅಯ್ಯೋ ಏನೆಲ್ಲ ಬರಿ ರೈಸ್ ಮೊಸರು"
    },
    {
      "t": "01:48",
      "text": "ಬಿರಿಯಾನಿ ತಿನ್ನೋ ತಾನೇ ಸಂಡೆ ಇವತ್ತು?"
    },
    {
      "t": "01:51",
      "text": "ಅಯ್ಯೋ ಮನೇಲಿ ಯಾರು ಇಲ್ಲ"
    },
    {
      "t": "01:53",
      "text": "ಎಲ್ಲಿ ಹೋಗಿದ್ದಾರೆ?"
    },
    {
      "t": "01:55",
      "text": "ಊರು"
    },
    {
      "t": "01:58",
      "text": "ಊರು ಊರು"
    },
    {
      "t": "02:00",
      "text": "ಓಕೆ"
    },
    {
      "t": "02:03",
      "text": "ನಿಮ್ದು ಯಾವೂರು?"
    },
    {
      "t": "02:04",
      "text": "ಬೆಂಗಳೂರು"
    },
    {
      "t": "02:06",
      "text": "ವರ್ಕ್?"
    },
    {
      "t": "02:09",
      "text": "ವರ್ಕ್ ಐ ವೋ ಸೈಲ್ ಅಲ್ಲಿ ವರ್ಕ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "02:13",
      "text": "ಮದುವೆ ಆಗಿಲ್ಲ?"
    },
    {
      "t": "02:15",
      "text": "ಇನ್ನು ಇಲ್ಲ"
    },
    {
      "t": "02:17",
      "text": "ಆಯ್ತೀರಾ?"
    },
    {
      "t": "02:22",
      "text": "ಈಗ್ಲೇ ಬೇಡಪ್ಪ ಮದುವೆ ಎಲ್ಲಾ"
    },
    {
      "t": "02:26",
      "text": "ಯಾಕೆ ಈಗ ಚೆನ್ನಾಗೇ ಮಾತಾಡ್ತೀರಾ ಆಮೇಲೆ ಆಮೇಲೆ ಚೇಂಜ್ ಆಗ್ಬಿಡ್ತೀರಾ ಟೈಮ್ ಕೂಡ ಕೊಡಲ್ಲ ಅನ್ಸುತ್ತೆ"
    },
    {
      "t": "02:34",
      "text": "ಆತರ ಏನಿಲ್ಲ"
    },
    {
      "t": "02:37",
      "text": "ಹಂಗಂತ ಎಲ್ಲರೂ ಹೇಳ್ತಾರೆ ಫಿಲ್ ಹಂಗೆ ಮಾಡೋದು"
    },
    {
      "t": "02:41",
      "text": "ಚೆನ್ನಾಗಿದೆ"
    },
    {
      "t": "02:44",
      "text": "ಏನು ಹೋಯ್ತು ಹೋಯ್ತು ಬಿಸಿ ಆಯ್ತಾರೆ"
    },
    {
      "t": "02:50",
      "text": "ಸೊ ನಮಗೂ ಅಂತ ಟೈಮ್ ಕೊಡೋರ್ ಆಗಿರಬೇಕು ಬಟ್ ಒಳ್ಳೆ ಫ್ರೆಂಡ್ ಆಗಿರಬೇಕು"
    },
    {
      "t": "03:02",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "03:04",
      "text": "ಊಟ ಮಾಡಿ ಪಾಪ ನೀವು ಟೈಮ್ ಆಯ್ತು ಊಟ ಮಾಡ್ಬಿಟ್ಟು ತಾನೇ ಕಾಲ್ ಮಾಡಬೇಕು ನೀವು"
    },
    {
      "t": "03:10",
      "text": "ಸುಮ್ನೆ ಮಾಡ್ದೆ ನೋಡೋಣ ಅಂತ ಊಟ ಮಾಡ್ತಿದ್ದೆ ನಾನು"
    },
    {
      "t": "03:18",
      "text": "ಬನ್ನಿ ಊಟ ಮಾಡಿ"
    },
    {
      "t": "03:20",
      "text": "ಆಯ್ತು ನಂದು ಊಟ ಮಾಡಿ ಆಯ್ತು"
    },
    {
      "t": "03:25",
      "text": "ಚೆನ್ನಾಗಿ ಬಿರಿಯಾನಿ ಕಬಾಬ್ ತಿನ್ನೋದು ಬಿಟ್ಕೊಂಡು ಮಸ್ತಣ್ಣ ತಿಂತೀರಾ ಅಲ್ವಾ ನೀವು"
    },
    {
      "t": "03:29",
      "text": "ಅಯ್ಯೋ ನೆನ್ನೆ ಮೈಸೂರು ಬಂದಿದೆ ಮೈಸೂರಲ್ಲಿ ತಿನ್ಕೊಂಡು ಬಂದೆ ಅದಕ್ಕೆ"
    },
    {
      "t": "03:35",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "03:36",
      "text": "ಹ ಒಳ್ಳೆ ಬಿರಿಯಾನಿ ಕಬಾಬ್ ಎಲ್ಲಾ ಅದಕ್ಕೆ ಇವತ್ತು ತಿಂತಾ ಇಲ್ಲ"
    },
    {
      "t": "03:41",
      "text": "ನೀವು ಏನ್ ವರ್ಕ್ ಮಾಡಿದ್ದು?"
    },
    {
      "t": "03:44",
      "text": "ಟೈಲರಿಂಗ್"
    },
    {
      "t": "03:47",
      "text": "ಸ್ಟಿಚಿಂಗ್"
    },
    {
      "t": "03:50",
      "text": "ಓಕೆ ಕಾಲ್ ಕಟ್ ಆಗುತ್ತೆ ಈಗ"
    },
    {
      "t": "03:54",
      "text": "ಹೌದಾ"
    }
  ]
}