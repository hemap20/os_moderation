  "segments": [
    {
      "t": "00:00",
      "text": "ஹலோ"
    },
    {
      "t": "00:03",
      "text": "ஹலோ"
    },
    {
      "t": "00:05",
      "text": "ஹலோ"
    },
    {
      "t": "00:07",
      "text": "ஹாய், என்ன ஊரு உங்களுக்கு?"
    },
    {
      "t": "00:11",
      "text": "மயிலாடுதுறைங்க."
    },
    {
      "t": "00:15",
      "text": "ஆர்.சி.என்."
    },
    {
      "t": "00:19",
      "text": "மேரிடா?"
    },
    {
      "t": "00:21",
      "text": "மேரிட் இல்லீங்க."
    },
    {
      "t": "00:23",
      "text": "மேரிடா?"
    },
    {
      "t": "00:25",
      "text": "அன்மேரிடுங்க."
    },
    {
      "t": "00:27",
      "text": "நான் மேரிட்."
    },
    {
      "t": "00:30",
      "text": "நான் மேரிட்."
    },
    {
      "t": "00:32",
      "text": "சரிங்க."
    },
    {
      "t": "00:36",
      "text": "என் ஹவுஸ் வைஃப் ஆர் கியூ ஆர் என்னமா?"
    },
    {
      "t": "00:39",
      "text": "ஹவுஸ் வைஃப் ஆர் வொர்க்கிங்கா?"
    },
    {
      "t": "00:43",
      "text": "ஏன் என்ன பொறுமையா போயிட்டு இருக்கீங்க?"
    },
    {
      "t": "00:48",
      "text": "என்னங்க? நான் பேசுறது உங்களுக்கு லேட்டா கேட்குதுன்னு நினைக்கிறேன்."
    },
    {
      "t": "00:54",
      "text": "ம் ஆமா."
    },
    {
      "t": "00:57",
      "text": "அதான்"
    },
    {
      "t": "01:00",
      "text": "டபுள் டபுளா சொல்றீங்க."
    },
    {
      "t": "01:10",
      "text": "சொல்லுங்க."
    },
    {
      "t": "01:13",
      "text": "என்ன சொல்லணும்?"
    },
    {
      "t": "01:16",
      "text": "எது வேணாலும் சொல்லலாம்."
    },
    {
      "t": "01:19",
      "text": "என்ன வேணாலும் சொல்லலாமா?"
    },
    {
      "t": "01:21",
      "text": "ம்."
    },
    {
      "t": "01:25",
      "text": "உண்மையா? என்ன வேணாலும் சொல்லு."
    },
    {
      "t": "01:29",
      "text": "உண்மையா"
    },
    {
      "t": "01:31",
      "text": "எப்படி இருக்கீங்க?"
    },
    {
      "t": "01:42",
      "text": "ஹலோ."
    },
    {
      "t": "01:43",
      "text": "ஹலோ."
    },
    {
      "t": "01:44",
      "text": "ம் சொல்லுங்க."
    },
    {
      "t": "01:48",
      "text": "சுமாராதான் இருப்பேன்."
    },
    {
      "t": "01:55",
      "text": "ம்."
    },
    {
      "t": "01:58",
      "text": "அப்புறம் சுமாராதான் இருக்கேனே எப்படி சொல்றது?"
    },
    {
      "t": "02:02",
      "text": "எப்படி சொல்லணும் சொல்லிட்டு வாங்க."
    },
    {
      "t": "02:09",
      "text": "நான் சொல்லணுமா?"
    },
    {
      "t": "02:12",
      "text": "ஆமா."
    },
    {
      "t": "02:20",
      "text": "சரி நீங்க எப்படி பேசுவீங்க? இப்படி என்ன பேசுவீங்களா?"
    },
    {
      "t": "02:24",
      "text": "எப்படி வேணாலும் பேசுவேன்."
    },
    {
      "t": "02:28",
      "text": "ரொம்ப நாளா இருக்கீங்களா இந்த ஆப்ல?"
    },
    {
      "t": "02:30",
      "text": "ம்?"
    },
    {
      "t": "02:33",
      "text": "ரொம்ப நாளா இருக்கீங்களா இந்த ஆப்ல?"
    },
    {
      "t": "02:36",
      "text": "ம் ஆமா."
    },
    {
      "t": "02:42",
      "text": "நீங்க கடைசியா எப்போ செக் பண்ணீங்க?"
    },
    {
      "t": "02:48",
      "text": "கடைசியா"
    },
    {
      "t": "02:50",
      "text": "போன வாரத்துல."
    },
    {
      "t": "02:52",
      "text": "ஒரு வாரம் ஆயிடுச்சா?"
    },
    {
      "t": "02:54",
      "text": "ஆமா."
    },
    {
      "t": "02:56",
      "text": "ஏன் ஃபர்ஸ்ட் ஹஸ்பண்ட் இல்லையா?"
    },
    {
      "t": "02:59",
      "text": "ஹஸ்பண்ட் இல்லைங்க."
    },
    {
      "t": "03:04",
      "text": "வீக்லி ஒன் டைம் தானா?"
    },
    {
      "t": "03:07",
      "text": "ம் ம்."
    },
    {
      "t": "03:09",
      "text": "இயர்லி ஒன் டைம்."
    },
    {
      "t": "03:10",
      "text": "ம்."
    },
    {
      "t": "03:12",
      "text": "இயர்லி ஒன் டைம்மா?"
    },
    {
      "t": "03:14",
      "text": "ஏன்?"
    },
    {
      "t": "03:15",
      "text": "ஆமா."
    },
    {
      "t": "03:16",
      "text": "அப்பறம் பாருங்க அப்பறம்."
    },
    {
      "t": "03:24",
      "text": "எத்தனை வருஷமா ஒர்க் பண்றது எங்க?"
    },
    {
      "t": "03:28",
      "text": "ஒரு மூணு வருஷமா இருக்காரு."
    },
    {
      "t": "03:33",
      "text": "சரி வெளையாட்டு டைம்ல மூடு வந்தா என்ன பண்ணுவீங்க?"
    },
    {
      "t": "03:36",
      "text": "இந்த ஆப்ல வருவேன்."
    },
    {
      "t": "03:40",
      "text": "வந்து"
    },
    {
      "t": "03:42",
      "text": "பேசுவேன்."
    },
    {
      "t": "03:44",
      "text": "அப்படி இல்லைன்னா எனக்கு ஏர்காட்னா புடிச்சது வந்துச்சுன்னா"
    },
    {
      "t": "03:48",
      "text": "சும்மா"
    },
    {
      "t": "03:50",
      "text": "கீழ மட்டும் வாய் வைக்க சொல்லுவேன்."
    },
    {
      "t": "03:58",
      "text": "எப்படி நேர்ல வந்தா இல்ல போன்லயே தானா?"
    },
    {
      "t": "04:00",
      "text": "நேர்ல."
    },
    {
      "t": "04:02",
      "text": "உண்மையா?வா?"
    },
    {
      "t": "04:05",
      "text": "எனக்கு தெரிஞ்சு ஒரு பையன் இருக்கான், பண்ணி குடுப்பான்."
    },
    {
      "t": "04:13",
      "text": "எப்படி நக்குவீங்களா நல்லா நக்குவான்?"
    },
    {
      "t": "04:16",
      "text": "ம் ஆமா."
    },
    {
      "t": "04:17",
      "text": "நல்லா நக்கி தருவான்."
    },
    {
      "t": "04:27",
      "text": "நல்லா நக்குவானா?"
    },
    {
      "t": "04:29",
      "text": "ஆமா, நல்லா நக்குவான்."
    },
    {
      "t": "04:36",
      "text": "காதுல உள்ள விட்டு."
    },
    {
      "t": "04:40",
      "text": "அப்படி பண்ணலாம் போட்டு அடிச்சா சக்க சக்கன்னு சக்கட்டி எடுப்பான்."
    },
    {
      "t": "04:50",
      "text": "வீட்டு பக்கத்துலயே இருக்கறவன்னு."
    },
    {
      "t": "04:54",
      "text": "ஆமா."
    },
    {
      "t": "04:58",
      "text": "ஹஸ்பண்ட் இல்லாத தலைவன்?"
    },
    {
      "t": "05:01",
      "text": "ஆமா, இல்லாத அப்ப மட்டும் அவன்."
    },
    {
      "t": "05:08",
      "text": "எப்படி? ஃபர்ஸ்ட் வாட்டி எப்படி பண்ணுவாங்க?"
    },
    {
      "t": "05:13",
      "text": "எப்படி அப்ரோச் பண்ணலாம்?"
    },
    {
      "t": "05:15",
      "text": "அவன் எங்க வீட்டு மாடி, எங்க வீட்டு மாடி இல்ல,"
    },
    {
      "t": "05:19",
      "text": "நான் இருந்தேன். அவங்க வீட்டு மாடில அவன் இருந்தான். அப்ப பாப்போம்."
    },
    {
      "t": "05:25",
      "text": "மாடி வந்து பாத்தீங்கன்னா, அப்படி ஜம்ப் பண்ணி வரமாறித்தான் இருக்கும்."
    },
    {
      "t": "05:32",
      "text": "ரொம்ப டிஸ்டன்ஸ்லாம் இல்ல."
    },
    {
      "t": "05:38",
      "text": "அப்போ நைட்ல வரும்போது,"
    },
    {
      "t": "05:41",
      "text": "எங்க வீட்டு தட்டுன்னு நான் பேசிருந்தேன். போன் பேசும்போது, மாடியில போனேன்."
    },
    {
      "t": "04:06",
      "text": "அப்போ அவன் பேசிட்டு இருந்தான்."
    },
    {
      "t": "05:51",
      "text": "நான் எங்க வீட்டுக்காரர் கிட்ட கொஞ்சம் அதுவா பேசிட்டு இருந்தேன்."
    },
    {
      "t": "05:56",
      "text": "அவன் இருக்குறத நான் கவனிக்கல."
    },
    {
      "t": "06:01",
      "text": "திடீர்னு அவன் அதெல்லாம் பேசிட்டு இருக்கும்போது திடீர்னு எல்லாம்,"
    },
    {
      "t": "06:09",
      "text": "அப்போ என்னாச்சு?"
    },
    {
      "t": "06:12",
      "text": "அவன் வந்து ஃபர்ஸ்ட் எப்படி உங்ககிட்ட கேட்டானா?"
    },
    {
      "t": "06:15",
      "text": "அவன் கேட்கல."
    },
    {
      "t": "06:19",
      "text": "நான்தான் கொஞ்சம் முதல்ல எல்லாம் காமிச்சு கொடுத்தேன்."
    },
    {
      "t": "06:25",
      "text": "அவன் நல்லா பார்ப்பான்."
    },
    {
      "t": "06:34",
      "text": "சும்மி நல் இருக்கும்."
    },
    {
      "t": "06:38",
      "text": "புரியல."
    },
    {
      "t": "06:39",
      "text": "சும்மி நல்லா இருக்கும். நான் பார்த்துட்டே இருப்பேன்."
    },
    {
      "t": "06:44",
      "text": "அப்ப என்ன கூப்பிட்டு கேட்டான். ஏன் என்ன அப்படி பாக்குற? அப்படின்னு."
    },
    {
      "t": "06:49",
      "text": "பாக்கணும் போல இருக்கு. இந்த மாதிரி பண்ணனும் அப்படின்னு நான் கேட்டேன்."
    },
    {
      "t": "06:59",
      "text": "மாடி மேலேயே வச்சு,"
    },
    {
      "t": "07:02",
      "text": "நைட் டைம் தான்."
    },
    {
      "t": "07:07",
      "text": "மாலைக்கிள்."
    },
    {
      "t": "07:11",
      "text": "நான் சாரி கட்டி இருந்தேன்."
    },
    {
      "t": "07:13",
      "text": "அங்கிருந்து இப்படி வந்து"
    },
    {
      "t": "07:17",
      "text": "நான் நின்னதுமே அவன் அப்படியே கீழ என் காலை விரிச்சுட்டு நக்கினான்."
    },
    {
      "t": "07:32",
      "text": "என்ஜாய் பண்றீங்க போல."
    },
    {
      "t": "07:38",
      "text": "ம் ம்."
    },
    {
      "t": "07:44",
      "text": "புரியல."
    },
    {
      "t": "07:47",
      "text": "ஆமாடா."
    },
    {
      "t": "07:50",
      "text": "நீ இது பண்ணது இல்லையா?"
    },
    {
      "t": "07:54",
      "text": "அப்படிலாம் பண்ணுவேன்."
    },
    {
      "t": "07:56",
      "text": "சான்ஸ் கொடுத்தா நானும் பண்ணுவேன்."
    },
    {
      "t": "08:08",
      "text": "நீங்க போதும் போதும்னு சொல்ற வரைக்கும் பண்ணலாம்."
    },
    {
      "t": "08:11",
      "text": "போதும்னு சொல்ல மாட்டேங்க."
    },
    {
      "t": "08:16",
      "text": "எனக்கு எடுக்கவே மாட்டேன்."
    },
    {
      "t": "08:19",
      "text": "எனக்கு ஊத்துனே இருக்கணும்."
    },
    {
      "t": "08:24",
      "text": "என் கூதி கிழிஞ்சாலும்."
    },
    {
      "t": "08:26",
      "text": "உட்காரணும்."
    },
    {
      "t": "08:31",
      "text": "உறிஞ்சுட்டே இருக்கணும்."
    },
    {
      "t": "08:33",
      "text": "ஆமா."
    },
    {
      "t": "08:44",
      "text": "எப்படி எல்லாம் உங்கள வொர்க் பண்ணனும்?"
    },
    {
      "t": "08:49",
      "text": "ம்?"
    },
    {
      "t": "08:50",
      "text": "எப்படி எல்லாம் உங்கள வொர்க் பண்ணனும்?"
    },
    {
      "t": "08:52",
      "text": "நீ ஊக்குறதுலயே எப்படி உத்தாலும் வந்து ரொட்டேட் பண்ணனும்."
    },
    {
      "t": "08:57",
      "text": "தூக்கி வச்சு அடிக்கணும்."
    },
    {
      "t": "09:00",
      "text": "பேக் ஷாட் பண்ணனும்."
    },
    {
      "t": "09:05",
      "text": "ரெண்டு காலை மடிச்சு மேல தூக்கி சுன்னிய எடுத்து குத்தி."
    },
    {
      "t": "09:17",
      "text": "நல்லா இருக்கும்."
    },
    {
      "t": "09:18",
      "text": "உங்க வெறி."
    },
    {
      "t": "09:19",
      "text": "ரொம்ப வெறிச்சு இருக்கீங்க போல."
    },
    {
      "t": "09:21",
      "text": "ஆமா."
    },
    {
      "t": "09:26",
      "text": "எப்படி பண்ண சொல்ற?"
    },
    {
      "t": "09:33",
      "text": "உங்க மேல ரெண்டையும் காச வச்சு நல்லா பால் குடிக்கணும்."
    },
    {
      "t": "09:37",
      "text": "அப்படியே சப்பு சப்புன்னு பால் குடிக்கணும்."
    },
    {
      "t": "09:42",
      "text": "எனக்கு 38 சைஸ்."
    },
    {
      "t": "09:47",
      "text": "புரியல, 38ஆ?"
    },
    {
      "t": "09:49",
      "text": "ம்."
    },
    {
      "t": "09:50",
      "text": "நல்ல சைஸ்டா, அப்ப நல்ல பால் குடிக்கலாம்."
    },
    {
      "t": "09:53",
      "text": "வாயில பத்தாது."
    },
    {
      "t": "09:55",
      "text": "புரியல, வாய் பத்தாது."
    },
    {
      "t": "10:00",
      "text": "வாய் பத்தலன்னா என்ன?"
    },
    {
      "t": "10:04",
      "text": "முடிஞ்ச வரைக்கும் உள்ள சொல்ல வேண்டியது."
    },
    {
      "t": "10:10",
      "text": "நல்லா கசக்கி கசக்கி பால் குடிச்சு,"
    },
    {
      "t": "10:16",
      "text": "அப்படியே பொறுமையா கீழ வந்து"
    },
    {
      "t": "10:20",
      "text": "வாய் வச்சு"
    },
    {
      "t": "10:23",
      "text": "நல்லா நக்கம்."
    },
    {
      "t": "10:25",
      "text": "நசக்கி எடுக்கணும்."
    },
    {
      "t": "10:33",
      "text": "ஓட்டத்துள்ள."
    },
    {
      "t": "10:36",
      "text": "என்னது?"
    },
    {
      "t": "10:37",
      "text": "வாய் சூப்பரா இருக்கு."
    },
    {
      "t": "10:40",
      "text": "என் வயசா?"
    },
    {
      "t": "10:43",
      "text": "வயசு."
    },
    {
      "t": "10:47",
      "text": "ஏட்டி."
    },
    {
      "t": "10:52",
      "text": "ஏன் இருக்கு வயசு?"
    },
    {
      "t": "10:56",
      "text": "சுன்னி எப்படி இருக்கும் யோசிக்கணும்."
    },
    {
      "t": "11:02",
      "text": "நீங்க பேசுற"
    },
    {
      "t": "11:08",
      "text": "என்னது?"
    },
    {
      "t": "11:09",
      "text": "வாடி புடின்னு சொல்லி கொடுத்துறேன் சுன்னி."
    },
    {
      "t": "11:14",
      "text": "சரிடி."
    },
    {
      "t": "11:16",
      "text": "பர்ஸ்ட்டிங்கம்மா பேசுறதுக்கு."
    },
    {
      "t": "11:20",
      "text": "நீ எப்பவாவது பேசவா?"
    },
    {
      "t": "11:23",
      "text": "எவ்வளவு ஆச்சு?"
    },
    {
      "t": "11:26",
      "text": "உன்னால எவ்வளவு முடியுமோ அவ்வளவு."
    },
    {
      "t": "11:33",
      "text": "நால எவ்வளவு முடியுமோ அவ்வளவு."
    },
    {
      "t": "11:42",
      "text": "கூதி கிரிய கீழ இறக்கணுண்டி."
    },
    {
      "t": "11:45",
      "text": "ம்?"
    },
    {
      "t": "11:48",
      "text": "கூதி கீறி கீழ இறக்கணுண்டி."
    },
    {
      "t": "11:50",
      "text": "ஆ நான் விரிப்பேன்டா."
    },
    {
      "t": "11:55",
      "text": "என்னது?"
    },
    {
      "t": "11:57",
      "text": "நல்லா விரிச்சு காமிப்பேன்."
    },
    {
      "t": "12:00",
      "text": "நல்லா விரிச்சு காட்டுவீயா?"
    },
    {
      "t": "12:02",
      "text": "ஆமா."
    },
    {
      "t": "12:05",
      "text": "விரிச்சு விரிச்சு நான் ஓத்துட்டே இருக்கணும்."
    },
    {
      "t": "12:12",
      "text": "எனக்கு ஆனா இது மாதிரி எல்லாம் பேசினா மூட் ஆகுது கல்லி வந்து டக்குனு வெளிய வராது."
    },
    {
      "t": "12:18",
      "text": "கஞ்சியா?"
    },
    {
      "t": "12:22",
      "text": "உள்ள விட்டு செய்யணும்."
    },
    {
      "t": "12:26",
      "text": "செய்ய செய்யத்தான் அது வரும்."
    },
    {
      "t": "12:29",
      "text": "சொத்தலாம்."
    },
    {
      "t": "12:33",
      "text": "அப்ப நல்லா ஊர்."
    },
    {
      "t": "12:35",
      "text": "கூப்பிடுவா."
    },
    {
      "t": "12:37",
      "text": "எங்க இருக்குன்னு சொல்லு வந்து ஓட்டுன்னு சொல்லு."
    },
    {
      "t": "12:48",
      "text": "சொல்லுடி."
    },
    {
      "t": "12:51",
      "text": "எதாவது சொல்லு."
    },
    {
      "t": "12:54",
      "text": "நீ எங்க இருக்கன்னு சொல்லு வந்து ஒருத்தர் வரப்போறாங்க."
    },
    {
      "t": "12:59",
      "text": "நான்தானே சொன்னேனே சுன்னி."
    },
    {
      "t": "13:03",
      "text": "கிருஷ்ணகிரி."
    },
    {
      "t": "13:06",
      "text": "என்னது?"
    },
    {
      "t": "13:08",
      "text": "சொல்லு."
    },
    {
      "t": "13:09",
      "text": "கிருஷ்ணகிரி."
    },
    {
      "t": "13:13",
      "text": "கிருஷ்ணகிரியா?"
    },
    {
      "t": "13:15",
      "text": "ம்."
    },
    {
      "t": "13:16",
      "text": "கிருஷ்ணகிரியா வந்திருக்க வேண்டியது."
    },
    {
      "t": "13:18",
      "text": "ம்."
    },
    {
      "t": "13:28",
      "text": "அடுத்த வாட்டி வரும்போது வர வேண்டியதுதான்."
    },
    {
      "t": "13:31",
      "text": "எனக்கு."
    },
    {
      "t": "13:34",
      "text": "இது ஒன்னும் ஒத்த."
    },
    {
      "t": "13:41",
      "text": "சரிடி."
    },
    {
      "t": "13:43",
      "text": "சரிடா சுன்னி."
    },
    {
      "t": "13:48",
      "text": "ம் செய்ய ரெடி பண்ணு."
    },
    {
      "t": "13:51",
      "text": "பண்ணிய விரிக்கும் நல்லா ஓசத்துக்கு."
    },
    {
      "t": "13:56",
      "text": "நீ நல்லா விரிச்சு விரிச்சு நான் ஒன்னு ஓசிட்டு வச்சிருந்தேன்."
    },
    {
      "t": "14:01",
      "text": "நீ ஓக்குறது தவிர நான் புண்டிய நல்லா விரிப்பேன்."
    },
    {
      "t": "14:09",
      "text": "உன் ஊதி உத்துட்டே இருக்கேன் உத்திரு."
    },
    {
      "t": "14:14",
      "text": "அப்படியே உருச்சி நிமிஷமா எதையோ எடுத்து அப்படி சொருகணும்டா."
    },
    {
      "t": "14:20",
      "text": "எடுத்து எடுத்துதான் செய்யணும்."
    },
    {
      "t": "14:22",
      "text": "ஐயோ!"
    },
    {
      "t": "14:23",
      "text": "அப்படியே வேகமா,"
    },
    {
      "t": "14:25",
      "text": "லபக்குன்னு உள்ள விட்டு விட்டு எடுக்கணும்."
    },
    {
      "t": "14:27",
      "text": "ஐயோ!"
    },
    {
      "t": "14:28",
      "text": "செமையா சொன்ன."
    },
    {
      "t": "14:32",
      "text": "அந்த மாதிரி எடுத்துட்டு எடுத்துட்டு விடுவேன்."
    },
    {
      "t": "14:39",
      "text": "வேகமா குத்து குத்துன்னு குத்து வாங்க."
    },
    {
      "t": "14:45",
      "text": "கத்தியா குத்தணும்?"
    },
    {
      "t": "14:49",
      "text": "அப்படியே உன்ன குத்திக்கிட்டே உன் பருப்பு இருக்குல்ல"
    },
    {
      "t": "14:55",
      "text": "ம்."
    },
    {
      "t": "14:56",
      "text": "கீழ."
    },
    {
      "t": "14:57",
      "text": "அந்த விரல்ல வச்சு சீண்டி சீண்டிகிட்டே தேய்ச்சிக்கிட்டே நம்ம குத்த வேண்டியது."
    },
    {
      "t": "15:02",
      "text": "ஐயோ!"
    },
    {
      "t": "15:04",
      "text": "மாமா."
    },
    {
      "t": "15:06",
      "text": "நல்லா தேய்ச்சு தேய்ச்சிக்கிட்டு குத்து குத்துன்னு குத்துவோம்."
    },
    {
      "t": "15:13",
      "text": "அப்படியே நீ நலி நலிய குத்திக்கிட்டே."
    },
    {
      "t": "15:15",
      "text": "ம்."
    },
    {
      "t": "15:25",
      "text": "புண்டில இருந்து தண்ணி வருமே."
    },
    {
      "t": "15:30",
      "text": "ஆமா, தண்ணி வரும்டா."
    },
    {
      "t": "15:32",
      "text": "நக்கி."
    },
    {
      "t": "15:36",
      "text": "நக்கிட்டு அப்படியே ஊத்தணும்."
    },
    {
      "t": "15:40",
      "text": "நக்கிட்டு எடுத்துட்டு போகணும்."
    },
    {
      "t": "15:44",
      "text": "மூஞ்ச வழியா?"
    },
    {
      "t": "15:52",
      "text": "புரியல."
    },
    {
      "t": "15:59",
      "text": "நீ எந்த ஊர்ல உன்னா உனக்கு நக்கதான்."
    },
    {
      "t": "16:04",
      "text": "ம்."
    },
    {
      "t": "16:05",
      "text": "நல்லா ஊம."
    },
    {
      "t": "16:09",
      "text": "வாயில வச்சாலே மாட்டேன் சுன்னிய."
    },
    {
      "t": "16:13",
      "text": "நானும் விடவே மாட்டேன் ஒன்னு சொல்றேன்."
    },
    {
      "t": "16:18",
      "text": "ஒன் ஹவர்க்கு அப்படியே படுத்துகிட்டே"
    },
    {
      "t": "16:22",
      "text": "பூதியை நக்கிட்டே."
    },
    {
      "t": "16:24",
      "text": "ஐயோ!"
    },
    {
      "t": "16:28",
      "text": "எடுத்து கப்பிக்கிட்டே இருக்க வேண்டியதுதான்."
    },
    {
      "t": "16:35",
      "text": "இன்னும் கத்த கத்த நான் வாய வச்சு சப்பி சப்பி எடுப்பேன்."
    },
    {
      "t": "16:42",
      "text": "நல்லா இருக்கும்."
    },
    {
      "t": "16:46",
      "text": "நல்லா இருக்கும்டா."
    },
    {
      "t": "16:49",
      "text": "பேசும்போதே நல்லா இருக்கு."
    },
    {
      "t": "16:52",
      "text": "பண்ண இன்னும் நல்லா இருக்குமே."
    },
    {
      "t": "16:54",
      "text": "ஆமா."
    },
    {
      "t": "17:00",
      "text": "எப்ப பண்ணலாம்?"
    },
    {
      "t": "17:04",
      "text": "நிறைய எக்ஸ்ப்ளோர் பண்ணனும்."
    },
    {
      "t": "17:08",
      "text": "என்னலாம்? என்னலாம் பண்ணனும்?"
    },
    {
      "t": "17:18",
      "text": "நீ வாழ்நாள்ல நினைச்சு பார்க்க முடியாத மாதிரி செய்யணும்டி."
    },
    {
      "t": "17:29",
      "text": "ஒரு நாளைக்கு அஞ்சு ரவுண்டு ஆறு ரவுண்டு போகணும்."
    },
    {
      "t": "17:36",
      "text": "டயர்டு ஆயிடுவ."
    },
    {
      "t": "17:43",
      "text": "சும்மா சொல்லாத டயர்டு ஆயிடுவ."
    },
    {
      "t": "17:47",
      "text": "ஒரு வாட்டி உனக்கு வெளிய வந்தாலே டயர்டுதான்."
    },
    {
      "t": "18:00",
      "text": "ஹஸ்பண்ட் அதானே ஒரு நாளைக்கு எத்தனை வாட்டி பண்ணுவாரு?"
    },
    {
      "t": "18:05",
      "text": "மூணு."
    },
    {
      "t": "18:10",
      "text": "டெய்லி மூணு வாட்டியா?"
    },
    {
      "t": "18:22",
      "text": "என்ன?"
    },
    {
      "t": "18:27",
      "text": "கைய விட்டு நோன்றிய?"
    },
    {
      "t": "18:35",
      "text": "தேய்க்கிறியா?"
    },
    {
      "t": "18:41",
      "text": "தேய்க்கிறியா?"
    },
    {
      "t": "18:44",
      "text": "வேற என்ன பண்ற?"
    },
    {
      "t": "18:46",
      "text": "என்ன ஆசை?"
    },
    {
      "t": "18:52",
      "text": "சொல்லடி."
    },
    {
      "t": "18:54",
      "text": "என்ன பண்ற?"
    },
    {
      "t": "19:01",
      "text": "என்ன?"
    },
    {
      "t": "19:06",
      "text": "தப்பா?"
    },
    {
      "t": "19:10",
      "text": "புரியல."
    },
    {
      "t": "19:13",
      "text": "ஆமா."
    },
    {
      "t": "19:15",
      "text": "போதுமா?"
    },
    {
      "t": "19:19",
      "text": "எனக்கு பத்தாது."
    },
    {
      "t": "19:30",
      "text": "அப்புறம் எப்போ பத்தற அளவுக்கு எவ்வளவு வருதோ அப்போ அதுவரைக்கும் செய்ய வேண்டியதுதான்."
