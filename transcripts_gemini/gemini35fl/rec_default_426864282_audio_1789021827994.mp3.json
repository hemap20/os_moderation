  "segments": [
    {
      "t": "00:04",
      "text": "ಹೇய்"
    },
    {
      "t": "00:05",
      "text": "ಹಾಯ್"
    },
    {
      "t": "00:05",
      "text": "ಎಲ್ಲಿಂದ?"
    },
    {
      "t": "00:06",
      "text": "ಬೆಂಗಳೂರು"
    },
    {
      "t": "00:10",
      "text": "ನಾವು ಕೂಡ ಬೆಂಗಳೂರು."
    },
    {
      "t": "00:11",
      "text": "ಎಲ್ಲಿ ಬೆಂಗಳೂರು ಅಂದ್ರೆ?"
    },
    {
      "t": "00:15",
      "text": "ಜೆ.ಪಿ ನಗರ, ಜೆ.ಪಿ ನಗರ ನೀವು?"
    },
    {
      "t": "00:18",
      "text": "ನಾವು ಬನಶಂಕರಿ."
    },
    {
      "t": "00:20",
      "text": "ಏನ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ?"
    },
    {
      "t": "00:23",
      "text": "ಕೈಯಲ್ಲಿ ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ."
    },
    {
      "t": "00:27",
      "text": "ಕರೆಕ್ಟ್ ಆಗಿ ಕಂಡಿದ್ದೀರಾ ಬಿಡಿ."
    },
    {
      "t": "00:30",
      "text": "ಆರೆಂಜ್ ಟೀ ಶರ್ಟ್ ಹಾಕೊಂಡು ಇನ್ಕಡೆ ಹೋಮ್ ಅಪ್ಲೈನ್ಸ್ ಕಂಡ್ರೆ ಗೊತ್ತಾಗುತ್ತೆ."
    },
    {
      "t": "00:35",
      "text": "ಡೆಫಿನೇಟ್ಲಿ"
    },
    {
      "t": "00:38",
      "text": "ಇವಾಗ ಆಯ್ತಾ?"
    },
    {
      "t": "00:39",
      "text": "ಆಯ್ತು ನಿಮ್ದು ಆಯ್ತಾ?"
    },
    {
      "t": "00:41",
      "text": "ನಂದು ಏನು ಇಲ್ಲಮ್ಮ, ಆಕ್ಚುಲಿ ಇವತ್ತು ಹೋಮ್ ಮೀಟಿಂಗ್ ಇತ್ತು."
    },
    {
      "t": "00:47",
      "text": "ಸೋ ಸ್ವಲ್ಪ ಬೇಗ ಬಂದೆ, ಟಿಫನ್ ಮಾಡಿಲ್ಲ, ಮಾಡಬೇಕು."
    },
    {
      "t": "00:53",
      "text": "ಹೇಗೆ ಅನಿಸ್ತಿದೆ ನಿಮಗೆ?"
    },
    {
      "t": "00:57",
      "text": "ಹೇಗೆ ಅನಿಸ್ತಿದೆ ಅಂತಾನಾ?"
    },
    {
      "t": "00:59",
      "text": "ಹಾಂ ಮ್ಯಾರೇಜ್"
    },
    {
      "t": "01:01",
      "text": "ಹೇಗೆ ಅನಿಸ್ತಿದೆ?"
    },
    {
      "t": "01:02",
      "text": "ಡೆಫಿನೇಟ್ಲಿ ಕರೆಕ್ಟ್."
    },
    {
      "t": "01:03",
      "text": "ಎಷ್ಟು ಎಷ್ಟು ವರ್ಷ ಆಯ್ತು ಮದುವೆಯಾಗಿ?"
    },
    {
      "t": "01:07",
      "text": "ರೀಸೆಂಟ್ ಆಗಿ ಆಯ್ತಾ?"
    },
    {
      "t": "01:09",
      "text": "ಆ ರೀಸೆಂಟ್ ಆಗಿ ಅಯ್ಯೋ"
    },
    {
      "t": "01:13",
      "text": "ರೀಸೆಂಟ್ ಆಗಿ ಏನು ಅಲ್ಲ,"
    },
    {
      "t": "01:14",
      "text": "ನಾನು ಆಕ್ಚುಲಿ ಮದುವೆಯಾಗಿ"
    },
    {
      "t": "01:18",
      "text": "10 ಇಯರ್ಸ್ ಆಯ್ತು."
    },
    {
      "t": "01:20",
      "text": "10 ಇಯರ್ಸ್"
    },
    {
      "t": "01:22",
      "text": "ಯಾಕೆ ಹಂಗೆ ತಿರುಗಿ ತಿರುಗಿ ನೋಡ್ತಾ ಇದ್ದೀರಲ್ಲ?"
    },
    {
      "t": "01:25",
      "text": "ಇನ್ನು ಇನ್ನು ಇದಲಾ ಲ್ಯಾಪ್ಟಾಪ್,"
    },
    {
      "t": "01:28",
      "text": "ಇನ್ನ ಫುಲ್ ಹೆಂಗಾರ ನ್ಯಾಚುಟಿಕ್ ಇರೋದು ಅದಕ್ಕೆ ಕೇಳ್ದೆ ಫುಲ್ ಹೆಂಗಾಗಿದ್ದೀರಾ ಏನು ಅಂತ."
    },
    {
      "t": "01:31",
      "text": "ಹಂಗೆ ಇಲ್ಲ ನಾವು ಮೂರು ಜನ ಮಕ್ಕಳು,"
    },
    {
      "t": "01:36",
      "text": "ಹಂಗಾಗಿ ನಮ್ಮನ್ನ ಬೇಗ ಮದುವೆ ಮಾಡಿ ಮಾಡಿ ಕಳಿಸಿಬಿಟ್ರು."
    },
    {
      "t": "01:39",
      "text": "ಯಾವೂರು ನಮಗೆ ಸ್ವಂತ ಊರು?"
    },
    {
      "t": "01:42",
      "text": "ನಮ್ದು ಬಂದ್ಬಿಟ್ಟು ಹಾಸನ್."
    },
    {
      "t": "01:44",
      "text": "ಬಂದ್ಬಿಟ್ಟು ಹೋಗ್ಬಿಟ್ಟು?"
    },
    {
      "t": "01:47",
      "text": "ಹೋಗ್ಬಿಟ್ಟು ಏನು ಇಲ್ಲ, ಏನು ಇಲ್ಲ."
    },
    {
      "t": "01:50",
      "text": "ಹಾಸನ್"
    },
    {
      "t": "01:51",
      "text": "ಬಂದ್ಬಿಟ್ಟು ಹಾಸನ್ ಹೋಗ್ಬಿಟ್ಟು ಬೆಂಗಳೂರು."
    },
    {
      "t": "01:55",
      "text": "ನಿಮ್ಮೂರು?"
    },
    {
      "t": "01:57",
      "text": "ಬೆಂಗಳೂರು."
    },
    {
      "t": "01:58",
      "text": "ಬೆಂಗಳೂರು ಪ್ರಾಪರ್ ಬೆಂಗಳೂರಾ?"
    },
    {
      "t": "02:00",
      "text": "ಹಂಗೆ ಅನ್ಕೊಳ್ಳಿ."
    },
    {
      "t": "02:02",
      "text": "ಹಂಗೆ ಅನ್ಕೋಬೇಕಾ?"
    },
    {
      "t": "02:06",
      "text": "ಇವಾಗ ನಾನು ಹಿಂಗೆ ಹೇಳಿದ್ನ ನೀವು ಹಂಗೆ ಹೇಳಿದ್ರಿ."
    },
    {
      "t": "02:09",
      "text": "ಯಾಕೆ?"
    }
  ]
}