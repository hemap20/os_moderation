    {
      "t": "01:13",
      "text": "எனக்கு 26."
    },
    {
      "t": "01:16",
      "text": "ஓகே ஓகே."
    },
    {
      "t": "01:21",
      "text": "அப்புறம் அப்புறம் சாப்டீங்களா?"
    },
    {
      "t": "01:24",
      "text": "ஆ சாப்பிட்டேன்."
    },
    {
      "t": "01:28",
      "text": "நீங்க லவ்லாம் எதுவும் பண்ணலையா?"
    },
    {
      "t": "01:31",
      "text": "புரியல."
    },
    {
      "t": "01:34",
      "text": "நீங்க லவ்லாம் எதுவும் பண்ணலையான்னு கேட்டேன்."
    },
    {
      "t": "01:37",
      "text": "இல்லைங்க."
    },
    {
