      "text": "ஓகே ஓகே."
    },
    {
      "t": "00:23",
      "text": "என்ன பண்றீங்க?"
    },
    {
      "t": "00:26",
      "text": "நான் இப்போ அப்ராட்ல இருக்கேன்."
    },
    {
      "t": "00:30",
      "text": "ம்."
    },
    {
      "t": "00:32",
      "text": "நீங்க?"
    },
    {
      "t": "00:33",
      "text": "ஓகே."
    },
    {
      "t": "00:34",
      "text": "நான் திருச்சி தாங்க சொந்த ஊரு."
    },
    {
      "t": "00:37",
      "text": "ஓகே."
    },
    {
      "t": "00:38",
      "text": "ஜாப் எங்கே போறீங்க இல்ல வீட்ல தான் இருக்கீங்களா?"
    },
    {
      "t": "00:41",
      "text": "[inaudible]"
    },
    {
      "t": "00:43",
      "text": "இல்ல இப்போ வீட்ல தான் ஒர்க் அவுட் அப்புறம் நீங்க என்ன ஒர்க் பண்றீங்க?"
    },
    {
      "t": "00:50",
      "text": "நான் இங்க ஒரு சூப்பர்வைசரா இருக்கேன்."
    },
    {
      "t": "00:56",
      "text": "ஓ சரி சரி."
    },
    {
      "t": "00:58",
      "text": "மேரிடா?"
    },
    {
      "t": "01:01",
      "text": "இல்ல சிங்கிள் தான், நீங்க?"
    },
    {
      "t": "01:05",
      "text": "ம் நான் சிங்கிள் தான்."
    },
    {
      "t": "01:09",
      "text": "ஓகே ஓகே."
    },
    {
      "t": "01:10",
      "text": "உங்களுக்கு என்ன ஏஜ் ஆகுது?"
