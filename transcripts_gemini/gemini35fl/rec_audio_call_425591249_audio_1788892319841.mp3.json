  "segments": [
    {
      "t": "00:02",
      "text": "ಹಲೋ."
    },
    {
      "t": "00:04",
      "text": "ಹಲೋ. ಎಲ್ಲಿ ಇರೋದು ನೀವು?"
    },
    {
      "t": "00:07",
      "text": "ಬೆಂಗಳೂರಲ್ಲಿ ಇರೋದು."
    },
    {
      "t": "00:09",
      "text": "ನಮ್ಮ ಸಿಕ್ಕ ಮಗ್ಗದ ಅಂದ."
    },
    {
      "t": "00:11",
      "text": "ನಿಮ್ಮ ಹೆಸರು?"
    },
    {
      "t": "00:13",
      "text": "ರಾಜನ್ ಶಾಂತ. ನಿಮ್ಮ ಹೆಸರು?"
    },
    {
      "t": "00:17",
      "text": "ನೀವೇನು ವರ್ಕ್ ಮಾಡ್ತಿರೋದು?"
    },
    {
      "t": "00:20",
      "text": "ನಾನು ಇಂಜಿನಿಯರ್ ಅನ್ಕೊಳ್ಳಿ."
    },
    {
      "t": "00:24",
      "text": "ಹೂ."
    },
    {
      "t": "00:26",
      "text": "ನಾನು ಹಾಸ್ಪಿಟಲ್ ಅಲ್ಲಿ ವರ್ಕ್ ಮಾಡ್ತೀನಿ."
    },
    {
      "t": "00:30",
      "text": "ಹಾಸ್ಪಿಟಲ್ ಅಲ್ಲಿ ಏನು ಕೆಲಸ?"
    },
    {
      "t": "00:33",
      "text": "ನರ್ಸ್."
    },
    {
      "t": "00:36",
      "text": "ಎಷ್ಟು ಎಷ್ಟು ನೇಟಿ ಆಪ್ ಗೆ ಬಂದ? ಹಾ?"
    },
    {
      "t": "00:40",
      "text": "12 ಗಂಟೆ ಆಯ್ತಲ್ವಾ? ನೆನ್ನೆ ಬಂದಿರೋದು. ನೆನ್ನೆ ನೈಟ್."
    },
    {
      "t": "00:46",
      "text": "ಹಂಗಿದೆ ಹಂಗೆ ಮಾತಾಡ್ತಾ ಇದ್ದೀರಾ ಅಲ್ಲಿ."
    },
    {
      "t": "00:50",
      "text": "ನಾನು ಜಾಸ್ತಿ ಯೂಸ್ ಮಾಡಿಲ್ಲ. ಒಂದು ಟೂ ಥ್ರೀ ಕಾಲ್ಸ್ ಅಷ್ಟೇ ಅಟೆಂಡ್ ಮಾಡಿರೋದು."
    },
    {
      "t": "00:55",
      "text": "ಹೌದಾ?"
    },
    {
      "t": "00:56",
      "text": "ಹುಷಾರಾಗಿ ಯೂಸ್ ಮಾಡಿ. ಯಾರಿಗೂ ನಂಬರ್ ಕೊಡ್ಬೇಡಿ."
    },
    {
      "t": "01:00",
      "text": "ಓಕೆ. ಥ್ಯಾಂಕ್ ಯು. ಯಾಕೆ?"
    },
    {
      "t": "01:04",
      "text": "ನೀವು ನಂಬರ್ ಕೊಟ್ರೆ ಇದರೊಳಗೆ ಯಾರು ಅನ್-ನೋನ್ ಇರ್ತಾರೆ, ಸುಮ್ಮನೆ ಫೋನ್ ಮಾಡ್ತಿರ್ತಾರೆ, ಮೆಸೇಜ್ ಮಾಡ್ತಾರೆ, ವಾಟ್ಸಪ್ ಅಲ್ಲಿ ಹಿಂಗೆ ಮಾಡ್ತಾರೆ."
    },
    {
      "t": "01:10",
      "text": "ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡೋಕೆ ಬಂದ್ರೆ ಹೋಗಿ."
    },
    {
      "t": "01:13",
      "text": "ಎಲ್ಲಾ ಆಗುತ್ತೆ. ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡ್ತೀನಿ ಅಂತ ಅಂದ್ರೆ ಹೋಗ್ಬೇಡಿ."
    },
    {
      "t": "01:17",
      "text": "ಓಕೆ. ಚಾನ್ಸ್ ಮಾಡ್ರಿ."
    },
    {
      "t": "01:21",
      "text": "ಹುಷಾರಾಗಿರಿ. ಇಲ್ಲಾಂದ್ರೆ ಸಿಕ್ಕಾಕೊಂಡು,"
    },
    {
      "t": "01:24",
      "text": "ಮ್ಯಾರೀಡ್? ಅನ್-ಮ್ಯಾರೀಡ್?"
    },
    {
      "t": "01:27",
      "text": "ಅನ್-ಮ್ಯಾರೀಡ್."
    },
    {
      "t": "01:30",
      "text": "ಅನ್-ಮ್ಯಾರೀಡ್ ಅಂದ್ರೆ ಸುಮ್ಮನೆ ಕಷ್ಟ ಆಗ್ಬಿಡುತ್ತೆ. ಆಮೇಲೆ ಇನ್ನೊಂದು ಏನು ಅಂದ್ರೆ ಇದರಲ್ಲಿ ಮಾತಾಡೋದನ್ನೆಲ್ಲಾ ಬರಿ ಪ್ರೆಸೆಂಟ್ ಆಗಿ ಮಾತಾಡೋದು."
    },
    {
      "t": "01:38",
      "text": "ಸೆಕ್ಸ್ ಬಗ್ಗೆ ಮಾತಾಡ್ತೀರಾ?"
    },
    {
      "t": "01:41",
      "text": "ಈ ತರ ಹಿಂಗೆ ಮಾತಾಡ್ತಾರೆ. ನಿಮಗೆ ಹಂಗೆಲ್ಲ ಇಷ್ಟ ಆಗುತ್ತಾ?"
    },
    {
      "t": "01:49",
      "text": "ಹಲೋ?"
    },
    {
      "t": "01:50",
      "text": "ಹೌದು ಹೇಳಿ."
    },
    {
      "t": "01:52",
      "text": "ನಿಮಗೆ ಹಂಗೆಲ್ಲ ಮಾತಾಡೋಕೆ ಇಷ್ಟ ಆಗುತ್ತಾ ನಿಮಗೆ?"
    },
    {
      "t": "01:56",
      "text": "ಇಲ್ಲ ರೀ."
    },
    {
      "t": "01:57",
      "text": "ಅಲ್ಲ ಅದಕ್ಕೇನೇ ಎಲ್ಲಿದ್ದು? ಇದರಲ್ಲಿ ಹಂಗೆ ಕೇಳ್ತಾರೆ ನಿಮಗೆ."
    },
    {
      "t": "02:02",
      "text": "ಹುಷಾರು ನೋಡಿ ಯೂಸ್ ಮಾಡಿ. ಯಾರಿಗೂ ನಂಬರ್ ಕೊಡೋಕೆ."
    },
    {
      "t": "02:07",
      "text": "ಸುಮ್ಮನೆ ಒಂದೆರಡು ನಿಮಿಷ ಮಾತಾಡೋಕೆ ಅಷ್ಟೇ."
    },
    {
      "t": "02:10",
      "text": "ಖುಷಿಯಾಗಿ ನಂಬರ್ ಕೊಟ್ರೆ, ಅವರು ಸುಮ್ಮನೆ ಹೆಂಗೆ ಬೇಕೋ ಹಂಗೆ ಮೆಸೇಜ್ ಮಾಡ್ತಾರೆ."
    },
    {
      "t": "02:20",
      "text": "ನೀವು ಈಗ ಡ್ಯೂಟಿಯಲ್ಲಿ ಇದ್ದೀರಾ? ಮನೇಲಿ ಇದ್ದೀರಾ?"
    },
    {
      "t": "02:22",
      "text": "ಡ್ಯೂಟಿ ಇವತ್ತು ನೈಟ್ ಡ್ಯೂಟಿ ಹಾಕಿದ್ದಾರೆ ಶಿಫ್ಟ್."
    },
    {
      "t": "02:26",
      "text": "ಬಂದಿದ್ದು."
    },
    {
      "t": "02:29",
      "text": "ನಿದ್ದೆ ಬರ್ತಿದೆಯಲ್ಲ? ಸರಿ ಅಪ್ಲಿಕೇಶನ್ ಇದೆ. ಆಮೇಲೆ ಹೋಗೋಣ ಅಂತ ಬಂದೆ ಅಷ್ಟೇ."
    },
    {
      "t": "02:34",
      "text": "ಫೇಡ್ ಎಲ್ಲಾ,"
    },
    {
      "t": "02:37",
      "text": "ದುಡ್ಡು ಆಗುತ್ತೆ. ಟೈಮ್ ಪಾಸ್ ಆಗುತ್ತೆ. ಎಲ್ಲಾನು ಆಗುತ್ತೆ. ಆದ್ರೆ ನಿಧಾನಕ್ಕೆ ಹುಷಾರಾಗಿ ಉಪಯೋಗಿಸಿ ಅಷ್ಟೇ."
    },
    {
      "t": "02:44",
      "text": "ಓಕೆ."
    },
    {
      "t": "02:45",
      "text": "ಸರಿನಾ?"
    },
    {
      "t": "02:47",
      "text": "ಬಾಯ್."
    },
    {
      "t": "02:48",
      "text": "ಗುಡ್ ನೈಟ್."
    },
    {
      "t": "02:50",
      "text": "ಗುಡ್ ನೈಟ್."
    }
  ]
}