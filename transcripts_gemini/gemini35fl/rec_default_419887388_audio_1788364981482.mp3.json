  "segments": [
    {
      "t": "00:09",
      "text": "आवाज नहीं आ रहा है।"
    },
    {
      "t": "00:11",
      "text": "हां आ रही है।"
    },
    {
      "t": "00:13",
      "text": "आ रही है।"
    },
    {
      "t": "00:14",
      "text": "हां इससे पहले अपनी बात हुई?्"
    },
    {
      "t": "00:16",
      "text": "नहीं हुई है। कॉल कनेक्ट हुई थी बस।"
    },
    {
      "t": "00:20",
      "text": "नहीं नहीं, इससे पहले।"
    },
    {
      "t": "00:23",
      "text": "नहीं हुई है।"
    },
    {
      "t": "00:25",
      "text": "स्टूडेंट हैं?"
    },
    {
      "t": "00:29",
      "text": "क्या कर रहे हैं?"
    },
    {
      "t": "00:32",
      "text": "कुछ नहीं, ऐसे ही।"
    },
    {
      "t": "00:34",
      "text": "सॉल्व कर रही थी कुछ क्वेश्चंस।"
    },
    {
      "t": "00:36",
      "text": "अच्छा हॉस्टल में रहते हैं?"
    },
    {
      "t": "00:39",
      "text": "घर पे।"
    },
    {
      "t": "00:41",
      "text": "नहीं, इससे पहले कभी अभी बात तो हुई होगी क्योंकि आप मेरे फेवरेट में ऐड हो।"
    },
    {
      "t": "00:47",
      "text": "सच में?"
    },
    {
      "t": "00:48",
      "text": "हां।"
    },
    {
      "t": "00:49",
      "text": "हो कहां से आप?"
    },
    {
      "t": "00:51",
      "text": "मैं एमपी से हूं।"
    },
    {
      "t": "00:53",
      "text": "हो सकता है ऑडियो कॉल पे हुई हो बात।"
    },
    {
      "t": "00:58",
      "text": "वीडियो में ही हुई होगी, तब फेवरेट में ऐड हो।"
    },
    {
      "t": "01:04",
      "text": "हो सकता है, इतनी खूबसूरत लड़की देख के मैंने ऐड कर लिया होगा।"
    },
    {
      "t": "01:09",
      "text": "नहीं नहीं, ऑडियो पे हुई होगी बात शायद। क्या?"
    },
    {
      "t": "01:12",
      "text": "नहीं, मैं जनरली क्या"
    },
    {
      "t": "01:14",
      "text": "मैं तो जॉब करता हूं इसमें लड़की उसमें जनरली ओपन टॉक करने के लिए कनेक्ट करता हूं।"
    },
    {
      "t": "01:19",
      "text": "पर आपका चेहरा देख के लग नहीं रहा है कि मैंने आपसे बात किया होगा।"
    },
    {
      "t": "01:24",
      "text": "नहीं की है क्योंकि ऑडियो पे की होगी हमने शायद क्या करते हो?"
    },
    {
      "t": "01:30",
      "text": "जॉब करता हूं।"
    },
    {
      "t": "01:32",
      "text": "क्या जॉब करते हो?"
    },
    {
      "t": "01:34",
      "text": "जीएसटी अकाउंटेंट हूं।"
    },
    {
      "t": "01:36",
      "text": "अकाउंटेंट?"
    },
    {
      "t": "01:38",
      "text": "पता नहीं यार, किए होंगे। मेरे को भी याद नहीं है।"
    },
    {
      "t": "01:42",
      "text": "[inaudible]"
    },
    {
      "t": "01:45",
      "text": "एक्चुअली ना ये कॉल, आई थिंक तो ऐसे शो तो होती थी मेरे को आरसी रॉक करके, कई बार आती थी ना कॉल।"
    },
    {
      "t": "01:51",
      "text": "बट कई बार मैं ऑफलाइन चली जाती थी, तो ऑफलाइन जाने के लिए भी 8-10 कॉल्स काटनी पड़ती है यार।"
    },
    {
      "t": "01:59",
      "text": "इस टाइम लोग बहुत आते हैं ना।"
    },
    {
      "t": "02:04",
      "text": "हो गया खाना पीना?"
    },
    {
      "t": "02:07",
      "text": "ठीक है, मैं आपसे बाद में बात करूंगा अभी थोड़ा"
    },
    {
      "t": "02:11",
      "text": "सम ओपन टॉक वाली लड़की से थोड़ा बात करूंगा।"
    },
    {
      "t": "02:15",
      "text": "ओके, बाय।"
    },
    {
      "t": "02:17",
      "text": "आप आप तो कर नहीं सकते। आपकी शक्ल ही बता रही है।"
    },
    {
      "t": "02:19",
      "text": "[inaudible]"
    },
    {
      "t": "02:20",
      "text": "मेरे को ठीक नहीं लगता है ऐसे।"
    },
    {
      "t": "02:22",
      "text": "क्यों नहीं लगता? सिंगल हो, फ्रेंड हो।"
    },
    {
      "t": "02:25",
      "text": "बॉयफ्रेंड है या सिंगल हो?"
    },
    {
      "t": "02:29",
      "text": "सिंगल हूं, सिंगल।"
    },
    {
      "t": "02:32",
      "text": "बनवाया बनाया ही नहीं अभी तक।"
    },
    {
      "t": "02:36",
      "text": "ऐ यार, इतनी क्यूट लड़की लेके सिंगल है सारा।"
    },
    {
      "t": "02:39",
      "text": "ब्रेकअप कर दिया है, अच्छे से ट्रीट नहीं करता मेरा बंदा मेरे को।"
    },
    {
      "t": "02:42",
      "text": "अच्छा।"
    },
    {
      "t": "02:44",
      "text": "क्यों? क्या करता था?"
    },
    {
      "t": "02:47",
      "text": "बेवकूफ है वो, बेवकूफ। बदतमीजी से बात करता है।"
    },
    {
      "t": "02:51",
      "text": "अच्छा।"
    },
    {
      "t": "02:53",
      "text": "इतनी प्यारी लड़की से।"
    },
    {
      "t": "02:57",
      "text": "हो कहां से आप?"
    },
    {
      "t": "03:01",
      "text": "मत करो, रो दूंगी मैं।"
    },
    {
      "t": "03:04",
      "text": "वो रिश्ता भेजूं, है ना?"
    },
    {
      "t": "03:06",
      "text": "बस कर पगले रुलाएगा क्या? तारीफ करके।"
    },
    {
      "t": "03:14",
      "text": "[inaudible]"
    },
    {
      "t": "03:15",
      "text": "रोना नहीं।"
    },
    {
      "t": "03:17",
      "text": "सुंदर लड़की रोते-रोते नहीं।"
    },
    {
      "t": "03:22",
      "text": "[inaudible]"
    },
    {
      "t": "03:25",
      "text": "चलो, मैं अभी करता हूं फिर मैं आता हूं।"
    },
    {
      "t": "03:28",
      "text": "ओके, बाय।"
    },
    {
      "t": "03:30",
      "text": "[inaudible]"
    }
  ]
}