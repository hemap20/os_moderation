      "text": "ಯಾವ ಊರು?"
    },
    {
      "t": "00:16",
      "text": "ಬೆಂಗಳೂರು, ನಿಂದು?"
    },
    {
      "t": "00:18",
      "text": "ನಂದು ಬೆಂಗಳೂರು."
    },
    {
      "t": "00:20",
      "text": "ಏನ್ ಮಾರ್ಕೊಂಡಿದ್ದೀರಾ?"
    },
    {
      "t": "00:22",
      "text": "ಏನ್ಲು?"
    },
    {
      "t": "00:24",
      "text": "ಏನ್ ಮಾರ್ಕೊಂಡಿದ್ದೀರಾ?"
    },
    {
      "t": "00:27",
      "text": "ನಾನು ಬ್ಯಾಂಕ್ ಅಲ್ಲಿ ವರ್ಕ್ ಮಾಡ್ತೀನಿ, ನೀವು?"
    },
    {
      "t": "00:30",
      "text": "ಯಾವ ಬ್ಯಾಂಕು?"
    },
    {
      "t": "00:32",
      "text": "ಬಂಧನ್ ಬ್ಯಾಂಕು."
    },
    {
      "t": "00:34",
      "text": "ಓ ಮೈ ಗಾಡ್! ನಾನು ಜನ ಸ್ಮಾಲ್ ಫೈನಾನ್ಸ್ ಬ್ಯಾಂಕ್ ಅಲ್ಲಿ ವರ್ಕ್ ಮಾಡೋದು."
    },
    {
      "t": "00:40",
      "text": "ಓಕೆ."
    },
    {
      "t": "00:41",
      "text": "ಯಾವ ಕಡೆ ಇರೋದು?"
    },
    {
      "t": "00:43",
      "text": "ನಾನು ಕೆ. ಆರ್. ಪುರಂ."
    },
    {
      "t": "00:45",
      "text": "ಹೂ."
    },
    {
      "t": "00:47",
      "text": "ನೀವಿರೋದು?"
    },
    {
      "t": "00:49",
      "text": "ಬೊಮ್ಮನಹಳ್ಳಿ."
    },
    {
      "t": "00:51",
      "text": "ಬೊಮ್ಮನಹಳ್ಳಿ ಓಕೆ."
    },
    {
      "t": "00:55",
      "text": "ಮತ್ತೆ ಟಿಫನ್ ಆಯ್ತಾ?"
    },
    {
      "t": "00:56",
      "text": "ಇವತ್ತು ಲೀವ್ ಇದೆ ಕೆಲಸ ಇಲ್ಲ ಆಯ್ತು ನಿಮ್ದು ಆಯ್ತಾ?"
    },
    {
      "t": "01:00",
      "text": "ಹೂ ನಂದು ಆಯ್ತು."
    },
    {
      "t": "01:02",
      "text": "ಇವತ್ತು ಹೋಗಿಲ್ವಾ ಲೀವ್ವಾ?"
    },
    {
      "t": "01:04",
      "text": "ಇವತ್ತು ಲೀವ್ ಅಲ್ಲಿ ಇದ್ದೆ ನೀನು?"
    },
    {
      "t": "01:07",
      "text": "ನಾನು ಅಷ್ಟೇ."
    },
    {
      "t": "01:10",
      "text": "ಮತ್ತೆ ಏನ್ ಸಮಾಚಾರ?"
    },
    {
      "t": "01:14",
      "text": "ಹೇಳು ಕೇಳೋಣ."
    },
    {
      "t": "01:15",
      "text": "ಏನ್ ಕೇಳೋಣ? ಹೇಗೆ ನಡೀತಿದೆ ಕೆಲಸ? ಲೈಫ್ ಎಲ್ಲಾ?"
    },
    {
      "t": "01:23",
      "text": "ನಿಂದು?"
    },
    {
      "t": "01:25",
      "text": "ನಂದು ಓಕೆ ಓಕೆ."
    },
    {
      "t": "01:27",
      "text": "ನಂದು ಸೇಮ್ ಅಷ್ಟು ಸಕ್ಕತ್ತಾಗಿ ಏನು ಇಲ್ಲ."
    },
    {
      "t": "01:32",
      "text": "ನಿಮ್ಮ ಪ್ರಾಪರ್ ಊರು?"
    },
    {
      "t": "01:35",
      "text": "ದಾವಣಗೆರೆ."
    },
    {
      "t": "01:36",
      "text": "ಓಕೆ. ಇಲ್ಲಿ ಫ್ಯಾಮಿಲಿ ಮ್ಯಾರಿಡ್ ಅ ನೀವು?"
    },
    {
      "t": "01:39",
      "text": "ಇಲ್ಲಪ್ಪ, ಪೇಚಲಿದ್ದೀನಿ."
    },
    {
      "t": "01:41",
      "text": "ಹೂ."
    },
    {
      "t": "01:43",
      "text": "ಇಲ್ಲ."
    },
    {
      "t": "01:45",
      "text": "ಮ್ಯಾರಿಡ್ ಅ ನೀವು?"
    },
    {
      "t": "01:47",
      "text": "ನಾನು ಮ್ಯಾರಿಡ್ ಅದ್ರಿಗೆ ಕೇಳಿದೆ."
    },
    {
      "t": "01:50",
      "text": "ಮತ್ತೆ ಎಲ್ಲ ಕಂಪ್ಲೀಟ್ ಮಾಡ್ತೀರಾ? ನಿಮ್ಮ ವಯಸ್ಸು ಎಷ್ಟಾಗುತ್ತೆ ಇನ್ನು?"
    },
    {
      "t": "01:54",
      "text": "ನಾನು ಪ್ರಾಪರ್ ಬಂದು ಊರು ನಂದು ಆಂಧ್ರ ಕಡೆ."
    },
    {
      "t": "01:58",
      "text": "ಇಲ್ಲಿ ಏರಿಯಾ ಮ್ಯಾನೇಜರ್ ಆಗಿದ್ದೀನಿ."
    },
    {
      "t": "02:00",
      "text": "ಓಕೆ ಯು."
    },
    {
      "t": "02:03",
      "text": "ನಿಮ್ಮ ಫ್ಯಾಮಿಲಿ ಅವರ ಅಲ್ಲಿ ಇರೋದಾ?"
    },
    {
      "t": "02:09",
      "text": "ಹೌದು."
    },
    {
      "t": "02:11",
      "text": "ನೀವು ಪಿಸಿ ಅಲ್ಲಿ ಇರೋದಾ ಅಮ್ಮ?"
    },
    {
      "t": "02:14",
      "text": "ಇಲ್ಲ ರೂಮ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀನಿ. ಮುಂಚೆ ಅಲ್ಲೇ ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೆ ನಮ್ಮೂರಿಂದಾನೆ. ಅಲ್ಲಿಂದ ಟ್ರಾನ್ಸ್ಫರ್ ಮಾಡಿ ಇಲ್ಲಿಗೆ ಪ್ರಮೋಷನ್ ಕೊಟ್ರು."
    },
    {
      "t": "02:20",
      "text": "ಓಕೆ."
    },
    {
      "t": "02:22",
      "text": "ಪ್ಯಾಕೇಜ್ ಎಲ್ಲ ಚೆನ್ನಾಗಿ ಕೊಡ್ತಿದ್ದಾರಾ?"
    },
    {
      "t": "02:24",
      "text": "ಹಾ ಚೆನ್ನಾಗಿದೆ 80, 80, 85 ಬರುತ್ತೆ."
    },
    {
      "t": "02:28",
      "text": "ಸಾಕು ಬಿಡಿ."
    },
    {
      "t": "02:29",
      "text": "ನೀವುಗಳು ಇನ್ನೇನು ಚೆನ್ನಾಗಿ ಇರುತ್ತೆ ಬ್ಯಾಂಕರ್ಸ್ಗೆ."
    },
    {
      "t": "02:33",
      "text": "ಹೌದು ಈ ಸಾಟರ್ಡೆ ಸಂಡೆ, ಮಂಡೆ ಮುಂಚೆದಲ್ಲಿ ನೀವು."
    },
    {
      "t": "02:37",
      "text": "ನಂಗೂ ಅಷ್ಟೇ. ನಾನು ನಾಳೆ ಊರಿಗೆ ಹೋಗ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "02:40",
      "text": "ಓಕೆ."
    },
    {
      "t": "02:44",
      "text": "ಎಷ್ಟು ದಿನ ಆಯ್ತು? ಯೂಸ್ ಮಾಡೋಕೆ ಶುರು ಮಾಡಿ?"
    },
    {
      "t": "02:47",
      "text": "ನಾನು ನೆನ್ನೆ ಬಂದೆ. ಒಬ್ಬನೇ ಇರ್ತೀನಿ ಬೆಂಗಳೂರಲ್ಲಿ ಎಲ್ಲಾ ಫ್ರೆಂಡ್ಸ್ ಆಗ್ತಾರೆ ಅಂತ ಬಂದೆ."
    },
    {
      "t": "02:51",
      "text": "ನಾನು ಬಂದು ಒನ್ ಮಂತ್ ಆಯ್ತು ಇಲ್ಲಿ ಬೆಂಗಳೂರಿಗೆ."
    },
    {
      "t": "02:53",
      "text": "ಅಷ್ಟೇನಾ?"
    },
    {
      "t": "02:56",
      "text": "ಹಾ."
    },
    {
      "t": "02:57",
      "text": "ಹಾ ಚೆನ್ನಾಗಿ ಅನಿಸ್ತಾ ಇದ್ದೀಯಾ?"
    },
    {
      "t": "03:00",
      "text": "ಏನ್ ಹೇಳು?"
    },
    {
      "t": "03:02",
      "text": "ಬೆಂಗಳೂರು ಚೆನ್ನಾಗಿ ಅನಿಸ್ತಾ ಇದ್ದೀಯಾ?"
    },
    {
      "t": "03:04",
      "text": "ಆಕ್ಚುವಲಿ ಹೊಸ ಊರು ಅಲ್ವಾ?"
    },
    {
      "t": "03:06",
      "text": "ಹೂ."
    },
    {
      "t": "03:07",
      "text": "ಅಡ್ಜಸ್ಟ್ ಆಗ್ಬೇಕಲ್ವಾ ನಮಗೂನು?"
    },
    {
      "t": "03:10",
      "text": "ಹೂ."
    },
    {
      "t": "03:11",
      "text": "ಆಗುತ್ತೆ ಬಿಡಿ ತಲೆ ಕೆಡಿಸಿಕೊಬೇಡಿ. ಬೆಂಗಳೂರು ತುಂಬಾ ಚೆನ್ನಾಗಿದೆ."
    },
    {
      "t": "03:15",
      "text": "ಎಲ್ಲರಿಗೂ ಅಡ್ಜಸ್ಟ್ ಆಗುತ್ತೆ."
    },
    {
      "t": "03:19",
      "text": "ನೀವು ಎಷ್ಟು ದಿನ ಆಯ್ತು ಬಂದಿ?"
    },
    {
      "t": "03:22",
      "text": "ನಾನು ಬೆಂಗಳೂರಿಗೆ ಬಂದು ಮೂರು ವರ್ಷ ಆಯ್ತು."
    },
    {
      "t": "03:24",
      "text": "ಓಕೆ."
    },
    {
      "t": "03:27",
      "text": "ಮತ್ತೆ ಏನ್ ತಿಂಗಳು ಇರೋದು?"
    },
    {
      "t": "03:31",
      "text": "ದೋಸೆ ಮಾಡಿದೆ."
    },
    {
      "t": "03:35",
      "text": "ಆಚೆನಾ?"
    },
    {
      "t": "03:37",
      "text": "ಹಾ ಹೌದು."
    },
    {
      "t": "03:40",
      "text": "ಫುಡ್ ಎಲ್ಲಾ ಸೆಟ್ ಆಯ್ತಾ?"
    },
    {
      "t": "03:43",
      "text": "ಸೆಟ್ ಆಗ್ಬೇಕು ಸೆಟ್ ಮಾಡ್ಕೋಬೇಕು ನಾವೇ."
    },
    {
      "t": "03:47",
      "text": "ಇಲ್ಲ ಏನ್ ಗೊತ್ತಾ? ಬೆಂಗಳೂರು ಪಿಸಿ ಗಳಲ್ಲಿ ಎಲ್ಲಾ ಜಾಸ್ತಿ ಆಂಧ್ರ ಪಿಸಿ ಗಳೇ ಇರೋದಾ?"
    },
    {
      "t": "03:52",
      "text": "ಫುಡ್ ಎಲ್ಲಾ ನಿಮಗೆ ಅಡ್ಜಸ್ಟ್ ಆಗೋತರನೇ ಇರುತ್ತೆ."
    },
    {
      "t": "03:55",
      "text": "ಅದೇನು ವರಿ ಮಾಡ್ಕೊಬೇಡಿ."
    },
    {
      "t": "03:57",
      "text": "ಆಂಧ್ರ ಅಂದ್ರೆ ನಮ್ದು ಆಂಧ್ರ ಅಲ್ಲ ಕನ್ನಡಕ್ಕೆ ಬಾರ್ಡರ್ ಅಲ್ಲಿ ಇರೋದು."
    },
    {
      "t": "04:00",
      "text": "ಯಾವ ಊರು?"
    },
    {
      "t": "04:02",
      "text": "ಇತ್ಕಡೆ ಕೆ.ಜಿ.ಎಫ್. ಕಡೆ ನಮ್ದು ಇರೋದು."
    },
    {
      "t": "04:04",
      "text": "ಕುಪ್ಪ ಮುತ ಕೆ.ಜಿ.ಎಫ್. ಸೆಂಟ್ರಲ್."
    },
    {
      "t": "04:06",
      "text": "ಇತ್ಕಡೆ ಕೋಲಾರ್ ಸೈಡ್."
    },
    {
      "t": "04:09",
      "text": "ಹಾ?"
    },
    {
      "t": "04:10",
      "text": "ಕೋಲಾರ."
    },
    {
      "t": "04:12",
      "text": "ಕೋಲಾರ್ ಸೈಡ್ ಆ?"
    },
    {
      "t": "04:13",
      "text": "ಕೋಲಾರ್, ಮುಳಬಾಗಿಲು, ನಂಗಲಿ,"
    },
    {
      "t": "04:18",
      "text": "ಹೂ ಹೌದು."
    },
    {
      "t": "04:20",
      "text": "ಆ ನಾನು ಫಸ್ಟ್ ಬೆಂಗಳೂರಿಗೆ ಬಂದಾಗ ಅಲ್ಲಿ ಕೋಲಾರ ಹತ್ರ ಇದು ನರಸಾಪುರದಲ್ಲಿ ಒಂದು ಐಫೋನ್ ಮ್ಯಾನುಫ್ಯಾಕ್ಚರಿಂಗ್ ಕಂಪನಿ ಇದೆಯಲ್ಲ ಅಲ್ಲಿಗೆ."
    },
    {
      "t": "04:29",
      "text": "ಹಾಗೆ ಗೊತ್ತಿ ಹೇಳಿ."
    },
    {
      "t": "04:30",
      "text": "ಫಸ್ಟ್."
    },
    {
      "t": "04:32",
      "text": "ಹೂ ಅವಾಗ ವಿಷ್ಟ್ರನ್ ಅಂತ ಇತ್ತು. ಇವಾಗ ಟಾಟಾ ಆಗಿದೆ."
    },
    {
      "t": "04:35",
      "text": "ಟಾಟಾ ಲೇಟೆಸ್ಟ್ ಆಗಿದೆ."
    },
    {
      "t": "04:38",
      "text": "ಹ್ಮ್ ಹ್ಮ್."
    },
    {
      "t": "04:39",
      "text": "ಅಲ್ಲೇ ಫಸ್ಟ್ ನಾನು ವರ್ಕ್ ಮಾಡಿದ್ದು."
    },
    {
      "t": "04:42",
      "text": "ಓಕೆ. ಎಷ್ಟು ದಿನ ಮಾಡ್ತೀರಾ ನೀವು ಇಲ್ಲಿ ವರ್ಕ್?"
    },
    {
      "t": "04:46",
      "text": "ಅಲ್ಲ ಅಲ್ಲೊಂದು 10 ಮಂತ್ಸ್ ಮಾಡಿದೆ."
    },
    {
      "t": "04:49",
      "text": "ಸಿಕ್ಕಾಪಟ್ಟೆ ಕಷ್ಟ ಆಯ್ತು. ಅಲ್ಲೆಲ್ಲ ಲೀವ್ ಗಳು ಇರ್ತಾ ಇರ್ಲಿಲ್ವಾ? ಬೇರೆ ಕಡೆ ಇರಬೇಕು ಕೊಡಕೂ ಆಗ್ತಿರ್ಲಿಲ್ಲ."
    },
    {
      "t": "04:55",
      "text": "ಅಲ್ಲೇ ಸ್ಟ್ರಕ್ ಆಗ್ಬಿಟ್ಟಿದೆ."
    },
    {
      "t": "04:57",
      "text": "ಆಮೇಲೆ ಅಲ್ಲಿ ಬಿಟ್ಟು ಮತ್ತೆ ಬೆಂಗಳೂರಿಗೆ ಬಂದು ಒನ್ ವೀಕ್ ಅಲ್ಲಿ ಇಟ್ಕೊಂಡೆ ಬೇರೆ ಕಡೆ ಅಲ್ಲಿ."
    },
    {
      "t": "05:05",
      "text": "ನಿಮ್ಮದೇನು ವರ್ಕು? ಇದರಲ್ಲಿ ನಿಮ್ದು ಹಿಂದೆ ಏನು ವರ್ಕು?"
    },
    {
      "t": "05:09",
      "text": "ಗೋಲ್ಡ್ ಲೋನ್ ಅಲ್ಲಿ."
    },
    {
      "t": "05:11",
      "text": "ಓ ಗೋಲ್ಡ್ ಲೋನ್ ಅಲ್ಲ. ಓಕೆ ಏನು ಕ್ಯಾಶಿಯರ? ಬಿಸಿನೆಸ್ ಸೇಲ್ಸಾ ಏನು?"
    },
    {
      "t": "05:14",
      "text": "ಸೇಲ್ಸ್ ಸೇಲ್ಸ್. ಮುಂಚೆ ಆಪರೇಷನ್ ಅಲ್ಲಿ ಮಾಡ್ತಿದ್ದೆ. ಸಿಕ್ಕಾಪಟ್ಟೆ ಪ್ರೆಷರ್ ಕೊಡ್ತಾರೆ ಆ ಕಡೆ ಸೇಲ್ಸ್ ಮಾಡ್ಬೇಕು ಆಪರೇಷನ್ ನೋಡ್ಕೋಬೇಕು."
    },
    {
      "t": "05:22",
      "text": "ಅದಕ್ಕೆ ಇವಾಗ ಸೇಲ್ಸ್ ಚಂದಾದೆ."
    },
    {
      "t": "05:25",
      "text": "ಇಲ್ಲಿ ಸಿಕ್ಸ್ ಮಂತ್ಸ್ ಆಯ್ತು ನಾನು ಜಾಯಿನ್ ಆಗಿ."
    },
    {
      "t": "05:30",
      "text": "ಹಾ ಇದು ಸೇಲ್ಸ್ ಅಲ್ಲಿ ಮಾಡ್ತಿದ್ದೀನಿ."
    },
    {
      "t": "05:32",
      "text": "ನಿಮಗೆ ಇನ್ಸೆಂಟಿವ್ ಎಲ್ಲಾ ಬರುತ್ತಲ್ವಾ?"
    },
    {
      "t": "05:36",
      "text": "ಇನ್ಸೆಂಟಿವ್ ಬರುತ್ತೆ ಬಟ್ ಕಷ್ಟ."
    },
    {
      "t": "05:40",
      "text": "ನಾನು ಗೋಲ್ಡ್ ಲೋನ್ ಅಲ್ಲಿ ಮಾಡೋದು."
    },
    {
      "t": "05:41",
      "text": "ಹೌದು."
    },
    {
      "t": "05:42",
      "text": "ಗೋಲ್ಡ್ ಲೋನ್ ಅಂದ್ರೆ ಲೊಕೇಶನ್ ಮೇಲೆ ಡಿಪೆಂಡ್ ಆಗುತ್ತೆ. ಕೋನಮಂಗಳ ಸರ್ಕಾರಿ ಚೇರಿ ಅಲ್ವಾ?"
    },
    {
      "t": "05:48",
      "text": "ಹೌದು."
    },
    {
      "t": "05:49",
      "text": "ಕಡಿಮೆ ಗೋಲ್ಡ್ ಲೋನ್ ಇರೋದು ತಗೋಳೋದು."
    },
    {
      "t": "05:52",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "05:55",
      "text": "ನೀನೇನು ಮತ್ತೆ?"
    },
    {
      "t": "05:58",
      "text": "ಹೇಳಿ ಕೇಳೋಣ."
    },
    {
      "t": "06:00",
      "text": "ನೀನೇನು ಇಲ್ಲಮ್ಮ. ನೀನೇ ಎಲ್ಲ ಕೇಳು."
    },
    {
      "t": "06:04",
      "text": "ಮಿಸ್ ಮಾಡ್ಕೊಳ್ತಿದ್ದೀರಾ ಫ್ಯಾಮಿಲಿನ?"
    },
    {
      "t": "06:08",
      "text": "ಫ್ಯಾಮಿಲಿ ಮಿಸ್ ಆಗುತ್ತೆ ಇನ್ನೇನು ಮಾಡ್ತೀಯಾ?"
    },
    {
      "t": "06:11",
      "text": "ಊರಿಗೋಸ್ಕರ ಮಾಡಬೇಕಲ್ವಾ?"
    },
    {
      "t": "06:14",
      "text": "ಮಾಡಬೇಕು."
    },
    {
      "t": "06:15",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "06:16",
      "text": "ಇದು ಬೇಡಿಸದಿಯಾ?"
    },
    {
      "t": "06:18",
      "text": "ಹಾ ಇದೆ. ಪಾಪು ಇದೆ."
    },
    {
      "t": "06:20",
      "text": "ಒಂದು ಪಾಪುನಾ?"
    },
    {
      "t": "06:21",
      "text": "ಹಾ ಹೌದು."
    },
    {
      "t": "06:22",
      "text": "ಗಂಡು ಗಂಡು ಪಾಪಾ?"
    },
    {
      "t": "06:24",
      "text": "ಗಂಡು."
    },
    {
      "t": "06:27",
      "text": "ಬಂದಾಗಿಂದ ಹೋಗಿಲ್ವಾ?"
    },
    {
      "t": "06:30",
      "text": "ಏನ್ ಹೇಳು?"
    },
    {
      "t": "06:31",
      "text": "ಬೆಂಗಳೂರು ಬಂದಾಗಿಂದ ಹೋಗಿಲ್ವಾ ಊರಿಗೆ?"
    },
    {
      "t": "06:35",
      "text": "ಇಲ್ಲ ಹೋಗ್ತೀನಿ."
    },
    {
      "t": "06:37",
      "text": "ನಾನು ಇಲ್ಲಿ ಕಾರ್ ತಗೊಂಡು ಇಟ್ಕೊಂಡಿದೀನಿ. ಯಾವಾಗ ಮುಂಚೆ ಬರ್ತೀವೋ ಕಾರ್ ಅಲ್ಲಿ ಹೊರಟು ಹೋಗ್ತೀನಿ."
    },
    {
      "t": "06:40",
      "text": "ಇನ್ನ ಟ್ರೈನಿಂಗ್ ಏನಿಲ್ಲ ಹೋಗಲ್ಲ. ತುಂಬಾ ಲೇಟ್ ಆಗುತ್ತೆ ಅಂದ್ಬಿಟ್ಟು ಕಾರಲ್ಲಿ ಹೊರಟು ಹೋಗ್ತೀನಿ."
    },
    {
      "t": "06:45",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "06:47",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "06:49",
      "text": "ಹತ್ತಿರನೇ ಇದೆ ಬಿಡಿ. ಹೋಗಿ ಬರಬಹುದು. ಕೇರ್ಪುರ ಅಲ್ವಾ? ಈ ಕಡೆ ಸೈಡ್ ಎಲ್ಲಾ ಇದ್ದಿದ್ರೆ ಸ್ವಲ್ಪ ಕಷ್ಟ ಆಗ್ತಿತ್ತು."
    },
    {
      "t": "06:55",
      "text": "ಕಷ್ಟ ಹೌದು."
    },
    {
      "t": "06:56",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "06:59",
      "text": "ಅಲ್ಲಿಂದ ಅಲ್ಲಿಗೆ ಹೋಗಬಹುದು. ಏನ್ ಅನಿಸಲ್ಲ."
    },
    {
      "t": "07:05",
      "text": "ಮತ್ತೆ ಹೇಳಿ ಏನ್ ಸಮಾಚಾರ?"
    },
    {
      "t": "07:09",
      "text": "ನೀನು ಹೇಳು ಕೇಳೋಣ."
    },
    {
      "t": "07:11",
      "text": "ಮತ್ತೆ ಊರಿಗೆ ಹೋಗೋದು ನಾಳೇನಾ?"
    },
    {
      "t": "07:14",
      "text": "ಹ್ಮ್ ನಾಳೆ, ನಾಳೆ ಲೀವ್ ಇಲ್ಲ. ನಾಳೆ ಆಫ್ಟರ್ ಡೇ ಪರ್ಮಿಷನ್ ತಗೊಂಡು ಹೋಗ್ತೀನಿ."
    },
    {
      "t": "07:20",
      "text": "ಹ ಹೋಗಿ ಸಾಟರ್ಡೆ, ಸಂಡೆ, ಮಂಡೆ."
    },
    {
      "t": "07:23",
      "text": "ಮಂಡೆ ಬರ್ತೀರಾ?"
    },
    {
      "t": "07:25",
      "text": "ಮಂಡೆ ನೇ ಹಬ್ಬ ನಮ್ಮ ಊರಲ್ಲಿ. ಪಂಚಮಿನು ಅವಾಗ್ಲೇ ಮಾಡೋದು. ಸೋ ಮಂಡೆ ಬರಲ್ಲ."
    },
    {
      "t": "07:30",
      "text": "ಹಾ."
    },
    {
      "t": "07:31",
      "text": "ಟ್ಯೂಸ್ಡೇ ಇಲ್ಲ ಅಂದ್ರೆ ವೆಡ್ಸ್ಡೇ ಬರಬೇಕು ಅಂತ ಅನ್ಕೊಂಡಿದ್ದೀನಿ. ನನಗೆ ಲೀವ್ ಬೇಕು. ಒನ್ ಮಂತ್ ಆಯ್ತು ಊರಿಗೆ ಹೋಗಿ ಹೋಗೆ ಇಲ್ಲ."
    },
    {
      "t": "07:39",
      "text": "ಹ್ಮ್ ಹ್ಮ್."
    },
    {
      "t": "07:41",
      "text": "ಸೋ ಮಿಸ್ ಮಾಡ್ಕೊಳ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "07:43",
      "text": "ಲೀವ್ ಬೇಕು ನೋಡೋಣ."
    },
    {
      "t": "07:45",
      "text": "ಇಲ್ಲಿ ವೀಕೆಂಡ್ ಅಲ್ಲಿ ಎಲ್ಲಾ ಎಲ್ಲಿಗೆ ಹೋಗ್ತಿಯಾ? ಏನ್ ಮಾಡ್ತೀಯಾ? ಫ್ರೆಂಡ್ಸ್ ಇದ್ದಾರಾ?"
    },
    {
      "t": "07:50",
      "text": "ಆತರ ಯಾರು ಇಲ್ಲ. 15 ಡೇಸ್ ಕೌಂಟೆನ್ ಹೋಗ್ತಿದ್ದೆ."
    },
    {
      "t": "07:54",
      "text": "ಇದು ಸ್ವಲ್ಪ."
    },
    {
      "t": "07:56",
      "text": "ಈ ಲಾಸ್ಟ್ ಮಂತ್ ಅಲ್ಲಿ ಆಕ್ಟಿವಿಟಿಸ್ ಅದು ಇದು ಒಂತರ ಅಂದು ಲೀವ್ ಟೈಮ್ ಅಲ್ಲೂನು ಹೋಗೋಕೆ ಆಗ್ಲಿಲ್ಲವ."
    },
    {
      "t": "08:04",
      "text": "ನಂಗೂ ಬೇರೆ ಹುಷಾರು ಇರ್ಲಿಲ್ಲ. ಹಂಗಾಗಿ ಹೋಗ್ಲಿಲ್ಲ. ಸೆಕೆಂಡ್ ಸಾಟರ್ಡೆ, ಫೋರ್ತ್ ಸಾಟರ್ಡೆ ನಾರ್ಮಲ್ ಆಗಿ ಊರಿಗೆ ಹೋಗ್ತೀನಿ."
    },
    {
      "t": "08:11",
      "text": "ಇಲ್ಲಿ ಮಾತ್ರ ಈ ಸಲನು ಎಲ್ಲೂ ಹೋಗಿಲ್ಲ. ಸುಮ್ನೆ ಪಿಸಿ ಅಲ್ಲಿ ಇರ್ತಿದ್ದೆ ಹೋದ್ರೆ ಆಫೀಸ್ ಇಲ್ಲಾಂದ್ರೆ ಇಸ್ಕಾಂಟ್ ಅಲ್ಲಿ."
    },
    {
      "t": "08:18",
      "text": "ಅಷ್ಟೇ."
    },
    {
      "t": "08:20",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "08:22",
      "text": "ಬೋರಿಂಗ್ ಆಗ್ತಿತ್ತು."
    },
    {
      "t": "08:25",
      "text": "ಸೇಮ್ ನಂದೇ ಇದೆ ಪ್ರಾಬ್ಲಮ್ ಇಲ್ಲಿ."
    },
    {
      "t": "08:30",
      "text": "ಏನೋ ಒಂತರ ಆಫೀಸ್ಗೆ ಹೋದ್ರೆ ಸೂಯಿ ಯಾವುದಾದ್ರೂ ಹೋಗ್ಬೇಕು ಅನ್ಸುತ್ತೆ. ಬೆಳಗ್ಗೆ ಬೆಳಗ್ಗೆನೆ ಅಡಲು ಒಂದು ಗಂಟೆ ತಗೋತಾರೆ."
    },
    {
      "t": "08:38",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "08:39",
      "text": "ಅದಾದ್ಮೇಲೆ ಬಂದ್ರೆ ಒಂತರ."
    },
    {
      "t": "08:44",
      "text": "ನೀನೇನು ಹೇಳೋಕೆ ಬಂದ್ವಿ?"
    },
    {
      "t": "08:47",
      "text": "ಟ್ಯಾನ್ ಕಾರ್ಡ್ ತಗೋತಾರೆ ಅಂದೆ."
    },
    {
      "t": "08:49",
      "text": "ಟ್ಯಾನ್ ಕಾಲು ನಮ್ಮ ಟೀಮ್ ಅವರು ತಗೋತಾರೆ. ಬ್ರಾಂಚ್ ಅವರು ಅಡಲ್ ತಗೋತಾರೆ. ನಮ್ದು ಬ್ರಾಂಚ್ ಬ್ಯಾಂಕಿಂಗ್ ಆಯ್ತಾ?"
    },
    {
      "t": "08:55",
      "text": "ಈ ಕಡೆ ಇವರು ಸಾಹಿಸುತಾರೆ. ಆ ಕಡೆ ನಮ್ಮ ಗೋಲ್ಡ್ ಟೀಮ್ ಅವರು ಸಾಹಿಸುತಾರೆ ಟಾರ್ಗೆಟ್ ಆಗಿಲ್ಲ ಅಂದ್ರೆ. ಬಟ್ ಕಂಪ್ಲೀಟ್ ಟಾರ್ಗೆಟ್ ಎಲ್ಲಾ ಕೇಳಲ್ಲ ಪಾಪ. ಒಳ್ಳೆಯವರು ಇದ್ದಾರೆ."
    },
    {
      "t": "09:05",
      "text": "ಅರ್ಥ ಮಾಡ್ಕೊತಾರೆ ಗೋಲ್ಡ್ ಅಲ್ವಾ?"
    },
    {
      "t": "09:08",
      "text": "ಹೌದು."
    },
    {
      "t": "09:10",
      "text": "ಸುಮ್ನೆ ತಗೊಂಡು ಬಂದು ಇಡಲ್ಲ ಯಾರುನು. ಅವರು ಕಷ್ಟ ಬರಬೇಕು. ನಮ್ಮ ಬ್ರಾಂಚ್ ಅಲ್ಲಿ ಇರೋರು ಅರ್ಥ ಮಾಡ್ಕೊಳಲ್ಲ ಹೆಂಗೆ ಆಡ್ತಾರೆ ಗೊತ್ತಾ?"
    },
    {
      "t": "09:14",
      "text": "ಇವತ್ತು ರೇಕ್ ಅಷ್ಟೇ ನಂಗೆ ಅದೆಲ್ಲ ಗೊತ್ತಿಲ್ಲ ಇವತ್ತು ರೇಕ್ ಅಷ್ಟೇ ಅಂತಾರೆ. ಹಂಗೆ ಹೇಳಿದಾಗೆಲ್ಲ ನಾನು ಸುಮ್ನೆ ಎದ್ದು ಬಂದ್ಬಿಡ್ತೀನಿ."
    },
    {
      "t": "09:23",
      "text": "ಇಲ್ಲಿಂದ ತಗೊಂಡು ಬರಕಾಗುತ್ತೆ ನೀವೇ ಹೇಳಿ."
    },
    {
      "t": "09:27",
      "text": "ಅದು ಹೇಳು."
    },
    {
      "t": "09:29",
      "text": "ಯಾವುದಕ್ಕೆ ಹೇಳ್ತಾರಾ ಓಕೆ ಮಾಡ್ತೀನಿ ಅಂತ ಹೇಳ್ತೀನಿ. ಫಾಲೋ ಅಪ್ ಇರ್ತವೆ ನಮಗೆ ಹೆಂಗೆ ಗೊತ್ತಾ? ವರ್ಸ್ಟ್ ಅಲ್ಲೇ ವರ್ಸ್ಟ್."
    },
    {
      "t": "09:35",
      "text": "ಇವಾಗ ಇಲ್ಲಿ ಬರ್ತೀನಿ ಅಂತ ಹೇಳಿರ್ತಾರೆ."
    },
    {
      "t": "09:38",
      "text": "ಒನ್ ಹವರ್ ಸಾಕು ಅಲ್ವಾ ನಿಮಗೆ ಎಂತ ಬ್ಯಾಂಕಿಗೆ ಹೋದ್ರೆ ಯಾವುದೇ ಎನ್ಬಿಸಿ ಗೆ ಹೋದ್ರು."
    },
    {
      "t": "09:43",
      "text": "20 ರಿಂದ 30 ನಿಮಿಷದಲ್ಲಿ ಮಾಡಿ ಮುಗಿಸಿಬಿಡ್ತಾರೆ. ಮ್ಯಾಕ್ಸಿಮಮ್ ಒನ್ ಹವರ್ ಅಂತ ಹೇಳಿ."
    },
    {
      "t": "09:48",
      "text": "ಹೌದು."
    },
    {
      "t": "09:50",
      "text": "ಇಲ್ಲಿ ಕೇಳಿರ್ತಾರೆ ಬರ್ತೀನಿ ಓಕೆ ಹಂಗೆ ಹಿಂಗೆ ಅಂತ ಎಲ್ಲಾ ಹೇಳಿರ್ತಾರೆ. ಒನ್ ವೀಕ್ ಒನ್ ಮಂತ್ ಇಂದ ಎಲ್ಲಾ ಫಾಲೋ ಅಪ್ ಇಟ್ಕೊಂಡಿರ್ತೀನಿ."
    },
    {
      "t": "09:56",
      "text": "ಮೇಡಂ ಇವತ್ತು ಬರ್ತೀನಿ ಇಲ್ಲ ನಾಳೆ ಬೆಳಗ್ಗೆನೆ ಬರ್ತೀನಿ ಮೇಡಂ ನನಗೆ ಅರ್ಜೆಂಟ್ ಇದೆ ಹಂಗೆ ಹಿಂಗೆ ಅಂತ ಹೇಳಿರ್ತಾರೆ."
    },
    {
      "t": "10:01",
      "text": "ಕಾಲ್ ಮಾಡಿದ್ರೆ ಫೋನ್ ರೆಸ್ಪಾಂಡ್ ಮಾಡಲ್ಲ. ಆಮೇಲೆ ಒಂದು ಸ್ವಲ್ಪ ದಿನ ಬಿಟ್ಟಮೇಲೆ ಗೊತ್ತಾಗುತ್ತೆ."
    },
    {
      "t": "10:06",
      "text": "ಇಲ್ಲ ಮೇಡಂ ಅಲ್ಲಿ ಇಂಟರೆಸ್ಟ್ ಕಮ್ಮಿ ಮತ್ತೆ ಗೊತ್ತಿರೋವರು ಬೇರೆ ನಾವು ಇಂಟರೆಸ್ಟ್ ಪೇ ಮಾಡಿಲ್ಲ ಅಂದ್ರೂನು ಗೋಲ್ಡ್ ಏನ್ ಆಕ್ಷನ್ ಆಗಲ್ಲ. ನಮ್ದು ನಂಬಿಕೆ ಇಲ್ಲ ಮೇಡಂ ಹಂಗೆ ಹಿಂಗೆ ಅಂತ ಹೇಳ್ತಾರೆ."
    },
    {
      "t": "10:14",
      "text": "ಏನು ಕೇಳು? ಹೇಳಿದ್ರು ಇಲ್ಲ. ಕೇಳೋದೇ ಇಲ್ಲ. ಬರ್ತೀನಿ ಬರ್ತೀನಿ ಅಂತ ಒಪ್ಕೊಂಡು ಲಾಸ್ಟ್ ಮಿನಿಟ್ ಅಲ್ಲಿ ಕೈ ಎತ್ತಿಬಿಡ್ತಾರೆ."
    },
    {
      "t": "10:23",
      "text": "ಅಯ್ಯೋ."
    },
    {
      "t": "10:25",
      "text": "ಕಷ್ಟ ಗೋಲ್ಡ್ ಲೋನು ಅಂತ ಚೆನ್ನಾಗಿ ಏನು ಇರಲ್ಲ. ಆದ್ರೆ ಏನ್ ಮಾಡೋದು ಆಕ್ಟಿವೇಷನ್ ಆಯ್ತು ಅಂದ್ರೆ ಯಾರು ಕೇಳಲ್ಲ. ಸ್ವಲ್ಪ ಇಂಗ್ಲಿಷ್ ಉಸಿರಾಡೋಕೆ ಹಾರ್ಡ್ ಕೊಡ್ತಾರೆ."
    },
    {
      "t": "10:39",
      "text": "ಬೇರೆ ಆಯ್ತು ಅಂದ್ರೆ ಕ್ಲಾರಿಟಿಸ್ ಗೆ ಎಲ್ಲಾ ಹೋದ್ವಿ ಅಂದ್ರೆ ಎಲ್ಲಾ ಪ್ರಾಡಕ್ಟ್ಸ್ ಮಾಡಬೇಕು."
    },
    {
      "t": "10:45",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "10:47",
      "text": "ನಾವು ಅದು ನೀವ್ ಯಾವುದು?"
    },
    {
      "t": "10:49",
      "text": "ಏನ್ ಹೇಳು?"
    },
    {
      "t": "10:51",
      "text": "ನೀವು ಅಂದ್ರೆ ಯಾವುದರಲ್ಲಿ ಮಾಡೋದು ಯಾವ ಡಿಪಾರ್ಟ್ಮೆಂಟ್?"
    },
    {
      "t": "10:55",
      "text": "ನಂದು ಬಂದು ಎನ್ಪಿಐ ಡಿಪಾರ್ಟ್ಮೆಂಟ್ ನಂದು."
    },
    {
      "t": "10:58",
      "text": "ಹಂಗಂದ್ರೆ?"
    },
    {
      "t": "10:59",
      "text": "ಓಡಿ."
    },
    {
      "t": "11:03",
      "text": "ಓಡಿ ಅಂದ್ರೆ ಓಡಿ ಬರುತ್ತಲ್ವಾ?"
    },
    {
      "t": "11:05",
      "text": "ಹ್ಮ್."
    },
    {
      "t": "11:06",
      "text": "ಆ ಕಷ್ಟ ಮಾಡಿಸಿ ನನ್ನ ಹುಡುಗರಿಗೆ ಕೇಳಿ ನಾನು ಫಾಲೋ ಅಪ್ ಮಾಡ್ಸಬೇಕು."
    },
    {
      "t": "11:09",
      "text": "ಕಲೆಕ್ಷನ್ ಮಾಡ್ಸೋದಾ?"
    },
    {
      "t": "11:11",
      "text": "ಹಾ ಹೌದು."
    },
    {
      "t": "11:13",
      "text": "ಅದು ಸ್ವಲ್ಪ ಇರಿಟೇಷನ್ ಆಯ್ತಾನೆ."
    },
    {
      "t": "11:15",
      "text": "ಸೈಕೋ! ಡಬಲ್ ಸೈಕೋ ಇದು."
    },
    {
      "t": "11:19",
      "text": "ಅಯ್ಯೋ ಇಲ್ಲಿ ನಮ್ಮ ಸರ್ ಒಬ್ಬರು ಇದ್ದಾರೆ."
    },
    {
      "t": "11:22",
      "text": "ಅವರು ಹೆಂಗ್ ಮಾಡ್ತಿರ್ತಾರೆ ಗೊತ್ತಾ? ಅಂದ್ರೆ ಬೇರೆ ಬ್ರಾಂಚ್ ಮ್ಯಾನೇಜರ್."
    },
    {
      "t": "11:25",
      "text": "ಅವರು ಕಲೆಕ್ಷನ್ ಅಲ್ಲೇ ಇರೋದು ಬ್ರಾಂಚ್ ಹೆಡ್ ಅವರು."
    },
    {
      "t": "11:28",
      "text": "ಅವರು ಒಂದೊಂದು ಸಲ ಅಂದ್ರೆ ಸ್ಟಾರ್ಟಿಂಗ್ ಅವರ ಬ್ರಾಂಚ್ ಗೆ ಟ್ರೈನಿಂಗ್ ಹೋದ್ರೆ ಪರಿಚಯ ಆದಿದ್ರಲ್ಲ."
    },
    {
      "t": "11:34",
      "text": "ನಾನು ಒಬ್ಬಳೇ ಸ್ವಲ್ಪ ಚಿಕ್ಕ ಹುಡುಗಿ ಅಂತ ಹೇಳಿ ಚೆನ್ನಾಗಿ ಮಾತಾಡಿಸಿದ್ರು."
    },
    {
      "t": "11:38",
      "text": "ಅವರು ಕಾಲ್ ಮಾಡ್ಬಿಟ್ಟು ಇದೊಂದು ಚೂರು ನಂಬರ್ ಕೊಡ್ತೀನಿ."
    },
    {
      "t": "11:42",
      "text": "ಮೂರು."
    }
  ]
}