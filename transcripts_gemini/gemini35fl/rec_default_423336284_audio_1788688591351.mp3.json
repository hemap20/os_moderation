  "segments": [
    {
      "t": "00:09",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:10",
      "text": "ಹಲೋ ಮೇಡಂ"
    },
    {
      "t": "00:13",
      "text": "ಬೆಂಗಳೂರಿಂದ ಮಾತಾಡ್ತಾ ಇದ್ದೀನಿ ಅಲ್ವಾ?"
    },
    {
      "t": "00:16",
      "text": "ಬೆಂಗಳೂರು."
    },
    {
      "t": "00:19",
      "text": "ಏನ್ ಮೇಡಂ ಕಾಂಟ್ಯಾಕ್ಟ್?"
    },
    {
      "t": "00:22",
      "text": "ನಾನು ಕಂಪನಿಯಲ್ಲಿ Facebook ಇಂದ."
    },
    {
      "t": "00:26",
      "text": "ಇಂಟರೆಸ್ಟೆಡ್ ಯಾ?"
    },
    {
      "t": "00:30",
      "text": "ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡ್ತೀರಾ WhatsApp ಅಲ್ಲಿ?"
    },
    {
      "t": "00:34",
      "text": "ಫಸ್ಟ್ ಈಸ್ ರಿಯಲ್ ಕ್ಲೋಸ್ ಅಪ್ ಅಂತ."
    },
    {
      "t": "00:37",
      "text": "ಇದೆಲ್ಲ ಏನೋ ಆರ್ಟ್ ಗ್ಯಾಲರಿ ಎಲ್ಲಾ ಮೋಸ ಮಾಡೋರಿಗೆ ಬರ್ತಾರೆ."
    },
    {
      "t": "00:41",
      "text": "ನಂಬರ್ ಕೊಡಿ ನಾನೇನು ಮೋಸಗಾರ್ತಿ ಅಲ್ಲ 300 rupees,"
    },
    {
      "t": "00:46",
      "text": "ಹಾಗೆ ಕೇಳ್ತೀನಿ ಅಲ್ವಾ ನನಗೂ ಹುಷಾರಿಲ್ಲ ನನಗೂ ಅಮೌಂಟ್ ಬೇಕು."
    },
    {
      "t": "00:51",
      "text": "ನೋಡಿ ನಾನೀಗ ನನ್ನ ಮೇಲೆ ನಂಬಿಕೆ ಬಂತು ಅಂದ್ರೆ ನಂಬರ್ ಕೊಡಿ."
    },
    {
      "t": "00:54",
      "text": "ನಾನೇನು 300 ರೂಪಾಯಿಗೋಸ್ಕರ ಏನು ಬ್ಲಾಕ್ ಮಾಡಲ್ಲ."
    },
    {
      "t": "00:57",
      "text": "ಮಾಡಿದಮೇಲೆ ಕಾಸ್ ಕೊಡಲಾ?"
    },
    {
      "t": "01:00",
      "text": "ಮಾಡಿದಮೇಲೆ ಕಾಸ್ ಕೊಡಲಾ?"
    },
    {
      "t": "01:02",
      "text": "ಹಿಂಗೆ ಹೇಳು ನಾನು ಹಿಂಗೆ ನಂಬಿ ಒಂದು ಇಬ್ಬರಿಗೆ ಮಾಡ್ಬಿಟ್ಟು ಲಾಸ್ಟಿಗೆ ಅವರು ನನಗೆ ದುಡ್ಡು ಹಾಕಿಲ್ಲ ನನಗೆ ಬ್ಲಾಕ್ ಮಾಡಿದ್ದಾರೆ."
    },
    {
      "t": "01:09",
      "text": "ಗೊತ್ತು."
    },
    {
      "t": "01:10",
      "text": "ನಾವು ಹೆಂಗೆ ನಂಬೋದು? ನಾನು ತುಂಬಾ ಕಡೆ."
    },
    {
      "t": "01:12",
      "text": "ನಿಮ್ಮ ಇಷ್ಟ ಯಾರು ದುಡ್ಡು ಹಾಕದಲೆ ಮಾಡಲ್ಲ ನಿಮಗೆ ಗೊತ್ತು."
    },
    {
      "t": "01:15",
      "text": "ಒಬ್ಬೊಬ್ಬರು ದುಡ್ಡು ಹಾಕಿಸಿಕೊಂಡು ಬ್ಲಾಕ್ ಮಾಡ್ಕೊಂಡೆ ಹೋಗ್ತಾರೆ."
    },
    {
      "t": "01:18",
      "text": "ನಾನು ಹೇಳ್ತಿದ್ದೀನಿ ನಾನು ಜೆನ್ಯೂನ್ ಆಗಿ ಇರ್ತೀನಿ ಅಂತ."
    },
    {
      "t": "01:21",
      "text": "ನೀವು ಮಾಡ್ತೀರಾ ಅಂದ್ರೆ ನಂಬರ್ ಕೊಡಿ ಸುಮ್ನೆ ಇಲ್ಲ ಕಟ್ ಮಾಡಿ."
    }
  ]
}