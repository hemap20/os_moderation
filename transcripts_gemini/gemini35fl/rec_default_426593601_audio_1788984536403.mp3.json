    },
    {
      "t": "00:55",
      "text": "கிட்ட கிட்ட வச்சு பேச வேண்டாம்"
    },
    {
      "t": "01:00",
      "text": "கிட்ட வச்சுதா பேசணும் சொல்லுங்க"
    },
    {
      "t": "01:02",
      "text": "கேக்க மாட்டேங்குது காதுல வச்சு பேசுங்க"
    },
    {
      "t": "01:05",
      "text": "சொல்லுங்க"
    },
    {
      "t": "01:10",
      "text": "ஆப் எவ்வளோ நாள் எப்படி போயிட்டு இருக்குன்னு?"
    },
    {
      "t": "01:13",
      "text": "நான் ஒரு த்ரீ டேஸ் ஆகி ஓபன் பண்ணி த்ரீ டேஸ் ஆச்சு ஆனா இன்னைக்கு தான் வந்துருக்கேன்."
    },
    {
      "t": "01:19",
      "text": "ஓகே எப்படி பேசி இருக்கேன் எப்படி பேசணும்னு"
    },
    {
      "t": "01:23",
      "text": "எப்படி பேசி இருக்க எப்படி பேசினா பிடிக்கும்னு"
    },
    {
      "t": "01:27",
      "text": "ம் நல்லா பேசலாமே"
    },
