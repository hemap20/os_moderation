  "segments": [
    {
      "t": "00:07",
      "text": "എവിടുന്ന് ആണ്?"
    },
    {
      "t": "00:09",
      "text": "അമാലി"
    },
    {
      "t": "00:11",
      "text": "എന്ത് പരിപാടി?"
    },
    {
      "t": "00:13",
      "text": "ഒരു പരിപാടിയും ഇല്ല വെറുതെ ഇരിക്കണം."
    },
    {
      "t": "00:18",
      "text": "ബാക്കിയുള്ളവരൊക്കെ എവിടെയാ വീട്ടിൽ ആരെങ്കിലുമുണ്ട്?"
    },
    {
      "t": "00:21",
      "text": "ഹസ്ബൻഡ് കുട്ടികൾ"
    },
    {
      "t": "00:23",
      "text": "അവരൊക്കെ എവിടെയാ?"
    },
    {
      "t": "00:24",
      "text": "കുട്ടികൾ സ്കൂളിൽ പോയി"
    },
    {
      "t": "00:26",
      "text": "ചേട്ടൻ"
    },
    {
      "t": "00:29",
      "text": "ജോലിക്ക് പോയി"
    },
    {
      "t": "00:31",
      "text": "അപ്പോ ചുമ്മാ ബോറടി ശരിയാണ്."
    },
    {
      "t": "00:37",
      "text": "അവിടെ ആരെങ്കിലും ഉണ്ടോ?"
    },
    {
      "t": "00:38",
      "text": "ഇവിടെ അച്ഛനമ്മയാണ് അനിയൻ അനിയത്തി എത്ര പേരൊക്കെ"
    },
    {
      "t": "00:41",
      "text": "കേട്ടില്ല"
    },
    {
      "t": "00:43",
      "text": "അച്ഛനമ്മ അനിയൻ അനിയത്തി"
    },
    {
      "t": "00:47",
      "text": "മാരീഡ് ആണോ അല്ലല്ല അല്ലല്ല"
    },
    {
      "t": "00:54",
      "text": "വർക്ക് ഇല്ലേ എന്ന്"
    },
    {
      "t": "00:56",
      "text": "എന്നാലും ഇവിടുത്തെ"
    },
    {
      "t": "00:58",
      "text": "അവിടെ സ്ഥലം എവിടെയൊക്കെയാ?"
    },
    {
      "t": "01:00",
      "text": "തൃശൂർ തൃശൂർ തൃശൂർ"
    },
    {
      "t": "01:03",
      "text": "തൃശൂർ ആണ്"
    },
    {
      "t": "01:05",
      "text": "അതാരം പാപ്പ അല്ല"
    },
    {
      "t": "01:07",
      "text": "എന്തായാലും ഫ്രണ്ട്സിനെ കിട്ടിയാ?"
    },
    {
      "t": "01:10",
      "text": "നിങ്ങൾ എത്ര കാലമായി ഇതില്?"
    },
    {
      "t": "01:14",
      "text": "രണ്ടാഴ്ച"
    },
    {
      "t": "01:16",
      "text": "ഞാൻ ഏകദേശം അത്ര തന്നെ ആയിട്ടുള്ളൂ"
    },
    {
      "t": "01:20",
      "text": "രണ്ടാഴ്ച"
    },
    {
      "t": "01:23",
      "text": "ഓക്കേ എങ്ങനെയുണ്ട് ചേട്ടന്മാരൊക്കെ വന്നിട്ട് എന്തെങ്കിലും ഒക്കെ ചോദിച്ചിരുന്നോ?"
    },
    {
      "t": "01:28",
      "text": "ചേട്ടന്മാർ വന്ന് പണിയില്ലാതെ അല്ലേ വരുന്നേ ചോദിക്കാൻ വേണ്ടിയിട്ടാണല്ലോ വരുന്നേ"
    },
    {
      "t": "01:32",
      "text": "ചേച്ചിമാർ"
    },
    {
      "t": "01:33",
      "text": "കുറെ ചേച്ചിമാരും കുഴപ്പമൊന്നുമില്ല ഞാനൊക്കെ നേരിട്ട് അനുഭവിച്ചത്"
    },
    {
      "t": "01:39",
      "text": "നേരിട്ട് അനുഭവിച്ച"
    },
    {
      "t": "01:41",
      "text": "നേരിട്ടിട്ട് അനുഭവിച്ചു എന്ന് പറഞ്ഞാൽ ഒരെണ്ണം കിട്ടി"
    },
    {
      "t": "01:47",
      "text": "ഓ അങ്ങനെ നേരിട്ടാ"
    },
    {
      "t": "01:50",
      "text": "കൊച്ചിയിലേക്ക് വന്നു"
    },
    {
      "t": "01:54",
      "text": "അതൊക്കെ അതല്ലേ കാര്യങ്ങളല്ലേ"
    },
    {
      "t": "01:57",
      "text": "എന്ത് പറ്റി?"
    },
    {
      "t": "02:00",
      "text": "ഒരു ചെറിയ ഇപ്പോ ഒരു കുറവ്"
    },
    {
      "t": "02:03",
      "text": "എന്ത് കുറവ്?"
    },
    {
      "t": "02:07",
      "text": "എന്താ പറയുക ഒരു"
    },
    {
      "t": "02:10",
      "text": "പഞ്ചിങ് കുറവ്"
    },
    {
      "t": "02:12",
      "text": "ഉന്മേശക്കുറവ്"
    },
    {
      "t": "02:20",
      "text": "പിന്നെ ഫ്രണ്ട്സ് ഒക്കെ ആയോ നോർമലി"
    },
    {
      "t": "02:25",
      "text": "ചില ആൾക്കാര്"
    },
    {
      "t": "02:27",
      "text": "വിളിക്കാറുണ്ടോ?"
    },
    {
      "t": "02:28",
      "text": "ടെലിഗ്രാമിൽ ചാറ്റ് ചെയ്യും"
    },
    {
      "t": "02:32",
      "text": "എന്താ വർക്ക് ചെയ്യുന്നത്?"
    },
    {
      "t": "02:34",
      "text": "എനിക്ക് സ്വന്തമായിട്ട് ഷോപ്പാ"
    },
    {
      "t": "02:37",
      "text": "തൃശൂർ തന്നെയാ?"
    },
    {
      "t": "02:38",
      "text": "തൃശൂർ"
    },
    {
      "t": "02:41",
      "text": "എന്തിന്റെയാ?"
    },
    {
      "t": "02:43",
      "text": "എന്താ?"
    },
    {
      "t": "02:44",
      "text": "എന്തിന്റെ ഷോപ്പാണ്?"
    },
    {
      "t": "02:45",
      "text": "ബുള്ലറ്റിന്റെ സ്പെയർ പാർട്സ് ബൈക്കിന്റെ സ്പെയർ പാർട്സുകൾ ഹോൾസെയിലും റീട്ടെയിലും"
    },
    {
      "t": "02:50",
      "text": "ഹോൾസെയിൽ ഉണ്ട്"
    },
    {
      "t": "02:52",
      "text": "ഹോൾസെയിലും ഉണ്ട് റീട്ടെയിലും ഉണ്ട്"
    },
    {
      "t": "02:56",
      "text": "എന്തായാലും നന്നായിട്ട് എന്താ?"
    },
    {
      "t": "02:58",
      "text": "ഇന്ന് പോയില്ലേന്ന്"
    },
    {
      "t": "02:59",
      "text": "ഇന്ന് ഇന്ന് പോയില്ല"
    },
    {
      "t": "03:01",
      "text": "വേറെ കുറച്ച് പരിപാടികൾ ഉണ്ട്"
    },
    {
      "t": "03:04",
      "text": "എന്തായാലും കാര്യങ്ങളൊക്കെ പരിചയപ്പെട്ടതിൽ ഒത്തിരി സന്തോഷം നോർമൽ ചാറ്റ് എന്നല്ലേ നിങ്ങൾ ഉദ്ദേശിക്കുന്നത്"
    },
    {
      "t": "03:10",
      "text": "നല്ലതാ നന്നായത്"
    }
  ]
}