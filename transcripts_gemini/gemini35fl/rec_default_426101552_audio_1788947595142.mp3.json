  "segments": [
    {
      "t": "00:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:03",
      "text": "ಹಾಯ್"
    },
    {
      "t": "00:05",
      "text": "ಹಾಯ್ ಹೇಗಿದ್ದೀರಾ?"
    },
    {
      "t": "00:07",
      "text": "ಚೆನ್ನಾಗಿದ್ದೀನಿ ನೀವು?"
    },
    {
      "t": "00:10",
      "text": "ಚೆನ್ನಾಗಿದ್ದೀನಿ. ಯಾಕಣ್ಣು ಹಾಂಗೆ ಇರ್ತೀರಾ?"
    },
    {
      "t": "00:13",
      "text": "ಹೂ ಕಣ್ಣು ಇರೋದು ನೋಡೋದಕ್ಕೆ ನೋಡಬಾರದಾ?"
    },
    {
      "t": "00:18",
      "text": "ಹೌದು"
    },
    {
      "t": "00:19",
      "text": "ನೀವು ಯಾಕೆ ನನ್ನ ಹಂಗೆ ನೋಡ್ತಾ ಇದ್ದೀರಾ ಹಂಗಾದ್ರೆ?"
    },
    {
      "t": "00:24",
      "text": "ಕೇಳಿಸ್ತಾ ಇಲ್ಲ ನಿಮ್ಮ ವಾಯ್ಸ್ ಬ್ರೇಕ್ ಆಯ್ತು."
    },
    {
      "t": "00:29",
      "text": "ಏನ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ?"
    },
    {
      "t": "00:30",
      "text": "ಆಯ್ತು ಕೆಲಸ ಮಾಡ್ತಾ ಇದೀನಿ ನೀವು"
    },
    {
      "t": "00:33",
      "text": "ಐ ಆಮ್ ಆಲ್ಸೋ ವರ್ಕಿಂಗ್ ಅಂಡ್ ಐ ಆಮ್ ಎ ಸ್ಪೋರ್ಟ್ಸ್ ಜಿಮ್ ಫಿಟ್ನೆಸ್ ಟ್ರೈನರ್."
    },
    {
      "t": "00:44",
      "text": "ಮತ್ತೆ ನೀವು ಏನ್ ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ?"
    },
    {
      "t": "00:47",
      "text": "ಅಕೌಂಟೆಂಟ್."
    },
    {
      "t": "00:49",
      "text": "ಓಕೆ ನೈಸ್, ಏನಕ್ಕೆ ಆಪ್ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ?"
    },
    {
      "t": "00:53",
      "text": "ನೀವೇನಕ್ಕೆ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ?"
    },
    {
      "t": "00:55",
      "text": "ಲುಕಿಂಗ್ ಫಾರ್ ಫ್ರೆಂಡ್ಸ್"
    },
    {
      "t": "00:59",
      "text": "ಲೈಫ್ ಟೈಮ್ ಪಾಸ್."
    },
    {
      "t": "01:00",
      "text": "ಟೈಮ್ ಪಾಸ್ ಓಕೆ."
    },
    {
      "t": "01:03",
      "text": "ಓಕೆ ಎಂಜಾಯ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ?"
    },
    {
      "t": "01:06",
      "text": "ಎಂಜಾಯ್ ಆ?"
    },
    {
      "t": "01:08",
      "text": "ಇನ್ನೇನು ಇದಕ್ಕೆ ಟೈಮ್ ಪಾಸ್ ಅಂದ್ರೆ ಏನು? ವಾಟ್ ಈಸ್ ದ ಟೈಮ್ ಪಾಸ್?"
    },
    {
      "t": "01:12",
      "text": "ಬೋರ್ ಅಡಿಸ್ತಾ ಇದೆ ಅದಕ್ಕೆ ಮಾತಾಡೋದು."
    },
    {
      "t": "01:15",
      "text": "ಮ್ಯಾರಿಡ್ ಆರ್ ಸಿಂಗಲ್?"
    },
    {
      "t": "01:18",
      "text": "ಸಿಂಗಲ್?"
    },
    {
      "t": "01:21",
      "text": "ಬಾಯ್ ಫ್ರೆಂಡ್?"
    },
    {
      "t": "01:23",
      "text": "ಇಷ್ಟು ದಿನ ಇಲ್ಲಿದ್ದಾರಾ?"
    },
    {
      "t": "01:25",
      "text": "ಇಲ್ಲಪ್ಪ ಅದಕ್ಕೆ ನಾನು ಈ ಆಪ್ ಯೂಸ್ ಮಾಡ್ತಾ ಇರೋದು."
    },
    {
      "t": "01:28",
      "text": "ಹೇ ಇಷ್ಟೊಂದು ಸಾಧನ ಬೇಡ."
    },
    {
      "t": "01:30",
      "text": "ನೀವೆಲ್ಲರ ಜೊತೆ ಇರಲ್ವಲ್ಲಾ?"
    },
    {
      "t": "01:35",
      "text": "ಅರ್ಥ ಆಗಿಲ್ಲ."
    }
  ]
}