  "segments": [
    {
      "t": "00:10",
      "text": "नहीं अभी कौन सा है लाइट ऑफ करके"
    },
    {
      "t": "00:14",
      "text": "क्या बोलूं?"
    },
    {
      "t": "00:15",
      "text": "लाइट तो ऑन कर लो"
    },
    {
      "t": "00:17",
      "text": "वेट लाइट चालू करने दो"
    },
    {
      "t": "00:20",
      "text": "हम कर लो"
    },
    {
      "t": "00:25",
      "text": "अकेली हो के रूम पे?"
    },
    {
      "t": "00:28",
      "text": "हां जी"
    },
    {
      "t": "00:30",
      "text": "कोई पास में नहीं है क्या?"
    },
    {
      "t": "00:33",
      "text": "नहीं"
    },
    {
      "t": "00:35",
      "text": "अच्छा फिंगरिंग करते हो"
    },
    {
      "t": "00:38",
      "text": "हां?"
    },
    {
      "t": "00:39",
      "text": "फिंगरिंग किए हो कभी?"
    },
    {
      "t": "00:41",
      "text": "ड्रिंक"
    },
    {
      "t": "00:43",
      "text": "फिंगरिंग किए हो कभी?"
    },
    {
      "t": "00:45",
      "text": "हेलो"
    },
    {
      "t": "00:47",
      "text": "फिंगरिंग किए हो कभी आप?"
    },
    {
      "t": "00:49",
      "text": "क्या जी?"
    },
    {
      "t": "00:51",
      "text": "फिंगरिंग"
    },
    {
      "t": "00:53",
      "text": "नो"
    },
    {
      "t": "00:55",
      "text": "अच्छा क्यों करने का मन नहीं करता है अकेले में?"
    },
    {
      "t": "00:59",
      "text": "नहीं"
    },
    {
      "t": "01:01",
      "text": "अच्छा मेरे को तो करने का मन करता है अकेले में"
    },
    {
      "t": "01:05",
      "text": "नहीं मुझे नहीं दिखता"
    },
    {
      "t": "01:09",
      "text": "क्यों नहीं बेबी यार? किसी का नहीं ये भी नहीं होता"
    },
    {
      "t": "01:14",
      "text": "हूँ"
    },
    {
      "t": "01:14",
      "text": "मतलब किसी का नहीं ये भी नहीं होता"
    },
    {
      "t": "01:17",
      "text": "नहीं करता बस तो"
    },
    {
      "t": "01:20",
      "text": "यार आपकी कितनी बड़े हैं बाप रे"
    },
    {
      "t": "01:24",
      "text": "क्या हुआ?"
    },
    {
      "t": "01:25",
      "text": "आपकी कितनी बड़े-बड़े बूफ़्स हैं"
    },
    {
      "t": "01:28",
      "text": "बिना दबाए हुए इतना बड़ा कैसे हो गया?"
    },
    {
      "t": "01:34",
      "text": "वह मैं लड़की नहीं हूँ क्या?"
    },
    {
      "t": "01:37",
      "text": "हूँ?"
    },
    {
      "t": "01:38",
      "text": "लड़की हूँ ना, तो नॉर्मली चीज़ है ओके।"
    },
    {
      "t": "01:42",
      "text": "फिर भी कैसे इतना बड़ा हो गया बेबी?"
    },
    {
      "t": "01:45",
      "text": "वह मैं लड़की हूँ तो नॉर्मल चीज़ है, भगवान का दिया हुआ है।"
    },
    {
      "t": "01:50",
      "text": "नहीं एक होता है ना दबाने से बड़ा हो जाता है।"
    },
    {
      "t": "01:54",
      "text": "एज के अकॉर्डिंग सब इंप्रूव होता है।"
    },
    {
      "t": "01:58",
      "text": "तो नहीं कैमरा नीचे करो ना।"
    },
    {
      "t": "02:00",
      "text": "क्या?"
    },
    {
      "t": "02:01",
      "text": "कैमरा नीचे करो ना।"
    },
    {
      "t": "02:06",
      "text": "क्या बोल रहे हो?"
    },
    {
      "t": "02:07",
      "text": "कैमरा नीचे करो ना।"
    },
    {
      "t": "02:11",
      "text": "कैमरा मेरा इतना ही दिखता है।"
    },
    {
      "t": "02:13",
      "text": "मतलब हल्का नीचे करो आपके बुक्स का साइज़ देखना है एक बार और।"
    },
    {
      "t": "02:21",
      "text": "अच्छा।"
    },
    {
      "t": "02:22",
      "text": "हाँ नीचे करो, हल्का नीचे करो।"
    },
    {
      "t": "02:26",
      "text": "अब हम में कोई नहीं है क्या? बुक्स निकाल लो ना।"
    },
    {
      "t": "02:31",
      "text": "क्या?"
    },
    {
      "t": "02:33",
      "text": "अपना बुक्स निकाल लो ना, टीशर्ट्स के बाहर निकालो ना।"
    },
    {
      "t": "02:39",
      "text": "अच्छा जी।"
    },
    {
      "t": "02:40",
      "text": "हाँ।"
    },
    {
      "t": "02:43",
      "text": "वैसे आप हैं कहाँ से?"
    },
    {
      "t": "02:45",
      "text": "मैं बिहार से हूँ।"
    },
    {
      "t": "02:47",
      "text": "कहाँ से?"
    },
    {
      "t": "02:48",
      "text": "बिहार से बिहार।"
    },
    {
      "t": "02:51",
      "text": "अच्छा।"
    },
    {
      "t": "02:54",
      "text": "निकालो ना।"
    },
    {
      "t": "02:56",
      "text": "मैं दिल्ली से हूँ।"
    },
    {
      "t": "02:58",
      "text": "हूँ?"
    },
    {
      "t": "03:00",
      "text": "क्या बोले?"
    },
    {
      "t": "03:02",
      "text": "मैं दिल्ली से हूँ।"
    },
    {
      "t": "03:04",
      "text": "पहले क्या थी?"
    },
    {
      "t": "03:06",
      "text": "क्या?"
    },
    {
      "t": "03:08",
      "text": "क्या बोले आप?"
    },
    {
      "t": "03:10",
      "text": "मैंने बोला मैं दिल्ली से हूँ।"
    },
    {
      "t": "03:12",
      "text": "अच्छा आप दिल्ली से हो, अपना बुक्स निकालो ना।"
    },
    {
      "t": "03:18",
      "text": "क्या बोल रहे हो?"
    },
    {
      "t": "03:20",
      "text": "आप अपना बुक्स निकालो ना।"
    },
    {
      "t": "03:23",
      "text": "नो सॉरी।"
    },
    {
      "t": "03:26",
      "text": "आप अपना तो फेस तो शो कर नहीं रहे हो, मेरा फेस शो करवा रहे हो, अपना फेस या तो शो करो या तो मैं वीडियो कॉल बंद करती हूँ।"
    },
    {
      "t": "03:34",
      "text": "नहीं यार नहीं ही ला रहा हूँ।"
    },
    {
      "t": "03:36",
      "text": "आप अपना फेस शो करवाओ ना, आप तो मेरा फेस देख रहे हो, आप भी अपना फेस दिखाओ आप कैसे हो, कैसे नहीं।"
    },
    {
      "t": "03:43",
      "text": "नहीं यार नहीं ला रहा हूँ, देखो कितना बड़ा है।"
    },
    {
      "t": "03:48",
      "text": "हूँ?"
    },
    {
      "t": "03:49",
      "text": "आप कैमरे के सामने आएंगे?"
    },
    {
      "t": "03:52",
      "text": "आप मेरा देखोगे?"
    },
    {
      "t": "03:57",
      "text": "देखोगे आप?"
    },
    {
      "t": "03:59",
      "text": "क्या?"
    },
    {
      "t": "04:00",
      "text": "आप मेरा देखोगे?"
    },
    {
      "t": "04:03",
      "text": "आप कैमरे के सामने आएंगे? अपना फेस दिखाएंगे?"
