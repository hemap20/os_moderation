    {
      "t": "04:41",
      "text": "ഉം?"
    },
    {
      "t": "04:42",
      "text": "പറ."
    },
    {
      "t": "04:44",
      "text": "കളിക്കാൻ മൂഡ് ഉണ്ടോ?"
    },
    {
      "t": "04:46",
      "text": "എന്തുവാ?"
