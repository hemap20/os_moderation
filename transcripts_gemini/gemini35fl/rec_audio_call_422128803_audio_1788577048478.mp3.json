    {
      "t": "01:39",
      "text": "പിന്നെ."
    },
    {
      "t": "01:41",
      "text": "പിന്നെന്താ പറ."
    },
    {
      "t": "01:44",
      "text": "പറയൂ."
    },
    {
      "t": "01:46",
      "text": "താൻ പറ."
