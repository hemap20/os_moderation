  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:06",
      "text": "ನಿಮ್ಮ ಹೆಸರೇನು?"
    },
    {
      "t": "00:08",
      "text": "ನನ್ನ ಹೆಸರು ಸಂತೋಷ್ ಅಂತ, ನಿಮ್ಮ ಹೆಸರು?"
    },
    {
      "t": "00:10",
      "text": "ನನ್ನ ಹೆಸರು ಇಂಪನ ಅಂತ."
    },
    {
      "t": "00:14",
      "text": "ರೋಬಾಲಿ?"
    },
    {
      "t": "00:15",
      "text": "ಇಂಪನ"
    },
    {
      "t": "00:17",
      "text": "ಇಂಪನ"
    },
    {
      "t": "00:19",
      "text": "ಮತ್ತೆ ಊಟ ಆಯ್ತಾ?"
    },
    {
      "t": "00:22",
      "text": "ನಂದು ಆಯ್ತು, ನಿಮ್ದು ಆಯ್ತಾ?"
    },
    {
      "t": "00:24",
      "text": "ಆಗಿದೆ ಮೇಡಂ, ನಂದು ಆಗಿದೆ, ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ."
    },
    {
      "t": "00:28",
      "text": "ಹೌದಾ, ನೀವೆಷ್ಟು ದಿನದಿಂದ ಈ ಆಪ್ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ?"
    },
    {
      "t": "00:31",
      "text": "ಒಂದು 15 ಡೇಸ್"
    },
    {
      "t": "00:34",
      "text": "15 ಡೇಸ್, ನಿಮಗೆ ಯಾರು ಸಜೆಸ್ಟ್ ಮಾಡಿದ್ದು ಯೂಸ್ ಮಾಡಿ ಅಂತ?"
    },
    {
      "t": "00:38",
      "text": "ಮಾಡು ಅಂತಲ್ಲ ಏನು ಫೇಸ್ಬುಕ್ ಅಲ್ಲಿ ಬಂತು ಮಾಡಿದೆ, ಓಕೆ, ಮಾಡಬಾರದ ವಯಸ್ಸಲ್ಲ ಮಾಡಬಾರದು, ಮಾಡೋ ವಯಸ್ಸಲ್ಲ ನಂದು."
    },
    {
      "t": "00:45",
      "text": "ಅದು ನಿಮ್ಮ ಮೇಲೆ ಡಿಪೆಂಡ್, ನಿಮ್ಮ ಮೇಲೆ ಡಿಪೆಂಡ್ ಅಲ್ವಾ, ನಾವು ಹೇಳೋರು ಕೇಳೋರಲ್ಲ, ಐ ಜಸ್ಟ್ ಆಸ್ಕ್ಡ್."
    },
    {
      "t": "00:51",
      "text": "ಮತ್ತೆ?"
    },
    {
      "t": "00:53",
      "text": "ಮತ್ತೆ ಮದುವೆ ಆಗಿದ್ಯಾ, ಎಷ್ಟು ಮಕ್ಕಳು?"
    },
    {
      "t": "00:55",
      "text": "ಮದುವೆ ಆಗಿದೆ ಮೂರು ಮಕ್ಕಳಿದೆ, ನನಗೆ ಸೆಕ್ಸ್ ಬಗ್ಗೆ ಇಂಟರೆಸ್ಟ್, ಇನ್ನು ಮಾಡಬೇಕು, ಮಾಡಬೇಕು ಅನ್ಸುತ್ತೆ ಸೆಕ್ಸ್."
    },
    {
      "t": "01:01",
      "text": "ದಿನಾಲು ಬೇಕು ನನಗೆ."
    },
    {
      "t": "01:03",
      "text": "ದಿನಾಲು ಬೇಕು."
    },
    {
      "t": "01:05",
      "text": "ನಿಮ್ಮ ಹೆಂಡತಿ ರೆಡಿ ಇದ್ರೆ ಮಾಡಿ."
    },
    {
      "t": "01:08",
      "text": "ನಿಮ್ಮದು ಆಗಿಲ್ವಾ?"
    },
    {
      "t": "01:10",
      "text": "ನಾವಿಲ್ಲ, ನಾವಿನ್ನೂ ಓದ್ತಾ ಇದ್ದೀವಿ, ಓದ್ಕೊಂಡಿರೋದು."
    },
    {
      "t": "01:15",
      "text": "ಮತ್ತೆ?"
    },
    {
      "t": "01:18",
      "text": "ಮತ್ತೆ ಹೇಳಿ."
    },
    {
      "t": "01:20",
      "text": "ಮನೇಲಿ ಹೆಂಡತಿಗೆ ಗೊತ್ತಾ ಯೂಸ್ ಮಾಡೋದು?"
    },
    {
      "t": "01:23",
      "text": "ಗೊತ್ತಿಲ್ಲ."
    },
    {
      "t": "01:25",
      "text": "ಗೊತ್ತಾದ್ರೆ?"
    },
    {
      "t": "01:27",
      "text": "ಕುಡಿತಾರೆ ಇಡೋದು."
    },
    {
      "t": "01:31",
      "text": "ನಿಮ್ಮ ಹತ್ರ ಫ್ರೆಂಡ್ಸ್ ಸಿಗಲ್ವಾ ನಿಮಗೆ?"
    },
    {
      "t": "01:35",
      "text": "ಮನೇಲಿ ಹೆಂಡತಿ ಇರಬೇಕಾದ್ರೆ ಯಾಕೆ ಯೂಸ್ ಮಾಡೋದು, ಸುಮ್ನೆ ಪ್ರಾಬ್ಲಮ್ ಅಲ್ವಾ?"
    },
    {
      "t": "01:41",
      "text": "ಬೇಕಲ್ಲ ಒಬ್ಬರು ಸಂಗಾತಿ."
    }
  ]
}