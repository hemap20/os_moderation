  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": "ಹಾಯ್"
    },
    {
      "t": "00:06",
      "text": "ಹಾಯ್ ಹೇಗಿದ್ದೀರಾ"
    },
    {
      "t": "00:08",
      "text": "ಚೆನ್ನಾಗಿದ್ದೀನಿ ನೀವು"
    },
    {
      "t": "00:10",
      "text": "ನಾನು ಚೆನ್ನಾಗಿದ್ದೀನಿ ಯಾಕೆ ಅನ್ಮ್ಯೂಟ್ ಆಗಿದ್ದೀರಾ"
    },
    {
      "t": "00:13",
      "text": "ನೋ ಕಣ್ಣಿರೋದನ್ನ ನೋಡೋದಕ್ಕೆ ನೋಡಬಾರದ"
    },
    {
      "t": "00:17",
      "text": "ಹೌದು"
    },
    {
      "t": "00:19",
      "text": "ನೀವು ಯಾಕೆ ನನ್ನ ಹಂಗೆ ನೋಡ್ತಾ ಇದ್ದೀರಾ ಹಂಗಾದ್ರೆ"
    },
    {
      "t": "00:24",
      "text": "ಕಾಯ್ ಕೇಳಿಸ್ತಾ ಇಲ್ಲ ನಿಮ್ಮ ವಾಯ್ಸ್ ಬ್ರೇಕ್ ಆಯ್ತು"
    },
    {
      "t": "00:29",
      "text": "ಏನ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "00:30",
      "text": "ಹಾಯ್ ಕೇಳಿಸ್ತಾ ಇದೆ"
    },
    {
      "t": "00:31",
      "text": "ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ ನೀವು"
    },
    {
      "t": "00:33",
      "text": "ಐ ಆಮ್ ಆಲ್ಸೋ ವರ್ಕಿಂಗ್ ಅಂಡ್ ಐ ಆಮ್ ಎ ಸ್ಪೋರ್ಟ್ಸ್ ಜಿಮ್ ಫಿಟ್ನೆಸ್ ಟ್ರೈನರ್"
    },
    {
      "t": "00:44",
      "text": "ಮತ್ತೆ ನೀವು ಏನು ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "00:47",
      "text": "ಅಕೌಂಟೆಂಟ್"
    },
    {
      "t": "00:49",
      "text": "ಓಕೆ ನೈಸ್ ಏನಕ್ಕೆ ಆಪ್ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "00:53",
      "text": "ನೀವೇನಕ್ಕೆ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "00:56",
      "text": "ಲುಕಿಂಗ್ ಫಾರ್ ಫ್ರೆಂಡ್"
    },
    {
      "t": "00:59",
      "text": "ನನ್ ಟೈಮ್ ಪಾಸ್"
    },
    {
      "t": "01:01",
      "text": "ಟೈಮ್ ಪಾಸ್ ಓಕೆ"
    },
    {
      "t": "01:04",
      "text": "ಓಕೆ ಎಂಜಾಯ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "01:06",
      "text": "ಎಂಜಾಯ್ ಯಾಕೆ"
    },
    {
      "t": "01:08",
      "text": "ಇನ್ನೇನಕ್ಕೆ ಟೈಮ್ ಪಾಸ್ ಅಂದ್ರೆ ಏನು ವಾಟ್ ಇಸ್ ದ ಟೈಮ್ ಪಾಸ್"
    },
    {
      "t": "01:12",
      "text": "ಬೋರ್ ಹೊಡಿತಿದೆ ಅದಕ್ಕೆ ಮಾತಾಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "01:15",
      "text": "ಹು ಹು"
    },
    {
      "t": "01:16",
      "text": "ಮ್ಯಾರೀಡ್ ಆರ್ ಸಿಂಗಲ್"
    },
    {
      "t": "01:18",
      "text": "ಸಿಂಗಲ್"
    },
    {
      "t": "01:20",
      "text": "ಬಾಯ್ ಫ್ರೆಂಡ್ಸ್"
    },
    {
      "t": "01:23",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "01:24",
      "text": "ಇಲ್ಲಪ್ಪ ಅದಕ್ಕೆ ನಾನು ಈ ಆಪ್ ಯೂಸ್ ಮಾಡ್ತಾ ಇರೋದು"
    },
    {
      "t": "01:29",
      "text": "ಹೇ ಇಟ್ಕೊಳ್ಳೋಕೆ ಆಗಲ್ಲ ಬಿಡ"
    },
    {
      "t": "01:31",
      "text": "ಹ"
    },
    {
      "t": "01:32",
      "text": "ನೀವು ಎಲ್ಲರಿಗೂ ಇರಲ್ಲ ಅಲ್ವಾ"
    },
    {
      "t": "01:35",
      "text": "ಅರ್ಥ ಆಗಿಲ್ಲ"
    }
  ]
}