  "segments": [
    {
      "t": "00:08",
      "text": "എവിടെയാണ്?"
    },
    {
      "t": "00:09",
      "text": "മാലി"
    },
    {
      "t": "00:11",
      "text": "എന്താ പരിപാടി?"
    },
    {
      "t": "00:13",
      "text": "ഒരു പരിപാടിയുമില്ല വെറുതെ ഇരിക്കുകയാണ്"
    },
    {
      "t": "00:16",
      "text": "ഓക്കേ ഓക്കേ ഓക്കേ"
    },
    {
      "t": "00:18",
      "text": "ബാക്കിയുള്ളവരൊക്കെ എവിടെയാ? വീട്ടിൽ ആരൊക്കെയുണ്ട്?"
    },
    {
      "t": "00:20",
      "text": "ഹസ്ബൻഡ് കുട്ടികൾ"
    },
    {
      "t": "00:22",
      "text": "അവരൊക്കെ എവിടെയാ?"
    },
    {
      "t": "00:25",
      "text": "കുട്ടികൾ സ്കൂളിൽ പോയി"
    },
    {
      "t": "00:27",
      "text": "ചേട്ടൻ?"
    },
    {
      "t": "00:29",
      "text": "ജോലിക്ക് പോയി"
    },
    {
      "t": "00:31",
      "text": "അപ്പൊ ചുമ്മാ ബോറടിച്ചു ഇരിക്കുകയാണ്"
    },
    {
      "t": "00:35",
      "text": "അവിടെ ആരൊക്കെയുണ്ട്?"
    },
    {
      "t": "00:37",
      "text": "ഇവിടെ അച്ഛൻ അമ്മ അനിയൻ അനിയത്തി അത്രേ ഉള്ളൂ"
    },
    {
      "t": "00:41",
      "text": "അച്ഛൻ അമ്മ അനിയൻ അനിയത്തി"
    },
    {
      "t": "00:46",
      "text": "മാര്യഡ് ആണോ?"
    },
    {
      "t": "00:48",
      "text": "അല്ലല്ല"
    },
    {
      "t": "00:51",
      "text": "എന്താ?"
    },
    {
      "t": "00:53",
      "text": "വർക്കില്ലേ എന്ന്"
    },
    {
      "t": "00:56",
      "text": "ഇന്നലെ ഇവിടുത്തെ"
    },
    {
      "t": "00:58",
      "text": "അവിടെ സ്ഥലം എവിടെയാ?"
    },
    {
      "t": "01:00",
      "text": "തൃശ്ശൂർ തൃശ്ശൂർ തൃശ്ശൂർ"
    },
    {
      "t": "01:03",
      "text": "തൃശ്ശൂർ ആണ്"
    },
    {
      "t": "01:05",
      "text": "എന്തായാലും കുഴപ്പമില്ല"
    },
    {
      "t": "01:07",
      "text": "എന്തായാലും വല്ല ഫ്രണ്ട്സിനെയും കിട്ടിയോ?"
    },
    {
      "t": "01:10",
      "text": "നിങ്ങൾ എത്ര കാലമായി ഇതിൽ?"
    },
    {
      "t": "01:13",
      "text": "രണ്ടാഴ്ച"
    },
    {
      "t": "01:15",
      "text": "ഞാൻ ഏകദേശം അത്ര തന്നെ ആയിട്ടുള്ളൂ"
    },
    {
      "t": "01:20",
      "text": "രണ്ടാഴ്ച"
    },
    {
      "t": "01:22",
      "text": "ഓക്കേ എങ്ങനെയുണ്ട് ചേട്ടന്മാരൊക്കെ വന്നിട്ടുണ്ടോ? എന്തായാലും ഒക്കെ ചോദിച്ചായിരുന്നോ?"
    },
    {
      "t": "01:27",
      "text": "ചേട്ടന്മാർക്ക് പണിയില്ലാണ്ടല്ലേ വരുന്നത് ചോദിക്കാൻ വേണ്ടിയിട്ടല്ലേ വരുന്നേ"
    },
    {
      "t": "01:32",
      "text": "കുറെ ചേച്ചിമാരും കുഴപ്പമൊന്നുമില്ല"
    },
    {
      "t": "01:35",
      "text": "ഞാനൊക്കെ നേരിട്ട് അനുഭവിച്ചതാണ്"
    },
    {
      "t": "01:38",
      "text": "നേരിട്ട് അനുഭവിച്ചാ?"
    },
    {
      "t": "01:40",
      "text": "നേരിട്ട് അനുഭവിച്ചു എന്ന് പറഞ്ഞാൽ"
    },
    {
      "t": "01:43",
      "text": "ഒരെണ്ണം കിട്ടി"
    },
    {
      "t": "01:46",
      "text": "നേരിട്ടാ?"
    },
    {
      "t": "01:49",
      "text": "കൊച്ചിയിലേക്ക് വന്നു"
    },
    {
      "t": "01:53",
      "text": "അത് വലിയ കാര്യമില്ല"
    },
    {
      "t": "01:56",
      "text": "എന്ത് പറ്റി?"
    },
    {
      "t": "02:00",
      "text": "ഒരു ചെറിയ ഒരു കുറവ്"
    },
    {
      "t": "02:04",
      "text": "എന്ത് കുറവ്?"
    },
    {
      "t": "02:06",
      "text": "എന്താ പറയുക ഒരു"
    },
    {
      "t": "02:10",
      "text": "പഞ്ചിങ് കുറവ്"
    },
    {
      "t": "02:12",
      "text": "ഉന്മേഷ കുറവ്"
    },
    {
      "t": "02:15",
      "text": "കുഴപ്പമില്ല എന്തായാലും കാര്യം"
    },
    {
      "t": "02:19",
      "text": "പിന്നെ ഫ്രണ്ട്സ് ഒക്കെ ആയോ നോർമലി?"
    },
    {
      "t": "02:22",
      "text": "ആ കുറച്ചു ആൾക്കാര്"
    },
    {
      "t": "02:25",
      "text": "വിളിക്കാറുണ്ടോ?"
    },
    {
      "t": "02:27",
      "text": "ടെലിഗ്രാമിൽ ചാറ്റ് ചെയ്യും"
    },
    {
      "t": "02:31",
      "text": "എന്താ വർക്ക് ചെയ്യുന്നത്?"
    },
    {
      "t": "02:33",
      "text": "എനിക്ക് സ്വന്തമായിട്ട് ഷോപ്പാ"
    },
    {
      "t": "02:36",
      "text": "തൃശ്ശൂർ തന്നെയാ?"
    },
    {
      "t": "02:38",
      "text": "തൃശ്ശൂർ"
    },
    {
      "t": "02:40",
      "text": "എന്തിന്റെയാ?"
    },
    {
      "t": "02:42",
      "text": "എന്തിന്റെ ഷോപ്പാണ്?"
    },
    {
      "t": "02:44",
      "text": "ബുള്ളറ്റിന്റെ സ്പെയർ പാർട്സ് ബൈക്കിന്റെ സ്പെയർ പാർട്സുകൾ ഹോൾസെയിൽ റീട്ടെയിൽ"
    },
    {
      "t": "02:49",
      "text": "ഹോൾസെയിൽ ആണോ?"
    },
    {
      "t": "02:51",
      "text": "ഹോൾസെയിലും ഉണ്ട് റീട്ടെയിലും ഉണ്ട്"
    },
    {
      "t": "02:54",
      "text": "എന്തായാലും നടക്കട്ടെ"
    },
    {
      "t": "02:56",
      "text": "എന്താ?"
    },
    {
      "t": "02:58",
      "text": "ഇന്ന് പോയില്ലേ എന്ന്"
    },
    {
      "t": "03:00",
      "text": "ഇല്ല ഇന്ന് പോയില്ല വേറെ കുറച്ചു പരിപാടികൾ ഉണ്ട് അതുകൊണ്ട് പോയില്ല"
    },
    {
      "t": "03:04",
      "text": "എന്തായാലും കാര്യങ്ങളൊക്കെ കേട്ട പരിചയപ്പെട്ടതിൽ വളരെ സന്തോഷം നോർമൽ ചാറ്റ് അല്ലേ നിങ്ങൾ ഉദ്ദേശിക്കുന്നത്"
    },
    {
      "t": "03:10",
      "text": "നല്ലതാ നന്നായി അത്"
    }
  ]
}