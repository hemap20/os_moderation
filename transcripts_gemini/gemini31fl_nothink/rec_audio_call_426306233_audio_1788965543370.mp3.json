    },
    {
      "t": "00:04",
      "text": "ಹಾಯ್ ಎಲ್ಲಿಂದ ಮಾತಾಡ್ತಿದ್ದೀರಾ"
    },
    {
      "t": "00:06",
      "text": "ನಾನು ಬೆಂಗಳೂರಿನಿಂದ ನೀವು"
    },
    {
      "t": "00:08",
      "text": "ನಾನು ಬೆಂಗಳೂರಿನಿಂದಲೇ ಮಾತಾಡ್ತಿದ್ದೀನಿ"
    },
    {
      "t": "00:10",
      "text": "ನಾನಿವಾಗ ಎಂಬಿಎ ಕಂಪ್ಲೀಟ್ ಆಗಿದೆ ಸೋ ಮನೆಯಲ್ಲೇ ಇದ್ದೀನಿ"
    },
    {
      "t": "00:15",
      "text": "ಯಾಕೆ ಆತರ ಮಾತಾಡ್ತಿದ್ದೀರಾ ಸರಿ"
    },
    {
      "t": "00:18",
      "text": "ಸಾರಿ ಏನು ಅರ್ಥ ಆಗ್ಲಿಲ್ಲ ಕೇಳಿಸಲಿಲ್ಲ ಏನು"
    },
    {
      "t": "00:22",
      "text": "ಯಾಕೆ ಆತರ ಮಾತಾಡ್ತಿದ್ದೀರಾ ಸರಿ ನನಗೆ ಏನು ಅರ್ಥ ಆಗ್ಲಿಲ್ಲ"
    },
    {
      "t": "00:27",
      "text": "ನೀವು ಯಾವ ತರ ಮಾತಾಡ್ತೀರಾ"
    },
    {
      "t": "00:30",
      "text": "ಸೆಕ್ಸ್ ಬಗ್ಗೆನಾ"
    },
    {
      "t": "00:32",
      "text": "ಮಾತಾಡಬಹುದು ಬಟ್ ನನಗೇನು ಸಿಗುತ್ತೆ ಮಾತಾಡಿದ್ರೆ"
    },
    {
      "t": "00:36",
      "text": "ಏನ್ರಿ"
    },
    {
      "t": "00:38",
      "text": "ಮಾತಾಡಬಹುದು ಬಟ್ ಮಾತಾಡಿದ್ರೆ ನನಗೇನು ಸಿಗುತ್ತೆ"
    },
    {
      "t": "00:44",
      "text": "ಏನ್ರಿ"
    },
    {
      "t": "00:46",
      "text": "ಯಾರಿಗೆ ನಮಗ ನನಗ"
    },
    {
