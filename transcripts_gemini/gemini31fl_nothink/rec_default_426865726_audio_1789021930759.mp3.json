      "text": "ಹಲೋ"
    },
    {
      "t": "00:06",
      "text": "ಏನ್ ನಿಮ್ದು?"
    },
    {
      "t": "00:08",
      "text": "ಬೆಂಗಳೂರು ನಿಮ್ದು?"
    },
    {
      "t": "00:09",
      "text": "ನಾವ್ ಬೆಂಗಳೂರು"
    },
    {
      "t": "00:11",
      "text": "ಜೆಪಿ ನಗರ ನಿಮ್ದು?"
    },
    {
      "t": "00:14",
      "text": "ನಮ್ದು ಪಿನ್ಯಾ"
    },
    {
      "t": "00:17",
      "text": "ಬರ್ತಡೇ ಇರೋದು"
    },
    {
      "t": "00:20",
      "text": "ಗವರ್ನಮೆಂಟ್ ಸ್ಕೂಲ್"
    },
    {
      "t": "00:22",
      "text": "ಆಯ್ತು ತಿಂಡಿ ಹೋಗಿಲ್ವಾ ಇವತ್ತು?"
    },
    {
      "t": "00:25",
      "text": "ಇಲ್ಲ ಹೋಗಿಲ್ಲ"
    },
    {
      "t": "00:27",
      "text": "ಗೇಟ್"
    },
    {
      "t": "00:29",
      "text": "ನೀವು?"
    },
    {
      "t": "00:32",
      "text": "ಆಯ್ತು ತಿಂಡಿ ಊಟ?"
    },
    {
      "t": "00:35",
      "text": "ತಿಂಡಿ ಆಗಿಲ್ಲ ಇವಾಗ ಮಾಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "00:39",
      "text": "ನಿಮ್ದು?"
    },
    {
      "t": "00:41",
      "text": "ತಿಂಡಿ ಆಯ್ತು ಊಟ ಮಾಡಬೇಕು"
    },
    {
      "t": "00:44",
      "text": "ಹೌದಾ"
    },
    {
      "t": "00:45",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "00:48",
      "text": "ನೀವೇ ಹೇಳಿ"
    },
    {
      "t": "00:51",
      "text": "ಯಾವ ಆಪ್ ಯೂಸ್ ಮಾಡ್ತೀರಾ ಆಪ್?"
    },
    {
      "t": "00:54",
      "text": "ನಾವ್ ಒಂದು ಹತ್ತು ದಿನ ಆಯ್ತು ನೀವು?"
    },
    {
      "t": "00:57",
      "text": "ನಾಲ್ಕು ದಿನ ಆಯ್ತು"
    },
    {
      "t": "01:00",
      "text": "ಚೆನ್ನಾಗಿದೆ ಆಪ್"
    },
    {
      "t": "01:06",
      "text": "ಯಾರನ್ನ ಮೀಟ್ ಮಾಡಿದ್ರಾ ಆಪ್ ಅಲ್ಲಿ?"
    },
    {
      "t": "01:11",
      "text": "ಇಲ್ಲ ಯಾರು ಸಿಕ್ಕಿಲ್ಲ"
    },
    {
      "t": "01:14",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "01:19",
      "text": "ರೆಗ್ಯುಲರ್ ಆಗಿ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದಾರೆ ಸಿಗ್ತಾರೆ ನಾನು ಅವಾಗವಾಗ ಯೂಸ್ ಮಾಡ್ತೀನಿ ಅಷ್ಟೇ"
    },
    {
      "t": "01:33",
      "text": "ಮತ್ತೆ ನೀವ್ಯಾಕೆ ಯಾರನ್ನು ಮೀಟ್ ಮಾಡಿಲ್ಲ?"
    },
    {
      "t": "01:48",
      "text": "ಇನ್ನೇನು ಇಷ್ಟ"
    },
    {
      "t": "02:02",
      "text": "ನಾನು ಸಿಂಗಲ್ ನೀವು?"
    },
    {
      "t": "02:11",
      "text": "ಇನ್ನೇನು ಸಮಾಚಾರ ಯಾರಾದ್ರೂ ಸಿಕ್ಕಿದ್ರೆ ಮಾತಾಡ್ತೀರಾ?"
    },
    {
      "t": "03:32",
      "text": "ನೀವು ಮ್ಯಾರೀಡ್ ಆ?"
    },
    {
      "t": "03:36",
      "text": "ನಾವ್ ಮ್ಯಾರೀಡ್"
    },
    {
      "t": "03:45",
      "text": "ಹೀಗೆಲ್ಲಾ ಮಾತಾಡೋದು ಆಪ್ ಅಲ್ಲಿ"
    }
  ]
