    },
    {
      "t": "00:06",
      "text": "ಬೆಂಗಳೂರು ಇಂದಾನೇನಾ"
    },
    {
      "t": "00:09",
      "text": "ಹೌದು ಮಂಡ್ಯದಿಂದ"
    },
    {
      "t": "00:12",
      "text": "ನಿಮ್ಮ ಹೆಸರು"
    },
    {
      "t": "00:14",
      "text": "ರಾಜನ್ ಅಂತ ನಿಮ್ಮ ಹೆಸರು"
    },
    {
      "t": "00:17",
      "text": "ಏನ್ ವರ್ಕ್ ಮಾಡ್ತಿರೋದು"
    },
    {
      "t": "00:20",
      "text": "ನಾನು ಇಂಜಿನಿಯರ್ ಅಂದೆ"
    },
    {
      "t": "00:25",
      "text": "ನಾನು ಹಾಸ್ಪಿಟಲ್ ವರ್ಕ್ ಮಾಡ್ತಿದ್ದೀನಿ"
    },
    {
      "t": "00:29",
      "text": "ಹಾಸ್ಪಿಟಲ್ ಅಲ್ಲಿ ಏನ್ ಕೆಲಸ"
    },
    {
      "t": "00:33",
      "text": "ನರ್ಸ್"
    },
    {
      "t": "00:36",
      "text": "ಓಕೆ ಎಷ್ಟು ಹೊತ್ತಿಗೆ ಆಫೀಸ್ ಇಂದ ಬಂದಿದ್ದು"
    },
    {
      "t": "00:40",
      "text": "12 ಗಂಟೆ ಆಯ್ತಲ್ವಾ ನಿನ್ನೆ ಬಂದಿರೋದು ನೈಟ್"
    },
    {
      "t": "00:45",
      "text": "ಓಕೆ ಹೆಂಗಿದೆ ಹೆಂಗೆ ಮಾತಾಡೋದು ಅಲ್ಲಿ"
    },
    {
      "t": "00:50",
      "text": "ನಾನು ಜಾಸ್ತಿ ಯೂಸ್ ಮಾಡಿಲ್ಲ ಒಂದು ಟೂ ತ್ರೀ ಕಾಲ್ಸ್ ಅಷ್ಟೇ ಅಟೆಂಡ್ ಮಾಡಿರೋದು"
    },
    {
      "t": "00:56",
      "text": "ಹೌದಾ ಹುಷಾರಾಗಿ ಯೂಸ್ ಮಾಡಿ ಯಾರಿಗೂ ನಂಬರ್ ಕೊಡಬೇಡಿ"
    },
    {
      "t": "1:00",
      "text": "ಓಕೆ ಥ್ಯಾಂಕ್ ಯು ಓಕೆ"
    },
    {
      "t": "1:04",
      "text": "ನಂಬರ್ ಕೊಟ್ರೆ ಇದರೊಳಗೆ ಯಾರು ಅನ್ನೋನ್ ಇರ್ತಾರೆ ಸುಮ್ನೆ ಫೋನ್ ಮಾಡ್ತಿರ್ತಾರೆ ಮೆಸೇಜ್ ಮಾಡ್ತಾರೆ ವಾಟ್ಸಪ್ ಅಲ್ಲಿ ಹಿಂಗ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "1:10",
      "text": "ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "1:12",
      "text": "ಎಲ್ಲಾ ಆಗುತ್ತೆ ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡ್ತೀನಿ ಅಂತ ಅಂದ್ರೆ ಹೋಗ್ಬೇಡಿ"
    },
    {
      "t": "1:17",
      "text": "ಓಕೆ ಥ್ಯಾಂಕ್ಸ್ ರೀ"
    },
    {
      "t": "1:20",
      "text": "ಹುಷಾರಾಗಿರಿ ಇಲ್ಲ ಅಂದ್ರೆ ಸಿಗಾಕೊಂಡು"
    },
    {
      "t": "1:24",
      "text": "ಮ್ಯಾರೀಡ್ ಅನ್ ಮ್ಯಾರೀಡ್"
    },
    {
      "t": "1:27",
      "text": "ಅನ್ ಮ್ಯಾರೀಡ್"
    },
    {
      "t": "1:30",
      "text": "ನಾನು ಮ್ಯಾರೀಡ್ ಸುಮ್ನೆ ಕಷ್ಟ ಆಗುತ್ತೆ ಆಮೇಲೆ ಇನ್ನೊಂದು ಏನಂದ್ರೆ ಇದರಲ್ಲಿ ಮಾತು ಬರಿ ಫ್ರೆಂಡ್ಸ್ ತರಾನೇ ಮಾತಾಡೋದು"
    },
    {
      "t": "1:38",
      "text": "ಸೆಕ್ಸ್ ಬಗ್ಗೆ ಮಾತಾಡ್ತೀರಾ"
    },
    {
      "t": "1:41",
      "text": "ಈ ತರ ಹೆಂಗೆ ಮಾತಾಡ್ತಾರೆ ನಿಮಗೆ ಹೆಂಗೆಲ್ಲಾ ಇಷ್ಟ ಆಗುತ್ತೆ ಅಲ್ವಾ"
    },
    {
      "t": "1:49",
      "text": "ಹಲೋ"
    },
    {
      "t": "1:51",
      "text": "ಹಾ ಹೇಳಿ"
    },
    {
      "t": "1:53",
      "text": "ನಿಮಗೆ ಹಂಗೆಲ್ಲಾ ಮಾತಾಡೋಕೆ ಇಷ್ಟ ಆಗುತ್ತಾ ನಿಮಗೆ"
    },
    {
      "t": "1:56",
      "text": "ಇಲ್ಲ ರೀ"
    },
    {
      "t": "1:57",
      "text": "ಅದಕ್ಕೆನೇ ಹೇಳಿದ್ದು ಇದರಲ್ಲಿ ಹಂಗೆ ಕೇಳ್ತಾರೆ"
    },
    {
      "t": "2:01",
      "text": "ಹುಷಾರು ನೋಡಿ ಯೂಸ್ ಮಾಡಿ ಯಾರಿಗೂ ನಂಬರ್ ಕೊಡಬೇಡಿ"
    },
    {
      "t": "2:06",
      "text": "ಸುಮ್ನೆ ಒಂದು ಹತ್ತು ನಿಮಿಷ ಮಾತಾಡೋಕೆ ಅಷ್ಟೇನಾ"
    },
    {
      "t": "2:10",
      "text": "ಖುಷಿಯಾಗಿ ನಂಬರ್ ಕೊಡ್ತಾರೆ"
    },
    {
      "t": "2:13",
      "text": "ಅವರು ಸುಮ್ನೆ ಹೆಂಗೆ ಬೇಕೋ ಹಂಗೆ ಮೆಸೇಜ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "2:20",
      "text": "ನೀವು ಈಗ ಡ್ಯೂಟಿಯಲ್ಲಿ ಇದ್ದೀರಾ ಮನೇಲಿ ಇದ್ದೀರಾ"
    },
    {
      "t": "2:22",
      "text": "ಡ್ಯೂಟಿ ಇವತ್ತು ನೈಟ್ ಡ್ಯೂಟಿ ಹಾಕಿದ್ದಾರೆ ಶಿಫ್ಟ್"
    },
    {
      "t": "2:27",
      "text": "ಬಂದಿದ್ದೆ"
    },
    {
      "t": "2:29",
      "text": "ನಿದ್ದೆ ಬರ್ತಿದೆಯಲ್ಲ ಸರಿ ಅಪ್ಲಿಕೇಶನ್ ಇದೆ ಆನ್ ಹೋಗೋಣ ಅಂತ ಬಂದೆ ಅಷ್ಟೇ"
    },
    {
      "t": "2:34",
      "text": "ಸರಿ ಅಲ್ವಾ"
    },
    {
      "t": "2:36",
      "text": "ದುಡ್ಡು ಆಗುತ್ತೆ ಟೈಮ್ ಪಾಸ್ ಆಗುತ್ತೆ ಎಲ್ಲಾನು ಆಗುತ್ತೆ ಇದರಲ್ಲಿ ಆದ್ರೆ ನಿಧಾನಕ್ಕೆ ಹುಷಾರು ಉಪಯೋಗಿಸಿ ಅಷ್ಟೇ"
    },
    {
      "t": "2:42",
      "text": "ಓಕೆ"
    },
    {
      "t": "2:45",
      "text": "ಸರಿನಾ"
    },
    {
      "t": "2:47",
      "text": "ಸರಿ ಬಾಯ್ ಗುಡ್ ನೈಟ್"
    },
    {
      "t": "2:49",
      "text": "ಗುಡ್ ನೈಟ್"
    }
  ]
