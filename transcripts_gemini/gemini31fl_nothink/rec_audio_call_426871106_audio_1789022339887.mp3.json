      "text": "ಹೇಳ್ರಿ"
    },
    {
      "t": "00:12",
      "text": "ಏನ್ರಿ ಮಾಡ್ತಾ ಇದ್ದೀರಾ?"
    },
    {
      "t": "00:14",
      "text": "ಏನ್ರಿ"
    },
    {
      "t": "00:15",
      "text": "ಆ"
    },
    {
      "t": "00:16",
      "text": "ಕೂತ್ಕೊಂಡಿದ್ದೀವಿರಿ"
    },
    {
      "t": "00:18",
      "text": "ಕೂತ್ಕೊಂಡು ಏನ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ?"
    },
    {
      "t": "00:20",
      "text": "ಏನ್ ಮಾಡಲ್ಲ"
    },
    {
      "t": "00:22",
      "text": "ಸುಮ್ನೆ ಕೂತ್ಕೊಂಡಿದ್ದೀವಿರಿ"
    },
    {
      "t": "00:24",
      "text": "ಎಲ್ಲಿ ನೀವು ಯಾವ ಊರು ನಿಮ್ಮದು?"
    },
    {
      "t": "00:27",
      "text": "ಆ"
    },
    {
      "t": "00:29",
      "text": "ಹುಬ್ಬಳ್ಳಿ"
    },
    {
      "t": "00:30",
      "text": "ಹುಬ್ಬಳ್ಳಿನಾ"
    },
    {
      "t": "00:32",
      "text": "ನಿನ್ನೆ ಮಾತಾಡಿದ್ರಲ್ಲ ನನ್ನ ಹತ್ರ ನೀವು"
    },
    {
      "t": "00:35",
      "text": "ಆ"
    },
    {
      "t": "00:37",
      "text": "ಇಲ್ವಾ"
    },
    {
      "t": "00:40",
      "text": "ಏನ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ?"
    },
    {
      "t": "00:41",
      "text": "ಹೌಸ್ ವೈಫ್"
    },
    {
      "t": "00:43",
      "text": "ಹೌಸ್ ವೈಫ್ ಆ"
    },
    {
      "t": "00:45",
      "text": "ಆ"
    },
    {
      "t": "00:49",
      "text": "ಅಯ್ಯೋ"
    },
    {
      "t": "00:54",
      "text": "ಸರಿ ಏನೋ ಮಾಡಿ ಹೋಗ್ಲಿ"
    },
    {
      "t": "00:57",
      "text": "ನೀವೇನ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಿ ಅಂದೆ"
    },
    {
      "t": "00:59",
      "text": "ನಾನು ಕೆಲಸ ಮಾಡ್ಕೊಂಡಿದ್ದೀನಿ"
    },
    {
      "t": "01:01",
      "text": "ಏನು?"
    },
    {
      "t": "01:03",
      "text": "ಕೆಲಸ ಬಿಡಿ ಯಾವುದೋ ಒಂದು ಕೆಲಸ ಏನ್ ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "01:11",
      "text": "ಏನ್ ಏನ್ ಮಾಡಬೇಕು ನೀವು ಹೇಳ್ಬೇಕು ಏನ್ ಮಾಡ್ತೀರಾ ಯಾಕೆ ನೀವು?"
    },
    {
      "t": "01:16",
      "text": "ಟೈಮ್ ಪಾಸ್ ಆಗಿರೋದು ಮಾಡ್ಕೋತೀನಿ ಅಪ್ಪ"
    },
    {
      "t": "01:19",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:23",
      "text": "ಸರಿ ಸರಿ ಕಂಡ್ರಿ ಟೈಮ್ ಪಾಸ್ ಮಾಡಿ"
    },
    {
      "t": "01:26",
      "text": "ಯಾಕ್ರಿ?"
    },
    {
      "t": "01:28",
      "text": "ಸುಮ್ನೆ ಕೇಳ್ದೆ"
    },
    {
      "t": "01:30",
      "text": "ಹೇಳಬಾರದು"
    },
    {
      "t": "01:31",
      "text": "ಹೇಳಬಾರದು"
    },
    {
      "t": "01:32",
      "text": "ಆ"
    },
    {
      "t": "01:33",
      "text": "ಯಾಕೆ ಮಾಡಬಾರದು ಅಂತ ಅಂದೆ"
    },
    {
      "t": "01:35",
      "text": "ನಾನೇನು ಹೇಳಿಲ್ವಲ್ಲ ಮಾಡಬಾರದು ಅಂತ ಅವರವರ ಇಷ್ಟ"
    },
    {
      "t": "01:39",
      "text": "ಎತ್ತರಕ್ಕೆ ಬಂದು"
    },
    {
      "t": "01:41",
      "text": "ನಾನು ಬಂದು ಒಂದು ಒಂದು ವರ್ಷ ಆಯ್ತು"
    },
    {
      "t": "01:44",
      "text": "ವಾ"
    },
    {
      "t": "01:45",
      "text": "ಆ"
    },
    {
      "t": "01:46",
      "text": "ಎಷ್ಟು ಖರ್ಚು ಮಾಡಿದ್ದೀರಾ?"
    },
    {
      "t": "01:48",
      "text": "ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "01:50",
      "text": "ಅಪ್ಪ ದೇವರೇ"
    },
    {
      "t": "01:53",
      "text": "ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "01:55",
      "text": "ಹೂ"
    },
    {
      "t": "01:57",
      "text": "ಕಾರಣ ಅವರು"
    },
    {
      "t": "01:59",
      "text": "ತಲೆ ಇಲ್ಲ ಏನು ಇಲ್ಲ ಸುಮ್ನೆ ಒಂದು ಲಕ್ಷ ಖರ್ಚು ಮಾಡೋ ಅಂತ ಬೈಕೊಂತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "02:02",
      "text": "ಅಲ್ಲ ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "02:05",
      "text": "ಅದು ಅಪ್ಪ ಮಗು ಕೊಟ್ಟಿದ್ದು ಎಷ್ಟು ಖುಷಿ ಪಡೋರು ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "02:09",
      "text": "ಅದು ಕರೆಕ್ಟ್ ಅಲ್ವಾ ಇವಾಗ ಇನ್ಸ್ಟಾಲ್ ಆಗಿ ಅನ್ ಇನ್ಸ್ಟಾಲ್ ಮಾಡ್ತೀನಿ ಆಪ್ ನ"
    },
    {
      "t": "02:14",
      "text": "ಅದೇ ದುಡ್ಡಿದೆ ಅಪ್ಪ ಅಮ್ಮ ಅಕ್ಕ ತಂಗಿ ಅಣ್ಣ ತಮ್ಮ ಏನು ಅದು ಕೊಡಿಸಬಹುದು"
    },
    {
      "t": "02:19",
      "text": "ಅಲ್ವಾ ಇರಿ ಫಸ್ಟ್ ತೆಗಿತೀನಿ ಆಪ್ ನ ಇವಾಗ"
    },
    {
      "t": "02:23",
      "text": "ನಿಮ್ಮ ಇಷ್ಟ ಅದು ನಂದು ನನ್ ಲೆಕ್ಕಕ್ಕೆ ನಾನು ಹೇಳ್ದೆ"
    },
    {
      "t": "02:26",
      "text": "ಕರೆಕ್ಟ್ ಕರೆಕ್ಟ್"
    },
    {
      "t": "02:29",
      "text": "ನನ್ ಕಡೆ ಏನಾದ್ರೂ ಇದ್ದಿದ್ರೆ ಅಷ್ಟು"
    },
    {
      "t": "02:31",
      "text": "ಆ"
    },
    {
      "t": "02:32",
      "text": "ಇಷ್ಟು ಹೊತ್ತಿಗೆ ನನ್ನ ಮಗಳಿಗೆ ಬಂಗಾರ ಮಾಡ್ಸಾಗ್ತಿದ್ದೆ ಅತ್ತೆಗೆ"
    },
    {
      "t": "02:36",
      "text": "ಅಯ್ಯಯ್ಯೋ"
    },
    {
      "t": "02:38",
      "text": "ಇಲ್ಲ ಅಂದ್ರೆ ನನ್ನ ಎಕ್ಸ್ ಗೆ ಏನಾದ್ರೂ ಚೈನ್ ಕೊಡುಸ್ತಿದ್ದೆ ನಾನು"
    },
    {
      "t": "02:41",
      "text": "ನಿಮ್ಮ ಎಕ್ಸ್ ಆ?"
    },
    {
      "t": "02:42",
      "text": "ಹೂ"
    },
    {
      "t": "02:43",
      "text": "ಯಾಕೆ ಪ್ರೆಸೆಂಟ್ ಇಲ್ವಾ?"
    },
    {
      "t": "02:46",
      "text": "ಪ್ರೆಸೆಂಟ್ ಅಂದ್ರೆ ಸಿಂಗಲ್ ಪೇರೆಂಟ್"
    },
    {
      "t": "02:50",
      "text": "ಸಿಂಗಲ್ ಪೇರೆಂಟ್ ಆ?"
    },
    {
      "t": "02:52",
      "text": "ಹೂ"
    },
    {
      "t": "02:53",
      "text": "ಸಿಂಗಲ್ ಪೇರೆಂಟ್ ಆಗಿದ್ರೆ ಎಕ್ಸ್ ಗೆ ಹೆಂಗ್ರಿ ಕೊಡುಸ್ತೀರಾ?"
    },
    {
      "t": "02:56",
      "text": "ಕೊಡುಸ್ತೀನಿ ಅವನು ಕೇಳಿದ್ರೆ ಅಚ್ಚೆ ನಾನು ಕೊಡೋದು ಅಚ್ಚೆ"
    },
    {
      "t": "03:00",
      "text": "ಛೀ ನಿಮ್ಮಂತವರು ಇರೋದ್ರಿಂದಾನೆ ರೀ ಪ್ರಪಂಚ ಇವತ್ತು ಉಳಿದಿರೋದು"
    },
    {
      "t": "03:04",
      "text": "ಯಾಕ್ರಿ?"
    },
    {
      "t": "03:06",
      "text": "ಏನೋ ಸುಮ್ನೆ ಹಂಗೆ"
    },
    {
      "t": "03:08",
      "text": "ಯಾಕೆ ಹೇಳ್ರಿ?"
    },
    {
      "t": "03:10",
      "text": "ಸುಮ್ನೆ ಹಂಗೆ"
    },
    {
      "t": "03:12",
      "text": "ನನ್ ಮಕ್ಳಿಗೆ ಆಯ್ತು ನನ್ನ ಎಕ್ಸ್ ಗೆ ಆಯ್ತು ಏನೋ ಕೊಡುಸ್ತಿದ್ದನಪ್ಪ"
    },
    {
      "t": "03:17",
      "text": "ಎಲ್ಲಾದರೂ ಒಂದು ರೆಸಾರ್ಟ್ ಗೆ ಹೋಗಿ ಸಕ್ಕತ್ತಾಗಿ ಪಾರ್ಟಿ ಮಾಡ್ತಿದ್ದು ದುಡ್ಡು ಇದ್ದಿದ್ರೆ"
    },
    {
      "t": "03:22",
      "text": "ಎಲ್ಲಿಗೆ ಹೋಗಿದ್ರಿ?"
    },
    {
      "t": "03:24",
      "text": "ರೆಸಾರ್ಟ್ ಗೆ ಹೋಗಿ ಪಾರ್ಟಿ ಮಾಡ್ತಿದ್ದು ಅಂದೆ"
    },
    {
      "t": "03:26",
      "text": "ಏನ್ ಮಾಡ್ತೀರಾ ರೆಸಾರ್ಟ್ ಗೆ ಹೋಗ್ಬಿಟ್ಟು ಹೆಂಗೆ ಪಾರ್ಟಿ ಮಾಡ್ತೀರಾ?"
    },
    {
      "t": "03:29",
      "text": "ಪಾರ್ಟಿ ಅಂದ್ರೆ ಮಾಮೂಲಿ ಪಾರ್ಟಿ ಉಣ್ಣೋದು ತಿನ್ನೋದು"
    },
    {
      "t": "03:31",
      "text": "ಆ"
    },
    {
      "t": "03:32",
      "text": "ಏನ್ ಮಾಡ್ತೀರಾ ಕುಡಿಯೋದು?"
    },
    {
      "t": "03:34",
      "text": "ಇಲ್ಲಪ್ಪ ಆ ಹ್ಯಾಬಿಟ್ ಇಲ್ಲ"
    },
    {
      "t": "03:37",
      "text": "ಯಾಕೆ ಹ್ಯಾಬಿಟ್ ಇಲ್ಲ ಮಾಡ್ಕೊಳ್ಳಿ"
    },
    {
      "t": "03:39",
      "text": "ಅಪ್ಪ ಅದರ ಸಹವಾಸನೇ ಬೇಡ"
    },
    {
      "t": "03:42",
      "text": "ಏನ್ರಿ ಹಿಂಗೆ ಅಂತೀರಾ"
    },
    {
      "t": "03:46",
      "text": "ಒಂದು ಲಕ್ಷ ಅಂದ್ರೆ ನನಗೆ ಆಶ್ಚರ್ಯ"
    },
    {
      "t": "03:50",
      "text": "ನನ್ನ ಹತ್ರ ಕೋಟ್ಯಾನುಗಟ್ಟಲೆ ದುಡ್ಡಿದೆ ಏನ್ ಮಾಡೋಣ?"
    },
    {
      "t": "03:54",
      "text": "ಕೊಡಿ ಅಂದೆ ಒಂದು ಲಕ್ಷ ಒಂದು ಐದಾರು ಸಾವಿರ"
    },
    {
      "t": "03:58",
      "text": "ಸಾಕಾ?"
    },
    {
      "t": "03:59",
      "text": "ಸಾಕು"
    },
    {
      "t": "04:00",
      "text": "ಏನ್ ಮಾಡ್ತೀರಾ ಐದಾರು ಸಾವಿರ ಹಿಡ್ಕೊಂಡು?"
    },
    {
      "t": "04:02",
      "text": "ನನ್ ಎಕ್ಸ್ ಗೆ ಏನಾದ್ರೂ ಕೊಡ್ತೀನಿ ಅತ್ತೆಗೆ"
    },
    {
      "t": "04:05",
      "text": "ಏ ನೀವೇನ್ರಿ ಕೊಡ್ತೀರಾ ಅವರೇ ಕೊಡ್ತಾರೆ ಹೋಗ್ಲಿ ಸುಮ್ನೆ"
    },
    {
      "t": "04:09",
      "text": "ಅವರು ಕೊಡುಸ್ತಾರೆ ಆದ್ರೆ ನಮಗೆ ನಮ್ದು ಒಂತರ ಹಠ"
    },
    {
      "t": "04:13",
      "text": "ನಾವು ಅವರಿಗೆ ಕೊಡ್ಸಬೇಕು ಅವರ ಕಡೆಯಿಂದ ನಮಗೆ ಏನು ಬೇಡ"
    },
    {
      "t": "04:17",
      "text": "ನಮಗೆ ಆತರ ಡ್ರೀಮ್ ಇಲ್ಲ"
    },
    {
      "t": "04:20",
      "text": "ಹಂಗೆ"
    },
    {
      "t": "04:22",
      "text": "ಕರೆಕ್ಟ್ ಕಂಡ್ರಿ ಫಸ್ಟ್ ಈ ಆಪ್ ನ ಅನ್ ಇನ್ಸ್ಟಾಲ್ ಮಾಡ್ಬಿಟ್ಟು ಯಾವುದಾನ ಹುಡುಗಿಗೆ ಹೋಗ್ಬಿಟ್ಟು ಚೆನ್ನಾಗಿ ಏನಾದ್ರೂ ಕೊಡುಸ್ತೀನಿ"
    },
    {
      "t": "04:29",
      "text": "ಹುಡುಗಿ ಪೈಸಾ ಜಾಸ್ತಿ ನಾ ಟೈಮ್"
    },
    {
      "t": "04:33",
      "text": "ಟೈಮ್"
    },
    {
      "t": "04:34",
      "text": "ದುಡ್ಡು"
    },
    {
      "t": "04:36",
      "text": "ಗಿಫ್ಟ್ ಅಲ್ಲ"
    },
    {
      "t": "04:38",
      "text": "ಅಂತವರು ಇದ್ದಾರೆ ಸುಮಾರು ಜನ"
    },
    {
      "t": "04:40",
      "text": "ನಾನು ನೋಡಿರೋ ಪ್ರಕಾರ"
    },
    {
      "t": "04:43",
      "text": "ಟೈಮ್"
    },
    {
      "t": "04:46",
      "text": "ಒಂಚೂರು ಪ್ರೀತಿ"
    }
  ]
}