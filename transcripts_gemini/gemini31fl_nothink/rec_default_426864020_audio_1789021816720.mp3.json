  "segments": [
    {
      "t": "00:00",
      "text": "ಹಾಯ್"
    },
    {
      "t": "00:05",
      "text": "ಹೇಗಿದ್ದೀರಾ?"
    },
    {
      "t": "00:08",
      "text": "ನಾನು ಚೆನ್ನಾಗಿದ್ದೀನಿ, ನೀವು?"
    },
    {
      "t": "00:11",
      "text": "ನಾನು ಕೂಡ ಚೆನ್ನಾಗಿದ್ದೀನಿ."
    },
    {
      "t": "00:12",
      "text": "ಮ್ಯಾರೀಡ್ ಅಲ್ವಾ?"
    },
    {
      "t": "00:14",
      "text": "ಏನು?"
    },
    {
      "t": "00:15",
      "text": "ಮ್ಯಾರೀಡ್ ಅಲ್ವಾ? ಸಿಂಗಲ್ ಅಲ್ವಾ ಅಂತ ಕೇಳ್ದೆ."
    },
    {
      "t": "00:17",
      "text": "ಸಿಂಗಲ್, ನೀವು?"
    },
    {
      "t": "00:20",
      "text": "ಸಿಂಗಲ್, ಒಬ್ಬಳೇ ಇದ್ದೀಯಾ?"
    },
    {
      "t": "00:23",
      "text": "ಮ್ಯಾರೀಡ್ ಅಲ್ವಾ? ಸಿಂಗಲ್ ಅಲ್ವಾ?"
    },
    {
      "t": "00:25",
      "text": "ಸಿಂಗಲ್."
    },
    {
      "t": "00:29",
      "text": "ಏನ್ ಮಾಡ್ತಿದ್ದೀಯಾ?"
    },
    {
      "t": "00:34",
      "text": "ನಾನು ಬಿಸಿನೆಸ್ ಮಾಡ್ತಿದ್ದೀನಿ."
    },
    {
      "t": "00:38",
      "text": "ಏನ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀಯಾ ಜಾಬ್?"
    },
    {
      "t": "00:40",
      "text": "ಬಿಸಿನೆಸ್ ಮಾಡ್ತಿದ್ದೀನಿ ಅಂತೆ."
    },
    {
      "t": "00:42",
      "text": "ಏನ್ ಬಿಸಿನೆಸ್?"
    },
    {
      "t": "00:45",
      "text": "ಎಲೆಕ್ಟ್ರಿಕಲ್ಸ್."
    },
    {
      "t": "00:47",
      "text": "ಹಾಂ?"
    },
    {
      "t": "00:50",
      "text": "ಎಲೆಕ್ಟ್ರಿಕಲ್ಸ್, ಎಲೆಕ್ಟ್ರಿಕಲ್ಸ್ ಶಾಪ್."
    },
    {
      "t": "00:55",
      "text": "ಯಾಕೆ ಇದೆಲ್ಲ ಬ್ಲಾಕ್ ಆಗಿದೆ?"
    },
    {
      "t": "00:58",
      "text": "ಬ್ಲಾಕ್?"
    },
    {
      "t": "00:59",
      "text": "ಹೇರ್."
    },
    {
      "t": "01:01",
      "text": "ಹೇರ್ಸ್ ಹೌದು."
    },
    {
      "t": "01:05",
      "text": "ಮತ್ತೆ?"
    },
    {
      "t": "01:08",
      "text": "ಸಿಂಗಲ್ ಇದು, ಬಾಯ್ ಫ್ರೆಂಡ್ ಇಲ್ವಾ?"
    },
    {
      "t": "01:12",
      "text": "ಬಾಯ್ ಫ್ರೆಂಡ್ ಇಲ್ವಾ ಅಂತ ಕೇಳ್ದೆ."
    },
    {
      "t": "01:14",
      "text": "ನೋ."
    },
    {
      "t": "01:16",
      "text": "ಆಗಬಹುದಾ?"
    },
    {
      "t": "01:19",
      "text": "ಏನು?"
    },
    {
      "t": "01:20",
      "text": "ಬಾಯ್ ಫ್ರೆಂಡ್ ಆಗಬಹುದಾ ಅಂತ ಕೇಳ್ದೆ."
    },
    {
      "t": "01:24",
      "text": "ಏನಿ?"
    },
    {
      "t": "01:27",
      "text": "ಅಂದ್ರೆ ಆಪ್ ಯೂಸ್ ಮಾಡ್ಲಿಕ್ಕೆ ರೀಸನ್."
    },
    {
      "t": "01:30",
      "text": "ಏನು?"
    },
    {
      "t": "01:33",
      "text": "ಸ್ವಲ್ಪ ಮೊಬೈಲ್ ಗೆ ದೂರ ಇಟ್ಕೊಳ್ಳಿ ನೋಡುವ."
    },
    {
      "t": "01:36",
      "text": "ಏನೂ ಸರಿಯಾಗಿ ಕಾಣ್ತಿಲ್ಲ."
    },
    {
      "t": "01:38",
      "text": "ಹೌದು ಸರಿಯಾಗಿ ಕಾಣ್ತಿಲ್ಲ."
    },
    {
      "t": "01:42",
      "text": "ನಿಮ್ಮ ನೆಟ್ವರ್ಕ್ ಪ್ರಾಬ್ಲಮ್ ಅನ್ಸುತ್ತೆ, ಮೊಬೈಲ್ ಸ್ವಲ್ಪ ದೂರ ಇಟ್ಕೊಳ್ಳಿ ನೋಡುವ ಅಂತ ಅಂದೆ."
    },
    {
      "t": "01:47",
      "text": "ಏನೂ ಕಾಣ್ತಿಲ್ಲ ಸರಿ."
    },
    {
      "t": "01:49",
      "text": "ಇವಾಗ?"
    },
    {
      "t": "01:52",
      "text": "ಹಾಂ?"
    },
    {
      "t": "01:56",
      "text": "ಏನು?"
    }
  ]
}