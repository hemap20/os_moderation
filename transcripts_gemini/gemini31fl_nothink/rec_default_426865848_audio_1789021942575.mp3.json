      "text": "ಹಲೋ"
    },
    {
      "t": "00:07",
      "text": "ನೀವೇನು ಮಾಡ್ತಾ ಇದ್ದೀರಿ?"
    },
    {
      "t": "00:09",
      "text": "ನಾನೇನು ಮಾಡ್ತಾ ಇದ್ದೀನಿ?"
    },
    {
      "t": "00:10",
      "text": "ಸಿವಿಲ್ ಇಂಜಿನಿಯರ್"
    },
    {
      "t": "00:13",
      "text": "ಅಲ್ಲ ವರ್ಕ್ ಫ್ರಮ್ ಹೋಮ್ ಆ"
    },
    {
      "t": "00:16",
      "text": "ವರ್ಕ್ ಎಲ್ಲಾ ಇದೆ ಈಗ ಸ್ವಲ್ಪ ಫ್ರೀ ಇದೆ ಅದಕ್ಕೆ ಆನ್ಲೈನ್ ಬಂದೆ"
    },
    {
      "t": "00:21",
      "text": "ತುಮಕೂರಲ್ಲಿ ವರ್ಕ್ ಮಾಡ್ತೀರಾ?"
    },
    {
      "t": "00:25",
      "text": "ಹೌದು"
    },
    {
      "t": "00:29",
      "text": "ನೀವು ಯಾವಾಗಲಿಂದ ಯೂಸ್ ಮಾಡ್ತಿದ್ದೀರಾ?"
    },
    {
      "t": "00:31",
      "text": "ನಾನೊಂದು ತ್ರೀ ಡೇಸ್ ಆಯ್ತು"
    },
    {
      "t": "00:34",
      "text": "ತ್ರೀ ಡೇಸ್ ಆ"
    },
    {
      "t": "00:35",
      "text": "ಸಂಡೆ ಇನ್ಸ್ಟಾಲ್ ಮಾಡಿದ್ದೆ"
    },
    {
      "t": "00:40",
      "text": "ಸಿಕ್ಕಿದ್ರೆ ಯಾರಾದ್ರೂ ಫ್ರೆಂಡ್"
    },
    {
      "t": "00:43",
      "text": "ಇನ್ನ ಇಲ್ಲ"
    },
    {
      "t": "00:45",
      "text": "ಗೊತ್ತಿಲ್ಲ ಇದರಲ್ಲಿ ಫ್ರೆಂಡ್ಸ್ ಜೆನ್ಯೂನಿಟಿ ಇರುತ್ತೋ ಇಲ್ವೋ ಗೊತ್ತಿಲ್ಲ ಅದಕ್ಕೆ ಫ್ರೆಂಡ್ ಮಾಡ್ಕೊಂಡಿಲ್ಲ"
    },
    {
      "t": "00:52",
      "text": "ಇದರಲ್ಲಿ ಏನು ಇಲ್ಲರೀ ಆಲ್ಮೋಸ್ಟ್ ನಾನು ನಿಮಗೆ ಫ್ರೆಂಡ್ ಆಗಿ ಹೇಳ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "00:57",
      "text": "ಸೋ ನಾನು ತುಂಬಾ ತಿಂಗಳಿಂದ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ ಸುಮಾರು ಒಂದು ನೈನ್ ಮಂತ್ಸ್ ಬ್ಯಾಕ್ ಇಂದ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "01:01",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:04",
      "text": "ಒಂಬತ್ತು ತಿಂಗಳಿಂದ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "01:06",
      "text": "ಓಕೆ"
    },
    {
      "t": "01:09",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:10",
      "text": "ಅಂದ್ರೆ ಅದೇ ಬಿಟ್ಟು ಬಿಟ್ಟು ಬರ್ತೀನಿ ಅಷ್ಟೇನೇನೆ ವರ್ಕ್ ಇದ್ದಾಗ ಬರಲ್ಲ ವರ್ಕ್ ಇಲ್ಲ ಅಂದ್ರೆ ಬರ್ತೀನಿ"
    },
    {
      "t": "01:14",
      "text": "ಸೋ ಶೇರ್ ಮಾಡ್ಕೊಂತೀವಿ"
    },
    {
      "t": "01:16",
      "text": "ಮಾತಾಡ್ತೀವಿ"
    },
    {
      "t": "01:18",
      "text": "ಟೈಮ್ ಎಲ್ಲಾದ್ರೂ ಸಿಕ್ಕಿದ್ರೆ ನಾನು ಯಾರನ್ನು ಮೀಟ್ ಮಾಡಿಲ್ಲ"
    },
    {
      "t": "01:21",
      "text": "ತುಂಬಾ ಜನ ಮಾತಾಡ್ತಾರೆ ಮೀಟ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "01:24",
      "text": "ಕೆಲವರು ಹೋಗ್ತಾರೆ"
    },
    {
      "t": "01:26",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:27",
      "text": "ಆದ್ರೆ ನಾನು ಹೋಗಿಲ್ಲ ನಂದು ಕೆಲಸ ಅಲ್ವಾ ಮುಂಚೆನೇ"
    },
    {
      "t": "01:31",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:33",
      "text": "ನಿಮಗೆ ಯಾವ ತರ ಬೇಕು?"
    },
    {
      "t": "01:36",
      "text": "ನನಗೆ ಫ್ರೆಂಡ್ ಹೇಗಾದ್ರೂ ಸರಿ"
    },
    {
      "t": "01:39",
      "text": "ಫ್ರೆಂಡ್ಸ್ ಹುಡುಕ್ತಾ ಇದ್ದೆ"
    },
    {
      "t": "01:41",
      "text": "ಹೌದಲ್ಲ ನೋಡೋಣ"
    },
    {
      "t": "01:43",
      "text": "ಬಟ್ ಎಲ್ಲಾ ರೀತಿನೂ"
    },
    {
      "t": "01:46",
      "text": "ನಿಮ್ಮ ಹೆಸರೇನು?"
    },
    {
      "t": "01:48",
      "text": "ಹರ್ಷ"
    },
    {
      "t": "01:50",
      "text": "ಹರ್ಷ ಎಲ್ಲಾ ರೀತಿನೂ ಫ್ರೆಂಡ್ಸ್ ಸಿಗ್ತಾರೆ ಕಂಡ್ರಿ"
    },
    {
      "t": "01:54",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ನಿಮಗೆ ಸಿಕ್ಕಿ ನಿಮಗಾಗಿದ್ದಾರಾ ಫ್ರೆಂಡ್ಸ್"
    },
    {
      "t": "01:58",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ಬಟ್ ಎಲ್ಲೋ ಆಚೆ ಹೋಗಿ"
    },
    {
      "t": "02:00",
      "text": "ನಾನು ಅವಾಗವಾಗ ಬರ್ತೀನಿ ಅಲ್ವಾ"
    },
    {
      "t": "02:02",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:03",
      "text": "ನಾನು ಬರೋದೇ ಅಂದ್ರೆ ಕೆಲಸ ಇದ್ದಾಗ ಬರೋದು ಸೋ ನನಗೆ ಒಂದು ಇಬ್ಬರು ತುಂಬಾ ಬೆಸ್ಟ್ ಫ್ರೆಂಡ್ ಆಗಿದ್ದಾರೆ"
    },
    {
      "t": "02:09",
      "text": "ಸೋ ಅವರು ಯಾರು ಇಲ್ಲಿಲ್ಲ ಅವರೆಲ್ಲ ಬಳ್ಳಾರಿ ಆ ಸೈಡ್ ಇರೋದು ಅಲ್ವಾ ಸೋ ಜಸ್ಟ್ ಕಾಲ್ ಅಲ್ಲಿ ಬಂದು ಮಾತಾಡ್ತಾರೆ ಅಷ್ಟೇ"
    },
    {
      "t": "02:14",
      "text": "ಓಕೆ ಯಾರಿಗೂ ಫೋನ್ ನಂಬರ್ಸ್ ಏನು ಶೇರ್ ಮಾಡಿಲ್ಲ ನೀವು"
    },
    {
      "t": "02:19",
      "text": "ನೀವು ತುಮಕೂರು ಅಂತೀರಾ"
    },
    {
      "t": "02:22",
      "text": "ನಾನೇನು ಕೊಟ್ಟಿಲ್ಲ"
    },
    {
      "t": "02:24",
      "text": "ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "02:25",
      "text": "ನಾನು ಫೋನ್ ನಂಬರ್ ಕೊಟ್ಟಿಲ್ಲ ಮತ್ತೆ ಇನ್ನ ಆಲ್ಮೋಸ್ಟ್"
    },
    {
      "t": "02:30",
      "text": "ನಾನು"
    },
    {
      "t": "02:33",
      "text": "ನಂಬರ್ ಇಸ್ಕೊಂಡು ಇಲ್ಲ ಕೊಟ್ಟೂ ಇಲ್ಲ"
    },
    {
      "t": "02:35",
      "text": "ಹ್ಮ್ ಹ್ಮ್"
    }
  ]
}