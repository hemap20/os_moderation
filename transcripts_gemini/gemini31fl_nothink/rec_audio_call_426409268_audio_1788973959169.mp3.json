    },
    {
      "t": "00:05",
      "text": "हाय कैसे हैं आप?"
    },
    {
      "t": "00:07",
      "text": "हाय वेयर आर यू फ्रॉम?"
    },
    {
      "t": "00:10",
      "text": "आई एम फ्रॉम दिल्ली एंड यू?"
    },
    {
      "t": "00:12",
      "text": "ओह दिल्ली के लिए वार"
    },
    {
      "t": "00:15",
      "text": "यस"
    },
    {
      "t": "00:16",
      "text": "व्हाट डू यू डू?"
    },
    {
      "t": "00:18",
      "text": "आई एम स्टडिंग"
    },
    {
      "t": "00:20",
      "text": "यू नो आई लाइक दिल्ली गर्ल्स"
    },
    {
      "t": "00:24",
      "text": "ओके वेयर आर यू फ्रॉम?"
    },
    {
      "t": "00:27",
      "text": "आई एम फ्रॉम बैंगलोर"
    },
    {
      "t": "00:29",
      "text": "सो व्हाट डू यू डू?"
    },
    {
      "t": "00:31",
      "text": "आई एम वर्किंग एस ए सॉफ्टवेयर इंजीनियर"
    },
    {
      "t": "00:34",
      "text": "ओह ओके ओके"
    },
    {
      "t": "00:36",
      "text": "वेयर डू यू स्टे? यू आर स्टेइंग इन होम और हॉस्टल?"
    },
    {
      "t": "00:40",
      "text": "होम फ्रॉम द्वारका"
    },
    {
