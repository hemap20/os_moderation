    },
    {
      "t": "00:11",
      "text": "ನಾವು ಬೆಂಗಳೂರಿನಿಂದ"
    },
    {
      "t": "00:12",
      "text": "ಏನ್ ಮಾಡ್ತಿರೋದು ನೀವು? ಏನ್ ಮಾಡ್ತಿರೋದು?"
    },
    {
      "t": "00:16",
      "text": "ನಾನು ಒಂದು ಪ್ರೈವೇಟ್ ಕಂಪನಿಯಲ್ಲಿ ಕೆಲಸ ಮಾಡ್ತೀನಿ ನೀವು?"
    },
    {
      "t": "00:19",
      "text": "ನಾನು ಹೌಸ್ ವೈಫ್"
    },
    {
      "t": "00:22",
      "text": "ಓಕೆ ಯಾವ ತರ ಮಾತಾಡೋಕೆ ಇಂಟರೆಸ್ಟ್ ಇದೆ?"
    },
    {
      "t": "00:24",
      "text": "ಯಾವಾಗ ಮಾತಾಡ್ತಿದ್ದೀರಾ?"
    },
    {
      "t": "00:26",
      "text": "ನೀವು ಹೇಳಿ"
    },
    {
      "t": "00:28",
      "text": "ನೀವು ಹೇಳಿ"
    },
    {
      "t": "00:31",
      "text": "ನಿಮಗೆ ಯಾವ ತರ ಮಾತಾಡೋಕೆ ಇಂಟರೆಸ್ಟ್ ಇದೆ ಅಂದ್ರೆ"
    },
    {
      "t": "00:34",
      "text": "ಸೆಕ್ಸ್ ಒಂದು ಬಿಟ್ಟು ಬೇರೆ ಏನಾದ್ರೂ ಮಾತಾಡಿ ಮಾತಾಡ್ತೀನಿ"
