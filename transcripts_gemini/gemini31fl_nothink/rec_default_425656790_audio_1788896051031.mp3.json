  "segments": [
    {
      "t": "00:00",
      "text": "ஹலோ"
    },
    {
      "t": "00:03",
      "text": "நான் சக்தி பேசறேன், சக்தி"
    },
    {
      "t": "00:05",
      "text": "சொல்லுங்க"
    },
    {
      "t": "00:06",
      "text": "சக்தி சார் எந்த ஊரு?"
    },
    {
      "t": "00:10",
      "text": "நான் கரூர்ங்க, நீங்க?"
    },
    {
      "t": "00:12",
      "text": "நான் தஞ்சாவூர் சார்"
    },
    {
      "t": "00:14",
      "text": "தஞ்சாவூர்ங்களா? சரி சரி"
    },
    {
      "t": "00:19",
      "text": "என் பேரு சுதா"
    },
    {
      "t": "00:20",
      "text": "என் பேரு சக்திவேலுங்க"
    },
    {
      "t": "00:22",
      "text": "ஓகே சூப்பர் சக்தி"
    },
    {
      "t": "00:28",
      "text": "எந்த ஆப் யூஸ் பண்ணுவீங்க சக்தி?"
    },
    {
      "t": "00:32",
      "text": "எதுங்க?"
    },
    {
      "t": "00:34",
      "text": "சோலோஸ் ஆப் நீங்க எவ்வளவு நாளா யூஸ் பண்றீங்க?"
    },
    {
      "t": "00:38",
      "text": "இப்பதான்ங்க ஓபன் பண்ணேன்"
    },
    {
      "t": "00:40",
      "text": "எல்லாம் எப்படி பேசுறாங்க?"
    },
    {
      "t": "00:42",
      "text": "இப்பதான் ஓபன் பண்ணேன், இப்பதான் ரெண்டாவது கால்ங்க நீங்க"
    },
    {
      "t": "00:45",
      "text": "அப்டிங்களா? ஓகே"
    },
    {
      "t": "00:47",
      "text": "ரொமான்டிக்கா பேசுவாங்க, செக்ஸியா பேசுவாங்க, பிரண்ட்லியாவும் பேசுவாங்க"
    },
    {
      "t": "00:52",
      "text": "சரி சரி சரி"
    },
    {
      "t": "00:54",
      "text": "நிறைய லேடீஸ் தான் வருவாங்க, மேரேஜ் ஆன லேடீஸ் வருவாங்க"
    },
    {
      "t": "00:57",
      "text": "எதுங்க?"
    },
    {
      "t": "00:58",
      "text": "லேடீஸ் வருவாங்க, மேரேஜ் ஆன லேடீஸ் வருவாங்க"
    },
    {
      "t": "01:01",
      "text": "ஓ சரி சரி"
    },
    {
      "t": "01:03",
      "text": "தனியா வாட்ஸ்அப் இதுல பேசினா பேசுங்க, வாட்ஸ்அப் நம்பர் எல்லாம் கொடுத்து"
    },
    {
      "t": "01:06",
      "text": "ஜிபே பண்ண சொன்னா அதெல்லாம் பேசாதீங்க, காசு வாங்கிட்டு ஏமாத்திருவாங்க"
    },
    {
      "t": "01:10",
      "text": "ஓகே ஓகேங்க"
    },
    {
      "t": "01:11",
      "text": "ஓகேவா?"
    },
    {
      "t": "01:12",
      "text": "ஓகே"
    },
    {
      "t": "01:13",
      "text": "லைன்ல வெயிட் பண்ணுங்க, நிறைய ஆள் வந்துகிட்டே இருப்பாங்க, பேசுங்க"
    },
    {
      "t": "01:16",
      "text": "சரி சரி"
    },
    {
      "t": "01:17",
      "text": "ஓகே"
    },
    {
      "t": "01:18",
      "text": "வச்சுடவா? பாய்"
    },
    {
      "t": "01:19",
      "text": "பாய்"
    }
  ]
}