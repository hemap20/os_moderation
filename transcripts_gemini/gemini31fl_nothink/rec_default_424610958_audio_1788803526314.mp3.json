    {
      "t": "01:49",
      "text": "ನೈಸ್."
    },
    {
      "t": "01:52",
      "text": "ಹೇಗಿದೆ?"
    },
    {
      "t": "01:55",
      "text": "ಪರವಾಗಿಲ್ಲ."
    },
    {
      "t": "02:00",
      "text": "ಒಂತರ ವೆರೈಟಿ ವೆರೈಟಿ ಎಲ್ಲಾ ಕೂಡ."
    },
    {
      "t": "02:03",
      "text": "ನೀವು ಯಾವ ತರ ಇಷ್ಟ ಆಯ್ತು?"
    },
    {
      "t": "02:05",
      "text": "ನಾನು ಎಲ್ಲಾ ತರ ಕೂಡ ಮಾತಾಡ್ತೀನಿ, ಎಲ್ಲಾ ಕೂಡ ಹೇಗೆ ಮಾತಾಡೋದು ಹಾಗೆ."
    },
    {
      "t": "02:11",
      "text": "ಹಾಗೆ ಮಾತಾಡ್ತೀವಿ."
    },
    {
      "t": "02:13",
      "text": "ಹಾಗೆ."
    },
    {
      "t": "02:17",
      "text": "ಮತ್ತೆ?"
    },
    {
      "t": "02:18",
      "text": "ನೆಟ್ವರ್ಕ್ ಇಲ್ಲ ಅನ್ಸುತ್ತೆ ರೀ."
    },
    {
      "t": "02:20",
      "text": "ಕಾಣ್ತಾ ಇದೇನಾ ನಾನು?"
    },
    {
      "t": "02:23",
      "text": "ನಿಮ್ಮದು."
    },
    {
      "t": "02:25",
      "text": "ಹೌದಾ?"
    },
    {
      "t": "02:26",
      "text": "ಹ."
    },
    {
      "t": "02:30",
      "text": "ಮತ್ತೆ?"
    },
    {
      "t": "02:32",
      "text": "ಹೇಳಿ."
    },
    {
      "t": "02:36",
      "text": "ಇವಾಗ ಮಾಡಲ್ಲ, ನಾನು ನಾಳೆ ಮಾಡ್ತೀನಿ ಆಯ್ತಾ?"
    },
    {
      "t": "02:39",
      "text": "ಹ."
    },
    {
      "t": "02:40",
      "text": "ಮತ್ತೆ?"
    },
    {
      "t": "02:42",
      "text": "ಮತ್ತೆ ಹೇಳ್ಬೇಕು."
    },
    {
      "t": "02:44",
      "text": "ಹೇಳಿ."
    },
    {
      "t": "02:46",
      "text": "ಹೇಳಿ."
    },
    {
      "t": "02:49",
      "text": "ಹೇಳ್ಬೇಕು."
    },
    {
      "t": "02:51",
      "text": "ಮನೇಲಿ ಯಾರು ಇಲ್ವಾ?"
    },
    {
      "t": "02:53",
      "text": "ಒಬ್ಬನೇ."
    },
    {
      "t": "02:56",
      "text": "ಹಾಗೆ."
    },
    {
      "t": "02:58",
      "text": "ಅಂದ್ರೆ ರೂಮ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ?"
    },
    {
      "t": "03:00",
      "text": "ಹ."
    },
    {
      "t": "03:08",
      "text": "ಮತ್ತೆ ಹೇಳಿ."
    },
    {
      "t": "03:10",
      "text": "ನಿಮ್ಮ ಹೆಸರು?"
    },
    {
      "t": "03:13",
      "text": "ನೇಹಾ ಅಂತ, ನಿಮ್ಮದು?"
    },
    {
      "t": "03:18",
      "text": "ವಿನಯ್."
    },
    {
      "t": "03:21",
      "text": "ನಂದು ನೆಟ್ವರ್ಕ್ ಪ್ರಾಬ್ಲಮ್ ಏನು."
    },
    {
      "t": "03:26",
      "text": "ಅಲ್ವಾ?"
    },
    {
      "t": "03:28",
      "text": "ನಿಮ್ಮದು ಸ್ಟ್ರಕ್ ಆಗಿದೆ."
    },
    {
      "t": "03:34",
      "text": "ಮತ್ತೆ ನೀವು ತುಂಬಾ ವೆರೈಟಿ ವೆರೈಟಿ ನೋಡಿರಬಹುದು ಅಂತ ಅಲ್ವಾ?"
    },
    {
      "t": "03:41",
      "text": "ನೀವು ಯಾವ ಉದ್ದೇಶಕ್ಕೆ ಬಂದಿದ್ದೀರಾ ಆಪ್ ಗೆ?"
    },
    {
      "t": "03:44",
      "text": "ಎಲ್ಲಾ ತರ, ನೀವು?"
    },
    {
      "t": "03:46",
      "text": "ನಾನು 100 ರಲ್ಲಿ 90 ಪರ್ಸೆಂಟ್ ಅರ್ನಿಂಗ್ ಅಂತಾನೆ ಬಂದಿದ್ದು, ಒಂದು 10 ಪರ್ಸೆಂಟ್ ಟೈಮ್ ಪಾಸ್ ಮಾಡಬಹುದು, ಮಾತಾಡಬಹುದು, ಫ್ರೆಂಡ್ಶಿಪ್ ತರ ನೋಡುವ ಅಂತ ಬಂದಿದ್ದು."
    },
    {
      "t": "03:56",
      "text": "ಅಂತ."
    },
    {
      "t": "04:01",
      "text": "ನೀವು, ನಿಮಗೆ ಸಿಕ್ಕಿದ್ದಾರಾ?"
    },
    {
      "t": "04:05",
      "text": "ಸಿಕ್ಕಿದ್ದಾರೆ."
    },
    {
      "t": "04:09",
      "text": "ಅಲ್ಲಿ ಹೋಗಿ ಎಲ್ಲಾ ಕೂಡ ಆಗಿದೆ ಅಂತ ಹಾಗಾದ್ರೆ ಅಲ್ವಾ?"
    },
    {
      "t": "04:15",
      "text": "ತುಂಬಾ ದೂರ ದೂರ ಹೋಗ್ತೀರಾ?"
    },
    {
      "t": "04:17",
      "text": "ಬೆಂಗಳೂರೇ."
    },
    {
      "t": "04:21",
      "text": "ಟೋಟಲ್?"
    },
    {
      "t": "04:24",
      "text": "ಇಲ್ಲರೀ, ಒಂದು ತಿಂಗಳು ಆಯ್ತು ಅಂತ ಹೇಳಿದ್ನಲ್ವಾ, ನನಗೆ ಸಿಕ್ಕವರಲ್ಲಿ ಮೂರು ಜನ, ಇಬ್ಬರು ಮೈಸೂರಿನವರು, ಒಬ್ಬರು ಬೆಂಗಳೂರಿನವರು, ಸೋ ಅವರಿಗೆ ಇಲ್ಲಿ ಬರಲಿಕ್ಕೆ ಆಗಲ್ಲ, ನನಗೆ ಅಲ್ಲಿ ಹೋಗಲಿಕ್ಕೆ ಆಗಲ್ಲ, ಹಾಗೆ ಮಾತಾಡೋದು ಮಾತ್ರ ನಾವು."
    },
    {
      "t": "04:36",
      "text": "ಸಿಕ್ತೀರಾ?"
    },
    {
      "t": "04:38",
      "text": "ಅವರು ಇಲ್ಲಿ ಬರಬೇಕಲ್ಲರೀ, ಬರೋದಿಲ್ಲಲ್ಲ ಅವರು."
    },
    {
      "t": "04:42",
      "text": "ಬಂದ್ರೆ ಸಿಕ್ತೀರಾ?"
    },
    {
      "t": "04:44",
      "text": "ಬಂದ್ರೆ ಸಿಗಬಹುದು, ಬಟ್ ಅವರು ಬರಲ್ಲ ಅಂತ ಹೇಳಿದ್ರು, ಹಾಗೆ ಮಾತಾಡ್ತೀವಿ, ಸ್ನ್ಯಾಪ್ ಅಲ್ಲಿ ನಂಬರ್ ಕೊಟ್ಟಿದ್ದೀನಿ, ಐಡಿ ಕೊಟ್ಟಿದ್ದೀನಿ, ಹಾಗೆ ಅದರಲ್ಲಿ ಮೆಸೇಜ್ ಕಾಲ್ ಮಾಡ್ಕೊಂಡು ಮಾತಾಡ್ತಾ ಇರ್ತೀವಿ ಹಾಗೆ."
    },
    {
      "t": "05:00",
      "text": "ಏನಾದ್ರೂ ಬೇಕು ಅಂತ ಹೇಳಿದ್ರೆ ಅದರಲ್ಲಿ ಇದು ಮಾಡ್ತಾರೆ, ನನಗೇನಾದ್ರೂ ಬೇಕು ಅಂತ ಅನ್ಸಿದ್ರೆ ಸ್ಕ್ಯಾನರ್ ಕಳಿಸಿದ್ರೆ ಅವರು ಹಾಕ್ತಾರೆ, ಹಾಗೆ ಆತರ ಮಾತಾಡ್ತೀವಿ."
    }
  ]
