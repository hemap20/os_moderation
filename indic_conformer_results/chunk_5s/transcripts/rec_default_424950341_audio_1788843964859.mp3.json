  "segments": [
    {
      "t": "00:00",
      "text": "ஹலோஹ"
    },
    {
      "t": "00:05",
      "text": "வணக்கம் ஏன்னா உங்க ஒரு கண்ணுதான் தெரியுது ஒரு கண்ணு தெரியல"
    },
    {
      "t": "00:10",
      "text": "சொல்ல ந போச்ச"
    },
    {
      "t": "00:15",
      "text": "ங்களூர் என்ன பண்றங்க"
    },
    {
      "t": "00:20",
      "text": "ஆஹ் பிசினஸ் பண்றேன் நீஹ"
    },
    {
      "t": "00:25",
      "text": "மேரிடா ஆமா அதான் ச"
    },
    {
      "t": "00:30",
      "text": "என்ன பெப்பர் சால்ட் புரியல பெப்பர் அண்ட் சால்டா இருக்கு"
    },
    {
      "t": "00:35",
      "text": "டேஸ்ட் பண்ணி பாக்குறீங்களா"
    },
    {
      "t": "00:40",
      "text": "நல்ஸட் பண்றேன்"
    },
    {
      "t": "00:45",
      "text": "உங்க ஏஜேன் உ"
    },
    {
      "t": "00:50",
      "text": "பேரு ஒண்ணு சொல்லல என் பேர் ஆனந்த் என்னோட பேர் சோனியா ஏ்டோ"
    },
    {
      "t": "00:55",
      "text": "ியட்டு"
    },
    {
      "t": "01:00",
      "text": "ச்ச"
    },
    {
      "t": "01:05",
      "text": "ஆ"
    },
    {
      "t": "01:10",
      "text": "இருக்கீங்கள ச வெளில களம்ப"
    },
    {
      "t": "01:15",
      "text": "கூப்பட போதுங்க"
    },
    {
      "t": "01:20",
      "text": "உங்களுக்கு எப்படி போகுது எாம் ந"
    },
    {
      "t": "01:25",
      "text": "அ போ"
    },
    {
      "t": "01:30",
      "text": "நீங்க மேரிடா நான் மேரிடு"
    },
    {
      "t": "01:35",
      "text": "பண்றீங்க மது நாள்"
    },
    {
      "t": "01:40",
      "text": "போ"
    },
    {
      "t": "01:45",
      "text": "நிறைய பொண்ணுங்கதான் இருப்பாங்களே பேசு நிறைய பேர் இருப்பாங்களே பேசுறதுக்கு"
    },
    {
      "t": "01:50",
      "text": "நம்மளுக்கு இன்டரஸ்ட் வேணும்லா"
    },
    {
      "t": "01:55",
      "text": "அப்பறே இருந்தா பே பண்ண அதாவது"
    },
    {
      "t": "02:00",
      "text": "்சுவலு பண்றது இ"
    },
    {
      "t": "02:05",
      "text": "கொஞ்சம் நீட்டா இருக்கணும்ங்க அந்த மாதிரி புரிய"
    },
    {
      "t": "02:10",
      "text": "நீட்டு உங்கள மாதிரி பேசனும் பேசணும்னு நல்லா இருக்கும் நான"
    },
    {
      "t": "02:15",
      "text": "நல்லாவா இருக்கீங்க வேஸா"
    },
    {
      "t": "02:20",
      "text": "ஆஹ் ஓ"
    }
  ],
  "full_text": "ஹலோஹ வணக்கம் ஏன்னா உங்க ஒரு கண்ணுதான் தெரியுது ஒரு கண்ணு தெரியல சொல்ல ந போச்ச ங்களூர் என்ன பண்றங்க ஆஹ் பிசினஸ் பண்றேன் நீஹ மேரிடா ஆமா அதான் ச என்ன பெப்பர் சால்ட் புரியல பெப்பர் அண்ட் சால்டா இருக்கு டேஸ்ட் பண்ணி பாக்குறீங்களா நல்ஸட் பண்றேன் உங்க ஏஜேன் உ பேரு ஒண்ணு சொல்லல என் பேர் ஆனந்த் என்னோட பேர் சோனியா ஏ்டோ ியட்டு ச்ச ஆ இருக்கீங்கள ச வெளில களம்ப கூப்பட போதுங்க உங்களுக்கு எப்படி போகுது எாம் ந அ போ நீங்க மேரிடா நான் மேரிடு பண்றீங்க மது நாள் போ நிறைய பொண்ணுங்கதான் இருப்பாங்களே பேசு நிறைய பேர் இருப்பாங்களே பேசுறதுக்கு நம்மளுக்கு இன்டரஸ்ட் வேணும்லா அப்பறே இருந்தா பே பண்ண அதாவது ்சுவலு பண்றது இ கொஞ்சம் நீட்டா இருக்கணும்ங்க அந்த மாதிரி புரிய நீட்டு உங்கள மாதிரி பேசனும் பேசணும்னு நல்லா இருக்கும் நான நல்லாவா இருக்கீங்க வேஸா ஆஹ் ஓ",
