    },
    {
      "t": "00:30",
      "text": "ఇద్దరు"
    },
    {
      "t": "00:35",
      "text": "లేడా హస్బం లేడా లేడు"
    },
    {
      "t": "00:40",
      "text": "అవునవు హస్బండ్ తెలుసా ఫోన్ మాట్లాడుతామండి"
    },
    {
      "t": "00:45",
      "text": "తెలుసు ఏమన్నాడా"
    },
    {
      "t": "00:50",
      "text": "దే మేో మ"
