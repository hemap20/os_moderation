    {
      "t": "00:05",
      "text": "చెప్పండి ఎ"
    },
    {
      "t": "00:10",
      "text": "నరతపుర్ నర్తపుర్"
    },
    {
      "t": "00:15",
      "text": "సరేమి నా అక్కడ"
