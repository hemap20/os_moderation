{
  "file_id": "rec_audio_call_426570103_audio_1788982695863.mp3",
  "language": "tamil",
  "chunk_seconds": 5.0,
  "decoding": "ctc",
  "audio_duration_sec": 1229.796,
  "processing_time_sec": 27.517574071884155,
  "segments": [
    {
      "t": "00:00",
      "text": "ஹலோ ஹலோ"
    },
    {
      "t": "00:05",
      "text": "ஹஹ் எந்த ஊர் நீங்க"
    },
    {
      "t": "00:10",
      "text": "பிரஷனை இல்லைீங்க"
    },
    {
      "t": "00:15",
      "text": ""
    },
    {
      "t": "00:20",
      "text": "டிட்டா"
    },
    {
      "t": "00:25",
      "text": ""
    },
    {
      "t": "00:30",
      "text": "ஆஹ்"
    },
    {
      "t": "00:35",
      "text": "ஹவுஸ் வப்ா இருக்க ஹஸ் வப்"
    },
    {
      "t": "00:40",
      "text": "ஏன் என்ல்ல பொறுமைய பொ பேசுற"
    },
    {
      "t": "00:45",
      "text": ""
    },
    {
      "t": "00:50",
      "text": "இல்லைங்க நான் பேசுறது உங்களுக்கு லேட்டா கேள்து நினைக்கிறேன்"
    },
    {
      "t": "00:55",
      "text": "உம் ஆமா அதான்"
    },
    {
      "t": "01:00",
      "text": "அபடபரா சொல்றீங்கள"
    },
    {
      "t": "01:05",
      "text": ""
    },
    {
      "t": "01:10",
      "text": "சொல்லுங்க என்ன சொல்லும்"
    },
    {
      "t": "01:15",
      "text": "என்னன்னா சொல்லாமா"
    },
    {
      "t": "01:20",
      "text": "உம்"
    },
    {
      "t": "01:25",
      "text": "உண் என்ம சொல்ல உண்மா"
    },
    {
      "t": "01:30",
      "text": "எப்படி இருக்கு"
    },
    {
      "t": "01:35",
      "text": ""
    },
    {
      "t": "01:40",
      "text": "ஹலோ உம்"
    },
    {
      "t": "01:45",
      "text": "மாறாதான் இருப்பேன்"
    },
    {
      "t": "01:50",
      "text": ""
    },
    {
      "t": "01:55",
      "text": "உம் அப்புறம் சுமார் இருப்பீன்ன"
    },
    {
      "t": "02:00",
      "text": "எப்படி சொல்றது எப்படி சொல்லணும் சொல்லி தாங்க"
    },
    {
      "t": "02:05",
      "text": "ந"
    },
    {
      "t": "02:10",
      "text": "சொல்லுமா ஆமா"
    },
    {
      "t": "02:15",
      "text": "ம்"
    },
    {
      "t": "02:20",
      "text": "நீங்க இதுல எப்படி பேசுவீங்க என்ன பேசுவீங்களா எப்படி வேணும் பேசுவன்"
    },
    {
      "t": "02:25",
      "text": "உம் கனல்ல இருக்கீங்களல"
    },
    {
      "t": "02:30",
      "text": "ரொம்ப நாளா இருக்கீங்களா அந்தா"
    },
    {
      "t": "02:35",
      "text": "உம் ஆமா"
    },
    {
      "t": "02:40",
      "text": "நீங்க கடைசியா எப்போ செக்ஸ் பண்ணுங்க"
    },
    {
      "t": "02:45",
      "text": "கடைசியா போன வாரத்துல"
    },
    {
      "t": "02:50",
      "text": "ஒரு வாரம் ஆச்சா"
    },
    {
      "t": "02:55",
      "text": "என் ப இல்லையா"
    },
    {
      "t": "03:00",
      "text": "ஹஸ்பண்ட் இல்லைங்க"
    },
    {
      "t": "03:05",
      "text": "வ ஒன் தானம் இ ஒன்"
    },
    {
      "t": "03:10",
      "text": "உம் இயர்லி ஒன் டைம்"
    },
    {
      "t": "03:15",
      "text": "ஆ ப இருலாம்"
    },
    {
      "t": "03:20",
      "text": "எத்தனை வருஷம் ஆும்"
    },
    {
      "t": "03:25",
      "text": "ற அ மூணு வருஷமா இருக்காரு"
    },
    {
      "t": "03:30",
      "text": "எல்லா டைம்ல மூடு வந்தா என்ன பண்ணுவீங்க"
    },
    {
      "t": "03:35",
      "text": "ந்த ஆப்ல வருவான்"
    },
    {
      "t": "03:40",
      "text": "ஏ சொல்ல அப்படி இன்னா எனக்கு ஏ புடிச்ச"
    },
    {
      "t": "03:45",
      "text": "ந்துச்சுன்னா சும்மா கீழே மட்டும் வாங்க வைக்க"
    },
    {
      "t": "03:50",
      "text": "சொல்ல"
    },
    {
      "t": "03:55",
      "text": "எ நேரல வந்தா இல்ல போன்ல தானே"
    },
    {
      "t": "04:00",
      "text": "ஏ"
    },
    {
      "t": "04:05",
      "text": "எனக்கு தெரிஞ்ச ஒரு பைய இருக்க பண்ணி கொடுப்பான்"
    },
    {
      "t": "04:10",
      "text": "எப்ப போ ந"
    },
    {
      "t": "04:15",
      "text": "உம் ஆமா நல்லா அக்கி சொல்லுவோான்"
    },
    {
      "t": "04:20",
      "text": "ஹ"
    },
    {
      "t": "04:25",
      "text": "நல்லா நக்குவானா"
    },
    {
      "t": "04:30",
      "text": "ஆமா நல்ல நடக்கும்"
    },
    {
      "t": "04:35",
      "text": "ஆக்க உள்ள விட்டு"
    },
    {
      "t": "04:40",
      "text": "உம் பருப்புல்லாம் போட்டுடு சப்பு சப்பு"
    },
    {
      "t": "04:45",
      "text": "சப்பத்தி எடுப்போம்"
    },
    {
      "t": "04:50",
      "text": "வீட்டு பக்கத்தல இருக்கிறன் ஆமா"
    },
    {
      "t": "04:55",
      "text": "அஸப ததலாதல்ல"
    },
    {
      "t": "05:00",
      "text": "ஆமா இல்லாத அப்ப மட்டும்"
    },
    {
      "t": "05:05",
      "text": "எப்படி கஷ்ட"
    },
    {
      "t": "05:10",
      "text": "எப்படி பண்ணா எப்படி எப்ப சொல்லாம்"
    },
    {
      "t": "05:15",
      "text": "அவன் எங்க வீட்டு மாடி எங்க வீட்டு மாடிய இல்ல நான் இருந்தேன் அவங்க வீட்டு முடிய"
    },
    {
      "t": "05:20",
      "text": "ந வரனாப்ப பாாரப்போம்"
    },
    {
      "t": "05:25",
      "text": "அஹ் மாடி வந்து பாத்தீங்கன்னா அப்படி ஜம்ப் பண்ணி வர மாதிரிதான் இருக்கும்"
    },
    {
      "t": "05:30",
      "text": "ரொம்ப டிஸ்டன்ஸ்லாம் இல்"
    },
    {
      "t": "05:35",
      "text": "அப்ப நைட்ல வரும்பல எங்க வீட்டு"
    },
    {
      "t": "05:40",
      "text": "ந பேசன் போன்ு பேச மாடியில போனேன்"
    },
    {
      "t": "05:45",
      "text": "அப்போம் பேசிட்டம்ந்தான்"
    },
    {
      "t": "05:50",
      "text": "நான் எங்க வீட்டுக்காரக்கிட்ட கொஞ்சம் அதுவா பேசிட்டேந்த"
    },
    {
      "t": "05:55",
      "text": "ஆஹ் வறுக்கது நான் கவனிக்கல"
    },
    {
      "t": "06:00",
      "text": "திடீ நான் எல்லாம் பேசுமே இருக்குமோ திடீனு நந்தம்"
    },
    {
      "t": "06:05",
      "text": "அப்ப சொன்னா சரி"
    },
    {
      "t": "06:10",
      "text": "அவ வந்து ஸ்ட்டே எப்படி உங்ககிட்ட கேட்ட நான்"
    },
    {
      "t": "06:15",
      "text": "ஆஹ்ல ந"
    },
    {
      "t": "06:20",
      "text": "கொஞ்சம் மழையெல்லாம் காமிச்சு கொடுத்தேன் உ"
    },
    {
      "t": "06:25",
      "text": "ஆ நல்லா பாப்பான்"
    },
    {
      "t": "06:30",
      "text": ""
    },
    {
      "t": "06:35",
      "text": "புரியல அவ சொ"
    },
    {
      "t": "06:40",
      "text": "நல்லா இருக்கும் நான் பாாரத்துட்டே இருப்பேன்"
    },
    {
      "t": "06:45",
      "text": "என்ன தூப்பிட்டு கேட்டான் ஏன் என்ன அப்படி பாக்குற அப்படின்னு"
    },
    {
      "t": "06:50",
      "text": "பாக்கணும் போல இருக்குக்கு இந்த மாதிரி பண்ணணும் அப்படின்னு நான் கேட்டேன்"
    },
    {
      "t": "06:55",
      "text": "மாடி மாலை"
    },
    {
      "t": "07:00",
      "text": "வச்சு நைட்டிங தான்"
    },
    {
      "t": "07:05",
      "text": "அழமை கில நாச"
    },
    {
      "t": "07:10",
      "text": "சாரி கட்டிருந்தோம் அங்க வந்து இப்படி வந்து"
    },
    {
      "t": "07:15",
      "text": "நான் இனமே வந்தான் அவன் அப்படி கீழ என் கால"
    },
    {
      "t": "07:20",
      "text": "குச்சட்டு நக்கினாம"
    },
    {
      "t": "07:25",
      "text": "உம்"
    },
    {
      "t": "07:30",
      "text": ""
    },
    {
      "t": "07:35",
      "text": "க போ"
    },
    {
      "t": "07:40",
      "text": "ஆ ஆமா"
    },
    {
      "t": "07:45",
      "text": "புரிய ஆமாடா"
    },
    {
      "t": "07:50",
      "text": "ஏது பண்ணது இலையா"
    },
    {
      "t": "07:55",
      "text": "ங்க்ஸ் கொடுத்தா நல்ல பண்ணுவன்"
    },
    {
      "t": "08:00",
      "text": ""
    },
    {
      "t": "08:05",
      "text": "நீங்க எ போோதும் போதும் சொல்ற கூ பண்ணலாம்"
    },
    {
      "t": "08:10",
      "text": "ஆஹ் போும்ன்னு சொல்ல மாட்டேங்கே"
    },
    {
      "t": "08:15",
      "text": "நான் எடுக்கவே மாட்டேன் எனக்கு"
    },
    {
      "t": "08:20",
      "text": "பே இருக்கணும் எனக்கு"
    },
    {
      "t": "08:25",
      "text": "டி கிழிஞ்சாலும் க்கணும்"
    },
    {
      "t": "08:30",
      "text": "உம் ஓகே தெ"
    },
    {
      "t": "08:35",
      "text": ""
    },
    {
      "t": "08:40",
      "text": "உஹம்ப்படிான் உ உஹம்"
    },
    {
      "t": "08:45",
      "text": "எப்படல்லாம் உங்க வக்கணும்"
    },
    {
      "t": "08:50",
      "text": "போக்குரத்துல எப்படி ஒருத்தாலும் வந்து கோப்ரேட் பண்ண"
    },
    {
      "t": "08:55",
      "text": "ூக்கி வச்சு அடிக்க"
    },
    {
      "t": "09:00",
      "text": "பண்ண"
    },
    {
      "t": "09:05",
      "text": "ரெண்டு களை மடிச்சு நர தூக்கி சுண்ணி எத்துக்கு"
    },
    {
      "t": "09:10",
      "text": "ம்"
    },
    {
      "t": "09:15",
      "text": "ரொம்ப வெறி ரொம்ப வெறி"
    },
    {
      "t": "09:20",
      "text": "திருச்ச போல"
    },
    {
      "t": "09:25",
      "text": "நீடி பண்ண சொ"
    },
    {
      "t": "09:30",
      "text": "இல்ல உங்க மேல ரெண்ட பசைக்கு நல்லா ப"
    },
    {
      "t": "09:35",
      "text": "ச ச ப"
    },
    {
      "t": "09:40",
      "text": "எனக்கு முப்பத்தி எட்டு சைஸ்"
    },
    {
      "t": "09:45",
      "text": "புரியல முப்பத்தி எட்ட நல்ல பேச தான்"
    },
    {
      "t": "09:50",
      "text": "நல்லா பால் பிடிக்கிறாங்க"
    },
    {
      "t": "09:55",
      "text": "புரியல வாய் பாரத்தாதே"
    },
    {
      "t": "10:00",
      "text": "அ பத்தண்ணாயணும்டிே"
    },
    {
      "t": "10:05",
      "text": ""
    },
    {
      "t": "10:10",
      "text": "அாம் காசக்கு காசக்கு பால தச்சி"
    },
    {
      "t": "10:15",
      "text": "அப்படிய சொல்லவேன் கவே வண்டு"
    },
    {
      "t": "10:20",
      "text": "வாய் வச்சு நக்கம்"
    },
    {
      "t": "10:25",
      "text": ""
    },
    {
      "t": "10:30",
      "text": "உக்கு என்னட்ட"
    },
    {
      "t": "10:35",
      "text": "நய சொன்ன"
    },
    {
      "t": "10:40",
      "text": "என்வ சார்"
    },
    {
      "t": "10:45",
      "text": "உஹம்"
    },
    {
      "t": "10:50",
      "text": "உஹம்"
    },
    {
      "t": "10:55",
      "text": "சொன்னி எப்படி இருக்கும் யோசிக்கலாம்"
    },
    {
      "t": "11:00",
      "text": "ஏனும் அடிப்படின்னு சொல்லி"
    },
    {
      "t": "11:05",
      "text": "மாடிப்படின்னு சொல்லி"
    },
    {
      "t": "11:10",
      "text": "சொ சரி"
    },
    {
      "t": "11:15",
      "text": "அசிங்கமா பேசிருக்கோம்"
    },
    {
      "t": "11:20",
      "text": "பேசதா எவனச"
    },
    {
      "t": "11:25",
      "text": "உனால உள்ள்ளோ முனிதான் வணும்"
    },
    {
      "t": "11:30",
      "text": "ந ந தமா போல"
    },
    {
      "t": "11:35",
      "text": "ஆஹ"
    },
    {
      "t": "11:40",
      "text": "போடி கழ க வாக்க"
    },
    {
      "t": "11:45",
      "text": "இது போன கிடையே கிடையே வக்கணடி"
    },
    {
      "t": "11:50",
      "text": "மாதிர பண்ணா"
    },
    {
      "t": "11:55",
      "text": "நால விசச்சு காமிப்பா"
    },
    {
      "t": "12:00",
      "text": "நீ நல்லா எரிச்சு கட்டுறிய"
    },
    {
      "t": "12:05",
      "text": "ஏக்கன அவ"
    },
    {
      "t": "12:10",
      "text": "எனக்கு ஆனா இப்ப இதல்லாம் பேசுினா மூணாவது வெள்ளிய"
    },
    {
      "t": "12:15",
      "text": "வ சியா"
    },
    {
      "t": "12:20",
      "text": "உள்ள விட்டு செய்யணும்"
    },
    {
      "t": "12:25",
      "text": "செய் செய் இருா"
    },
    {
      "t": "12:30",
      "text": "அப்ப நாம் டுவா"
    },
    {
      "t": "12:35",
      "text": "நீ எல்லாருக்கும் சொல்ல வ க்க தான்"
    },
    {
      "t": "12:40",
      "text": "உஹம்"
    },
    {
      "t": "12:45",
      "text": "சொல்லடி"
    },
    {
      "t": "12:50",
      "text": "என் எங்க அத்துு சொல்"
    },
    {
      "t": "12:55",
      "text": "வந்து ஒருப்பறங்க ந சொன்ன"
    },
    {
      "t": "13:00",
      "text": "சனி கஷ நகிர"
    },
    {
      "t": "13:05",
      "text": "சொ கிருஷ்ணகிர"
    },
    {
      "t": "13:10",
      "text": "விஷ்ணகிரியா கஷ்ணகிரியான் வந்திருக்கேன்"
    },
    {
      "t": "13:15",
      "text": "ஆஹ"
    },
    {
      "t": "13:20",
      "text": ""
    },
    {
      "t": "13:25",
      "text": "அட்டி வரும்பது வர"
    },
    {
      "t": "13:30",
      "text": "ன அஷ"
    },
    {
      "t": "13:35",
      "text": "ஹ"
    },
    {
      "t": "13:40",
      "text": "சா சரி நான் சொ"
    },
    {
      "t": "13:45",
      "text": "உம் செய்யறண்டடி உண்டா"
    },
    {
      "t": "13:50",
      "text": "கொண்டிய விடிக்கிறமா நல்லத்துக்க"
    },
    {
      "t": "13:55",
      "text": "நீ நல்ல விரக்க வறுக்க நான் ஒண்ண அவச்சிட்ட இருக்கி"
    },
    {
      "t": "14:00",
      "text": "நீ ஓக்குறோங்கற தகுன்னா என் பொண்டிய நான் அத விரிப்பேன்"
    },
    {
      "t": "14:05",
      "text": "உம்ச்ச"
    },
    {
      "t": "14:10",
      "text": "பே"
    },
    {
      "t": "14:15",
      "text": "இட்டு சடி சொல்லா"
    },
    {
      "t": "14:20",
      "text": "சரி தான் சரு அ வேகமா நமக்கு"
    },
    {
      "t": "14:25",
      "text": "சாம சொ"
    },
    {
      "t": "14:30",
      "text": "அ எப்பட்டு எப்பட்டு டு"
    },
    {
      "t": "14:35",
      "text": "ரத்த கொத்த ர"
    },
    {
      "t": "14:40",
      "text": "எமா குத்து குத்து"
    },
    {
      "t": "14:45",
      "text": "க"
    },
    {
      "t": "14:50",
      "text": "அப்படியே உன் குத்தக்கிட்டே உ பருப்புடுத்துங்க"
    },
    {
      "t": "14:55",
      "text": "கீழ அந்த விரல வச்சு ச சே்சுக்கிட்டே தேய்ச்சுிக்கிட்டே நம்ம"
    },
    {
      "t": "15:00",
      "text": "அயயோ ஆமா"
    },
    {
      "t": "15:05",
      "text": "நல்லா தே்சன்னு தேய்ச்சுட்டுத்தபத்தன்ன பச்சுவ"
    },
    {
      "t": "15:10",
      "text": "அப்படிின் இந்தல எ சுத்திக்கிட்டு"
    },
    {
      "t": "15:15",
      "text": "உம்"
    },
    {
      "t": "15:20",
      "text": ""
    },
    {
      "t": "15:25",
      "text": "பொன்றுல இருந்து தண்ணி வரும மாமா"
    },
    {
      "t": "15:30",
      "text": "ஆமா தண்ணி வருங்க"
    },
    {
      "t": "15:35",
      "text": "ந"
    },
    {
      "t": "15:40",
      "text": "ஓ எவும் போியா"
    },
    {
      "t": "15:45",
      "text": "ஆ"
    },
    {
      "t": "15:50",
      "text": "புரியலஹ"
    },
    {
      "t": "15:55",
      "text": "நீ எ"
    },
    {
      "t": "16:00",
      "text": "உ நல்ல"
    },
    {
      "t": "16:05",
      "text": "வாயனச்சமாக்கவே மாட்டான்"
    },
    {
      "t": "16:10",
      "text": "நானும்டவே மாட்டேம் சொன்றறேன்"
    },
    {
      "t": "16:15",
      "text": "ஒன்ருக்கு அப்படியே படுத்துக்கிட்டே"
    },
    {
      "t": "16:20",
      "text": "போக என்"
    },
    {
      "t": "16:25",
      "text": "ருக்க"
    },
    {
      "t": "16:30",
      "text": ""
    },
    {
      "t": "16:35",
      "text": "உ க கச்ச நாவ சி சி"
    },
    {
      "t": "16:40",
      "text": "உ நல்லா இருக்கும்"
    },
    {
      "t": "16:45",
      "text": "நல்லாக்குண்டா பேச உத"
    },
    {
      "t": "16:50",
      "text": "நல்லா இருக்கு பண்ணா இன்னும் நல்லா இருே ஆ"
    },
    {
      "t": "16:55",
      "text": ""
    },
    {
      "t": "17:00",
      "text": "எப்ப பண்ணலாம் நிறைய எக்ஸ்ப்ளோர் பண்ணு"
    },
    {
      "t": "17:05",
      "text": "என்னல்லாம் என்னல்லாம் சொல்லு"
    },
    {
      "t": "17:10",
      "text": ""
    },
    {
      "t": "17:15",
      "text": "இது வாழ்நாள் நினைச்சு பா"
    },
    {
      "t": "17:20",
      "text": "போ மாதிரி செய்யணஹ"
    },
    {
      "t": "17:25",
      "text": "நாளை"
    },
    {
      "t": "17:30",
      "text": "அஞ்சு ரவுண்டு ஆறு ரவுண்டு போனும்"
    },
    {
      "t": "17:35",
      "text": "டய்ட ஆயிருயா"
    },
    {
      "t": "17:40",
      "text": "ம் ம்"
    },
    {
      "t": "17:45",
      "text": "மா சொல்லாது டயர்ட ஆயிது ஒரு வாட்டி உனக்கு வெளியே வந்தாலே டயர்டு தான்"
    },
    {
      "t": "17:50",
      "text": "ஹ"
    },
    {
      "t": "17:55",
      "text": ""
    },
    {
      "t": "18:00",
      "text": "ஹஸ்பண்ட் அதானே ஒரு நாளைக்கு எத்தனை ட்டி பண்ணாரு"
    },
    {
      "t": "18:05",
      "text": "உம் மன"
    },
    {
      "t": "18:10",
      "text": "டெய்லியும் மூணு மூு மூணுுவ்த்தா"
    },
    {
      "t": "18:15",
      "text": "ம்"
    },
    {
      "t": "18:20",
      "text": "என்ன"
    },
    {
      "t": "18:25",
      "text": "ஆஹ கையை விட்டு நோன்றறிய"
    },
    {
      "t": "18:30",
      "text": "ஆஹ உ"
    },
    {
      "t": "18:35",
      "text": "இல்ல ச்கிறியா ச்கிறியா"
    },
    {
      "t": "18:40",
      "text": "வே என்ன சொ"
    },
    {
      "t": "18:45",
      "text": "என்ன ஆா"
    },
    {
      "t": "18:50",
      "text": "சொல்லடி என்ன பண்றேன்"
    },
    {
      "t": "18:55",
      "text": "ஆம்"
    },
    {
      "t": "19:00",
      "text": "என்ன உப்ப"
    },
    {
      "t": "19:05",
      "text": "ஹ"
    },
    {
      "t": "19:10",
      "text": "புரியல அத"
    },
    {
      "t": "19:15",
      "text": "ஒண்ணமா"
    },
    {
      "t": "19:20",
      "text": "அ ச"
    },
    {
      "t": "19:25",
      "text": ""
    },
    {
      "t": "19:30",
      "text": "எப்போ பத்திர அளவுக்கு எவ்வளவுும் அப்போ அது வரைக்கும் செய்ய வேண்டியதுதான்"
    },
    {
      "t": "19:35",
      "text": "உங்களுக்கு என்ன ஆசை எது மாதிரி பண்ணணும்"
    },
    {
      "t": "19:40",
      "text": ""
    },
    {
      "t": "19:45",
      "text": "வாய எச்ச உக்கு வரவேற்கணமாா"
    },
    {
      "t": "19:50",
      "text": "ஓ"
    },
    {
      "t": "19:55",
      "text": "ச இக்குத"
    },
    {
      "t": "20:00",
      "text": ""
    },
    {
      "t": "20:05",
      "text": "ஹலோ ஆ"
    },
    {
      "t": "20:10",
      "text": ""
    },
    {
      "t": "20:15",
      "text": ""
    },
    {
      "t": "20:20",
      "text": ""
    },
    {
      "t": "20:25",
      "text": ""
    }
