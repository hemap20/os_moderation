    {
      "t": "00:05",
      "text": "ஹலோ ஹலோ"
    },
    {
      "t": "00:10",
      "text": "போஹ எங்கந்து பேசுறீங்க"
    },
    {
      "t": "00:15",
      "text": "நான் வீட்டுல இருந்து நானும் வீட்டு"
    },
    {
      "t": "00:20",
      "text": "ிசன் எந்த ஊரு உங்க வீடு எந்த ஊர்ல இருக்குது"
    },
    {
      "t": "00:25",
      "text": "வீடு கிடையாது  இங்க இருக்கேன் பெங்களூர்ங்கள"
    },
    {
      "t": "00:30",
      "text": "ல இருக்கேன் ஏன் வீடியோ கத்த பண்ணக்கீங்க மாட்டங்களா"
    },
    {
      "t": "00:35",
      "text": "நான் அழகா இருக்க மாட்டேம்லயயோயோ"
    },
    {
      "t": "00:40",
      "text": "என்னன்ன மாப்பிளை வா பா்க வந்திருக்கேன் அழகா இருக்கீங்களா என்னன்னு பாக்குறக்கு"
    },
    {
      "t": "00:45",
      "text": "உஹம் மாப்பிளை பாக்கம் வந்திருக்கே நாங்க"
    },
    {
      "t": "00:50",
      "text": "தெரியலையே உம்"
    },
    {
      "t": "00:55",
      "text": "சொல்லுங்க"
    },
    {
      "t": "01:00",
      "text": "என் பேர் சுமதி மேரட்ஹவுஸ் வாப்ீடிய"
    },
    {
      "t": "01:05",
      "text": "ம பேசலாமா இன்ட்ரெஸ்ட் இருக்கா"
    },
    {
      "t": "01:10",
      "text": "உம் புரியல"
    },
    {
      "t": "01:15",
      "text": "ச த் பேர்"
    },
    {
      "t": "01:20",
      "text": "பண்ணனும் நூட பேசுவன் டைம் லிமிட் இல்ல உ வரைக்கும் நான் பேசுவேன் ஓகே"
    },
    {
      "t": "01:25",
      "text": "எதான்"
    },
    {
      "t": "01:30",
      "text": "டபுள் நைன் போர் தரீ சிக்ஸ்"
    },
    {
      "t": "01:35",
      "text": "போட"
