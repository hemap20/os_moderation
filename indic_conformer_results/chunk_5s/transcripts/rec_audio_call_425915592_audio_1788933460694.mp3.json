  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ ഹലോ"
    },
    {
      "t": "00:05",
      "text": "ഹലോ കേക്കുന്നുണ്ടോ"
    },
    {
      "t": "00:10",
      "text": "തലടിയ ഇത് പാലക്കാട്"
    },
    {
      "t": "00:15",
      "text": "എന്ത്"
    },
    {
      "t": "00:20",
      "text": "ഞാൻ മാർക്കറ്റിംഗ എക്സിക്യൂട്ടീവ ആയിട്ട് വർക്ക് ചെയ നിങ്ങ എന്താ ചെയ്യുന്നേ"
    },
    {
      "t": "00:25",
      "text": "എവിടുന്നാ"
    },
    {
      "t": "00:30",
      "text": "തൃശൂര് തൃശൂര്"
    },
    {
      "t": "00:35",
      "text": "എത്ര ഏജൊക്കെ ഉണ്ട്"
    },
    {
      "t": "00:40",
      "text": "തക്ക ഫ"
    },
    {
      "t": "00:45",
      "text": "ഹസ്ബൻഡ് ഒക്കെ അപ്പ"
    },
    {
      "t": "00:50",
      "text": "എന്താ എടുക്കുന്ന വട്ട"
    },
    {
      "t": "00:55",
      "text": "വൈഫ്ുണ്ട് രണ്ട് മക്കളുണ്ട്"
    },
    {
      "t": "01:00",
      "text": "ഹൗസ് വൈഫ് ആാണ് ഇപ്പൊ പുറത്തു പോയി"
    },
    {
      "t": "01:05",
      "text": "മക്കള എത്രല്ല"
    },
    {
      "t": "01:10",
      "text": "മക്കൾ എട്ടിലും നാലിലും"
    },
    {
      "t": "01:15",
      "text": "നിങ്ങളടയോ"
    },
    {
      "t": "01:20",
      "text": "ആ രണ്ടപേഴ ഒന്നില്"
    },
    {
      "t": "01:25",
      "text": "ഒന്നില്ല ചെറിയ പിള്ളോരാ ഹസ്ബൻഡ്"
    },
    {
      "t": "01:30",
      "text": "ഡ്രൈവറണ് ആട്ടിട്ടല്ല അവിടെ കാല"
    },
    {
      "t": "01:35",
      "text": "കുഴപ്പില്ല ചൂടാ പലക്കടല്ല"
    },
    {
      "t": "01:40",
      "text": "ചൂട ഇതി എത്ര ആണ"
    },
    {
      "t": "01:45",
      "text": "ഏകദേശം ഒരു  വീക്സ് ത്രീ വീക്സ് ഒക്കെ ആയി എങ്ങന"
    },
    {
      "t": "01:50",
      "text": "എനിക്ക് കൊഴപ്പില്ലാന്ന് തോന്നിയ നിക്കോ"
    },
    {
      "t": "01:55",
      "text": "ഉ ഉ ഉഴപ്പില്ലങ്ങനെ"
    },
    {
      "t": "02:00",
      "text": "എങ്ങനെ നോർമൽ നോർമൽ ടോക്ക് മാത്രമേ ഉള്ളൂ അതെല്ലാം ടോപ്പ സംസാരിക്കുവോോർൽ"
    },
    {
      "t": "02:05",
      "text": "നോർമൽ മാത്രേ ഉള്ളു ഓക്കെ"
    },
    {
      "t": "02:10",
      "text": "ഇ എങ്ങനെ ചറിയ"
    },
    {
      "t": "02:15",
      "text": "ഉ ഉ പിന്നെ"
    },
    {
      "t": "02:20",
      "text": "പത്തോഷ"
    },
    {
      "t": "02:25",
      "text": "ഇല്ല ഒന്നറ കടാ"
    },
    {
      "t": "02:30",
      "text": "ലവ് വിത്ത് അറേഞ്ച് അങ്ങനെ പറയ കൊഴപ്പണ്ട"
    },
    {
      "t": "02:35",
      "text": "ഞാൻടന്നരുന്നു"
    },
    {
      "t": "02:40",
      "text": "ഞങ്ങൾക്ക്ും അങ്ങ തന്നെയ തോന്ന"
    },
    {
      "t": "02:45",
      "text": "ങ്ങ കൊഴപ്പില്ല ഉഷാറാണ് വല്ിയ കൊഴപ്പൊന്നുമല്ല"
    },
    {
      "t": "02:50",
      "text": "വ വല്ിയ കുഴപ്പില്ലാരും പോണ്ട"
    },
    {
      "t": "02:55",
      "text": "എന്താതിനതിനകത്ത്"
    },
    {
      "t": "03:00",
      "text": "ക"
    },
    {
      "t": "03:05",
      "text": ""
    },
    {
      "t": "03:10",
      "text": "ദവർ പചാാലിച്ച"
    }
  ],
  "full_text": "ഹലോ ഹലോ ഹലോ കേക്കുന്നുണ്ടോ തലടിയ ഇത് പാലക്കാട് എന്ത് ഞാൻ മാർക്കറ്റിംഗ എക്സിക്യൂട്ടീവ ആയിട്ട് വർക്ക് ചെയ നിങ്ങ എന്താ ചെയ്യുന്നേ എവിടുന്നാ തൃശൂര് തൃശൂര് എത്ര ഏജൊക്കെ ഉണ്ട് തക്ക ഫ ഹസ്ബൻഡ് ഒക്കെ അപ്പ എന്താ എടുക്കുന്ന വട്ട വൈഫ്ുണ്ട് രണ്ട് മക്കളുണ്ട് ഹൗസ് വൈഫ് ആാണ് ഇപ്പൊ പുറത്തു പോയി മക്കള എത്രല്ല മക്കൾ എട്ടിലും നാലിലും നിങ്ങളടയോ ആ രണ്ടപേഴ ഒന്നില് ഒന്നില്ല ചെറിയ പിള്ളോരാ ഹസ്ബൻഡ് ഡ്രൈവറണ് ആട്ടിട്ടല്ല അവിടെ കാല കുഴപ്പില്ല ചൂടാ പലക്കടല്ല ചൂട ഇതി എത്ര ആണ ഏകദേശം ഒരു  വീക്സ് ത്രീ വീക്സ് ഒക്കെ ആയി എങ്ങന എനിക്ക് കൊഴപ്പില്ലാന്ന് തോന്നിയ നിക്കോ ഉ ഉ ഉഴപ്പില്ലങ്ങനെ എങ്ങനെ നോർമൽ നോർമൽ ടോക്ക് മാത്രമേ ഉള്ളൂ അതെല്ലാം ടോപ്പ സംസാരിക്കുവോോർൽ നോർമൽ മാത്രേ ഉള്ളു ഓക്കെ ഇ എങ്ങനെ ചറിയ ഉ ഉ പിന്നെ പത്തോഷ ഇല്ല ഒന്നറ കടാ ലവ് വിത്ത് അറേഞ്ച് അങ്ങനെ പറയ കൊഴപ്പണ്ട ഞാൻടന്നരുന്നു ഞങ്ങൾക്ക്ും അങ്ങ തന്നെയ തോന്ന ങ്ങ കൊഴപ്പില്ല ഉഷാറാണ് വല്ിയ കൊഴപ്പൊന്നുമല്ല വ വല്ിയ കുഴപ്പില്ലാരും പോണ്ട എന്താതിനതിനകത്ത് ക  ദവർ പചാാലിച്ച",
