{
  "file_id": "rec_audio_call_422128803_audio_1788577048478.mp3",
  "language": "malayalam",
  "chunk_seconds": 5.0,
  "decoding": "ctc",
  "audio_duration_sec": 528.8239375,
  "processing_time_sec": 11.417433261871338,
  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:05",
      "text": "ഹലോ വ"
    },
    {
      "t": "00:10",
      "text": "ച മലപ്പുറം എന്താന്നെ"
    },
    {
      "t": "00:15",
      "text": "ഉ നസഫണ"
    },
    {
      "t": "00:20",
      "text": "എന്തക്ക് എ മരില്ലാം"
    },
    {
      "t": "00:25",
      "text": "രക്കണ്ട"
    },
    {
      "t": "00:30",
      "text": "ഉ അലളുണ്ടും"
    },
    {
      "t": "00:35",
      "text": "പിന്നെ എന്താണ് പരിപാടി പരിപാടിൊന്നല്ല"
    },
    {
      "t": "00:40",
      "text": "അവിടെ കഴിഞ്ഞു"
    },
    {
      "t": "00:45",
      "text": "എത്ര വയ എത്ര വയസായി"
    },
    {
      "t": "00:50",
      "text": "ഞൻ അഡവൈ വാണ്"
    },
    {
      "t": "00:55",
      "text": "ആ"
    },
    {
      "t": "01:00",
      "text": "പിന്നെ എന്താ പിന്താേ"
    },
    {
      "t": "01:05",
      "text": "ഹസ്ബൻഡടെ നാട്ട തന്നെയാണ് തൃശ്ശൂര്"
    },
    {
      "t": "01:10",
      "text": "ണോ അതെതെ ഉ"
    },
    {
      "t": "01:15",
      "text": "പിന്നെ വരാറില്ലേ വന്നില്ലേ"
    },
    {
      "t": "01:20",
      "text": "ല്ല വന്നില്ലേ"
    },
    {
      "t": "01:25",
      "text": "പിന്നെ ആരൊക്കെ എന്തടെ ഇടെ"
    },
    {
      "t": "01:30",
      "text": "രണ്ടുപേരേ ഉള്ളു"
    },
    {
      "t": "01:35",
      "text": "പി പിന്നെ"
    },
    {
      "t": "01:40",
      "text": "പിന്നെന്താ പറ പറ"
    },
    {
      "t": "01:45",
      "text": "താ പറ"
    },
    {
      "t": "01:50",
      "text": "പറ പുള്ളിക്കാരൻ അവിടെ ഇന്ന് കഴിഞ്ഞ അങ്ങനെ"
    },
    {
      "t": "01:55",
      "text": "രാവിലെ കളിയൊന്നല്ലേ"
    },
    {
      "t": "02:00",
      "text": "കള്യുക കളിയില്ലാന്നിങ്ങനെയ"
    },
    {
      "t": "02:05",
      "text": "അറിയത്തില്ല"
    },
    {
      "t": "02:10",
      "text": "പുള്ളി വരത്തില്ല ഇല്ല ഉ പുുള്ളി"
    },
    {
      "t": "02:15",
      "text": "വല്ലപ്പോഴേലീ വിട്ടത്തുള്ളൂ"
    },
    {
      "t": "02:20",
      "text": "എന്താ കൂടുതൽ ഇഷ്ടം എല്ലാം ഇഷ്ടവാ"
    },
    {
      "t": "02:25",
      "text": "ഉ എല്ലാം ഇഷ്ടമാണ്"
    },
    {
      "t": "02:30",
      "text": "ഉ എന്നാലും കൂടെലാം"
    },
    {
      "t": "02:35",
      "text": "കൂടുതലും ഓറലൊക്കെയ ഇഷ്ടം ഓറൽ സെക്സ്"
    },
    {
      "t": "02:40",
      "text": "ഉ"
    },
    {
      "t": "02:45",
      "text": "പിന്ന പിന്നെ പറം"
    },
    {
      "t": "02:50",
      "text": "ഉ താര"
    },
    {
      "t": "02:55",
      "text": "പറ"
    },
    {
      "t": "03:00",
      "text": "പറ ദ പറ"
    },
    {
      "t": "03:05",
      "text": "ഇരിലാരലും ഉണ്ടോ ഇല്ല"
    },
    {
      "t": "03:10",
      "text": "പിനന്തപുറം"
    },
    {
      "t": "03:15",
      "text": "ജോലിൽന്ന്"
    },
    {
      "t": "03:20",
      "text": "കൊണ്ട് പത്ത് മണിയക്കെ ആവുമ്പോ പോയാൽ മതി"
    },
    {
      "t": "03:25",
      "text": "വീട്ടില ആാരൊക്കെയുണ്ട് മരിഡ ആണോ"
    },
    {
      "t": "03:30",
      "text": "അല്ല ശങ്ങളാം"
    },
    {
      "t": "03:35",
      "text": "എന്ത വട്ടി മുപ്പത് വയസ്സ വട്ടും കിട്ടാത്ത"
    },
    {
      "t": "03:40",
      "text": "നോക്കുന്നുണ്ട്"
    },
    {
      "t": "03:45",
      "text": "നേരത്തെ പറഞ്ഞണ്ടായിരുന്നു തേച്ചു"
    },
    {
      "t": "03:50",
      "text": "എന്താ പറ്റിയതാണ് എ"
    },
    {
      "t": "03:55",
      "text": "പറ്റിയത് ഞമക്ക് വേറെ ഉണ്ടായിരുന്നു"
    },
    {
      "t": "04:00",
      "text": "അടിപൊളി"
    },
    {
      "t": "04:05",
      "text": "കളച്ച്ടുത്ത പോയി"
    },
    {
      "t": "04:10",
      "text": "ഓട്ടെ ഓട്ടെ ഉ സാരില്ലേട്ടോ"
    },
    {
      "t": "04:15",
      "text": "അവളെ കളിച്ച മടുത്ത്പഴത്തേന്നെ പോയിന്ന് പോട്ടെ പോട്ടെ സാര"
    },
    {
      "t": "04:20",
      "text": "കെട്ടിയായിരുന്ന"
    },
    {
      "t": "04:25",
      "text": "ഇപ്പ മശ ആട്ട ഇരിക്കണ്ട വന്ന തന്നെ"
    },
    {
      "t": "04:30",
      "text": ""
    },
    {
      "t": "04:35",
      "text": "പിന്നെ പറ"
    },
    {
      "t": "04:40",
      "text": "ഉ പറ കളിക്കാൻ മൂടെണ്ടോ"
    },
    {
      "t": "04:45",
      "text": "കളിക്കാൻ പോടണ്ടോ"
    },
    {
      "t": "04:50",
      "text": "ഉണ്ട് എന്ന"
    },
    {
      "t": "04:55",
      "text": "ഇതിനകത്ത കൂടെ കളിക്കാൻ മുകളളില്ല"
    },
    {
      "t": "05:00",
      "text": "ഫോണിനകത്തോടെ കളിക്കാൻ മൂടില്ല പിന്നെന"
    },
    {
      "t": "05:05",
      "text": "നേരിട്ട് വേണേ നോക്കാം"
    },
    {
      "t": "05:10",
      "text": "ഏറ്റവും വലിയ അവിടെ അവിടെ വല്ലോ എന്തുവാ"
    },
    {
      "t": "05:15",
      "text": "എവിടെ പറഞ്ഞ്പം മലപ്പുറ വ"
    },
    {
      "t": "05:20",
      "text": "മലപ്പുറത്ത്ന്ന് പറഞ്ഞിട്ട് എവിടെയാ മലപ്പുറത്ത്"
    },
    {
      "t": "05:25",
      "text": "ണ്ട പെരുന്തൽ മണ്ട"
    },
    {
      "t": "05:30",
      "text": "ആഹ അപ്പൊ എന്ത കാണാ ഓ ഞാന അവിടൊക്കെ വരാറുണ്ട്"
    },
    {
      "t": "05:35",
      "text": "എന്നിട്ട"
    },
    {
      "t": "05:40",
      "text": "റൂ എടുക്കോ എന്തെങ്കിലും ചെയ്യ"
    },
    {
      "t": "05:45",
      "text": "എന്തെങ്കിലും ചെയ്യാം"
    },
    {
      "t": "05:50",
      "text": "എന്തെങ്കിലും ചെയ്യാന്ന് പറഞ്ഞട്ട് എന്താ ഞാൻവിടെ വന്നിട്ട്"
    },
    {
      "t": "05:55",
      "text": "തന്നാ വീട്ടിലോട്ട്വാ"
    },
    {
      "t": "06:00",
      "text": "വീട്ടിലോട്ട് വ വീട്ടേ വരത്തില്ല"
    },
    {
      "t": "06:05",
      "text": "പിന്നെ എത്താൻ പറു"
    },
    {
      "t": "06:10",
      "text": "എന്നാ പിന്നെ താൻ പറ"
    },
    {
      "t": "06:15",
      "text": "റൂ എടുക്കണം ഓക്കെ"
    },
    {
      "t": "06:20",
      "text": "ഉം"
    },
    {
      "t": "06:25",
      "text": "നട്ട"
    },
    {
      "t": "06:30",
      "text": "എന്നട്ട പറ"
    },
    {
      "t": "06:35",
      "text": "പറരാ"
    },
    {
      "t": "06:40",
      "text": "പെരുന്നൽ മണല്ലേ എവിടെയാ"
    },
    {
      "t": "06:45",
      "text": "പത്തനങ്ങാടി ആ"
    },
    {
      "t": "06:50",
      "text": "പ്പത്തനങ്ങാടി"
    },
    {
      "t": "06:55",
      "text": "പിന്നെ"
    },
    {
      "t": "07:00",
      "text": "പിന്നെന്താ"
    },
    {
      "t": "07:05",
      "text": "ഇന്ന കളിച്ചല്ലേ"
    },
    {
      "t": "07:10",
      "text": "ഇല്ല ഇല്ല"
    },
    {
      "t": "07:15",
      "text": "ആര"
    },
    {
      "t": "07:20",
      "text": "ആരെ കള"
    },
    {
      "t": "07:25",
      "text": "അടുത്തന്ന ആൾക്കാാരല്ല"
    },
    {
      "t": "07:30",
      "text": "എല്ല ഇല്ല"
    },
    {
      "t": "07:35",
      "text": "പിള്ളോര് കളിക്കുന്നതാണോ പ്രായമുള്ളവരെ കളിക്കുന്നതാണോ ഇഷ്ടംിയ"
    },
    {
      "t": "07:40",
      "text": "പിള്ളേർ കളിച്ചിട്ടില്ല പിള്ളോര"
    },
    {
      "t": "07:45",
      "text": "കളിച്ചിട്ടില്ലന്താ"
    },
    {
      "t": "07:50",
      "text": "എന്താന്ന് വച്ചാ ഇപ്പം പറയുന്നില്ല"
    },
    {
      "t": "07:55",
      "text": ""
    },
    {
      "t": "08:00",
      "text": "പിന്നെന്ത"
    },
    {
      "t": "08:05",
      "text": "ആ ഉ"
    },
    {
      "t": "08:10",
      "text": "വീഡിയോ കോൾ ചെയ്യാൻ മോടുണ്ടോ"
    },
    {
      "t": "08:15",
      "text": "എന്ത വിയ"
    },
    {
      "t": "08:20",
      "text": "ഇോ ചെയ്യണ ഇതിലല്ല"
    },
    {
      "t": "08:25",
      "text": "പിന്നെ വാട്സപ്പിൽ പതണ"
    },
    {
      "t": "08:30",
      "text": "ആ കേട്ടല"
    },
    {
      "t": "08:35",
      "text": "മെയിലാണോ അതെ ആഹ"
    },
    {
      "t": "08:40",
      "text": "അ"
    },
    {
      "t": "08:45",
      "text": ""
