  "segments": [
    {
      "t": "00:00",
      "text": "ஹலோ"
    },
    {
      "t": "00:05",
      "text": "இல"
    },
    {
      "t": "00:10",
      "text": "ஏன் கேட்க மாட்டந்துங்க நீங்க பேசல"
    },
    {
      "t": "00:15",
      "text": "உம் எங்கந்து பேசுறீங்க"
    },
    {
      "t": "00:20",
      "text": "க உம் நான் பெங்களூர்"
    },
    {
      "t": "00:25",
      "text": "நான் சிங்கிள் நீங்க சிங்கிளா மேரிடா"
    },
    {
      "t": "00:30",
      "text": "கேட்க மாட்டேன்னுங்க மங்க பேசுறது கிட்ட வச்ச பேசுங்க"
    },
    {
      "t": "00:35",
      "text": "ஆ எவ்ளோ நாள் எப்ப போயட்டு இருக்கேன்"
    },
    {
      "t": "00:40",
      "text": "எப்படி பேசிருக்கேன் எப்படி பேசினா பிடிக்கும்"
    },
    {
      "t": "00:45",
      "text": "கேக்கல"
    },
    {
      "t": "00:50",
      "text": "ஹலோ சொல்லு"
    },
    {
      "t": "00:55",
      "text": "கிட்ட கிட்ட வச்சு பேசண்டான்"
    },
    {
      "t": "01:00",
      "text": "பே கே்க மாட்டேன் காதலை வச்சு பேசுறேன்"
    },
    {
      "t": "01:05",
      "text": "உம்"
    },
    {
      "t": "01:10",
      "text": "எவ்ளவு நாள் எப்படி போயட்டு இருக்கு"
    },
    {
      "t": "01:15",
      "text": ""
    },
    {
      "t": "01:20",
      "text": "பேிருக்க எப்படி பேசலடிய எப்படி பேசிருக்க எப்படி பேசாம்"
    },
    {
      "t": "01:25",
      "text": "பிடிக்கும் பேச"
    },
    {
      "t": "01:30",
      "text": "பண்ணிருக்கீங்களா இப்ப ரீசடாச்சு"
    },
    {
      "t": "01:35",
      "text": "எப்ப பண்ணீங்க"
    },
    {
      "t": "01:40",
      "text": "இல்ல பண்ணதே இல்லையா"
    },
    {
      "t": "01:45",
      "text": "கேக்கல அந்த மாதிரிலாம் பண்ணி ரொம்ப நல்லாச்சு"
    },
    {
      "t": "01:50",
      "text": "ஏன் அவரு என்ங்கங்க அஸ்பண்ட"
    },
    {
      "t": "01:55",
      "text": "அப்போ என்ன பண்றீங்க கண்ட்ரோல் பஃிங்கரிங் வீடியோஸ்"
    },
    {
      "t": "02:00",
      "text": "துவும் சும்மா ஆப்ல வ பேச"
    },
    {
      "t": "02:05",
      "text": "சைஸ் நிப்பல் ஏது காட்ல"
    },
    {
      "t": "02:10",
      "text": "காட்டலாம்ான"
    },
    {
      "t": "02:15",
      "text": ""
    },
    {
      "t": "02:20",
      "text": "ஓபன் பண்ணி கட்டலேன்"
    },
    {
      "t": "02:25",
      "text": "அதனால அதோடு"
    }
  ],
