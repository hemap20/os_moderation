    {
      "t": "00:20",
      "text": "കല്യാണംണം കഴിഞ്ഞ"
    },
    {
      "t": "00:25",
      "text": "എത്രാവസണ്ട് ട്വന്റി സെവൻ"
    },
    {
      "t": "00:30",
      "text": "എങ്ങനെ എല്ലാ കോളോ"
    },
    {
      "t": "00:35",
      "text": "പ്പ പിന്ത"
    },
    {
      "t": "00:40",
      "text": "കേട്ട എന്ത് ചോദിച്ച കേട്ടില്ല"
