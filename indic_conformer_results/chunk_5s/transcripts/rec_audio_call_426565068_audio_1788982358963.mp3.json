{
  "file_id": "rec_audio_call_426565068_audio_1788982358963.mp3",
  "language": "malayalam",
  "chunk_seconds": 5.0,
  "decoding": "ctc",
  "audio_duration_sec": 642.254,
  "processing_time_sec": 14.873664140701294,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:05",
      "text": "ഹലോ ഹലോ"
    },
    {
      "t": "00:10",
      "text": "ആ പേരെന്തായിരുന്നു പറയത്തില്ല"
    },
    {
      "t": "00:15",
      "text": "അ പറയരുന്ന് അവര് പറഞ്ഞു"
    },
    {
      "t": "00:20",
      "text": "ആര് പറഞ്ഞു പ്പിലുള്ള ചേച്ചി"
    },
    {
      "t": "00:25",
      "text": "വേറെ തെങ്കും മറച്ചല്ലോ"
    },
    {
      "t": "00:30",
      "text": "നമ്മള് നാട് വീട് കാര്യങ്ങള് പേഴസണൽ കാര്യങ്ങ ഒന്നും പറയരുതെന്ന് പറ"
    },
    {
      "t": "00:35",
      "text": "ബാക്കി ചീത്തിയൊക്കെ പറയാൻ നോക്കു"
    },
    {
      "t": "00:40",
      "text": "താങ്കൾക്ക് താങ്ക എന്തിനാ വന്നേ"
    },
    {
      "t": "00:45",
      "text": "ഞാൻ വെറുതെ സംസാരിച്ചിരിക്കാലോ"
    },
    {
      "t": "00:50",
      "text": "താങ്കെ"
    },
    {
      "t": "00:55",
      "text": "പേര്നിയാസ്"
    },
    {
      "t": "01:00",
      "text": "ആ ചേച്ചി ഒന്നും പറഞ്ഞില്ല ഇയാളടുത്ത് ആ ചേച്ചി പറഞ്ഞില്ല"
    },
    {
      "t": "01:05",
      "text": "എന്താ പറ ഇയാളപ്പം പറഞ്ഞ തന്നെ"
    },
    {
      "t": "01:10",
      "text": "ആണ അത്ട്ടെയണ എന്താ അതനുസരിക്ക"
    },
    {
      "t": "01:15",
      "text": "ത"
    },
    {
      "t": "01:20",
      "text": "അതിലൊക്കെ ഇപ്പ എന്താ ഇയാളപ്പൊ കൂള ചെയതപ്പോ നമ്മൾ ചോദിക്കരു ആരാണ്"
    },
    {
      "t": "01:25",
      "text": "എപ്പ പേര് പറയണോ"
    },
    {
      "t": "01:30",
      "text": "പോ അങ്ങ ഉ ഉ ഉ നാസിം"
    },
    {
      "t": "01:35",
      "text": "ന്താ യാളുടെ പേരെന്താ നാസിംന്നന്നെ പറഞ്ഞ"
    },
    {
      "t": "01:40",
      "text": "പന്നിയ"
    },
    {
      "t": "01:45",
      "text": "പെട്ട നീയ"
    },
    {
      "t": "01:50",
      "text": "സക്ക നിയസത്"
    },
    {
      "t": "01:55",
      "text": "പേന്താ എന്റെ പേരാ"
    },
    {
      "t": "02:00",
      "text": "ന്തോന്ത"
    },
    {
      "t": "02:05",
      "text": "ആ ോണിമ്മന്തോണിയ"
    },
    {
      "t": "02:10",
      "text": "ആ ഞങ്ങ കഷ"
    },
    {
      "t": "02:15",
      "text": "അത് മനസിലായി"
    },
    {
      "t": "02:20",
      "text": "കുളച്ചൽ ക കുളച്ചൽ"
    },
    {
      "t": "02:25",
      "text": "അതടാ"
    },
    {
      "t": "02:30",
      "text": "തമിഴ്നാട് ബോർഡറും എക്ക്"
    },
    {
      "t": "02:35",
      "text": "എനക്ക് ശ്രീലങ്ക തെറിയും തമിഴ് തെറിയും മലയാളം തറയും"
    },
    {
      "t": "02:40",
      "text": "വലിയ പുള്ളിയപ്പൂ"
    },
    {
      "t": "02:45",
      "text": "നിനക്ക് എത്ര ഭാഷ അറിയാം"
    },
    {
      "t": "02:50",
      "text": "ആ എനിക്ക് സയൻസ് അറിയാം സോഷ്യൽ സ്റ്റഡീസ് അറിയാം"
    },
    {
      "t": "02:55",
      "text": "എന്ത് അറിയാം"
    },
    {
      "t": "03:00",
      "text": "എന്നല്ലാറി"
    },
    {
      "t": "03:05",
      "text": "നീ ഉറങ്ങാതെ എന്ത് ചെയ്യാൻ പോന്ന്"
    },
    {
      "t": "03:10",
      "text": "പറഞ്ഞാണ്"
    },
    {
      "t": "03:15",
      "text": "എന്നാ ഞാൻ പോട്ടെ"
    },
    {
      "t": "03:20",
      "text": "ഉ പോവത"
    },
    {
      "t": "03:25",
      "text": "അതന്ത പോണന്ന്"
    },
    {
      "t": "03:30",
      "text": "നാളെ അന്നം പേടിക്കാൻ പോണെങ്കിൽ ജോലിക്ക് പോയല അന്നം"
    },
    {
      "t": "03:35",
      "text": "കിെ"
    },
    {
      "t": "03:40",
      "text": "അ"
    },
    {
      "t": "03:45",
      "text": "പ്രൊ ഒന്ന ക പ്ര"
    },
    {
      "t": "03:50",
      "text": "ചെയ്യുന്ന ആ പാസ് ഇരുന്ന് വിഷമിക്കും അവരെന്ത് ചെയ്യും നിയർാ"
    },
    {
      "t": "03:55",
      "text": "അ"
    },
    {
      "t": "04:00",
      "text": "ൻസി ഉണ്ടാവും ഡെഫിഷ്യൻസി ഉണ്ടായാ എന്തുണ്ടാവും അസുഖം ഉണ്ടാവും"
    },
    {
      "t": "04:05",
      "text": "ഇതന്താ സയൻസിന്റെ ക്ലാസ്"
    },
    {
      "t": "04:10",
      "text": "ഇപ്പൊ എങ്ങനെ ഇരിക്കുന്നു എന്താ ഞാൻ സെക്സ് ക്ലാസ് എടുത്തില്ല"
    },
    {
      "t": "04:15",
      "text": "എനിക്കിഷ്ടണ"
    },
    {
      "t": "04:20",
      "text": "നിനക്ക് എന്ത് ടൈപ്പ് സെക്സ് ഇഷ്ടം"
    },
    {
      "t": "04:25",
      "text": "ഏതൊക്കെ ടൈപ്പ് പറയും"
    },
    {
      "t": "04:30",
      "text": "കുട്ടി പറയും സിങ്കിള് പറയും"
    },
    {
      "t": "04:35",
      "text": "വൺ ബൈ വൺ വരയും"
    },
    {
      "t": "04:40",
      "text": "ഹലോ ആ പറയൂ"
    },
    {
      "t": "04:45",
      "text": "സിംഗിൾ പറയും ഡബിള് പറയും ത്രിബിള് പറയും വൺ ബൈ"
    },
    {
      "t": "04:50",
      "text": "രണ്ടു പേരള്ളട്ട അപ്പ അ"
    },
    {
      "t": "04:55",
      "text": "ഗേ ആൻഡ് മെൻ പറയും ട്രാൻസ്ജെൻഡേഴ്സ് പറയും"
    },
    {
      "t": "05:00",
      "text": "പി എൻ പറയായും വേട്ടി പറയും"
    },
    {
      "t": "05:05",
      "text": "ഉ"
    },
    {
      "t": "05:10",
      "text": "ഇപ്പൊ നമ്മള് കണ്ടപേരല്ലേ അതിനനുസരിച്ച് പറഞ്ഞൻ"
    },
    {
      "t": "05:15",
      "text": "ഓ പറഞ്ഞു എനിക്ക്"
    },
    {
      "t": "05:20",
      "text": "ിറ്റ്"
    },
    {
      "t": "05:25",
      "text": "എനിക്ക"
    },
    {
      "t": "05:30",
      "text": "ന്ത"
    },
    {
      "t": "05:35",
      "text": "ഒന്നും വേണ്ടേ"
    },
    {
      "t": "05:40",
      "text": "എനിക്കൊന്നും വേണ്ട ഞാൻ ചോദിച്ചത"
    },
    {
      "t": "05:45",
      "text": ""
    },
    {
      "t": "05:50",
      "text": "എത്ര വയസായി അമ്പത്തിട്ട്"
    },
    {
      "t": "05:55",
      "text": "് അൻപത്തെട്ടോ"
    },
    {
      "t": "06:00",
      "text": "ആ എന്ത്"
    },
    {
      "t": "06:05",
      "text": "ഉറച്ചതിയായി പോയിന്നന്നെ"
    },
    {
      "t": "06:10",
      "text": "അത ഈശ്വരൻ കനിഞ്ഞ് ഓരോ ദിവസവും കൂടുന്ന"
    },
    {
      "t": "06:15",
      "text": "എന്റെ വോയിസ് എങ്ങനെ ചെറുതായി ചെറുതായി"
    },
    {
      "t": "06:20",
      "text": "നസ്"
    },
    {
      "t": "06:25",
      "text": "ഞള് നാട്ടില എവിടെയാിക്ക"
    },
    {
      "t": "06:30",
      "text": "കോഴിക്കോുള്ളതൊക്കെ പറ"
    },
    {
      "t": "06:35",
      "text": "ആന്നെിക്ക ഓ കട്ട"
    },
    {
      "t": "06:40",
      "text": "ആ ഞാ കേ"
    },
    {
      "t": "06:45",
      "text": ""
    },
    {
      "t": "06:50",
      "text": "ക് അ അവശസഖ"
    },
    {
      "t": "06:55",
      "text": "ഈ ട്വന്റി സിക്ുള്ള ആൾക്കാർ ഇത്രയും ശാന്തമായിട്ട് സംസാരിക്ക"
    },
    {
      "t": "07:00",
      "text": "അല്ല അവരെങ്കിലും സംസാരിക്കുവന്ന് നക്കൂ ഇത്ര"
    },
    {
      "t": "07:05",
      "text": ""
    },
    {
      "t": "07:10",
      "text": "ത നിക്കത"
    },
    {
      "t": "07:15",
      "text": "നക്കാനൊക്കെ നിക്കുന്നു"
    },
    {
      "t": "07:20",
      "text": "നന്നായിട്ട് ക്ലാസ് എടുത്ത്രെപ്പഴേക്കെ നിക്കൂ"
    },
    {
      "t": "07:25",
      "text": "ന ഉം"
    },
    {
      "t": "07:30",
      "text": "എന്താ ഞാാനപ്പ പുറത്താ"
    },
    {
      "t": "07:35",
      "text": "വേറെറ്റോബ"
    },
    {
      "t": "07:40",
      "text": "പുറത്താണല്ലേ  അല്ല പാരത്രിക"
    },
    {
      "t": "07:45",
      "text": "സംസാരിക്ക"
    },
    {
      "t": "07:50",
      "text": "അവിടൊ ചോപ്പോ"
    },
    {
      "t": "07:55",
      "text": "വർ ഹൗസില ഫുഡിന്റെ"
    },
    {
      "t": "08:00",
      "text": "വ ഹ"
    },
    {
      "t": "08:05",
      "text": "ഫുഡ്ച്ചാക്കി"
    },
    {
      "t": "08:10",
      "text": "പരിപാടിക്ക മഷീന്റെ"
    },
    {
      "t": "08:15",
      "text": "അപ്പൊ അവിടെ നിന്ന് ഷെഫിന് പഠിക്കണം"
    },
    {
      "t": "08:20",
      "text": "നീ അതന്നല്ല"
    },
    {
      "t": "08:25",
      "text": "എന്നാലൊരു മാസം തേർട്ടി ഫൈവ് കിട്ടുമ"
    },
    {
      "t": "08:30",
      "text": "ഫുഡ് കഴിഞ്ഞിട്ട് നാട്ടിൽ എന്താ വച്ചുടക്കാൻ പറ്റോ"
    },
    {
      "t": "08:35",
      "text": "നാട്ടിലേക്ക്ട്ട വണ്ടിയൊക്കെ"
    },
    {
      "t": "08:40",
      "text": "നയ്യോ ഈ ട്വൻ കിട്ടുന്നണ"
    },
    {
      "t": "08:45",
      "text": "സ്ടക്ക"
    },
    {
      "t": "08:50",
      "text": "പോട്ട് കഴിച്ചി ഇത്രല്ല ഉള്ള"
    },
    {
      "t": "08:55",
      "text": "ഇ കൊച്ച ചരിത്ര ഉണ്ട്പോ നിങ്ങളടെ"
    },
    {
      "t": "09:00",
      "text": "ഓക്കെ ഞാന ഇന്ന് ലേറ്റ് ആയി പോയി ഫുഡ് ഒഴിക്കാന"
    },
    {
      "t": "09:05",
      "text": "അപ്പോഴത്തേക്ക് കഴിച്ച കഴിഞ്ഞപ്പോഴത്തേക്ക് ഉറങ്ങാൻ പറ്റില്ല"
    },
    {
      "t": "09:10",
      "text": ""
    },
    {
      "t": "09:15",
      "text": "വിളിക്കുവാണെങ്കിൽ ആരവിടെരിക്ക"
    },
    {
      "t": "09:20",
      "text": "അങ്ങനെയാ വിളിക്കാൻ വേണ്ടി വന്ന"
    },
    {
      "t": "09:25",
      "text": "കലണം എന്റെ ഫോണില് ചാർജും ഇല്ല ഒട്ടും കഴിയ"
    },
    {
      "t": "09:30",
      "text": "ഉ ഉ"
    },
    {
      "t": "09:35",
      "text": "ബൻഡ ഞൻടള"
    },
    {
      "t": "09:40",
      "text": "ഉ"
    },
    {
      "t": "09:45",
      "text": "റ്റ ആ അത"
    },
    {
      "t": "09:50",
      "text": "ഞാൻ ചേച്ചി ലടാ"
    },
    {
      "t": "09:55",
      "text": ""
    },
    {
      "t": "10:00",
      "text": ""
    },
    {
      "t": "10:05",
      "text": ""
    },
    {
      "t": "10:10",
      "text": "അപ്പറക്കരിാ"
    },
    {
      "t": "10:15",
      "text": "എനോറക്കം വര"
    },
    {
      "t": "10:20",
      "text": "രുന്നു മുമ്പേ ബയോളജി ക്ലാസ് ഒക്കെ എടുത്തടെ"
    },
    {
      "t": "10:25",
      "text": "എന്ത"
    },
    {
      "t": "10:30",
      "text": "എന്തോ എനിക്ക്ര്ക്കാം വന്നെ ശരിയ ബായ"
    },
    {
      "t": "10:35",
      "text": "ട്ടക്ക"
    },
    {
      "t": "10:40",
      "text": "വി"
