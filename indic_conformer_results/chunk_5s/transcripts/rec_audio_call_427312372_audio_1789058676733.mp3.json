    {
      "t": "00:05",
      "text": "சொ என்ன சொல்ல என்ன பண்றீங்க"
    },
    {
      "t": "00:10",
      "text": "பேச"
    },
    {
      "t": "00:15",
      "text": "ஆஹம்"
    },
    {
      "t": "00:20",
      "text": "அப்புறம் சாப்பிட்டாச்சே"
    },
    {
      "t": "00:25",
      "text": "சாப்பாச்சா பண்ணலாம் எப்படி இருக்காரு"
    },
    {
      "t": "00:30",
      "text": "நல்லத்தார"
    },
    {
      "t": "00:35",
      "text": "பண்ணக்கு தெரியுமா போன் யூஸ் பண்றதுெல்லாம்"
    },
    {
      "t": "00:40",
      "text": "கத பேசட்டுக்க"
    },
    {
      "t": "00:45",
      "text": "உம் ஹலோ"
    },
    {
      "t": "00:50",
      "text": "அதுவும் சொல்ல மாட்டாரா"
    },
    {
      "t": "00:55",
      "text": "ஏ பல்ல அவரு"
    },
    {
      "t": "01:00",
      "text": "விச்சார த"
    },
    {
      "t": "01:05",
      "text": "சக்கா"
    },
    {
      "t": "01:10",
      "text": "அப்ப"
    },
    {
      "t": "01:15",
      "text": "ஹலோ"
    },
    {
      "t": "01:20",
      "text": "ஆ கே்கதா  சொல்லுங்க"
    },
    {
      "t": "01:25",
      "text": "ம்"
    },
    {
      "t": "01:30",
      "text": "ழ"
    },
    {
      "t": "01:35",
      "text": ""
    },
    {
      "t": "01:40",
      "text": "அப்பறாங்க"
    },
    {
      "t": "01:45",
      "text": "அப்புறம் எங்கச்சு"
    },
    {
      "t": "01:50",
      "text": ""
    },
    {
      "t": "01:55",
      "text": "அம சரி பண்ணலாமா"
    },
    {
      "t": "02:00",
      "text": "சொல்லாமா சொல்லந்தர மாட்டார்ல"
    },
    {
      "t": "02:05",
      "text": "என்ன"
    },
    {
      "t": "02:10",
      "text": "கேக்குதா"
    },
    {
      "t": "02:15",
      "text": "அ"
    },
    {
      "t": "02:20",
      "text": "எப்படி பண்ணா பிடிக்கும்"
    },
    {
      "t": "02:25",
      "text": ""
    },
    {
      "t": "02:30",
      "text": "ஹலோ எப்படி பண்ணும்"
    },
    {
      "t": "02:35",
      "text": "ஏத மெய"
    },
    {
      "t": "02:40",
      "text": "முாடி பண்றான் பிடிக்கும் முாடி"
    },
    {
      "t": "02:45",
      "text": "னாடி முனாடி தான் பண்ண"
    },
    {
      "t": "02:50",
      "text": "பின்னாடி பண்ணலாம் ப ஆனா நல்லா பின்னாடி நல்லா உங்க தண்மைய ஆடுச்சு"
    },
    {
      "t": "02:55",
      "text": "அ நல்லா நச்சுட்டுண்டே நச்சி நச்சி நல்லா உள்ள விட்ட் அடிப்பாங்க"
    },
    {
      "t": "03:00",
      "text": "பின்னாடி ஓடுறதோட பின்னாடி ஓடுறத நல்லா போவா"
    },
    {
      "t": "03:05",
      "text": "அப்படி இல்லையா"
    },
    {
      "t": "03:10",
      "text": "ா இருக்கும்க்கு"
    },
    {
      "t": "03:15",
      "text": "நீங்க சொல்றீங்க நான் நிறைய ட்ரை பண்ணியிருக்கேன் அப்படிதானே பண்ணிருக்கேன்"
    },
    {
      "t": "03:20",
      "text": "ந தற ஒரு"
    },
    {
      "t": "03:25",
      "text": "ட்டு வருமும் இல்ல இல்ல"
    },
    {
      "t": "03:30",
      "text": "எட்டு வருஷமா பின்னாடி பண்ணத இல்லையா வரு"
    },
    {
      "t": "03:35",
      "text": "எட்டு விஷமாவே பண்ணது இல்லையாறப்ப நீங்க குழந்தைங்கும்"
    },
    {
      "t": "03:40",
      "text": "அது கல்யாணம் புடிச்சல"
    },
    {
      "t": "03:45",
      "text": "அதுக்கப்புறம் பண்ணவே இல்லையா ஏாங்க"
    },
    {
      "t": "03:50",
      "text": "என்னா சொல்றீங்க புடிக்கல"
    },
    {
      "t": "03:55",
      "text": "ஓது வாங்கறது பி"
    },
    {
      "t": "04:00",
      "text": "அடி வாங்கறது பிடிக்கல ய வா"
    },
    {
      "t": "04:05",
      "text": "முடிக்க வ்க குடுக்கலனு"
    },
    {
      "t": "04:10",
      "text": "அவரை புிடிக்கலையா என்ன மாதிரி ஆள் வந்த"
    },
    {
      "t": "04:15",
      "text": "உ"
    },
    {
      "t": "04:20",
      "text": "ரிய சரிய"
    },
    {
      "t": "04:25",
      "text": "சரி"
    },
    {
      "t": "04:30",
      "text": "என்ன சொல்லுங்க"
    },
    {
      "t": "04:35",
      "text": ""
    },
    {
      "t": "04:40",
      "text": "ஹலோ"
    },
    {
      "t": "04:45",
      "text": "ஆஹ் பேசுங்க"
    },
    {
      "t": "04:50",
      "text": "நா"
    },
    {
      "t": "04:55",
      "text": "பண்ணட்டாரா சரி கே"
    },
    {
      "t": "05:00",
      "text": "ச பாருங்க"
    },
    {
      "t": "05:05",
      "text": "ஹலோ ஸபெண்ட் உண்டாரா"
    },
    {
      "t": "05:10",
      "text": "சரி வட்ட"
    },
    {
      "t": "05:15",
      "text": "ந"
    }
  ],
