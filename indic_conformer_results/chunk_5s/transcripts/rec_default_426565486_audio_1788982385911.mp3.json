  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ വ സ്ല"
    },
    {
      "t": "00:05",
      "text": "എന്ത് ചെയ്യുന്നു"
    },
    {
      "t": "00:10",
      "text": "ആയുവേദനർക്ക"
    },
    {
      "t": "00:15",
      "text": "ആയുർവേദനസായിട്ട്ർക്ക"
    },
    {
      "t": "00:20",
      "text": "അ വേണ്ട വരിട"
    },
    {
      "t": "00:25",
      "text": "ലല്ലവണ്ടോ"
    },
    {
      "t": "00:30",
      "text": "അല്ല വന്നില്ലേ"
    },
    {
      "t": "00:35",
      "text": "ഉണ്ടായി കേട്ടില്ല"
    },
    {
      "t": "00:40",
      "text": "ഉണ്ടായിരുന്നു പറയാട്ട"
    },
    {
      "t": "00:45",
      "text": "കളിച്ചിനാ കളിച്ചിട്ടുണ്ടോ ചിച്ചോ"
    },
    {
      "t": "00:50",
      "text": "ഉ"
    },
    {
      "t": "00:55",
      "text": "എവിടെല്ല"
    },
    {
      "t": "01:00",
      "text": "ാല് ബ്രേക്കപ്പ ഇപ്പ തന്നെ പോന്നും സീരിയസ അല്ല കളിച്ച കഴിഞ്ഞാൽ പോയി"
    },
    {
      "t": "01:05",
      "text": "ഓ അങ്ങനന്ന എത്ര വശം കളിച്ചിട്ടുണ്ട്"
    },
    {
      "t": "01:10",
      "text": "എത്ര പ്രാവശ്യം കളിച്ചിട്ടുണ്ടാവും"
    },
    {
      "t": "01:15",
      "text": "ര എവിടെക്കായിുന്നാ"
    },
    {
      "t": "01:20",
      "text": "ഇരന്തരം ഇ"
    },
    {
      "t": "01:25",
      "text": "എന്ത ഒന്നാൽ കാണാൻ പറ്റോ എന്"
    },
    {
      "t": "01:30",
      "text": "നിക്കും കളിക്കയ്യടാ"
    },
    {
      "t": "01:35",
      "text": "ക്കഥ മ മക്കി പോ"
    },
    {
      "t": "01:40",
      "text": "ല്ല നക്കും്പോല്ലേ സുഖം നക്കീ കാത്തന്ത"
    },
    {
      "t": "01:45",
      "text": "ആാ മറ്റി തട്ടെ"
    },
    {
      "t": "01:50",
      "text": "നീ എന്താ"
    },
    {
      "t": "01:55",
      "text": "ചറ്റുമ്പോ വേദന ഉണ്ടോ ഇല്ല"
    },
    {
      "t": "02:00",
      "text": "ഏ എന്ത ഫൈസ് ആഏ"
    },
    {
      "t": "02:05",
      "text": "സുഖണ്ടോഖ"
    },
    {
      "t": "02:10",
      "text": "ഇല്ല ഒന്നുമല്ല"
    },
    {
      "t": "02:15",
      "text": "മനസിലായില്ലോ ഒന്നല്ലായിുന്നോ"
    },
    {
      "t": "02:20",
      "text": "എന്ത ഫേസി കളിക്കാത്ത"
    },
    {
      "t": "02:25",
      "text": "കാണിക്കാ"
    },
    {
      "t": "02:30",
      "text": "മല കണ്ടല്ലോല ക"
    },
    {
      "t": "02:35",
      "text": "എ എന്ന്ത്ന്ന"
    },
    {
      "t": "02:40",
      "text": "അതെ കാണിച്ച പി"
    },
    {
      "t": "02:45",
      "text": "ല്ല കാണ്ടിക്കോ"
    },
    {
      "t": "02:50",
      "text": "അപടില്ല"
    },
    {
      "t": "02:55",
      "text": "മടായി"
    },
    {
      "t": "03:00",
      "text": "ഒ അല്ല"
    },
    {
      "t": "03:05",
      "text": "വീട്ടില എന്റെ വീട്ടിലാണോ"
    },
    {
      "t": "03:10",
      "text": "വിടെ കൊ കോഴിക്കോടൊക്കെ വരാറുണ്ടോ"
    },
    {
      "t": "03:15",
      "text": "ഇല്ല"
    },
    {
      "t": "03:20",
      "text": "ഇനിപ്പോളാ തിരുവനന്തപുരംക്ഷ"
    },
    {
      "t": "03:25",
      "text": "മത കാണിക്കത"
    },
    {
      "t": "03:30",
      "text": "എന്ത്"
    },
    {
      "t": "03:35",
      "text": "മൂടായി"
    },
    {
      "t": "03:40",
      "text": "ടായി കാണിക്ക"
    },
    {
      "t": "03:45",
      "text": "അക്കി തറ്റ"
    },
    {
      "t": "03:50",
      "text": "അമ്മോത കാണിക്കുന്നു"
    },
    {
      "t": "03:55",
      "text": "ഞാൻ നോക്കട്ടെ കാണിക്ക"
    },
    {
      "t": "04:00",
      "text": "പോലെ കാണിച്ചിട"
    },
    {
      "t": "04:05",
      "text": "ഉം"
    },
    {
      "t": "04:10",
      "text": "ആളിക്ക ആളിക്കട"
    },
    {
      "t": "04:15",
      "text": "എന്ത് കാണ"
    },
    {
      "t": "04:20",
      "text": "അത് പി കാണിക്കണ"
    },
    {
      "t": "04:25",
      "text": "ആിന്നന്നെ കാണിക്കണ്ട"
    },
    {
      "t": "04:30",
      "text": "ഹ"
    },
    {
      "t": "04:35",
      "text": "എന്നെ കാണാൻ പറ്റുന്നല്ലല്ലോ"
    },
    {
      "t": "04:40",
      "text": "ഇല്ലല്ലോ"
    },
    {
      "t": "04:45",
      "text": "അൊ കാണാം"
    },
    {
      "t": "04:50",
      "text": "ക്ക കണ്ടോ"
    },
    {
      "t": "04:55",
      "text": "ഇടുക്കി എഞ്ഞ"
    },
    {
      "t": "05:00",
      "text": "മീൻ ജസ്റ്റ് കാണിക്കുന്നു"
    },
    {
      "t": "05:05",
      "text": "പ്പിക്കാന ആ"
    },
    {
      "t": "05:10",
      "text": "കാണിച്ചോടും"
    },
    {
      "t": "05:15",
      "text": "കാണിക്കു"
    },
    {
      "t": "05:20",
      "text": "ആാനിക്കടി"
    },
    {
      "t": "05:25",
      "text": "കാണൊന്നില്ല ആയി കാണിക്ക നോക്കട്ടെ"
    },
    {
      "t": "05:30",
      "text": "കാണ ആയി നോക്ക് കാണിക്കൂ"
    },
    {
      "t": "05:35",
      "text": "മട കണിക്കോയി"
    },
    {
      "t": "05:40",
      "text": "കാണിക്കപ്പ"
    },
    {
      "t": "05:45",
      "text": ""
    },
    {
      "t": "05:50",
      "text": "കാണിക്കൂ"
    },
    {
      "t": "05:55",
      "text": "ഞാൻ കട്ട"
    },
    {
      "t": "06:00",
      "text": "ല കട്ട ചെയ്യുന്ന ഓക്കെ"
    },
    {
      "t": "06:05",
      "text": "കാണിപ്പൊ കാണിക്കില്ലേ"
    },
    {
      "t": "06:10",
      "text": "ൂ നക്കി തരാം നല്ല"
    },
    {
      "t": "06:15",
      "text": "ട നക്കി തരും വരോ"
    },
    {
      "t": "06:20",
      "text": "ആരല്ലേ അല്ല"
    },
    {
      "t": "06:25",
      "text": "ന നട്ടി തിരുപ്പൂർ വരോ"
    },
    {
      "t": "06:30",
      "text": "എടെ കാസർഗോഡ"
    },
    {
      "t": "06:35",
      "text": "എന്റെ പൂർ നക്കി തരും നല്ലതാണ്"
    },
    {
      "t": "06:40",
      "text": "അക്കനിഷ്ട"
    },
    {
      "t": "06:45",
      "text": "കേറ്റുന്ന മാത്ര ഇഷ്ടോ കേറ്റുന്ന മാത്രയാ"
    },
    {
      "t": "06:50",
      "text": "നല്ല രസംുണ്ടോ കേറ്റുമ്പോ"
    },
    {
      "t": "06:55",
      "text": "ചഏറ്റവും രസംുണ്ടോ"
    },
    {
      "t": "07:00",
      "text": "ഡേറ്റ് ആണോ അ ഡേറ്റ് ആണോ"
    },
    {
      "t": "07:05",
      "text": "സാധനം തേറ്റാണോ"
    },
    {
      "t": "07:10",
      "text": "കേട്ടട്ടോ"
    },
    {
      "t": "07:15",
      "text": "ക്കിന ഒരു കട്ടളിക്കണം"
    },
    {
      "t": "07:20",
      "text": ""
    }
  ],
  "full_text": "ഹലോ വ സ്ല എന്ത് ചെയ്യുന്നു ആയുവേദനർക്ക ആയുർവേദനസായിട്ട്ർക്ക അ വേണ്ട വരിട ലല്ലവണ്ടോ അല്ല വന്നില്ലേ ഉണ്ടായി കേട്ടില്ല ഉണ്ടായിരുന്നു പറയാട്ട കളിച്ചിനാ കളിച്ചിട്ടുണ്ടോ ചിച്ചോ ഉ എവിടെല്ല ാല് ബ്രേക്കപ്പ ഇപ്പ തന്നെ പോന്നും സീരിയസ അല്ല കളിച്ച കഴിഞ്ഞാൽ പോയി ഓ അങ്ങനന്ന എത്ര വശം കളിച്ചിട്ടുണ്ട് എത്ര പ്രാവശ്യം കളിച്ചിട്ടുണ്ടാവും ര എവിടെക്കായിുന്നാ ഇരന്തരം ഇ എന്ത ഒന്നാൽ കാണാൻ പറ്റോ എന് നിക്കും കളിക്കയ്യടാ ക്കഥ മ മക്കി പോ ല്ല നക്കും്പോല്ലേ സുഖം നക്കീ കാത്തന്ത ആാ മറ്റി തട്ടെ നീ എന്താ ചറ്റുമ്പോ വേദന ഉണ്ടോ ഇല്ല ഏ എന്ത ഫൈസ് ആഏ സുഖണ്ടോഖ ഇല്ല ഒന്നുമല്ല മനസിലായില്ലോ ഒന്നല്ലായിുന്നോ എന്ത ഫേസി കളിക്കാത്ത കാണിക്കാ മല കണ്ടല്ലോല ക എ എന്ന്ത്ന്ന അതെ കാണിച്ച പി ല്ല കാണ്ടിക്കോ അപടില്ല മടായി ഒ അല്ല വീട്ടില എന്റെ വീട്ടിലാണോ വിടെ കൊ കോഴിക്കോടൊക്കെ വരാറുണ്ടോ ഇല്ല ഇനിപ്പോളാ തിരുവനന്തപുരംക്ഷ മത കാണിക്കത എന്ത് മൂടായി ടായി കാണിക്ക അക്കി തറ്റ അമ്മോത കാണിക്കുന്നു ഞാൻ നോക്കട്ടെ കാണിക്ക പോലെ കാണിച്ചിട ഉം ആളിക്ക ആളിക്കട എന്ത് കാണ അത് പി കാണിക്കണ ആിന്നന്നെ കാണിക്കണ്ട ഹ എന്നെ കാണാൻ പറ്റുന്നല്ലല്ലോ ഇല്ലല്ലോ അൊ കാണാം ക്ക കണ്ടോ ഇടുക്കി എഞ്ഞ മീൻ ജസ്റ്റ് കാണിക്കുന്നു പ്പിക്കാന ആ കാണിച്ചോടും കാണിക്കു ആാനിക്കടി കാണൊന്നില്ല ആയി കാണിക്ക നോക്കട്ടെ കാണ ആയി നോക്ക് കാണിക്കൂ മട കണിക്കോയി കാണിക്കപ്പ  കാണിക്കൂ ഞാൻ കട്ട ല കട്ട ചെയ്യുന്ന ഓക്കെ കാണിപ്പൊ കാണിക്കില്ലേ ൂ നക്കി തരാം നല്ല ട നക്കി തരും വരോ ആരല്ലേ അല്ല ന നട്ടി തിരുപ്പൂർ വരോ എടെ കാസർഗോഡ എന്റെ പൂർ നക്കി തരും നല്ലതാണ് അക്കനിഷ്ട കേറ്റുന്ന മാത്ര ഇഷ്ടോ കേറ്റുന്ന മാത്രയാ നല്ല രസംുണ്ടോ കേറ്റുമ്പോ ചഏറ്റവും രസംുണ്ടോ ഡേറ്റ് ആണോ അ ഡേറ്റ് ആണോ സാധനം തേറ്റാണോ കേട്ടട്ടോ ക്കിന ഒരു കട്ടളിക്കണം ",
