{
  "file_id": "rec_audio_call_426656676_audio_1788993082694.mp3",
  "language": "malayalam",
  "chunk_seconds": 5.0,
  "decoding": "ctc",
  "audio_duration_sec": 467.4690625,
  "processing_time_sec": 9.814125061035156,
  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:05",
      "text": "ഹലോ ഹ ആ കേക്കുന്നുണ്ടോ"
    },
    {
      "t": "00:10",
      "text": "ആഹ കേക്കുന്നുണ്ട് ഞൻല"
    },
    {
      "t": "00:15",
      "text": "ഞ"
    },
    {
      "t": "00:20",
      "text": "ഴ"
    },
    {
      "t": "00:25",
      "text": "ആ പ്ലസ് ടു കഴിഞ്ഞു അപ്പ എങ്ങനെ നക്കുന്നു"
    },
    {
      "t": "00:30",
      "text": "ഹാ നിിക്കത്ത നി"
    },
    {
      "t": "00:35",
      "text": "എവിടെ ഇപ്പൊ വീട്ടിലാണോ"
    },
    {
      "t": "00:40",
      "text": "അത"
    },
    {
      "t": "00:45",
      "text": "ഇങ്ങനെയൊക്കെ ചിരിച്ചാ വീട്ടി വത്തില്ലേ"
    },
    {
      "t": "00:50",
      "text": "അമ്മ ഇപ്പോൊ എന്നെ ഒന്ന് വഴക്ക് പറഞ്ഞു കഴഞ്ഞു"
    },
    {
      "t": "00:55",
      "text": "അതപളി ഇനിപ്പ അമ്മരന്ന് എന്നെച്ചീട്ട എത്തിിക്കൂലേ"
    },
    {
      "t": "01:00",
      "text": "ഉ പിന്നെ കുറച്ച് ഓൺലൈൻ ഒക്കെ ഉണ്ടായിുന്നന"
    },
    {
      "t": "01:05",
      "text": "ഓൺലൈൻ ക്ലാ ഒക്കെ ഉണ്ടായിരുന്ന കൊണ്ട് അതൊക്കെ ചെയ്ത് ഇങ്ങനെ"
    },
    {
      "t": "01:10",
      "text": ""
    },
    {
      "t": "01:15",
      "text": "ഓൺലൈൻ ക്ലാല്ല ഓൺലൈ വർക്ക്"
    },
    {
      "t": "01:20",
      "text": "ആ അായി ഇറങ്ങുവാന്"
    },
    {
      "t": "01:25",
      "text": "നീ ഇപ്പത്തെരാ"
    },
    {
      "t": "01:30",
      "text": "റാണോ"
    },
    {
      "t": "01:35",
      "text": "ചിരിട്ടന്നണ്ട്"
    },
    {
      "t": "01:40",
      "text": "താഴ ഇട്ട് പൊട്ടുന്ന പോലുണ്ട്"
    },
    {
      "t": "01:45",
      "text": "ഹലോ ആ"
    },
    {
      "t": "01:50",
      "text": "ഇല്ല"
    },
    {
      "t": "01:55",
      "text": "എന്നെ ഇവിടെ കിടക്കാണ്"
    },
    {
      "t": "02:00",
      "text": "എന്താ പേര്"
    },
    {
      "t": "02:05",
      "text": "നിങ്ങ എന്ത് ചെയ്യുന്ന"
    },
    {
      "t": "02:10",
      "text": "ഞൻവിടെ അതേ കിടക്കുന്നു"
    },
    {
      "t": "02:15",
      "text": "എത്ര വയസല്"
    },
    {
      "t": "02:20",
      "text": "ടെ"
    },
    {
      "t": "02:25",
      "text": "വിടെ"
    },
    {
      "t": "02:30",
      "text": "എന്റെ പ്ലേസ് എറണാകുളത്താണ് ഞാാന ഇപ്പോ ഉള്ളത് പോയിട്ടത്"
    },
    {
      "t": "02:35",
      "text": "ആ എന്താ കോഴിക്കോട് നിക്കുന്ന"
    },
    {
      "t": "02:40",
      "text": "എനിക്ക് കോഴിക്കോട് വഞ്ഞ"
    },
    {
      "t": "02:45",
      "text": "ആഗ്രഹംുണ്ട്"
    },
    {
      "t": "02:50",
      "text": "അടെ അവരുടെ എങ്ങനെയ നല്ല പ്ലേസ് ഒക്കെ ആണോ"
    },
    {
      "t": "02:55",
      "text": "പിണ്ട് നീാ നമ്മൾ ഇവിടെ ഫുള് അടിച്ചുടു കട്ട കങ്ങി"
    },
    {
      "t": "03:00",
      "text": "രണ്ട് ദസം നിന്നിട്ടാ"
    },
    {
      "t": "03:05",
      "text": "അങ്ങന എന്റെ കൂടെ നിക്കാലോ"
    },
    {
      "t": "03:10",
      "text": "അല്ല അവിടെ എങ്ങനെ ഇപ്പൊ വ എന്താ മറ്റേറ"
    },
    {
      "t": "03:15",
      "text": "ന എനിക്കിപ്പോ ഇവിടെ ഫണ്ട്"
    },
    {
      "t": "03:20",
      "text": "അവര് റെന്റ് കൊടുക്കണ്ട ഞാൻ നല്ല സഹകായി"
    },
    {
      "t": "03:25",
      "text": "അപ്പ ഞാൻ സമയത്ത്ന്നട്ട കഴിച്ച"
    },
    {
      "t": "03:30",
      "text": "എന്ത കണ്ടെങ്കിൽ ചോദീന്ന ഞാനാ"
    },
    {
      "t": "03:35",
      "text": "അങ്ങനെ ചെയ്യുവാണെങ്കി അവിടെ നിിക്കാൻ പറ്റോ"
    },
    {
      "t": "03:40",
      "text": "ന അങ്ങനെ ചെയ്യ"
    },
    {
      "t": "03:45",
      "text": "ശരിക്കും ഞാൻ"
    },
    {
      "t": "03:50",
      "text": "ആ"
    },
    {
      "t": "03:55",
      "text": "സരിയ ആട്ട് പറഞ്ഞ"
    },
    {
      "t": "04:00",
      "text": "വ എന്താല"
    },
    {
      "t": "04:05",
      "text": "വിശ്വച്ച് വരാൻ പറ്റോ ഇനി ലാസ്റ്റ് അവിടം വരെ വന്നിട്ട് അവിടെ ആ ഇല്ലെങ്കിൽ"
    },
    {
      "t": "04:10",
      "text": "ങ്ങോ്"
    },
    {
      "t": "04:15",
      "text": "ആ എനിക്കൊരു കാര്യ"
    },
    {
      "t": "04:20",
      "text": "വ വരണ്ട"
    },
    {
      "t": "04:25",
      "text": "അല്ല പ്ലേസ്ും അറിയാൻ പാടള്ളൊക്കെ ഉണ്ട്"
    },
    {
      "t": "04:30",
      "text": "അങ്ങന"
    },
    {
      "t": "04:35",
      "text": "എന്താട്ടി എന്താ കാര്യം"
    },
    {
      "t": "04:40",
      "text": "അതെ എനക്ക്െന്താ എനിക്ക് അങ്ങോട്ടൊക്കെ വഞ്ഞ"
    },
    {
      "t": "04:45",
      "text": "ൈര്യായിട്ട് പോല ന ഇവി"
    },
    {
      "t": "04:50",
      "text": "നിന്റെ കൊതി മാറുമ്പോ പോയാ മതി ശരിക്കും"
    },
    {
      "t": "04:55",
      "text": "ശരിക്കും അങ്ങോട്ടോ വര്"
    },
    {
      "t": "05:00",
      "text": "കോാക് ചെയ"
    },
    {
      "t": "05:05",
      "text": "ഉ"
    },
    {
      "t": "05:10",
      "text": "ഓക്കെ ഞൻ പറ്റ തരാ"
    },
    {
      "t": "05:15",
      "text": "സെവൻ ത്രത്രീ സീറോ ഉ"
    },
    {
      "t": "05:20",
      "text": "റീറോ"
    },
    {
      "t": "05:25",
      "text": "സെവൻ ഫോർ സെവൻ ഫോവ"
    },
    {
      "t": "05:30",
      "text": "നയൻ ഡബിൾ ു"
    },
    {
      "t": "05:35",
      "text": "ഇത ആന്ധാപ്രദേശത്തെ നമ്പർല്ലേ"
    },
    {
      "t": "05:40",
      "text": "ധപ്രദേശ"
    },
    {
      "t": "05:45",
      "text": "പിന്നെ ഇതിന്റെണ ആ"
    },
    {
      "t": "05:50",
      "text": "ൊ ോ"
    },
    {
      "t": "05:55",
      "text": "ടു കാണിക്കണ്ട് നിനക്കൊ ശാന്തണ്ട"
    },
    {
      "t": "06:00",
      "text": "ഞാന അതിലോട്ട"
    },
    {
      "t": "06:05",
      "text": "ഹ യ വാട്ടസപ്പ ലേ"
    },
    {
      "t": "06:10",
      "text": "നീാന് വിളിക്കണേ"
    },
    {
      "t": "06:15",
      "text": "അ"
    },
    {
      "t": "06:20",
      "text": ""
    },
    {
      "t": "06:25",
      "text": "ഹലോ ഹലോ നാനപ്പോ വിളിച്ചേ"
    },
    {
      "t": "06:30",
      "text": "ആ പിന്ന എന്ന"
    },
    {
      "t": "06:35",
      "text": "അയ അതിനകത്ത് വിളിക്കാനില്ല"
    },
    {
      "t": "06:40",
      "text": "അതിന്റെ ഡീവിങ്സ് എല്ലാം ഇടാനായിട്ടാണ്"
    },
    {
      "t": "06:45",
      "text": "ഓ അപ്ഡേറ്റ്സും പിന്നെ ഞാന"
    },
    {
      "t": "06:50",
      "text": "അടെന്ന് ഇത്ര നാള് വേണേിലും അവിടെ നിത്താൻ പറ്റോ"
    },
    {
      "t": "06:55",
      "text": "എത്ര നാട് വേണെങ്കിലും അവിടെ നിൽക്കാൻ പറ്റുവോ"
    },
    {
      "t": "07:00",
      "text": "നീ ഒറ്റ കാണോ എന്നെ അതും കൂടെുണ്ട"
    },
    {
      "t": "07:05",
      "text": "നീ ഒറ്റക്കണോ ആരെങ്കിലും കൂടെണ്ടോ ഞാൻ ചപ്പോ ഒറ്റക്കായിരിക്കും വ"
    },
    {
      "t": "07:10",
      "text": "ആഹ നീ പോര് നിനക്ക് നിക്കാലോ"
    },
    {
      "t": "07:15",
      "text": "ഓ അപ്പൊ ഫുഡും കാര്യങ്ങള ഒക്കെ"
    },
    {
      "t": "07:20",
      "text": "നിനക്ക് ഫുഡ് ഞാൻ മേടിച്ചരാം വേറെന്താ നിനക്ക് വേണ്ടേ"
    },
    {
      "t": "07:25",
      "text": "ഉ വേറെ"
    },
    {
      "t": "07:30",
      "text": "നേറെ എനിക്ക് മെയക്ക് സെറ്റ്"
    },
    {
      "t": "07:35",
      "text": "ോട നിന്ന കാണട്ടെ"
    },
    {
      "t": "07:40",
      "text": "എൻന്റെ വാട്സആപ്പിൽ മെസേജണ്"
    },
    {
      "t": "07:45",
      "text": ""
    }
