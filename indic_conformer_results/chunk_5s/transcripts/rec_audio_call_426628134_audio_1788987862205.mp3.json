{
  "file_id": "rec_audio_call_426628134_audio_1788987862205.mp3",
  "language": "kannada",
  "chunk_seconds": 5.0,
  "decoding": "ctc",
  "audio_duration_sec": 891.995,
  "processing_time_sec": 19.663963079452515,
  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ ಹಾಯ"
    },
    {
      "t": "00:05",
      "text": "ಚ"
    },
    {
      "t": "00:10",
      "text": "ಹ್ಮ ನಿಮೇಶರು"
    },
    {
      "t": "00:15",
      "text": "ನಿಮಜು"
    },
    {
      "t": "00:20",
      "text": "ಟ್ಟಿ ತ್ರೀ ಏನ್ ಮಾಡ್ತಾಿದ್ದೀರಾ"
    },
    {
      "t": "00:25",
      "text": "ನಾನು ಅಷ್ಟೇ ಮಲ್ಕೊಂಡಿದ್ದೆ"
    },
    {
      "t": "00:30",
      "text": "ಊಟ ಆಯ್ತಾರ ಆಯ್ತು"
    },
    {
      "t": "00:35",
      "text": "ನಿ ಬೆ"
    },
    {
      "t": "00:40",
      "text": "ಇಲ್ಲ ೆ"
    },
    {
      "t": "00:45",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "00:50",
      "text": "ಗ ವಾಯ್ಸ್ ಕೇೇಳಿಸತಿಲ್ಲ"
    },
    {
      "t": "00:55",
      "text": "ಗತ್ತಿಲ್ಲ ಸುನೆನೆ ಬತಿಿಲ್ಲ ಅ್ಮ"
    },
    {
      "t": "01:00",
      "text": "ನಡ ಪ್ಯಾಂಟಕ್ ಮಾತಾಡ್ಬೋದಾ"
    },
    {
      "t": "01:05",
      "text": "ಎ ಸಕಲಿ"
    },
    {
      "t": "01:10",
      "text": "ಣ ಹ"
    },
    {
      "t": "01:15",
      "text": "ಹ ಎಷ್ಟುಿಸೈಜ"
    },
    {
      "t": "01:20",
      "text": "ನಾು ಬರ್ತೀನಿ ಸೀರೆ ಕಟ್ಕೊತೀಯಾ"
    },
    {
      "t": "01:25",
      "text": "ಯಾವಕಲರ್ ಸಿಿರ ಬೇಬಿ"
    },
    {
      "t": "01:30",
      "text": "ಸರ್ಮ ಸೀರ"
    },
    {
      "t": "01:35",
      "text": "ಏನ್ ಸೌಂಡದುೌ"
    },
    {
      "t": "01:40",
      "text": "ಯಾರೋ ಕಿರ್ಿಸತಾವ್ರ ಹಿಂದಿಂದ"
    },
    {
      "t": "01:45",
      "text": "ಸುಮ್ಮತ್ರ್ರಸ್ಪಗೆ್ಮ"
    },
    {
      "t": "01:50",
      "text": "ನನಗೆನ ಬಿಲ್ಲಪ್ಪ"
    },
    {
      "t": "01:55",
      "text": "ಯಾವ ಸೀರೆ ಕಟ್ಕೊತಯ ಸೀರೆ ಹಾಕೋಬೇಕಾ ನೀ್ ಬರ್ಬೇಕ"
    },
    {
      "t": "02:00",
      "text": "ಹ್ಮಷ್ಟ"
    },
    {
      "t": "02:05",
      "text": "ರಿ್ು ಯ"
    },
    {
      "t": "02:10",
      "text": ""
    },
    {
      "t": "02:15",
      "text": "ಹ ಸೂಪರ್ ಬಪಿ ಡೋರ್ ಓಪನ್ ಮಾಡಿ ಬಂದೆ"
    },
    {
      "t": "02:20",
      "text": "ಏ ಸ ಕದ ಕಾಣಿಸ್ತೀಿದೆ ಬಿಬಿ"
    },
    {
      "t": "02:25",
      "text": "ಹಂಗೆ ನೀನ್ ಎತ್ಕೊಂಡೋಗಿ ಬಿಡ್ಮೇಲೆ ಕೂರ್ಸಿ"
    },
    {
      "t": "02:30",
      "text": "ುಮಟ ಲಕ್ತೀನಿ"
    },
    {
      "t": "02:35",
      "text": "್ಮ ಬ್ಮಲ ಸಿಿ"
    },
    {
      "t": "02:40",
      "text": "ನೀನ್ ಒಟ್ಟಿ ಹತ್ರ ಎಲ್ಲ ಕೀಸ್ ಮಾಡ್ತೀನಿ ಹ್ಮ"
    },
    {
      "t": "02:45",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:50",
      "text": "ಹಾಗೆನ್ಸ ಬಿಟ್ಟು"
    },
    {
      "t": "02:55",
      "text": "ನೀನ್ ಮಕ್ಕಳತ್ರಲ್ಲ ಗೇಸ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "03:00",
      "text": "ಓ"
    },
    {
      "t": "03:05",
      "text": "ಸಕ್ಕದ ಕಳಿಸತಿ"
    },
    {
      "t": "03:10",
      "text": "ಏನ್ ಮಾಡದ ಇಷ್ಟ ನಂಗೆ ಹ ಏನ್ ಮಾಡ"
    },
    {
      "t": "03:15",
      "text": "ಇಷ್ಟ ನಂಗೆ ನ ಎಲ್ಲ"
    },
    {
      "t": "03:20",
      "text": "ಅಾನು ಬಬ"
    },
    {
      "t": "03:25",
      "text": "ಹ ನೀನು ಕಲತ್ರೆ ುಪ್ಪಕಿ ಫುಲ್ ಟೇಸ್ಟ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "03:30",
      "text": "ಹಾ"
    },
    {
      "t": "03:35",
      "text": "ಎಸ್ಬ ಅಗೆ ತ"
    },
    {
      "t": "03:40",
      "text": "ನಿನ್ನ ಇನ್ನೆ ಎಲ್ಲ ತಪ್ಕೊಂಡು"
    },
    {
      "t": "03:45",
      "text": "ನಿನ್ ಕತ್ತತ್ರ ಎಲ್ಲ ಕೀಸ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "03:50",
      "text": "ಟ ಹ್ಮ ಕಸ್ ಮಾಡತ"
    },
    {
      "t": "03:55",
      "text": "ಕೊಡ್ತಾ ಇದ್ದೀಿಂಗೆ ನಿನ್ ಮುಖ"
    },
    {
      "t": "04:00",
      "text": "ಖನ ತಿರುಗಸಿ ನಿನ್ನ ಲಿಪ್ಸ್ ನಲ್ಲ ಟೇಸ್ಟ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "04:05",
      "text": "ಕಸ್ ಕೊಡತಸೌ ಮಟು"
    },
    {
      "t": "04:10",
      "text": ""
    },
    {
      "t": "04:15",
      "text": "ನೀನು ಕೊಡು"
    },
    {
      "t": "04:20",
      "text": "ಹೇಬ ಬೇಬಿ ಸ್ನ್ಯಾಪ್ಚೆಟ್ ಯೂಸ್ ಮಾಡ್ತಿದ್ದಯಾ"
    },
    {
      "t": "04:25",
      "text": "ಇಲ್ಲ ನೀನ್ನ ನೋಡ್ಬೇಕ ಅನ್ಸುತ್ತಿದೆ ಬಿ"
    },
    {
      "t": "04:30",
      "text": "ನಾನ ನುಡ್ತ ಹ್ಮ ಸರಿ ಬೇಬಿ"
    },
    {
      "t": "04:35",
      "text": "ಕಿಸಕಡುೋ"
    },
    {
      "t": "04:40",
      "text": "ಹಕ್ಕ ಬಿಟು"
    },
    {
      "t": "04:45",
      "text": "ನ ನೀ ಪಲ್ಲ ನಮ್ಮತ್ತ"
    },
    {
      "t": "04:50",
      "text": "ಪ್ರ ನಟ್ ಕಲಿಪ"
    },
    {
      "t": "04:55",
      "text": "ಲ್ಲಾ ಕಸ್ ಮಾಡ್ತೀನಿ ಬ್ಲೌಸ್ ಮೇಲೆ"
    },
    {
      "t": "05:00",
      "text": "ಹ ಸದಾಗಿಿದ್ದವೆಬ"
    },
    {
      "t": "05:05",
      "text": "ಕಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ ನಿನ್ ಕಲ ಬೇಜ ಹತ್ರಲ್ಲ"
    },
    {
      "t": "05:10",
      "text": "ನೀ ಬ್ಲೌಸ್ ನ ಬಜತೀನ ಒಂದು ದೊ"
    },
    {
      "t": "05:15",
      "text": "ಹ ಬಚ್ಚ ತಿ ಬ"
    },
    {
      "t": "05:20",
      "text": "ಬ್ಲೌಸ್ ನ ಪೀಿಸಕಿ ಕೈೆತ್ತ ನಿ ನಂಡ"
    },
    {
      "t": "05:25",
      "text": "ಆಾಮ್ಸ್ನೆಲ್ಲ ಕಿಸ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "05:30",
      "text": "ಹಾ ಸಕ್ಕತ್ಾಗಿದೆ ಬೇಬಿ ಹ"
    },
    {
      "t": "05:35",
      "text": "ಏನು ನೀನ್ ನನ್ನು ಆರಾಮ್ಸತ ಎಲ್ಲ ಕಿಸ್ ಮಾಡ್ತಿದ್ದೀನಿ ಅಂದೆ"
    },
    {
      "t": "05:40",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "05:45",
      "text": "ಆ ನಿನ್ನ ತಪ್ಪಿಕೊಂಡು"
    },
    {
      "t": "05:50",
      "text": "ನೀ ಬಾವಲ್ಗಡೆ ಕೈ ಹಪ್ತೀನ"
    },
    {
      "t": "05:55",
      "text": "ಹ್ಮ್ ಹೇಳಡ್ಲಿಕ್ಕೆ ನಿ"
    },
    {
      "t": "06:00",
      "text": "ಒಳಗಡೆ ಕೈ ಹಾಕ್ತೀನಿ ಅಂದೆ"
    },
    {
      "t": "06:05",
      "text": "ಸಫ್ಟ ಆ"
    },
    {
      "t": "06:10",
      "text": "ಹ ಬೇಪಿಗೆ ಕೊಡು ಏನ್ ಮಾಡ್ತಯಟ"
    },
    {
      "t": "06:15",
      "text": "ಫುಲ್ ಸಪ್ ಮಾಡಿ ಪ್ರೆಸ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "06:20",
      "text": "ಇ ಬುರಾನಮ್ಮತವಿೀಚ್ಚ"
    },
    {
      "t": "06:25",
      "text": "ನಿನ್ ಬ್ರಾಣ ಬಿಸಾಕಿ ಒಂದ್ ಕೈಯಲ್ಲಿ ಪ್ರೆಸ್ ಮಾಡಿ"
    },
    {
      "t": "06:30",
      "text": "ಇನ್ನೊಂದ್ ಕೆಲ್ಸಪ್ ಮಾಡ್ತಾ್ದೀನಿ"
    },
    {
      "t": "06:35",
      "text": "ಹ್ಮ ಸಟ್ಟಣ"
    },
    {
      "t": "06:40",
      "text": "ಇ ಸೂರ್ ಕ ಅಂತ ಕೇಳಿಸ್ತಾ ಇಲ್ಲ"
    },
    {
      "t": "06:45",
      "text": "ಸಖತ್ಾಗಿದೆ ಕಾಣ"
    },
    {
      "t": "06:50",
      "text": "ನಿ ಪಲ್ಸ್ಲ್ಲ ಕಚ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "06:55",
      "text": "ಕಥಾಗಿತಣ"
    },
    {
      "t": "07:00",
      "text": "ಚಿಪ್ತಾ ಇದ್ದೀನಿ ನೀಷ್ಟು"
    },
    {
      "t": "07:05",
      "text": ""
    },
    {
      "t": "07:10",
      "text": "ಮ ಆ ಚಾನ್ಸ್ ಕೊಡ ನೀನ"
    },
    {
      "t": "07:15",
      "text": "ಹ್ಮ್ ಹ"
    },
    {
      "t": "07:20",
      "text": "ಹ ಸ ಕದಗಿದೆಬ"
    },
    {
      "t": "07:25",
      "text": "ಯಾರಾಾದರಿಚ ಪರ ಹ್ಮ"
    },
    {
      "t": "07:30",
      "text": "ಇಲ್ಲ ನಾನೇ ಫಸ್ಟು್ಮ"
    },
    {
      "t": "07:35",
      "text": "ನಿನ್ನ ಪಲ್ಸ್ನೆಲ್ಲ ಕಚ್ತಾ್ದೀನಿ"
    },
    {
      "t": "07:40",
      "text": "ಹ"
    },
    {
      "t": "07:45",
      "text": "ನಿಪಲ್ಸ್ ನ ಹಚ್ತಾ ಇದ್ದೀನಿ ಅಂದೆ"
    },
    {
      "t": "07:50",
      "text": "ಹ್ಮ್ಸಕ್ಕದಾಗದೆ ಕಡೆ"
    },
    {
      "t": "07:55",
      "text": "ಸ್ಥ ವ ಪ"
    },
    {
      "t": "08:00",
      "text": "ನೀನ್ೇನ್ ಮಾಡ್ತೀಿ ನಂಗೆ"
    },
    {
      "t": "08:05",
      "text": "ಮಾಡ ನೀನ ನ್ ಮಾಡ್ತ ಹೇಳು"
    },
    {
      "t": "08:10",
      "text": "ಕೊಡು ಮತ್ತೆ"
    },
    {
      "t": "08:15",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "08:20",
      "text": "ಹನ್ನೋ"
    },
    {
      "t": "08:25",
      "text": "ಹ್ಮ ಹಲೋ"
    },
    {
      "t": "08:30",
      "text": "ನ ಟೇಸ್ಟ್ ಮಾಡ್ತೀಯಾ ತಗೊ ಮತ್ತೆ"
    },
    {
      "t": "08:35",
      "text": "ಎಷ್ಟು ಜನ ಗತ್ತ ಸಿಕ್ಸು"
    },
    {
      "t": "08:40",
      "text": "ಹ್ಮ"
    },
    {
      "t": "08:45",
      "text": "ಟೇಸ್ಟ್ ಮಾಡಗೆ ಮಾಡ್ತ"
    },
    {
      "t": "08:50",
      "text": "ಹ್ಮ್ ಸೌ ಮಾಡುವ"
    },
    {
      "t": "08:55",
      "text": "ಮ ತ ಕಟಿ ಹ"
    },
    {
      "t": "09:00",
      "text": ""
    },
    {
      "t": "09:05",
      "text": "ಹ"
    },
    {
      "t": "09:10",
      "text": "ಮೆತ್ತಿಗೆ ಏನ್ಾಗನೆ"
    },
    {
      "t": "09:15",
      "text": "ಮೆತ್ತಕ್ ಮಾಡಾರು"
    },
    {
      "t": "09:20",
      "text": "ನಿನ್ ಗಂಟ್ಲು ತನಕ ಹೋಗುತ್ತೆ"
    },
    {
      "t": "09:25",
      "text": "ಹ ಹಲೋ"
    },
    {
      "t": "09:30",
      "text": "ಏನ್ ಮಾಡ್ತಿದ್ಯಾ"
    },
    {
      "t": "09:35",
      "text": "ಗ ಬ"
    },
    {
      "t": "09:40",
      "text": "ತ್ತಲ್ಲ"
    },
    {
      "t": "09:45",
      "text": "ಚೆನ್ನ್ಮ ಚ"
    },
    {
      "t": "09:50",
      "text": "ಚನ್ನರ್ತಿತ್ತು ಹ ಇನ್ನನ್ ಗಂಟ್ಲು ತನಕ ಹೋಗುತ್ತೆ ನೋಡು"
    },
    {
      "t": "09:55",
      "text": "ಹಾ ಹಾಕಿದೀನಲ್ಲ ಫುಲ್ ಬಾಯಲ್ಲಿ"
    },
    {
      "t": "10:00",
      "text": "ಹ"
    },
    {
      "t": "10:05",
      "text": ""
    },
    {
      "t": "10:10",
      "text": "ಕತ"
    },
    {
      "t": "10:15",
      "text": "ಆಾ ಮೇತ್ತಗೆ"
    },
    {
      "t": "10:20",
      "text": "ಹ"
    },
    {
      "t": "10:25",
      "text": "ಎಸ್ ಮ ತ"
    },
    {
      "t": "10:30",
      "text": "ಹಾ ಮೆತ್ತಗೆ"
    },
    {
      "t": "10:35",
      "text": "ಚೆಸ್ ಅಪ್ಪ"
    },
    {
      "t": "10:40",
      "text": "ಹಾ ಸ"
    },
    {
      "t": "10:45",
      "text": "ಹ"
    },
    {
      "t": "10:50",
      "text": "ನಾನು ಬೂಟ್ಸ್ನ ಪ್ರೆಸ್ ಮಾಡ್ತಾ್ದೀನಿ"
    },
    {
      "t": "10:55",
      "text": "ಹ್ಮ್ ಮಾಡ್ತಾ ಇದಿದ್ದೀನಿ ಎ"
    },
    {
      "t": "11:00",
      "text": "ಎರಡು ಬುಪ್ಸ್ ನಟ್ಕೊಂಡು ಗಟ್ಟಿಯಾಗೆ"
    },
    {
      "t": "11:05",
      "text": "ನೀನ ಕಲತ್ರ ಲಿ"
    },
    {
      "t": "11:10",
      "text": "ಮಾಡ್ತಾ್ದೀನಿ"
    },
    {
      "t": "11:15",
      "text": "ಮತ್ತ ಚಿರ ಬಚ್ಚಿ"
    },
    {
      "t": "11:20",
      "text": "ನಿನ್ ಕಾಲತ್ರರಿಿಂದಲ್ಲಾ ಕೀಸ್ ಮಾಡ್ಕೊಂಡ್ ಬರ್ತೀನಿ"
    },
    {
      "t": "11:25",
      "text": "ನೀನ್ ತೋಡೆ ಹತ್ರ ಎಲ್ಲ ಕಿಸ ಮಾಡ್ತೀನಿ ಹ್ಮ ಹ್ಮ್"
    },
    {
      "t": "11:30",
      "text": "ಹಲೋ"
    },
    {
      "t": "11:35",
      "text": "ನೀನು ತೊಡೆ ಹತ್ರ ಎಲ್ಲ ಕಸ್ ಮಾಡ್ತೀನಿ ಅಂತೆ"
    },
    {
      "t": "11:40",
      "text": "ಸಕ್ಕಗತ ಕಡೆ"
    },
    {
      "t": "11:45",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "11:50",
      "text": "ನಿನ್ ಪ್ಯಾಂಟಿ ಮೇಲೆಲ್ಲ ಕೀಸ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "11:55",
      "text": "ಮ ಪ್ಯಾಂಟಿ ಬಿ"
    },
    {
      "t": "12:00",
