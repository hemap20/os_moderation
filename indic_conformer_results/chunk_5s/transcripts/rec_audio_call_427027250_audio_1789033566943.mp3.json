    {
      "t": "00:00",
      "text": "ഹലോ എവിടെെന്നാ"
    },
    {
      "t": "00:05",
      "text": "ഇത് സ്ഥല ആലപ്പഴ ഇത്വിടന്നാ ഞാൻ കാസർഗോഡ് എന്ത് ചെയ്യുന്നു"
    },
    {
      "t": "00:10",
      "text": "വക്ക് ചെയ നിങ്ങ ചെയ്യാന വ ചെയ"
    },
    {
      "t": "00:15",
      "text": "ഒപ്പൊക്ക താല്പര്യംുണ്ടോ"
    },
    {
      "t": "00:20",
      "text": "ഓപ്പൺ ഡോക്ക്ന്ന് പറയുമ്പോ എന്ത ഓപ്പ"
    },
    {
      "t": "00:25",
      "text": "ണുമമ്പോ വീടോള്ും"
    },
    {
      "t": "00:30",
      "text": "വീഡിയോപളി ഞാൻ താല്പര്യംണ്ടോ"
    },
    {
      "t": "00:35",
      "text": "ഹലോലോ"
    },
    {
      "t": "00:40",
      "text": "ആഹ ഇതില ഇതിണ താല്പര്യുണ്ട്"
    },
    {
      "t": "00:45",
      "text": "വ"
    },
    {
      "t": "00:50",
      "text": "സ്റ്റ ഇതില ആളെ കാണാൻ പറ്റ ഇതില് ആളെ കാണാൻ പറ്റോ"
    },
    {
      "t": "00:55",
      "text": "പറ്റൂല ആെന്താ പറ്റൂന്ന്"
    },
    {
      "t": "01:00",
      "text": "എഡോ കോ ആ"
    },
    {
      "t": "01:05",
      "text": "സപ"
    },
    {
      "t": "01:10",
      "text": ""
    },
    {
      "t": "01:15",
      "text": "കാണ കാണൻ പറ്റുന്നില്ല എന്നാ"
    },
    {
      "t": "01:20",
      "text": "ഞൻ ആരന്നെ"
    },
    {
      "t": "01:25",
      "text": "വെല്ല പാണിക്ക്ു പോടെ വ വെല്ല പാണക്ക്ു പോടെ"
    },
    {
      "t": "01:30",
      "text": "നീ വല്ല പണ"
    }
  ],
