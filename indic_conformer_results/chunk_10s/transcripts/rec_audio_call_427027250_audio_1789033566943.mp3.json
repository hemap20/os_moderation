    {
      "t": "00:00",
      "text": "ഹലോ എവിടെന്നാ ഞാൻ കാസർഗോഡ് എന്ത് ചെയ്യുന്നു"
    },
    {
      "t": "00:10",
      "text": "ചെയാനക്ക് ചെയ ഓപ്പ താപര്യോഓപ്പ താര്യണ്ടോ"
    },
    {
      "t": "00:20",
      "text": "ഓപ്പൺോക്ക്ന്ന് പറയുമ്പോ എന്ത ഓപ്പൺ ഡടോക്ക് കണുമ്പോ വീഡിയോ കോള്"
    },
    {
      "t": "00:30",
      "text": "വീഡിയോപളി ഞാൻ താല്പര്യുണ്ടോ എന്ത"
    },
    {
      "t": "00:40",
      "text": ""
    },
    {
      "t": "00:50",
      "text": "ഫസ്റ്റ ഇതില ആളെ കാണാൻ പറ്റ ഇതി ആളെ കാണൻറ്ററ്റൂെന്താറ്റ"
    },
    {
      "t": "01:00",
      "text": "ിയോ കോ ആ ആ ഇതില് വഡിയോ കോൾ ആിപ"
    },
    {
      "t": "01:10",
      "text": "കാണ കാണാൻ പറ്റുന്നില്ല എന്നാ"
    },
    {
      "t": "01:20",
      "text": "ഞ വെല്ല പാണി പോടെ വെല്ല പാണക്ക്ു പോടെ"
    },
    {
      "t": "01:30",
      "text": "നീ വല്ല പണ"
    }
  ],
