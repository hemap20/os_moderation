    {
      "t": "00:00",
      "text": "ഹലോ എവിടെ സ്ഥലം"
    },
    {
      "t": "00:10",
      "text": "ത്ടെ സ്ഥലന്ന്ൃടെ സ്ഥലന്ന്"
    },
    {
      "t": "00:20",
      "text": "കല്യാണം കഴിഞ്ഞ വസണ്ട് ട്വന് സെവ"
    },
    {
      "t": "00:30",
      "text": "എങ്ങനെ എല്ലാ കോളോ പ്പൺ"
    },
    {
      "t": "00:40",
      "text": "ഏ ചോ കേ എല്ലോ ഓപ്പൺ കോള് ചെയ്യാറുോ ഓപ്പൺോ ചെയ്യാറുണ്ടോന്ന്"
    },
    {
      "t": "00:50",
      "text": "ശരിക്കും ചെയ്യാലേ എന്ത ഒപ്പം കോ"
    },
    {
      "t": "01:00",
      "text": "ചോദിച്ചന്നള്ളു ഞൻപ്പോോ ആണ്ട"
    },
    {
      "t": "01:10",
      "text": "ആണോ അ ഞാൻ അണ്ടൊക്കെ ചെയ് വേണമെങ്കിൽ കട്ട് ചെയ്തോട്ടോ കൊഴപ്പില്ലഞാൻ"
    }
  ],
