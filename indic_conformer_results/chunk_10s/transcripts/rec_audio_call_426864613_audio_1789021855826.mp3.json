      "t": "01:10",
      "text": "ಅಕ್ಕಾನಲ್ಲ ಹ್ಮ್ ಹ್ಮ್ ಹಾಗೆ"
    },
    {
      "t": "01:20",
      "text": "ಮತ್ತೆ ಬೇರೆ ವಿಶೇಷಗಳುವಂತಂಗಡಿನ"
    },
    {
      "t": "01:30",
      "text": "ಏನ್ ನಿಮ್ಮ್ ಹೆಸರುಜ ಎಷ್ಟ"
    },
    {
      "t": "01:40",
      "text": "ಹ ಮತ್ತೆ ಬೇರೆ"
    },
    {
      "t": "01:50",
      "text": "ಗಣೇಶ ಹಬ್ಬ ಎಲ್ಲ ಬರ್ತಾ ಇದೆ ಜೋರ್ ವ್ಯಾಪಾರ ಅಂಗ"
    },
    {
      "t": "02:00",
      "text": "ಸಿರ್ಸಿಯಲ್ಲಿಲ್ಲಿ ಮು"
    },
