    {
      "t": "00:50",
      "text": "ಹ್ಮ ಎಷ್ಟ ಮಾಡದ"
    },
    {
      "t": "01:00",
      "text": "ಹ್ಮ ಯಾರಲ್ಲ ಇದಾರ ಮನೆಯಲ್ಲಿ ಮನ ನಮ್ಮಮ್ಮ ನಾನಮ್ಮ"
    },
