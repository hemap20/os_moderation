    },
    {
      "t": "02:20",
      "text": "ಸ್ಣದನ್ರಿ ಸ ಸರಿ ಸರಿ"
    },
    {
      "t": "02:30",
      "text": "ಮತ್ತೆ ಬೇರೆಬೇಕ ಈಗನ್ ಅಷ್ಟಲ್ಲ ಇದ್ರ"
    },
    {
      "t": "02:40",
      "text": "ಹ್ಮ್ ಹಾಗದು ಹ್ಮ"
    },
