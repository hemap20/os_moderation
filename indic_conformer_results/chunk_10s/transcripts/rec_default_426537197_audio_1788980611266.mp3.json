    {
      "t": "00:00",
      "text": "ഹലോ ഹലോ ഞാന് എറണാകുളം"
    },
    {
      "t": "00:10",
      "text": "ഞാൻ അക്കൗണ്ടാണ് രേഷ്മ എന്ത"
    },
    {
      "t": "00:20",
      "text": "എന്താ ചെയ്യുന്നത് രേഷ്മേഷ്മ എന്താ ചെയ എന്തിനാ പഠിക്ക"
    },
    {
      "t": "00:30",
      "text": "നഴസിംഗ എവിടെയ പഠിക്കണ അപ്പ അവിടെയാണോ"
    },
    {
      "t": "00:40",
      "text": "ഓെ മാഡാണോ അതോ ബോയ് ഫ്രണ്ട്ോ അങ്ങനെ എന്തെിലും ഉണ്ടോ"
    },
    {
      "t": "00:50",
      "text": "ആ കോപ്പെട്ടക്ക"
    },
    {
      "t": "01:00",
      "text": "യണ്ടോ ഓപ്പൺ ടോക്ക് താല്പര്യുണ്ടോന്ന്"
    },
    {
      "t": "01:10",
      "text": "അല്ല"
    }
  ],
