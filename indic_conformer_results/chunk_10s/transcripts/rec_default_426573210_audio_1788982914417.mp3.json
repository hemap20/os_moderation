    {
      "t": "01:20",
      "text": "ர பண்ணீங்க உங்க படிச்ச போட்டுருவாங்க"
    },
    {
      "t": "01:30",
      "text": "என்னையே ஏன் பயனுச்சன்னலாங்க பண்ண கூடாது அது தப்பு"
    },
    {
      "t": "01:40",
      "text": "என்ன சரக்குக்கு சரக்கு சரக்கு மாசாவா ரெண்டு அடி மிக்ஸ் ஆகி வயிற் கலக்குறதுக்கா"
    },
    {
      "t": "01:50",
      "text": "சரக்கு மா"
    },
    {
      "t": "02:00",
      "text": "வறண்டா செவனா புறண்ணா"
    },
    {
      "t": "02:10",
      "text": "எனெடி ஆள் இருக்கு"
    },
    {
      "t": "02:20",
      "text": "உம் என்னடி என்ன கொண்டு"
    },
    {
      "t": "02:30",
      "text": "உ ரரண்ட அவளும் அப்பல்லாம் பேசுறங்க"
    },
    {
      "t": "02:40",
      "text": "உம் புரியலா"
    },
    {
      "t": "02:50",
      "text": "ா வா்ப்ல வரீங்களா பண்ண"
    },
    {
      "t": "03:00",
      "text": "நம்பர் நோட் பண்ணிக்க செவன் டபுள் த்ரீ"
    },
    {
      "t": "03:10",
      "text": "நைன் சிக்ஸ் எயிட் ஒன் நயன்"
    },
    {
      "t": "03:20",
      "text": "நயன் தண்ட"
    },
    {
      "t": "03:30",
      "text": "பேர் தாரணி தாரணி தாரணி தாரணி"
