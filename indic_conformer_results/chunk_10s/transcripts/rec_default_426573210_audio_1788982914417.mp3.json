    {
      "t": "00:50",
      "text": "சென்னனை நீ"
    },
    {
      "t": "01:00",
      "text": "கோய கோயம்பத்த உன ஒ"
    },
    {
      "t": "01:10",
      "text": "புரிய கோயு் கோ"
