    {
      "t": "00:00",
      "text": "ஹ ஹலோ ஆஹ் எங்க பேரு என்ன"
    },
    {
      "t": "00:10",
      "text": "என் பேரு ரம்யா உங்க பேரு எந்த ஊரு"
    },
    {
      "t": "00:20",
      "text": "நான் கோயம்புத்தூரு இன்ஸ்டா வரங்களா நியூ வீடியோ கால"
    },
    {
      "t": "00:30",
      "text": "மளாய பூண்டைய எல்லாம் காட்டுவ ஆமா மளாய பூண்டையல்லாம்ட்டு"
    },
    {
      "t": "00:40",
      "text": "எவ்ளவு தருவங்க எனக்கு வேணும் நீங்க எவ் தரு"
    },
    {
      "t": "00:50",
      "text": "நீங்க இது வரைக்கும் எவ்ளவு கண்டு போயிருக்கீங்கு சொல்லுே"
    },
    {
      "t": "01:00",
      "text": "த"
    },
    {
      "t": "01:10",
      "text": "ரம்யாரி மறுபடியும்ா ரம்யா"
    },
    {
      "t": "01:20",
      "text": "ஆர் ஏ எம் ஒயய ஆர் ஏ எம் ஒயய போட்டியா"
    },
    {
      "t": "01:30",
      "text": "ச"
    }
  ],
