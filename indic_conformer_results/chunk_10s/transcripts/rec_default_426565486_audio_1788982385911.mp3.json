  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ എവിടെല എന്ത് ചെയ്യുന്നു"
    },
    {
      "t": "00:10",
      "text": "ആയുവേദന ആയുർവേദനട്ട്ക്ക"
    },
    {
      "t": "00:20",
      "text": "ണ്ട ഡ എവണ്ടോ"
    },
    {
      "t": "00:30",
      "text": "ന്നില്ലേ ഉണ്ടായിരുന്നു കേട്ടില്ല"
    },
    {
      "t": "00:40",
      "text": "ണ്ട കളിച്ചിട്ടണ്ടോ"
    },
    {
      "t": "00:50",
      "text": "എവിടെ"
    },
    {
      "t": "01:00",
      "text": "്ര ഇപ്പ തന്നെ പോും സരിയല്ല കള കഴിഞ്ഞാല് പോയി എത്ര വഷം കളിട്ടുണ്ട്"
    },
    {
      "t": "01:10",
      "text": "എത്ര പ്രാവശ്യം കളിച്ചിട്ടുണ്ടാവും എവിടെൊക്കെുന്ന"
    },
    {
      "t": "01:20",
      "text": "തിരുവനന്തപുരം തിരുവനന്തപുരം വന്നാൽ കാണാൻ പറ്റോ എന്"
    },
    {
      "t": "01:30",
      "text": "എനിക്കും കളിക്കാന അവ നീൊക്കെ തന്നിരുന്നു"
    },
    {
      "t": "01:40",
      "text": "നക്കുമ്പോല്ലേ സുഖം നക്കി കാത്തന്താ ഞാ നക്കി തട്ടേ"
    },
    {
      "t": "01:50",
      "text": "ചറ്റുമ്പോ വേദന ഉണ്ടോ ഇല്ല"
    },
    {
      "t": "02:00",
      "text": "ഖണ്ട"
    },
    {
      "t": "02:10",
      "text": "ില"
    },
    {
      "t": "02:20",
      "text": "എ കിക്ക കാണില്ല"
    },
    {
      "t": "02:30",
      "text": "ണ്ടല്ലോന്ത"
    },
    {
      "t": "02:40",
      "text": "ല കാണിച്ചല കാ കാണിക്ക"
    },
    {
      "t": "02:50",
      "text": "അ"
    },
    {
      "t": "03:00",
      "text": "അല്ല വീട്ടിലാ"
    },
    {
      "t": "03:10",
      "text": "കൊഴോരാറുണ്ടോല്ല"
    },
    {
      "t": "03:20",
      "text": "ഇനിപ്പോഴാ തിരുവനന്തപുരംണ"
    },
    {
      "t": "03:30",
      "text": "എ മടായി"
    },
    {
      "t": "03:40",
      "text": "മട കാണ അക്കി തറ്റൻ"
    },
    {
      "t": "03:50",
      "text": "അമ്മോതെ കാണിക്കുന്നു ഞാൻ നോക്കട്ടെ കാണിക്ക"
    },
    {
      "t": "04:00",
      "text": "പോലെ കാണിച്ചിട"
    },
    {
      "t": "04:10",
      "text": "ാ"
    },
    {
      "t": "04:20",
      "text": "അ കാണിക്ക കാണിക്കോ"
    },
    {
      "t": "04:30",
      "text": "ഉ എന്നെ കാണാൻ പറ്റുന്നതല്ലോ"
    },
    {
      "t": "04:40",
      "text": "ഇല്ലല്ലോ അപ്പ കാണാം"
    },
    {
      "t": "04:50",
      "text": "ഇ"
    },
    {
      "t": "05:00",
      "text": "ണാന"
    },
    {
      "t": "05:10",
      "text": "കാണിച്ചട കാണിക്കു"
    },
    {
      "t": "05:20",
      "text": "കാണിക്കടിണ ആയി കാണിക്ക നോക്കട്ടെ"
    },
    {
      "t": "05:30",
      "text": "ആയി നോക്ക് കാണിക്കുൂടാവ കാണ"
    },
    {
      "t": "05:40",
      "text": "കാണിക്കപ്പ"
    },
    {
      "t": "05:50",
      "text": "കാണിക്ക ഞാൻ കരുന്നുണ"
    },
    {
      "t": "06:00",
      "text": "ല കട്ട ചെയ്യുന്ന ഓക്കെ കാണിക്കോ കാണിക്കില്ലേ"
    },
    {
      "t": "06:10",
      "text": "പൂട് നക്കി തരാം നല്ല പാല നക്കി തരും വിരവാം"
    },
    {
      "t": "06:20",
      "text": "ആരല്ലേ നല്ല പ നക്കി തരു പോ വരോ"
    },
    {
      "t": "06:30",
      "text": "കാസർഗോഡ എന്റെ പൂർണക്കി തരു നല്ലാണ്"
    },
    {
      "t": "06:40",
      "text": "അക്കന് ഇഷ്ടയാ കേറ്റുന്ന മാത്രേ ഇഷ്ടോ കേറ്റുന്ന മാത്രയാ"
    },
    {
      "t": "06:50",
      "text": "നല്ല രസമുണ്ടോ കേറ്റുമ്പോ കേറ്റുമ്പോ രസമുണ്ടോ"
    },
    {
      "t": "07:00",
      "text": "ആണോം ആണോ സാധനം ആണോ"
    },
    {
      "t": "07:10",
      "text": "കേട്ടട്ടാ കളിക്കണം"
    },
    {
      "t": "07:20",
      "text": ""
    }
  ],
