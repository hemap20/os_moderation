    },
    {
      "t": "01:00",
      "text": "ವಿಜಯಂತ"
    },
    {
      "t": "01:10",
      "text": "ಸ್ ಮತ್ತೆ ಮನ್ಚ"
    },
    {
      "t": "01:20",
      "text": "ಅಂದ್ರೆ ಯಾವತರ"
    },
    {
      "t": "01:30",
      "text": "ಎಫುಡ್ ವರ್ ಸಿಕ್ಸ್ ಬನ ಶಾಂತನ ಎಳ್ಳಿ"
    },
    {
      "t": "01:40",
      "text": "ನಿಮ್ಗೆ ಯಾವತರ ಇಷ್ಟ ಎಂತ ನಲ ಸ ಮಾಡ್ತಾರೆೆ ಇಷ್ಟ"
    },
    {
      "t": "01:50",
      "text": "ಬೇರೆ ಬೇರೆ ಇನ್ನೇನು ಇಷ್ಟಂದ"
    },
    {
      "t": "02:00",
      "text": "ರೆ ಸೆಕ್ಸಲ್ಲಿ ಇನ್ನೇನ್ ಇಷ್ಟಾಂತ"
    },
    {
      "t": "02:10",
      "text": "ಅತ್ತ ಆಗ್ಲಿಲ್ಲ ಸೆಕ್ಸ್ ಅಲ್ಲಿ ನಿಮ್ಗೆ ಯಾವತರ ಇಷ್ಟ ಅಂತ ಅಂದ್ರೆಂಗ"
    },
    {
      "t": "02:20",
      "text": "ಇ ಹ್ಮ್ ನಿಮ್ಗೆ ಹೆಂಗ ಮಾಡುದ್ರ ಆಮ"
    },
    {
      "t": "02:30",
      "text": "ನಕ ತುಲ್ಸಪುರಿಷಠಾನ"
    },
    {
      "t": "02:40",
      "text": "ಹ್ಮ ಬೇರೆ"
    },
    {
      "t": "02:50",
      "text": "ನಿ ನಮಗ್ ತುಲ್ಸಿ ಪೂುದಂದೆ ತುಂಬಾ ಆಸೆ ಡಾರ್ ಸ್ಟೈಲ್"
    },
    {
      "t": "03:00",
      "text": "್ಮ ಅವಳ ನೀವು ಅವಳ ನಮ್ಮೋಡ ತಂದ್ರ ತಂಬ"
    },
    {
      "t": "03:10",
      "text": "ೆ ನನ್ ಮೇಲೆ ಅವಳು ಬಂದ್ ಮಾಡಿದ್ರೆ ಇನ್ನೂ ಆಸೆ"
    },
    {
      "t": "03:20",
      "text": "ಕಷ್ಟ ಆಗಲ್ ನಮ್ಗ ನಮನ್"
    },
    {
      "t": "03:30",
      "text": "ಏನು ಇಲ್ಲ ಚೆನ್ನಾಗಿರುತ್ತೆ ಮತ್ತೆ ಮಾತಾಡ್ಕ್ ಇಂಟ್ರೆಸ್ಟ್ ಇದೆಯಾ"
    },
    {
      "t": "03:40",
      "text": "ಹ್ಮ ಹೌದು"
    },
    {
      "t": "03:50",
      "text": "ಓನ್ಲಿ ಯಪ ತೋತೀರಾ"
    },
    {
      "t": "04:00",
      "text": "ಏನ್ ತೋಬೇಕು ತೋಿ"
    },
    {
      "t": "04:10",
      "text": "ನ್ ನೋಡ ಕೆ ಕೇಳು ಹ್ಮ"
    },
    {
      "t": "04:20",
      "text": "ನೀವ್ ಯಾವ ಜೀತ ಟ್ರೈ ಮಾಡಿಲ್ವಾ ಮಾಡಿದ್ದೀನಿ"
    },
    {
      "t": "04:30",
      "text": "ಎಷ್ಟಲ ಮಾಡಿದ್ದೀರಾ ಕಟಿನ್ಯ ನಿೆನ್ನೆನು ಮಾಡ್ದ್ಮ"
    },
    {
      "t": "04:40",
      "text": "ಇಲ್ಲಿ ನಮ್ಮ ಮನೆ ಪಕ್ಕದಲ್ಲಿ ಇರೋದು್ರಟಟ"
    },
