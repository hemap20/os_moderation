      "text": "అ మరి దంకి దం మధ్యలో పెట్టా అ"
    },
    {
      "t": "01:30",
      "text": "ఇంటస్ట్ ఉన్నా ఇంట"
    },
    {
      "t": "01:40",
      "text": ""
    },
    {
      "t": "01:50",
      "text": "అవు"
    },
