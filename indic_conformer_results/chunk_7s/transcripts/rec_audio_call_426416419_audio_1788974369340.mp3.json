    {
      "t": "00:07",
      "text": "ஆஹ் என் பேரு என்ன என் பேரு"
    },
    {
      "t": "00:14",
      "text": "ரம்யா உங்க பேரு எந்த ஊரு"
    },
    {
      "t": "00:21",
      "text": "நான் கோயம்புத்தூர் இன்ஸ்டா வரங்க தா நியூஸ் வீடியோ கால"
    },
    {
      "t": "00:28",
      "text": "மள பூண்டு எல்லாம் காட்டுவேன் ஆமா"
    },
    {
      "t": "00:35",
      "text": "பாக்கல்லாம் பாட்டு"
    },
    {
      "t": "00:42",
      "text": "எவ்வளவு தருவீங்க எனக்கு வேணும் நீங்க எவ்வளவு தருவீங்க"
    },
    {
      "t": "00:49",
      "text": "நீங்க இதுரைக்கும் எவ்ளவு தண்டு போயிருக்கீங்கு சொல்லுங்க ஓகே சொல்ேன்"
    },
    {
      "t": "00:56",
      "text": "ந த கே"
    },
    {
      "t": "01:03",
      "text": ""
    },
    {
      "t": "01:10",
      "text": "ரம்யா சரி"
    },
    {
      "t": "01:17",
      "text": "மபடிய ரம்யா ஆ ஏம் ஒ"
    },
    {
      "t": "01:24",
      "text": "ஆர் ஏஎம் ஒ போட்டியா"
    },
    {
      "t": "01:31",
      "text": "போ"
    },
    {
