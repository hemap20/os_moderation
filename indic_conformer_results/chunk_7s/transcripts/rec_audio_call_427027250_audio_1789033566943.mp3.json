    {
      "t": "00:00",
      "text": "ഹലോ എ  ഇത് സലല പ്ര ഇത എവിടുന്നാ"
    },
    {
      "t": "00:07",
      "text": "ഞാൻ കാസർഗോഡ എന്ത് ചെയ്യുന്നു ചെയ നി ചെയ ാനുംക്ക് ചെയ്യ"
    },
    {
      "t": "00:14",
      "text": "ഓപ്പൺോക്കി താല്പര്യുണ്ടോ ഓപ്പൺോക്ക താപര്യണ്ടോ"
    },
    {
      "t": "00:21",
      "text": "പ്പൺോക്ക്ുമ്പോ വീഡിയോ കോള്"
    },
    {
      "t": "00:28",
      "text": "വീഡിയോപളി ഞാൻ താല്പര്യണ്ടോ"
    },
    {
      "t": "00:35",
      "text": "ഹലോ ആഹ ഇതി ഇതി"
    },
    {
      "t": "00:42",
      "text": "തപയണ്ട് ഇതിലടാപ്പാട"
    },
    {
      "t": "00:49",
      "text": "ഇതി ആളെ കാണാൻ പറ്റ ഇതില ആളെ കാണാൻ പറ്റ"
    },
    {
      "t": "00:56",
      "text": "ാ വീഡിയോ കോൾ ആോ"
    },
    {
      "t": "01:03",
      "text": "ആ ഇതില് വീഡിയോ കോൾ ആാക്കി അക്സെപ ചെയ"
    },
    {
      "t": "01:10",
      "text": "കാണോ പറ്റ"
    },
    {
      "t": "01:17",
      "text": "കാണാൻ പറ്റുന്നില്ല എന്നാ ഞൻരന്നെ"
    },
    {
      "t": "01:24",
      "text": "വെല്ല പാണിക്ക് പോടെ വെ വെല്ല പാണിക്ക്ു പോടെ"
    },
    {
      "t": "01:31",
      "text": "നീ വല്ല പണി"
    }
  ],
