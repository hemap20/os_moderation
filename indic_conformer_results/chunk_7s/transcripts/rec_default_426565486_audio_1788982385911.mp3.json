  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:07",
      "text": "എ ചെയ"
    },
    {
      "t": "00:14",
      "text": "ആയുർവേദനസായിട്ട്ക്കവിടെ"
    },
    {
      "t": "00:21",
      "text": "എല്ലവണ്ടോ"
    },
    {
      "t": "00:28",
      "text": "അല്ല വന്നില്ലേ"
    },
    {
      "t": "00:35",
      "text": "ണ്ടായി കേട്ടില്ല ലണ്ടായിുന്നോ"
    },
    {
      "t": "00:42",
      "text": "ഉണ്ടായിരുന്നു പറയാട്ടെ"
    },
    {
      "t": "00:49",
      "text": "കളിച്ചിട്ടുണ്ട ചോച്ച"
    },
    {
      "t": "00:56",
      "text": "എവിടെല്ല കളിച്ചാല് ബ്രേക്കപ്പ ഇപ്പോൾ തന്നെ പോുന്നു"
    },
    {
      "t": "01:03",
      "text": "കള കഴിഞ്ഞാല് പോഓ എത്ര വഷം കളിച്ചിട്ടുണ്ട്"
    },
    {
      "t": "01:10",
      "text": "എത്ര പ്രാവശ്യം കളിച്ചിട്ടുണ്ടാവും"
    },
    {
      "t": "01:17",
      "text": "എവിടെക്കായിരുന്നാ തിരുവനന്തപുരം"
    },
    {
      "t": "01:24",
      "text": "തിരുവനന്തപുരം വന്നാൽ കാണാൻ പറ്റോ എനിക്കും കളിക്കാനാ"
    },
    {
      "t": "01:31",
      "text": "അ്യടാ ഇല്ല"
    },
    {
      "t": "01:38",
      "text": "ക്കുമ്പോല്ലെ സുഖം മക്ക കാത്തന്ത"
    },
    {
      "t": "01:45",
      "text": "ആറ്റട്ടന്ത"
    },
    {
      "t": "01:52",
      "text": "ചറ്റുമ്പോ വേദന ഉണ്ടോ"
    },
    {
      "t": "01:59",
      "text": ""
    },
    {
      "t": "02:06",
      "text": "സുഖണ്ടോ സുഖണോറ്റ"
    },
    {
      "t": "02:13",
      "text": "ഒന്നല്ലില ഒന്നുംല്ലായിുന്നോ"
    },
    {
      "t": "02:20",
      "text": "എ കളിക്ക കാണില്ല"
    },
    {
      "t": "02:27",
      "text": "ന്റെ മോല കണ്ടല്ലോ മോല ക"
    },
    {
      "t": "02:34",
      "text": "എ എന്ത്"
    },
    {
      "t": "02:41",
      "text": "കാണിച്ച ആ"
    },
    {
      "t": "02:48",
      "text": "മല്ല കാണ്ടിക്ക"
    },
    {
      "t": "02:55",
      "text": "ടായി ഒറ്റക്കണോ താമസം"
    },
    {
      "t": "03:02",
      "text": "അല്ല വീട്ടില എന്റെ വീട്ടിലാണോ"
    },
    {
      "t": "03:09",
      "text": "വിടെയാ കോഴിക്കോടൊക്കെ വരാറുണ്ടോ"
    },
    {
      "t": "03:16",
      "text": "മ്മ ഇനിപ്പോളാ തിരുവനന്തപുരം"
    },
    {
      "t": "03:23",
      "text": "ങ്ങ"
    },
    {
      "t": "03:30",
      "text": "എന്ത്"
    },
    {
      "t": "03:37",
      "text": "മടായി മൂടായി"
    },
    {
      "t": "03:44",
      "text": "കാണിക്ക അക്കിത്തറ്റൻ"
    },
    {
      "t": "03:51",
      "text": "അമോത കാണിക്ക ഞാൻ നോക്കട്ടെ"
    },
    {
      "t": "03:58",
      "text": "കാണ പോലെ കാണിച്ചിട"
    },
    {
      "t": "04:05",
      "text": "അനിച്ച"
    },
    {
      "t": "04:12",
      "text": ""
    },
    {
      "t": "04:19",
      "text": "അ കാണിക്കുന്ന കാണ"
    },
    {
      "t": "04:26",
      "text": "രണ്ടോ"
    },
    {
      "t": "04:33",
      "text": "എന്നെ കാണാൻ പറ്റുന്നല്ലല്ലോ"
    },
    {
      "t": "04:40",
      "text": "ഇല്ലല്ലോ ഇപ്പ കാണാം"
    },
    {
      "t": "04:47",
      "text": "ള കണ്ടോ"
    },
    {
      "t": "04:54",
      "text": "ഇക്കിതിിക്കഞ്ഞ"
    },
    {
      "t": "05:01",
      "text": "ജസ്റ്റ് കാണിക്ക പോയിപ്പിക്കാന"
    },
    {
      "t": "05:08",
      "text": "ആ കാണിച്ചോട"
    },
    {
      "t": "05:15",
      "text": "കാണിക്കു"
    },
    {
      "t": "05:22",
      "text": "കാണിക്കടി ആയി കാണിക്ക നോക്കട്ടെ"
    },
    {
      "t": "05:29",
      "text": "ആയി നോക്ക് കാണിക്ക"
    },
    {
      "t": "05:36",
      "text": "കാണിക്കല്ല"
    },
    {
      "t": "05:43",
      "text": "കാണിക്ക പോ"
    },
    {
      "t": "05:50",
      "text": "കാണിക്ക ഞാൻ കട്ട ചെയു"
    },
    {
      "t": "05:57",
      "text": "കാണിക്കൂല കട്ട ചെയ്യുന്ന ഓക്കെ"
    },
    {
      "t": "06:04",
      "text": "കാണിക്കോ കാണിക്കില്ലേ പൂർ നക്കി തരാ"
    },
    {
      "t": "06:11",
      "text": "നല്ല പാല നക്കി തരും വരോ"
    },
    {
      "t": "06:18",
      "text": "ആരല്ലേ അല്ല"
    },
    {
      "t": "06:25",
      "text": "നട്ടി തിരുപ്പൂർ വരോ"
    },
    {
      "t": "06:32",
      "text": "കാസർഗോഡ എന്റെ പൂർണക്കി തരും നല്ല"
    },
    {
      "t": "06:39",
      "text": "അക്കനിഷ്ഠ"
    },
    {
      "t": "06:46",
      "text": "കേറ്റന്ന് മാത്രേ ഇഷ്ടോ കേറ്റുന്ന മാത്ര നല്ല രസുണ്ടോ"
    },
    {
      "t": "06:53",
      "text": "റ്റുമ്പോ രസുണ്ടോ"
    },
    {
      "t": "07:00",
      "text": "ഡേറ്റ് ആണോ അന് ഡേറ്റ് ആണോ"
    },
    {
      "t": "07:07",
      "text": "സാധനം തറ്റാണോ കേറ്റട്ടോ"
    },
    {
      "t": "07:14",
      "text": "ക്ക കളിക്കണം"
    },
