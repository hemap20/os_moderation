  "segments": [
    {
      "t": "00:00",
      "text": "சொல்லு என்ன சொல்லுங்க"
    },
    {
      "t": "00:07",
      "text": "என்ன பண்றீங்க பேற"
    },
    {
      "t": "00:14",
      "text": "அப்புறம்"
    },
    {
      "t": "00:21",
      "text": "சப்பச்சாய சப்பட்சாய"
    },
    {
      "t": "00:28",
      "text": "பண்ணலாம் எப்படி இருக்காரு நல்லா தர"
    },
    {
      "t": "00:35",
      "text": "க்கு தெரியுமா போஸ் பண்றது தெரியாம போ"
    },
    {
      "t": "00:42",
      "text": "உம்"
    },
    {
      "t": "00:49",
      "text": "ஹ எதுவும் சொல்ல மாட்டாரா"
    },
    {
      "t": "00:56",
      "text": "பள்ளி அவருச்ச இருக்காரா"
    },
    {
      "t": "01:03",
      "text": ""
    },
    {
      "t": "01:10",
      "text": "அப்பத்த போ"
    },
    {
      "t": "01:17",
      "text": "ஆ கக்க உஹம்"
    },
    {
      "t": "01:24",
      "text": "சொல்லுங்க குழங்கைங்க"
    },
    {
      "t": "01:31",
      "text": ""
    },
    {
      "t": "01:38",
      "text": "அப்புறாங்க"
    },
    {
      "t": "01:45",
      "text": ""
    },
    {
      "t": "01:52",
      "text": "கேம சரி பண்ணலாமா"
    },
    {
      "t": "01:59",
      "text": "சொண்ணாமா சொண்ட தர மாட்டார்ல"
    },
    {
      "t": "02:06",
      "text": "என்ல்ல"
    },
    {
      "t": "02:13",
      "text": "கேக்குக்கா"
    },
    {
      "t": "02:20",
      "text": "எப்படி பண்ணா பிடிக்கும் உங்களுக்கு"
    },
    {
      "t": "02:27",
      "text": "ஹலோ எப்படி ப"
    },
    {
      "t": "02:34",
      "text": "எனக்கு மெயினா பின்னாடி பண்றாதான் பிடிக்கும்"
    },
    {
      "t": "02:41",
      "text": "முன்னாடி அதுக்கப்புறம் பின்னாடிாடி"
    },
    {
      "t": "02:48",
      "text": "பின்னாடிதான் பண்ணும் பின்னாடி பண்ணலாம்னா நல்லா பின்னாடி நல்லா உங்க தண்மையா ஆச்சு"
    },
    {
      "t": "02:55",
      "text": "நல்லா நச்சுட்டுண்டு நச்சி நச்சி நல்லா உள்ள விட்ட அடிக்காங்க பின்னாடி ஓட்டுறதோட பின்னாடி ஓட்டுற"
    },
    {
      "t": "03:02",
      "text": "நல்லா"
    },
    {
      "t": "03:09",
      "text": ""
    },
    {
      "t": "03:16",
      "text": "ையக்கே அப்படிானேிருக்கேன்"
    },
    {
      "t": "03:23",
      "text": "வருமும் இல்ல இல்ல"
    },
    {
      "t": "03:30",
      "text": "எட்டு வருஷமா பின்னாடி பண்ணது இல்லைய வரு பது இல்லா"
    },
    {
      "t": "03:37",
      "text": "நீங்க குழந்தைங்கும் அது கல்யாணம்"
    },
    {
      "t": "03:44",
      "text": "அதுக்கப்புறம் பண்ணவே இல்லையா ஏாங்க"
    },
    {
      "t": "03:51",
      "text": "என்னன்ன சொல்றீங்க புடிக்கல"
    },
    {
      "t": "03:58",
      "text": "டு வாங்கறது பிடிக்கலையா அடி வாங்கறது பிடிக்கலையா அண்ண"
    },
    {
      "t": "04:05",
      "text": "அவரை புிடிக்கலையா"
    },
    {
      "t": "04:12",
      "text": "என்ன மாதிரி ஆள் வந்த"
    },
    {
      "t": "04:19",
      "text": "சரிய"
    },
    {
      "t": "04:26",
      "text": "சரிங்க என்ன சொன்னுங்க"
    },
    {
      "t": "04:33",
      "text": ""
    },
    {
      "t": "04:40",
      "text": "ஹலோ ஆஹ்"
    },
    {
      "t": "04:47",
      "text": ""
    },
    {
      "t": "04:54",
      "text": "ஹஸ்பண்ட் அண்டாரா சரி ஓகே சொருங்க"
    },
    {
      "t": "05:01",
      "text": "ஹலோ"
    },
    {
      "t": "05:08",
      "text": "ஸபண்ட்ண்டாரா சரி ஓகே"
    },
    {
      "t": "05:15",
      "text": "ந"
    }
