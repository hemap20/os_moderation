    {
      "t": "00:00",
      "text": "ஹலோ ஹலோ ம் சொல்லுங்க"
    },
    {
      "t": "00:07",
      "text": "ஹலோஹ் இப்பா எங்க இருந்து பேசுறீங்க எப்படி இருக்கீங்க"
    },
    {
      "t": "00:14",
      "text": "உஹம் நல்லா இருக்கேன் ந சொன்னேன் நீங்க குசிப்ப"
    },
    {
      "t": "00:21",
      "text": "என்ன பங்க"
    },
    {
      "t": "00:28",
      "text": "சாப்பிடுச்சா என்ன சாப்பிட்டீங்க"
    },
    {
      "t": "00:35",
      "text": ""
    },
    {
      "t": "00:42",
      "text": "ந"
    },
    {
      "t": "00:49",
      "text": "ப இருக்கேன்ா உம் நல்லாதான் இருக்கேன்"
    },
    {
      "t": "00:56",
      "text": "நட சமந்தா"
