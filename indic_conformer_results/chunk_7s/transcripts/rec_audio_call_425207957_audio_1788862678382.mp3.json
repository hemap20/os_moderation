      "text": "ஹ"
    },
    {
      "t": "01:24",
      "text": "சொல்லுங்க"
    },
    {
      "t": "01:31",
      "text": "பேச நீங்க பேசுவீங்க கே"
    },
    {
      "t": "01:38",
      "text": "திருப்ப நீங்க நல்ல கேக்குற எப்ப"
    },
    {
      "t": "01:45",
      "text": "எப்படினாலும் ஓகேடா பராப்ளம் இல்ல"
    },
    {
      "t": "01:52",
      "text": "உஷ மூடா இருக்கு"
