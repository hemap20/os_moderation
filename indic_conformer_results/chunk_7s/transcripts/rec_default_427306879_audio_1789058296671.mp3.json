    },
    {
      "t": "00:49",
      "text": "చె మీరే"
    },
    {
      "t": "00:56",
      "text": "వ సకాల చే తర"
    },
    {
      "t": "01:03",
      "text": "ఎాలి ఎ పం"
    },
    {
      "t": "01:10",
      "text": "ఇం చేసినర్ చేయపోతాయి మళ్ళీ చేయకపోతాయి"
    },
    {
      "t": "01:17",
      "text": "ఏేను నిశ్చయిస్తాము"
    },
    {
      "t": "01:24",
      "text": "చేస్తారా ఫలాన్ చేయ"
    },
    {
      "t": "01:31",
      "text": "నే ఇ నమ్మడించే లేకపోట్టలేదు"
    },
    {
      "t": "01:38",
      "text": ""
    }
