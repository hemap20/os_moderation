    {
      "t": "00:00",
      "text": "ஹ்"
    },
    {
      "t": "00:07",
      "text": "சென்னையில இருந்து போயி சொல்லுங்க"
    },
    {
      "t": "00:14",
      "text": "நான்"
    },
    {
      "t": "00:21",
      "text": "ட்டு ச"
    },
    {
      "t": "00:28",
      "text": "ஆள் இருக்காங்களா ெட பொண்ணு முடிக்க"
    },
    {
      "t": "00:35",
      "text": "இந்த முக பாக்கே"
    },
    {
      "t": "00:42",
      "text": "ஹலோ எந்த ஒரு"
    },
    {
      "t": "00:49",
      "text": "செடனை நீ"
    },
    {
      "t": "00:56",
      "text": "உஹம் ச கோய"
    },
    {
      "t": "01:03",
      "text": "கோயம்பத்தந்த உன ஒழுக்கல"
    },
    {
      "t": "01:10",
      "text": "புரியல கோயம்ப"
    },
    {
      "t": "01:17",
      "text": "கோயம்புத்தூர்ல வந்து ரேக் பண்ணீங்கன்னா உங்க கில புடிச்சு போட்டுருவாங்க"
    },
    {
      "t": "01:24",
      "text": "பொண்ணே பண்ண ய ஒண்ணு பண்ணண்ண"
    },
    {
      "t": "01:31",
      "text": "என்னைய ஏன் பழனுச்சன்ன இல்லாம பண்ண கூடாது அது"
    },
    {
      "t": "01:38",
      "text": "என்ன சரக்குக்கு சரக்கு சரக்கு மாசாவா"
    },
    {
      "t": "01:45",
      "text": "ரெண்டு அடி மிக்ஸ் ஆகி வயிற் கலக்குறதுக்கா சரக்கு மாசா"
    },
    {
      "t": "01:52",
      "text": "ப அடிக்க நீ சொல்ல"
    },
    {
      "t": "01:59",
      "text": "அதா வறண்டா செவனா"
    },
    {
      "t": "02:06",
      "text": "அறம் மட் பண்ணும் போடிக்கும்"
    },
    {
      "t": "02:13",
      "text": "எத்தி ஐம் நாள் ரெடி ஆள் இருக்கு"
    },
    {
      "t": "02:20",
      "text": "ஏ"
    },
    {
      "t": "02:27",
      "text": "என்னடி என்ன கொண்டு வ உ"
    },
    {
      "t": "02:34",
      "text": "ண்டே ஆன அப்பல்லாம் பேசுறாங்க"
    },
    {
      "t": "02:41",
      "text": "உம்"
    },
    {
      "t": "02:48",
      "text": "புங்களா வீங்களா"
    },
    {
      "t": "02:55",
      "text": "பே பண்ணங்களா நம்பர் நோட் பண்ணிக்க"
    },
    {
      "t": "03:02",
      "text": "செவன்"
    },
    {
      "t": "03:09",
      "text": "தீ ந சிக் எிட்"
    },
    {
      "t": "03:16",
      "text": "ஒன் நைன் நைன் த்ரீ"
    },
    {
      "t": "03:23",
      "text": "ஒப்ப தரன"
    },
    {
      "t": "03:30",
      "text": "பேர் தாரணி தாரணி தாரணி தாரணி"
    },
    {
      "t": "03:37",
      "text": ""
    },
    {
      "t": "03:44",
      "text": ""
    },
    {
      "t": "03:51",
      "text": ""
    },
    {
      "t": "03:58",
      "text": ""
    },
    {
      "t": "04:05",
      "text": "ல்ல காணது"
    },
    {
      "t": "04:12",
      "text": "மத்தசியா வரல"
    },
    {
      "t": "04:19",
      "text": "உம் சரி என்ன ஒர்க் பண்றீங்க"
    },
    {
      "t": "04:26",
      "text": "உ"
