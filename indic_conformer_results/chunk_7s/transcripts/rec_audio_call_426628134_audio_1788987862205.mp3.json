{
  "file_id": "rec_audio_call_426628134_audio_1788987862205.mp3",
  "language": "kannada",
  "chunk_seconds": 7.0,
  "decoding": "ctc",
  "audio_duration_sec": 891.995,
  "processing_time_sec": 17.451293230056763,
  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ ಹ"
    },
    {
      "t": "00:07",
      "text": "ನೀವು ಹ್ಮ ನಿಮ್ಮ ಹೆಸರು"
    },
    {
      "t": "00:14",
      "text": ""
    },
    {
      "t": "00:21",
      "text": "ಮಾಡ್ತಾಿದ್ದೀರ ನಾನು ಅಷ್ಟೇ ಮಲ್ಕೊಂಡಿದ್ದೆ"
    },
    {
      "t": "00:28",
      "text": "ಊಟ ಆಯ್ತಾರ ಆಯ್ತು"
    },
    {
      "t": "00:35",
      "text": "ನ ದ ಬದಿಲ್ಲ"
    },
    {
      "t": "00:42",
      "text": "ಎಕ್ಕೆೆ"
    },
    {
      "t": "00:49",
      "text": "ಹ್ಮ ವಾಯ್ಸ್ ಕೇಳಿಸತಿಲ್ಲ"
    },
    {
      "t": "00:56",
      "text": "ಗೊತ್ತಿಲ್ಲ ಸುಮ್ಮನೆ ಬತ್ತಿಲ್ಲ ಅ ಹ್ಮ್ ಹ್ಮ್ ಏನಾದ್ರೂ ರೊಮ್ಯಾಂಟಿಕ್ಂಗ ಮಾತಾಡ್ಬೋದಾ"
    },
    {
      "t": "01:03",
      "text": "ಎಂದ ಸಕುಲಿನ್"
    },
    {
      "t": "01:10",
      "text": "ಣ ಹ್ಮ ಹ"
    },
    {
      "t": "01:17",
      "text": "ಎಷ್ಟುಬ ಸೈಜ ನು ಬರ್ತೀನಿ ಸೀರೆ"
    },
    {
      "t": "01:24",
      "text": "ಕಕತಯ ಯಾವ ಕಲರ್ ಸೀರೆ ಆಗ್ತತಿ"
    },
    {
      "t": "01:31",
      "text": "ಹ್ಮ ಏನ್ ತೌದು"
    },
    {
      "t": "01:38",
      "text": "ಯಾರೋ ಕಿರ್ಚತ್ರಿಂದಿಂದ"
    },
    {
      "t": "01:45",
      "text": "ಸುಮ್ಮತ್ರಸಪಗೆ ನನ"
    },
    {
      "t": "01:52",
      "text": "ಯಾವ ಸೀರೆ ಕಟ್ಕೊಂತಯ ಸೀರೆ"
    },
    {
      "t": "01:59",
      "text": "ಬೇಕ ಹ್ಮ ಇಷ್ಟ"
    },
    {
      "t": "02:06",
      "text": "ಸರಿಯ್ತ ಯಾವ ಕಲರ್ ಕಟ್ಕೊಂತಯ"
    },
    {
      "t": "02:13",
      "text": "ಸೂರ್ ಬಪಿ ಡೋರ್ ಓಪನ್ ಮಾಡಿ ಬಂದೆ"
    },
    {
      "t": "02:20",
      "text": "ಏನ್ ಸಕ ಕಾಣಿಸ್ತಬ"
    },
    {
      "t": "02:27",
      "text": "ಹಗೆ ನೀನ್ ಎತ್ಕೊಂಡೋಗಿ ಬೆಡ್್ಮೇಲ್ ಕೂರ್ಸಿ ರೂಮ್ೋರ್ ಹಾಕ್ತೀನಿ"
    },
    {
      "t": "02:34",
      "text": "್ಮ ಮಾಲ ಸಿ"
    },
    {
      "t": "02:41",
      "text": "ನೋಟಿ ಹತ್ರಲ್ಲಾ ಕೀಸ್ ಮಾಡ್ತೀನಿ ಹ್ಮ"
    },
    {
      "t": "02:48",
      "text": "ಹಾಗೆಚೂೆನ್ಸಿ ಜರಗಸ್ಬಿಟ್ಟು"
    },
    {
      "t": "02:55",
      "text": "ನೀನ್ ಮಕ್ಕಳತ್ರಲ್ಲ ಗೀಸ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "03:02",
      "text": "ಸಕ್ಕ ಕಡಿ"
    },
    {
      "t": "03:09",
      "text": "ಏನ್ ಮಾಡೋದ್ಿಷ್ಟ ನಿಂಗೆ ಹ ಏನ್ ಮಾಡೋದ್ ಇಷ್ಟ ನಿಂಗೆ"
    },
    {
      "t": "03:16",
      "text": "ನನಗ ಎಲ್ಲಾನು ಬೇಬಿ"
    },
    {
      "t": "03:23",
      "text": "ಹ ನೀನು ನೀನು ಕಲತ್ರೆ ುಪ್ಪಕಿ ಫುಲ್ ಟೇಸ್ಟ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "03:30",
      "text": "ಎ ಬಬ"
    },
    {
      "t": "03:37",
      "text": "ಅಂಗಗೆ ತಪ್ಪೊಂಡ ನಿನ್ನನ್ನೆ"
    },
    {
      "t": "03:44",
      "text": "ತಪ್ಕೊಂಡು ನಿನ್ ಕತ್ತತ್ರ ಎಲ್ಲ ಕಿಸ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "03:51",
      "text": "ಡು ಹ್ಮಬ ಕೇಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿಡು"
    },
    {
      "t": "03:58",
      "text": "ಕೊಡ್ತಾ ಇದ್ದೀನಿ ನಂಗೆ ನಿನ್ ಮುಖನ ತಿರುಗಸಿ ನಿನ್ ಲಿಪ್ಸ್ ನಲ್ಲ ಟೇಸ್ಟ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "04:05",
      "text": "ಿಸಡ ತ ಸಟ"
    },
    {
      "t": "04:12",
      "text": "ನೀನು ಕೊಡು"
    },
    {
      "t": "04:19",
      "text": "ಸ್ಪ್ ಚಟ್ ಯೂಸ್ ಮಾಡ್ತಿದ್ದಯಾ"
    },
    {
      "t": "04:26",
      "text": "ನೀನ್ನ ನೋಡ್ಬೇಕನ್ಸುತ್ತಿದೆಬಿ ನಾನ ನುಡ್ತರು"
    },
    {
      "t": "04:33",
      "text": "ಸರಿ ಬಬಿ ಕಿಸ ಕೊಡು"
    },
    {
      "t": "04:40",
      "text": "ಹಕ್ಕ ಬಿಟೆು"
    },
    {
      "t": "04:47",
      "text": "ನೀ ಪಲ ನಮ್ಮೇ ತ ದದು"
    },
    {
      "t": "04:54",
      "text": "ನೀನ್ ಕ್ಜ್ ಹತ್ರ ಎಕಸ್ ಮಾಡ್ತೀನಿ ಬ್ಲೌಸ್ ಮೇಲೆ"
    },
    {
      "t": "05:01",
      "text": "ಬಬಿ ಮಾಡ್ತಾ ಇದೀನಿ ನಿಲಿ"
    },
    {
      "t": "05:08",
      "text": "್ ಹತ್ರ ಇಲ್ಲ ನೀನ್ ಬ್ಲೌಸ್ ನ ಮೆತ್ತ ಬಚ್ತೀನಿ ಒಂದೊಂದ"
    },
    {
      "t": "05:15",
      "text": "ಹಕ್ ಬಿನ ಬ್ಲೌಸ್ ಬಿಸಕ"
    },
    {
      "t": "05:22",
      "text": "ಕೈ ಎತ್ತೀನಿ ನಾನು ಅರಾಮ್ಸ್ನೆಲ್ಲ ಕೀಸ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "05:29",
      "text": "ಹ ಸಕ್ಕ ಆಿದೆ ಬ ಹ"
    },
    {
      "t": "05:36",
      "text": "ನೀನ್ ನಂಡುರಾಮ್ಸತಲ್ಲ ಕಿಸ್ ಮಾಡ್ತಿದ್ದೀನಿ ಅಂದೆ ಹ್ಮ್"
    },
    {
      "t": "05:43",
      "text": "ನಿನ್ನ ತಪ್ಿಕೊಂಡು"
    },
    {
      "t": "05:50",
      "text": "ನಿ ಬ ಒಲ ಕಡೆ ಕೈ ಹತಿ ನೀ"
    },
    {
      "t": "05:57",
      "text": "ಹ್ಮ್ ಹೇಳಕ್ಕೆ ನಿನ್ ್ರಾವಲ್ಗಡೆ ಕೈ ಹಾಕ್ತೀನಿ ಅಂದೆ"
    },
    {
      "t": "06:04",
      "text": "ಇಬಿ ಹ ಬಬಿ"
    },
    {
      "t": "06:11",
      "text": "ಕೊಡು ನ್ ಮಾಡ ಫುಲ್ ಸಪ್ ಮಾಡಿ ಪ್ರೆಸ್ ಮಾಡ್ತನಿ"
    },
    {
      "t": "06:18",
      "text": "ಇ ಬರಾನ ಮತಗ ಬಿಚ"
    },
    {
      "t": "06:25",
      "text": "ನೀನ್ ಬ್ರಾಣ ಬಿಸಾಕಿ ಒಂದ್ ಕೈಯಲ್ಲಿ ಪ್ರೆಸ್ ಮಾಡಿ ಇನ್ನೊಂದ್ ಕೈಯಲ್ಲಿ ಸಕ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "06:32",
      "text": "ಹ್ಮ್ ಸಟ್ಟ"
    },
    {
      "t": "06:39",
      "text": "ಏನು ಸ ಕ ಅಂತ ಕೇಳಿಸ್ತಾ ಇಲ್ಲ"
    },
    {
      "t": "06:46",
      "text": "ಸಕ್ಕತ್ಾಗಿದೆ ಕ ನಿ ಪಲ್ಸ್ ಕಚ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "06:53",
      "text": "ಸಕ್ಕದಾಗಿತೆ ಕಣ"
    },
    {
      "t": "07:00",
      "text": "ಚೀಪ್ತಾ ಇದ್ದೀನಿ ಟ್ವೆಂಟಿ ಸಿಕ್ಸ್"
    },
    {
      "t": "07:07",
      "text": "ಮ ಅರ್ತಿ ಚಾನ್ಸ ಕೊಡ ನೀನ"
    },
    {
      "t": "07:14",
      "text": "ಹ್ಮ ಹ ಸ"
    },
    {
      "t": "07:21",
      "text": "ದಾಗಿದೆ ಬಬಿ ನಿಂದ ಯಾವಾದರುೂ ಜೀಪ ಅವರ"
    },
    {
      "t": "07:28",
      "text": "ಹ್ಮ ಹ್ಮ ಇಲ್ಲ ನಾನೇ ಫಸ್ಟ"
    },
    {
      "t": "07:35",
      "text": "ನಿ ಪಲ್ಸ್ನೆಲ್ಲ ಕಚ್ತಾ ಇದ್ದೀನಿ ಹ್ಮ್"
    },
    {
      "t": "07:42",
      "text": "ನಿಬ ಕರ್ಚತ ನೀ"
    },
    {
      "t": "07:49",
      "text": "ಹ್ಮ ಸ ಕದಾಗದೆ ಕಡೆ"
    },
    {
      "t": "07:56",
      "text": "ಹೇಬಿ ನೀನ್ೇನ್ ಮಾಡ್ತೀಿ ನಂಗೆ"
    },
    {
      "t": "08:03",
      "text": "ನೀನ್ ನ್ ಮಾಡ್ತ ಹೇಳು"
    },
    {
      "t": "08:10",
      "text": "ಕೊಡು ಮೆ"
    },
    {
      "t": "08:17",
      "text": "ಹ್ಮಲೋ"
    },
    {
      "t": "08:24",
      "text": "ಹ್ಮ"
    },
    {
      "t": "08:31",
      "text": "ಹ ತಗೊ ಮತ್ತೆ ಎಷ್ಟತ"
    },
    {
      "t": "08:38",
      "text": "ಸಿಕ್ಸ"
    },
    {
      "t": "08:45",
      "text": "ಟ ಮಾಡ ಮಾಡ್ತ ಹ್ಮ ಸೌಂಡ್ ಮಾಡು"
    },
    {
      "t": "08:52",
      "text": "ತ್ತ"
    },
    {
      "t": "08:59",
      "text": "ಕತಿ ಹ"
    },
    {
      "t": "09:06",
      "text": "ಮಗೆ"
    },
    {
      "t": "09:13",
      "text": "ಮೆು ಮಾಡುವ"
    },
    {
      "t": "09:20",
      "text": "ನಿನ್ ಗಂಟ್ಲು ತನಕ ಹೋಗುತ್ತೆ ಹ್ಮ್"
    },
    {
      "t": "09:27",
      "text": "ಹಲೋ"
    },
    {
      "t": "09:34",
      "text": "ಏನ್ ಮಾಡ್ತಿದ್ಯಾಗೆ ಬರ್ತಾ ಇಲ್ಲ"
    },
    {
      "t": "09:41",
      "text": "ಚನ್ನ ಹ್ಮ್"
    },
    {
      "t": "09:48",
      "text": "ಿದ್ರೆ ಚೆನ್ನಾಗಿರ್ತಿತ್ತು ಹ್ಮ ಇನ್ನನ್ ಗಂಟ್ಲು ತನಕ ಹೋಗುತ್ತೆ ನೋಡು"
    },
    {
      "t": "09:55",
      "text": "ಹಾ ನಿಮ್ಮ ಹಾಕಿದೀನಲ್ಲ ಫುಲ್ ಬಾಯಲ್ಲಿ"
    },
    {
      "t": "10:02",
      "text": "ಹತ"
    },
    {
      "t": "10:09",
      "text": "ಹ"
    },
    {
      "t": "10:16",
      "text": "ಹಾಗಗೆ"
    },
    {
      "t": "10:23",
      "text": "ಎಸ್ ಮ ತಮ"
    },
    {
      "t": "10:30",
      "text": "ಹಾ ಮೆತ್ತಗೆ"
    },
    {
      "t": "10:37",
      "text": "ಹ ಕಪ"
    },
    {
      "t": "10:44",
      "text": "ಹಾ"
    },
    {
      "t": "10:51",
      "text": "ನ ಬೂಟ್ಸ್ ಪ್ರೆಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ ಹ್ಮ"
    },
    {
      "t": "10:58",
      "text": "ಮಾಡ್ತಾಿದ್ದೀನಿ ಎರಡು ಬುಕ್ಸ್ ನಟ್ಕೊಂಡು ಗಟ್ಟಿಯಾಗೆ"
    },
    {
      "t": "11:05",
      "text": "ನಿನ್ ನಿನ್ನ ನೀನು ಕಲತ್ರಲ್ಲ ಗೀಸ್ ಮಾಡ್ತಾ್ದೀನಿ"
    },
    {
      "t": "11:12",
      "text": "ಮೆತ್ತ ಕೆ ಚೀರೆ ಮೆತ್ತಕನ್ನ ಚೀರ ಬಿಚ್ಚಿ"
    },
    {
      "t": "11:19",
      "text": "ನಿನ್ ಕಾಲ ಹತ್ರಿಂದಲ್ಲಾ ಕೀಸ್ ಮಾಡ್ಕೊಂಡ್ ಬರ್ತೀನಿ ನಿನ್ ತೊಡೆ ಹತ್ರ ಎಲ್ಲ"
    },
    {
      "t": "11:26",
      "text": "ಕಸ್ ಮಾಡ್ತೀನಿ ಹ"
    },
    {
      "t": "11:33",
      "text": "ಹಲೋ ನೀನು ತೊಡೆ ಹತ್ರ ಎಲ್ಲ ಕಸ್ ಮಾಡ್ತೀನಿ ಅಂತೆ"
    },
    {
      "t": "11:40",
      "text": "ಸಕ್ಕತ ಕಡೆ"
    },
    {
      "t": "11:47",
      "text": "ಹ್ಮ ನೀನ್ ಪ್ಯಾಂಟಿ ಮೇಲೆ"
    },
    {
      "t": "11:54",
      "text": "ಕಸ್ ಮಾಡ್ತೀನಿ ಮತ್ತನ್ ಪ್ಯಾಂಟಿ ಬಿಚ್ಚಿ"
    },
    {
      "t": "12:01",
      "text": "ಇನ್ನೆರಡು ಕಾಲನು ನನ್ು ಬೂಜಿದ್ಮೇಲೆ ಹಾಕ್ಕೊಂಡು"
    },
    {
      "t": "12:08",
      "text": "ಮತ್ತ ಪುಷ್ಪಲ ಅವಲ್ಲ ಕಡೆ"
    },
    {
      "t": "12:15",
      "text": "ಿಸಾಲ"
    },
    {
      "t": "12:22",
      "text": "ಹಕುುಿಿ ಆಮೇ"
    },
    {
      "t": "12:29",
      "text": "ಮಾಡ್ತೀನಿ ಇವಾಗ ಡೈರೆಕ್ಟ್ ಸಲಹ್ ಹಾಕು"
    },
    {
      "t": "12:36",
      "text": "ಹಬ ಮ ಮ ಕಾಪತಿ"
    },
    {
      "t": "12:43",
      "text": "ಪ ಇಷ್ಟ"
    },
    {
      "t": "12:50",
      "text": "ಟನ"
    },
    {
      "t": "12:57",
      "text": ""
    },
    {
      "t": "13:04",
      "text": "ಧತ"
    },
    {
      "t": "13:11",
      "text": "ಹೋಗ್ತಾನ ಇಿಲ್ಲ ಅರ್ಧಾ ಹಯ್ತು ಮ ಬಿ"
    },
    {
      "t": "13:18",
      "text": "ಅ ನಾವತು"
    },
    {
      "t": "13:25",
      "text": "ಅ ಅಸಲ ಮಾಡಚ ಹ"
    },
    {
      "t": "13:32",
      "text": "ತೊಳ್ತಾ ಇದ್ದೀನಿ ಮೆತ್ತಗೆ ಆಯ್ತಾ"
    },
    {
      "t": "13:39",
      "text": "ತುಂಬ ಬೂಫುಲ್ ಆಯ್ತು ನಿಂಚಸ್ ಮಾಡ ಹೆಚ್ಚಾಗಗ್ತಿದೆ"
    },
    {
      "t": "13:46",
      "text": "ಹ ಸಕ್ಕತ್ಾಗಿದೆಫಲ್ಟಟ್ೆ"
    },
    {
      "t": "13:53",
      "text": "ತ್ ಮತ್ತಗಿ ಮತ್ತೆ ಹಗ್ತನಿ ಒಳಗಡೆ"
    },
    {
      "t": "14:00",
      "text": "ಪಕ್ಕದಾಗಿದ ಕಡೆ ಆಗ್ತಿದ್ದನಿ"
    },
    {
      "t": "14:07",
      "text": "ಆಪ ಕಮಲ್"
    },
    {
      "t": "14:14",
      "text": "ಎ ಅ ಚ ಎ ಸಬ್ಾಗಿ"
    },
    {
      "t": "14:21",
      "text": "ು ಮಾಡ್ತಾ್ದೀನಿ"
    },
    {
      "t": "14:28",
      "text": "ಎಸ್ ಬೇಬಿ ಐ ಎ್ ಡೂಯಿಂಗ್ ಇಟ್ ಎಸ್ ಬೇಬಿ"
    },
    {
      "t": "14:35",
      "text": "ಆಮ ೂೈಂಗ ಇಟ್ ಕ್ರ"
