    {
      "t": "00:07",
      "text": "ஹலோ ஏ கேட்க மாட்டதுங்க நீங்க பேசல"
    },
    {
      "t": "00:14",
      "text": "உம் எங்கந்து பேசுறீங்க கக்க"
    },
    {
      "t": "00:21",
      "text": "உ ந பெங்கூர் ந சிங்கல்"
    },
    {
      "t": "00:28",
      "text": "ங்க கேக்க மாட்டேு கிட்டச்ச பேசுங்க"
    },
    {
      "t": "00:35",
      "text": "எவளோ நாள் எ போயட்டு இருக்கேன்"
    },
    {
      "t": "00:42",
      "text": "எப்படி பேசிருக்கேன் எப்படி பேசினா படிக்கும் கேக்கல"
    },
    {
      "t": "00:49",
      "text": "ஹலோ கிட்ட கிட்ட வச்சு"
    },
    {
      "t": "00:56",
      "text": "பேச பே ஏக்க"
    },
    {
      "t": "01:03",
      "text": "மட்ட காதல வச்சு பேச உ"
    },
    {
      "t": "01:10",
      "text": ""
    },
    {
      "t": "01:17",
      "text": "எப்படி பேசிருக்கேன் எப்படி பேசல எப்படி"
    },
    {
      "t": "01:24",
      "text": "பேசிருக்க எப்ப பே படி பண்ணிருக்கீங்கள"
    },
    {
      "t": "01:31",
      "text": "ரீசச்சு எப்போ பண்ணீங்க"
    },
    {
      "t": "01:38",
      "text": "அந்த மாிர இல்ல பண்ணதே இல்லையா"
    },
    {
      "t": "01:45",
      "text": "கேக்கல அந்த மாதிர பண்ண ர நாு ஏன் அவரு எங்க ஹஸ்பண்ட"
    },
    {
      "t": "01:52",
      "text": "அப்போ என்ன பண்றீங்க கண்ட்ரோல் பிங்கரிங் வீடியோஸ்"
    },
    {
      "t": "01:59",
      "text": "து சமால வ பேச உம் என்ன சைஸ் நப்பல்"
    },
    {
      "t": "02:06",
      "text": "என் கட்டல க"
    },
    {
      "t": "02:13",
      "text": "க்கலாம்"
    },
    {
      "t": "02:20",
      "text": "பன் பண்ணட்டன்"
    },
    {
      "t": "02:27",
      "text": ""
    }
