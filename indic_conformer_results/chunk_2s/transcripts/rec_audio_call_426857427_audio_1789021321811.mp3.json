    },
    {
      "t": "00:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": "ಹಲೋ ಹ"
    },
    {
      "t": "00:06",
      "text": "ಹ"
    },
    {
      "t": "00:08",
      "text": "ಸೀನಾ"
    },
    {
      "t": "00:10",
      "text": "ಪನಿ ಮಶರು"
    },
    {
      "t": "00:12",
      "text": "ಜ ಹಕ"
    },
    {
      "t": "00:14",
      "text": "ಯಾವ ಊರು"
    },
    {
      "t": "00:16",
      "text": "ಬ್ಯಾಂಗ್ಳೂರ್ ನಿಮ್ದು"
    },
    {
      "t": "00:18",
      "text": "ನಂತು ಬ್ಯಾಂಗ್ಳೂರ್"
    },
    {
      "t": "00:20",
      "text": "ಹನ್ ನಿತಿ"
    },
    {
      "t": "00:22",
      "text": "ಏನನು"
    },
    {
      "t": "00:24",
      "text": "ಏನ್ ಮಾಡ್ಕೊಂಡ"
    },
    {
      "t": "00:26",
      "text": "ನಾನು ಬ್ಯಾಂಕಲ್ಲಿರ"
    },
    {
      "t": "00:28",
      "text": "ಬರ್ತೀನಿ ನೀವು"
    },
    {
      "t": "00:30",
      "text": "ಯಾವ ಬ್ಯಾಂಕು"
    },
    {
      "t": "00:32",
      "text": "ಬಂಧನ್ ಬ್ಯಾಂಕು"
    },
    {
      "t": "00:34",
      "text": "ಹ ಆಯ್ತಾ ಆಯ್ತ"
    },
    {
      "t": "00:36",
      "text": "ನಾನು ಜನ ಸ್ಮಾಲ್ ಫಿನಾನ್ಸ್"
    },
    {
      "t": "00:38",
      "text": "ಭಯಕರ ಬಷ ಮಾಡಳ್ಳದು"
    },
    {
      "t": "00:40",
      "text": "ಕ"
    },
    {
      "t": "00:42",
      "text": "ಕಡೆ ಇದು"
    },
    {
      "t": "00:44",
      "text": "ಆರ್ಪುರಂ"
    },
    {
      "t": "00:46",
      "text": "ನೀವ ಇರೋದು"
    },
    {
      "t": "00:48",
      "text": "ಹ"
    },
    {
      "t": "00:50",
      "text": "ಓರ್ಮಂಗಾ ಓಕೆ"
    },
    {
      "t": "00:52",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "00:54",
      "text": "ಮತ್ತ ಿಕಣ ಆಯತ"
    },
    {
      "t": "00:56",
      "text": "ಕೆಲಸಲ್ಲ ಆಯ್ತ"
    },
    {
      "t": "00:58",
      "text": "ನಿಮದ ಆಯ್ತ"
    },
    {
      "t": "01:00",
      "text": "ಹ್ಮ ನಂದಾಯ್ತು"
    },
    {
      "t": "01:02",
      "text": "ಇವತ್ ಹೋಗಿಲ್ವಾ ನೀೈವಾ"
    },
    {
      "t": "01:04",
      "text": "ಇವತ್ತು ಲವಲ್ಲ ಇದ್ದೆ ನೀನು"
    },
    {
      "t": "01:06",
      "text": "ನಾನು ಅಷ್ಟೆ"
    },
    {
      "t": "01:08",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:10",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:12",
      "text": "ಮತ್ತಏನ್ ಸಮಾಚಾರಾ"
    },
    {
      "t": "01:14",
      "text": "ಹೇಳು ಹೋಗ್ತಿಲ್ಲ ನ"
    },
    {
      "t": "01:16",
      "text": "ಹ್ಮ ಸ"
    },
    {
      "t": "01:18",
      "text": "ಹೇಗ್ ನಡೀತಿದೆ ಕೆಲಸಾಲ"
    },
    {
      "t": "01:20",
      "text": "ಹ್ಮಲ್ಲ"
    },
    {
      "t": "01:22",
      "text": "ನಿಂದು"
    },
    {
      "t": "01:24",
      "text": "ನಮ್ಮದು"
    },
    {
      "t": "01:26",
      "text": ""
    },
    {
      "t": "01:28",
      "text": "ಲ್ಲ"
    },
    {
      "t": "01:30",
      "text": ""
    },
    {
      "t": "01:32",
      "text": "ನಿಮ್ಮ ಪ್ರಾಪರ್ ಇವರು"
    },
    {
      "t": "01:34",
      "text": "ಗೆ"
    },
    {
      "t": "01:36",
      "text": "ಇಲ್ಲಿ ಫ್ಯಾಮಿಲಿ ಮ್ಯೇಡ್ ನೀವವು"
    },
    {
      "t": "01:38",
      "text": "ಇಲ್ಲಪ್ಪ"
    },
    {
      "t": "01:40",
      "text": "ಪಜತ"
    },
    {
      "t": "01:42",
      "text": "ಹದ"
    },
    {
      "t": "01:44",
      "text": "ಹ"
    },
    {
      "t": "01:46",
      "text": "ನಾರಡ ನೀವು"
    },
    {
      "t": "01:48",
      "text": "ನಾನ್ ಮ್ಯಾರೀಜ ಅದ್ರಗ ಕೇಳನ"
    },
    {
      "t": "01:50",
      "text": "ಹ"
    },
    {
      "t": "01:52",
      "text": "ರ ವಸ"
    },
    {
      "t": "01:54",
      "text": "ನನ್"
    },
    {
      "t": "01:56",
      "text": "ಪಾಪರ್ ಬಂದ್ರು ನಂದು ಆಂಧ್ರ ಕಡೆ ಇ"
    },
    {
      "t": "01:58",
      "text": "ಬೇರೆ ಮ್ಯಾಜರ್ ಆಗಿದ್ದೀನಿ"
    },
    {
      "t": "02:00",
      "text": "ತೇವ"
    },
    {
      "t": "02:02",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:04",
      "text": "ಹ್ಮ ನೀ"
    },
    {
      "t": "02:06",
      "text": "ನಿ ಫ್ಯಾಮಿಲಿ ಅವರೆಲ್ಲ ಅಲ್ಲಿರದಾವ"
    },
    {
      "t": "02:08",
      "text": "ಹೌದು"
    },
    {
      "t": "02:10",
      "text": ""
    },
    {
      "t": "02:12",
      "text": "ನೀವೇನು ಪಸಿದದಾಾ"
    },
    {
      "t": "02:14",
      "text": "ಇಲ್ಲ ರೂಮ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀನಿ ಮುಂಚೆ"
    },
    {
      "t": "02:16",
      "text": "ವರ್ಕ್ ಮಾಡ್ತ್ ನಮ್ಮರಿಂದನ ಅಲ್ಲಿಂದ"
    },
    {
      "t": "02:18",
      "text": "ಪ್ರಮೋಷನ್ ಕೊಟ್ರು"
    },
    {
      "t": "02:20",
      "text": ""
    },
    {
      "t": "02:22",
      "text": "ಪ್ಯಾಕೇಜಿ ಬಸ್ನ್ನ ಕೊಟ್ಟಿದ್ದಾರಾ"
    },
    {
      "t": "02:24",
      "text": "ಹಾ ಚೆನ್ನಾಗಿದೆ ಇ"
    },
    {
      "t": "02:26",
      "text": "ತಿಪ ಬರುತ್ತೆ"
    },
    {
      "t": "02:28",
      "text": "ಸಾಕ್ಬಡಿ"
    },
    {
      "t": "02:30",
      "text": "ಲೀವ್ಗಳು ಇನ್ನೇನ್ ಚೆನ್ನಾಗೇ ಇರುತ್ತಾ ಬ್ಯಾಂಕ್"
    },
    {
      "t": "02:32",
      "text": "ರ್ಸಗೆ ಹೌದು"
    },
    {
      "t": "02:34",
      "text": "ಈ ಸ್ಯಾಟರ್ಡೆೇ ಸಂಡೆ ಮಂಡೇ"
    },
    {
      "t": "02:36",
      "text": "ಮುಡಸೆಗಲಿವು"
    },
    {
      "t": "02:38",
      "text": "ಹಂಗು ಅಷ್ಟೇ ನಾನು ನಾಳೆ ಊರಿಗೆಗ್ ಹೋಗ್ತನೆ"
    },
    {
      "t": "02:40",
      "text": "ಹ ಓಕೆ"
    },
    {
      "t": "02:42",
      "text": "ಹ್ಮ"
    },
    {
      "t": "02:44",
      "text": "ಎಷ್ಟ ದಿನ ಆಯತು"
    },
    {
      "t": "02:46",
      "text": "ಯಸ್ ಮಾಡ ಶ ಮಾಡಿ"
    },
    {
      "t": "02:48",
      "text": "ನಾನ್ ನಿೆನ್ನೆ ಬಂದೆ ಒಬ್ಬನೇ ಇರ್ತೀಿ ಮಂಗ"
    },
    {
      "t": "02:50",
      "text": "ಯಾರ ಪೆನ್ಸ ಆಗ್ತರಂತ ಬಂದೆ"
    },
    {
      "t": "02:52",
      "text": "ನಾನ್ ಬಂದು್ ಒಂದ ಮಂದತ್ ಆಯ್ತಿ ಇಲ್ಲಿ ಬೆಂಗ್ಳೂರ್ಗೆ"
    },
    {
      "t": "02:54",
      "text": "ಅಷ್ಟೇನಾ"
    },
    {
      "t": "02:56",
      "text": "ಹಾ ಹ"
    },
    {
      "t": "02:58",
      "text": "ಹಾ ಚೆನ್ನಾಗಿ ಅನ್ಸ್ತಿದ್"
    },
    {
      "t": "03:00",
      "text": "ಏನಲು"
    },
    {
      "t": "03:02",
      "text": "ಬೆಂಗಳೂರು ಚೆನ್ನಾಗಿದೆನ್ನಸ್ತಾ"
    },
    {
      "t": "03:04",
      "text": "ಆಕ್ಚುಲಿ ಹೊಸ ಊರಲ್ವಾ"
    },
    {
      "t": "03:06",
      "text": "ಪಚಸ್ ಾ ಬ"
    },
    {
      "t": "03:08",
      "text": "ಲ್ವಾರ ನನ"
    },
    {
      "t": "03:10",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "03:12",
      "text": "ಆನ್ತ್ತೇ ಬಿೇಡಿ ತರಾ ಕೆಸದು"
    },
    {
      "t": "03:14",
      "text": "ಬೆಂ್ಗಳೂರು ತುಂಬಾ ಚೆನ್ನಾಗಿದೆ"
    },
    {
      "t": "03:16",
      "text": "ಎಲ್ರಿಗೂ ಅಡ್ಜಸ್ಟ್ ಆಗತಿ"
    },
    {
      "t": "03:18",
      "text": "ನೀ ಒಜಿನಯಿತ ಪ"
    },
    {
      "t": "03:20",
      "text": "ನಾ"
    },
    {
      "t": "03:22",
      "text": "ನ ಬೆಂಗ್ಗಳೂರ್ ಬಂದ್ ಮೂರ್ ವರ್ಷ ಆಯ್ತು"
    },
    {
      "t": "03:24",
      "text": "ಓ ಓಕೆ"
    },
    {
      "t": "03:26",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "03:28",
      "text": "ಹ್ಮ"
    },
    {
      "t": "03:30",
      "text": "ಮತ್ತ ಈ ಪಂದಲಿ ಬಲಗೆ"
    },
    {
      "t": "03:32",
      "text": "ದಸೆ ಮಾಡ್ದ"
    },
    {
      "t": "03:34",
      "text": ""
    },
    {
      "t": "03:36",
      "text": "ಆ ನ"
    },
    {
      "t": "03:38",
      "text": "ಹೌದು"
    },
    {
      "t": "03:40",
      "text": "ಹೌಡ್ ಎಲ್ಲ"
    },
    {
      "t": "03:42",
      "text": "ಸಟಸ"
    },
    {
      "t": "03:44",
      "text": "ಸತ್ತ ಆಗ್ಬೇಕು ಸತ್"
    },
    {
      "t": "03:46",
      "text": "ಮಾಡ್ಕೊಬೇಕು ನಾವೇ"
    },
    {
      "t": "03:48",
      "text": "ಇಲ್ಲ ಏನ್ ಗೊತ್ತಾ ಬೆಂಗ್ಳೂರ್ ಬೇಸ"
    },
    {
      "t": "03:50",
      "text": "ಜಾಸ್ತಿ ಆಂಧ್ರ ಪಿಜ"
    },
    {
      "t": "03:52",
      "text": "ಇರೋದಾ ಫುಡ್ಲ್ಲ"
    },
    {
      "t": "03:54",
      "text": "ಅಸ್ಟ್ ಆಗಾನ ಇರುತ್ತೆ"
    },
    {
      "t": "03:56",
      "text": "ಅೇ ಆಂಧ್ರ"
    },
    {
      "t": "03:58",
      "text": "ನಮ್ದು ಆಂಧ್ರ ಅಲ್ಲ ಕರ್ನಾಟಕ ಬಾರ್ಡರ್"
    },
    {
      "t": "04:00",
      "text": "ಯಾವ ಊರು"
    },
    {
      "t": "04:02",
      "text": "ಇ ಕಡೆ"
    },
    {
      "t": "04:04",
      "text": "ಇಜ ಪಡೆ ಕಮಜ ಕುಪ್ಪ"
    },
    {
      "t": "04:06",
      "text": ""
    },
    {
      "t": "04:08",
      "text": "ೈ ಆ"
    },
    {
      "t": "04:10",
      "text": "ಕಲಾರಾ"
    },
    {
      "t": "04:12",
      "text": "ಕೋಲಾರ ಸೈಡಾ"
    },
    {
      "t": "04:14",
      "text": "ಕಲಾರ ಮತ್ ಆಗಲ"
    },
    {
      "t": "04:16",
      "text": "ನೈ್ಮ"
    },
    {
      "t": "04:18",
      "text": "ಹೌದು"
    },
    {
      "t": "04:20",
      "text": "ನಾನು ಫಸ್ಟ್"
    },
    {
      "t": "04:22",
      "text": "ಬೆಂಗಳೂರ್ ಬಂದಾಗ ಅಲ್ಲಿ ಕೋಲಾರತ್ರ"
    },
    {
      "t": "04:24",
      "text": "ಇದು ನಸರಾಪುರ"
    },
    {
      "t": "04:26",
      "text": "ಅದ ಒಂದು ಐಫೋನ್್ಯಾನುಫ್ಯಾಕ್ಚಂಗ್ ಕಂಪನಿ"
    },
    {
      "t": "04:28",
      "text": "ಅ ಗೊತ್ತ"
    },
    {
      "t": "04:30",
      "text": "ಹ್ಮ ಹ"
    },
    {
      "t": "04:32",
      "text": "ಉಸ್ರಾನ್ ಅಂತ ಇತ್ತು ಇವಾಗ"
    },
    {
      "t": "04:34",
      "text": "ಆಟಾ ಆದ"
    },
    {
      "t": "04:36",
      "text": ""
    },
    {
      "t": "04:38",
      "text": "ಹ್ಮ ಅಲ್ಲೇ ಫಸ್ಟ್ ನಾನು"
    },
    {
      "t": "04:40",
      "text": "ವರ್ಕ್ ಮಾಡಿದ್ದು"
    },
    {
      "t": "04:42",
      "text": "ಓಕೆ ಎಷ್ಟುಿನ ಮಾಡ್ತವಿ ನೀವು ಇಲ್ಲಿವರ್ಕೂ"
    },
    {
      "t": "04:44",
      "text": ""
    },
    {
      "t": "04:46",
      "text": "ಅಲ್ಲ ಅಲ್ಲೊಂದು"
    },
    {
      "t": "04:48",
      "text": "ಟೆನ್ ಮಂತ್ಸ್ ಮಾಡಿದೆ"
    },
    {
      "t": "04:50",
      "text": "ಸಿಕ್ಕಾಪಟ್ಟೆ ಕಷ್ಟ ಆಯ್ತು ಅಲ್ಲೆಲ್ಲ"
    },
    {
      "t": "04:52",
      "text": "ಲೀವ್ ಗಳು ಇರ್ತಾ ಇರ್ಲಿಲ್ವಾ ಬೇರೆ"
    },
    {
      "t": "04:54",
      "text": "ಕಡೆ ಇಟರ್ವ್ಯೂ ಕೊಡಕೂ ಆಗ್ತಿರ್ಲಿಲ್ಲ"
    },
    {
      "t": "04:56",
      "text": "ಅದಷ್ಟಕ್ಕ್ಬಟ್ಟಿದೆ"
    },
    {
      "t": "04:58",
      "text": "ಆಮೇಲೆ ಅಲ್ಲಿ ಬಿಟ್ಟು"
    },
    {
      "t": "05:00",
      "text": "ಹ್ಮ್ ಮತ್ತದೇ"
    },
    {
      "t": "05:02",
      "text": "ಬೆಂಗಳೂರು ಬಂದು ಒನ್ ವೀಕ್ ಅಲ್ಲಿ"
    },
    {
      "t": "05:04",
      "text": "ೊಂಡ ಬೇರೆ ಕಡೆ ಅಲ್ಲ"
    },
    {
      "t": "05:06",
      "text": "ಇಲ್ಲಿ ನಿ ನಿಿಂದೆ"
    },
    {
      "t": "05:08",
      "text": "ಗೋಡ್ ಲೋ"
    },
    {
      "t": "05:10",
      "text": "ಓ ಬೋಲ್ಲ್ಲ"
    },
    {
      "t": "05:12",
      "text": "ಓೆ ಕ್ಯಾಷಿನಸ್ ಸೇ"
    },
    {
      "t": "05:14",
      "text": "ಸರಿ ಸ ಸರಿ ಸ"
    },
    {
      "t": "05:16",
      "text": "ಸೊ ಮುಂಚೆ ಆಪರೇಷನ್ ಅಲ್ಲಿ ಮಾಡ್ತಿದೆ ಸಿ"
    },
    {
      "t": "05:18",
      "text": "ಕಾಪಟ್ಟೆ ಪ್ರೆಷರ್ ಕೊಡ್ತಾರೆ ಆ ಕಡೆ"
    },
    {
      "t": "05:20",
      "text": "ಸೇಲ್ಸ ಮಾಡ್ಬೇಕು ಆಪ್ರೇಷನ್ ನೋಡ್ಬೇಕು"
    },
    {
      "t": "05:22",
      "text": "ಕೋಬೇಕು ಅದಕ್ಕೆ ಇವಾಗ"
    },
    {
      "t": "05:24",
      "text": "ಸೇರಿಸಿದ ಸಂಪಾದ ಇಲ್ಲಿ"
    },
    {
      "t": "05:26",
      "text": "ಸಿಕ್ಸ್ ಮಂತ್ಸ್ ಆಯ್ತು ನನ್ಸ"
    },
    {
      "t": "05:28",
      "text": "ಜಾಯ್ನ್ ಆಗಿ"
    },
    {
      "t": "05:30",
      "text": "ಹಾ ಇದು ಸರಿ ಸರಿ ಮಾಡ್ತೀವಿ"
    },
    {
      "t": "05:32",
      "text": "ಹ್ಮ"
    },
    {
      "t": "05:34",
      "text": "ನಿಮಗೆ ಇನ್ಸೆಂಟಿವ್ ಎಲ್ಲ ಬರುತ್ತಲ್ವಾ"
    },
    {
      "t": "05:36",
      "text": "ಇ್ಮಸನ್ಂತವು ಬಾರ"
    },
    {
      "t": "05:38",
      "text": "ಇರುತ್ತೆ ಬಟ್ ಕಷ್ಟ"
    },
    {
      "t": "05:40",
      "text": "ನನ್ ಗೋಲ್ಡ್ ಲೋನ್ ಅಲ್ಲಿ ಮಾಡದುರು"
    },
    {
      "t": "05:42",
      "text": "ಅಂದ್ರೆ"
    },
    {
      "t": "05:44",
      "text": "ಲೊಕೇಶನ್ ಮೇಲ್ ಡಿಪೆಂಡ್ ಆಗುತ್ತೆ"
    },
    {
      "t": "05:46",
      "text": "ಮಂಗಲಸವರ್ ಕರಿಚೇರಿಯಾರ್ವಾ"
    },
    {
      "t": "05:48",
      "text": "ಹದು ಕ"
    },
    {
      "t": "05:50",
      "text": ""
    },
    {
      "t": "05:52",
      "text": "ಹ್ಮ"
    },
    {
      "t": "05:54",
      "text": "ಹ್ಮ"
    },
    {
      "t": "05:56",
      "text": "ನೀನು ಮತ್ತೆ"
    },
    {
      "t": "05:58",
      "text": "ಹೇಕ್ಕಿದೆ ನಾ"
    },
    {
      "t": "06:00",
      "text": "ಏನಿಲ್ಲಮ್ಮ"
    },
    {
      "t": "06:02",
      "text": "ನ್ ಎಲ್ಲ ಕಲ್ಲ"
    },
    {
      "t": "06:04",
      "text": "ಇ ಮಾಡ್ಕೊತಿದ್ದೀರಾ"
    },
    {
      "t": "06:06",
      "text": "ನ"
    },
    {
      "t": "06:08",
      "text": "ಫ್ಯಾಮಿಲಿ ಮಿಸ್ ಆಗುತ್ತೆ ಏನ ನ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "06:10",
      "text": "ಅವ ಪಸ್ಕ"
    },
    {
      "t": "06:12",
      "text": "ಮಾಡ್ಬೇಕಲ್ವಾ"
    },
    {
      "t": "06:14",
      "text": "ಇದು ಬ"
    },
    {
      "t": "06:16",
      "text": ""
    },
    {
      "t": "06:18",
      "text": "ಇದೆ ಪಾಪು ಇದೆ"
    },
    {
      "t": "06:20",
      "text": "ಹ"
    },
    {
      "t": "06:22",
      "text": "ಪಾಪಾ"
    },
    {
      "t": "06:24",
      "text": "ಕಂಡು"
    },
    {
      "t": "06:26",
      "text": ""
    },
    {
      "t": "06:28",
      "text": "ಬಂದಾಗಿಿಂದ ಹೋಗಿಲ್ವಾ"
    },
    {
      "t": "06:30",
      "text": "ಏನರ"
    },
    {
      "t": "06:32",
      "text": "ಬೆಂಗ್ಳೂರ್ ಬಂದಾರ್ನಿಂದ ಹೋಗಿಲ್ವ"
    },
    {
      "t": "06:34",
      "text": "ಹ್"
    },
    {
      "t": "06:36",
      "text": "ನಾನ ಕಾತ"
    },
    {
      "t": "06:38",
      "text": "ಟ್ಕೊಂಡನಿ ಯಾವಾಗ್ ಮುನ್ಸ್ ಬರ್ತ"
    },
    {
      "t": "06:40",
      "text": "ನ್ನ ಟ್ರೈನಂಗ"
    },
    {
      "t": "06:42",
      "text": "ಲ್ಲ ಹೋಗಲ್ಲ ತುಂಬಾ ಲೇಟ್ ಆಗುತ್ತ ಅ ಕ"
    },
    {
      "t": "06:44",
      "text": "ಹ್ಮ"
    },
    {
      "t": "06:46",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "06:48",
      "text": "ಅತ್ರ ನ"
    },
    {
      "t": "06:50",
      "text": "ಬಿ ಹೋಗ್ ಬರ್ಬಹುದು ರ್"
    },
    {
      "t": "06:52",
      "text": "ಅಲ್ವಾ ಈ ಕಡೆ ಸೈಡ್ ಎಲ್ಲಾ ಇದ್ದಿದೆ"
    },
    {
      "t": "06:54",
      "text": "ಅ ಸ್ವಲ್ಪ ಕಷ್ಟ ಆಗ್ತಿ"
    },
    {
      "t": "06:56",
      "text": "ಹೌದು ಹ್ಮ್"
    },
    {
      "t": "06:58",
      "text": "ಅಲ್ಲಿಂದ ಅಲ್ಲ"
    },
    {
      "t": "07:00",
      "text": "ಹೋಗ್ಬೋದು ಏನ್ ಅನ್ಸಲ್ಲ"
    },
    {
      "t": "07:02",
      "text": ""
    },
    {
      "t": "07:04",
      "text": ""
    },
    {
      "t": "07:06",
      "text": "ಮತ್ತೆ ಹೇಳಿ ಏನ್ ಸಮ"
    },
    {
      "t": "07:08",
      "text": "ನೀ"
    },
    {
      "t": "07:10",
      "text": "ಲ್ಲ"
    },
    {
      "t": "07:12",
      "text": "ಮತ್ತೆ ಊರ್ಗ ಹೋಗದು ನಾಳೆನ"
    },
    {
      "t": "07:14",
      "text": "ಹ್ಮ್ ನಾಳೆ ನಾಳೆ"
    },
    {
      "t": "07:16",
      "text": "ನಾಳೆ ಲೀವ್ ಇಲ್ಲ ನಾಳೆ ಹ"
    },
    {
      "t": "07:18",
      "text": "ಪರ್ಮಿಷನ್ ತಗೊಂಡು ಹೋಗ್ತಿ"
    },
    {
      "t": "07:20",
      "text": "ಹಾ ಹೋಗ ಸಾರದ"
    },
    {
      "t": "07:22",
      "text": "ಸಂಂಡೆ ಮಂಡೆ ಮಂಡೆ ಬರ್ತ"
    },
    {
      "t": "07:24",
      "text": "ಮಂಡನೆೇ ಹಬ್ಬಾ"
    },
    {
      "t": "07:26",
      "text": "ನಮ್ಮ್ ಊರಲ್ಲಿ ಕಂಚಮನು ಅವಾಗ್ಲೇ ಮಾಡ"
    },
    {
      "t": "07:28",
      "text": "ೂಸ ಮಂಡೆ ಬರಲ್ಲ"
    },
    {
      "t": "07:30",
      "text": "ಹಾ"
    },
    {
      "t": "07:32",
      "text": "ಟ್ಯೂಸ್ಡೇ ಏನಂದ್ರೆ ವೆನ್ಸ್ಡೇ"
    },
    {
      "t": "07:34",
      "text": "ಬರ್ಬೇಕು ಅಂತ ಅನ್ಕೊಂಡಿದ್ದೀನಿ ನಾನ ಇಲ್ಲಿ"
    },
    {
      "t": "07:36",
      "text": "ಬೇಕು ಒಂದ್ ಮಂತ್ ಆಯ್ತು ಊರ್ ಹೋಗ"
    },
    {
      "t": "07:38",
      "text": "ಹೋಗ ಇಲ್ಲ"
    },
    {
      "t": "07:40",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "07:42",
      "text": "ಮ್ ಮಾಡ್"
    },
    {
      "t": "07:44",
      "text": "ಇಲ್ಲಿ"
    },
    {
      "t": "07:46",
      "text": "ವ ಎಲ್ಲ ಹೋಗತಾ ಏನ್ ಮಾಡ್ತಿಯಾ ಿಲ್್"
    },
    {
      "t": "07:48",
      "text": ""
    },
    {
      "t": "07:50",
      "text": "ಸರ ಯಾರು ಇಲ್ಲ"
    },
    {
      "t": "07:52",
      "text": "ಫಿಫ್ಟೀನ್ ಡೇಸ್ ಗಂಟೆ ಹೋಗ್ತಿದ್ದಿದೆ"
    },
    {
      "t": "07:54",
      "text": "ಇನ್ನು ಸ್ವಲ್ಪ"
    },
    {
      "t": "07:56",
      "text": "ಈ ಲಾಸ್ಟ್ ಮಂತ್"
    },
    {
      "t": "07:58",
      "text": "ಆಕ್ಟಿವಿಟೀಸು ಅದು ಇದ ಒಂದು"
    },
    {
      "t": "08:00",
      "text": "ಂದು ರೀವ ಟೈಮ್ ಎಲ್ಲೂ"
    },
    {
      "t": "08:02",
      "text": "ಹೋಗಕ್ಕೆ ಆಗ ಇಲ್ವಾ"
    },
    {
      "t": "08:04",
      "text": "ನಂಗೂ ಬರ ಹುಷಾರಿದೆಯಲ್ಲ"
    },
    {
      "t": "08:06",
      "text": "ಅಂದ ಅ ಹೋಗಲ್ಲ ಸರಿ"
    },
    {
      "t": "08:08",
      "text": "ಡಫರ್ಸ್ಡ ನಾರ್ಮಲಾ"
    },
    {
      "t": "08:10",
      "text": "ಹ ಬಕ್ತ ಹ್ಮ"
    },
    {
      "t": "08:12",
      "text": "ಮಾತ್ರ ಈ ಸಲಾನ ಎಲ್ಲೋ"
    },
    {
      "t": "08:14",
      "text": "ಹೋಗಿಲ್ಲ ಸುಮ್ಮ್ನೆ ಪಿ ಜಿಲ್ಲ ಇರ್ತಿದ್ದೆ"
    },
    {
      "t": "08:16",
      "text": "ಹೋದ್ರ ಆಫೀಸ್ ಇಲ್ಲ ಅಂದ್ರ ಇಸ್ಕೊಂಡ"
    },
    {
      "t": "08:18",
      "text": "ಅಷ್ಟ ಹ್ಮ ಹ್ಮ"
    },
    {
      "t": "08:20",
      "text": "ಹಾ"
    },
    {
      "t": "08:22",
      "text": "ಬೋರಿಂಗ್ ಆಗ್ತು"
    },
    {
      "t": "08:24",
      "text": "ಸ ಮಾಡಂದಿದೆ ಪ್ರಾ"
    },
    {
      "t": "08:26",
      "text": "ಲ್ಲಿ"
    },
    {
      "t": "08:28",
      "text": "ಹ ಹ್ಮ್ಮ"
    },
    {
      "t": "08:30",
      "text": "ಏನು ಒಂತರ"
    },
    {
      "t": "08:32",
      "text": "ಆಫೀಸ್ಗೆ ಹೋದ್ರೆ ಚೂ ಯಾಕಾದ್ರೂ ಹ್ಬೇಕು"
    },
    {
      "t": "08:34",
      "text": "ು ಅನ್ಸೆ ಬೆಳಗ್ಗೆ ಬೆಳಗ್ಗೆ ನಾಡ"
    },
    {
      "t": "08:36",
      "text": "ಒಂದ್ ಗಂಟೆ ತಗೋತಾರೆ"
    },
    {
      "t": "08:38",
      "text": "ಆದಾರ್"
    },
    {
      "t": "08:40",
      "text": "ಇರ್ಕ ಅಂದ್ರೆ ಉಂತಾರ"
    },
    {
      "t": "08:42",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "08:44",
      "text": "ಹ್ಮ ಏನ್ ಹೇಳಪ್ಪ ಅಂದ್ರಿ"
    },
    {
      "t": "08:46",
      "text": "ಕಣ ಕಲ್ತೊಂತಾರ ಅಂದೆ"
    },
    {
      "t": "08:48",
      "text": "ಕಾನ್ ಕಾಲು ನಮ"
    },
    {
      "t": "08:50",
      "text": "ಮೂೋರ್ ತಗೋತಾರೆ ಬ್ರಾನ್ಚ್ ಅವರು ಅಡ"
    },
    {
      "t": "08:52",
      "text": "ತಗೋ ನಮ್ದು ಬ್ರ್ಯಾಂ್ ಪ್ಯಾಂಟಂಗ್ಯ"
    },
    {
      "t": "08:54",
      "text": "ಈ ಕಡೆ ಇವ"
    },
    {
      "t": "08:56",
      "text": "ರೂಸ್ ಸಾಯಿಸ್ತಾರೆ ಯಾಕಡೆ ನಮ್ ಗೋಲ್ಡ್"
    },
    {
      "t": "08:58",
      "text": "ತ್ತ ಮೂರು ಸಾಯ್ತಾರೆ ಟಾರ್ಗೆಟ್"
    },
    {
      "t": "09:00",
      "text": "ಅಂದ್ರೆ ಬಟ್ ಕಂಪ್ಲೀಟ್"
    },
    {
      "t": "09:02",
      "text": "ಟಟ್ ಎಲ್ಲ ಕೇಳಲ್ಲ ಪಾಪ ಒಳ್ಳೆವ ಇದ"
    },
    {
      "t": "09:04",
      "text": "ಅರ್ಥ ಮಾಡ್ಕೋತಾರೆ ಗೋಲ್ಡ್"
    },
    {
      "t": "09:06",
      "text": "ವಾ"
    },
    {
      "t": "09:08",
      "text": "ಸುಮ್ನೆ ತಗೋ ಬಂದ್ ಇಡಲ್ವ ಯಾರನ್ನು"
    },
    {
      "t": "09:10",
      "text": "ಅವರು ಕಷ್ಟ ಬರ್ಬೇಕು ನಮ್ರ"
    },
    {
      "t": "09:12",
      "text": "ನಾನ್ ಚಲ್ ಇರೋರು ಅರ್ಥ ಮಾಡ್ಕೊಳ್ಳಳಲ್ಲ ಹೆಂಗ"
    },
    {
      "t": "09:14",
      "text": "ಮಾಡತ ಗೊತ್ತಾ ಇವ"
    },
    {
      "t": "09:16",
      "text": "ಅಷ್ಟೇ ನಂಗಗೆ ಅದೆಲ್ಲ ಗೊತ್ತಿಲ್ಲ ಬೇಕ ಅಷ್ಟೇ"
    },
    {
      "t": "09:18",
      "text": "ಅಂತಲ್ಲ ಹಂ ಹೇಳ್ದಾಗ ನಾು ಸುಮನೆದ್ ಬಂದ್ಬಟ್ಟು"
    },
    {
      "t": "09:20",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "09:22",
      "text": "ಅಯ ಎಲ್ಲಿಂದ ತ"
    },
    {
      "t": "09:24",
      "text": "ಬರಕ್ ಆತ್ ನೀವೇ ಹೇಳಿ"
    },
    {
      "t": "09:26",
      "text": "ಅದೇ ಹೇಳು"
    },
    {
      "t": "09:28",
      "text": "ಹ್ಮ್ ಅದಕ್ಕೆ ಹೇಳ್ತ"
    },
    {
      "t": "09:30",
      "text": "ಓಕೆ ಮಾಡ್ತೀನಿ ಅಂತ ಹೇಳ್ತೀನಿ"
    },
    {
      "t": "09:32",
      "text": "ಚಾಲೋ ತರುತವೆೇಣ ಹೆಂಗ್ೊತಾ"
    },
    {
      "t": "09:34",
      "text": "ಹಾ ವಸ್ ಲ್ಲ ವಸ್ತ"
    },
    {
      "t": "09:36",
      "text": "ಇವಾಗ ಇಲ್ಲಿ ಬರ್ತೀನಿ ಅಂತ ಹೇಳಿರ್ತಾರೆ"
    },
    {
      "t": "09:38",
      "text": "ಒನ್ ಅವರ್ ಸಾಕ್ಲ್ವಾ ನಿಮಗೆ"
    },
    {
      "t": "09:40",
      "text": "ಎಂತ ಬ್ಯಾಂಕ್ ಹೋದ್ರು ಯಾವ್ದೇ ಹೆಂಗ"
    },
    {
      "t": "09:42",
      "text": "ಸಿಗೋದ್ರು ಇಪ್ಪತ್"
    },
    {
      "t": "09:44",
      "text": "ಇದರಿಂದ ಮೂವತ್ ನಿಮಿಷದಲ್ಲಿ ಮಾನ್ ಮುಸ್ ಬಿಿಡ್ತಾರೆ"
    },
    {
      "t": "09:46",
      "text": "ಮ್ಯಾಕ್ಸಿಮಮ್ ಒನ್ ಅವರ್ ಅನ್ಕೊಳ್ಳಿ"
    },
    {
      "t": "09:48",
      "text": "ಅದ ಹೌದು"
    },
    {
      "t": "09:50",
      "text": "ಹೇಳಿರ್ತಾರೆ ಬರ್ತೀನಿ ಓಕೆ ಹಂ ಹಿ"
    },
    {
      "t": "09:52",
      "text": "ಎಲ್ಲ ಹೇಳಿರ್ತಾರೆ ಒಂದ್ ವೀಕ್ ಒಂದ್ ಮಂತ್"
    },
    {
      "t": "09:54",
      "text": "ಿಂದ ಎಲ್ಲ ಫಲೋ ಇಟ್ಕೊಂಡಿರ್ತೀನಿ"
    },
    {
      "t": "09:56",
      "text": "ಮೇಡಮ್ ಯಾವಕ್ ಬರ್ತೀನಿ ಇಲ್ಲ ನಾಳೆ ಬಿಳಗ್"
    },
    {
      "t": "09:58",
      "text": "ನ ಬರ್ತೀನಿ ಮೇಡ್ ನಂ್ ಅರ್ಜೆಂ ಇದೆ ಹ ಹಾಗ"
    },
    {
      "t": "10:00",
      "text": "ಂತಿರ್ತಾರೆ ಕ ಮಾಡಿದ್ರೆ"
    },
    {
      "t": "10:02",
      "text": "ರೆಸ್ಪಾನ್್ ಮಾಡಲ್ಲ ಆಮೇಲೆ"
    },
    {
      "t": "10:04",
      "text": "ಸ್ವಲ್ಪ ದಿನ ಬಿಟ್ಟ್ಮೇ್ರ ಗೊತ್ತಾಗತ್ತೆ"
    },
    {
      "t": "10:06",
      "text": "ಇಲ್ಲ ಮೇಡಮ್ ಅಲ್ಲಿ ಇಂಟ್ರೆಸ್ಟ್ ಕಮ್ಮಿ"
    },
    {
      "t": "10:08",
      "text": "ಮತ್ತೆ ಗೊತ್ತರೋದ್ ಬೇರೆ ನಾವ್ ಇಂಟ್ರೆ"
    },
    {
      "t": "10:10",
