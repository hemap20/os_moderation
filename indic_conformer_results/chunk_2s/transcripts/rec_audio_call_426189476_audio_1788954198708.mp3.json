  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": ""
    },
    {
      "t": "00:04",
      "text": "ഹലോ"
    },
    {
      "t": "00:06",
      "text": ""
    },
    {
      "t": "00:08",
      "text": "ആ"
    },
    {
      "t": "00:10",
      "text": "ഹലോ"
    },
    {
      "t": "00:12",
      "text": "ആഹ എവിടുന്ന"
    },
    {
      "t": "00:14",
      "text": "വിളിക്ക"
    },
    {
      "t": "00:16",
      "text": "ഇടുക്കി"
    },
    {
      "t": "00:18",
      "text": "ിക്കി ക്ക എ പേര്"
    },
    {
      "t": "00:20",
      "text": "ഇത് സുൽസൻ"
    },
    {
      "t": "00:22",
      "text": "ക്കെ"
    },
    {
      "t": "00:24",
      "text": "സഖന എന്ത്യെന്നോ"
    },
    {
      "t": "00:26",
      "text": "ഹൌസ് വൈഫാ"
    },
    {
      "t": "00:28",
      "text": "ആഹ്"
    },
    {
      "t": "00:30",
      "text": "അപ്പം വീട്ടിലാരൊക്കെ"
    },
    {
      "t": "00:32",
      "text": "ം"
    },
    {
      "t": "00:34",
      "text": "ഒരു കുഞ്ഞും"
    },
    {
      "t": "00:36",
      "text": "അമ്മായിപ്പനും അമ്മായി്മയും ഹസ്ബന്റും"
    },
    {
      "t": "00:38",
      "text": "ആയശട്ട"
    },
    {
      "t": "00:40",
      "text": "അപ്പന്റെ പേവ"
    },
    {
      "t": "00:42",
      "text": "ജോ"
    },
    {
      "t": "00:44",
      "text": "അബന്റെ നാട്ടിലുണ്ടോ എന്നന്താ ചെയ്യണേ"
    },
    {
      "t": "00:46",
      "text": "തുണ"
    },
    {
      "t": "00:48",
      "text": "പോ"
    },
    {
      "t": "00:50",
      "text": "ശ"
    },
    {
      "t": "00:52",
      "text": "എന്നിട്ടോ വെറന്തന്റെ വിശേഷങ്ങളൊക്കെ"
    },
    {
      "t": "00:54",
      "text": "ക്ക ഇടുക്കീല്"
    },
    {
      "t": "00:56",
      "text": "ഒരു വിശേഷല്ല സുഖം"
    },
    {
      "t": "00:58",
      "text": "ആായിട്ട്ിക്കുന്നു"
    },
    {
      "t": "01:00",
      "text": "ആ"
    },
    {
      "t": "01:02",
      "text": "ആ"
    },
    {
      "t": "01:04",
      "text": "ഞാൻ ഇപ്പ ഡൗൺലോഡ് ചെയ്ത് ഫസ്റ്റ് കോള"
    },
    {
      "t": "01:06",
      "text": "ആ ഫസ്റ്റ് ഗോള ആാണ്"
    },
    {
      "t": "01:08",
      "text": "നല്ല"
    },
    {
      "t": "01:10",
      "text": "എല്ലാവിധ ഭാവുകളും നേരും"
    },
    {
      "t": "01:12",
      "text": "ആയി എന്താ"
    },
    {
      "t": "01:14",
      "text": "അല്ല ന"
    },
    {
      "t": "01:16",
      "text": "ത്തോ"
    },
    {
      "t": "01:18",
      "text": "ട്രോഫി എല്ലാം കിട്ട ഭാഗ"
    },
    {
      "t": "01:20",
      "text": "ൊക്കെ നിറന്നിട്ടാ"
    },
    {
      "t": "01:22",
      "text": "അ അതൊക്കെ നിങ്ങളടെ കഴിവും അല്ലെ"
    },
    {
      "t": "01:24",
      "text": ""
    },
    {
      "t": "01:26",
      "text": ""
    },
    {
      "t": "01:28",
      "text": "ഉം"
    },
    {
      "t": "01:30",
      "text": "മ"
    },
    {
      "t": "01:32",
      "text": "അതെ"
    },
    {
      "t": "01:34",
      "text": "എന്ത്"
    },
    {
      "t": "01:36",
      "text": "ഇപ്പൊ എന്താണ് പരസ്യ കുടെ വാര് വേണോ"
    },
    {
      "t": "01:38",
      "text": "ഉ"
    },
    {
      "t": "01:40",
      "text": "എന്താന്ന്റ കൊറെേ നാളായിഞ"
    },
    {
      "t": "01:42",
      "text": "കാണുന്നു"
    },
    {
      "t": "01:44",
      "text": "ആപ്പ"
    },
    {
      "t": "01:46",
      "text": "മാ പിെ എങ്ങനെ"
    },
    {
      "t": "01:48",
      "text": "ചോദിച്ചിട്ട കാര്യില്ല"
    },
    {
      "t": "01:50",
      "text": "ആഓ"
    },
    {
      "t": "01:52",
      "text": "എ നള"
    },
    {
      "t": "01:54",
      "text": ""
    },
    {
      "t": "01:56",
      "text": "ഞാനൊരു രണ്ട്"
    },
    {
      "t": "01:58",
      "text": "ആ ഒരു മാസമായി"
    },
    {
      "t": "02:00",
      "text": "എന്നങ്ങിട്ട് കൊള്ളാം"
    },
    {
      "t": "02:02",
      "text": "പ്രപ്പ"
    },
    {
      "t": "02:04",
      "text": "ഉ"
    },
    {
      "t": "02:06",
      "text": "ഉ"
    },
    {
      "t": "02:08",
      "text": "അതവിടെ ആും വരമില്ല"
    },
    {
      "t": "02:10",
      "text": "ഞാൻ കണ്ണൂരാണ് പറഞ്ഞരുന്നത്"
    },
    {
      "t": "02:12",
      "text": "അത് കേൾക്കില്ല"
    },
    {
      "t": "02:14",
      "text": "ആഹ കണ്ണൂര്"
    },
    {
      "t": "02:16",
      "text": "ആഹ"
    },
    {
      "t": "02:18",
      "text": "ഓക്കെ"
    },
    {
      "t": "02:20",
      "text": "എന്ത്തു ഉദ്ദേശട്ട ാപക"
    },
    {
      "t": "02:22",
      "text": "ചുമ് സംസാരിക്കാനാണോ അല്ലെങ്കിൽ ഏണങ്കിൽ"
    },
    {
      "t": "02:24",
      "text": ""
    },
    {
      "t": "02:26",
      "text": "അങ്ങനെയ ഒന്നും ഉദ്ദേശിക്കില്ല ഇതിെ"
    },
    {
      "t": "02:28",
      "text": "അ കണ്ടപ്പോൊ അന്ന് ജോയിൻ ചെയ്ത് നോക്കിയേക്കത്"
    },
    {
      "t": "02:30",
      "text": ""
    },
    {
      "t": "02:32",
      "text": "ആ ശ ഉ"
    },
    {
      "t": "02:34",
      "text": "ശ"
    },
    {
      "t": "02:36",
      "text": "വീട്ടിലക്ക മക്ക"
    },
    {
      "t": "02:38",
      "text": "പുതി കുഞ്ഞുണ്ടന്നല്ലോ അല്ലേ പുജ എത്ര വയസ്സ്"
    },
    {
      "t": "02:40",
      "text": "രണ്ടു വയസോ"
    },
    {
      "t": "02:42",
      "text": ""
    },
    {
      "t": "02:44",
      "text": ""
    },
    {
      "t": "02:46",
      "text": "കുഴപ്പ ഉണ്ടോ"
    },
    {
      "t": "02:48",
      "text": ""
    },
    {
      "t": "02:50",
      "text": "ഏ"
    },
    {
      "t": "02:52",
      "text": "കൊഴപ്പംുണ്ടാവന്നോ"
    },
    {
      "t": "02:54",
      "text": "എല്ല"
    },
    {
      "t": "02:56",
      "text": "കുഴപ്പംുണ്ടാവുന്ന രണ്ട വയസ"
    },
    {
      "t": "02:58",
      "text": "തന്റെ കുഞ്ഞ രണ്ട"
    },
    {
      "t": "03:00",
      "text": "ഞാന എന്ത് കുഴപ്പം പോയട്ട"
    },
    {
      "t": "03:02",
      "text": "അതന്നെ ര"
    },
    {
      "t": "03:04",
      "text": "ുള്ള ഇപ്പ ഞാൻെന്താ ചെയ്യാ"
    },
    {
      "t": "03:06",
      "text": "രണ്ടു വയസുള്ള"
    },
    {
      "t": "03:08",
      "text": "അടെ എത്ര കാണായി"
    },
    {
      "t": "03:10",
      "text": "കല്യാണം കഴിഞ്ഞിട്ട് നാല വക്ക"
    },
    {
      "t": "03:12",
      "text": ""
    },
    {
      "t": "03:14",
      "text": "ആ അപ്പൊ കൊഴപ്പുണ്ട്"
    },
    {
      "t": "03:16",
      "text": "എസം പോല്ല"
    },
    {
      "t": "03:18",
      "text": "ആഹ"
    },
    {
      "t": "03:20",
      "text": "പി കുഴപ്പ"
    },
    {
      "t": "03:22",
      "text": "ചോദിച്ചാൽ പിന്നെ എന്തേലും കുഴപ്പം പറയണ്ടേ"
    },
    {
      "t": "03:24",
      "text": "ഉം അതോർത്ത് പറഞ്ഞാലേ"
    },
    {
      "t": "03:26",
      "text": "കല്യാണം കഴിഞ്ഞ"
    },
    {
      "t": "03:28",
      "text": "ആ എന്തായാലും പറഞ്ഞില്ലങ്ങക്ക് പോ"
    },
    {
      "t": "03:30",
      "text": "എന്റെ കല്യാണം"
    },
    {
      "t": "03:32",
      "text": "കഴിഞ്ഞതാണ്"
    },
    {
      "t": "03:34",
      "text": "കുട്ടികളോ"
    },
    {
      "t": "03:36",
      "text": "കുട്ടികളൊന്നും"
    },
    {
      "t": "03:38",
      "text": ""
    },
    {
      "t": "03:40",
      "text": "ആഹ"
    },
    {
      "t": "03:42",
      "text": "ഒരു വയസ"
    },
    {
      "t": "03:44",
      "text": "ഓക്കെ"
    },
    {
      "t": "03:46",
      "text": "ആഹ"
    },
    {
      "t": "03:48",
      "text": ""
    },
    {
      "t": "03:50",
      "text": "അപ്പൊ ഒരു കുഴപ്പമില്ല"
    },
    {
      "t": "03:52",
      "text": "എനിക്ക്ര് കുഴവമില്ല"
    },
    {
      "t": "03:54",
      "text": ""
    },
    {
      "t": "03:56",
      "text": "ഞവലണ്ടാ"
    },
    {
      "t": "03:58",
      "text": "പിന്നെ ജോലില്ലാണ്ട്"
    },
    {
      "t": "04:00",
      "text": "ബറി മക്കളല്ലക്കല്ല"
    },
    {
      "t": "04:02",
      "text": "ആഹ"
    },
    {
      "t": "04:04",
      "text": "ഞാ ഗ്ര"
    },
    {
      "t": "04:06",
      "text": "മാറ ഏ"
    },
    {
      "t": "04:08",
      "text": "ഗ്രഹാശക്തി ചെയേനറാണ് ഗ്രഹാശക്തി"
    },
    {
      "t": "04:10",
      "text": "വ"
    },
    {
      "t": "04:12",
      "text": "പാടം പിിടിച്ചെങ്കി അറിയാമോ"
    },
    {
      "t": "04:14",
      "text": "അീന്നല്ല"
    },
    {
      "t": "04:16",
      "text": ""
    },
    {
      "t": "04:18",
      "text": "നമ്മള് ഞാന"
    },
    {
      "t": "04:20",
      "text": "എന്ത ശ്രീലാസോട്ടും വർക്ക് ചെയ"
    },
    {
      "t": "04:22",
      "text": "കമ്പനിൽ വർക്ക് ചെയ്ത"
    },
    {
      "t": "04:24",
      "text": "ആഹ"
    },
    {
      "t": "04:26",
      "text": "പ്രാംസ ഡോ"
    },
    {
      "t": "04:28",
      "text": "ക്ക എന്ത എന്ത ക"
    },
    {
      "t": "04:30",
      "text": "എന്ത് ഗ്രാഫിക്ക ഡിസൈൻ ചെയ്യന്ന്"
    },
    {
      "t": "04:32",
      "text": "പ്പിറ്റീ ആഡ്സ് എല്ലാം ചെയ്ത"
    },
    {
      "t": "04:34",
      "text": "കൊടുക്കണണ്ട്േ"
    },
    {
      "t": "04:36",
      "text": "ആസോ"
    },
    {
      "t": "04:38",
      "text": "ഡിജിറ്റൽ മാർക്ക ഡിജിറ്റൽ മാർക്കറ്റിംഗ അല്ലേ"
    },
    {
      "t": "04:40",
      "text": "ആഹ"
    },
    {
      "t": "04:42",
      "text": "അതിന വേണ്ടിയുള്ള ആഡ്സ് വീഡിയോസ്"
    },
    {
      "t": "04:44",
      "text": "അങ്ങനൊക്കെ ചെയ്ത് കൊടുക്കാറുണ്ട്"
    },
    {
      "t": "04:46",
      "text": "ആഹ അങ്ങനെയൊന്ന"
    },
    {
      "t": "04:48",
      "text": "അറിയില്ല ആകെ അറിയാവുന്നത്"
    },
    {
      "t": "04:50",
      "text": ""
    },
    {
      "t": "04:52",
      "text": "വേറെ പണികളെ ഉള്ള അറിയത്തില്ല"
    },
    {
      "t": "04:54",
      "text": "ആെ അറ നന്ത"
    },
    {
      "t": "04:56",
      "text": "പഞ്ഞിയ കറിയുമ്പക്കെ"
    },
    {
      "t": "04:58",
      "text": "ആച"
    },
    {
      "t": "05:00",
      "text": "അത് മര്യാദക്കും അറിയില്ല"
    },
    {
      "t": "05:02",
      "text": "ഡിഗ്രി ആഞ"
    },
    {
      "t": "05:04",
      "text": "വെറുതെരിക്കുവവാ"
    },
    {
      "t": "05:06",
      "text": "എന്ത ഡിഗ്രി എന്തായിരുന്നു"
    },
    {
      "t": "05:08",
      "text": "ഡിഗ്രി"
    },
    {
      "t": "05:10",
      "text": "ഇത്രത്രോ അ"
    },
    {
      "t": "05:12",
      "text": "ഒന്നും അറിയിാത്തതൊണ്ട് പിന്നെ ഒന്നിനന് ഞാൻ പോയില്ല"
    },
    {
      "t": "05:14",
      "text": "ആ ശരി"
    },
    {
      "t": "05:16",
      "text": ""
    },
    {
      "t": "05:18",
      "text": "ഓക്കെ ഇങ്ങനെയൊക്കെയാണ്പ്പൊ"
    },
    {
      "t": "05:20",
      "text": ""
    },
    {
      "t": "05:22",
      "text": ""
    },
    {
      "t": "05:24",
      "text": "ഇല്ല അവിടെക്ക താരല്ലേ അങ്ങനെ"
    },
    {
      "t": "05:26",
      "text": "അല്ല ഇപ്പം കാര്യങ്ങൾന്ന് പറഞ്ഞ"
    },
    {
      "t": "05:28",
      "text": "ഏതാ"
    },
    {
      "t": "05:30",
      "text": "ബില അവവറേജ് ആുന്ന സാരം അത്ര"
    },
    {
      "t": "05:32",
      "text": "ള്ള ആ"
    },
    {
      "t": "05:34",
