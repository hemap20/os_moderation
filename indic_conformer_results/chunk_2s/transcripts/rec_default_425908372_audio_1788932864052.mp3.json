    },
    {
      "t": "15:06",
      "text": ""
    },
    {
      "t": "15:08",
      "text": "చెప్పు సెక్స ఉన్నాం అంటున్నా"
    },
    {
      "t": "15:10",
      "text": "అ ఏం చూస మ"
    },
    {
      "t": "15:12",
      "text": "కొంత కాట్లా"
    },
    {
      "t": "15:14",
      "text": "ఎ"
    },
    {
      "t": "15:16",
      "text": "చూపిస్తామంటే"
    },
    {
      "t": "15:18",
      "text": "ఇవళ నిమ్మ"
    },
    {
      "t": "15:20",
      "text": "ఎంతకి"
    },
    {
      "t": "15:22",
      "text": "అ"
    },
    {
      "t": "15:24",
      "text": "అ"
    },
    {
      "t": "15:26",
      "text": "ఏట్యితిరోజు"
    },
    {
      "t": "15:28",
      "text": "ఎంగనట్లయితే"
    },
    {
      "t": "15:30",
      "text": "అంటున్నా ఇప్పుడు"
    },
    {
      "t": "15:32",
      "text": "వత్ర్రమ్పుర్"
    },
    {
      "t": "15:34",
      "text": ""
    },
    {
      "t": "15:36",
      "text": "నైట్యషందా"
    },
    {
      "t": "15:38",
      "text": "అవు"
    },
    {
      "t": "15:40",
      "text": "ఇంటి కూతున్నా కదమ్ మళ్ళ"
