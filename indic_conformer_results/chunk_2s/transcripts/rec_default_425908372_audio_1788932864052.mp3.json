    {
      "t": "12:44",
      "text": "ఇప్పుడుదాకా"
    },
    {
      "t": "12:46",
      "text": ""
    },
    {
      "t": "12:48",
      "text": "మీ నది"
    },
    {
      "t": "12:50",
      "text": "ఇ పెట్టుకుం"
    },
    {
      "t": "12:52",
      "text": ""
    },
    {
      "t": "12:54",
      "text": "నీది పెట్టుకుండా"
