      "text": "డే బై డేనా"
    },
    {
      "t": "11:56",
      "text": "అ"
    },
    {
      "t": "11:58",
      "text": "అ"
    },
    {
      "t": "12:00",
      "text": "ఇంకా"
    },
    {
      "t": "12:02",
      "text": "అ"
    },
    {
      "t": "12:04",
      "text": "చెప్పాల"
    },
    {
      "t": "12:06",
      "text": ""
    },
    {
      "t": "12:08",
      "text": "నూట ఎడ్కోను"
    },
    {
      "t": "12:10",
      "text": "నూట ఎడుకున్నా"
    },
    {
      "t": "12:12",
      "text": "ఎవంది"
    },
    {
      "t": "12:14",
      "text": ""
    },
    {
      "t": "12:16",
      "text": "క"
    },
    {
      "t": "12:18",
      "text": "చెట్కోలే"
    },
    {
      "t": "12:20",
      "text": "ఇంకాలో"
    },
    {
      "t": "12:22",
      "text": "మ బయాను"
    },
