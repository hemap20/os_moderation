      "text": ""
    },
    {
      "t": "10:10",
      "text": "അന്റെ എന്ത അപ്പൊ"
    },
    {
      "t": "10:12",
      "text": "ഓറക്കം"
    },
    {
      "t": "10:14",
      "text": "ശരിെന്നാ"
    },
    {
      "t": "10:16",
      "text": "എോ ആ"
    },
    {
      "t": "10:18",
      "text": ""
    },
    {
      "t": "10:20",
      "text": "മുമ്പേ"
    },
    {
      "t": "10:22",
      "text": ""
    },
    {
      "t": "10:24",
      "text": "സ കടത്തോടെ"
    },
    {
      "t": "10:26",
      "text": "എന്തോ"
    },
    {
      "t": "10:28",
      "text": ""
    },
    {
      "t": "10:30",
      "text": "എന്ത"
    },
    {
      "t": "10:32",
      "text": "ഓർക്കാ പിന്നെ ശരിയ ബൈ"
    },
    {
      "t": "10:34",
      "text": "ഓ പിന്നെ"
    },
    {
      "t": "10:36",
      "text": "വണ്ടി"
    },
    {
      "t": "10:38",
      "text": "അട്ടക്ക"
    },
    {
      "t": "10:40",
      "text": "ആ ബക്ക"
