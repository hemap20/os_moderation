    {
      "t": "00:06",
      "text": "ഹലോ"
    },
    {
      "t": "00:08",
      "text": "ഹലോ"
    },
    {
      "t": "00:10",
      "text": "ആഹ പേരെന്തായിരുന്നു"
    },
    {
      "t": "00:12",
      "text": "പറയത്തിന്െ"
    },
    {
      "t": "00:14",
      "text": "അെ"
    },
    {
      "t": "00:16",
      "text": ""
    },
    {
      "t": "00:18",
      "text": "പറയലന്ന് അവര് പറഞ്ഞു"
    },
    {
      "t": "00:20",
      "text": "ആര് പറഞ്ഞു"
    },
    {
      "t": "00:22",
      "text": "പി"
    },
    {
      "t": "00:24",
      "text": "ചേച്ചി"
    },
    {
      "t": "00:26",
      "text": ""
    },
    {
      "t": "00:28",
      "text": "വേറെ എന്തെങ്കിലും പറച്ചോ"
    },
    {
      "t": "00:30",
      "text": "നമ്മള് നാട് വീട്"
    },
    {
      "t": "00:32",
      "text": "കാര്യങ്ങ പേഴസണൽ കാര്യങ്ങളൾ ഒന്ന"
    },
    {
      "t": "00:34",
      "text": "പറയരുത ബാക്കി"
    },
    {
      "t": "00:36",
      "text": "ചീത്തയൊക്കെ പറയാ നോക്കു"
    },
    {
      "t": "00:38",
      "text": "ഉഏ"
    },
    {
      "t": "00:40",
      "text": ""
    },
    {
      "t": "00:42",
      "text": "താങ്കൾക്ക് താങ്കൾ എന്തിനാ വന്നേ"
    },
    {
      "t": "00:44",
      "text": ""
    },
    {
      "t": "00:46",
      "text": "ഞ വെറുതെ സംസാരിച്ചിരിക്ക"
    },
    {
      "t": "00:48",
      "text": "ആഹ ശുക്ക"
    },
    {
      "t": "00:50",
      "text": "ഇ"
    },
    {
      "t": "00:52",
      "text": ""
    },
    {
      "t": "00:54",
      "text": "താങ്കള പേര്"
    },
    {
      "t": "00:56",
      "text": ""
    },
    {
      "t": "00:58",
      "text": "നിയസ"
    },
    {
      "t": "01:00",
      "text": "ആ ചേച്ചിയൊന്നും പറഞ്ഞില്ലേ ഇയാളടുത്ത്"
    },
    {
      "t": "01:02",
      "text": ""
    },
    {
      "t": "01:04",
      "text": "ആ ചേച്ചി പറഞ്ഞില്ല"
    },
    {
      "t": "01:06",
      "text": "എന്താ പറന്ന"
    },
    {
      "t": "01:08",
      "text": "ഇയാളപ്പം പറഞ്ഞക്കെ തന്നെ"
    },
    {
      "t": "01:10",
      "text": "ആഹ"
    },
    {
      "t": "01:12",
      "text": "അതിന്റെ"
    },
    {
      "t": "01:14",
      "text": "ണന്താ അത അനസരിരിക്കത്തെ"
    },
    {
      "t": "01:16",
      "text": ""
    },
    {
      "t": "01:18",
      "text": ""
    },
    {
      "t": "01:20",
      "text": "അതിലേൊക്കെപ്പന്താ"
    },
    {
      "t": "01:22",
      "text": "ഇയാളപ്പൊ കള്തപ്പോ നമ്മൾ ചോദിക്ക"
    },
    {
      "t": "01:24",
      "text": "ആഹ"
    },
    {
      "t": "01:26",
      "text": "അപ്പൊ"
    },
    {
      "t": "01:28",
      "text": "പര് പറയണോ"
    },
    {
      "t": "01:30",
      "text": "പോ ഉ ഉ ഉ"
    },
    {
      "t": "01:32",
      "text": "അ"
    },
    {
      "t": "01:34",
      "text": "നസിം"
    },
    {
      "t": "01:36",
      "text": "എന്താ ഞടെ"
    },
    {
      "t": "01:38",
      "text": "പേര്ന്ത നാസിം തന്നെ പറഞ്ഞ"
    },
    {
      "t": "01:40",
      "text": "നിയസ്"
    },
    {
      "t": "01:42",
      "text": "ന്നിയ"
    },
    {
      "t": "01:44",
      "text": "സൗകറി"
    },
    {
      "t": "01:46",
      "text": "പെട്ട"
    },
    {
      "t": "01:48",
      "text": "നയ"
    },
    {
      "t": "01:50",
      "text": "സക്ക നിയ ജ"
    },
    {
      "t": "01:52",
      "text": "എട്ട"
    },
    {
      "t": "01:54",
      "text": "ആട്ട"
    },
    {
      "t": "01:56",
      "text": "എന്റെ പേരെന്താ"
    },
    {
      "t": "01:58",
      "text": "എന്റെ വേടാ"
    },
    {
      "t": "02:00",
      "text": "അന്തോനി അഹംഹ"
    },
    {
      "t": "02:02",
      "text": "എന്തോളിയ"
    },
    {
      "t": "02:04",
      "text": "ആ ോണ"
    },
    {
      "t": "02:06",
      "text": "ആമ്മ"
    },
    {
      "t": "02:08",
      "text": "ആന്റോണിയ ആന്മാ"
    },
    {
      "t": "02:10",
      "text": "ആഹ"
    },
    {
      "t": "02:12",
      "text": ""
    },
    {
      "t": "02:14",
      "text": "ഞങ്ങള് കൃഷൻ"
    },
    {
      "t": "02:16",
      "text": "അത് മനസ്സിലായി"
    },
    {
      "t": "02:18",
      "text": "ആം"
    },
    {
      "t": "02:20",
      "text": "പൂർണചൽ കട"
    },
    {
      "t": "02:22",
      "text": "കൂടച്ച"
    },
    {
      "t": "02:24",
      "text": "കുച്ചില്ല"
    },
    {
      "t": "02:26",
      "text": "ആ"
    },
    {
      "t": "02:28",
      "text": "അതവിടാ"
    },
    {
      "t": "02:30",
      "text": "തമിഴ്നാട്"
    },
    {
      "t": "02:32",
      "text": "ട്ടർ"
    },
    {
      "t": "02:34",
      "text": "എക്ക്  എക്ക് ശ്രീലങ്ക"
    },
    {
      "t": "02:36",
      "text": "തരും തമഴ് തരും"
    },
    {
      "t": "02:38",
      "text": ""
    },
    {
      "t": "02:40",
      "text": "വ"
    },
    {
      "t": "02:42",
      "text": "പുള്ളിയപ്പ"
    },
    {
      "t": "02:44",
      "text": "ആഹ"
    },
    {
      "t": "02:46",
      "text": "നിനക്ക് എത്ര ഭാഷ അറിയണം"
    },
    {
      "t": "02:48",
      "text": "എനിക്ക്"
    },
    {
      "t": "02:50",
      "text": ""
    },
    {
      "t": "02:52",
      "text": "ആ എനിക്ക് സയൻസ് അറിയാം സോഷ്യൽ സ്റ്റഡി"
    },
    {
      "t": "02:54",
      "text": "റ"
    },
    {
      "t": "02:56",
      "text": "അിയാം"
    },
    {
      "t": "02:58",
      "text": ""
    },
    {
      "t": "03:00",
      "text": ""
    },
    {
      "t": "03:02",
      "text": ""
    },
    {
      "t": "03:04",
      "text": "എന്നാ അറിയാപ്പ"
    },
    {
      "t": "03:06",
      "text": "ഉ"
    },
    {
      "t": "03:08",
      "text": "ഉറങ്ങാതെ എന്ത് ചെയ്യാൻ പോന്ന്"
    },
    {
      "t": "03:10",
      "text": ""
    },
    {
      "t": "03:12",
      "text": "പറന്നാണ്ോ"
    },
    {
      "t": "03:14",
      "text": "ഓക്കേ"
    },
    {
      "t": "03:16",
      "text": "എന്നാ ഞാൻ പോട്ടെ"
    },
    {
      "t": "03:18",
      "text": "കണണ"
    },
    {
      "t": "03:20",
      "text": "ഉം തവേ"
    },
    {
      "t": "03:22",
      "text": "ഹത്തദേഹി"
    },
    {
      "t": "03:24",
      "text": "ആഹ"
    },
    {
      "t": "03:26",
      "text": "അതെന്ത പോണം"
    },
    {
      "t": "03:28",
      "text": "ഉം"
    },
    {
      "t": "03:30",
      "text": "നാളെ അന്നം വേടിക്ക"
    },
    {
      "t": "03:32",
      "text": "െോല"
    },
    {
      "t": "03:34",
      "text": "യലടെ വന്നം കിട്ടത്തളും"
    },
    {
      "t": "03:36",
      "text": "അത"
    },
    {
      "t": "03:38",
      "text": "അന്നം കിട്ടിയില്ലെങ്കിൽ നമ്മ"
    },
    {
      "t": "03:40",
      "text": "നളെന്ത ചെയ്യും"
    },
    {
      "t": "03:42",
      "text": "അ"
    },
    {
      "t": "03:44",
      "text": "ബാത്രവിൽ പോവാനുള്ള പ്രൊഡക്ഷൻസ്"
    },
    {
      "t": "03:46",
      "text": "ഒന്നും കിട്ടത്തില്ല"
    },
    {
      "t": "03:48",
      "text": "അപ്പം ആ പ്രൊഡക്"
    },
    {
      "t": "03:50",
      "text": "ം ചെയ്യുന്ന ആ പാർസ് ഇരുന്ന്"
    },
    {
      "t": "03:52",
      "text": "വിഷമിക്ക അവരെന്ത ചെയ്യും"
    },
    {
      "t": "03:54",
      "text": "നിയർള്ള പാർസിലുള്ള ക"
    },
    {
      "t": "03:56",
      "text": "നിങ്ങളെ അവര് കടം എടുക്കും"
    },
    {
      "t": "03:58",
      "text": "അങ്ങന"
    },
    {
      "t": "04:00",
      "text": "ൻ ഉണ്ടാവും ഡെഫിഷ്യൻസി ഉ"
    },
    {
      "t": "04:02",
      "text": "ഉണ്ടായ എന്തുണ്ടാവോ അസുഖം ഉണ്ടാവും"
    },
    {
      "t": "04:04",
      "text": ""
    },
    {
      "t": "04:06",
      "text": "എന്താ സയൻസിന്റെ ക്ലാസ്"
    },
    {
      "t": "04:08",
      "text": ""
    },
    {
      "t": "04:10",
      "text": "ഇപ്പൊ എങ്ങനെ ഇരിക്കുന്നു"
    },
    {
      "t": "04:12",
      "text": "എന്താ ഞാൻ സെക്സ് ക്ലസ് എടുത്ത"
    },
    {
      "t": "04:14",
      "text": "ട്ട"
    },
    {
      "t": "04:16",
      "text": "എനിക്കിഷ്ടണ"
    },
    {
      "t": "04:18",
      "text": "ഉ"
    },
    {
      "t": "04:20",
      "text": "നിനക്ക്ി"
    },
    {
      "t": "04:22",
      "text": "എന്ത് ടൈപ്പ് സെക്സ് ഇഷ്ടം"
    },
    {
      "t": "04:24",
      "text": "ഉം"
    },
    {
      "t": "04:26",
      "text": "ഏതൊക്കെ ടൈപ്പ് പറയും"
    },
    {
      "t": "04:28",
      "text": "മരി"
    },
    {
      "t": "04:30",
      "text": "കുട്ടി പറയും സിങ്കിള് പറയും"
    },
    {
      "t": "04:32",
      "text": ""
    },
    {
      "t": "04:34",
      "text": "വൺ"
    },
    {
      "t": "04:36",
      "text": "ബൈ വൺ പററയും"
    },
    {
      "t": "04:38",
      "text": ""
    },
    {
      "t": "04:40",
      "text": "അ"
    },
    {
      "t": "04:42",
      "text": "ആ പറയ"
    },
    {
      "t": "04:44",
      "text": "സിങ്കിൾ പറയും"
    },
    {
      "t": "04:46",
      "text": "യും ഡബിൾ വരയും ത്രിപിൾ വര"
    },
    {
      "t": "04:48",
      "text": ""
    },
    {
      "t": "04:50",
      "text": "ര"
    },
    {
      "t": "04:52",
      "text": "ട്ട അപ്പ അപ്പടൊന്ന പറ"
    },
    {
      "t": "04:54",
      "text": "ഗേ"
    },
    {
      "t": "04:56",
      "text": "ും മെൻ പറയും ട്രൻസ്റ്റൻ"
    },
    {
      "t": "04:58",
      "text": "പറയും"
    },
    {
      "t": "05:00",
      "text": "പി എൻ പറയും"
    },
    {
      "t": "05:02",
      "text": "ഉം"
    },
    {
      "t": "05:04",
      "text": "വേടിി പറയുംയും"
    },
    {
      "t": "05:06",
      "text": ""
    },
    {
      "t": "05:08",
      "text": "ഉം"
    },
    {
      "t": "05:10",
      "text": "ഇപ്പൊ നമ്മള് കണ്ട് വര"
    },
    {
      "t": "05:12",
      "text": "അതിനനുസരിച്ച് പറഞ്ഞ"
    },
    {
      "t": "05:14",
      "text": "ഓഹഓ"
    },
    {
      "t": "05:16",
      "text": "ഉം"
    },
    {
      "t": "05:18",
      "text": "പറഞ്ഞു എനിക്ക്"
    },
    {
      "t": "05:20",
      "text": "ബെനിഫിറ്റ്"
    },
    {
      "t": "05:22",
      "text": ""
    },
    {
      "t": "05:24",
      "text": "എന്തായിരുന്നു വേണ്ട"
    },
    {
      "t": "05:26",
      "text": ""
    },
    {
      "t": "05:28",
      "text": "പേടിക്കന്ത"
    },
    {
      "t": "05:30",
      "text": "പിണ്ട്"
    },
    {
      "t": "05:32",
      "text": ""
    },
    {
      "t": "05:34",
      "text": ""
    },
    {
      "t": "05:36",
      "text": ""
    },
    {
      "t": "05:38",
      "text": "ഒന്നും വേണ്ടായി"
    },
    {
      "t": "05:40",
      "text": "എനിക്കൊന്നും വേണ്ട"
    },
    {
      "t": "05:42",
      "text": "ഞാൻ ചോദിച്ചത്"
    },
    {
      "t": "05:44",
      "text": "ഉം"
    },
    {
      "t": "05:46",
      "text": ""
    },
    {
      "t": "05:48",
      "text": ""
    },
    {
      "t": "05:50",
      "text": "എത്ര വയസായി"
    },
    {
      "t": "05:52",
      "text": "അമ്പത്തിട്ട്"
    },
    {
      "t": "05:54",
      "text": "എത്രത്ര"
    },
    {
      "t": "05:56",
      "text": "അൻപത്തി എട്ട്"
    },
    {
      "t": "05:58",
      "text": "അന്പത്തെട്ടോ"
    },
    {
      "t": "06:00",
      "text": "ഉം"
    },
    {
      "t": "06:02",
      "text": ""
    },
    {
      "t": "06:04",
      "text": "എന്ത്"
    },
    {
      "t": "06:06",
      "text": "മ അഛ"
    },
    {
      "t": "06:08",
      "text": "ആയി പോയിുന്ന"
    },
    {
      "t": "06:10",
      "text": "അതെ ഈ"
    },
    {
      "t": "06:12",
      "text": "ഈശ്വൻ കണഞ്ഞഞ് ഓരോ"
    },
    {
      "t": "06:14",
      "text": "ദിവസം കൂടുന്നവർ എന്റെ സ്വ"
    },
    {
      "t": "06:16",
      "text": "ന ചലത ച"
    },
    {
      "t": "06:18",
      "text": ""
    },
    {
      "t": "06:20",
      "text": ""
    },
    {
      "t": "06:22",
      "text": "ആഹ"
    },
    {
      "t": "06:24",
      "text": "ഞാ"
    },
    {
      "t": "06:26",
      "text": "ഞ നാട്ടില എവിടെയാണ്"
    },
    {
      "t": "06:28",
      "text": "കാലിക്കറ്റ്ിൽ"
    },
    {
      "t": "06:30",
      "text": "ഉ"
    },
    {
      "t": "06:32",
      "text": "ഉ ഉ കോഴ"
    },
    {
      "t": "06:34",
      "text": "ള്ളതൊക്കെ വന്നന്ന അപ്പ"
    },
    {
      "t": "06:36",
      "text": "ആഹ് അന്നെ പോയിിക്കോടെ"
    },
    {
      "t": "06:38",
      "text": "കന കട്ടണ"
    },
    {
      "t": "06:40",
      "text": "ആരി"
    },
    {
      "t": "06:42",
      "text": "ഉം"
    },
    {
      "t": "06:44",
      "text": "ഞക്ക് എഴുജ ഇത്രുണ്ട്"
    },
    {
      "t": "06:46",
      "text": "വന്ി സക്സ്"
    },
    {
      "t": "06:48",
      "text": "ഉ"
    },
    {
      "t": "06:50",
      "text": "സക്സ് അത് ആാ വർഷ സ"
    },
    {
      "t": "06:52",
      "text": "പിന്നെ"
    },
    {
      "t": "06:54",
      "text": "ണ്ണ്ടി സ"
    },
    {
      "t": "06:56",
      "text": "ുള്ള ആൾക്കാർ ഇത്രയും ശാന്തമായിട്ട"
    },
    {
      "t": "06:58",
      "text": "ശരി"
    },
    {
      "t": "07:00",
      "text": ""
    },
    {
      "t": "07:02",
      "text": "അല്ല അവരെങ്കിലും സംസാരിക്കുവന്നോ"
    },
    {
      "t": "07:04",
      "text": "മിക്കും ഇത്രയും കൂടു"
    },
    {
      "t": "07:06",
      "text": "ഉ"
    },
    {
      "t": "07:08",
      "text": ""
    },
    {
      "t": "07:10",
      "text": "അപ്പ"
    },
    {
      "t": "07:12",
      "text": "നിിക്കാത"
    },
    {
      "t": "07:14",
      "text": "ഉം"
    },
    {
      "t": "07:16",
      "text": "നിക്കാനൊക്കെ നിക്കുന്നു"
    },
    {
      "t": "07:18",
      "text": "ശട്ടല്ല"
    },
    {
      "t": "07:20",
      "text": "ഉ"
    },
    {
      "t": "07:22",
      "text": "നന്നായിട്ട് ക്ലാസ്ടുത്ത വരെ"
    },
    {
      "t": "07:24",
      "text": ""
    },
    {
      "t": "07:26",
      "text": "ന"
    },
    {
      "t": "07:28",
      "text": "ആം"
    },
    {
      "t": "07:30",
      "text": "എന്താ ജോലി"
    },
    {
      "t": "07:32",
      "text": "ഉ"
    },
    {
      "t": "07:34",
      "text": "ഞാപ്പ പുൊറത്താ"
    },
    {
      "t": "07:36",
      "text": "വറോസ്ക്ോബ"
    },
    {
      "t": "07:38",
      "text": ""
    },
    {
      "t": "07:40",
      "text": "പുറത്തണല്ല"
    },
    {
      "t": "07:42",
      "text": "ഉല്ല"
    },
    {
      "t": "07:44",
      "text": "പാരത്രികന്ന് സംസാരിക്കുന്ന"
    },
    {
      "t": "07:46",
      "text": "അതെ"
    },
    {
      "t": "07:48",
      "text": "ഉം"
    },
    {
      "t": "07:50",
      "text": "മട്ട്"
    },
    {
      "t": "07:52",
      "text": "അവിടെ എന്നാ ചോപ്പ"
    },
    {
      "t": "07:54",
      "text": "വറോസ്"
    },
    {
      "t": "07:56",
      "text": "കേട്ടില്ല"
    },
    {
      "t": "07:58",
      "text": "വെയർ ഹൗസിലന്ന് ഫുഡിന്റെ"
    },
    {
      "t": "08:00",
      "text": "വ"
    },
    {
      "t": "08:02",
      "text": "ഹൗസ്മസ്"
    },
    {
      "t": "08:04",
      "text": "ഫാക്ടറി ആണ് ഫുഡ്"
    },
    {
      "t": "08:06",
      "text": "ചപ്പ"
    },
    {
      "t": "08:08",
      "text": "ട്രക്കിങ് ഏ"
    },
    {
      "t": "08:10",
      "text": "പിംഗ"
    },
    {
      "t": "08:12",
      "text": "പരിപാടിക്ക മെഷീഫന്റെ"
    },
    {
      "t": "08:14",
      "text": "ആഹ"
    },
    {
      "t": "08:16",
      "text": "അപ്പ"
    },
    {
      "t": "08:18",
      "text": "അവിടെ നിന്ന് ഷെഫിന് പഠിക്കണം"
    },
    {
      "t": "08:20",
      "text": "ന അതുംല്ല"
    },
    {
      "t": "08:22",
      "text": "ഉം"
    },
    {
      "t": "08:24",
      "text": ""
    },
    {
      "t": "08:26",
      "text": "എന്നാലൊരു മാസം തേർട്ടി ഫൈവ് കിട്ടുവ"
    },
    {
      "t": "08:28",
      "text": "ആഹ വിട്ടോ"
    },
    {
      "t": "08:30",
      "text": "ഫുഡ് കഴിഞ്ഞു"
    },
    {
      "t": "08:32",
      "text": "എന്നട്ട് നാട്ടിൽ എന്താ ചച്ചോടക്കാൻ പറ്റോ"
    },
    {
      "t": "08:34",
      "text": ""
    },
    {
      "t": "08:36",
      "text": "നാട്ടിലേക്ക്ട്ട വണ്ടിയ"
    },
    {
      "t": "08:38",
      "text": "ച"
    },
    {
      "t": "08:40",
      "text": "ന യ"
    },
    {
      "t": "08:42",
      "text": "ഇനി ൊണ്ട ക"
    },
    {
      "t": "08:44",
      "text": "പ അ വല സ്ഥല"
    },
    {
      "t": "08:46",
      "text": "ടുന്ന"
    },
    {
      "t": "08:48",
      "text": "സ്റ്റാർട്ടിങ്് അങ്ങനെയൊക്കെ ഉണ്ടാവും പിെ"
    },
    {
      "t": "08:50",
      "text": "രടിയ"
    },
    {
      "t": "08:52",
      "text": "ഉ ആ പോട്ട്"
    },
    {
      "t": "08:54",
      "text": "ഈ ചിത്ര എല്ലാം ഉണ്ടോ"
    },
    {
      "t": "08:56",
      "text": "ഇ കൊച്ച ചരിത്ര"
    },
    {
      "t": "08:58",
      "text": "ോണ്ടപ്പ നിങ്ങളടെ"
    },
    {
      "t": "09:00",
      "text": "ന ആ ഓക്കെ"
    },
    {
      "t": "09:02",
      "text": "ഞാന ഇന്ന് ലേറ്റ് ആയിപ്പോയി"
    },
    {
      "t": "09:04",
      "text": "ഉൾഴരിക്ക"
    },
    {
      "t": "09:06",
      "text": "അപ്പോഴത്തേക്ക് കാഴ്ച"
    },
    {
      "t": "09:08",
      "text": "കഴിഞ്ഞപ്പോഴത്തേക്ക് ഉറങ്ങാൻ പറ്റില്ലല്ലോ"
    },
    {
      "t": "09:10",
      "text": "ച്ച ഡൈജഷൻണ്ടേ"
    },
    {
      "t": "09:12",
      "text": "ആ"
    },
    {
      "t": "09:14",
      "text": "പ്പം ഇതിനകത്ത് വിളിക്കണെങ്കിൽ"
    },
    {
      "t": "09:16",
      "text": "ആഹ രോണായി"
    },
    {
      "t": "09:18",
      "text": "സതിതിിച്ച"
    },
    {
      "t": "09:20",
      "text": "ആഹഹ"
    },
    {
      "t": "09:22",
      "text": "അങ്ങനെയള"
    },
    {
      "t": "09:24",
      "text": "ാൻ വേണ്ടി വന്ന കാരണം"
    },
    {
      "t": "09:26",
      "text": "പിന്നെ ഫോണില് ചജ"
    },
    {
      "t": "09:28",
      "text": "ഒട്ടും കഴിയല്ല"
    },
    {
      "t": "09:30",
      "text": "ഉ"
    },
    {
      "t": "09:32",
      "text": "ഉം"
    },
    {
      "t": "09:34",
      "text": "വ"
    },
    {
      "t": "09:36",
      "text": "ഹസ്പൻഡ്"
    },
    {
      "t": "09:38",
      "text": "പ്പ എെ ഞാൻ അടിച്ചു കള"
    },
    {
      "t": "09:40",
      "text": "ഉ"
    },
    {
      "t": "09:42",
      "text": "ഉ"
    },
    {
      "t": "09:44",
      "text": "അ"
    },
    {
      "t": "09:46",
      "text": "ഏ കഹണി"
    },
    {
      "t": "09:48",
      "text": "ആഹ അതെ"
    },
    {
      "t": "09:50",
      "text": "ീ"
    },
    {
      "t": "09:52",
      "text": "ആ"
    },
    {
      "t": "09:54",
      "text": "ചേച്ചി ലടാഡ"
    },
    {
      "t": "09:56",
      "text": "ആ"
    },
    {
      "t": "09:58",
      "text": "ഉ"
    },
    {
