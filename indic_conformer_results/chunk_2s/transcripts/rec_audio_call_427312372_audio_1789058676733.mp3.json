    {
      "t": "03:22",
      "text": "புரியலா"
    },
    {
      "t": "03:24",
      "text": "எட்டு வருர்ஷமாா இல்"
    },
    {
      "t": "03:26",
      "text": "கூட்டு வருசமாோ எல்ல"
