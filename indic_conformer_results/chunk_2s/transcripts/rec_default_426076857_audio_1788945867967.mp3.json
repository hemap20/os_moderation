{
  "file_id": "rec_default_426076857_audio_1788945867967.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 401.85,
  "processing_time_sec": 15.203294038772583,
  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "ஆ"
    },
    {
      "t": "00:04",
      "text": ""
    },
    {
      "t": "00:06",
      "text": "ஆஹ் எங்க இருந்து பேசுறீங்க"
    },
    {
      "t": "00:08",
      "text": "கன்னியாகுமரி நீங்க இருந்த"
    },
    {
      "t": "00:10",
      "text": "நான் கோயமத்தூ"
    },
    {
      "t": "00:12",
      "text": "உங்க பேர்"
    },
    {
      "t": "00:14",
      "text": "என் பே பாாஸ்கண"
    },
    {
      "t": "00:16",
      "text": "உங்க பேர்ன"
    },
    {
      "t": "00:18",
      "text": "ஓகே என்ன பண்றீங்க"
    },
    {
      "t": "00:20",
      "text": "நான் ஒர்க் பண்ணின்"
    },
    {
      "t": "00:22",
      "text": "ட்டு இருக்க ஒரு பிரைவேட் கம்பெனில்லாம் நீங்க"
    },
    {
      "t": "00:24",
      "text": "ந ஒரு பண்ணிட்டு இருக்கன் ஆயிட்டிலாம்"
    },
    {
      "t": "00:26",
      "text": "ஆஹம்்"
    },
    {
      "t": "00:28",
      "text": "கே ஓகே நீங்க மேரிடா"
    },
    {
      "t": "00:30",
      "text": "இல்ல சிங்க நீங்க"
    },
    {
      "t": "00:32",
      "text": "நானும் செங்கல் தான்"
    },
    {
      "t": "00:34",
      "text": "எந்த ஆப் எவ்வளவு நாளா யூஸ் பண்றீங்க"
    },
    {
      "t": "00:36",
      "text": "நான் ஒரு சிக்ஸ் டேஸ்யஸ் பண்றேன் நீங்க"
    },
    {
      "t": "00:38",
      "text": "தொோட சச்சி"
    },
    {
      "t": "00:40",
      "text": "உம் உம் அடி போயிட்டு இருக்கு"
    },
    {
      "t": "00:42",
      "text": ""
    },
    {
      "t": "00:44",
      "text": "ஓகே த"
    },
    {
      "t": "00:46",
      "text": "ம்"
    },
    {
      "t": "00:48",
      "text": "சொல்லுங்க அப்புறம்"
    },
    {
      "t": "00:50",
      "text": "லைஃப்ல அப்படி போயட்டு இருக்கேன்"
    },
    {
      "t": "00:52",
      "text": "நல்லா போயிட்டு இருக்கு"
    },
    {
      "t": "00:54",
      "text": "உங்களுக்கு உம் நல்லா போயிட்டு இருக்கேன்"
    },
    {
      "t": "00:56",
      "text": "உம்"
    },
    {
      "t": "00:58",
      "text": ""
    },
    {
      "t": "01:00",
      "text": "அப்புறம்"
    },
    {
      "t": "01:02",
      "text": ""
    },
    {
      "t": "01:04",
      "text": ""
    },
    {
      "t": "01:06",
      "text": "என் வீட்டு அலன்ஸ் பாத்துட்டு இருக்கேன்ும்"
    },
    {
      "t": "01:08",
      "text": "இல்ல லோ பண்றீங்க மே"
    },
    {
      "t": "01:10",
      "text": "பாத்துட்டு இருக்காங்க நாலும்"
    },
    {
      "t": "01:12",
      "text": "எல்லாம் பண்ணலாம்"
    },
    {
      "t": "01:14",
      "text": "என்ன"
    },
    {
      "t": "01:16",
      "text": "வி நன்"
    },
    {
      "t": "01:18",
      "text": "ஆஹ் ஓகே"
    },
    {
      "t": "01:20",
      "text": "உம்"
    },
    {
      "t": "01:22",
      "text": ""
    },
    {
      "t": "01:24",
      "text": "சொல்லுங்க அப்பம்"
    },
    {
      "t": "01:26",
      "text": "வேற என்ன"
    },
    {
      "t": "01:28",
      "text": "உஹம்"
    },
    {
      "t": "01:30",
      "text": "ரெண்டு நாள் எப்படி பேசிட்டு இருந்தாங்களா"
    },
    {
      "t": "01:32",
      "text": "கரோம்"
    },
    {
      "t": "01:34",
      "text": "பரவாயில்ல ஓகே தான்"
    },
    {
      "t": "01:36",
      "text": "ஓவவர் ஜட்ஜ்மெண்ட்"
    },
    {
      "t": "01:38",
      "text": "உம் உஹம் உம்"
    },
    {
      "t": "01:40",
      "text": "ஓகே"
    },
    {
      "t": "01:42",
      "text": "உம்"
    },
    {
      "t": "01:44",
      "text": "நான் இதுவரை யாரிட்டையும் அப்படியே ஒழுங்க"
    },
    {
      "t": "01:46",
      "text": "சல்ல உம்"
    },
    {
      "t": "01:48",
      "text": "சொல்லாமல"
    },
    {
      "t": "01:50",
      "text": "கட் பண்ணிட்டு போறாங்க பேச"
    },
    {
      "t": "01:52",
      "text": "க்கிட்டே இருக்கும் அப்புறம் வேற"
    },
    {
      "t": "01:54",
      "text": "நிறைய ரொம்ப ஜஜ்மெண்டல்"
    },
    {
      "t": "01:56",
      "text": "நீங்க எதுக்குூர்ல"
    },
    {
      "t": "01:58",
      "text": "நான் தனியா இருக்கனாலும்"
    },
    {
      "t": "02:00",
      "text": "ஒர்க் பண்றேன் ச யூஸ் பண்றேன்"
    },
    {
      "t": "02:02",
      "text": "கே கே கன்னியாகுமரிம் தனியா"
    },
    {
      "t": "02:04",
      "text": "இருக்கீங்களா இல்ல"
    },
    {
      "t": "02:06",
      "text": "நான் பெங்களூர்ல ஒர்க் பண்ணிட்டு இருக்கேன்"
    },
    {
      "t": "02:08",
      "text": "இங்க பேஜ எல்லாம் தனியா இருப்பேன்"
    },
    {
      "t": "02:10",
      "text": "ஆஹ நைட் ஷிப்ட் ர்கக்கு"
    },
    {
      "t": "02:12",
      "text": "டே டைம் தனியா தான் இருப்பேன் ஃபுல்லா"
    },
    {
      "t": "02:14",
      "text": "சரி ஓபன் பண்ணி பா"
    },
    {
      "t": "02:16",
      "text": "னு வந்தேன் எங்க இருக்கீ"
    },
    {
      "t": "02:18",
      "text": "ளே போக வேண்டிதானே அப்ப ஏன் இங்க இருக்கே"
    },
    {
      "t": "02:20",
      "text": "இந்த டாபிக பா"
    },
    {
      "t": "02:22",
      "text": "ப வெளியே போனும்ன்னனு சோணும்ாது"
    },
    {
      "t": "02:24",
      "text": "சிக்னல்லல எவ்வளவு நேரம் நிற்க வேண்டியது இருக்கும்"
    },
    {
      "t": "02:26",
      "text": "ரொம்ப கஷ்டம்"
    },
    {
      "t": "02:28",
      "text": "சரி சரி சரி"
    },
    {
      "t": "02:30",
      "text": ""
    },
    {
      "t": "02:32",
      "text": "உம்ம்"
    },
    {
      "t": "02:34",
      "text": "உங்களுக்கு எப்படி பரவாயில்லையா வர்ற கால் செல்லலாம்"
    },
    {
      "t": "02:36",
      "text": "ஆ"
    },
    {
      "t": "02:38",
      "text": "நான் அவ்வளா யூஸ் பண்ண மாட்டேன் பேப்பாச்சுான்"
    },
    {
      "t": "02:40",
      "text": "ம்"
    },
    {
      "t": "02:42",
      "text": ""
    },
    {
      "t": "02:44",
      "text": "என்"
    },
    {
      "t": "02:46",
      "text": "ஃப்ரெண்டு கிடைச்சாங்களா இல்ல"
    },
    {
      "t": "02:48",
      "text": "ஆஹ்ஹ நான் தான் சொன்னே"
    },
    {
      "t": "02:50",
      "text": "யாருக்கிட்டடைமே ஒழுங்கா பேசல"
    },
    {
      "t": "02:52",
      "text": "ஜஸ்ட் வருவேன் ஒரு டூ த்ரீ காால்ஸ்"
    },
    {
      "t": "02:54",
      "text": "அ பண்ணுவ"
    },
    {
      "t": "02:56",
      "text": "கடுப்பா இருக்கும் அதந்தெல்லாம் மூடி வச்ச"
    },
    {
      "t": "02:58",
      "text": "வச்சட்டு போயிருவேன் நைய"
    },
    {
      "t": "03:00",
      "text": "ரெண்டு நாள் அப்படிதான் போச்சுன்னைக்கு தே"
    },
    {
      "t": "03:02",
      "text": "பீஸ் பண்றீங்க"
    },
    {
      "t": "03:04",
      "text": "இது பரவாயில்லல"
    },
    {
      "t": "03:06",
      "text": "எல்லாம் போட்டுிருந்தாங்க ஓகே"
    },
    {
      "t": "03:08",
      "text": "டீசெண்டடா தான் பேசுவாங்களா இருக்கும் ஜட்"
    },
    {
      "t": "03:10",
      "text": "பண்ணாம பேசுவாங்கன்னு நினைச்சேன்"
    },
    {
      "t": "03:12",
      "text": "பாத்தா எல்லாரும்"
    },
    {
      "t": "03:14",
      "text": "சர்ச்் பண்ணிட்டு இருக்காங்க பெங்களூருனு சொன்னோன்னே"
    },
    {
      "t": "03:16",
      "text": "ஏ அப்போ"
    },
    {
      "t": "03:18",
      "text": "்் இஸ் யர் பாடி கவுண்டு"
    },
    {
      "t": "03:20",
      "text": "அது என்னே"
    },
    {
      "t": "03:22",
      "text": "கேக்குறோான் நம்ம கொஞ்சம் களோஸா"
    },
    {
      "t": "03:24",
      "text": "பேச ஆரம்பிச்சாச்சுன்னா அதுவும் வரும்"
    },
    {
      "t": "03:26",
      "text": "ஸ்டி்லேப்படி ஒரு கொஸ்டன் கேட்டாச்சன்னா"
    },
    {
      "t": "03:28",
      "text": "ஏ அப்ப நீ கஞ்சா அடிப்பதானே சிகரெட்"
    },
    {
      "t": "03:30",
      "text": "அடிப்பதானே அப்போ அப்படி பண்றவங்க எல்லாம் தப்பா"
    },
    {
      "t": "03:32",
      "text": "அது அவக்கு சாயஸ்"
    },
    {
      "t": "03:34",
      "text": "எதுக்கு தப்பாட்டு பண்ணனும் என்கிட்ட"
    },
    {
      "t": "03:36",
      "text": "அது ஏதோ ஒரு பெரிய இது போல கேக்குறாங்க"
    },
    {
      "t": "03:38",
      "text": "நான் சொல்ல"
    },
    {
      "t": "03:40",
      "text": "கே கே ே"
    },
    {
      "t": "03:42",
      "text": ""
    },
    {
      "t": "03:44",
      "text": ""
    },
    {
      "t": "03:46",
      "text": "சொல்ல"
    },
    {
      "t": "03:48",
      "text": "அப்புறம் நீங்க ஏதாச்சும் கேளுங்க"
    },
    {
      "t": "03:50",
      "text": "எதை பத்தி கேக்குறது"
    },
    {
      "t": "03:52",
      "text": "எந்தச்ச"
    },
    {
      "t": "03:54",
      "text": "ங்க உங்களுக்கு என்ன கேக்குன்னுோு"
    },
    {
      "t": "03:56",
      "text": "கேளுங்க"
    },
    {
      "t": "03:58",
      "text": "சத்தியமா நான் பேசுறாலே"
    },
    {
      "t": "04:00",
      "text": "கிடையாது நான் லசனர் மாதிரி"
    },
    {
      "t": "04:02",
      "text": "யாராவது பேசிட்டு வந்தா கேட்டுட்டு இருப்பேன்"
    },
    {
      "t": "04:04",
      "text": "எனக்காட்டு பேச தெரியாது சத்தியம்"
    },
    {
      "t": "04:06",
      "text": ""
    },
    {
      "t": "04:08",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "04:10",
      "text": ""
    },
    {
      "t": "04:12",
      "text": ""
    },
    {
      "t": "04:14",
      "text": "நாங்க எப்படி இருக்கு பெங்களூர்ல"
    },
    {
      "t": "04:16",
      "text": "போய் எவ்ளோ நல்லாச்சு பெங்களூர்ல"
    },
    {
      "t": "04:18",
      "text": "ஆான் டூ இயர்ஸா பெங்களூர்ல தான் இருக்கேன்"
    },
    {
      "t": "04:20",
      "text": "தூர் சாவ"
    },
    {
      "t": "04:22",
      "text": "ஆஹ"
    },
    {
      "t": "04:24",
      "text": "எடி போயட்டு இருக்க"
    },
    {
      "t": "04:26",
      "text": "நல்லா போயிட்டு இருக்கு"
    },
    {
      "t": "04:28",
      "text": "எங்கேயாச்சும் வெல்லிய போனீங்களா"
    },
    {
      "t": "04:30",
      "text": "நான் ரொம்ப போக மாட்டேன்"
    },
    {
      "t": "04:32",
      "text": "ஏன்னா இங்க டிராபிகிக்கே ஜாஸ்தியா இருக்குமா"
    },
    {
      "t": "04:34",
      "text": "போறது"
    },
    {
      "t": "04:36",
      "text": "க"
    },
    {
      "t": "04:38",
      "text": "அவ்வளோதான் மத்தபடி பெங்களூர்ல பாக்குறது"
    },
    {
      "t": "04:40",
      "text": "இதுக்கு வேற எந்த இடமே இல்ல"
    },
    {
      "t": "04:42",
      "text": "ஆ"
    },
    {
      "t": "04:44",
      "text": "ேஓகே யரு நீங்க ஃரெண்ட்ஸோட போயீங்களா"
    },
    {
      "t": "04:46",
      "text": "ஜி ண்டோட"
    },
    {
      "t": "04:48",
      "text": "ஆ பிஜி ஃப்ரண்ட்ஸ் கூட இல்ல ஆபீஸ் ம மேட்ஸ்"
    },
    {
      "t": "04:50",
      "text": "பீஸ் பல"
    },
    {
      "t": "04:52",
      "text": "போய தருங்களாா"
    },
    {
      "t": "04:54",
      "text": "பி மேக்ஸ் அப்படின்ா அவங்களுக்கு வேற கமெ"
    },
    {
      "t": "04:56",
      "text": "நினைச்சிருக்கோம் அவங்கள நம்ம கூட"
    },
    {
      "t": "04:58",
      "text": "சேர்க்க முடியாது"
    },
    {
      "t": "05:00",
      "text": "கலீக்ஸ் கூட போயிட்டு வாா"
    },
    {
      "t": "05:02",
      "text": "ஓகே கே எங்க"
    },
    {
      "t": "05:04",
      "text": "உடம்பங்களா போவீங்களா"
    },
    {
      "t": "05:06",
      "text": "கோரமங்கலல்லாம் மாட்டோம்ல இந்திரா நகர்"
    },
    {
      "t": "05:08",
      "text": "ஓகே"
    },
    {
      "t": "05:10",
      "text": "ங்க மரத்தி அந்த மாதிரி போயிட்டு"
    },
    {
      "t": "05:12",
      "text": "ங்கள ஆஹ் மாரத்தா"
    },
    {
      "t": "05:14",
      "text": "பள்ளி இல்ல சர்ஜாப்பூர் போயிருக்கேன்"
    },
    {
      "t": "05:16",
      "text": "அப்புறம் வந்து இங்க கோரமங்கலம்"
    },
    {
      "t": "05:18",
      "text": "ஓகே ஓகே உ"
    },
    {
      "t": "05:20",
      "text": "நீங்க போனாலும் எந்த ப போ உங்க புடிச்சிருச்சு ரொம்ப"
    },
    {
      "t": "05:22",
      "text": ""
    },
    {
      "t": "05:24",
      "text": "எனக்கா எனக்கு ஒரு பப்பும் பிடிக்கல"
    },
    {
      "t": "05:26",
      "text": "ஏய"
    },
    {
      "t": "05:28",
      "text": "எனக்கு பிடிக்கல"
    },
    {
      "t": "05:30",
      "text": "நான் சும்மா கம்பெனி குடுக்கணும்னு போன்"
    },
    {
      "t": "05:32",
      "text": "ஏன்னா நம்ம இப்போ டீம்மேட்ஸ் கூட"
    },
    {
      "t": "05:34",
      "text": "போகல அப்படனு நம்மளை காலர் பண்ணிடுவாங்க"
    },
    {
      "t": "05:36",
      "text": "அப்பல சவுண்ட் கட்டன்னு சொல்லுவோம்"
    },
    {
      "t": "05:38",
      "text": "வாங்க நமக்கு லேபிள் குத்திரும்"
    },
    {
      "t": "05:40",
      "text": "ங்க இவ டிரரெண்ட்லயே இல்ல அப்படின்னா"
    },
    {
      "t": "05:42",
      "text": "ஆனாலா சும்மா கூட போவேன் எனக்கு"
    },
    {
      "t": "05:44",
      "text": "அங்க உள்ள அந்த என்ம"
    },
    {
      "t": "05:46",
      "text": "் அவ்வளவோ பிடிக்கல"
    },
    {
      "t": "05:48",
      "text": "சமா"
    },
    {
      "t": "05:50",
      "text": "வங்க என்ஜாய் பண்றத பாக்குறதுக்கு பிடிக்கும்"
    },
    {
      "t": "05:52",
      "text": "து ஆனா நான் வந்து அதுல கலந்துக்க"
    },
    {
      "t": "05:54",
      "text": "மாட்டேன் நீ இன்டர்"
    },
    {
      "t": "05:56",
      "text": ""
    },
    {
      "t": "05:58",
      "text": "இன்றோ விட்டுன்னனு சொல்ல முடியாது எனக்கு"
    },
    {
      "t": "06:00",
      "text": "சில பழக்கம் பழக்கம் பிடிக்காது அவ்ளவுதான்"
    },
    {
      "t": "06:02",
      "text": "அந்த ட்ஸ்"
    },
    {
      "t": "06:04",
      "text": "சிகார் அங்க அங்க அங்க"
    },
    {
      "t": "06:06",
      "text": "வ டான்ஸ் அவ ம"
    },
    {
      "t": "06:08",
      "text": "ங்க என்ஜாய் பண்றதை பாறது பிடிக்கும் பட்"
    },
    {
      "t": "06:10",
      "text": "அந்த பிளேஸ்ல இருக்க மாட்டேன்"
    },
    {
      "t": "06:12",
      "text": "றைய உம்"
    },
    {
      "t": "06:14",
      "text": ""
    },
    {
      "t": "06:16",
      "text": "நீங்களே உங்களுக்கு ரெஸ்ட்ரிக்ஷனா இருக்கீங்களா"
    },
    {
      "t": "06:18",
      "text": "ப்பதி விஷயத்துல"
    },
    {
      "t": "06:20",
      "text": "அப்படிய எல்லாம் இல்ல சில விஷயத்துல கட்டுப்பாடு"
    },
    {
      "t": "06:22",
      "text": "இருக்கிறது நல்லது"
    },
    {
      "t": "06:24",
      "text": "கரெக்ட தான்"
    },
    {
      "t": "06:26",
      "text": ""
    },
    {
      "t": "06:28",
      "text": ""
    },
    {
      "t": "06:30",
      "text": ""
    },
    {
      "t": "06:32",
      "text": "ஏன்னா என்னோட பாயிண்ட் ஆஃப் வியூல சில விஷயங்கள்"
    },
    {
      "t": "06:34",
      "text": "வந்து நான் எடுத்துக்கிறது அதான்"
    },
    {
      "t": "06:36",
      "text": "என்ா ஆமா"
    },
    {
      "t": "06:38",
      "text": "மத்தங்க மத்தவங்களுக்கு"
    },
    {
      "t": "06:40",
      "text": "வேண்டி என்ன மாத்திக்க கூடாதுல்ல"
    }
  ],
  "full_text": " ஆ  ஆஹ் எங்க இருந்து பேசுறீங்க கன்னியாகுமரி நீங்க இருந்த நான் கோயமத்தூ உங்க பேர் என் பே பாாஸ்கண உங்க பேர்ன ஓகே என்ன பண்றீங்க நான் ஒர்க் பண்ணின் ட்டு இருக்க ஒரு பிரைவேட் கம்பெனில்லாம் நீங்க ந ஒரு பண்ணிட்டு இருக்கன் ஆயிட்டிலாம் ஆஹம்் கே ஓகே நீங்க மேரிடா இல்ல சிங்க நீங்க நானும் செங்கல் தான் எந்த ஆப் எவ்வளவு நாளா யூஸ் பண்றீங்க நான் ஒரு சிக்ஸ் டேஸ்யஸ் பண்றேன் நீங்க தொோட சச்சி உம் உம் அடி போயிட்டு இருக்கு  ஓகே த ம் சொல்லுங்க அப்புறம் லைஃப்ல அப்படி போயட்டு இருக்கேன் நல்லா போயிட்டு இருக்கு உங்களுக்கு உம் நல்லா போயிட்டு இருக்கேன் உம்  அப்புறம்   என் வீட்டு அலன்ஸ் பாத்துட்டு இருக்கேன்ும் இல்ல லோ பண்றீங்க மே பாத்துட்டு இருக்காங்க நாலும் எல்லாம் பண்ணலாம் என்ன வி நன் ஆஹ் ஓகே உம்  சொல்லுங்க அப்பம் வேற என்ன உஹம் ரெண்டு நாள் எப்படி பேசிட்டு இருந்தாங்களா கரோம் பரவாயில்ல ஓகே தான் ஓவவர் ஜட்ஜ்மெண்ட் உம் உஹம் உம் ஓகே உம் நான் இதுவரை யாரிட்டையும் அப்படியே ஒழுங்க சல்ல உம் சொல்லாமல கட் பண்ணிட்டு போறாங்க பேச க்கிட்டே இருக்கும் அப்புறம் வேற நிறைய ரொம்ப ஜஜ்மெண்டல் நீங்க எதுக்குூர்ல நான் தனியா இருக்கனாலும் ஒர்க் பண்றேன் ச யூஸ் பண்றேன் கே கே கன்னியாகுமரிம் தனியா இருக்கீங்களா இல்ல நான் பெங்களூர்ல ஒர்க் பண்ணிட்டு இருக்கேன் இங்க பேஜ எல்லாம் தனியா இருப்பேன் ஆஹ நைட் ஷிப்ட் ர்கக்கு டே டைம் தனியா தான் இருப்பேன் ஃபுல்லா சரி ஓபன் பண்ணி பா னு வந்தேன் எங்க இருக்கீ ளே போக வேண்டிதானே அப்ப ஏன் இங்க இருக்கே இந்த டாபிக பா ப வெளியே போனும்ன்னனு சோணும்ாது சிக்னல்லல எவ்வளவு நேரம் நிற்க வேண்டியது இருக்கும் ரொம்ப கஷ்டம் சரி சரி சரி  உம்ம் உங்களுக்கு எப்படி பரவாயில்லையா வர்ற கால் செல்லலாம் ஆ நான் அவ்வளா யூஸ் பண்ண மாட்டேன் பேப்பாச்சுான் ம்  என் ஃப்ரெண்டு கிடைச்சாங்களா இல்ல ஆஹ்ஹ நான் தான் சொன்னே யாருக்கிட்டடைமே ஒழுங்கா பேசல ஜஸ்ட் வருவேன் ஒரு டூ த்ரீ காால்ஸ் அ பண்ணுவ கடுப்பா இருக்கும் அதந்தெல்லாம் மூடி வச்ச வச்சட்டு போயிருவேன் நைய ரெண்டு நாள் அப்படிதான் போச்சுன்னைக்கு தே பீஸ் பண்றீங்க இது பரவாயில்லல எல்லாம் போட்டுிருந்தாங்க ஓகே டீசெண்டடா தான் பேசுவாங்களா இருக்கும் ஜட் பண்ணாம பேசுவாங்கன்னு நினைச்சேன் பாத்தா எல்லாரும் சர்ச்் பண்ணிட்டு இருக்காங்க பெங்களூருனு சொன்னோன்னே ஏ அப்போ ்் இஸ் யர் பாடி கவுண்டு அது என