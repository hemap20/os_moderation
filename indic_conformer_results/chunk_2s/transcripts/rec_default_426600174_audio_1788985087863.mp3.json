  "segments": [
    {
      "t": "00:00",
      "text": "അ"
    },
    {
      "t": "00:02",
      "text": ""
    },
    {
      "t": "00:04",
      "text": "ഹല"
    },
    {
      "t": "00:06",
      "text": "അസലം"
    },
    {
      "t": "00:08",
      "text": "ടെ"
    },
    {
      "t": "00:10",
      "text": "കോഴിക്കോട് ഇതവിടെ"
    },
    {
      "t": "00:12",
      "text": "ഇിക്കാണ് കട്ടപ്പഴ"
    },
    {
      "t": "00:14",
      "text": "ഉ"
    },
    {
      "t": "00:16",
      "text": "എന്തായിന്നോ"
    },
    {
      "t": "00:18",
      "text": "നാനേ വർക്കേ ന"
    },
    {
      "t": "00:20",
      "text": "ോഓർരുന്നത് കേക്കാമോ"
    },
    {
      "t": "00:22",
      "text": "ആ"
    },
    {
      "t": "00:24",
      "text": "ആഹ"
    },
    {
      "t": "00:26",
      "text": "ഹലോ"
    },
    {
      "t": "00:28",
      "text": "പായ അല"
    },
    {
      "t": "00:30",
      "text": "ഇല്ല കൊറോയില്ല"
    },
    {
      "t": "00:32",
      "text": "ല്ല ഒരു മാസമൊക്കെ വല്ലപ്പോഴ കറുള്ളൂ"
    },
    {
      "t": "00:34",
      "text": "ലെ ക"
    },
    {
      "t": "00:36",
      "text": "ഇല്ല"
    },
    {
      "t": "00:38",
      "text": "എപ്പോഴും വേററില്ലല്ലോ ൻ"
    },
    {
      "t": "00:40",
      "text": "അ ശ"
    },
    {
      "t": "00:42",
      "text": "ഉ ഇപ്പ എവിടെ കീട്ടിലോ"
    },
    {
      "t": "00:44",
      "text": "അ നാട്ടിലുള്ള"
    },
    {
      "t": "00:46",
      "text": ""
    },
    {
      "t": "00:48",
      "text": "നാട്ട"
    },
    {
      "t": "00:50",
      "text": "പിന്നെ"
    },
    {
      "t": "00:52",
      "text": "ഇതൊക്കെ ഇണ്ട്"
    },
    {
      "t": "00:54",
      "text": "സ് പോ"
    },
    {
      "t": "00:56",
      "text": "വീട്ടിലാണപ്പം"
    },
    {
      "t": "00:58",
      "text": "എക്കാ ഉള്ളത്"
    },
    {
      "t": "01:00",
      "text": "കിട്ട അ"
    },
    {
      "t": "01:02",
      "text": "അല് മക്കളുണ്ട്"
    },
    {
      "t": "01:04",
      "text": "ഞാനുണ്ട് മാഡ"
    },
    {
      "t": "01:06",
      "text": "ഇ ാ"
    },
    {
      "t": "01:08",
      "text": "ണ്ട്"
    },
    {
      "t": "01:10",
      "text": "ഹസ്ബൻഡ് ജോലിക്ക് പോയി"
    },
    {
      "t": "01:12",
      "text": "ഉ നക്ക"
    },
    {
      "t": "01:14",
      "text": "മക്കളെ"
    },
    {
      "t": "01:16",
      "text": "കൊറക്കാണ് ഇ കുറച്ച് വ"
    },
    {
      "t": "01:18",
      "text": "ഉണ്ടരുന്നൊക്കെ കഴിച്ചിട്ട് ഇനെ ഇരിക്കുന്നുന്നുള്ളൂ"
    },
    {
      "t": "01:20",
      "text": "ഓ ശരി"
    },
    {
      "t": "01:22",
      "text": "ഉ"
    },
    {
      "t": "01:24",
      "text": "ഒറക്കെ വന്നില്ലപ്പ ചുമ്മാ കയറിറ"
    },
    {
      "t": "01:26",
      "text": "ൂട്ടി രാവിലെ"
    },
    {
      "t": "01:28",
      "text": "ഉറങ്ങി എണീറ്റ്ു പോ"
    },
    {
      "t": "01:30",
      "text": "ഓർക്കുമ്പോഴ"
    },
    {
      "t": "01:32",
      "text": "ത"
    },
    {
      "t": "01:34",
      "text": "എഴുതാുണ്ടായിരുന്ന"
    },
    {
      "t": "01:36",
      "text": "അതൊക്കെ കഴിഞ്ഞപ്പോ ഇങ്ങനെ"
    },
    {
      "t": "01:38",
      "text": "പിന്ന് ഫ്രണ്ട്സിനെ കിട്ടിയാ"
    },
    {
      "t": "01:40",
      "text": "ഇല്ലല്ലൈ"
    },
    {
      "t": "01:42",
      "text": "ത അതല്ല"
    },
    {
      "t": "01:44",
      "text": "മ പത്ത് മാസംമായിന്ന് പറല്ലേ"
    },
    {
      "t": "01:46",
      "text": ""
    },
    {
      "t": "01:48",
      "text": "മത്തല്ല വൺ മന്ത് ഒരു മാസയി"
    },
    {
      "t": "01:50",
      "text": "ആലവാസല്ല"
    },
    {
      "t": "01:52",
      "text": "അ"
    },
    {
      "t": "01:54",
      "text": "ദ ലോക്ക"
    },
    {
      "t": "01:56",
      "text": "അങ്ങനെ"
    },
    {
      "t": "01:58",
      "text": "എന്താ വാലോട്ട ച അവയ്ക്കന്നെ"
    },
    {
      "t": "02:00",
      "text": "ഏല്ലോ"
    },
    {
      "t": "02:02",
      "text": "ഉം"
    },
    {
      "t": "02:04",
      "text": "ഒന്നുമല്ല"
    },
    {
      "t": "02:06",
      "text": "ഞാന ചോദ രാത്രി"
    },
    {
      "t": "02:08",
      "text": "ക്കണോ"
    },
    {
      "t": "02:10",
      "text": "ക്ക"
    },
    {
      "t": "02:12",
      "text": "പില്ല പറ"
    },
    {
      "t": "02:14",
      "text": "എന്താ വർക്ക്"
    },
    {
      "t": "02:16",
      "text": "എക്കണല്"
    },
    {
      "t": "02:18",
      "text": ""
    },
    {
      "t": "02:20",
      "text": "പിന്ന നാളെ"
    },
    {
      "t": "02:22",
      "text": "ആണ്ട് ഉണ്ട്"
    },
    {
      "t": "02:24",
      "text": "ഉ"
    },
    {
      "t": "02:26",
      "text": "പിന്നെ"
    },
    {
      "t": "02:28",
      "text": "ഉണ്ടൊക്കെ അടിച്ചോ"
    },
    {
      "t": "02:30",
      "text": "ഓ ഫുഡ് അടിച്ചൊക്കെ കടന്നു ഞെ"
    },
    {
      "t": "02:32",
      "text": "പണട്ടർപ്പോ"
    },
    {
      "t": "02:34",
      "text": "റക്ക കഴല്ല"
    },
    {
      "t": "02:36",
      "text": "ആഹ അ"
    },
    {
      "t": "02:38",
      "text": "പിന്നെ"
    },
    {
      "t": "02:40",
      "text": "പി"
    },
    {
      "t": "02:42",
      "text": "ആ"
    },
    {
      "t": "02:44",
      "text": ""
    },
    {
      "t": "02:46",
      "text": "ഇങ്ങനെ കൂട്ടുകാരൊ ക കേട്ടിയോ"
    },
    {
      "t": "02:48",
      "text": "ഇന്തന്താ"
    },
    {
      "t": "02:50",
      "text": "അങ്ങനെ അറിക്ക ഫ്രണ്ട്സ് ഒന്നുമല്ല"
    },
    {
      "t": "02:52",
      "text": "ഉം"
    },
    {
      "t": "02:54",
      "text": "സരി പത്ര"
    },
    {
      "t": "02:56",
      "text": "ആഹ"
    },
    {
      "t": "02:58",
      "text": "ഇ ഫസ്റ്റ് പോള"
    },
    {
      "t": "03:00",
      "text": "ആഹ് പ്രസി"
    },
    {
      "t": "03:02",
      "text": "ഉ"
    },
    {
      "t": "03:04",
      "text": "എന്തൊക്കെയാ സംസാരിക്കാറ്"
    },
    {
      "t": "03:06",
      "text": "എന്ത്"
    },
    {
      "t": "03:08",
      "text": "അംർത്തം പറഞ്ഞ"
    },
    {
      "t": "03:10",
      "text": "എല്ലാവ സംസാരിച്ചിക്ക"
    },
    {
      "t": "03:12",
      "text": "ഉം"
    },
    {
      "t": "03:14",
      "text": "ഉന്താച്ച"
    },
    {
      "t": "03:16",
      "text": "ഹന്തോ"
    },
    {
      "t": "03:18",
      "text": "എന്താനസാരിച്ചിരിക്ക"
    },
    {
      "t": "03:20",
      "text": "എനിക്കിഷ്ടോ എനിക്ക്"
    },
    {
      "t": "03:22",
      "text": "അങ്ങനെയൊന്നുമല്ല ഞാൻ സംസാരിക്കുമല്ല"
    },
    {
      "t": "03:24",
      "text": "എനിക്ക്"
    },
    {
      "t": "03:26",
      "text": "ആ ഒരുത്തരി കാെ ോദിക്കണോ"
    },
    {
      "t": "03:28",
      "text": "നോർമൽ പോൾ ആണോ ഓട്ടോ ഓപ്പൺ ഡോർ"
    },
    {
      "t": "03:30",
      "text": "ണോ അങ്ങനെയൊക്കെോ നമ്മ"
    },
    {
      "t": "03:32",
      "text": "അപ്പ മൂട അളക്ക"
    },
    {
      "t": "03:34",
      "text": "സംസാരിക്ക ഓപ്പോ"
    },
    {
      "t": "03:36",
      "text": "സംസാരിച്ചിട്ടില്ല സം"
    },
    {
      "t": "03:38",
      "text": "ഡലി് സംസാരിക്കും"
    },
    {
      "t": "03:40",
      "text": "അത"
    },
    {
      "t": "03:42",
      "text": "അപ്പൊ ഉണ്ടക്കതി"
    },
    {
      "t": "03:44",
      "text": "ഇിലപ്പതില്"
    },
    {
      "t": "03:46",
      "text": "പ്പണ്ടോപ്പ അങ്ങനെ ചെയ്തില്ല"
    },
    {
      "t": "03:48",
      "text": "ഞാനിങ്ങനെ ഓരുര് പറഞ്ഞൊക്കെ"
    },
    {
      "t": "03:50",
      "text": "പറയുന്നൊക്കെ കേട്ടോണ്ടൊക്കെ ഇരുന്നിട്ടുണ്ട്"
    },
    {
      "t": "03:52",
      "text": "അത ഇത്"
    },
    {
      "t": "03:54",
      "text": "കപ്പിൾസ്ൊക്കെ ആയിട്ടൊക്കെ എങ്ങനെ"
    },
    {
      "t": "03:56",
      "text": "അതൊക്കെ നിനക്കായിട്ടുണ്ട്"
    },
    {
      "t": "03:58",
      "text": "അല്ലോ"
    },
    {
      "t": "04:00",
      "text": "ഉ വേറെൊന്നുംല്ല"
    },
    {
      "t": "04:02",
      "text": "അ ശരി"
    },
    {
      "t": "04:04",
      "text": "എന്തന്നെ"
    },
    {
      "t": "04:06",
      "text": "ആ"
    },
    {
      "t": "04:08",
      "text": "ഇപ്പക്ക"
    },
    {
      "t": "04:10",
      "text": "ഇപ്പ ഈ ഡ്യൂട്ടി കെ കഴ"
    },
    {
      "t": "04:12",
      "text": "ഇനി വരുന്നവരൊക്കെ ഉണ്ട് പുറത്തൊക്കെ ഉള്ളതൊക്കെ"
    },
    {
      "t": "04:14",
      "text": "അപ്പൊ അങ്ങനുള്ള"
    },
    {
      "t": "04:16",
      "text": "സംസാരിക്ക ഇഷ്ടമാണ്"
    },
    {
      "t": "04:18",
      "text": "ഇങ്ങനെ"
    },
    {
      "t": "04:20",
      "text": "ഉം"
    },
    {
      "t": "04:22",
      "text": "ആ"
