    {
      "t": "00:02",
      "text": "உஹ்"
    },
    {
      "t": "00:04",
      "text": "ஹலோ"
    },
    {
      "t": "00:06",
      "text": ""
    },
    {
      "t": "00:08",
      "text": ""
    },
    {
      "t": "00:10",
      "text": "ஹல ஆஹ் சொல்லுங்க"
    },
    {
      "t": "00:12",
      "text": "கா உம் எனக்கு"
    },
    {
      "t": "00:14",
      "text": "இத்தக்கா"
    },
    {
      "t": "00:16",
      "text": "உம் க எ இருத்தேனியா"
    },
    {
      "t": "00:18",
      "text": "ந ஜர்"
    },
    {
      "t": "00:20",
      "text": "உம் என்ன பண்ற"
    },
    {
      "t": "00:22",
      "text": "சமா"
    },
    {
      "t": "00:24",
      "text": "உம்"
    },
    {
      "t": "00:26",
      "text": "சரி சரி ஆ"
    },
    {
      "t": "00:28",
      "text": "அவள சேபா இருக்க"
    },
    {
      "t": "00:30",
      "text": "சரி சரி ந"
    },
    {
      "t": "00:32",
      "text": "மாதிரி ஒர்க் பண்ணிட்டு இருக்கேன்"
    },
    {
      "t": "00:34",
      "text": "ஓம்"
    },
    {
      "t": "00:36",
      "text": "உக்காச்சங்களா என்ன இன்னைக்கு வக்கா"
    },
    {
      "t": "00:38",
      "text": "ீயா இ"
    },
    {
      "t": "00:40",
      "text": ""
    },
    {
      "t": "00:42",
      "text": "ஓகே உம்"
    },
    {
      "t": "00:44",
      "text": "உம் சரி சரி"
    },
    {
      "t": "00:46",
      "text": "போ"
    },
    {
      "t": "00:48",
      "text": "ஹம்"
    },
    {
      "t": "00:50",
      "text": "ஜித்தல்ல அப்படி இருக்காங்க"
    },
    {
      "t": "00:52",
      "text": "ஹலக்க ந"
    },
    {
      "t": "00:54",
      "text": "நல்லா இருக்காங்க"
    },
    {
      "t": "00:56",
      "text": "உம் நீ"
    },
    {
      "t": "00:58",
      "text": "உம்"
    },
    {
      "t": "01:00",
      "text": "நீங்க தான் ஒருத்துக்கு பொலையன்ற"
    },
    {
      "t": "01:02",
      "text": "தெரியலல்ல ரெண்டு பசங்க இருக்காங்க"
    },
    {
      "t": "01:04",
      "text": "அவங்க பாாரத்துக்கறிறதுக்கு"
    },
    {
      "t": "01:06",
      "text": "வீட்ட யாரும் கிடையாது"
    },
    {
      "t": "01:08",
      "text": "சரி சரி"
    },
    {
      "t": "01:10",
      "text": "இருக்காங்க ஆனா பாத்துுக்கறக்கலாம்"
    },
    {
      "t": "01:12",
      "text": "நம்ம பசங்களை பாத்துக்கறிறதுனால நம்ம தான"
    },
    {
      "t": "01:14",
      "text": "பெத்தோ நாமதான பார்த்தாவும்"
    },
    {
      "t": "01:16",
      "text": "ஆமா ஆமா ஓசூரேவா உள்ள வேற"
    },
    {
      "t": "01:18",
      "text": ""
    },
    {
      "t": "01:20",
      "text": "அந்த சொந்த ஊர் வந்து கிருஷ்ணகிரி"
    },
    {
      "t": "01:22",
      "text": ""
    },
    {
      "t": "01:24",
      "text": "பேஸ்டே பண்ணியிருக்கோம் ரூம் ரூமில்"
    },
    {
      "t": "01:26",
      "text": "ஓகே"
    },
    {
      "t": "01:28",
      "text": "உம் ஏ சப்"
    },
    {
      "t": "01:30",
      "text": "ா சாப்பிட்டாச்சு"
    },
    {
      "t": "01:32",
      "text": "அதனால அப்படியே ஒரு வாக்கிங்க போட"
    },
    {
      "t": "01:34",
      "text": "போ வல்ல போன தக்கேட்ட வாச்சி"
    },
    {
      "t": "01:36",
      "text": "சரி சரி"
    },
    {
      "t": "01:38",
      "text": ""
    },
    {
      "t": "01:40",
      "text": "சட்டலர்"
    },
    {
      "t": "01:42",
      "text": "அதாலும் கொஞ்சம் டிஃப்ரெண்ட"
    },
    {
      "t": "01:44",
      "text": "டிப்ரஷன்"
    },
    {
      "t": "01:46",
      "text": "உம் உம்"
    },
    {
      "t": "01:48",
      "text": "சரி ஆப்்கள்ள வரலாமோ சரி"
    },
    {
      "t": "01:50",
      "text": "வந்த பேசா"
    },
    {
      "t": "01:52",
      "text": "ச வருாங்க கொஞ்ச நேரம் பேசிட்டு அப்படி"
    },
    {
      "t": "01:54",
      "text": "போவாடின்ட்டு"
    },
    {
      "t": "01:56",
      "text": "உம் சரி சரி"
    },
    {
      "t": "01:58",
      "text": "எப்படி இருக்குந்தா அப்போ"
    },
    {
      "t": "02:00",
      "text": "ஆப்ல எல்லாமே பாத்தீங்க"
    },
    {
      "t": "02:02",
      "text": "ஒரு நைன்டிி"
    },
    {
      "t": "02:04",
      "text": "டூ பர்சன்ட் வந்து"
    },
    {
      "t": "02:06",
      "text": "நைன்டி டூன்றது நைன்டி ை் வந்து"
    },
    {
      "t": "02:08",
      "text": ""
    },
    {
      "t": "02:10",
      "text": "செக்ஸுவல் ஹரஸ்மெண்ட் தான்"
    },
    {
      "t": "02:12",
      "text": "அது சரி"
    },
    {
      "t": "02:14",
      "text": "உம்"
    },
    {
      "t": "02:16",
      "text": "எதுவும் நம்ம ீலிங்ஸ்"
    },
    {
      "t": "02:18",
      "text": "அதாவது ஓபன் பண்ணும்போது என்ன சொன்னாங்க"
    },
    {
      "t": "02:20",
      "text": "இதுல பார்ட் டைமா நீங்க ஒர்க் பண்ணிக்கலாம்"
    },
    {
      "t": "02:22",
      "text": "நம்ம பபீலி்ஸ் ஷர் பண்ணிக்கலாம்னு சொல்லிட்டு தான்"
    },
    {
      "t": "02:24",
      "text": "உம்"
    },
    {
      "t": "02:26",
      "text": "கூத்து விடுறாங்க"
    },
    {
      "t": "02:28",
      "text": "கடைசிக்கு வந்து பாத்தங்கன்னா அதெல்லாம் எதுவுமே உ"
    },
    {
      "t": "02:30",
      "text": "ண்ம கிடையாது"
    },
    {
      "t": "02:32",
      "text": "ம் எல்லாரும் யூஸ் பண்றதுே இக்குதான்"
    },
    {
      "t": "02:34",
      "text": "உம்"
    },
    {
      "t": "02:36",
      "text": "ஏன்னா அதுவும் காலர் வராங்க வந்துட்டு கே்க"
    },
    {
      "t": "02:38",
      "text": "து எந்த எதுவும் கிடையாது"
    },
    {
      "t": "02:40",
      "text": "உம் அதே வற"
    },
    {
      "t": "02:42",
      "text": "ா நீங்க இத பண்ணுவீங்களா"
    },
    {
      "t": "02:44",
      "text": "அத பண்ணுவல்லாம் கேட்பாங்க இல்ல"
    },
    {
      "t": "02:46",
      "text": "அந்த மாதிரி அப்படிங்கும்போது"
    },
    {
      "t": "02:48",
      "text": "போத உள்ள கூட சொல்ல விடும்"
    },
    {
      "t": "02:50",
      "text": "கட் பண்ணிட்டு போயடுவா"
    },
    {
      "t": "02:52",
      "text": "எனக்கும் காய் முடிய போோகுது"
    },
    {
      "t": "02:54",
      "text": "ஆஹ்"
    },
    {
      "t": "02:56",
      "text": ""
    }
