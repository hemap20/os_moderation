    {
      "t": "00:08",
      "text": "ஹலோ"
    },
    {
      "t": "00:10",
      "text": "ஹலோ ஹலோ கேக்குதுங்களா"
    },
    {
      "t": "00:12",
      "text": "சொல்லுங்க"
    },
    {
      "t": "00:14",
      "text": "கேக்குதுங்க நீங்க"
    },
    {
      "t": "00:16",
      "text": "என்னங்க"
    },
    {
      "t": "00:18",
      "text": "ஆஹ் கேக்குது கேக்குது"
    },
    {
      "t": "00:20",
      "text": "சொல்லுங்க"
    },
    {
      "t": "00:22",
      "text": "இது நேத்துதான் இந்த ஆப் இது பண்ணன்"
    },
    {
      "t": "00:24",
      "text": "ஓகே"
    },
    {
      "t": "00:26",
      "text": "ரெண்டு மூணு கால இந்த மாதிரி அந்துச்சா"
    },
    {
      "t": "00:28",
      "text": "யாரும் பேசல ஒருத்தங்க பேசும்ன அறம்"
    },
    {
      "t": "00:30",
      "text": "ரெண்டு செகண்ட் ஏதோசற மாதிர சவுண்ட் கிடிச்சா"
    },
    {
      "t": "00:32",
      "text": "கரெ் ஆயடுது"
    },
    {
      "t": "00:34",
      "text": "ம் ரெஸ்பான்ஸ் சொண்ணுவ"
    },
    {
      "t": "00:36",
      "text": "நீங்க தான் ஃபஸ்ட் டைம்ாவது பேசுறீங்க"
    },
    {
      "t": "00:38",
      "text": "ஓகே"
    },
    {
      "t": "00:40",
      "text": ""
    },
    {
      "t": "00:42",
      "text": "சொல்லுங்க"
    },
    {
      "t": "00:44",
      "text": "எங்க இருந்து பேசுறீங்க"
    },
    {
      "t": "00:46",
      "text": ""
    },
    {
      "t": "00:48",
      "text": "ஹலோ கேக்க"
    },
    {
      "t": "00:50",
      "text": "என்னங்கம்"
    },
    {
      "t": "00:52",
      "text": "ஸ்ட் டைம் பேசுறீங்க"
    },
    {
      "t": "00:54",
      "text": "ஓகே"
    },
    {
      "t": "00:56",
      "text": "எங்கிருந்து பேசுறீங்க"
    },
    {
      "t": "00:58",
      "text": "ஈரோடுங்க"
    },
    {
      "t": "01:00",
      "text": "ஈரோடா உண்மையா சொல்லுங்க"
    },
    {
      "t": "01:02",
      "text": "ஆமாங்க ஈரோடு தாங்க"
    },
    {
      "t": "01:04",
      "text": "ஜன"
    },
    {
      "t": "01:06",
      "text": "என்ானும் பசுினேன் நம்பமலாம் வாங்களேன்"
    },
    {
      "t": "01:08",
      "text": "ஏங்க இப்படி கேக்குறீங்க நா இப்பதான்"
    },
    {
      "t": "01:10",
      "text": "பேத்துி எப்படிின்ன தெரிு ஜெனியன்"
    },
    {
      "t": "01:12",
      "text": "என்னச்சு ஏா எனக்கு"
    },
    {
      "t": "01:14",
      "text": "ஈரோடுல ஒரு ஆள் தேவைப்படுது அதான்"
    },
    {
      "t": "01:16",
      "text": "ஆஹ் ஃப்ரெண்ட் பண்ணிக்கலாமே அப்படின்ட்டுதான்"
    },
    {
      "t": "01:18",
      "text": "புரியல ஃப்ரெண்டு பண்ண"
    },
    {
      "t": "01:20",
      "text": "இந்த ஆப் வச்சட்டு எப்படி யூஸ் பண்ண"
    },
    {
      "t": "01:22",
      "text": "எனக்கு தெரியலைங்க அவங்கஸ்ட் அதுக்கேக்கடட்டுக்கு"
    },
    {
      "t": "01:24",
      "text": "க க"
    },
    {
      "t": "01:26",
      "text": "அத தான் இதே மாதிரி கால் பண்ணிட்டே"
    },
    {
      "t": "01:28",
      "text": "இருந்தங்களன்ன ஒவ்வொருர்ர ஒவொருத்தரா உங்க காலா"
    },
    {
      "t": "01:30",
      "text": "அன் பண்ணி பேசுவாங்க எல்லா பொண்ணண்டுங்க தான் பேசுவாங்க"
    },
    {
      "t": "01:32",
      "text": "சரி சரிங்க"
    },
    {
      "t": "01:34",
      "text": "எப்படி வேணாலும் பேசலாம்"
    },
    {
      "t": "01:36",
      "text": "நீங்க அவ விருப்பப்பட்டா நீங்க"
    },
    {
      "t": "01:38",
      "text": "பேசலாம் ஆக்சுவலி நீங்க கேட்ட"
    },
    {
      "t": "01:40",
      "text": "அவங்க விருப்ப கொட்ட பேசலாம்"
    },
    {
      "t": "01:42",
      "text": "பு என்ன வேணாலும் பய"
    },
    {
      "t": "01:44",
      "text": "க்கலாம் சிக்சியா ஆஹ்"
    },
    {
      "t": "01:46",
      "text": "ஃபீலிங்ஸை ஷேர் பண்ணுறது"
    },
    {
      "t": "01:48",
      "text": "பர்சனல் ஷேர் பண்றது ரெண்ட்லிய"
    },
    {
      "t": "01:50",
      "text": "ஜாலியா"
    },
    {
      "t": "01:52",
      "text": ""
    },
    {
      "t": "01:54",
      "text": "சாப் பண்ண க"
    },
    {
      "t": "01:56",
      "text": "உங்க என்னங்க"
    },
    {
      "t": "01:58",
      "text": "எல்லாமே ஷேர் பண்ணி"
    },
    {
      "t": "02:00",
      "text": "ட்டங்க அப்புறமா வீடிய"
    },
    {
      "t": "02:02",
      "text": "்கட்டுறேன் வாட்ஸ்அப் கால் பண்றீங்களா"
    },
    {
      "t": "02:04",
      "text": "அப்படின்னு கேடப்பாங்க நம்பிடாதீங்க"
    },
    {
      "t": "02:06",
      "text": "காட்டுவேன்னு சொல்லுவாங்க உடம்பு"
    },
    {
      "t": "02:08",
      "text": "அப்புறம் கட் பண்ணிடுவாங்க காசை போ"
    },
    {
      "t": "02:10",
      "text": "ங்கிடுவாங்க ஏமாந்துிராதீங்க"
    },
    {
      "t": "02:12",
      "text": "ஜனியனா இருந்தா"
    },
    {
      "t": "02:14",
      "text": "ஓகே உங்களுக்கு விருப்பப்பட்டு நீங்க பா"
    },
    {
      "t": "02:16",
      "text": "கணும்னு ஆசையா இருந்தா ஓகே"
    },
    {
      "t": "02:18",
      "text": "எனக்கு தெரிஞ்சு வேஸ்டன்னு நினைக்கிறேன்"
    },
    {
      "t": "02:20",
      "text": ""
    },
    {
      "t": "02:22",
      "text": "ஹலோ இருக்கு"
    },
    {
      "t": "02:24",
      "text": "ங்களா"
    },
    {
