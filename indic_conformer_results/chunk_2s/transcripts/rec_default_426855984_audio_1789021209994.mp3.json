    {
      "t": "00:02",
      "text": "ಹ್ಮ"
    },
    {
      "t": "00:04",
      "text": "ಅ ಯತ"
    },
    {
      "t": "00:06",
      "text": "ಹ"
    },
    {
      "t": "00:08",
      "text": ""
    },
    {
      "t": "00:10",
      "text": ""
    },
    {
      "t": "00:12",
      "text": ""
    },
    {
      "t": "00:14",
      "text": "ಹಾಯ"
    },
    {
      "t": "00:16",
      "text": "ಹ ಎಲ್ಲಿಂದ"
    },
    {
      "t": "00:18",
      "text": ""
    },
    {
      "t": "00:20",
      "text": "ಮಡಿಕ"
    },
    {
      "t": "00:22",
      "text": "ಸೇರಿ"
    },
    {
      "t": "00:24",
      "text": "ಊಟಾ ತಿಂಡಿ ಐತಾ"
    },
    {
      "t": "00:26",
      "text": "ಹ್ಮ್ ಒಂದು"
    },
    {
      "t": "00:28",
      "text": "ಹ"
    },
    {
      "t": "00:30",
      "text": "ಲ ಪಸ್ಟ್"
    },
    {
      "t": "00:32",
      "text": "ಎನರ್ಜಿ ಬ"
    },
    {
      "t": "00:34",
      "text": "ಬ ಕಸ್ತ"
    },
    {
      "t": "00:36",
      "text": "ಹ"
    },
    {
      "t": "00:38",
      "text": "ಹ"
    },
    {
      "t": "00:40",
      "text": "ಮ"
    },
    {
      "t": "00:42",
      "text": "ಿ ಮತ್ತೆ ಮಕ್ಕಳು ಜೀವ್ನ"
    },
    {
      "t": "00:44",
      "text": "ಸಿಂಗಲ್"
    },
    {
      "t": "00:46",
      "text": "ಹ"
    },
    {
      "t": "00:48",
      "text": "ಸಿಂಗಲ್ ೆ"
    },
    {
      "t": "00:50",
      "text": "ಇತಂದ"
    },
    {
      "t": "00:52",
      "text": "ಹ ಇದ"
    },
    {
      "t": "00:54",
      "text": "ಹ"
    },
    {
      "t": "00:56",
      "text": "ಕ್ಕ ಅವ ವಿಟ್ಟ ದಾಸ"
    },
    {
      "t": "00:58",
      "text": "ಹಂಗಗೆ ಚಂದ"
    },
    {
      "t": "01:00",
      "text": ""
    },
    {
      "t": "01:02",
      "text": "ನೀವು ಏನೋ ಅಂದ್ರಲ್ಲಿ"
    },
    {
      "t": "01:04",
      "text": "ಹೀಗೆ ಚಂದ ಅಂದ್ರ"
    },
    {
      "t": "01:06",
      "text": "ಓ ಯಾಕು"
    },
    {
      "t": "01:08",
      "text": ""
    },
    {
      "t": "01:10",
      "text": "ಸ ಚಂತ"
    },
    {
      "t": "01:12",
      "text": "ಇ"
    },
    {
      "t": "01:14",
      "text": "ಚಂದ ನೀವು ಸಿಂಗಲ್ಲ"
    },
    {
      "t": "01:16",
      "text": ""
    },
    {
      "t": "01:18",
      "text": "ಹಂಗ ಕಾಣಿಸತಿದ್ದೀನಿ"
    },
    {
      "t": "01:20",
      "text": ""
    },
    {
      "t": "01:22",
      "text": ""
    },
    {
      "t": "01:24",
      "text": "ಏನ್ ಕೈಲ್ಲ"
    },
    {
      "t": "01:26",
      "text": "ಅವೆಲ್ಲ ರಿಂಗ್ಸ್ ಎಲ್ಲ ತೋರಿಸ್ ಬಿಟ್ರೆ"
    },
    {
      "t": "01:28",
      "text": "ನಾವ ನ್ ಮಾಡ್ಬೇಕು ನೀವೇ ನಮ್ಗ ಬಂದನ್"
    },
    {
      "t": "01:30",
      "text": "ಒಂದು ಪಸ್ ಪಚಲ್ ಕಿಸ್ತೀರಾ"
    },
    {
      "t": "01:32",
      "text": "ಹಾ"
    },
    {
      "t": "01:34",
      "text": "ಹೆಣ ಮಕ್ಳ ರೀ"
    },
    {
      "t": "01:36",
      "text": "ನಾವೆಲ್ಲಾ ಹಂಗೆಲ್ಲಾ ಮಾಡ್ಬಾರ್ದು"
    },
    {
      "t": "01:38",
      "text": "ಯಾವರು"
    },
    {
      "t": "01:40",
      "text": "ಚ"
    },
    {
      "t": "01:42",
      "text": "ಹಾವೇರಿ"
    },
    {
      "t": "01:44",
      "text": "ಕಾವೇರಿ"
    },
    {
      "t": "01:46",
      "text": "ಅಮ್ಮೂರಲ್ಲೆಲ್ಲ ಚ"
    },
    {
      "t": "01:48",
      "text": "ಇನ್ನದ್ ಗಣಿನಿ ಇದೆ ಗೊತ್ತಾ"
    },
    {
      "t": "01:50",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:52",
      "text": ""
    },
    {
      "t": "01:54",
      "text": "ಬತ್ತ"
    },
    {
      "t": "01:56",
      "text": ""
    },
    {
      "t": "01:58",
      "text": "ಮಕ್ಕಿಿದ್ದೀರಾ"
    },
    {
      "t": "02:00",
      "text": "ಬಂದಿದ್ದೀನಿ"
    },
    {
      "t": "02:02",
      "text": "ಟ್ರಿಪ ಪಲ್ಲ"
    },
    {
      "t": "02:04",
      "text": "ಸಂದರ"
    },
    {
      "t": "02:06",
      "text": ""
    },
    {
      "t": "02:08",
      "text": "ಇ"
    },
    {
      "t": "02:10",
      "text": "ಎಲ್ಲ ಆಗ್ಬೇಕು"
    },
    {
      "t": "02:12",
      "text": "ತಿ ತಿಂಂಗಗಳು"
    },
    {
      "t": "02:14",
      "text": ""
    },
    {
      "t": "02:16",
      "text": ""
    },
    {
      "t": "02:18",
      "text": "ಹ"
    },
    {
      "t": "02:20",
      "text": "ಹೇಳೇರಿ"
    },
    {
      "t": "02:22",
      "text": "ಎಲ್ಲಿ ಕೊಡ್ತಿರದು"
    },
    {
      "t": "02:24",
      "text": "ಮನೇಲ್ರಿ"
    },
    {
      "t": "02:26",
      "text": "ಮನೇಲಿ ಒಂದ್ ಡೇ ಇದ್ ಬಿಟ್ರೆ ಬರ್ರಿ"
    },
    {
      "t": "02:28",
      "text": "ಹೆಣ್ಮಕ್ಳ ಬರೀ ಕೆಲ್ಸ ಬಿಟ್ರೆ ಬೇರೆ ಕೆ"
    },
    {
      "t": "02:30",
      "text": "ಕೆಲ್ಸನೇ ಇರಲ್ಲ ಅವ್ರಿಗೆ"
    },
    {
      "t": "02:32",
      "text": "ಒಬರ ಇದ್ದೀರಾ"
    },
    {
      "t": "02:34",
      "text": ""
    },
    {
      "t": "02:36",
      "text": ""
    },
    {
      "t": "02:38",
      "text": "ಮಮ್ಮೀ"
    },
    {
      "t": "02:40",
      "text": "ಹ್ಮ"
    },
    {
      "t": "02:42",
      "text": "ಮಮ್ಮಿ ಇದ್ದಾರೆ"
    },
    {
      "t": "02:44",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "02:46",
      "text": "ಹೊರಗಡೆ ಇದ್ದಾರೆ"
    },
    {
      "t": "02:48",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "02:50",
      "text": "ಹನ್ ಬರೇ ಇಲಿ ಈ ನಮ್ದ"
    },
    {
      "t": "02:52",
      "text": "ಅೇ ಕೆಲ್ಸ ಮಾಡ್ಕೊಳ್ತಾ ಇದೀನಿ"
    },
    {
      "t": "02:54",
      "text": "ಹೇಗಿದೆ ಅಪ್ಪು"
    },
    {
      "t": "02:56",
      "text": "ಹಾ"
    },
    {
      "t": "02:58",
      "text": "ಎಡಪ್ಪಾಸ ವಾಸನೆ"
    },
    {
      "t": "03:00",
      "text": "್ತ"
    },
    {
      "t": "03:02",
      "text": "ಈ ಟೈಮ್ ಬಿಟ್ಟು ಮತ್ತೆ"
    },
    {
      "t": "03:04",
      "text": "ಯಾವದಾದ್ರುೂ ಟೈಮ್ಲ್ಲಿ ಒಂದ್ ಸ್ವಲ್ಪ"
    },
    {
      "t": "03:06",
      "text": "ಚೂರ್ ರೀಚ್ ಆಗಿ ಸಂಜೆ"
    },
    {
      "t": "03:08",
      "text": "ಟೈಮ್ ಅಲ್ಲಿ ಒ್ ಲೆಕ್ಕದಲ್ಲಿ ಇರುತ್ತೆ"
    },
    {
      "t": "03:10",
      "text": "ಪರವಾಗಿಲ್ಲ ಸ"
    },
    {
      "t": "03:12",
      "text": "ಕಾಮನ್ ಆಗಿ ಮಾತಾಡ್ತಾರೆ"
    },
    {
      "t": "03:14",
      "text": "ಹ್ಮ ಅದ್ರಲ್ಲೂ ಒಂದು"
    },
    {
      "t": "03:16",
      "text": "ಒಂಬತ್ತು ಗಂಟೆ ಅಷ್ಟು ಕ್ರಾಸ್ ಆದ್ರೆ"
    },
    {
      "t": "03:18",
      "text": "ೇ ಹ ತ ಮಗರ್ ಜಿ ಒನನೆ ಬಡ"
    },
    {
      "t": "03:20",
      "text": "ಬೇಕ ಏನಾಯ್ತು"
    },
    {
      "t": "03:22",
      "text": "ಯಾಕಂದ್ರೆ ಎಲ್ಲ ಹೆಣ್ಮಕ್ಳು ಒಂದೇ ತರ"
    },
    {
      "t": "03:24",
      "text": "ಹತಾರೆ ಏತ್ತರ ಟ್ರೀಟ್ ಮಾಡ್ತಾರಲ್ಲ ಹುಡುಗರು"
    },
    {
      "t": "03:26",
      "text": "ಹ ಆದು ಬೇಜಾರಷ್ಟ"
    },
    {
      "t": "03:28",
      "text": "ಮತ್ತಕ್ ಯಾಕೆ ನೈವದ ಮಾಡ್ತಿದ್ದೀರಾ"
    },
    {
      "t": "03:30",
      "text": "ಸೊ ನಾನ್ ಬಂದಿರೋದು ಒಂದ್ಲಿ"
    },
    {
      "t": "03:32",
      "text": "ಒಂದ್ ಮೈಂಡ್ನ್ನು ಫ್ರೆ್ ಮಾಡ್ಕೋಕೋಸ್ಕರ"
    },
    {
      "t": "03:34",
      "text": "ತ್ರೆ ಅದು ಬಿಟ್ಟು ನಂಗೆ ಸೆಕ್ಷಲ್ ಮಾತಾಡ"
    },
    {
      "t": "03:36",
      "text": "ಅವೆಲ್ಲಾ ಇಂಟ್ರೆಸ್ಟ್ ಇಲ್ವಲ್ಲ ಸೊ"
    },
    {
      "t": "03:38",
      "text": "ಅದಕ್ಕೆ ಅಂತಾನೇ ಇಲ್ವಾ ಇದು"
    },
    {
      "t": "03:40",
      "text": "ಮಾಡಿದರದು ಫ್ರೆಂಡ್ ಯಾವ"
    },
    {
      "t": "03:42",
      "text": "ಪ್ಪು ದೋಸ್ತಿ ಅಪ್ಪು ಅಂತ ಅದು ಬಿಟ್ಟು ಅದ್ರಲ್ಲಿ"
    },
    {
      "t": "03:44",
      "text": "ಏನಾದ್ೂ ಮೆನ್ಷನ್ ಮಾಡಿದ್ದಾರೆಾ ಇದರಲ್ಲಿ ಸೆಕ್ಸ್"
    },
    {
      "t": "03:46",
      "text": "ಲ್ಲ ಮಾತಾಡ್ಬೇಕು ಹಿಂಗೆ ಇರ್ಬೇಕು ಅಂತ ಏನ"
    },
    {
      "t": "03:48",
      "text": "ಡೇಟಿಂಗ್ ಆಪ್ ಅಂತ ಏನಾದ್"
    },
    {
      "t": "03:50",
      "text": "ಕೊಟ್ಟಿದರ ಇಲ್ವಲ್ಲ"
    },
    {
      "t": "03:52",
      "text": "ಹತನೆ"
    },
    {
      "t": "03:54",
      "text": "ನಾ್ ಮಕ್ಕಳಗಿದ್ರೆ ನಾವ ಯ"
    },
    {
      "t": "03:56",
      "text": "ಬರ್ಬೇಕು ಎಲ್ಲರು ಒಂದೇ ಇಲ್ಲ ಯಕಂದ್ರೆ ಹು"
    },
    {
      "t": "03:58",
      "text": "ಉಡುಕಿರ್ಕನು ಯಾವಾದಾರು"
    },
    {
      "t": "04:00",
      "text": "ಒ ಪಕೆಟ್ ಮೇ ಸಿಗುತ್ತಲ್ಲ ಒಂದು ಐಸ್ ಕ್ರೀ್ ತಿನ್ಕೊಂಡು"
    },
    {
      "t": "04:02",
      "text": "ಕಾಲೇಜಿಂದ ಬಂದ್ರೆ ಸಾಕಪ್ಪಾ ಅಂತಿರ್ತೀವಿ"
    },
    {
      "t": "04:04",
      "text": "ಹೌತಾನ"
    },
    {
      "t": "04:06",
      "text": "ಕಕ್ಟ್ ಕಕ್"
    },
    {
      "t": "04:08",
      "text": "ಯಾರಾದ್ರೂ ಇವಾಗ ಹೋಗಿ"
    },
    {
      "t": "04:10",
      "text": "ಐಸ್ ಕ್ರಮ್ ತಿನ ಡ್ ಕೊಡರಿ ಅ್ರ ಅಂಗಡು"
    },
    {
      "t": "04:12",
      "text": "ಶೆಟಿ ಕೊಡ್ತಾರ"
    },
    {
      "t": "04:14",
      "text": "ಹಕ್ಷಟ್ಟಿ ಕೊಡೋದಿಲ್ಲ"
    },
    {
      "t": "04:16",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "04:18",
      "text": "ಎಲ್ಲದಕ್ಕ ಅಪ್ಪ"
    },
    {
      "t": "04:20",
      "text": "ಮನೆ ಕೇಳ್ಬೇಕು ಅಂತ ಅನ್ಕೋಬಾರ್ದು"
    },
    {
      "t": "04:22",
      "text": "ಅಟ್ ಲೀಸ್ಟ್ ಫ್ರೆಂಡ್ಸು ಸಿಗ್ತಾರೆ ನಾವು"
    },
    {
      "t": "04:24",
      "text": "ಇದನ್ನ ಆಗ್ಬೋದು ಅಂತ"
    },
    {
      "t": "04:26",
      "text": "ಸೊ ಪ್ರೊಫೆಷನಲಿ"
    },
    {
      "t": "04:28",
      "text": "ಲ್ಸ್ು ಇರ"
    },
    {
      "t": "04:30",
      "text": "ಆಲ್ಮೋಸ್ಟ್ ಆಲ್ ಬಿಸ್ನೆಸ್ ಪರ್ಪಸ್"
    },
    {
      "t": "04:32",
      "text": "ಸ್ರ ಬಂದಿದ್ದೀನಿ ಅರ್ಥ ಆಯ್ತ"
    },
    {
      "t": "04:34",
      "text": "ಟಾ"
    },
    {
      "t": "04:36",
      "text": ""
    },
    {
      "t": "04:38",
      "text": ""
    },
    {
      "t": "04:40",
      "text": ""
    },
    {
      "t": "04:42",
      "text": ""
    },
    {
      "t": "04:44",
      "text": "ಸಲ್ೂಟ್ ನಿಮ್ಗೆ"
    },
    {
      "t": "04:46",
      "text": ""
    },
    {
      "t": "04:48",
      "text": "ಚಂದ ಮಾತಾಡುದ್ರಿ"
    },
    {
      "t": "04:50",
      "text": "ಚಂದ ಮಾತಾಡಿದ್ರಿ ಎಂತ"
    },
    {
      "t": "04:52",
      "text": "ಇಜ ಬಾಗಲೋ"
    },
    {
      "t": "04:54",
      "text": "ಬಿಸ್ನೆಸ್ ಪರ್ಪಸ್ಗೋಸ್ಕರ ಬಂದಿದ್ದೀನಿ"
    },
    {
      "t": "04:56",
      "text": ""
    },
    {
      "t": "04:58",
      "text": ""
    },
    {
      "t": "05:00",
      "text": "ನೀವು ಹುಡುಗಿ ಉಡ್ಕೊಂಡ್ ಬಂದಿ"
    },
    {
      "t": "05:02",
      "text": "ಬಿಡರ"
    },
    {
      "t": "05:04",
      "text": "ಇಲ್ಲಪ್ಪ"
    },
    {
      "t": "05:06",
      "text": "ಹುಡುಗಿ ಉಡ್ಕೊಂಡು ಬಂದ್ರೆ ಇದ್ರಲ್ ನಿಮಗ್ ಹಂಗೆ"
    },
    {
      "t": "05:08",
      "text": "ಆ ತರ ಒೆ ಹುಗಿ ಸಿಗ್ತಾಳೆನ್ನೋ ಸ"
    },
    {
      "t": "05:10",
      "text": ""
    },
    {
      "t": "05:12",
      "text": "ಹಂಡ್ರೆಡ್ ಪರ್ಸೆಂಟ"
    },
    {
      "t": "05:14",
      "text": "ಯಕಂದ್ರೆ ಬಿಟ್ಟ್ರ ಯಾವದಾದ್ ಫ್ರೆಂಡ್ಸ್ ಸಿಗ್ಬಹುದು"
    },
    {
      "t": "05:16",
      "text": "ಅವ್ರನ್ನ ಫ್ರೆಂಡ್"
    },
    {
      "t": "05:18",
      "text": "ಟ್ರೀಟ್ ಮಾಡ್ಬೇಕೆ ಹೊರತು ಬೇರೆ"
    },
    {
      "t": "05:20",
      "text": "ವಿಶ್ವದಲ್ಲಿ ಅವ್ರನ್ನ ಟ್ರೀಟ್ ಮಾಡಕ ಹದು"
