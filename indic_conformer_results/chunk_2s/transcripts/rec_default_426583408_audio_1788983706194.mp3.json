{
  "file_id": "rec_default_426583408_audio_1788983706194.mp3",
  "language": "kannada",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 944.9806875,
  "processing_time_sec": 32.636557817459106,
  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": "ಎಲ್ಲಿಂದ"
    },
    {
      "t": "00:06",
      "text": "ತಿಂ್ಗಳೂರಿಂದ ಕೆಂಪ ಶವೀಗಳಿಂದ"
    },
    {
      "t": "00:08",
      "text": "ಬೆಂಗಲೋರಿ ಯಾವವ"
    },
    {
      "t": "00:10",
      "text": "ಒಂದೇಲ್ಲಂಕ ನೀವು"
    },
    {
      "t": "00:12",
      "text": "ಇಲ್ಲಿಲ್ಲ"
    },
    {
      "t": "00:14",
      "text": "ಒಬ"
    },
    {
      "t": "00:16",
      "text": "ಎಲ್ಲ"
    },
    {
      "t": "00:18",
      "text": "ನಾನು ನನ್ ಮಗ ಅಕ್ಕೆ ಮಾವ"
    },
    {
      "t": "00:20",
      "text": "ಎಂತ ಕ ಅಪ್ಪ"
    },
    {
      "t": "00:22",
      "text": "ಅ"
    },
    {
      "t": "00:24",
      "text": "್ರ್ ಸಿಗ್ತಾರ ಅಂತ ನೋಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "00:26",
      "text": "ಕ ಹಲ್ಸ ಬಟ್ಟನ್ ರೀತ"
    },
    {
      "t": "00:28",
      "text": "ನೀ ಸರ"
    },
    {
      "t": "00:30",
      "text": "ಅಂದ್ರೆ ನನ್ ಹಸ್ಬೆಂಡ್ ಒಂದು ಕುೂನದಲ್ಲಿ ವರ್ಕ್ ಮಾಡೋದು"
    },
    {
      "t": "00:32",
      "text": "ಅ ಇಲ್ಲಿ"
    },
    {
      "t": "00:34",
      "text": "ಮಲೆೇ ನಂಗ್ ಬೇಜಾರಾರ್ಾಗಗ್ತಾ ಇದೆಲ್ಲ"
    },
    {
      "t": "00:36",
      "text": "್ರರು ಹೋದ್ರಿ ಬಂದ್ರೆ"
    },
    {
      "t": "00:38",
      "text": "ಒಬ್ಳೇ ಹೋಗ್ಬೇಕು"
    },
    {
      "t": "00:40",
      "text": "ಅದಕ"
    },
    {
      "t": "00:42",
      "text": "ಸಾರಜ ಪಕ್ಷನ ಇಲ್ಲ"
    },
    {
      "t": "00:44",
      "text": "ಇಲ್ಲ ಇಲ್ಲ"
    },
    {
      "t": "00:46",
      "text": "ಹಸ್ಬೆಂಡ್ ಬಂದು ಅದೊಂದಕ್ಕೆ ಅಂತ ಇಲ್ಲ"
    },
    {
      "t": "00:48",
      "text": "ಪುನದಲ್ಲಿರೋದು"
    },
    {
      "t": "00:50",
      "text": "ಒಂದು ಟೆಂಪಲ್ ಹೋಗ್ಲಿ ಒಂದ"
    },
    {
      "t": "00:52",
      "text": "ಶಾಪಿಂಗ್ ಹೋಗ್ಲಿ ಔಟಿಂಗ್ ಹೋಗ್ಲಿ"
    },
    {
      "t": "00:54",
      "text": "ಒನ್ ಡೇ ಟ್ರಿಪ್ ಹೋಗ್ಲಿ ಒಬ್ಬೇ ಹೋಗ್ಬೇಕು"
    },
    {
      "t": "00:56",
      "text": "ಆದ್ರದು ತುಂಬಾ ಬೇಜಾರಿದೆ"
    },
    {
      "t": "00:58",
      "text": "ಬಟ್ ನನ್ನ ಪರ್ಸನಲ್ಗು ಕೂಡ ಬರ್ತ"
    },
    {
      "t": "01:00",
      "text": "ನ ಎಷ್ಟು ಕೂಡ ಬೇಕು ಅ"
    },
    {
      "t": "01:02",
      "text": "ಹ ಒಂದ ಫ್ರೆ್ ಸಿಕ್ತ ಅಂತ ಬಂದಿನಿ ಬಟ್"
    },
    {
      "t": "01:04",
      "text": "ಬೇರೆ ಬರೆ ಕಾನೂ ರಚನ ಜಾತಿ ಇದೆ ನೋಡಬೇಕ"
    },
    {
      "t": "01:06",
      "text": "ಹ್ಮ"
    },
    {
      "t": "01:08",
      "text": "ನಾ ನ"
    },
    {
      "t": "01:10",
      "text": "ನಾವು ನಾರ್ಮಲ್ ಆಗ ಸಿಗ್ಬೋದಾ"
    },
    {
      "t": "01:12",
      "text": "ನಾರ್ಮಲ್ ಹಗೆ ಅಂದ್ರೆ"
    },
    {
      "t": "01:14",
      "text": "ನೀ ಸ"
    },
    {
      "t": "01:16",
      "text": "ಶಪಿಂಗ್ ಅಂದ್ರೆ ಶಾಪಿಂಗ್ ಇಲ್ಲ ಮೂವಿ"
    },
    {
      "t": "01:18",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:20",
      "text": "ಆತ್ರ ಸ್ಥ"
    },
    {
      "t": "01:22",
      "text": "ನಾರ್ಮಲ್"
    },
    {
      "t": "01:24",
      "text": "ಂ್ಕಳ್ತಾರ ಅಲ್ಲ"
    },
    {
      "t": "01:26",
      "text": "ಹ ಬನ"
    },
    {
      "t": "01:28",
      "text": "ಅ ಇ"
    },
    {
      "t": "01:30",
      "text": "ಅದ ನಿಮ ನಿಮ್ಮ ಕಡೆಯಿಂದ ಅಷ್ಟೇ"
    },
    {
      "t": "01:32",
      "text": "ಹ"
    },
    {
      "t": "01:34",
      "text": "ನಿಮ್ಗ್ ಅನ್ಸದ್ರೆ"
    },
    {
      "t": "01:36",
      "text": "ಂದಕ್ಕೆ ನನಗಿಂತ ಸು"
    },
    {
      "t": "01:38",
      "text": "ಚಕ್ಕೋರ್ ಅಂದನ್ಕೊಂತೀನ್ಿ ನೀವು"
    },
    {
      "t": "01:40",
      "text": "ಎಷ್ಟಂಂಗ್ದ"
    },
    {
      "t": "01:42",
      "text": "ನಂಗ್ ತರ್ಟಿ ಫೈ ಇದೆ ನಾನ್ ಸ್ವಲ್ಪ"
    },
    {
      "t": "01:44",
      "text": "ಪ ಹನ್ನೆನವರು ನೋಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "01:46",
      "text": ""
    },
    {
      "t": "01:48",
      "text": "ಜಾ"
    },
    {
      "t": "01:50",
      "text": ""
    },
    {
      "t": "01:52",
      "text": "ತರ್ಟಿ ಫೋರ್ ಆಗುತ್ತೆ ನೆಕ್ಸ್ಟ್ ಮಂತ್"
    },
    {
      "t": "01:54",
      "text": "ಹ"
    },
    {
      "t": "01:56",
      "text": "ಹಓಕೆೊಂದರೆ ಇ ಒಂದ ವರ್ಷ ಎರಡು ವರ್ಷ ಆಗುತ್ತೆ"
    },
    {
      "t": "01:58",
      "text": "ತುಂಬಾ ಚಿಕ್ಕೋರೆಲ್ಲ ಬೇಡ"
    },
    {
      "t": "02:00",
      "text": "ಸಂಂಬ ಚಕ್ಕ"
    },
    {
      "t": "02:02",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:04",
      "text": "ತುಂಬಾ ಚಿ ಕಾರಣ"
    },
    {
      "t": "02:06",
      "text": "ಮ್ಮ"
    },
    {
      "t": "02:08",
      "text": "ಚಿಕ್ಕ ತುಂಬ ಚಿಕ್ಕರ"
    },
    {
      "t": "02:10",
      "text": "ಲ್ಲಾಂತ"
    },
    {
      "t": "02:12",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:14",
      "text": "ಅಕ್ಟೋಬರ್"
    },
    {
      "t": "02:16",
      "text": "ಟ್ವೆಂಟಿ ಫಿಫತ್ಗೆ"
    },
    {
      "t": "02:18",
      "text": ""
    },
    {
      "t": "02:20",
      "text": "ನಿನ್ ಮೇದಕ್ಕೆ ಆಗುತ್ತೆ"
    },
    {
      "t": "02:22",
      "text": ""
    },
    {
      "t": "02:24",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:26",
      "text": "್ಮ ಮರ್ರಿ ನೀಗ ಏನ್ ಕೊತ"
    },
    {
      "t": "02:28",
      "text": "ಹಪ ಯಸ್ ಮಾಡ್ತಾರದು"
    },
    {
      "t": "02:30",
      "text": "ನಾನ್ ಇವತ್ತು ಇನ್ಸ್ಟಾಲ್ ಮಾಡತೆ ಟ್ರ ಮಾಡ ಅಂತ"
    },
    {
      "t": "02:32",
      "text": "ನ ಮದ ಆಗಿಲ್ಲ ಸಿಂಗಡ್"
    },
    {
      "t": "02:34",
      "text": "ಕೆ ಏನ"
    },
    {
      "t": "02:36",
      "text": "ಮಾರ್ಕೆಟ"
    },
    {
      "t": "02:38",
      "text": "ಎಡ್ಡ ಹೋಗ್ ಮಾಡತ ಮತ್ತ ಎಂಟ ಕೆಸ ಮಾಡತೀಿ"
    },
    {
      "t": "02:40",
      "text": "ಹ್ಣ"
    },
    {
      "t": "02:42",
      "text": "ಇಂಡಸ್ಟ್ರಿಗೂ ಕೆಲಸ ಮಾಡ್ತೀನಿ ಮತ್ತೆ ಮಾರ್"
    },
    {
      "t": "02:44",
      "text": "ಕೆಟ ಕೆಟ್ಟಬ ಮಾಡಡ್ತನೆ"
    },
    {
      "t": "02:46",
      "text": "ಮಾರ್ಕೆಟ್ಗೆ ಅರ್ಥ ಆಗ"
    },
    {
      "t": "02:48",
      "text": "ಮಾರ್ಕೆಟ್ ಗೆಡ್ಡಾಗಿ ವರ್ಕ್ ಮಾಡ್ತ"
    },
    {
      "t": "02:50",
      "text": "ಪ್ರೈವಟ್ ಕಂಪ್ನಿಗೆ ಮಾರ್ ಎ"
    },
    {
      "t": "02:52",
      "text": ""
    },
    {
      "t": "02:54",
      "text": "ಇಂಡಸ್ಟ್ರಿಗೂ ಕೆಲ್ಸ ಮಾಡ್ತೇನೆ"
    },
    {
      "t": "02:56",
      "text": "ಅಂದ್ರೆ ನೀವ್ ಎರಡೆ ಎಟ ರೋಲ್ ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "02:58",
      "text": "ಬಿ ಎಸ್ ಸಿ ಇಂಡಸ್ಟ್ರಿ"
    },
    {
      "t": "03:00",
      "text": "ಕೊಡ್ತನಿ ಬೆಂಗ್ಳೂರ್ಗೆ"
    },
    {
      "t": "03:02",
      "text": "ಮೂವಿಸಸ್ಗೆಲ್ಲ ಮಾಡ್ತೇನೆ"
    },
    {
      "t": "03:04",
      "text": ""
    },
    {
      "t": "03:06",
      "text": "ಅಂದ್ರೆ ಏನ್ ಮಾಡ್ತೀರಾ ಮೂವೀಸ್ ಅಲ್ಲೆಲ್ಲಾ"
    },
    {
      "t": "03:08",
      "text": "ಆರ್ಟಿಸಿಸ್ಟಾನ"
    },
    {
      "t": "03:10",
      "text": "ಹೌದೇನ್ರೀ"
    },
    {
      "t": "03:12",
      "text": "ಯಾವದ್ರಲ್ಲ ಇರಿೀ"
    },
    {
      "t": "03:14",
      "text": "ಸಿಂಗ ಗದರಲ್ಲಿ"
    },
    {
      "t": "03:16",
      "text": "ಇ ಇ ಇ"
    },
    {
      "t": "03:18",
      "text": "ಬ ಟಸ್ಟ್ ಆಕ್ಚು"
    },
    {
      "t": "03:20",
      "text": "ಕೆ ಕೆ"
    },
    {
      "t": "03:22",
      "text": "ಮತ್ತೆಂತ ನಿಮಗೆ ಒಂದ ಒಳ್ಳೆ"
    },
    {
      "t": "03:24",
      "text": "ಎಲ್ಲ ಹುಡುಗಿ ಸಿಗುತ್ತೆ ನೋಡಿ"
    },
    {
      "t": "03:26",
      "text": ""
    },
    {
      "t": "03:28",
      "text": "ಆ್ಯಪ್ ಅಲ್ಲ ಎಲ್ಲ ಯಾಕೆ ಸರ್ಚ್ ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "03:30",
      "text": "ನನಗೆ ಟೈಮ್ ಸಿಕ್ಕಿಲ್ಲ ಆಕ್ಚುಲಿ"
    },
    {
      "t": "03:32",
      "text": "ಕಾಷ್ಟ ಆಗಿಬೇಕಂದ್ರೆ ಯಾಕಂದ್ರೆ ಬರೀ ಕೆಲ್ಸ"
    },
    {
      "t": "03:34",
      "text": "ಕೆಲ್ಸ ಅಂತ ನಾನವು ಬೇಕು ಅಂತ"
    },
    {
      "t": "03:36",
      "text": "ಜಾಸ್ತಿ ಬಿಸಿ ಅದೆ ಒ"
    },
    {
      "t": "03:38",
      "text": "ಅಂತ ಗ್ದುದು"
    },
    {
      "t": "03:40",
      "text": "ಯಾಕೆ ಬೇಕು ಅಂತ ಆಗಿದ್ದು"
    },
    {
      "t": "03:42",
      "text": "ಸವಾಜ ಸಕಿ ಬುಠಾನ ಅಂತ"
    },
    {
      "t": "03:44",
      "text": "್ರೆಂಡಸ್ ಅವ ಎಲ್ಲ ಎಲ್ಲ"
    },
    {
      "t": "03:46",
      "text": "ಪ್ರವಾಸ ಬಿಟ್ಟಿ ಕೆಲ್ಸದಲ್ಲಿ ಇದ್ರೆ"
    },
    {
      "t": "03:48",
      "text": "ಹ ೋಡಿ ಮಾಹಿತ"
    },
    {
      "t": "03:50",
      "text": "ಜಾಸ್ತಿ ಮಾಡ್ಕೊೊಳ್ಳೋಣ ಅಂತ"
    },
    {
      "t": "03:52",
      "text": "ಕೆ ಓೆ ಎಲ್ಲ ಈ ನಿ ಒ"
    },
    {
      "t": "03:54",
      "text": "ಂಗ ಆಯ್ತಾ ಆಯ"
    },
    {
      "t": "03:56",
      "text": "ಒನ್ ಟೈಮ್ ಅಲ್ಲಿ ಎಂಜಾಯ್ ಮಾಡಿರಂತ ಮಾಡ"
    },
    {
      "t": "03:58",
      "text": "ಅಂದ್ರೆ"
    },
    {
      "t": "04:00",
      "text": "ಆತರ ಅಲ್ಲ ಅಂದ್ರೆ ಫ್ರೆಂಡ್ಿಪ್ ಫ್ರ"
    },
    {
      "t": "04:02",
      "text": "ಜೊತೆ ಜಾಸ್ತಿ"
    },
    {
      "t": "04:04",
      "text": "ಇಟ್ರಿ ೋಡದು ಇದೆಲ್ಲಾ"
    },
    {
      "t": "04:06",
      "text": "ಒ್ ಟೈಮ್ ಎಲ್ಲ ಆಯ್ತು"
    },
    {
      "t": "04:08",
      "text": "ಸೊ ಇದು ಪರ್ಮನೆಂಟ್ ಅಲ್ಲ ಅಂತ ಗೊತ್ತಾಯ್ತು"
    },
    {
      "t": "04:10",
      "text": "ಬೇಕು ಅಂತ ಅವಾಯ್ಡ್ ಮಾಡಿದೆ ಎಲ್ಲ"
    },
    {
      "t": "04:12",
      "text": "ೋರು ಮಾಡುತ್ತೇನೆ ಹ್ಮ ಹ್ಮ"
    },
    {
      "t": "04:14",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "04:16",
      "text": "ಈ ತರ ಲೈಫ್ ನ ಬೇಗ ಅರ್ಥ ಮಾಡ್ಕೊಂಡ್ರೆ"
    },
    {
      "t": "04:18",
      "text": "ನಿಜವಾಗ್ಲ ರೀ ಒಳ್ಳೇದು"
    },
    {
      "t": "04:20",
      "text": "ಖುಷಿಯ್ತು ಯಾಕಂದ್ರೆ ಓೆ ಅದೇ"
    },
    {
      "t": "04:22",
      "text": "ಸಿಂಗ"
    },
    {
      "t": "04:24",
      "text": "ಬೇಕಾಗಲ್ಲ ನನ್ ಬೇಕು ಅಂತಾನೇ ಸಿಂಗ್"
    },
    {
      "t": "04:26",
      "text": "ದು ಯಾಕಂದ್ರೆ ನನ್ಗೆ ಕೆಲಸ ಮುಖ್ಯ ನ"
    },
    {
      "t": "04:28",
      "text": "ನನ್ ನನ್ನ ಇಷ್ಟ ಬರತ್ರತ್ರ"
    },
    {
      "t": "04:30",
      "text": "ನ್ ಸೆಟಲ್ ಆಗ ನನ್ಗೆ ಇಂಪಾರ್ಟೆಂಟು"
    },
    {
      "t": "04:32",
      "text": "ತ"
    },
    {
      "t": "04:34",
      "text": "ನಂ್ ಮದ್ವೆ ಆಗೋದಲ್ಲ ಇಂಪಾರ್ಟೆಂಟ್ ನ"
    },
    {
      "t": "04:36",
      "text": "ಕೈ ನಾನ್ ಕೈ ತುಂಬಾ ಕೆಸ ಇರ್ಬೇಕು"
    },
    {
      "t": "04:38",
      "text": "್ಮ ನ"
    },
    {
      "t": "04:40",
      "text": "ಕಾಲ ನಾ ನಿಂತ್ಕೊಂಡಿರ್ಬೇಕು ಅಂಡ"
    },
    {
      "t": "04:42",
      "text": "ನಮ್ಮ ಫ್ಯಾಮಿಲಿ"
    },
    {
      "t": "04:44",
      "text": "ನಾನು ಎಲ್ಲಕ್ಕಿಂತ ಚೆ"
    },
    {
      "t": "04:46",
      "text": "ಬಾಳ ತೋಸ್್ಬೇಕು"
    },
    {
      "t": "04:48",
      "text": "ಅದ್ಫಸ್ು ಅದ ಆದಬಳೆ"
    },
    {
      "t": "04:50",
      "text": "ಮದ್ುವೆ ಆಲ್ಲ ನ ನ"
    },
    {
      "t": "04:52",
      "text": "ನನ್ು ಪಸನಟ್ಟೆಂಗ"
    },
    {
      "t": "04:54",
      "text": "ನಂದ್ರಫ್ಯಾಮಿ"
    },
    {
      "t": "04:56",
      "text": "ಹುಡುಕ್ ್ರಂಡ್ಸ್ ಜೊತೆ ಎಲ್ಲ ಇರುವಾಗ"
    },
    {
      "t": "04:58",
      "text": "ಫ್ಯಾಮಿಲಿಯಿಂದಾನ ತುಂಬಾ ನಿಮಗೆ ಇದ್ ಮಾಡಿ"
    },
    {
      "t": "05:00",
      "text": "ಇನ್ಸೂ ಮಾಡಿಲಿಕ್ತಾರೆ ಅನ್ಸುತ್ತೆ ಅ"
    },
    {
      "t": "05:02",
      "text": "ಆತರ ಏನ್ ಮಾಡಿಲ್ಲ"
    },
    {
      "t": "05:04",
      "text": "ಬಟ್ ನನ್ ಪರ್ಸನಾಲಿಟಿ"
    },
    {
      "t": "05:06",
      "text": ""
    },
    {
      "t": "05:08",
      "text": "ಒಳ್ಳೆಲ್ಲಿದೆ ತುಂಬಾ ಒಳ್ಳೆ ಒಳ್ಳೆ ಮನುಷೆ"
    },
    {
      "t": "05:10",
      "text": "ನನ್ ಮೈಂಡ್ ಸೆಟ್ ಅಷ್ಟೇ ಅದು"
    },
    {
      "t": "05:12",
      "text": ""
    },
    {
      "t": "05:14",
      "text": "ಸ ಎಲ್ಲೂ ಹೋಗಿಲ್ಲ"
    },
    {
      "t": "05:16",
      "text": "ರೀಸೆಂಟ್ ಎಲ್ಲ ಆಚನ್"
    },
    {
      "t": "05:18",
      "text": "ನಾನಾ"
    },
    {
      "t": "05:20",
      "text": "ಎಲ್ಲಾರೆೀ ಮನ"
    },
    {
      "t": "05:22",
      "text": "ಹ್ಮ್ ಇಲ್ಲ ಮೊನ್ನೆ ಹೋಗಿದ್ದೆ"
    },
    {
      "t": "05:24",
      "text": "ಹೋಗ ಉಡುಪಿ ಮತ್ತೆ"
    },
    {
      "t": "05:26",
      "text": "ದೇವಂದರ ಟೆಂಪಲ್ಸ್ ಹ ಬ್ವಿ"
    },
    {
      "t": "05:28",
      "text": "ಬೆಂ್ಗಳೂರು ಅ ನೀವು"
    },
    {
      "t": "05:30",
      "text": "ನೀ ಮಾ ಚಲು ಪತಾ"
    },
    {
      "t": "05:32",
      "text": "ಹ"
    },
    {
      "t": "05:34",
      "text": "ಕೆ ನಿಂದುು ನೇಟವ್"
    },
    {
      "t": "05:36",
      "text": "ಅಮದು ಬೆಂಗ್ೂರ"
    },
    {
      "t": "05:38",
      "text": "ಹ"
    },
    {
      "t": "05:40",
      "text": "ಹಗೆಪ್ಪಾಸ"
    },
    {
      "t": "05:42",
      "text": "ಆಗ್ಬೋದಾ"
    },
    {
      "t": "05:44",
      "text": ""
    },
    {
      "t": "05:46",
      "text": "ಸಿಗಣ ಸುಮ್ನೆ ಸಿಗಣ ಅಂತ"
    },
    {
      "t": "05:48",
      "text": "ತಕರ ಹ್ಮ್ ಸ"
    },
    {
      "t": "05:50",
      "text": "ಹ ನನ್ನತ್ರ"
    },
    {
      "t": "05:52",
      "text": "ನ ಹ್ಮ ನ"
    },
    {
      "t": "05:54",
      "text": "ಹಾ ಆಮೇಲೆ ಹೆಂಗ್ ಹೆಂಗನ್ಸ"
    },
    {
      "t": "05:56",
      "text": "ಅದದ"
    },
    {
      "t": "05:58",
      "text": "ನಾನೇನ್ ಗೊತರಿ"
    },
    {
      "t": "06:00",
      "text": "ಜೆ ಸೀದಾ ಹಿಂಗೆ ಇವಾಗ"
    },
    {
      "t": "06:02",
      "text": "ಈನ್ ಹಿಂಗೆನ್ ಹುಗಿ ಸಿಕ್ದ್ರರಿ ಅಂತ"
    },
    {
      "t": "06:04",
      "text": "ತಂದ್ಬಿಟ್ಟು ನನ್ಗೆ ಅದಕ್ಕೆ ಇದಕ್ಕೆ"
    },
    {
      "t": "06:06",
      "text": "ಅನ್ನೋದು ಕರೆಯೋದು ನ ನನ್ಗೆ"
    },
    {
      "t": "06:08",
      "text": "ಇಷ್ಟ ಇಲ್ಲ ನನ್ಗೆ ನನ್ ಕ್ಯಾರೆಕ್ಟರ್ ಅ"
    },
    {
      "t": "06:10",
      "text": "ತ"
    },
    {
      "t": "06:12",
      "text": "ೆ ಅದು ಹೆಣನ್ಾಗಿಿರ್ಲಿ ಗಂಡ್ ಆಗರ್ಲಿ"
    },
    {
      "t": "06:14",
      "text": "ಒಬ್ಬ್ರರಿಗೆ ಕಂಫರ್ಟ್ ಇರಬೇಕು ಒಬ್ಬ್ರಿಗೆ ಅನ್"
    },
    {
      "t": "06:16",
      "text": "ು ಹೌದು"
    },
    {
      "t": "06:18",
      "text": "ಅಂತ ತಕ ಅದ"
    },
    {
      "t": "06:20",
      "text": "ಯಾರ ಕಿ ಕದ"
    },
    {
      "t": "06:22",
      "text": "ಹೇಳದಲ್ಲ ಅದು ಅನ್ಸಿದ್ರೆ ಮಾತ್ರ"
    },
    {
      "t": "06:24",
      "text": "ಆ ಮು ಬೆಳವಣಗೆ"
    },
    {
      "t": "06:26",
      "text": "ಕ್ಕು"
    },
    {
      "t": "06:28",
      "text": "ನನ್ಗೂ ಅಷ್ಟೇ ಒಂದು ರಿಲೇಷನ್ಶಿಪ್ ಅಂತ"
    },
    {
      "t": "06:30",
      "text": "ತಂದ್ರೆ ಅದಕ್ಕೊಂದು ವ್ಯಾಲ್ಯೂ ಇರ್ಬೇಕು"
    },
    {
      "t": "06:32",
      "text": "ಒ ರೆಸ್ಪೆಕ್ಟ್ ಇರ್ಬೇಕು"
    },
    {
      "t": "06:34",
      "text": "ಅಷ್ಟ ಚೆನ್ನಾಗಿರ್ಬೇಕು"
    },
    {
      "t": "06:36",
      "text": "ಮಟ್ ನಿಮಗ್ ಇಷ್ಟ ಇದೆ ತಾನೆ"
    },
    {
      "t": "06:38",
      "text": "ಮಾತ್ರ ಸಪ್ಪಟ್ಟಗಿರೋದಕ್ಕೆ"
    },
    {
      "t": "06:40",
      "text": "ಇದೆ ಯದಕ್ಕೋಸ್ಕರದ ನಾನು ಒಂದು"
    },
    {
      "t": "06:42",
      "text": "ಕೆಂಡ್ ಬೇಕಂತಾನೇ ಬಂದಿರೋದು"
    },
    {
      "t": "06:44",
      "text": "ಬಟ್ ಅಂಡರ್ಸ್ಟ್ಯಾಂಡಂಗ್ ಕೂಡ ಇಂಪಾರ್ಟೆಂಟ್"
    },
    {
      "t": "06:46",
      "text": "ಫೆಂಡ್ ಅನ್ ಮಾತ್ರಕ್ಕೆ ಯಾರೋ ಸಿಕ್ಕಿದ್ರು ಯಾರ ಜತೆ"
    },
    {
      "t": "06:48",
      "text": "ಅಲ್ಲ ಇಲ್ಲ"
    },
    {
      "t": "06:50",
      "text": "ಒ"
    },
    {
      "t": "06:52",
      "text": "್ರೆಟ್ ಇದ್ರಲ್ಲೂ ಇರಬೇಕು"
    },
    {
      "t": "06:54",
      "text": "ಇನ್ಸೇಫ್ಟಿ"
    },
    {
      "t": "06:56",
      "text": "ಹೌದು ಯಾರೋ ಸಿಕ್ಕಿದ್ರು ನಾ"
    },
    {
      "t": "06:58",
      "text": "ನಾನದೇ ಒಂದ್ ಸಲ ಹದೇ ಎಷ್ಟ ಸಲ ಹದೆ ಇದೆ"
    },
    {
      "t": "07:00",
      "text": "ಎ ನನಗ್ ಬೇಡ ನನಗೆ"
    },
    {
      "t": "07:02",
      "text": "ಹ"
    },
    {
      "t": "07:04",
      "text": "ನನ್ನದೇ ಹೇಳಿದ್ದು ಒಂದ ಟ್ಟ"
    },
    {
      "t": "07:06",
      "text": "ಟಂಪಲ್ ಹೋಗ್ ನಾವಗೆುಂಬಳ ಹೋಗಬೇಕು ತುಂಬಾ"
    },
    {
      "t": "07:08",
      "text": "ಬೇಜಾರ ಆಗುತ್ತೆ ಯ"
    },
    {
      "t": "07:10",
      "text": "ಟೆಂಲ್ಗ್ ಹೋಗ ಇಷ್ಟ ಆದೆ ಒಬ್ಬನೆ ಹೋಗ್ತಾರೆ"
    },
    {
      "t": "07:12",
      "text": "ಹ್ಮ"
    },
    {
      "t": "07:14",
      "text": "ಮದ ಮಾಡದು"
    },
    {
      "t": "07:16",
      "text": "ನಾನು ಬಬ್ನ ಇದ್ದು"
    },
    {
      "t": "07:18",
      "text": "ಇದು ತುಂಬಾ ಅಪ್ಯಾಸರ್ ಜೀವನದಲ್ಲಿ"
    },
    {
      "t": "07:20",
      "text": ""
    },
    {
      "t": "07:22",
      "text": "ಜಾಸ್ತಿ ಕಲ್ಪಿದ್ದೆ ಅಭ್ಯಾಸ"
    },
    {
      "t": "07:24",
      "text": "ಮ ದಹ ತಂತ"
    },
    {
      "t": "07:26",
      "text": "ಅದು ಒಂದಸಲ ತುಂಬಾ ಚೆನ್ನಾಗಿರತ್ತೆ ಅಲ್ಲ"
    },
    {
      "t": "07:28",
      "text": "ಆರ್ ವರ್ಷ ಆಯ್ತು ಆರು ವರ್ಷ ಆಯ್ತು"
    },
    {
      "t": "07:30",
      "text": "ಬಿಟ್ಟ ಆ"
    },
    {
      "t": "07:32",
      "text": "ಹೋಗನೆ ಹವಿ ಹೋದ್ರು ಹೋಗ್ನೆ ಎಲ್ಲಾದ್ೂ ಹೋಗ"
    },
    {
      "t": "07:34",
      "text": "ಹೌದ"
    },
    {
      "t": "07:36",
      "text": "ಸೋಲಟ ಪೋಗಿದ್ದೀರಾ"
    },
    {
      "t": "07:38",
      "text": "ಹಾ ಒಬ್ಬೋಗನೆೇ ಹೋಗ್ತೇನೆ"
    },
    {
      "t": "07:40",
      "text": "ಹೇಳಳ್ಳ ಮೈಸೂರು ಎಂತ ಕೇಳಿ"
    },
    {
      "t": "07:42",
      "text": "ಹ್ಮ್ ಎಂತಕ್ಕೆ"
    },
    {
      "t": "07:44",
      "text": "ದೇಹರ್ಗೆ ಹ ಸ"
    },
    {
      "t": "07:46",
      "text": "ಚಛೋಡ ಚಛೋಡ ಇವರು"
    },
    {
      "t": "07:48",
      "text": "ಹ ಚಾಮುಂಡೇಶ್ವರಿ"
    },
    {
      "t": "07:50",
      "text": "ಹ್ಮ ನಾವ್ ಮುನ್ನ ನೋಡಕ್ ಹೋಗ್ತಾನೆ ಇ"
    },
    {
      "t": "07:52",
      "text": ""
    },
    {
      "t": "07:54",
      "text": "ಅಮ್ಮ"
    },
    {
      "t": "07:56",
      "text": "ಒಳ್ಳೇದ್ ಮಾಡ್ಲಿ ನಿಮಗೆ ನಿ"
    },
    {
      "t": "07:58",
      "text": "ಹ ನಾನನ್ ಹೋಗ್ತಾನೆ ಇಂತೇನೆ"
    },
    {
      "t": "08:00",
      "text": "ನನಗೆ ನನಗ್ ಮನ್ಸುಕ್ ನೆಮದೇ ಬೇಕ"
    },
    {
      "t": "08:02",
      "text": "ಯಾಕಂದ್ರೆ ನನಗೆ ಜೀವನದಲ್ಲಿ ನಂದಿ"
    },
    {
      "t": "08:04",
      "text": "ಕೂಡ ಜಾಗ ಅಂದ್ರೆ ಅದುೊಂದೆ"
    },
    {
      "t": "08:06",
      "text": "ೆ ಸರ್ಬ್ಲ"
    },
    {
      "t": "08:08",
      "text": "ಹೋಗ ಬೈಕ್ ಎತ್ಕೊಂಡು ಹೋಗತಾ ಇರತ್ತದು"
    },
    {
      "t": "08:10",
      "text": ""
    },
    {
      "t": "08:12",
      "text": "ಹಾ"
    },
    {
      "t": "08:14",
      "text": "ಹ್ಮ್ ಯಾರ್ಯಾರಿದ್ದೀರಾ ಮನೆಯಲ್ಲಿ"
    },
    {
      "t": "08:16",
      "text": "ಮನೆಯಲ್ಲಿ ತಂದೆ"
    },
    {
      "t": "08:18",
      "text": "ಅಕ್ಕ ಎಲ್ಲ ಇದತಾರೆ"
    },
    {
      "t": "08:20",
      "text": "ನಕ್ಕಪ ಪಲ್ಲ"
    },
    {
      "t": "08:22",
      "text": "ಸಿಗ್ೋದಾ ನೀವು"
    },
    {
      "t": "08:24",
      "text": "ಇನ್ನೊತ್ತಲ್ಲ"
    },
    {
      "t": "08:26",
      "text": "ಮಾತಾರ್ಣ"
    },
    {
      "t": "08:28",
      "text": "ಅಂದೆ ನಂಬರ್ ಎಕ್ಸ್ಚೇಂಜ್ ಮಾಡ್ಕುಣ ತೊಂದೆ ಇಲ್ಲ"
    },
    {
      "t": "08:30",
      "text": "ಒಂದೆನ್್ಸಲ ಕಾಲಲ್ಲೂ ಮಾತಣಣ"
    },
    {
      "t": "08:32",
      "text": "ಓಕೆ ಈ ಕಂಫರ್ಟಬಲ್"
    },
    {
      "t": "08:34",
      "text": "ಇ ಇಲ್ಲ ಅಂತಲ್ಲ ಬಟ್ ಇನ್ನ ಸ್ವಲ್ಪ ಕಂಫರ್ಟೆಬಲ್"
    },
    {
      "t": "08:36",
      "text": "ಅಂ ಅಂಚು ಕಂತ ನೋ"
    },
    {
      "t": "08:38",
      "text": "ಆೇ"
    },
    {
      "t": "08:40",
      "text": "ನಿಮ್ ನಿಮ ರಿಕ್ವಯರ್ೆಂಟ್ ಹೇಳಿ ಎಂತ"
    },
    {
      "t": "08:42",
      "text": "್ರಲ್ಲ"
    },
    {
      "t": "08:44",
      "text": "ೆ ಮಾಡ್ತ ಯಾವ್ ತರ"
    },
    {
      "t": "08:46",
      "text": "ಅಂದ್ರೆ ಮ ಹೆಂಗೆ"
    },
    {
      "t": "08:48",
      "text": "ಹಾದುಃಖ"
    },
    {
      "t": "08:50",
      "text": "ನಿಮ್ಗೆ ಫೋರ್ಸ್ ುಲಿ ಅಂತೂ ಹೇಳಕ್ ಹೋಗಲ್ಲ"
    },
    {
      "t": "08:52",
      "text": "ಆ ನಮ ಎಕ್ಪ್ರೆನ್"
    },
    {
      "t": "08:54",
      "text": "ನಗೆ ನಾರು ಮಣ ಮುಟ"
    },
    {
      "t": "08:56",
      "text": "ಅಂದ್ರೆ ಹೊಸೊಬ್ರು ಅಂದ್ರೆ ಹೊ"
    },
    {
      "t": "08:58",
      "text": "ಸನ್ನ ಎಕ್ಸ್ಪ್ಲೋರ್ ಮಾಡಕೆ ಮಾತಾಡ್ಕೊಂಡಿರ"
    },
    {
      "t": "09:00",
      "text": "ನಾನಗಿಸತ"
    },
    {
      "t": "09:02",
      "text": "ಮಾಡ ಪರಿಯ ಮಾಡ್ಕೊಂಡು ತಿಳ್ಕೊಳ್ಳಿಕಕ್ಕೆ"
    },
    {
      "t": "09:04",
      "text": "ಮಾತುಕತೆ ಮಾಡಕ್ ನನ್ಗಿಷ್ಟ"
    },
    {
      "t": "09:06",
      "text": "ಇದು ನನ್ಪಂಟ್ ಅಫು"
    },
    {
      "t": "09:08",
      "text": "ಅವ್ರ್ದ ಹದಬೇಕು"
    },
    {
      "t": "09:10",
      "text": "ಬೇಕು ಅಂತ ನನಗೆ"
    },
    {
      "t": "09:12",
      "text": "ಆ ಆಸೆಗಳಿಗಿಂತ ನಾ್ ಮಾತಾಡ್ಬೇಕು"
    },
    {
      "t": "09:14",
      "text": "ಆಮಗೆ"
    },
    {
      "t": "09:16",
      "text": "ಚೆನ್ನಾಗಿರ್ಬೇಕ ಆತರ"
    },
    {
      "t": "09:18",
      "text": "ಪಸಮರು ಜುತಿ ಮದ ಬೇಕಿ ಯಾ ಪಾಲೆ ನತ್ತ"
    },
    {
      "t": "09:20",
      "text": "ಬು ಚೆನ್ನಾಗಿರುತ್ತಲ್ಲ ಅ್ರನ್ಯ ಪರ್"
    },
    {
      "t": "09:22",
      "text": "ಗೆ ಅಲ್ಲ ಹಂಗ"
    },
    {
      "t": "09:24",
      "text": "ಇಲ್ಲ ಅಂದ್ರೆ ಒಬ್ಬ ಇದ್ರೆ"
    },
    {
      "t": "09:26",
      "text": "ಒಂದು ಆ ಬಾಂಡಿಂಗ್ ಇರ್ಬೇಕು"
    },
    {
      "t": "09:28",
      "text": "ಕನ್ಫ್ರನ್ ಶ್ದ"
    },
    {
      "t": "09:30",
      "text": "ಆತಾಯ"
    },
    {
      "t": "09:32",
      "text": "ಹ್ಮ್ ಹ್ಮ"
    },
    {
      "t": "09:34",
      "text": "ಹ"
    },
    {
      "t": "09:36",
      "text": "ವಾಟ್ಸಆಪಲ್ಲಿ ಪಿಂಗ ಮಾಡಟ"
    },
    {
      "t": "09:38",
      "text": "ಹ ಮಾಡಿ"
    },
    {
      "t": "09:40",
      "text": "ನಂಬರು"
    },
    {
      "t": "09:42",
      "text": "ಅ ಬೆಲೆ ಆಯ್ತ್ ನಾಳೆ ಮಾತಾಡಣ ಹೋಗ"
    },
    {
      "t": "09:44",
      "text": "ಏ ಈಗ ಬೇಡ"
    },
    {
      "t": "09:46",
      "text": "ಓಕೆ ಅ ಓಕೆನಾ ನಿಮ್ಗೆ"
    },
    {
      "t": "09:48",
      "text": "ಓಕೆ ಓಕೆ ಓಕೆ ಏನ್ ತೊಂದ್ರೆ ಇಲ್ಲ"
    },
    {
      "t": "09:50",
      "text": "ನಿಮ್ಗೆ ಇಷ್ಟ ತಿಳ್ಬಳ್ಳಿ"
    },
    {
      "t": "09:52",
      "text": "ದ ಸಿಬ್ಬಳ್ಳಿ ಐತಿ"
    },
    {
      "t": "09:54",
      "text": "ತ್ರಿಬಲ್ ಏಟ್ ಓಕೆ"
    },
    {
      "t": "09:56",
      "text": "ಫೋರ್ ಫೈವ್"
    },
    {
      "t": "09:58",
      "text": "ಓಕೆ ಟ್ ನೈನ್"
    },
    {
      "t": "10:00",
      "text": "ಹಾ"
    },
    {
      "t": "10:02",
      "text": "ಸೆವೆನ್ ಫೋರ್"
    },
    {
      "t": "10:04",
      "text": ""
    },
    {
      "t": "10:06",
      "text": "ತ್ರಿಪುಲ್ ಏ ಟು ಫೋರ್ ಫೈವ್"
    },
    {
      "t": "10:08",
      "text": ""
    },
    {
      "t": "10:10",
      "text": "ಟ್ ನೈನ್"
    },
    {
      "t": "10:12",
      "text": ""
    },
    {
      "t": "10:14",
      "text": "ಏಟ್ ನೈನ್"
    },
    {
      "t": "10:16",
      "text": "ಸ ಪ"
    },
    {
      "t": "10:18",
      "text": "ಏಟ್ ನೈನ್ ಫೈವ್ ಸೆವೆನ್"
    },
    {
      "t": "10:20",
      "text": ""
    },
    {
      "t": "10:22",
      "text": ""
    },
    {
      "t": "10:24",
      "text": ""
    },
    {
      "t": "10:26",
      "text": ""
    },
    {
      "t": "10:28",
      "text": "ಬಂತ ನೋಡಿ ಮ"
    },
    {
      "t": "10:30",
      "text": "ವಿಸಜ"
    },
    {
      "t": "10:32",
      "text": "ಹ"
    },
    {
      "t": "10:34",
      "text": "ಮುಂದೆಿಲ್ಲದೆ ಹ ಬಂತು"
    },
    {
      "t": "10:36",
      "text": "ಹ"
    },
    {
      "t": "10:38",
      "text": "ಡಬಲ್ ಜೀರೋ ಫೋರ್ಲ್ಲ"
    },
    {
      "t": "10:40",
      "text": "ಹೌದು"
    },
    {
      "t": "10:42",
      "text": "ಶಿವರಾಜ"
    },
    {
      "t": "10:44",
      "text": "ಗಡ"
    },
    {
      "t": "10:46",
      "text": "ಡತ"
    },
    {
      "t": "10:48",
      "text": ""
    },
    {
      "t": "10:50",
      "text": "ಬ ಭರಲ್"
    },
    {
      "t": "10:52",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ನಾವು ಗನು ಆಸೆ"
    },
    {
      "t": "10:54",
      "text": "ಗೌಟ ನೀ"
    },
    {
      "t": "10:56",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "10:58",
      "text": "ಹಾ"
    },
    {
      "t": "11:00",
      "text": ""
    },
    {
      "t": "11:02",
      "text": "ಹೆಂಗ"
    },
    {
      "t": "11:04",
      "text": "ಾಣಸ್ತರಾ ಆಕ್ಚುಲಿ"
    },
    {
      "t": "11:06",
      "text": "ಹೌದ"
    },
    {
      "t": "11:08",
      "text": "ಹ್ಮ"
    },
    {
      "t": "11:10",
      "text": "ಹ್ಮ್್ಮ"
    },
    {
      "t": "11:12",
      "text": "ಇಕ್ಬಾದಾನಲ್ಲೇ"
    },
    {
      "t": "11:14",
      "text": "ನಾಳೆ"
    },
    {
      "t": "11:16",
      "text": "ಮ ಬಿ ಆ"
    },
    {
      "t": "11:18",
      "text": "ನನ್ ಹೇಳ್ ನಾನೇ ಹೇಳ್ತೇನ್ ರ"
    },
    {
      "t": "11:20",
      "text": "ಹೇಳ್ತೀನಿ ನಾಳೆ ಸದ್ಯ ನಾ"
    },
    {
      "t": "11:22",
      "text": "ಸಟರ್ಡೇನು ಯಾವತ್ತ ನಳ ಹೇಳ್ತೀನಿ ಅದ"
    },
    {
      "t": "11:24",
      "text": "ಮಾಡ್ಕೋಂದ್ರೆ ನಂದು ವರ್ಕೆ ಆಗಿತ್ತೆೇಏಾರ"
    },
    {
      "t": "11:26",
      "text": "ನ ಒಂದು ಒಂದು ಅರ್ಫರ್ಮೇಶಷನ್ ಸಿಗ್ಬಹುದ"
    },
    {
      "t": "11:28",
      "text": "ಬೇಗ ಬರ್ಲಿಕ್ಕೆ ಹಾಗೆ ಎಲ್ಲ ಹೋಗ್ತ ಕೆ"
    },
    {
      "t": "11:30",
      "text": "ಕ್ಕ"
    },
    {
      "t": "11:32",
      "text": "ತಿನ್"
    },
    {
      "t": "11:34",
      "text": "ತೆಲಂಗಾನ ತ"
    },
    {
      "t": "11:36",
      "text": "ಹ್ಮ್ ಅಂದ್ರೆ ಎನಾಂಕ ಅಂದ್ರೆ ನವು ಯನಾಂಕದಲ್ಲಿ"
    },
    {
      "t": "11:38",
      "text": "ಇಲ್ಲ ಅಟ್ಟುಳ್ಳೇಔಟ್ಟಿಂದ ಸ್ಟಾರ್ಟಿಂಗ್ ಆಗ"
    },
    {
      "t": "11:40",
      "text": ""
    },
    {
      "t": "11:42",
      "text": "ಕೆ ನ್ ಏನ್ ಕೆಲ್ಸ"
    },
    {
      "t": "11:44",
      "text": "ನಾನ್ ಫಸ್ಟ್ ಜುವೆರಿ"
    },
    {
      "t": "11:46",
      "text": "ಶೋರೂಮ್ ಅಲ್ಲಿ ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೇಂದ್ರೆ"
    },
    {
      "t": "11:48",
      "text": "ಹ್ಮಳ ತಟ ಎಲ್ಲ ಚೆನ್ನಾಗಿತ್ತು"
    },
    {
      "t": "11:50",
      "text": "ಬಟ್ಟ ತುಂಬಾ ಟೈಮಿಂಗ್ಸ್"
    },
    {
      "t": "11:52",
      "text": "ಟೆನ್ ಸರ್ಟಿ ಟು ಏಟ್ ಓ ಕ್ಲಾಕ್ ಆಗೆ"
    },
    {
      "t": "11:54",
      "text": "ಹ ಮನೇಲಿ ಮಗ"
    },
    {
      "t": "11:56",
      "text": "ಟೈ್ಪೆಂಡ್ ಮಾಡ್ಲಿಕ್ ಆಗ್ತಾ ಇಲ್ಲ ನನ್ಗೆ"
    },
    {
      "t": "11:58",
      "text": "ಹಾಗ ನ"
    },
    {
      "t": "12:00",
      "text": "ಅದು ಬಿಟ್ಟಿದ್ದೀನಿ ಈಗ ನೀವು"
    },
    {
      "t": "12:02",
      "text": "ಿಂದ ಮಾತ್ರ ಸೇರ್ಕೊಂಡಿದ್ದೇನೆ ಒಂದ ಇಯರ್"
    },
    {
      "t": "12:04",
      "text": "ಗ್ಬೇಕು ಸ್ಲ್ಪರ್ ತಗೊಳ್ಳಿ"
    },
    {
      "t": "12:06",
      "text": "ಎಪೀರಿಯಾನ್ಸ್ ತಗೊತಾ ಇದ್ದೀನಿ ಇವಾಗ"
    },
    {
      "t": "12:08",
      "text": "ಹಾಗಾಗಿ ಈ ಕಡೆ ಮ"
    },
    {
      "t": "12:10",
      "text": "ಅರ್ಚ ನೀ ಮಾತರುವ"
    },
    {
      "t": "12:12",
      "text": "ಹ ನ ್ರಿಂಕಂಗ್"
    },
    {
      "t": "12:14",
      "text": "ಮಾಡ್ತದಾ ಇಲ್ಲಪ್ಪ"
    },
    {
      "t": "12:16",
      "text": "ಯ"
    },
    {
      "t": "12:18",
      "text": "ಗೌಟ್ರಲ್ಲಿ ಹೆಣ ಮಕ್ಳು ಕೂಡ"
    },
    {
      "t": "12:20",
      "text": "ನಿ ಗೊ"
    },
    {
      "t": "12:22",
      "text": "ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "12:24",
      "text": "ಹೊರಟ ಎಲ್ಲ"
    },
    {
      "t": "12:26",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "12:28",
      "text": "ೊ ನ"
    },
    {
      "t": "12:30",
      "text": "ನಮ್ಮ್ ಫ್ಯಾಮಿಲಲಿ ಯಾರು ಮಾಡಲ್ಲ ನಮ್ಮ"
    },
    {
      "t": "12:32",
      "text": "ನಮ್ಮ ನಮ್ದು ಅಜ್ಜಿ ಮನ"
    },
    {
      "t": "12:34",
      "text": "ಚಿಕ್ಮಗಳೂರು ಅದು ಮನೆ ನ"
    },
    {
      "t": "12:36",
      "text": "ಮಾಡ ಅಲ್ಲೆಲ್ಲ ಹಾಗ"
    },
    {
      "t": "12:38",
      "text": "ನಮ್ಮ ಫ್ಯಾಮಿಲಿ ಬ್ಯಾಗ ನ"
    },
    {
      "t": "12:40",
      "text": "ಮಾಡ್ತರ್ಲ ಎಲ್ರೂ ಅಲ್ಲ"
    },
    {
      "t": "12:42",
      "text": "ಹೇಳಿದ ಕ ಕಬ"
    },
    {
      "t": "12:44",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ತಪ್ಪ"
    },
    {
      "t": "12:46",
      "text": "ಅಂದ್ರೇನು ಈಗ ಅದು ಸಾಮಾನ"
    },
    {
      "t": "12:48",
      "text": "ಬಟ್ ನಮಗ ಇದ ಅಭ್ಯಾಸ ಇಲ್ಲ"
    },
    {
      "t": "12:50",
      "text": "ನಮ್ಮ ಜೂನಿಯರ್ಸ್ ಎಲ್ಲ ಮೇ ಬಿ ಅದು ಸ್ವಲ್ಪ ಮ"
    },
    {
      "t": "12:52",
      "text": "ಕಾಮನ ಅಂತ ಅನ್ಸತ್ತೇನ"
    },
    {
      "t": "12:54",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "12:56",
      "text": "ಹ್ಮ"
    },
    {
      "t": "12:58",
      "text": "ಬ ನಂಬ ಸ"
    },
    {
      "t": "13:00",
      "text": "ಮಾಡಕಂಟ್ರ"
    },
    {
      "t": "13:02",
      "text": "ಸೇ ಮಾಡ್ಕೊಂಡಿಲ್ಲ ಆಮೇಲೆ ಮಾಡ್ಕೊತೀನಿ"
    },
    {
      "t": "13:04",
      "text": "ರಾಜ"
    },
    {
      "t": "13:06",
      "text": "ಆಮೇಲೆ ಮರ್ತ ಹೋಗ್ಬ ಬಿಡ್ತಾರೆ ಬೇಗಡೆ"
    },
    {
      "t": "13:08",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ಹಾಗೇನಿಲ್ಲ ನೀವು ನ"
    },
    {
      "t": "13:10",
      "text": "ಮಾರ್ಕೊಟ್ಟಿದ್ದೀನಿ ನ ಅಕ್ಕ"
    },
    {
      "t": "13:12",
      "text": "ತ್ ಮಾಡ್್ರೆ ನೀವಾದ್ರೂ ಮಾಡ"
    },
    {
      "t": "13:14",
      "text": "ಬೋದ ನಂಬರ್ ಏನ್ ಎಕ್ಲ್ಲಂಗ"
    },
    {
      "t": "13:16",
      "text": "ಹಾ"
    },
    {
      "t": "13:18",
      "text": "ಸ"
    },
    {
      "t": "13:20",
      "text": "ಇಪ್ಪಂದನಲೆ ನಾರ್ಮಲ್"
    },
    {
      "t": "13:22",
      "text": "ಕಫೆ"
    },
    {
      "t": "13:24",
      "text": "ಲ್ಲಿ ಅದೇ ಬಟ್ ನಾಳೆನ"
    },
    {
      "t": "13:26",
      "text": "ಲ್ಲ ನಾನೇ"
    },
    {
      "t": "13:28",
      "text": "ನಾೆ ನಿಮಗೆ ಕನ್ಫರ್್ತನೆ ಯಾಗ ಸಿಗ್ತೇನೆ"
    },
    {
      "t": "13:30",
      "text": "ಪ್ಪ"
    },
    {
      "t": "13:32",
      "text": "್ವರ್ ಹೋಗ್ಬೇಕ ಅಂತ ಅನ್ಕೊಂಡಿದೀಿ ನೋಣ"
    },
    {
      "t": "13:34",
      "text": "ಯಾವಾಗ್ ಬರ್ತೀನಿ ಅಂತ ಹೇಳ್ತನಿ"
    },
    {
      "t": "13:36",
      "text": "ಾವ ಹ್ಮ ನೀ ಯಾವ್ಯ ರ"
    },
    {
      "t": "13:38",
      "text": "ಎಂದ್ರನಾಗ"
    },
    {
      "t": "13:40",
      "text": "ಕೆ"
    },
    {
      "t": "13:42",
      "text": "ಆಗುತ್ತೆ ಮಲ್ಲೇಶ್ವರಂ ಅತ್ರ"
    },
    {
      "t": "13:44",
      "text": "ಹ್ಮ ಹ"
    },
    {
      "t": "13:46",
      "text": "ೋ ಅಲ್ಲಿ ಅಲ್ಲಿೇ ಗೊತ್ತಾದ್ರ ಸಿಗ್ತ"
    },
    {
      "t": "13:48",
      "text": "ನಮಗ್ಗೆ ಸ್ವಲ್ಪ ಬರ್ಬೇಕು ಅಲ್ಲಿಗ್ ಬರ್ತಾರೆ"
    },
    {
      "t": "13:50",
      "text": "ಮತ್ತಡ ಬನ್ನ ಸಿಗಣ"
    },
    {
      "t": "13:52",
      "text": "ಹ"
    },
    {
      "t": "13:54",
      "text": "ನಾೆ ಬನ್ನಿ ಸಿಗಣ ಅಷ್ಟೇ"
    },
    {
      "t": "13:56",
      "text": "ಇಲ್ಲ ನಾಳೆ"
    },
    {
      "t": "13:58",
      "text": "ಆಗಲ್ಲ ಯಾಕಂದ್ರರಿಯ"
    },
    {
      "t": "14:00",
      "text": "ಅ ನಿಮ್ ಇಷ್ಟ"
    },
    {
      "t": "14:02",
      "text": "ಹ್ಮ ಆಯ್ತು ಕಾಲ್ ಮಾಡ್ತ"
    },
    {
      "t": "14:04",
      "text": ""
    },
    {
      "t": "14:06",
      "text": "ಮ"
    },
    {
      "t": "14:08",
      "text": "ಪಡಿ"
    },
    {
      "t": "14:10",
      "text": "ನಮ್ಗೂ ಕೂಡ"
    },
    {
      "t": "14:12",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "14:14",
      "text": "ಓಕೆ ಅನ್ಸ್ತಾಖುಷಿಯ್ತಾಮನ್ಗೆ ಅನ್ಸ್ತಾ"
    },
    {
      "t": "14:16",
      "text": "ಚಷ ಆತಾರೆ"
    },
    {
      "t": "14:18",
      "text": "ಖಂಡಿತ ಖುಷಿ ಯಾಕೆ ಗೊತ್ತಾ"
    },
    {
      "t": "14:20",
      "text": "ಆಪಲ್ಲಿ ಬರೋರೆಲ್ಲ ಬೇರೆ ಬೇ"
    },
    {
      "t": "14:22",
      "text": "ಬೇರೆ ತರ ಮಾತಾಡ್ತಾರೆ ಬಟ್ ಅವರು"
    },
    {
      "t": "14:24",
      "text": "ಅದು ನನ್ಗ ಇಷ್ಟ ಆಗಲ್ಲ"
    },
    {
      "t": "14:26",
      "text": "ಹ ಅನ್ಯಾದದು ತಪ್ಪು ಅಂತ ನ"
    },
    {
      "t": "14:28",
      "text": "ಹೇಳಲ್ಲ ಬಟ್ ಅವರು"
    },
    {
      "t": "14:30",
      "text": "ಅದು ಗೊತ್ತಿಲ್ದಿರೋ ವ್ಯಕ್ತಿಗಳ"
    },
    {
      "t": "14:32",
      "text": "ನಮ್ಮ ಪರ್ಸನಲ್"
    },
    {
      "t": "14:34",
      "text": "ಮಾತಾಡೋದು ತುಂಬಾ ಕಷ್ಟ ಬಟ್ ಅವ್ರಗ"
    },
    {
      "t": "14:36",
      "text": "ದು ಕಷ್ಟ ಆಗ್ತಿಲ್ಲ ಅವ್ರಸತೆ ಬೇರೆ ಜನಗಳಿಗೆ"
    },
    {
      "t": "14:38",
      "text": "ನನಗೆ ಅದ ಆಶ್ಚರ್ಯ"
    },
    {
      "t": "14:40",
      "text": "ಏನ್ ತೊಂದ್ರ ಇಲ್ಲ್ ನಾವ"
    },
    {
      "t": "14:42",
      "text": "ಆರಸ ಅ್ಮ"
    },
