    {
      "t": "00:02",
      "text": "हाईस बेता"
    },
    {
      "t": "00:04",
      "text": "हैा कहां से हो"
    },
    {
      "t": "00:06",
      "text": "मैं राजस्थान से हूँ आप"
    },
    {
