      "text": "तो कितने रुपे लेती हो"
    },
    {
      "t": "01:24",
      "text": "दो सौ पचास"
    },
    {
      "t": "01:26",
      "text": "कितनी देर का"
    },
    {
      "t": "01:28",
      "text": "अ"
    },
    {
      "t": "01:30",
      "text": "े घंटे का"
    },
