      "text": "कहां से हो शवेता जी"
    },
    {
      "t": "00:10",
      "text": "ता्या"
    },
    {
      "t": "00:12",
      "text": "कसे हो"
    },
    {
      "t": "00:14",
      "text": "दिल्ली से"
    },
    {
      "t": "00:16",
      "text": "दिल्ली सेहू"
    },
    {
      "t": "00:18",
      "text": "हस्को"
    },
    {
      "t": "00:20",
      "text": "क्या हुआ"
    },
    {
      "t": "00:22",
      "text": "व एक सोंगनी"
    },
    {
      "t": "00:24",
      "text": "क दिल्ली सेहूं भैं चोर"
    },
    {
      "t": "00:26",
      "text": "से आ न"
    },
    {
      "t": "00:28",
      "text": "अच्छा बेसिकली मैं यूपी से हूँ बट"
    },
    {
      "t": "00:30",
      "text": "मैं दिल्ली राज"
    },
    {
      "t": "00:32",
      "text": "चौकस दे"
    },
    {
      "t": "00:34",
      "text": "क्या करते हो आप"
    },
    {
      "t": "00:36",
      "text": "क्वेश्चन पूछ सकती हूँ"
    },
    {
      "t": "00:38",
      "text": "क्या करते हो"
    },
    {
      "t": "00:40",
      "text": ""
    },
    {
      "t": "00:42",
      "text": "जो आपसे कुछ"
    },
    {
      "t": "00:44",
      "text": "कर सकते हो"
    },
    {
      "t": "00:46",
      "text": "पूछिए दो पूछिए अ"
    },
    {
      "t": "00:48",
      "text": "सर होगा तो पता नहीं"
    },
    {
      "t": "00:50",
      "text": "ओके"
    },
    {
      "t": "00:52",
      "text": "नहीं नर्माली बेसिक लाइफ"
    },
    {
      "t": "00:54",
      "text": "के ऊपर ही है मैं बता"
    },
    {
      "t": "00:56",
      "text": "सकते हो आप एक्चअली मै व्हाट्सप परे वीडियो"
    },
    {
      "t": "00:58",
      "text": "कॉलस वगैर करते हो चार्जस लेके आपका"
    },
    {
      "t": "01:00",
      "text": "करोग"
    },
    {
      "t": "01:02",
      "text": "क्या"
    },
    {
      "t": "01:04",
      "text": "मैं ओपन वीडियो कॉल्स को"
    },
    {
      "t": "01:06",
      "text": "वगै करती होँ चारजेस लेके आप करोगे"
    },
    {
      "t": "01:08",
      "text": ""
    },
    {
      "t": "01:10",
      "text": "हां तो मैं इतनी बार"
    },
    {
      "t": "01:12",
      "text": "पठी मारू इधर ओपन करके"
    },
