{
  "file_id": "rec_default_427308167_audio_1789058388570.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 356.754,
  "processing_time_sec": 13.889963150024414,
  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "அல்ல ஒல"
    },
    {
      "t": "00:04",
      "text": ""
    },
    {
      "t": "00:06",
      "text": "எங்க இருந்து பேசுறீங்க"
    },
    {
      "t": "00:08",
      "text": "நான் சேலாம் நீங்க"
    },
    {
      "t": "00:10",
      "text": "ஆஜ தரிச்ச"
    },
    {
      "t": "00:12",
      "text": "இந்த பேரு"
    },
    {
      "t": "00:14",
      "text": "என்ன பண்றீங்க"
    },
    {
      "t": "00:16",
      "text": "ஆ பாரன்ங்க"
    },
    {
      "t": "00:18",
      "text": "ஓகே"
    },
    {
      "t": "00:20",
      "text": "கட்டே"
    },
    {
      "t": "00:22",
      "text": "என் பேரு பிரியா என்ன பண்றீங்க வ"
    },
    {
      "t": "00:24",
      "text": "காரம்"
    },
    {
      "t": "00:26",
      "text": ""
    },
    {
      "t": "00:28",
      "text": "ஹலோ"
    },
    {
      "t": "00:30",
      "text": "ஓ"
    },
    {
      "t": "00:32",
      "text": "கட்ட ஆாயிடுச்சுது இருக்கு"
    },
    {
      "t": "00:34",
      "text": "அ"
    },
    {
      "t": "00:36",
      "text": "உங்களுக்கு நெட்வர்க் இஷயூ வரும்"
    },
    {
      "t": "00:38",
      "text": "ஓகே"
    },
    {
      "t": "00:40",
      "text": "சொல்லுங்க வரன்"
    },
    {
      "t": "00:42",
      "text": "ரொம்ப அழகா இருக்கீங்க"
    },
    {
      "t": "00:44",
      "text": "அ"
    },
    {
      "t": "00:46",
      "text": "தேங்க்யூ"
    },
    {
      "t": "00:48",
      "text": "என்ன ந இருக்கீங்க"
    },
    {
      "t": "00:50",
      "text": "நீங்கன்னு சொல்ற நீங்களே சிச்சுட்டீங்க"
    },
    {
      "t": "00:52",
      "text": "சும்மா விளையாத்துக்கு சொன்னீங்களா"
    },
    {
      "t": "00:54",
      "text": "இல்ல இல்ல நல்லாதான் இருக்கீங்க"
    },
    {
      "t": "00:56",
      "text": "உம்"
    },
    {
      "t": "00:58",
      "text": "க மேரேஜக்க"
    },
    {
      "t": "01:00",
      "text": ""
    },
    {
      "t": "01:02",
      "text": "ஏ"
    },
    {
      "t": "01:04",
      "text": "எனக்கு டவெண்டண்டி பஃபைவ தா"
    },
    {
      "t": "01:06",
      "text": "து இந்த மாிரில"
    },
    {
      "t": "01:08",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "01:10",
      "text": "லே எப்படி இருக்கு"
    },
    {
      "t": "01:12",
      "text": "இப்பதான் இ இன்ஸ்டால் பண்ண"
    },
    {
      "t": "01:14",
      "text": "இப்பதான் இன்ஸ்டால் பண்ணீங்களே"
    },
    {
      "t": "01:16",
      "text": "அதான் நல்லா பேசுறீங்க"
    },
    {
      "t": "01:18",
      "text": "நல்லண்ணா"
    },
    {
      "t": "01:20",
      "text": "நல்ல பையனா பேசுறீங்க"
    },
    {
      "t": "01:22",
      "text": "சொ"
    },
    {
      "t": "01:24",
      "text": "பக்கத்துல யாரும் இருக்காங்களோ"
    },
    {
      "t": "01:26",
      "text": "என்ன புரியல"
    },
    {
      "t": "01:28",
      "text": "இல்ல வருரும் தானே உம்"
    },
    {
      "t": "01:30",
      "text": "இல்ல வேற யாரையும் பச்சிச்சுட்டு இருக்கீங்களா அத"
    },
    {
      "t": "01:32",
      "text": "இருக்காங்களனு கேட்டேன்"
    },
    {
      "t": "01:34",
      "text": "யாரும் எல்ல வரும்"
    },
    {
      "t": "01:36",
      "text": "போயி எங்க பெஃண்ட்ல யாரும் இருக்கிறாங்க"
    },
    {
      "t": "01:38",
      "text": "அப்பயாரல்லவய"
    },
    {
      "t": "01:40",
      "text": "நா வேணா காட்டவா"
    },
    {
      "t": "01:42",
      "text": "என் பே சொல்றதான் தெரியும்"
    },
    {
      "t": "01:44",
      "text": ""
    },
    {
      "t": "01:46",
      "text": "எங்க வரும்னும் அது கூட தெரிய மாட்டேங்க இதுல்ல"
    },
    {
      "t": "01:48",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "01:50",
      "text": "பாருங்க"
    },
    {
      "t": "01:52",
      "text": "ஆஹ வ"
    },
    {
      "t": "01:54",
      "text": "பாக்குறதுக்கு"
    },
    {
      "t": "01:56",
      "text": "அதே ஜானமர் தான் எடுக்குறீங்க"
    },
    {
      "t": "01:58",
      "text": "ஏஜ் அந்த மாதிரி இருக்குதுனா டுவெண்ட்டி ஃபை"
    },
    {
      "t": "02:00",
      "text": "ப் ஆயிடுச்சு நான் என்ன பண்றது"
    },
    {
      "t": "02:02",
      "text": "ஓ சரிக்கே"
    },
    {
      "t": "02:04",
      "text": "கல்யாணம் ஆகல"
    },
    {
      "t": "02:06",
      "text": "அதனால எல்லாம் ஒண்ணும் பண்ண முடியாதுல்ல ஏஜ"
    },
    {
      "t": "02:08",
      "text": "சயச்சுதான்ம்"
    },
    {
      "t": "02:10",
      "text": "எனக்கு தான் கல்யா"
    },
    {
      "t": "02:12",
      "text": "உம் உங்க வயசு என்ன"
    },
    {
      "t": "02:14",
      "text": "எனனைக்கு இருபத்தி நாலு"
    },
    {
      "t": "02:16",
      "text": "உம் உங்களை விட ந"
    },
    {
      "t": "02:18",
      "text": "ஒரு வருஷம் பெருசுதா இருந்த"
    },
    {
      "t": "02:20",
      "text": "ஆாலும் ஏஜான மாதிர இருக்குன்ன நீங்களே சொல்லிட்டீங்க"
    },
    {
      "t": "02:22",
      "text": "ஆமா"
    },
    {
      "t": "02:24",
      "text": "உம் தரிவிடுங்க"
    },
    {
      "t": "02:26",
      "text": "அதெல்லாம் ஒன்னும் பிரச்சனை இல்ல ஏஜான் என்ன"
    },
    {
      "t": "02:28",
      "text": "பண்ண முடியும் நம்ம ஜீன் அப்படி"
    },
    {
      "t": "02:30",
      "text": "உஹம்"
    },
    {
      "t": "02:32",
      "text": "உம்"
    },
    {
      "t": "02:34",
      "text": "தருூர்ல இருக்க"
    },
    {
      "t": "02:36",
      "text": "இருக்கீங்களா வரும் ஆமா"
    },
    {
      "t": "02:38",
      "text": "ஓககே"
    },
    {
      "t": "02:40",
      "text": "ஏன் இந்த நேரத்துல கார"
    },
    {
      "t": "02:42",
      "text": "ல வீட்டுக்கு போலியா"
    },
    {
      "t": "02:44",
      "text": "இல்ல"
    },
    {
      "t": "02:46",
      "text": "ஆபிஸ்ல இருந்து இப்பதான் வந்தேன் சரி"
    },
    {
      "t": "02:48",
      "text": "அப்படியே கார்லயே படுத்துட்டேன்"
    },
    {
      "t": "02:50",
      "text": "ஓகே"
    },
    {
      "t": "02:52",
      "text": "சாப்பிட்டீங்களா"
    },
    {
      "t": "02:54",
      "text": "சாப்பிட்டங்க நீங்க"
    },
    {
      "t": "02:56",
      "text": "சாப்பிட்டா வரும்"
    },
    {
      "t": "02:58",
      "text": ""
    },
    {
      "t": "03:00",
      "text": ""
    },
    {
      "t": "03:02",
      "text": ""
    },
    {
      "t": "03:04",
      "text": "இந்த எ தெரிஞ்சுக்கணுமா"
    },
    {
      "t": "03:06",
      "text": "ஆஹ் சொல்லுங்க சொல்லுங்க"
    },
    {
      "t": "03:08",
      "text": ""
    },
    {
      "t": "03:10",
      "text": "இதுல வீடியோக்கள்ல்லாம் மோச"
    },
    {
      "t": "03:12",
      "text": "்லி வந்து எயிட்டீன் ப்ளஸ் வரும்"
    },
    {
      "t": "03:14",
      "text": "ஓகே"
    },
    {
      "t": "03:16",
      "text": "ஆனா வந்து இதுல அதிகமா பேச மாட்டாங்க"
    },
    {
      "t": "03:18",
      "text": "வாட்ஸ்அப் நம்பர் அந்த மாதிரி கொடு"
    },
    {
      "t": "03:20",
      "text": "கொடுத்து அமௌண்ட் பே பண்ண சொல்லி"
    },
    {
      "t": "03:22",
      "text": "அது போலச்சில"
    },
    {
      "t": "03:24",
      "text": "பேசுவாங்களாமா ஒரு சிலர் வந்து"
    },
    {
      "t": "03:26",
      "text": "சீட் பண்ணிட்டு போயிடுவாங்க பிளாக் பண்ணி"
    },
    {
      "t": "03:28",
      "text": "ா அப்பல்லாம் சொன்னாங்க"
    },
    {
      "t": "03:30",
      "text": "ஆ நீங்க வாட்ஸ்அப் நம்பர்"
    },
    {
      "t": "03:32",
      "text": "குடுத்து போ வர வா அப்பட"
    },
    {
      "t": "03:34",
      "text": "சொன்னாங்கன்னா இது பண்ணாதீங்க"
    },
    {
      "t": "03:36",
      "text": "இதுலயே பேசுவாங்கல்ல"
    },
    {
      "t": "03:38",
      "text": "ஆமா அவங்க கூட பேச"
    },
    {
      "t": "03:40",
      "text": "க்கங்க அதான் சேஃ"
    },
    {
      "t": "03:42",
      "text": "ஓகே"
    },
    {
      "t": "03:44",
      "text": "பரவங்களில்ல்ல நீ பேசினா மட்டும் போதும் அப்படியே சொல்ல"
    },
    {
      "t": "03:46",
      "text": "சொன்னீங்கன்னா இதுலயே பேசுவாங்க"
    },
    {
      "t": "03:48",
      "text": "ம் ம் அந்த மாதிரி யூஸ்"
    },
    {
      "t": "03:50",
      "text": "பண்ணிக்காங்க வாட்ஸ்அப் எல்லாம்"
    },
    {
      "t": "03:52",
      "text": "து பண்ணி நிறைய பேர் சொல்லி இருக்காங்க சீட் பண்ணி"
    },
    {
      "t": "03:54",
      "text": "பண்ண போயடுறாங்க"
    },
    {
      "t": "03:56",
      "text": "ஜாஸ்தி வரது இல்ல பிளாக் பண்ணிடுறாங்க"
    },
    {
      "t": "03:58",
      "text": "சொல்லு ஓகே ஓகே"
    },
    {
      "t": "04:00",
      "text": "உம் இது வீட்டு"
    },
    {
      "t": "04:02",
      "text": "உக்கால ஒரு சில"
    },
    {
      "t": "04:04",
      "text": "வந்து என்ன மாதிரியும் பேசுவாங்க பிரரெண்ட்"
    },
    {
      "t": "04:06",
      "text": "மட்டும் பேசுவாங்க"
    },
    {
      "t": "04:08",
      "text": "ஆடியோ காால்லயும் சடைம்ஸ்"
    },
    {
      "t": "04:10",
      "text": "வந்து நம்பர் கொடுத்து"
    },
    {
      "t": "04:12",
      "text": "் வாட்ஸ்அப் அந்த மாிர ரெண்டுயுமே"
    },
    {
      "t": "04:14",
      "text": "ப்புறமமா உம்"
    },
    {
      "t": "04:16",
      "text": "மோஸ்ட்லி"
    },
    {
      "t": "04:18",
      "text": "அந்த மாதிரி இது பண்ற மாதிரி"
    },
    {
      "t": "04:20",
      "text": "இருந்தா வீடியோ கால் வந்திருக்காங்க இல்ல"
    },
    {
      "t": "04:22",
      "text": "பேசினா மட்டும் போதும்னா நீங்க ஆடியோ"
    },
    {
      "t": "04:24",
      "text": "கால்லே போல ஆடியோ காால்ல ரொம்ப நேரம் டைம்"
    },
    {
      "t": "04:26",
      "text": "கிடைக்கும் ஆனா வீடியோ"
    },
    {
      "t": "04:28",
      "text": "வந்து சயின்ஸ் அதிகமா போகும் சோ அதனால"
    },
    {
      "t": "04:30",
      "text": "சீக்கிரமா முடிஞ்சிர"
    },
    {
      "t": "04:32",
      "text": "மாதிரி இருக்கும்"
    },
    {
      "t": "04:34",
      "text": "ஓ போ நீ"
    },
    {
      "t": "04:36",
      "text": "ஆடியோ காலில் நீ அட்டென்் பண்ண"
    },
    {
      "t": "04:38",
      "text": "ாமா உம்"
    },
    {
      "t": "04:40",
      "text": "ஆடியோ கால்ல நான் ஆன்லைன்"
    },
    {
      "t": "04:42",
      "text": "இருந்துனா எனக்கு ஆடியோ கால் கனெக்ட் ஆகும்"
    },
    {
      "t": "04:44",
      "text": "இல்லன்னா வேண"
    },
    {
      "t": "04:46",
      "text": "கரெக்ட கெக் பண்றது நான் எப்படி பண்றது"
    },
    {
      "t": "04:48",
      "text": "கன பண்ண முடியாது"
    },
    {
      "t": "04:50",
      "text": "ஒன்ஸ் நான் வீடியோ கால் வந்துட்டேன்னா வீடியோ"
    },
    {
      "t": "04:52",
      "text": "அவ மட்டம்தான் பேசிக்கணும் அ"
    },
    {
      "t": "04:54",
