{
  "file_id": "rec_default_425939252_audio_1788935280682.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 380.472,
  "processing_time_sec": 13.615535020828247,
  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": ""
    },
    {
      "t": "00:04",
      "text": "അൊക്ക"
    },
    {
      "t": "00:06",
      "text": ""
    },
    {
      "t": "00:08",
      "text": "എവിടെയാ സ്ഥലം"
    },
    {
      "t": "00:10",
      "text": "ഞാൻ എറണാകുളം"
    },
    {
      "t": "00:12",
      "text": "ഉ വിജയണോ"
    },
    {
      "t": "00:14",
      "text": "നി കർ ശോ"
    },
    {
      "t": "00:16",
      "text": "റൂമി വർക്ക് ചെയ്യാം"
    },
    {
      "t": "00:18",
      "text": "ഉം വല്ിയ വർക്കല്ലേ"
    },
    {
      "t": "00:20",
      "text": "എന്ന"
    },
    {
      "t": "00:22",
      "text": "ള്ളരുന്നു ന പോകുന്നു പ"
    },
    {
      "t": "00:24",
      "text": ""
    },
    {
      "t": "00:26",
      "text": "അ"
    },
    {
      "t": "00:28",
      "text": "പിന്നെ എവിടുന്നാ വിളിക്കുന്നത്"
    },
    {
      "t": "00:30",
      "text": "ഞാൻ ഗുരുവായൂ"
    },
    {
      "t": "00:32",
      "text": "ഗുരാന"
    },
    {
      "t": "00:34",
      "text": "എന് ചെയ്യുന്നോ"
    },
    {
      "t": "00:36",
      "text": "ഞാനൊരു തിരുമേനിയാണ്"
    },
    {
      "t": "00:38",
      "text": "ഉ"
    },
    {
      "t": "00:40",
      "text": "അമ്പത്തി തിരുവേനിയണാ"
    },
    {
      "t": "00:42",
      "text": ""
    },
    {
      "t": "00:44",
      "text": "വാ കാണല്േ"
    },
    {
      "t": "00:46",
      "text": "ജൾസില"
    },
    {
      "t": "00:48",
      "text": "ശ ശ ശ നണല്ലല്ല"
    },
    {
      "t": "00:50",
      "text": "ഒന്ന ഒരു തെരികിട പണി"
    },
    {
      "t": "00:52",
      "text": "ല്ല"
    },
    {
      "t": "00:54",
      "text": "എന്താ പേര് ശരിക്കും"
    },
    {
      "t": "00:56",
      "text": "എൻന്റെറെ പേര് ശരണ്യ"
    },
    {
      "t": "00:58",
      "text": ""
    },
    {
      "t": "01:00",
      "text": "ശരിക്കും സ്ല എവിടെ"
    },
    {
      "t": "01:02",
      "text": "പത്തനംതിട്ട"
    },
    {
      "t": "01:04",
      "text": ""
    },
    {
      "t": "01:06",
      "text": "ഞാൻ എറണാകുളത്ത് പറ"
    },
    {
      "t": "01:08",
      "text": "ചെയ താമസം എവിടൊണ്"
    },
    {
      "t": "01:10",
      "text": "ഇവിടെ എറണാകുളത്താ"
    },
    {
      "t": "01:12",
      "text": "ആസ്"
    },
    {
      "t": "01:14",
      "text": "ഈ എവിടെയ താമസ അവസ്ഥല്ലോ"
    },
    {
      "t": "01:16",
      "text": "ഇതൊരു അല്ലല്ല ഇത് അപ്പാർട്ട്മെന്റ"
    },
    {
      "t": "01:18",
      "text": ""
    },
    {
      "t": "01:20",
      "text": "ഏതമ്പഴത്തില് ശാന്തിയാ"
    },
    {
      "t": "01:22",
      "text": "എൺപത്"
    },
    {
      "t": "01:24",
      "text": "ഇതൊന്ന ഇല്ല ഇപ്പൊ പത്ത് വയസ് കുറായില്ല ഇപ്പ"
    },
    {
      "t": "01:26",
      "text": "സ്ഥിരമൊന്നും പനിയൊന്നുംല്ല"
    },
    {
      "t": "01:28",
      "text": "അ എല്ലപ്പോളും പോവും"
    },
    {
      "t": "01:30",
      "text": "പരിപാടി കിട്ടിയത്രയുള്ളു"
    },
    {
      "t": "01:32",
      "text": "ആണോ ആഹ"
    },
    {
      "t": "01:34",
      "text": "ജോലിിച്ചക്കറിയവാ"
    },
    {
      "t": "01:36",
      "text": ""
    },
    {
      "t": "01:38",
      "text": "ജോലസി ത"
    },
    {
      "t": "01:40",
      "text": "െറികടപ്പണിയണാ"
    },
    {
      "t": "01:42",
      "text": "പരിികണ ഇണ്ടായില് ധാരാളം"
    },
    {
      "t": "01:44",
      "text": "ആ"
    },
    {
      "t": "01:46",
      "text": "ആണോല്ലോര് പറയണ"
    },
    {
      "t": "01:48",
      "text": ""
    },
    {
      "t": "01:50",
      "text": "കാര്യം ചോദിച്ചോട്ടെ"
    },
    {
      "t": "01:52",
      "text": "ഏ"
    },
    {
      "t": "01:54",
      "text": "ഈ കു ബാത്രറൂം"
    },
    {
      "t": "01:56",
      "text": "കൂടുപാത്രംന്ന് പറഞ്ഞ"
    },
    {
      "t": "01:58",
      "text": "അതൊക്കെ അതൊക്കെ കള്ളണോ സത്യ"
    },
    {
      "t": "02:00",
      "text": "റില്ല"
    },
    {
      "t": "02:02",
      "text": "അങ്ങന അറാത്ത അറിയില്ല എന്ന പറ"
    },
    {
      "t": "02:04",
      "text": "ചെറിയ കോൾഡ് ബാത്റം മറ്റേ ബാത്റൂം"
    },
    {
      "t": "02:06",
      "text": "ശ"
    },
    {
      "t": "02:08",
      "text": "എനിക്ക"
    },
    {
      "t": "02:10",
      "text": "പാത്രത്തിനേ പറ്റി അറിയുള്ളൂ"
    },
    {
      "t": "02:12",
      "text": "അതല്ല ഞാൻ ചോദിച്ച"
    },
    {
      "t": "02:14",
      "text": "അണയം എന്റെ ചേട്ടനെ"
    },
    {
      "t": "02:16",
      "text": "എനിക്കൊരു ചേട്ടനുണ്ട് എന്റെ മൂത്താള്"
    },
    {
      "t": "02:18",
      "text": "ആ"
    },
    {
      "t": "02:20",
      "text": "അയാള് കല്യാണം കഴിച്ചിട്ട്"
    },
    {
      "t": "02:22",
      "text": "അത്ര നല്ല സ്വരത്തിലൊന്നും അല്ല"
    },
    {
      "t": "02:24",
      "text": "കൂട് പാത്രംല്ല കൂടപത്രം"
    },
    {
      "t": "02:26",
      "text": "പറം നൗ പറ"
    },
    {
      "t": "02:28",
      "text": "ആ അത് തന്നെ അത് തന്നെ"
    },
    {
      "t": "02:30",
      "text": "ടും"
    },
    {
      "t": "02:32",
      "text": "അങ്ങ ആ പെണ്ണൻ"
    },
    {
      "t": "02:34",
      "text": "എ വട്ടുകണ്ടല്ലോ"
    },
    {
      "t": "02:36",
      "text": "അമ്മയ്ക്ക്"
    },
    {
      "t": "02:38",
      "text": "ലക്ക് അനുഭവം"
    },
    {
      "t": "02:40",
      "text": "അനുഭവം ഉണ്ടോ എന്ന് പറയണ ന എ"
    },
    {
      "t": "02:42",
      "text": ""
    },
    {
      "t": "02:44",
      "text": "എന്റെ ചേട്ടന്റെ ജീവിതം ആകെ പോയി നാശ"
    },
    {
      "t": "02:46",
      "text": "ിച്ചു പോയന്നെ"
    },
    {
      "t": "02:48",
      "text": "ഉ എക്ക പറ"
    },
    {
      "t": "02:50",
      "text": "ഭഗവാനെ വിളിക്കുക ഭഗവാനോട് പ്രാർത്ഥിക്കുക"
    },
    {
      "t": "02:52",
      "text": "തൊക്കെ പെറ്റേ ചെയ്യുള്ളൂത"
    },
    {
      "t": "02:54",
      "text": "പക്ഷെ അതിനകത്ത് വേറൊരുന്ന് വൊൽ അ"
    },
    {
      "t": "02:56",
      "text": "െ ജോലി അങ്ങ് ഇവിടെ ഹൈദരാബാദിലാ"
    },
    {
      "t": "02:58",
      "text": "ഉം"
    },
    {
      "t": "03:00",
      "text": "അന്നൻ അവിടെ ഒരു ഒരു പെണ്ണുമാർ"
    },
    {
      "t": "03:02",
      "text": "ആ് സെറ്റപ്പ ആയിട്ട് ആ പെണ്ണ ഒരു കൊച്ചുണ്ടാവ"
    },
    {
      "t": "03:04",
      "text": ""
    },
    {
      "t": "03:06",
      "text": "ആ"
    },
    {
      "t": "03:08",
      "text": "ഇവിടുത്തെ ഇവിടുത്തെ ഭാര്യ"
    },
    {
      "t": "03:10",
      "text": "നമ്മ വീാപെണ് എന്റൊത്തു എന്ന് പറഞ്ഞി"
    },
    {
      "t": "03:12",
      "text": "എി ആപ്പനന്റെ വീട്ടിലാ"
    },
    {
      "t": "03:14",
      "text": "ആ അവവിടെ പോയപ്പോ അവിടെ"
    },
    {
      "t": "03:16",
      "text": ""
    },
    {
      "t": "03:18",
      "text": "വേണ്ട ചേട്ടനും വേണ്ട"
    },
    {
      "t": "03:20",
      "text": "പിന്നെ ലീഗലി ഇങ്ങനെ നക്കുന്നതന്നേ ഉള്ളു"
    },
    {
      "t": "03:22",
      "text": "അങ്ങനെ"
    },
    {
      "t": "03:24",
      "text": "അപ്പൊ അതിനെന്ത് ചെയ്യ"
    },
    {
      "t": "03:26",
      "text": "എ"
    },
    {
      "t": "03:28",
      "text": "നെ വിട്ടി ഭഗവാനോട് പറയാ നല്ലോണം"
    },
    {
      "t": "03:30",
      "text": "പ്രാർത്ഥിക്കുക നാമഞ്ചരിക്കുകൻ ഒരാൾിവ"
    },
    {
      "t": "03:32",
      "text": "ഇക്ക യാ"
    },
    {
      "t": "03:34",
      "text": "ചേട്ടനോടും പറയാ അത"
    },
    {
      "t": "03:36",
      "text": "ആാരോ അതൊെ തന്നെയ"
    },
    {
      "t": "03:38",
      "text": "അ അ"
    },
    {
      "t": "03:40",
      "text": "ആ പെടിനെ വേണ്ട"
    },
    {
      "t": "03:42",
      "text": "േണ്ടെങ്കിൽ വേണ്ട അത് ഒഴിവായിി കിട്ടാൻാ"
    },
    {
      "t": "03:44",
      "text": "കിട്ടിയട്ടത് നേരെ ആവാൻ പറ"
    },
    {
      "t": "03:46",
      "text": ""
    },
    {
      "t": "03:48",
      "text": "അല്ല അല്ല തിരുമേനി"
    },
    {
      "t": "03:50",
      "text": "ആ ഒഴിഞ്ഞു പോകാൻ പറഞ്ഞാ"
    },
    {
      "t": "03:52",
      "text": "ആെണ് ഒഴിഞ്ഞു പോകുന്നില്ല ആെണ്ി പൈസ വേണം"
    },
    {
      "t": "03:54",
      "text": "ചോിക്ക വ"
    },
    {
      "t": "03:56",
      "text": "വലിയ എമൗണ്ടാ"
    },
    {
      "t": "03:58",
      "text": "ഇ പറഞ്ഞണ്ട് നമുക്ക് നേരേക്കാൻ പറ്റില്ല"
    },
    {
      "t": "04:00",
      "text": "അതൊക്കെ നമ്മള് നേരെ നല്ലതരിക്കാത"
    },
    {
      "t": "04:02",
      "text": "തീരാൻ പ്രാർത്ഥുക അന്താച്ചാ"
    },
    {
      "t": "04:04",
      "text": "അങ്ങടും ഇങ്ങടും സഹകരിച്ച് അവസാനിപ്പിക്കാം"
    },
    {
      "t": "04:06",
      "text": "ഞാന് ഹിന്ദു ആണേ"
    },
    {
      "t": "04:08",
      "text": "ഹിന്ദുവാ ഏറ്റവും നല്ല ദൈവ"
    },
    {
      "t": "04:10",
      "text": "ഏതാ ഹിന്ദുയില്"
    },
    {
      "t": "04:12",
      "text": "അങ്ങനെയൊന്നുമല്ല എല്ലാ ദൈവവും നല്ലതാണ്"
    },
    {
      "t": "04:14",
      "text": "അങ്ങനെയൊന്നും ഞാൻ പറയില്ല ഒരു ദൈവം നല്ലത്ല്ല"
    },
    {
      "t": "04:16",
      "text": "ദൈവം ചീത്ത അങ്ങന എല്ലാ ദൈവവും"
    },
    {
      "t": "04:18",
      "text": "ദൈവം ഈശ്"
    },
    {
      "t": "04:20",
      "text": "വിശ്വാസം ഉണ്ടാവണം"
    },
    {
      "t": "04:22",
      "text": "പക്ഷെ എനിക്ക എല്ലാം മാത്രം"
    },
    {
      "t": "04:24",
      "text": "ദൈവ  ഞാൻ വച്ചിട്ട് നോക്കുമ്പോ"
    },
    {
      "t": "04:26",
      "text": "ഒരു ദൈവവും ഉള്ളൂ അത് മനുഷ്യന"
    },
    {
      "t": "04:28",
      "text": "ഉ ആഹ"
    },
    {
      "t": "04:30",
      "text": "എന്നാനന്റെ വിശ്വാസത്തിൽ പോവാ"
    },
    {
      "t": "04:32",
      "text": "രണ്ട വേറെ കണി കണ്ട അന്ത വിശ്വാസന്"
    },
    {
      "t": "04:34",
      "text": "എന്റെ മുകളിൽ പോകവാണ്ട് അവുടെ വിശ്വാസത്തിൽ"
    },
    {
      "t": "04:36",
      "text": "ഇല്ല അമ്മച്ചാൻ"
    },
    {
      "t": "04:38",
      "text": "ദൈവം ഡയറക്ട് നമ്മുടെ മുന്നിൽ വ"
    },
    {
      "t": "04:40",
      "text": "വത്തില്ല മനുഷ്യരുടെ രൂപത്തിലേ വരുത്തുള്ളൂ"
    },
    {
      "t": "04:42",
      "text": "ച മാച്ച"
    },
    {
      "t": "04:44",
      "text": "ഉം"
    },
    {
      "t": "04:46",
      "text": "അത്രേള്ള ആ"
    },
    {
      "t": "04:48",
      "text": "ദൈവന്റെ ആരോട്ട ഒരിക്കലും നമ്മുടെ മുന്നേ വരുത്തില്ല"
    },
    {
      "t": "04:50",
