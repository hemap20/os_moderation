    {
      "t": "00:06",
      "text": "എവിടെതാണ്"
    },
    {
      "t": "00:08",
      "text": "ഉ കമാാലി"
    },
    {
      "t": "00:10",
      "text": "എന്ത പരിപാടി"
    },
    {
      "t": "00:12",
      "text": "അ"
    },
    {
      "t": "00:14",
      "text": "പരിപാടില്ല വെറുതെരിക്കണം"
    },
    {
      "t": "00:16",
      "text": "ഓക്കെ ഓക്ക"
    },
    {
      "t": "00:18",
      "text": "ബക്കുള്ളോരക്കെ എവിടെയാീ"
    },
    {
      "t": "00:20",
      "text": ""
    },
    {
      "t": "00:22",
      "text": "കു അവരക്കെവിടെ"
    },
    {
      "t": "00:24",
      "text": "കുട്ടല്ല സ്കൂള പോ"
    },
    {
      "t": "00:26",
      "text": "ചട്ടൻ"
    },
    {
      "t": "00:28",
      "text": "ചരിക്ക"
    },
    {
      "t": "00:30",
      "text": "പച്ചമ്മ"
    },
    {
      "t": "00:32",
      "text": "ബോറടിച്ചിരിക്കാണ്"
    },
    {
      "t": "00:34",
      "text": "അ"
    },
    {
      "t": "00:36",
      "text": "അവിടെ ആറൊക്കെയണ്ട്"
    },
    {
      "t": "00:38",
      "text": "ഇവിടെ അച്ഛനമാന"
    },
    {
      "t": "00:40",
      "text": "അനിയത്തി അത്ര"
    },
    {
      "t": "00:42",
      "text": "കേട്ട"
    },
    {
      "t": "00:44",
      "text": "അമ്മ അനിയൻ മനിയത്തി"
    },
    {
      "t": "00:46",
      "text": "മാരിടാ ഇ"
    },
    {
      "t": "00:48",
      "text": "അല്ലല്ല അല്ല"
    },
    {
      "t": "00:50",
      "text": ""
    },
    {
      "t": "00:52",
      "text": "എന്താ"
    },
    {
      "t": "00:54",
      "text": "വർക്കല്ലേന്ന്"
    },
    {
      "t": "00:56",
      "text": "എന്നാലേ ഇവിടെത്തെക്കുന്നു"
    },
    {
      "t": "00:58",
      "text": "ടെ സ്ഥലം എവിടെയൊക്കെ"
    },
    {
      "t": "01:00",
      "text": "തൃശ്ശൂര് തൃശ്ശൂര് തൃശ്ശൂ"
    },
    {
      "t": "01:02",
      "text": "ഓ"
    },
    {
      "t": "01:04",
      "text": "ിച്ച"
    },
    {
      "t": "01:06",
      "text": "ഴപ്പല്ല അപല്ലെ"
    },
    {
      "t": "01:08",
      "text": "മനസ്സില കിട്ടിയ"
    },
    {
      "t": "01:10",
      "text": "ഇ അത്ര"
