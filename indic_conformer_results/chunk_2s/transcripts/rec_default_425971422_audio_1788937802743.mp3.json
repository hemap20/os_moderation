    {
      "t": "01:12",
      "text": "ഇ"
    },
    {
      "t": "01:14",
      "text": "രണ്ടാഴച"
    },
    {
      "t": "01:16",
      "text": "ഞാന ഏകദേശത്രനായിട്ടുള്ളു"
