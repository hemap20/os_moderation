    {
      "t": "01:34",
      "text": "ര കൊഴപ്പൊന്നല്ല"
    },
    {
      "t": "01:36",
      "text": "നക്ക നീണ്ടാ അനുഭവിച്ചത്"
    },
    {
      "t": "01:38",
      "text": "നേരിട്ടനുഭവിച്ചാ"
    },
    {
      "t": "01:40",
      "text": "ഇട്ടട്ട് അനുപ്പം"
    },
