  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "ഹയി"
    },
    {
      "t": "00:04",
      "text": "ഹലോ"
    },
    {
      "t": "00:06",
      "text": "സ്ഥലം എവിടെയായിരുന്നു"
    },
    {
      "t": "00:08",
      "text": "പോണ്ടോ"
    },
    {
      "t": "00:10",
      "text": "വടെേോ"
    },
    {
      "t": "00:12",
      "text": "ഞാൻ എറണാകുളം"
    },
    {
      "t": "00:14",
      "text": "അന്തന്ന"
    },
    {
      "t": "00:16",
      "text": "ഓക്കെ എന്നാ"
    },
    {
      "t": "00:18",
      "text": "ന്ത"
    },
    {
      "t": "00:20",
      "text": "ഉം എകോല്ല"
    },
    {
      "t": "00:22",
      "text": ""
    },
    {
      "t": "00:24",
      "text": "എന്താ പരിപാടി"
    },
    {
      "t": "00:26",
      "text": ""
    },
    {
      "t": "00:28",
      "text": "േച്ച പരിപാടിയൊന്നുംല്ല"
    },
    {
      "t": "00:30",
      "text": "ഇ"
    },
    {
      "t": "00:32",
      "text": "മ ലണ"
    },
    {
      "t": "00:34",
      "text": "വരട്ടല്ല"
    },
    {
      "t": "00:36",
      "text": "അന്ത മഡല"
    },
    {
      "t": "00:38",
      "text": "ഭരിീടല്ലാം"
    },
    {
      "t": "00:40",
      "text": "പൈസായില്ല"
    },
    {
      "t": "00:42",
      "text": "അസ"
    },
    {
      "t": "00:44",
      "text": "ഇരുപത്തി നാല്"
    },
    {
      "t": "00:46",
      "text": "ശരി ശരി"
    },
    {
      "t": "00:48",
      "text": "ഇരുപത്തിനാല്"
    },
    {
      "t": "00:50",
      "text": "വയ കഴ"
    },
    {
      "t": "00:52",
      "text": "തക്ക"
    },
    {
      "t": "00:54",
      "text": ""
    },
    {
      "t": "00:56",
      "text": ""
    },
    {
      "t": "00:58",
      "text": "കഴിക്കണമെങ്കിൽ കഴിക്കാം"
    },
    {
      "t": "01:00",
      "text": "ിക്കണം എന്താ നിർബന്ധം ഒന്നുമല്ലല്ലോ"
    },
    {
      "t": "01:02",
      "text": "അതുകൊണ്ട് കഴിച്ചില്ല കഴിക്കണം"
    },
    {
      "t": "01:04",
      "text": "ഒരുപന്നാല് വയസ കാര്യങ്ങളൊക്കെ"
    },
    {
      "t": "01:06",
      "text": "ണ്ട് ഏ"
    },
    {
      "t": "01:08",
      "text": "കാര്യങ്ങളൊക്കെ നടന്നു പോേണ്ട"
    },
    {
      "t": "01:10",
      "text": "എന്ത് കാര്യങ്ങള"
    },
    {
      "t": "01:12",
      "text": "ഏത് കാര്യങ്ങളായിരിക്കും"
    },
    {
      "t": "01:14",
      "text": "ആ"
    },
    {
      "t": "01:16",
      "text": "എട്ട് നാല് വയസ്സായില്ലേ വത"
    },
    {
      "t": "01:18",
      "text": "കൈല്"
    },
    {
      "t": "01:20",
      "text": "വലുതായി"
    },
    {
      "t": "01:22",
      "text": "ഒരുപാട് പേര് എന്തായല്ലല്ലോ ടൈം"
    },
    {
      "t": "01:24",
      "text": "ഉണ്ടല്ലോ"
    },
    {
      "t": "01:26",
      "text": "എനിക്ക് എത്ര പോയി തോന്ന"
    },
    {
      "t": "01:28",
      "text": "എനിക്ക് എത്ര പയ തോന്ന"
    },
    {
      "t": "01:30",
      "text": "ോന്നിക്കല്ല"
    },
    {
      "t": "01:32",
      "text": "ശ"
    },
    {
      "t": "01:34",
      "text": "ഇരുപത്തി എട്ട്"
    },
    {
      "t": "01:36",
      "text": ""
    },
    {
      "t": "01:38",
      "text": "അത"
    },
    {
      "t": "01:40",
      "text": "എന്നല് മുപ്പത്"
    },
    {
      "t": "01:42",
      "text": "ട്ട"
    },
    {
      "t": "01:44",
      "text": "രേസായി"
    },
    {
      "t": "01:46",
      "text": "ഇരുപത്തിാറ്"
    },
    {
      "t": "01:48",
      "text": "അ"
    },
    {
      "t": "01:50",
      "text": "അ"
    },
    {
      "t": "01:52",
      "text": "ചതുു ചത്ത ബസ്"
    },
    {
      "t": "01:54",
      "text": "എന്ത് ചെയ്യുന്ന വോക്കിയമോ"
    },
    {
      "t": "01:56",
      "text": "എന്ത"
    },
    {
      "t": "01:58",
      "text": "പത്ത"
    },
    {
      "t": "02:00",
      "text": "അഐ്രി"
    },
    {
      "t": "02:02",
      "text": "ഓ"
    },
    {
      "t": "02:04",
      "text": "ഉ കൊ"
    },
    {
      "t": "02:06",
      "text": "ോ സന്ന്"
    },
    {
      "t": "02:08",
      "text": ""
    },
    {
      "t": "02:10",
      "text": "ഞാൻ ഒപ്ഷോറിലായിരുന്നു"
    },
    {
      "t": "02:12",
      "text": "ഇപ്പം രണ്ട മൂന്ന് ദിവസംട്ട് ഇപ്പ ക വന്നേള്ള"
    },
    {
      "t": "02:14",
      "text": "എടുത്തത"
    },
    {
      "t": "02:16",
      "text": "എന്താന്നും കേട്ടില്ല"
    },
    {
      "t": "02:18",
      "text": "ഒഷർ"
    },
    {
      "t": "02:20",
      "text": "കടലിിനകത്ത്"
    },
    {
      "t": "02:22",
      "text": "ആഹ"
    },
    {
      "t": "02:24",
      "text": "അട്ട"
    },
    {
      "t": "02:26",
      "text": ""
    },
    {
      "t": "02:28",
      "text": "പിന്ന എങ്ങനെയാണ്"
    },
    {
      "t": "02:30",
      "text": "ഒഓപ്പൺ ോക്കിനൊക്കെ തലപര്റ കാണം"
    },
    {
      "t": "02:32",
      "text": "പപ്പണ്ടോക്കാം"
    },
    {
      "t": "02:34",
      "text": "ഉം"
    },
    {
      "t": "02:36",
      "text": "ഏ"
    },
    {
      "t": "02:38",
      "text": "അത"
    },
    {
      "t": "02:40",
      "text": "എടുത്ത അല്ലക്"
    },
    {
      "t": "02:42",
      "text": "അന്ത എടുക്കാത്ത എട്ടക്ക"
    },
    {
      "t": "02:44",
      "text": "മിസ്റ്റർ"
    },
    {
      "t": "02:46",
      "text": "നല്ല നമ്മളെപ്പറത്തെൾ"
    },
    {
      "t": "02:48",
      "text": "കടു ഇൻ്രസ്"
    },
    {
      "t": "02:50",
      "text": ""
    },
    {
      "t": "02:52",
      "text": ""
    },
    {
      "t": "02:54",
      "text": ""
    },
    {
      "t": "02:56",
      "text": "പറ"
    },
    {
      "t": "02:58",
      "text": ""
    },
    {
      "t": "03:00",
      "text": "പറയുന്ന"
    },
    {
      "t": "03:02",
      "text": "ഇതിപ്പ"
    },
    {
      "t": "03:04",
      "text": "തുടങ്ങിട്ട് അങ് മൂന്ന് ദിവസ ആുള്ളി അപ്പ"
    },
    {
      "t": "03:06",
      "text": "ര"
    },
    {
      "t": "03:08",
      "text": "പറഞ്ഞ എടുത്ത"
    },
    {
      "t": "03:10",
      "text": "എങ്ങനെ ഉണ്ട യൂസ് ചെയ്തിട്ട്"
    },
    {
      "t": "03:12",
      "text": "ഏ"
    },
    {
      "t": "03:14",
      "text": "നിെ നിങ്ങളെപ്പോ"
    },
    {
      "t": "03:16",
      "text": "ആൾക്കാരായി കുറച്ച വന്നു"
    },
    {
      "t": "03:18",
      "text": "നെ"
    },
    {
      "t": "03:20",
      "text": "അന്ന് പോയി വക്കും"
    },
    {
      "t": "03:22",
      "text": "പഠക്കല്ലേ ആൻറ്റി മന"
    },
    {
      "t": "03:24",
      "text": ""
    },
    {
      "t": "03:26",
      "text": "ശ രാ"
    },
    {
      "t": "03:28",
      "text": "അനിവാരൊക്കെ എങ്ങനെയുണ്ട് രസ"
    },
    {
      "t": "03:30",
      "text": "ണ്ട"
    },
    {
      "t": "03:32",
      "text": "ഫുള്ള് നരയാണ്"
    },
    {
      "t": "03:34",
      "text": "നേര മുടിിയൊക്കെ നടച്ച"
    },
    {
      "t": "03:36",
      "text": "പിന്നെ"
    },
    {
      "t": "03:38",
      "text": "പിന്നെ"
    },
    {
      "t": "03:40",
      "text": "ക്ഷ്മി അ"
    },
    {
      "t": "03:42",
      "text": "ണോ എല്ലാരും ഇനെ ആന്റിമാരൊക്കെ"
    },
    {
      "t": "03:44",
      "text": "പറയുമ്പോ ഞാൻ വിചാരിക്കും"
    },
    {
      "t": "03:46",
      "text": "നാല്പത് വയസൊക്കെല്ലേ"
    },
    {
      "t": "03:48",
      "text": "ചുരുക്കം ഒരു മുപ്പത്താറു പത്തേഴ"
    },
    {
      "t": "03:50",
      "text": "ക്ക വ പക്ഷെ ചില ആന്"
    },
    {
      "t": "03:52",
      "text": ""
    },
    {
      "t": "03:54",
      "text": "നല്ല പ്രായണ"
    },
    {
      "t": "03:56",
      "text": "നിറച്ചു സൈടൊക്കെ നിറച്ച കറ"
    },
    {
      "t": "03:58",
      "text": ""
    },
    {
      "t": "04:00",
      "text": ""
    },
    {
      "t": "04:02",
      "text": "അവരൊക്കെ ഫുൾിനഓടല്ലേ"
    },
    {
      "t": "04:04",
      "text": ""
    },
    {
      "t": "04:06",
      "text": "ള്ള സരിക്കൂല"
    },
    {
      "t": "04:08",
      "text": "അട്ടേടു വോക്കള"
    },
    {
      "t": "04:10",
      "text": ""
    },
    {
      "t": "04:12",
      "text": "ഇങ്ങനെ എന്ത"
    },
    {
      "t": "04:14",
      "text": "എന്താ അെ കോഴ്സ് വരുമ്പോം"
    },
    {
      "t": "04:16",
      "text": "ാ ഓരോരുത്തര് പറയും"
    },
    {
      "t": "04:18",
      "text": "ഉ അ"
    },
    {
      "t": "04:20",
      "text": "ഒരു ദിവസം ഞൻ ഒരു ദിവസം"
    },
    {
      "t": "04:22",
      "text": "അപ്പൊ ഞ പക ഇങ്ങനെ"
    },
    {
      "t": "04:24",
      "text": "എന്താ ഉണാക്കിയപ്പോ ഉ"
    },
    {
      "t": "04:26",
      "text": "ഒരാ കണക്ട്ായി അപ്പറ അടു"
    },
    {
      "t": "04:28",
      "text": "സോപ്പണ്ടോ"
    },
    {
      "t": "04:30",
      "text": "ആ അങ്ങനെ ചെയ്യാ"
    },
    {
      "t": "04:32",
      "text": "ട്രൈ ചെയ്ത് നോക്ക"
    },
    {
      "t": "04:34",
      "text": "അ"
    },
    {
      "t": "04:36",
      "text": "എന്താ ഓപ്പൺ ഡോക്ക് ചെയ്താ ഓപ്പൺ ഡോക്ക് ചെയ്യാലോ"
    },
    {
      "t": "04:38",
      "text": "എനക്ക് എന്താ വേണ്ടേന്ന് വെച്ചാ"
    },
    {
      "t": "04:40",
      "text": "തൊട്ട് മുന്നെ എനിക്കൊരു"
    },
    {
      "t": "04:42",
      "text": "ഹഓള് കിട്ടിയായിരുന്നു അതിലൊരു"
    },
    {
      "t": "04:44",
      "text": "ചേച്ചി"
    },
    {
      "t": "04:46",
      "text": "അവറിന്റെ താഴെ നിന്ന് കുളിക്കവാ"
    },
    {
      "t": "04:48",
      "text": "അക്ക്"
    },
    {
      "t": "04:50",
      "text": "പെണ്ണുങ്ങളെക്കെോളണറ്റാവോ"
    },
    {
      "t": "04:52",
      "text": "ഏ നിങ്ങക്ക്"
    },
    {
      "t": "04:54",
      "text": "പെണ്ണുങ്ങളുടെ അല്ല"
    },
    {
      "t": "04:56",
      "text": "എറട ഇതൊരു ചേട്ടൻ പറഞ്ഞിയാ"
    },
    {
      "t": "04:58",
      "text": "ഓ"
    },
    {
      "t": "05:00",
      "text": "ആഹ എന്നിട്ട് ഇങ്ങനെ ചേച്ച തോന്ന"
    },
    {
      "t": "05:02",
      "text": "ഓർത്തെ കൊടുത്ത് ഒന്ന് കുളിക്കുവ ഷ അവറിന്റെ"
    },
    {
      "t": "05:04",
      "text": "എന്നിട്ട് മേത്തൊക്കെ"
    },
    {
      "t": "05:06",
      "text": "വെള്ളം നനഞ്ഞ കഴഞ് കഴുമ്പോ തോർത്തക്കൂലരി"
    },
    {
      "t": "05:08",
      "text": "അടിപൊളി പരിപാടിയാ"
    },
    {
      "t": "05:10",
      "text": "പട്ടേ എന്റെ അടുത്ത്പോക്കാ അങ്ങനെ ചെയ്യാൻ പറ്റോ"
    },
    {
      "t": "05:12",
      "text": "ാ അറിയില്ല ചേട്ടമാ"
    },
    {
      "t": "05:14",
      "text": "ലോകത്തുള്ളവർക്കൊക്കെ ചെയ്യാം ഇതിലുള്ളവർക്ക്"
    },
    {
      "t": "05:16",
      "text": "ക്കെ ചെയന്നെന്താ നിട"
    },
    {
      "t": "05:18",
      "text": ""
    },
    {
      "t": "05:20",
      "text": "അങ്ങട്ടേത് കേട്ടല്ലാ"
    },
    {
      "t": "05:22",
      "text": "ഏതനാവുന്നായി"
    },
    {
      "t": "05:24",
      "text": ""
    },
    {
      "t": "05:26",
      "text": "അങ്ങനെ"
    },
    {
      "t": "05:28",
      "text": "അങ്ങനെയുള്ളവരു ഉണ്ട്"
    },
    {
      "t": "05:30",
      "text": "താല്പര്യുള്ള"
    },
    {
      "t": "05:32",
      "text": "ണ്ട് തല്പര്യമില്ലാത്തവരുണ്ട്ത്"
    },
    {
      "t": "05:34",
      "text": "പണ അറിയ"
    },
    {
      "t": "05:36",
      "text": "ഉ"
    },
    {
      "t": "05:38",
      "text": "ശക്ക"
    },
    {
      "t": "05:40",
      "text": ""
    },
    {
      "t": "05:42",
      "text": "ഏിക്ക പുട്ട്ോക്കാണ് താല്പര്യം"
    },
    {
      "t": "05:44",
      "text": "ഏ"
    },
    {
      "t": "05:46",
      "text": "എനിക്കും അപ്പൊ ടോ ടോക്ക് ചെയ്യ"
    },
    {
      "t": "05:48",
      "text": "താല്പര്യ"
    },
    {
      "t": "05:50",
      "text": ""
    },
    {
      "t": "05:52",
      "text": "ആഹ"
    },
    {
      "t": "05:54",
      "text": "ഞാനിതങ്ങനെ പിടിക്കാറില്ല"
    },
    {
      "t": "05:56",
      "text": "പിടിയം"
    },
    {
      "t": "05:58",
      "text": "ന്ന"
    },
    {
      "t": "06:00",
      "text": "ഞാൻങ്ങനെ ഒന്ന രണ്ടരോട് ചോിച്ചു എങ്ങനെയ"
    },
    {
      "t": "06:02",
      "text": "ചെയ്യ എങ്ങനെരിക്ക"
    },
    {
      "t": "06:04",
      "text": "ചെയാണ്"
    },
    {
      "t": "06:06",
      "text": "ട്ര ന"
    },
    {
      "t": "06:08",
      "text": "ഇഷമുള്ള ഒരാളുടെ കൂയല്ല നുക്ക്ങ്ങനെ ഓപ്പ ഉ"
    },
    {
      "t": "06:10",
      "text": "ഇഷ്ടില്ലാത്ത ആ"
    },
    {
      "t": "06:12",
      "text": "കാവുമ്പം"
    },
    {
      "t": "06:14",
      "text": "എന്തും പറയാം"
    },
    {
      "t": "06:16",
      "text": "അതാ പ്രശ്നം"
    },
    {
      "t": "06:18",
      "text": "എന്തും പറയാനുള്ളത്പാ"
    },
    {
      "t": "06:20",
      "text": "സ് ബാൽസോ"
    },
    {
      "t": "06:22",
      "text": "ആഹ സം ചെയ അതാണ് അതാണ്"
    },
    {
      "t": "06:24",
      "text": "്ന എും"
    },
    {
      "t": "06:26",
      "text": "അറിയാം എന്നുള്ള ഒരു ക്ലോസ് വരാന്നെ"
    },
    {
      "t": "06:28",
      "text": "എന്തും പറയും"
    },
    {
      "t": "06:30",
      "text": "ഓപ്പണ്ടോക്കിയ"
    },
    {
      "t": "06:32",
      "text": "നിക്ക് താല്ര്യംണ്ടാവില്ല ൂ"
    },
    {
      "t": "06:34",
      "text": "അ ക്കെ നമു ട്രൈ ചെയ് നക്ക എന്ന് പറയുമോ"
    },
    {
      "t": "06:36",
      "text": "അത്ര നേരം എടവുംന്ന്"
    },
    {
      "t": "06:38",
      "text": "വിളിച്ചൊണ്ടിരുന്ന ആ അടുത്ത"
    },
    {
      "t": "06:40",
      "text": "എന്താള എടിയുന്നും"
    },
    {
      "t": "06:42",
      "text": "ഈ എടീന്ന് വിളിക്കുന്ന നായ്ക്കളെ കണ്ണ"
    },
    {
      "t": "06:44",
      "text": "എടുത്ത കണ്ടൂടാ"
    },
    {
      "t": "06:46",
      "text": "എടി എടി എന്ന് വിളിക്കുന്നത്"
    },
    {
      "t": "06:48",
      "text": "എന്റെ അഭിപ്രായത്തിൽ ഒരു ചീത്ത"
    },
    {
      "t": "06:50",
      "text": "നിഷ്ട"
    },
    {
      "t": "06:52",
      "text": "ഒരു ഒരു ബോയ്ക്ക് ഇടിയൊന്ന് വിളിക്ക"
    },
    {
      "t": "06:54",
      "text": "നിനക്കെ ഇടാന്ന് വിളിക്കല്ലേ അൊ"
    },
    {
      "t": "06:56",
      "text": "എ വി"
    },
    {
      "t": "06:58",
      "text": "ഇടാന്ന് വിളാറില്ലല്ല ഞാൻ ഇടോന്ന് വിളിക്കാറുള്ളൂ"
    },
    {
      "t": "07:00",
      "text": "അ പെണ്ണുങ്ങ"
    },
    {
      "t": "07:02",
      "text": "നമുക്ക് ഈ ഇടോൊന്നും വിളില്ലാൻ പറ്റത്തില്ല"
    },
    {
      "t": "07:04",
      "text": "ഡി  ഡി"
    },
    {
      "t": "07:06",
      "text": "എടി ഒന്ന് പോ"
    },
    {
      "t": "07:08",
      "text": ""
    },
    {
      "t": "07:10",
      "text": "അങ്ങനെയ"
    },
    {
      "t": "07:12",
      "text": "ളിച്ചക്ക്റഞ് പിന്നെ അത്"
    },
    {
      "t": "07:14",
      "text": "കഴിഞ്ഞിട്ടുള്ള ഫസ്ത്ത് ഇത്േടിയായിരിക്കും"
    },
    {
      "t": "07:16",
      "text": "അപ്പൊ തന്നെ ഞാൻൂട്ടെ അത"
    },
    {
      "t": "07:18",
      "text": "ഭയ"
    },
    {
      "t": "07:20",
      "text": "ദന്റെ വടത്തിൽ കാവ്യമതന്"
    },
    {
      "t": "07:22",
      "text": "എ അതാണ്ാ കുടിക്കാത്തത്"
    },
    {
      "t": "07:24",
      "text": "ഇങ്ങനെ പടി അങ്ങനെ"
    },
    {
      "t": "07:26",
      "text": "അതെ ആ ഒരു താർ്യത വന്ന് ഞാൻ എങ്ങനെ"
    },
    {
      "t": "07:28",
      "text": "അഡ്ജസ്റ്റ് ചെയ്ത് നക്കുമ്പോായിരിക്കും അടുത്തത്"
    },
    {
      "t": "07:30",
      "text": "നിന്റെ മുലയുടെ സൈസ് എത്രയാ അപ്പൊ എന്ത"
    },
    {
      "t": "07:32",
      "text": "അ"
    },
    {
      "t": "07:34",
      "text": "കാര്യം ചെയോട്ട കാര്യം"
    },
    {
      "t": "07:36",
      "text": "അ ഈ ഒരു ആപ്പ്"
    },
    {
      "t": "07:38",
      "text": "രണ്ടിനേ കൂയല്ലേ അപ്പൊ ആൾക്കാര് ചോദ്യ എന്താ"
    },
    {
      "t": "07:40",
      "text": "ക്ക"
    },
    {
      "t": "07:42",
      "text": "ഉ പക്ഷെ അങ്ങനെയല്ലേ"
    },
    {
      "t": "07:44",
      "text": "നമ്മക്കിപ്പോ ത"
    },
    {
      "t": "07:46",
      "text": "എന്റെ ശരീരത്തെ പറ്റി പറയുമ്പോ"
    },
    {
      "t": "07:48",
      "text": "അയിന് എന്റെ കൺസെന്റ് വേണം"
    },
    {
      "t": "07:50",
      "text": "അത്"
    },
    {
      "t": "07:52",
      "text": "എന്താണ് അതിനാണ് നമ്മള് പറയുന്നത് ഓപ്പൺ ടോക്ക്"
    },
    {
      "t": "07:54",
      "text": "താല്പര്യമുണ്ടോ നോ ആണെങ്കിൽ"
    },
    {
      "t": "07:56",
      "text": "തര്യ"
    },
    {
      "t": "07:58",
      "text": "ഇല്ല എന്ന് പറഞ്ഞാ അവിടെ കൊണ്ട് നിർത്തണം"
    },
    {
      "t": "08:00",
      "text": "അല്ലെങ്കി ഇത് ചിലരുണ്ട്"
    },
    {
      "t": "08:02",
      "text": "ഉം ഞാന"
    },
    {
      "t": "08:04",
      "text": "ഇപ്പ ഇപ്പ ഇപ്പഴ ത"
    },
    {
      "t": "08:06",
      "text": "എനിക്ക് ഓപ്പൺ ഡോ ചെയ്യാൻ താല്പര്യംന്ന് പറഞ്ഞു"
    },
    {
      "t": "08:08",
      "text": "കേയാളത്തി യസനോന്നന്ന് പറഞ്ഞില്ല"
    },
    {
      "t": "08:10",
      "text": "ഉ"
    },
    {
      "t": "08:12",
      "text": "ഒന്നും പറഞ്ഞില്ലല്ലോ"
    },
    {
      "t": "08:14",
      "text": "കമ്പ ചെയുന്നയ"
    },
    {
      "t": "08:16",
      "text": "ആ അതാ പറഞ്ഞത്"
    },
    {
      "t": "08:18",
      "text": "ഞൻ മറ്റ"
    },
    {
      "t": "08:20",
      "text": "ഓഫ് കുലസ്ത്രീ അങ്ങനെയ ഒന്നും പറയുന്നില്ല"
    },
    {
      "t": "08:22",
      "text": "ഞാൻ ഓപ്പൊക്കെ ചെയ്തിട്ടുണ്ട്"
    },
    {
      "t": "08:24",
      "text": "ചെയ്യാതിരുന്നിട്ടൊന്നുമല്ല ചെയ്തിട്ടുണ്ട്"
    },
    {
      "t": "08:26",
      "text": "പക്ഷെ ഉം"
    },
    {
      "t": "08:28",
      "text": "ഒരാ വ"
    },
    {
      "t": "08:30",
      "text": "ആണൊക്കെ"
    },
    {
      "t": "08:32",
      "text": "പറയുമ്പോ കുറ ചക്റൊന്നും കൂടുന്നില്ല"
    },
    {
      "t": "08:34",
      "text": "തിരി ര"
    },
    {
      "t": "08:36",
      "text": "അത്രേ ഉള്ളൂ"
    },
    {
      "t": "08:38",
      "text": "അതരു ഗ ഇപ്പൊ"
    },
    {
      "t": "08:40",
      "text": "നൊരു ബോയ് ഫ്രണ്ട് വന്ന കഴിഞ്ഞ"
    },
    {
      "t": "08:42",
      "text": "സെക്സ്ില് ർപ്പെട പ്രത്തേക്ക്ി"
    },
    {
      "t": "08:44",
      "text": "എന്താണ് നമ്മളൊരു"
    },
    {
      "t": "08:46",
      "text": "ലൈക്ക് ഒരുറി മൃഗം പോലയിരിക്ക"
    },
    {
      "t": "08:48",
      "text": "പ്രത്യേശാനങ്ങള്ൾ"
    },
    {
      "t": "08:50",
      "text": "അതെന്താണ് നിങ്ങളത് മനസ്സിലാക്കി"
    },
    {
      "t": "08:52",
      "text": "അതിന് സപ്പോർട്ട് കൊടുക്കുക"
    },
    {
      "t": "08:54",
      "text": "അപ്പ അണത് മനസ്സിലായി പോും"
    },
    {
      "t": "08:56",
      "text": "അല്ലാതെ നിങ്ങളരു്ട"
    },
    {
      "t": "08:58",
      "text": "പോലെ നക്കുമ്പഴത്തേക്ക നക്ക്ർട്ടാവും"
    },
    {
      "t": "09:00",
      "text": "അ വീണ ഫോർസ് ഫുള്ളേ"
    },
    {
      "t": "09:02",
      "text": ""
    },
    {
      "t": "09:04",
      "text": "കു കാര്യങ്ങൾ"
    },
    {
      "t": "09:06",
      "text": "കൊണ്ടോൂ കൊറേ കാര്യങ്ങളൊക്കെ കൊണ്ടോൂ"
    },
    {
      "t": "09:08",
      "text": "എന്താണ്"
    },
    {
      "t": "09:10",
      "text": "ചലോ പോ ഭയങ്കര ഡിസ്ർബി"
    },
    {
      "t": "09:12",
      "text": "ഞാൻ കുറച്ച്ാര്ം പറയാ"
    },
    {
      "t": "09:14",
      "text": "ആഹ"
    },
    {
      "t": "09:16",
      "text": "ആഹ"
    },
    {
      "t": "09:18",
      "text": "പറയട്ടല്ലേ"
    },
    {
      "t": "09:20",
      "text": "എന്താ എന്താാര്യ"
    },
    {
      "t": "09:22",
      "text": "ട്ട ആസില എടുത്താത്"
    },
    {
      "t": "09:24",
      "text": "ആഹ്"
    },
    {
      "t": "09:26",
      "text": "ഉം"
    },
    {
      "t": "09:28",
      "text": "ഓർന്ന് സിക്സ്ല്ലേ"
    },
    {
      "t": "09:30",
      "text": "ആ"
    },
    {
      "t": "09:32",
      "text": "ഒരു സാധനം എടുത്ത് വായിലിട്ട് ചപ്പുന്ന"
    },
    {
      "t": "09:34",
      "text": "ഉ"
    },
    {
      "t": "09:36",
      "text": "ഉ അപ്പം അതില്"
    },
    {
      "t": "09:38",
      "text": "പാണ്ട് നല്ല സുഖം കിട്ടും നല്ല സുഖം കട്ടും"
    },
    {
      "t": "09:40",
      "text": "മ്പത്തേക്ക് അന്നപ്രശാര"
    },
    {
      "t": "09:42",
      "text": "അം സ്പ"
    },
    {
      "t": "09:44",
      "text": "വീട കൂടും അപ്പം"
    },
    {
      "t": "09:46",
      "text": "നമക്ക് എന്താണ് മീൻസ്"
    },
    {
      "t": "09:48",
      "text": "അയ്യ ആകുമ്പോഴത്തേക്ക് നമ്മ നമ്മളല്ലാതാവും"
    },
    {
      "t": "09:50",
      "text": "അത സംഭവം"
    },
    {
      "t": "09:52",
      "text": "നിങ്ങ നിങ്ങള് ഹയ്യ ആവുമ്പോ"
    },
    {
      "t": "09:54",
      "text": "ല്ല"
    },
    {
      "t": "09:56",
      "text": "ആ"
    },
    {
      "t": "09:58",
      "text": ""
    },
    {
      "t": "10:00",
      "text": "സിക്സ്റ്റ് ഉണ്ടോ"
    },
    {
      "t": "10:02",
      "text": ""
    },
    {
      "t": "10:04",
      "text": "ഉണ്ട്"
    },
    {
      "t": "10:06",
      "text": "പിന്നെ ഇതൊക്കെ എന്താ ചോദിക്കുന്ന"
    },
    {
      "t": "10:08",
      "text": "അരഞ്ഞൂടി"
    },
    {
      "t": "10:10",
      "text": "എടാ ഞാൻ"
    },
    {
      "t": "10:12",
      "text": "സെക്സ് ചെയ്തിട്ടുണ്ടന്ന് പറഞ്ഞിട്ട് എനിക്ക്"
    },
    {
      "t": "10:14",
      "text": "ലോകത്തുള്ളവരോടൊെ"
    },
    {
      "t": "10:16",
      "text": ""
    },
    {
      "t": "10:18",
      "text": "പ്പചാ ചെയ്യുന്ന അൂട്ടാ"
    },
    {
      "t": "10:20",
      "text": ""
    },
