{
  "file_id": "rec_default_421372353_audio_1788505796052.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 730.172,
  "processing_time_sec": 30.484440088272095,
  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": ""
    },
    {
      "t": "00:04",
      "text": ""
    },
    {
      "t": "00:06",
      "text": "நீ அம்ப"
    },
    {
      "t": "00:08",
      "text": "போ ச"
    },
    {
      "t": "00:10",
      "text": "ஹலோ"
    },
    {
      "t": "00:12",
      "text": "ா கேக்குதுங்க"
    },
    {
      "t": "00:14",
      "text": "உ பேரு"
    },
    {
      "t": "00:16",
      "text": "வே ப பே"
    },
    {
      "t": "00:18",
      "text": "ஆன்ல தாங்க இருக்கு"
    },
    {
      "t": "00:20",
      "text": ""
    },
    {
      "t": "00:22",
      "text": ""
    },
    {
      "t": "00:24",
      "text": "ஹம் கய"
    },
    {
      "t": "00:26",
      "text": "ஆ"
    },
    {
      "t": "00:28",
      "text": "ஆ"
    },
    {
      "t": "00:30",
      "text": "என்னங்க இந்த டிவில எல்லாம் இன்டர்வியூ எடுப்பாங்க"
    },
    {
      "t": "00:32",
      "text": "அந்த மாதிரி உக்காந்துிருக்கீங்க"
    },
    {
      "t": "00:34",
      "text": ""
    },
    {
      "t": "00:36",
      "text": "ுவாங்கசஹ் நீங்க பாத்துக்க கொண்டு இருப்ப"
    },
    {
      "t": "00:38",
      "text": "சவிிகள் நம்ம கூட யாருக்கரு பாருங்க"
    },
    {
      "t": "00:40",
      "text": "நம்ம நேர் இருக்காரு சொல்லுங்க"
    },
    {
      "t": "00:42",
      "text": "நீங்க என்ன பண்றங்கீ"
    },
    {
      "t": "00:44",
      "text": "யோ"
    },
    {
      "t": "00:46",
      "text": "ே நான் இல்லத நீங்க"
    },
    {
      "t": "00:48",
      "text": "போயத்தி கண்ணா இருக்கும் போல இருக்கு"
    },
    {
      "t": "00:50",
      "text": "நானே என்"
    },
    {
      "t": "00:52",
      "text": "இல் இல்லைன்னா"
    },
    {
      "t": "00:54",
      "text": "நானே எல்லாருமே கலாசித்தப்பன்ிக"
    },
    {
      "t": "00:56",
      "text": "நீ கலாய"
    },
    {
      "t": "00:58",
      "text": "பஷி உமா மாிர"
    },
    {
      "t": "01:00",
      "text": "சொல்லுங்க உங்களுக்கு என்ன பா்த்தக்கணும்"
    },
    {
      "t": "01:02",
      "text": "உம்"
    },
    {
      "t": "01:04",
      "text": "இல் இல்லை இல்லாம்"
    },
    {
      "t": "01:06",
      "text": "அப்படித்தான் சொல்லுவாங்க இல்ல"
    },
    {
      "t": "01:08",
      "text": "கி உமா மாதிரி பேசா"
    },
    {
      "t": "01:10",
      "text": "வயசு அப்படிதான் இருக்கு"
    },
    {
      "t": "01:12",
      "text": "என்ன சொீங்களா"
    },
    {
      "t": "01:14",
      "text": "அ"
    },
    {
      "t": "01:16",
      "text": "அடியா எனக்கு கழுத"
    },
    {
      "t": "01:18",
      "text": "வாய்பதான் கேட்டுட்டு"
    },
    {
      "t": "01:20",
      "text": "காப்பித கேக்குதா இ"
    },
    {
      "t": "01:22",
      "text": "ங்க தெ எ"
    },
    {
      "t": "01:24",
      "text": "சரி"
    },
    {
      "t": "01:26",
      "text": "எப்படி கட்டுபடிச்சங்க"
    },
    {
      "t": "01:28",
      "text": "இ பின்னாடி எது"
    },
    {
      "t": "01:30",
      "text": "போட்டுக்கான்னு பாங்கன்னை எப்படி கண்டுபிடிச்சீங்க"
    },
    {
      "t": "01:32",
      "text": "அததுே"
    },
    {
      "t": "01:34",
      "text": "ஆ"
    },
    {
      "t": "01:36",
      "text": "கண்டுபடிவுல்ல அ"
    },
    {
      "t": "01:38",
      "text": "நீவேந்த ஊரு சென்னை"
    },
    {
      "t": "01:40",
      "text": "ானங்களும்"
    },
    {
      "t": "01:42",
      "text": ""
    },
    {
      "t": "01:44",
      "text": "ஆஹ் வேரி உபாய"
    },
    {
      "t": "01:46",
      "text": "ஓகே கே அதுிக"
    },
    {
      "t": "01:48",
      "text": "அதுா"
    },
    {
      "t": "01:50",
      "text": "நீட்டு வச்சிருந்தன் எங்களுக்கு பேூர் இருந்து"
    },
    {
      "t": "01:52",
      "text": "பேசுறேன் அப்படி இந்த டிவி நியூஸ்"
    },
    {
      "t": "01:54",
      "text": "படிப்பாங்க பாத்தீங்களா அந்த மாதிரிக்குங்கது"
    },
    {
      "t": "01:56",
      "text": "ச"
    },
    {
      "t": "01:58",
      "text": "ஆ"
    },
    {
      "t": "02:00",
      "text": "அவவே அப்படி தான் ப நா"
    },
    {
      "t": "02:02",
      "text": "என்ன அ"
    },
    {
      "t": "02:04",
      "text": "பேசுறீங்கத ஆனா எனக்கு தான்"
    },
    {
      "t": "02:06",
      "text": "தெரியுதா"
    },
    {
      "t": "02:08",
      "text": "எத்தச்சு சும்மா சும்மா உங்க பேரி"
    },
    {
      "t": "02:10",
      "text": "உ"
    },
    {
      "t": "02:12",
      "text": "ஆஹ அ அதும்பஷம்"
    },
    {
      "t": "02:14",
      "text": "ட்டாச்சரி ஆ சரி"
    },
    {
      "t": "02:16",
      "text": "வின"
    },
    {
      "t": "02:18",
      "text": "பக்க பாக்க ப பக்கக்க பழ"
    },
    {
      "t": "02:20",
      "text": "சக்கெத்து"
    },
    {
      "t": "02:22",
      "text": "உம்"
    },
    {
      "t": "02:24",
      "text": "ஆமா"
    },
    {
      "t": "02:26",
      "text": "உங்க பேரை சொல்லுங்க"
    },
    {
      "t": "02:28",
      "text": "ஏன் பேரா"
    },
    {
      "t": "02:30",
      "text": "தொ மூர்"
    },
    {
      "t": "02:32",
      "text": "ஆஹ்"
    },
    {
      "t": "02:34",
      "text": "சரிப்ப"
    },
    {
      "t": "02:36",
      "text": "ஜெனிஃபர் அதான் ஷான் ஜெனி"
    },
    {
      "t": "02:38",
      "text": "ஏ குஷி படத்துல ஒருஜின"
    },
    {
      "t": "02:40",
      "text": "ஆச்ச"
    },
    {
      "t": "02:42",
      "text": "அந்த மாதிரி"
    },
    {
      "t": "02:44",
      "text": "கிச்ச நீ"
    },
    {
      "t": "02:46",
      "text": ""
    },
    {
      "t": "02:48",
      "text": "காய தெ நீ"
    },
    {
      "t": "02:50",
      "text": "பை உங்கரு"
    },
    {
      "t": "02:52",
      "text": "எய"
    },
    {
      "t": "02:54",
      "text": "உம்"
    },
    {
      "t": "02:56",
      "text": "கத்தற இந்த பாவைய கிட்ட இருந்தே"
    },
    {
      "t": "02:58",
      "text": "விக்னேஷ்"
    },
    {
      "t": "03:00",
      "text": ""
    },
    {
      "t": "03:02",
      "text": "நீ பக்கே தலண"
    },
    {
      "t": "03:04",
      "text": "ந தக்கது"
    },
    {
      "t": "03:06",
      "text": ""
    },
    {
      "t": "03:08",
      "text": ""
    },
    {
      "t": "03:10",
      "text": "ஓ வேறச்சன"
    },
    {
      "t": "03:12",
      "text": "ர"
    },
    {
      "t": "03:14",
      "text": "நயன் தரான்னு சொல்றீங்க பின் ரியாக்ஷன்"
    },
    {
      "t": "03:16",
      "text": "தான் மக்க முடியுமா"
    },
    {
      "t": "03:18",
      "text": ""
    },
    {
      "t": "03:20",
      "text": "விக்னேஷவர் பேசுன அயம்"
    },
    {
      "t": "03:22",
      "text": "உமாயக்கா"
    },
    {
      "t": "03:24",
      "text": "உம்"
    },
    {
      "t": "03:26",
      "text": "உம் சொல்லுங்க ஜெனி"
    },
    {
      "t": "03:28",
      "text": "என்ன பண்றீங்க"
    },
    {
      "t": "03:30",
      "text": "இங்க ஜங்க"
    },
    {
      "t": "03:32",
      "text": "ச"
    },
    {
      "t": "03:34",
      "text": "பண்ணதுக்க நனக்குல இ தா"
    },
    {
      "t": "03:36",
      "text": "அதா போய் கல்ு போட்டு இருக்கலாம் இருந்த"
    },
    {
      "t": "03:38",
      "text": "ஓ ஓே"
    },
    {
      "t": "03:40",
      "text": "ஆக்சுல டிசை ஒர்கண்டஸ்டர டிைன்"
    },
    {
      "t": "03:42",
      "text": "ந"
    },
    {
      "t": "03:44",
      "text": "ல தான் இருக்க எனக்குஞ மயில் வரணும் மயில் ஒ"
    },
    {
      "t": "03:46",
      "text": "ஒர்க்க் ஸ்டார்ட் ஆகும்ோ அதுக்கு"
    },
    {
      "t": "03:48",
      "text": "தான் வீட்டிங்ல இருக்கேன்"
    },
    {
      "t": "03:50",
      "text": "உம் சரி"
    },
    {
      "t": "03:52",
      "text": "வெயிட் பண்ணீங்க உன"
    },
    {
      "t": "03:54",
      "text": "வ ச"
    },
    {
      "t": "03:56",
      "text": "ஆஹ"
    },
    {
      "t": "03:58",
      "text": "நீங்க என்ன யூட்டர் ஆக்சுவலாம்"
    },
    {
      "t": "04:00",
      "text": "உம்"
    },
    {
      "t": "04:02",
      "text": "உம்"
    },
    {
      "t": "04:04",
      "text": "எிட்ட"
    },
    {
      "t": "04:06",
      "text": "பலஜி"
    },
    {
      "t": "04:08",
      "text": "தன்"
    },
    {
      "t": "04:10",
      "text": ""
    },
    {
      "t": "04:12",
      "text": ""
    },
    {
      "t": "04:14",
      "text": "ந ச சொ சொல்லகே"
    },
    {
      "t": "04:16",
      "text": "டா தோல்ட்டான அப்ப சொோல்ாது"
    },
    {
      "t": "04:18",
      "text": "உம் இங்கிலிஷ்"
    },
    {
      "t": "04:20",
      "text": ""
    },
    {
      "t": "04:22",
      "text": "அ"
    },
    {
      "t": "04:24",
      "text": "நான் அடுத்த ஆப்ஷன் மேக்ஸ் தான் வச்சிருந்தேன்"
    },
    {
      "t": "04:26",
      "text": "சரிஃர்ஸ்ட் இிலஷ சொல்லி ப்போ அப்படின்னு"
    },
    {
      "t": "04:28",
      "text": "ஹ"
    },
    {
      "t": "04:30",
      "text": "மூஞ்ச பத்தமாய்"
    },
    {
      "t": "04:32",
      "text": "எனக்கு செம்மதி இல்லாத மாதிரிதான் இருக்கும்"
    },
    {
      "t": "04:34",
      "text": "அதான் உண் வேனும்"
    },
    {
      "t": "04:36",
      "text": "ஆக்சுலி மாம்மி எச்ச ம வரா"
    },
    {
      "t": "04:38",
      "text": "கொதுல எனக்கு இன்ட்ரெஸ்ட் இல்லை"
    },
    {
      "t": "04:40",
      "text": "கப்பா ஆஹ் நான் வந்து"
    },
    {
      "t": "04:42",
      "text": "ச பே இது மாதிரி போகணும்"
    },
    {
      "t": "04:44",
      "text": "உ"
    },
    {
      "t": "04:46",
      "text": "சுப்பிரமணியம் வீடகரும தான் எங்க மா"
    },
    {
      "t": "04:48",
      "text": "உம் நான் நினக்க இருன் நங்க"
    },
    {
      "t": "04:50",
      "text": "நினைக்காது அவங்க நெைக்கிறத மட்டும்்தான் நெைக்கும்"
    },
    {
      "t": "04:52",
      "text": ""
    },
    {
      "t": "04:54",
      "text": "ப்படியாப்போ ஜன நீ அமாார ஒரு கேர"
    },
    {
      "t": "04:56",
      "text": "ந நான பேசகிட்டே இருப்பேன்"
    },
    {
      "t": "04:58",
      "text": "சுத்துி பேறுவாதிகளை ந"
    },
    {
      "t": "05:00",
      "text": "உங்க வாய்ஸ் மட்ட தனியே கேட்கும் போோது"
    },
    {
      "t": "05:02",
      "text": "ஒரு என்ன சொல்லது"
    },
    {
      "t": "05:04",
      "text": "ஒரு மெச்சூரு வயசுதிர இருக்கு கர்னு"
    },
    {
      "t": "05:06",
      "text": "நீங்க ஆர்ச்சவ போலாம்"
    },
    {
      "t": "05:08",
      "text": "உம்"
    },
    {
      "t": "05:10",
      "text": "ஓ"
    },
    {
      "t": "05:12",
      "text": "நிறைய காம்பினேஷன் இருக்கும்"
    },
    {
      "t": "05:14",
      "text": "அதுக்கு பின்னாடி நாம"
    },
    {
      "t": "05:16",
      "text": "இது பண்ண முடியுமனு தெரியாதுல்ல"
    },
    {
      "t": "05:18",
      "text": "நம்ம அதுலதான் வந்து இது பண்ண முடியாது"
    },
    {
      "t": "05:20",
      "text": "முலைங்க என சொ உங்க வாய்ஸ்க்கு"
    },
    {
      "t": "05:22",
      "text": "நீங்க வ யருாச்சும் இந்த மோட்டிவேட்ட சப்போ"
    },
    {
      "t": "05:24",
      "text": "போகலாம் அவதுல உங்க வாய்ஸ் கேட்ட"
    },
    {
      "t": "05:26",
      "text": "ே ஆஹா எங்க பேசுற வயசு"
    },
    {
      "t": "05:28",
      "text": "நிறைய நைய நாய்ஸ் எல்லாமும் சூப்பரா இருக்கு"
    },
    {
      "t": "05:30",
      "text": "அதனால இவங்க என்ன சொன்னாலும் நான் கேட்டுருவேன்"
    },
    {
      "t": "05:32",
      "text": "பரம மண்டலத்தில் இருக்கும் பரமப்ப"
    },
    {
      "t": "05:34",
      "text": "ாவவே நான் அறிந்த மரியன தெரிந்தும் தெரியும்"
    },
    {
      "t": "05:36",
      "text": ""
    },
    {
      "t": "05:38",
      "text": "ஆடுவாங்க கலாாய காது"
    },
    {
      "t": "05:40",
      "text": "நீய"
    },
    {
      "t": "05:42",
      "text": "எதச்ச"
    },
    {
      "t": "05:44",
      "text": "கொஞ்சம் மட்டும் நம்புற மாதிரி சொல்லுங்க"
    },
    {
      "t": "05:46",
      "text": "உண்ாங்க"
    },
    {
      "t": "05:48",
      "text": "உங்க வாய்ஸ் லக்ஷ்மா நல்லா இருக்கு"
    },
    {
      "t": "05:50",
      "text": "உம் கேக்கு கேக்கு கேட்டு கேட்டு"
    },
    {
      "t": "05:52",
      "text": "இருக்கணும் போல இருக்குா"
    },
    {
      "t": "05:54",
      "text": "இ உங்க வாய்ஸ்"
    },
    {
      "t": "05:56",
      "text": "ஏதாச்ச பா"
    },
    {
      "t": "05:58",
      "text": "ல ஏதாவ ஒரு பாட்டு பாடுங்க"
    },
    {
      "t": "06:00",
      "text": ""
    },
    {
      "t": "06:02",
      "text": "ஏ"
    },
    {
      "t": "06:04",
      "text": "சும்மா பாடுங்க"
    },
    {
      "t": "06:06",
      "text": "வயசுக்கு"
    },
    {
      "t": "06:08",
      "text": "எந்த படுசூட்டாகும்"
    },
    {
      "t": "06:10",
      "text": "உஹம் உ உ உ"
    },
    {
      "t": "06:12",
      "text": "உம் உம் உம்"
    },
    {
      "t": "06:14",
      "text": ""
    },
    {
      "t": "06:16",
      "text": "பாடுங்க ஏதது உங்க புடிச்சு பாட்டே பாடுங்க சும்மா"
    },
    {
      "t": "06:18",
      "text": ""
    },
    {
      "t": "06:20",
      "text": "உம் எதுட்டு சூரியியா சொல்லத்து"
    },
    {
      "t": "06:22",
      "text": "ப"
    },
    {
      "t": "06:24",
      "text": "ல்ல இரு கேக்குறேங்க"
    },
    {
      "t": "06:26",
      "text": "இதுவர்ர்"
    },
    {
      "t": "06:28",
      "text": "் நான் கே்கறேன் நீ"
    },
    {
      "t": "06:30",
      "text": "புடியப்ப"
    },
    {
      "t": "06:32",
      "text": "ஆ"
    },
    {
      "t": "06:34",
      "text": "ஓகே ஓகே உம்"
    },
    {
      "t": "06:36",
      "text": "உம் இல்ல ஆக்சுவலி"
    },
    {
      "t": "06:38",
      "text": "பேக்ரவுண்ட்ல பில்டிங் ஒர்க் பண்ணிட்டு இருக்குன்"
    },
    {
      "t": "06:40",
      "text": "அனத மெருுவோ பேீச இரு இருக்க"
    },
    {
      "t": "06:42",
      "text": "ச போங்க"
    },
    {
      "t": "06:44",
      "text": "அதான் கொஞ்சம் சை"
    },
    {
      "t": "06:46",
      "text": "ையா இருக்கா"
    },
    {
      "t": "06:48",
      "text": "ஆஹ் எங்க எ பாட்டு"
    },
    {
      "t": "06:50",
      "text": "ங்க சூப்பரா இருக்கும்"
    },
    {
      "t": "06:52",
      "text": ""
    },
    {
      "t": "06:54",
      "text": "என்"
    },
    {
      "t": "06:56",
      "text": "பட்டி போடுங்க"
    },
    {
      "t": "06:58",
      "text": ""
    },
    {
      "t": "07:00",
      "text": "உம்"
    },
    {
      "t": "07:02",
      "text": "ஆஹ ந பாட்ட"
    },
    {
      "t": "07:04",
      "text": "மாறி இருக்கேன் பக்கத்துலல்லாம் நிறைய"
    },
    {
      "t": "07:06",
      "text": ""
    },
    {
      "t": "07:08",
      "text": "அவா புரியீங்க எனக்கு கேக்குற மாதிரி பாடுங்க"
    },
    {
      "t": "07:10",
      "text": "பெக்்சியமா"
    },
    {
      "t": "07:12",
      "text": "பாடங்க கச்ச"
    },
    {
      "t": "07:14",
      "text": "இ"
    },
    {
      "t": "07:16",
      "text": "ஜல்வி நீ ூட்டங்க"
    },
    {
      "t": "07:18",
      "text": ""
    },
    {
      "t": "07:20",
      "text": ""
    },
    {
      "t": "07:22",
      "text": "ி பாடுங்க ஜனி"
    },
    {
      "t": "07:24",
      "text": "ட்டதான்"
    },
    {
      "t": "07:26",
      "text": "விட மாட்டீங்க"
    },
    {
      "t": "07:28",
      "text": "உம்"
    },
    {
      "t": "07:30",
      "text": "சரமாட்டே இ ர அம்மனா"
    },
    {
      "t": "07:32",
      "text": "தனியா கழுத கட்டுற மாதிரி"
    },
    {
      "t": "07:34",
      "text": "பேசி கட்டிட்டு இருப்பாரு என்ன"
    },
    {
      "t": "07:36",
      "text": "ரெ பே சேந்து பால"
    },
    {
      "t": "07:38",
      "text": "ச"
    },
    {
      "t": "07:40",
      "text": "ரெண்டு பேர் செய்லா"
    },
    {
      "t": "07:42",
      "text": "ஒன்றாயிரட பலாம"
    },
    {
      "t": "07:44",
      "text": ""
    },
    {
      "t": "07:46",
      "text": ""
    },
    {
      "t": "07:48",
      "text": ""
    },
    {
      "t": "07:50",
      "text": "சொில தான் இது பண்ணிட்டும்"
    },
    {
      "t": "07:52",
      "text": "உம்"
    },
    {
      "t": "07:54",
      "text": "ஆஹ்"
    },
    {
      "t": "07:56",
      "text": "அ"
    },
    {
      "t": "07:58",
      "text": "ஆ சரி"
    },
    {
      "t": "08:00",
      "text": "ஆஹ சொ"
    },
    {
      "t": "08:02",
      "text": "என் ஓ"
    },
    {
      "t": "08:04",
      "text": "நான் போ"
    },
    {
      "t": "08:06",
      "text": "உஹம்"
    },
    {
      "t": "08:08",
      "text": "உ"
    },
    {
      "t": "08:10",
      "text": "உஹ"
    },
    {
      "t": "08:12",
      "text": "உ உ"
    },
    {
      "t": "08:14",
      "text": "உ"
    },
    {
      "t": "08:16",
      "text": "உஹம்"
    },
    {
      "t": "08:18",
      "text": "எ"
    },
    {
      "t": "08:20",
      "text": ""
    },
    {
      "t": "08:22",
      "text": "அதுச்சட்டு ப"
    },
    {
      "t": "08:24",
      "text": "ட்ட"
    },
    {
      "t": "08:26",
      "text": "பட்ட த பண்ண"
    },
    {
      "t": "08:28",
      "text": "முடி அது ரொம்ப"
    },
    {
      "t": "08:30",
      "text": "நான் பேற விஜய் பயன்து"
    },
    {
      "t": "08:32",
      "text": "ரிஜிானா நீங்க என்ன ப பா்க்கும்போது நிறைய"
    },
    {
      "t": "08:34",
      "text": "இ விஜயம்திரியா இருக்குன்னு சொல்லியிருக்காங்க தெரியுமா"
    },
    {
      "t": "08:36",
      "text": ""
    },
    {
      "t": "08:38",
      "text": "ஆற"
    },
    {
      "t": "08:40",
      "text": "சரி செரிு சொல்ல தானே"
    },
    {
      "t": "08:42",
      "text": "வேணா உ"
    },
    {
      "t": "08:44",
      "text": "உம் எவடி இருதுக்கு"
    },
    {
      "t": "08:46",
      "text": "ஆமா"
    },
    {
      "t": "08:48",
      "text": "கே எனக்கு"
    },
    {
      "t": "08:50",
      "text": "எனக்கே கொஞ்சம் பதின எனக்கும் பதி"
    },
    {
      "t": "08:52",
      "text": "பதத்தமா தான் இருக்கு வருத்தம் என்ன சொல்றேனு கேட்ப"
    },
    {
      "t": "08:54",
      "text": "போப்ப அந்த மாதிரிதான்"
    },
    {
      "t": "08:56",
      "text": "உம்"
    },
    {
      "t": "08:58",
      "text": "நல்லதான் அக்கங்க பாக்க"
    },
    {
      "t": "09:00",
      "text": "கன பிசி"
    },
    {
      "t": "09:02",
      "text": "விஜய்னா விஜய் ஒருத்தர் மட்டி தான் இருக்கு"
    },
    {
      "t": "09:04",
      "text": "முடியும் மேல ஜய கூட கம்பேர்"
    },
    {
      "t": "09:06",
      "text": "இப்ப ஜய மாதிரி இருக்குனாப்ப"
    },
    {
      "t": "09:08",
      "text": ""
    },
    {
      "t": "09:10",
      "text": "ஜய பந்த விஜய"
    },
    {
      "t": "09:12",
      "text": "கப்ப பண்ணலாம்"
    },
    {
      "t": "09:14",
      "text": "நீங்க நீங்கல்லாதான் இருக்கீங்க"
    },
    {
      "t": "09:16",
      "text": "்் தேங்க்யூ தேங்க்யூ"
    },
    {
      "t": "09:18",
      "text": "நீங்க பாட்டுக்க சரி நீங்க சொன்ன"
    },
    {
      "t": "09:20",
      "text": ""
    },
    {
      "t": "09:22",
      "text": "நீங்க அந்த பாட்டு"
    },
    {
      "t": "09:24",
      "text": "கண்டினியூ பண்ணுங்க"
    },
    {
      "t": "09:26",
      "text": ""
    },
    {
      "t": "09:28",
      "text": "இல்ல இல்ல நான் இன்னொரு விச"
    },
    {
      "t": "09:30",
      "text": "சொல்ல வ அ நீங்க சொ"
    },
    {
      "t": "09:32",
      "text": "உ விஷயம் சொல்றேன் மோஸ்டாலி"
    },
    {
      "t": "09:34",
      "text": "இதுல அ என்ன செய் சொல்லுவாங்க"
    },
    {
      "t": "09:36",
      "text": "ஆஹ் அ வருணா"
    },
    {
      "t": "09:38",
      "text": "பேட ஒரு ஆ்டா பத்தன"
    },
    {
      "t": "09:40",
      "text": "கண்ண த"
    },
    {
      "t": "09:42",
      "text": "பாத்துிருக்கீங்களா அவங்க"
    },
    {
      "t": "09:44",
      "text": "பேேஸ்்கஸ் மா ட்ட ஆசோ"
    },
    {
      "t": "09:46",
      "text": ""
    },
    {
      "t": "09:48",
      "text": "ஆஹடிய"
    },
    {
      "t": "09:50",
      "text": "இ ஒருத்து வாங்க"
    },
    {
      "t": "09:52",
      "text": ""
    },
    {
      "t": "09:54",
      "text": "மனசுக்கு நல்ல உருட்ட உட்டு உருட்டு"
    },
    {
      "t": "09:56",
      "text": ""
    },
    {
      "t": "09:58",
      "text": "ஹலோ"
    },
    {
      "t": "10:00",
      "text": "அ சாய சொ"
    },
    {
      "t": "10:02",
      "text": "வய சொல்லுவாங்களா"
    },
    {
      "t": "10:04",
      "text": "சரிடா சைடா சைடா"
    },
    {
      "t": "10:06",
      "text": "ஆயா ம் சொல்லு சொல்லு"
    },
    {
      "t": "10:08",
      "text": ""
    },
    {
      "t": "10:10",
      "text": "சா நம்ப வேடா"
    },
    {
      "t": "10:12",
      "text": "பான்ன பாத்தீங்க பருவாயல இன்னும்"
    },
    {
      "t": "10:14",
      "text": "இந்த மாதிரி காத எல்லாம் வந்து இதுல கிடைக்கது ந"
    },
    {
      "t": "10:16",
      "text": "ரொம்ப ரயர் தான் நானும்"
    },
    {
      "t": "10:18",
      "text": "யாச்சும் பேச மாட்டாங்கன்னா விடமாட்டாங்க"
    },
    {
      "t": "10:20",
      "text": "நான் ஒமும் செலாட்ட மாட்டேம்மாா நப்படி"
    },
    {
      "t": "10:22",
      "text": "கிடைக்க மாட்ட"
    },
    {
      "t": "10:24",
      "text": "அ சொல்ல"
    },
    {
      "t": "10:26",
      "text": "வதல்லாம் உ"
    },
    {
      "t": "10:28",
      "text": "உ நிக்கிட்ட"
    },
    {
      "t": "10:30",
      "text": ""
    },
    {
      "t": "10:32",
      "text": "இல்ல உங்களுக்கு மனசு பார்த்தன் வர"
    },
    {
      "t": "10:34",
      "text": "காலத்துல எடிிரு போயன்ட்டு அந்த"
    },
    {
      "t": "10:36",
      "text": "எனாடி எஸ்ிடும்"
    },
    {
      "t": "10:38",
      "text": "உ உ"
    },
    {
      "t": "10:40",
      "text": ""
    },
    {
      "t": "10:42",
      "text": ""
    },
    {
      "t": "10:44",
      "text": "அம்ம கூடி நோக்கும் அது"
    },
    {
      "t": "10:46",
      "text": "கூட பவால்  ஜேன் அடனு சொ"
    },
    {
      "t": "10:48",
      "text": "பேசி போயிட்டா நல்லச்ச பே"
    },
    {
      "t": "10:50",
      "text": "சப்பக்கா தடி என்ன அே த"
    },
    {
      "t": "10:52",
      "text": "பண்றம் இ"
    },
    {
      "t": "10:54",
      "text": "டுத்தா"
    },
    {
      "t": "10:56",
      "text": "ோஷ"
    },
    {
      "t": "10:58",
      "text": "எல்லா"
    },
    {
      "t": "11:00",
      "text": "பாாரத்துட்டு என்ஜாய் பண்ணிட்டு இங்க வந்து கதை சொல்றீங்க"
    },
    {
      "t": "11:02",
      "text": "ாம்"
    },
    {
      "t": "11:04",
      "text": "என்"
    },
    {
      "t": "11:06",
      "text": "ந என்மாச்ச"
    },
    {
      "t": "11:08",
      "text": "என்ச்ச நீ இ"
    },
    {
      "t": "11:10",
      "text": "சிவசாமி ஃபுல்லா பாத்துட்டோ"
    },
    {
      "t": "11:12",
      "text": "பரல"
    },
    {
