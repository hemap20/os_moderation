{
  "file_id": "rec_audio_call_425384170_audio_1788877922101.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 492.625,
  "processing_time_sec": 19.556541919708252,
  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:02",
      "text": "ഹലോ എവിടന്നാ"
    },
    {
      "t": "00:04",
      "text": "അണര് ള എവിടുന്ന"
    },
    {
      "t": "00:06",
      "text": "ഞാന് മംഗലപുരം"
    },
    {
      "t": "00:08",
      "text": "എന്ത് ചെയയമോ"
    },
    {
      "t": "00:10",
      "text": "ബാംഗ്ലൂ"
    },
    {
      "t": "00:12",
      "text": "ാണ്"
    },
    {
      "t": "00:14",
      "text": "പാർമ്മ കമ്മതില്ല"
    },
    {
      "t": "00:16",
      "text": "അതെയോ"
    },
    {
      "t": "00:18",
      "text": "ഉ നിങ്ങളോ"
    },
    {
      "t": "00:20",
      "text": "ലായിട്ട് ജോലി ചെയ്യണം കണ്ണൂ"
    },
    {
      "t": "00:22",
      "text": "വർക്ക് ചെയ്യണത് വീട് കോഴോട്"
    },
    {
      "t": "00:24",
      "text": "ഓക്കെ ഓക്കെ"
    },
    {
      "t": "00:26",
      "text": "ഓെ ആഹ് ആഹ് ആഹ"
    },
    {
      "t": "00:28",
      "text": "എങ്ങനെ കമ്പ"
    },
    {
      "t": "00:30",
      "text": "ഹോസ്പിറ്റലൊക്കെ പോവലുണ്ടോ"
    },
    {
      "t": "00:32",
      "text": "നമ്മള നമ്മള മെഡിസിൻ മാന"
    },
    {
      "t": "00:34",
      "text": "ഫാക്ചറിങ് ചെയ്യണം"
    },
    {
      "t": "00:36",
      "text": "അതെ ഓക്കെ"
    },
    {
      "t": "00:38",
      "text": "സ്"
    },
    {
      "t": "00:40",
      "text": "ജസ്റ്റ് മിസ്"
    },
    {
      "t": "00:42",
      "text": ""
    },
    {
      "t": "00:44",
      "text": ""
    },
    {
      "t": "00:46",
      "text": "എങ്ങനെയുണ്ട് ആപ്പ"
    },
    {
      "t": "00:48",
      "text": "ആഹ അപ്പൊ"
    },
    {
      "t": "00:50",
      "text": "അത്ര ഒരു രണ്ട്ു ദിവസമായി"
    },
    {
      "t": "00:52",
      "text": "യൂസ് ചെയ്തിട്ടാ"
    },
    {
      "t": "00:54",
      "text": "അതൊക്ക പോട്ട ഇള"
    },
    {
      "t": "00:56",
      "text": "പേന്താ എന്റെ പേരിലത്തി"
    },
    {
      "t": "00:58",
      "text": "നിങ്ങളതാ"
    },
    {
      "t": "01:00",
      "text": "ഇയാള പേരെന്താ ലതീഫ്"
    },
    {
      "t": "01:02",
      "text": "എത്ര എത്ര"
    },
    {
      "t": "01:04",
      "text": "എനിക്ക് ഇരുപത്തി"
    },
    {
      "t": "01:06",
      "text": "നിങ്ങൾക്ക്"
    },
    {
      "t": "01:08",
      "text": "ണ്ടി"
    },
    {
      "t": "01:10",
      "text": "മാരിഡ ആണോ"
    },
    {
      "t": "01:12",
      "text": "അല്ലല്ല സിംഗിളണ്"
    },
    {
      "t": "01:14",
      "text": "ങ്ങളാം ഉ"
    },
    {
      "t": "01:16",
      "text": "പിന്നെ എന്താ ചെയ്യാ"
    },
    {
      "t": "01:18",
      "text": "അല്ല ആപ്പ് പ"
    },
    {
      "t": "01:20",
      "text": "് അ എക്സ്പീരിയൻസ് ഒന്ന് പറഞ്ഞ"
    },
    {
      "t": "01:22",
      "text": "എങ്ങനെ ഉണ്ടായത് കോസ്ത്ത് കൊ എങ്ങനെയ"
    },
    {
      "t": "01:24",
      "text": "ല്ലും"
    },
    {
      "t": "01:26",
      "text": "പ്രശ്നംുണ്ടായിുന്ന സംസ"
    },
    {
      "t": "01:28",
      "text": "എന്തെങ്കിലുംക്ക സ്റ്റോറി ഉണ്ടാവുംല്ലേ"
    },
    {
      "t": "01:30",
      "text": "ഒന്നും പറഞ്ഞില്ല"
    },
    {
      "t": "01:32",
      "text": "ഒ ഓരോരാൾ"
    },
    {
      "t": "01:34",
      "text": "ഭയങ്കര ക്ലോസ് ആയി സംസാരിക്കും"
    },
    {
      "t": "01:36",
      "text": "പിന്നെ കൊറെേ ആൾക്കാർക്കല്ല"
    },
    {
      "t": "01:38",
      "text": "കഴിഞ്ഞ അവര ഫീലിംഗ പറയും"
    },
    {
      "t": "01:40",
      "text": "ഫലിച്ച"
    },
    {
      "t": "01:42",
      "text": "സ അങ്ങെ"
    },
    {
      "t": "01:44",
      "text": "അവരുടെ ലൈഫ"
    },
    {
      "t": "01:46",
      "text": "സ്റ്റോറൊക്കെ പറഞ്ഞിട്ടുണ്ടോ"
    },
    {
      "t": "01:48",
      "text": "ഇയാളെ ഭാഷ സൂപ്പർ ആായിട്ടുണ്ട്ട്ടോ"
    },
    {
      "t": "01:50",
      "text": "ട്ടോ ആണോ"
    },
    {
      "t": "01:52",
      "text": "ഉം എനക്ക്ിഷ്ടായി"
    },
    {
      "t": "01:54",
      "text": "ആ ഹ ആ ലൈൻ ഉണ്ടോ"
    },
    {
      "t": "01:56",
      "text": "ഏ ഇല്ലല്ല"
    },
    {
      "t": "01:58",
      "text": "ആ ഉ ഇതുവരെ"
    },
    {
      "t": "02:00",
      "text": "ഇ"
    },
    {
      "t": "02:02",
      "text": "അ ഉണ്ടായിട്ടില്ല നമുക്ക് സെറ്റാവല"
    },
    {
      "t": "02:04",
      "text": "നന്ദേ"
    },
    {
      "t": "02:06",
      "text": "എന്ത് ഇത് വെച്ചിട്ട"
    },
    {
      "t": "02:08",
      "text": "ല സെ ആവാതെരിക്കുന്നതാണ്"
    },
    {
      "t": "02:10",
      "text": "ണ്ടത് ഉം ഉം ഉ ഉ ഉ"
    },
    {
      "t": "02:12",
      "text": "അങ്ങനെയാണ്"
    },
    {
      "t": "02:14",
      "text": "ഉ എനിക്ക് മുമ്പ്ണ്ടായിരുന്നു"
    },
    {
      "t": "02:16",
      "text": "ഇപ്പ"
    },
    {
      "t": "02:18",
      "text": "മണ്ടായിരുന്നു"
    },
    {
      "t": "02:20",
      "text": "മുമ്പ ഒരു നാല് വർഷം ലവ് ഉണ്ടായിരുന്നു"
    },
    {
      "t": "02:22",
      "text": "പിന്നെ"
    },
    {
      "t": "02:24",
      "text": "പോയത് അവള തേച്ചിട്ട് പോയി"
    },
    {
      "t": "02:26",
      "text": "ആഹ അതാണ് ഞാൻ പറഞ്ഞത്"
    },
    {
      "t": "02:28",
      "text": "സെറ്റായിട്ട് കാര്ില്ല അപ്പൊയാർക്കും സെറ്റ്"
    },
    {
      "t": "02:30",
      "text": "റില്ല"
    },
    {
      "t": "02:32",
      "text": "അങ്ങനെ"
    },
    {
      "t": "02:34",
      "text": "മൊത്തം എല്ലാം കറങ്ങിയിരുന്നു"
    },
    {
      "t": "02:36",
      "text": "ഊട്ടിയും"
    },
    {
      "t": "02:38",
      "text": "ഉ കൊറേ ദൂരു ദൂരം"
    },
    {
      "t": "02:40",
      "text": "പിക്ോ അതല്ലെ"
    },
    {
      "t": "02:42",
      "text": "ടെൻഷൻ അടിക്കാൻ പറ്റൂല വിഷ്മ"
    },
    {
      "t": "02:44",
      "text": "കന അപ്പൊ ഞൻ പ തീമായിിച്ചു"
    },
    {
      "t": "02:46",
      "text": "പ്രണയം ഉണ്ടയന്ത"
    },
    {
      "t": "02:48",
      "text": "ഉ അത് ആദ്യം"
    },
    {
      "t": "02:50",
      "text": "പ്രണയം പോലെ ഉണ്ടായിരുന്നില്ല"
    },
    {
      "t": "02:52",
      "text": "ജസ് ഒരു ബെസ്റ്റ് ഫ്രണ്ട് പോലെ"
    },
    {
      "t": "02:54",
      "text": "ഉണ്ടായിരുന്നു ഒരിക്ക"
    },
    {
      "t": "02:56",
      "text": "ഇങ്ങനല്ലേ ബെസ്റ്റ് ഫ്രണ്ടിനെ"
    },
    {
      "t": "02:58",
      "text": "ഒരു കാമുകി ആവുമ്പോ അവര്"
    },
    {
      "t": "03:00",
      "text": "വേർ നഞമ്മള് മാറലായിരിക്കും"
    },
    {
      "t": "03:02",
      "text": "പക്ഷെ ആള് മാറും അ"
    },
    {
      "t": "03:04",
      "text": "ശ്രദ്ധിച്ചിട്ടണ്ട"
    },
    {
      "t": "03:06",
      "text": "അത് നമ്മള്"
    },
    {
      "t": "03:08",
      "text": "പറഞ്ഞാല് നമ്മുടെ ബെസ്റ്റ് ഫ്രണ്ട് വരെ ഉണ്ട"
    },
    {
      "t": "03:10",
      "text": "ോ ദിവസം മറ്റ ഇങ്ങനെ"
    },
    {
      "t": "03:12",
      "text": "പോയിരുന്നു പറഞ്ഞു യൂട്ട പോയിരുന്നു"
    },
    {
      "t": "03:14",
      "text": "ആ ഒരു ദിവസം സ്റ്റേ ചെയ"
    },
    {
      "t": "03:16",
      "text": "ഓ"
    },
    {
      "t": "03:18",
      "text": "ആ സ്റ്റേോട്"
    },
    {
      "t": "03:20",
      "text": "കൂടെ ലവയത്"
    },
    {
      "t": "03:22",
      "text": "അത്"
    },
    {
      "t": "03:24",
      "text": "പ്രണയമാണോ"
    },
    {
      "t": "03:26",
      "text": "അങ്ങനെ ആയിത്"
    },
    {
      "t": "03:28",
      "text": "ഓ"
    },
    {
      "t": "03:30",
      "text": "പിന്നെ പ്രണയത്തിന് പോയത്"
    },
    {
      "t": "03:32",
      "text": ""
    },
    {
      "t": "03:34",
      "text": "പിന്നെ ആള് വേറെ കല്യാണം വിഴിച്ചു"
    },
    {
      "t": "03:36",
      "text": "പിന്നെ ആറ് വല്ല കല്യാണം കഴച്ചിട്ട"
    },
    {
      "t": "03:38",
      "text": "വേറെ എവിടെ പോയി"
    },
    {
      "t": "03:40",
      "text": ""
    },
    {
      "t": "03:42",
      "text": "അപ്പശ"
    },
    {
      "t": "03:44",
      "text": "ണ്ട സംസാരിച്ചോണ്ടായിുന്ന"
    },
    {
      "t": "03:46",
      "text": "കത്തി സമയ"
    },
    {
      "t": "03:48",
      "text": "കഴിഞ്ഞട്ട് ഒരു വർഷം കഴിഞ്ഞതിന്റെ ശേഷം"
    },
    {
      "t": "03:50",
      "text": "മസഴ"
    },
    {
      "t": "03:52",
      "text": "പിന്നെ ഇപ്പൊ ജസ്റ്റ്"
    },
    {
      "t": "03:54",
      "text": "ഫ്രണ്ട്സ് അത്ര ഉള്ളൂ"
    },
    {
      "t": "03:56",
      "text": "മീത്ത"
    },
    {
      "t": "03:58",
      "text": "അങ്ങനൊക്കെ വിളിച്ചാ പോവോ"
    },
    {
      "t": "04:00",
      "text": "വിളിച്ചാ പോവും"
    },
    {
      "t": "04:02",
      "text": "പിന്നെ"
    },
    {
      "t": "04:04",
      "text": "അപ്പത്തില വേണ്ടന്നാണ്"
    },
    {
      "t": "04:06",
      "text": "ഇപ്പൊ ഞാനത് അത് വിട്ടു"
    },
    {
      "t": "04:08",
      "text": "ത് വിട്ട് അത് തീർന്നു"
    },
    {
      "t": "04:10",
      "text": "ആഹ"
    },
    {
      "t": "04:12",
      "text": ""
    },
    {
      "t": "04:14",
      "text": "പിന്ന"
    },
    {
      "t": "04:16",
      "text": "നിങ്ങക്ക്ങ്ങെ ഒരു എക്സ്പീരിയൻസ് ഉണ്ടായിട്ടില്ലല്ലേ"
    },
    {
      "t": "04:18",
      "text": "എനക്ക്"
    },
    {
      "t": "04:20",
      "text": "എക്സ്പീരിയൻസ് ഉണ്ടായപ്പോ വെച്ചാൽ"
    },
    {
      "t": "04:22",
      "text": "എന്റെ ഫ്രണ്ടുകൾക്ക് ഇതൊക്കെ കണ്ടോണ്ടക്ക"
    },
    {
      "t": "04:24",
      "text": "പ്രണയിക്കാൻ തോന്നിട്ടില്ല പേരി"
    },
    {
      "t": "04:26",
      "text": "ആഹ"
    },
    {
      "t": "04:28",
      "text": "ആ"
    },
    {
      "t": "04:30",
      "text": "സെറ്റാവല എന്തോ"
    },
    {
      "t": "04:32",
      "text": "ആഹ"
    },
    {
      "t": "04:34",
      "text": "പിന്നെ വേറെ എക്സ്പീരിയൻസ്"
    },
    {
      "t": "04:36",
      "text": "ണ്ടായിട്ടില്ലല്ലോ"
    },
    {
      "t": "04:38",
      "text": "ഓ പോ കവി ചോയ്ിക്ക"
    },
    {
      "t": "04:40",
      "text": "അന്ന് ഊട്ടി പോയതു പോലെ അങ്ങനെ"
    },
    {
      "t": "04:42",
      "text": ""
    },
    {
      "t": "04:44",
      "text": "ഏ"
    },
    {
      "t": "04:46",
      "text": "ഇങ്ങനെ ഉണ്ടായിട്ട"
    },
    {
      "t": "04:48",
      "text": "ഉ അങ്ങനെ ഒരു ഫീലിംഗ ഉണ്ടായിട്ട്"
    },
    {
      "t": "04:50",
      "text": ""
    },
    {
      "t": "04:52",
      "text": "സീ നിങ്സോ"
    },
    {
      "t": "04:54",
      "text": "ഉം"
    },
    {
      "t": "04:56",
      "text": "നിങ്ങ ആൺകുട്ടികൾക്ക് ഇണ്ടാവണം"
    },
    {
      "t": "04:58",
      "text": "അലെ ഒരു പ്രായം എത്തുമ്പോ ഒരു"
    },
    {
      "t": "05:00",
      "text": "ഇവർക്ക് വ"
    },
    {
      "t": "05:02",
      "text": "ൊക്കെയള്ള വെറും തെറ്റിദ്ധാരണയാണ്"
    },
    {
      "t": "05:04",
      "text": "അത് ശരിയാണ് അ നമ്മളെ പോലെ"
    },
    {
      "t": "05:06",
      "text": "നിങ്ങളുടെ മൈൻഡ സെറ്റപ്പ് ഉണ്ടാവില്ല വേറെ ആായിരിക്കും"
    },
    {
      "t": "05:08",
      "text": "ആഹ കാരണം എന്താ വച്ചാല്"
    },
    {
      "t": "05:10",
      "text": "നമക്ക നാമത്തെ സെക്സ്"
    },
    {
      "t": "05:12",
      "text": "ഇതിനെ പറ്റൊക്കെ നന്നായിട്ട് അറിയാം"
    },
    {
      "t": "05:14",
      "text": "ായി് കൗൺസിലി് കോച്ചിങ് ഇതൊക്കെി"
    },
    {
      "t": "05:16",
      "text": "പിന്നെ ഒന്നാമത്തെ ഇതിന"
    },
    {
      "t": "05:18",
      "text": "പറ്റ ആലോചിച്ച ആലോചിച്ചച്ച് വീും"
    },
    {
      "t": "05:20",
      "text": "ൊക്കെ കണ്ട് ഉൾക്കണ്ടൊക്കെ കണ്ട്"
    },
    {
      "t": "05:22",
      "text": "ബോയ് ഫ്രണ്ട് ഒക്കെ ഉള്ളവർക്കൊക്കെയാണ്"
    },
    {
      "t": "05:24",
      "text": "ഓക്കെ ഇതൊന്ന് ട്രൈ ചെയ്ത് നോക്കാം"
    },
    {
      "t": "05:26",
      "text": "എന്ന് വിചാരിച്ചിട്ടാണ്പ്പ"
    },
    {
      "t": "05:28",
      "text": "ഞാൻ എനിക്ക് ഭാഗ്യവക്ഷ"
    },
    {
      "t": "05:30",
      "text": "ഇങ്ങനത്തെ സംഭവം ഒന്നും ഉണ്ടായിട്ടില്ല"
    },
    {
      "t": "05:32",
      "text": "അപ്പോൊ ഞാാനിപ്പോഴും"
    },
    {
      "t": "05:34",
      "text": "അങ്ങനെ കഥകളൊന്നും ഇല്ലാതായിരിക്കൂ"
    },
    {
      "t": "05:36",
      "text": "ഓരോരുത്തരടെ സ്റ്റോറി ആട്ട് ഇരിക്കും"
    },
    {
      "t": "05:38",
      "text": "എന്നാല"
    },
    {
      "t": "05:40",
      "text": "ഫീി ഉണ്ടപ്പോ"
    },
    {
      "t": "05:42",
      "text": "അ സ"
    },
    {
      "t": "05:44",
      "text": "നമ്മള് പറയാറുണ്ട്ന്ന്ിട്ട"
    },
    {
      "t": "05:46",
      "text": "ഓരോ ദിവസം ഇപ്പോൾ എനിക്ക് വേണം അങ്ങനെ"
    },
    {
      "t": "05:48",
      "text": "അ രു കാര്യം പറ"
    },
    {
      "t": "05:50",
      "text": "ട്ട ഇയാള് വെജിറ്റേറയൻ ആ"
    },
    {
      "t": "05:52",
      "text": "ണോ വിച്ചാണോ"
    },
    {
      "t": "05:54",
      "text": ""
    },
    {
      "t": "05:56",
      "text": "നോൺ വെജ് ആണോ വെജിറ്റേറിയൻ ആണോ"
    },
    {
      "t": "05:58",
      "text": "ഞാന എന്ത ഒന്ന വെച്ചാണ്"
    },
    {
      "t": "06:00",
      "text": "ആ വെജിറ്റേറിയൻ"
    },
    {
      "t": "06:02",
      "text": "കൃഷ്ട"
    },
    {
      "t": "06:04",
      "text": "ആഹ അത് ഇഷ്ടാ"
    },
    {
      "t": "06:06",
      "text": "ആ തീർച്ചയായിക്കും ആട ആട്"
    },
    {
      "t": "06:08",
      "text": "ബക്കു"
    },
    {
      "t": "06:10",
      "text": "പാമ്പ് കഴക്കോ മല പാമ്പ്"
    },
    {
      "t": "06:12",
      "text": "ഇല്ല ഇല്ല"
    },
    {
      "t": "06:14",
      "text": "ആഹ അപ്പൊ ഈ മല"
    },
    {
      "t": "06:16",
      "text": "മലമ്പാമ്പ് കേക്ക് മലമ്പാമ്പ്"
    },
    {
      "t": "06:18",
      "text": "ഇയാൾക്ക് ഫുഡ് ഇയാൾക്ക് ഉണ്ടാക്കി തരാ"
    },
    {
      "t": "06:20",
      "text": "അറപ്പാക്കൂല ആാണ്"
    },
    {
      "t": "06:22",
      "text": "ആക്കും പാപ്പശ"
    },
    {
      "t": "06:24",
      "text": "ടേസ്റ്റ് അറിയുന്നവർക്കല്ലേ വീണ്ടും"
    },
    {
      "t": "06:26",
      "text": "നക്കാൻ തോന്നൂ"
    },
    {
      "t": "06:28",
      "text": "ശരി അതേ പോലത്തേങ്ങണ"
    },
    {
      "t": "06:30",
      "text": "ക്"
    },
    {
      "t": "06:32",
      "text": "വീണ്ടും വീണ്ടും ചെയ്ത"
    },
    {
      "t": "06:34",
      "text": "ചെയ്യാ  നമ്മള് അങ്ങനത്തെ ചെയ്"
    },
    {
      "t": "06:36",
      "text": "അതിനെ പറ്റുള്ള"
    },
    {
      "t": "06:38",
      "text": "ആ അമ്മമായിത്തെ ഫീലംഗസിന് നമ്മള് പോലല്ല"
    },
    {
      "t": "06:40",
      "text": "നമ്മ ഓഓ ടപ്പെ ചെയ"
    },
    {
      "t": "06:42",
      "text": "ുമ്പോാണ് നമു അനത്തെ ഫീലിംഗസ് വരിക"
    },
    {
      "t": "06:44",
      "text": "അതാ അല്ലെ കൊം"
    },
    {
      "t": "06:46",
      "text": "അത് ചെയ്യുമ്പോ അല്ലെ"
    },
    {
      "t": "06:48",
      "text": "നിങ്ങളൊക്കെ"
    },
    {
      "t": "06:50",
      "text": "അനെ ഫീലിംഗസ് വരണല്ലോ"
    },
    {
      "t": "06:52",
      "text": "എന്റെ നിങ്ങൾക്ക്ൊന്നും"
    },
    {
      "t": "06:54",
      "text": "അങ്ങനെ"
    },
    {
      "t": "06:56",
      "text": "ഇല്ലന്നല്ല ഞാനും മനുഷ്യ ജീവിത"
    },
    {
      "t": "06:58",
      "text": "പക്ഷെ ക"
    },
    {
      "t": "07:00",
      "text": "െ കിച്ചാല് നക്കണ്ട ന"
    },
    {
      "t": "07:02",
      "text": "ബൂല്ലാതെടോെ"
    },
    {
      "t": "07:04",
      "text": "എന്നാലും ഒരു മസ്റ്റഷൻ അങ്ങനെ ഒരു ഫ"
    },
    {
      "t": "07:06",
      "text": "ഓക്കെ"
    },
    {
      "t": "07:08",
      "text": "ഇക്ക് ഫീലംഗ്സ് ഉണ്ട്"
    },
    {
      "t": "07:10",
      "text": "ആ് ഞരത്ത കൊറച്ച ആത്ത"
    },
    {
      "t": "07:12",
      "text": "അല്ല ഞാൻ ചോദിച്ച"
    },
    {
      "t": "07:14",
      "text": "എട്ട് പസന്റെ ഫീലിംഗ ഉണ്ടാവ"
    },
    {
      "t": "07:16",
      "text": "വസ്്ടത്ത"
    },
    {
      "t": "07:18",
      "text": "മസ്റ്റർ വിൂഷൻ"
    },
    {
      "t": "07:20",
      "text": "എന്ത് കൈ കൊൊണ്ട്"
    },
    {
      "t": "07:22",
      "text": ""
    },
    {
      "t": "07:24",
      "text": "േഷനോ"
    },
    {
      "t": "07:26",
      "text": "ഏ ഇല്ലല്ല ഞാൻ ചെയ്യല"
    },
    {
      "t": "07:28",
      "text": "അയ്യോ"
    },
    {
      "t": "07:30",
      "text": "ഉ അയിന്തൂട്ടി"
    },
    {
      "t": "07:32",
      "text": "ഉം"
    },
    {
      "t": "07:34",
      "text": "ആ പോ"
    },
    {
      "t": "07:36",
      "text": "എല്ലാരും അങ്ങനെ നമ്മള് ഇപ്പൊ ന"
    },
    {
      "t": "07:38",
      "text": "പഠിക്കണം ഞൻ ഗനക്കിറൽുള്ള"
    },
    {
      "t": "07:40",
      "text": "ൊ ബോയ്ന്ന് വെച്ചാ"
    },
    {
      "t": "07:42",
      "text": "ചെയ്യണ വെച്ചാൽ അവർക്ക്ത് ചെയ്തി"
    },
    {
      "t": "07:44",
      "text": "ഓട്ടോറ്റിക്കലി അത് പോ"
    },
    {
      "t": "07:46",
      "text": ""
    },
    {
      "t": "07:48",
      "text": "ചെയ്യാതെ ഇന്നെ ബോയ്സ്ന്ന് വെച്ചാൽ"
    },
    {
      "t": "07:50",
      "text": "ആഴ്ചനൊരിക്ക ഡെയിലി ചേർണ്ടത് ത"
    },
    {
      "t": "07:52",
      "text": "ആവശ്യക്കെരിക്ക ചെയ്യത് കുഴപ്പമില്ല"
    },
    {
      "t": "07:54",
      "text": "ന ചെയ"
    },
    {
      "t": "07:56",
      "text": "നല്ലതല്ല ഉ"
    },
    {
      "t": "07:58",
      "text": "സ്വയം"
    },
    {
      "t": "08:00",
      "text": "സ്വയം ചെയ്യത് നല്ലതല്ല"
    },
    {
      "t": "08:02",
      "text": "എന്നെങ്കിലും ഒരും"
    },
    {
      "t": "08:04",
      "text": ""
    },
    {
      "t": "08:06",
      "text": "എന്തെങ്കിലും ഒരു പ്രാവശ്യം ചെയ്യാറില്ല"
    },
    {
      "t": "08:08",
      "text": "പറഞ്ഞഞ് പറഞ്ഞ് ചെയ്യിപ്പിക്കാന"
    },
    {
      "t": "08:10",
      "text": "ആണിയ"
    },
    {
      "t": "08:12",
      "text": ""
    }
  ],
