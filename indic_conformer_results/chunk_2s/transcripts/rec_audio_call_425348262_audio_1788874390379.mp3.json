{
  "file_id": "rec_audio_call_425348262_audio_1788874390379.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 391.718,
  "processing_time_sec": 14.865108966827393,
  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:02",
      "text": ""
    },
    {
      "t": "00:04",
      "text": ""
    },
    {
      "t": "00:06",
      "text": "ഹലോ ഹലോ"
    },
    {
      "t": "00:08",
      "text": "ഹലോ"
    },
    {
      "t": "00:10",
      "text": "ത"
    },
    {
      "t": "00:12",
      "text": "അപ്പടും"
    },
    {
      "t": "00:14",
      "text": "ഉ"
    },
    {
      "t": "00:16",
      "text": "അ"
    },
    {
      "t": "00:18",
      "text": "എനിക്ക് കൺസ്രഷന്റെ വർക്ക്"
    },
    {
      "t": "00:20",
      "text": "എനിക്ക് മുപ്പത്തിയഞ്ച് വയസ്ുണ്ട്"
    },
    {
      "t": "00:22",
      "text": "എന്ന"
    },
    {
      "t": "00:24",
      "text": "ഞാൻ പഠിക്കാണ്"
    },
    {
      "t": "00:26",
      "text": "എന്റെ നാട് കൊല്ലയാണ് ഞാനി"
    },
    {
      "t": "00:28",
      "text": "ഓ കോയമ്പത്തൂരന്ന"
    },
    {
      "t": "00:30",
      "text": "എ"
    },
    {
      "t": "00:32",
      "text": "എനിക്ക്"
    },
    {
      "t": "00:34",
      "text": "ണ്ട്"
    },
    {
      "t": "00:36",
      "text": ""
    },
    {
      "t": "00:38",
      "text": "ഉത്രട"
    },
    {
      "t": "00:40",
      "text": "മാരിട അ മാ"
    },
    {
      "t": "00:42",
      "text": "എതി"
    },
    {
      "t": "00:44",
      "text": "്യന്ന് പറൂ"
    },
    {
      "t": "00:46",
      "text": "മാരിീടാണെന്ന് പറഞ്ഞ"
    },
    {
      "t": "00:48",
      "text": "മാരിടക്ക നീന്തിട്ടല്ലേ"
    },
    {
      "t": "00:50",
      "text": "ീ ഇില്ല"
    },
    {
      "t": "00:52",
      "text": "ങ്ങനെ"
    },
    {
      "t": "00:54",
      "text": "ഒണ്ട്ന്റെ ഈ നിങ്ങളെക്കൂട്ടുള്ള ഏജ്ള്ള"
    },
    {
      "t": "00:56",
      "text": "പിള്ളേർ വരുമ്പഴേ നമ്മള് കല്യാണംഴിച്ചാണോ"
    },
    {
      "t": "00:58",
      "text": "ചോദിക്കുമ്പം ഞാൻ പറയും കല്യാണം കഴിച്ച"
    },
    {
      "t": "01:00",
      "text": "എനിക്ക് ര മക്കളുണ്ട് പിന്നെ"
    },
    {
      "t": "01:02",
      "text": "എന്തായി ആപ്പിലങ്ക പോയി"
    },
    {
      "t": "01:04",
      "text": "അ അങ്ങനെ ഞാൻ ചോദത്തിില്ല"
    },
    {
      "t": "01:06",
      "text": "എഷവും നമ്മൾ സംസാരിക്കാമ"
    },
    {
      "t": "01:08",
      "text": "പട്ടിക കിരമംഗനെ"
    },
    {
      "t": "01:10",
      "text": "കേട്ടില്ല"
    },
    {
      "t": "01:12",
      "text": "എ"
    },
    {
      "t": "01:14",
      "text": ""
    },
    {
      "t": "01:16",
      "text": ""
    },
    {
      "t": "01:18",
      "text": "ഞാൻ ഒരു വർഷം രണ്ട മാസമായി"
    },
    {
      "t": "01:20",
      "text": "എങ്ങനെയുണ്ട്"
    },
    {
      "t": "01:22",
      "text": "കുഴപ്പന്നടും"
    },
    {
      "t": "01:24",
      "text": "ഉ എന്നും യൂസ് ചെയ്യാറ"
    },
    {
      "t": "01:26",
      "text": "എന്ന യൂസ് ചെയ്യാറ്"
    },
    {
      "t": "01:28",
      "text": "രണ്ട് മണിക്കൂർ മൂന്ന് മണിക്കൂറക്കെ"
    },
    {
      "t": "01:30",
      "text": "ണ്ട്"
    },
    {
      "t": "01:32",
      "text": "ഉം"
    },
    {
      "t": "01:34",
      "text": "വൈബല്ലെ"
    },
    {
      "t": "01:36",
      "text": "അഐഷു വീട്ടാണ് ഞാൻ പറക്ക്"
    },
    {
      "t": "01:38",
      "text": "വർക്ക് സൈറ്റില് പോകുമ്പം"
    },
    {
      "t": "01:40",
      "text": "നിനെക്കൾ ചെയ്യും നിങ്ങളുടെ കൂട്ടുള്ള ഏജിലുള്ള ഒരു"
    },
    {
      "t": "01:42",
      "text": "നല്ല ജ്ടിയ പ നാ"
    },
    {
      "t": "01:44",
      "text": "പ്പത് നാല്പ്പത്തി എട്ട് നാല്ത്തി"
    },
    {
      "t": "01:46",
      "text": "പത്തി ഒൻപത് വയസ്സ് വരെയുള്ള ലേഡീസ് വന്നിട്ട്"
    },
    {
      "t": "01:48",
      "text": "ഉം"
    },
    {
      "t": "01:50",
      "text": "അ"
    },
    {
      "t": "01:52",
      "text": "പല രീതി"
    },
    {
      "t": "01:54",
      "text": "ഉം"
    },
    {
      "t": "01:56",
      "text": "എല്ലാംക്ക് കൂടിയതും"
    },
    {
      "t": "01:58",
      "text": "എ പറഞ്ഞത്ൊന്നുംരിക്കാം"
    },
    {
      "t": "02:00",
      "text": "ഇന്നാന അതെ"
    },
    {
      "t": "02:02",
      "text": "ഒേക്കില് എറിങ്ങ"
    },
    {
      "t": "02:04",
      "text": "ചെറിയ പിള്ള"
    },
    {
      "t": "02:06",
      "text": "ആഹ"
    },
    {
      "t": "02:08",
      "text": "അവര് ഓൾറെഡി നമ്മളോട് ഡയറക്ട് ചോദിക്കുന്നു"
    },
    {
      "t": "02:10",
      "text": "പറയുന്ന വീഡിയോ കോള്"
    },
    {
      "t": "02:12",
      "text": "പേടുംമ്പ"
    },
    {
      "t": "02:14",
      "text": "അവർക്ക് സാമ്പത്തികം"
    },
    {
      "t": "02:16",
      "text": "ഉം"
    },
    {
      "t": "02:18",
      "text": "മറ്റൊരു സാമ്പത്തികം"
    },
    {
      "t": "02:20",
      "text": "വേണുന്നോറ് തരാ"
    },
    {
      "t": "02:22",
      "text": "ഉം"
    },
    {
      "t": "02:24",
      "text": "എല്ലാാംേണ്ട"
    },
    {
      "t": "02:26",
      "text": "എവിടെ വല്ല എടവാ"
    },
    {
      "t": "02:28",
      "text": "എന്നോട ഒരു ബാംഗ്ലൂർ ഉള്ളതാണ് ഞാൻ"
    },
    {
      "t": "02:30",
      "text": "അതുപോലെ നാഗൂരു അ"
    },
    {
      "t": "02:32",
      "text": "ലൂസ ആായി വിട്ടുണ്ട് എന്റെ ഫ്രണ്ടിന്റെ വീട്ടിൽ"
    },
    {
      "t": "02:34",
      "text": "എന്നൊക്കെ പറഞ്ഞ"
    },
    {
      "t": "02:36",
      "text": "ട്ട് സംസാരിക്ക കുറെേ നേരെ സംസാരിക്ക"
    },
    {
      "t": "02:38",
      "text": "അന്നേര എന്നോട് പറഞ്ഞു"
    },
    {
      "t": "02:40",
      "text": "വമോ എ ചോിച്ചു നമ്പറി വരാൻന്റെ"
    },
    {
      "t": "02:42",
      "text": "എന്റെ കലിക്ക് പോലും കാശില്ല"
    },
    {
      "t": "02:44",
      "text": "ഉ എ പറരുന്ന കാറല്ല"
    },
    {
      "t": "02:46",
      "text": "വറത്തുള്ള പെട്രോൾ അടിക്കണം"
    },
    {
      "t": "02:48",
      "text": "എക്ക് ാൻെ്രോടിക്കാ കാഴ് തം പക്ഷെ രണ്ട് ദിവം"
    },
    {
      "t": "02:50",
      "text": "നീ എന്റെ കൂടെ നൽക്കണം"
    },
    {
      "t": "02:52",
      "text": "എശ"
    },
    {
      "t": "02:54",
      "text": "ഉ ആവശ്യക്കാര്"
    },
    {
      "t": "02:56",
      "text": "ചിലര് പറയുന്നത്"
    },
    {
      "t": "02:58",
      "text": "പൈസാണ് ഉ"
    },
    {
      "t": "03:00",
      "text": "നമ്പൾ"
    },
    {
      "t": "03:02",
      "text": "കാറ്റ് കൊടുത്തിട്ട്ര് ലഡ എടു പോേണ്ടിാര്യും"
    },
    {
      "t": "03:04",
      "text": "ഉ"
    },
    {
      "t": "03:06",
      "text": "ആഏ"
    },
    {
      "t": "03:08",
      "text": "അതാണ്"
    },
    {
      "t": "03:10",
      "text": "ഞാൻ കല്യാണം കഴി കല്യാണം"
    },
    {
      "t": "03:12",
      "text": "കഴിക്കൻേഷം ലേഡിയ എടുത്തും പോയിട്ടില്ല"
    },
    {
      "t": "03:14",
      "text": "ആഹ"
    },
    {
      "t": "03:16",
      "text": "മുന്നേപ്പ ഉണ്ടായിരിക്കും"
    },
    {
      "t": "03:18",
      "text": "പിന്നെ ഇല്ല ഈജുള്ള ലേഡീസ്"
    },
    {
      "t": "03:20",
      "text": "ഓ"
    },
    {
      "t": "03:22",
      "text": "മുപ്പത്തിയഞ്ച്"
    },
    {
      "t": "03:24",
      "text": "ുള്ള ലേഡിയോ ആയി പോയി ഇരുപത്തി രണ്ട വയസ്സ്"
    },
    {
      "t": "03:26",
      "text": ""
    },
    {
      "t": "03:28",
      "text": "ഉ"
    },
    {
      "t": "03:30",
      "text": "ര വയ"
    },
    {
      "t": "03:32",
      "text": ""
    },
    {
      "t": "03:34",
      "text": "അ വ"
    },
    {
      "t": "03:36",
      "text": ""
    },
    {
      "t": "03:38",
      "text": "ആഹ അ വഴ വണ"
    },
    {
      "t": "03:40",
      "text": "ഭ ബാടി പടി ഭ"
    },
    {
      "t": "03:42",
      "text": "ഉ"
    },
    {
      "t": "03:44",
      "text": "മാർക്ക് പുരുഷന്മാർക്ക് പൊതുവേൂ"
    },
    {
      "t": "03:46",
      "text": "ഫ്രണ്ട്ിപ്പ്"
    },
    {
      "t": "03:48",
      "text": "കൂടാനും ഇഷ്ടം"
    },
    {
      "t": "03:50",
      "text": "ഉം"
    },
    {
      "t": "03:52",
      "text": "ആ ഉ"
    },
    {
      "t": "03:54",
      "text": "പറഞ്ഞ മനസിലല്ലേ"
    },
    {
      "t": "03:56",
      "text": "എതുേറെ"
    },
    {
      "t": "03:58",
      "text": "ഉന്താ ഫഡ"
    },
    {
      "t": "04:00",
      "text": ""
    },
    {
      "t": "04:02",
      "text": "എന്ത കഴിച്ചോ"
    },
    {
      "t": "04:04",
      "text": "കേട്ടില്ല ഫുഡ് കഴിക്കാൻ സമയ"
    },
    {
      "t": "04:06",
      "text": "വൈകിട്ട് നാല മണിയ ആയപ്പം"
    },
    {
      "t": "04:08",
      "text": "ചായ കുടിച്ചു കടി കഴിച്ചു"
    },
    {
      "t": "04:10",
      "text": "ആ"
    },
    {
      "t": "04:12",
      "text": "ഇഈ പെണ്ണ പള്ള എടുത്തി"
    },
    {
      "t": "04:14",
      "text": "ട ഓ"
    },
    {
      "t": "04:16",
      "text": "കാത്തിരിക്ക ഓണംക്കെ എങ്ങനെ"
    },
    {
      "t": "04:18",
      "text": "കുഴപ്പമല്ല അടിപൊളി"
    },
    {
      "t": "04:20",
      "text": "ഉ"
    },
    {
      "t": "04:22",
      "text": "ഓണോക്കടി പിയ"
    },
    {
      "t": "04:24",
      "text": "എത്ര നാള പ്പടുത്തട്ട്"
    },
    {
      "t": "04:26",
      "text": "ഞാനിപ്പോൊ ടു വീക്സ് രണ്ടാഴ"
    },
    {
      "t": "04:28",
      "text": "അങ്ങനെുണ്ട്"
    },
    {
      "t": "04:30",
      "text": "ഉം"
    },
    {
      "t": "04:32",
      "text": "നിങ്ങളടെ നിങ്ങളടെ വയസ്സ വ"
    },
    {
      "t": "04:34",
      "text": "വിട്ട് ഈ ആപ്പ എങ്ങനെ ഉണ്ടോ"
    },
    {
      "t": "04:36",
      "text": "അങ്ങടെ"
    },
    {
      "t": "04:38",
      "text": "ഉ കുറ പല്ല നല്ലെ"
    },
    {
      "t": "04:40",
      "text": "കൊഴപ്പൊന്നല്ല"
    },
    {
      "t": "04:42",
      "text": "ഉം ഉം"
    },
    {
      "t": "04:44",
      "text": "പിന്നെ നിങ്ങളത്തൊക്കെ വന്ന് കൂടു"
    },
    {
      "t": "04:46",
      "text": "ഓപ്പൺ ലോക്ക ആയിരിക്കും ചോദിക്കുന്ന അല്ലേ"
    },
    {
      "t": "04:48",
      "text": "ആം"
    },
    {
      "t": "04:50",
      "text": "ന"
    },
    {
      "t": "04:52",
      "text": "ഓപ്പൻ ോക്കേ"
    },
    {
      "t": "04:54",
      "text": "ഞാൻ ചെറിയ ലേഡീസ് വന്ന് നോക്ക"
    },
    {
      "t": "04:56",
      "text": "ണ്ടക്ക യോിച്ചിട്ടുണ്ടായി"
    },
    {
      "t": "04:58",
      "text": "എന്നോട് ചോദിക്കും നമ്മ ഓപ്പൺ ഡോ"
    },
    {
      "t": "05:00",
      "text": "സംസാരിക്കുന്ന അവര് അവർക്ക് ഒപ്പ"
    },
    {
      "t": "05:02",
      "text": "അ ഓപ്പൺ അറിയത്തില്ല"
    },
    {
      "t": "05:04",
      "text": "ഓപ്പൺ ടോക്ക എന്ന് പറഞ്ഞാൽ നമ്മള് ഓൾറെഡി"
    },
    {
      "t": "05:06",
      "text": "ഇപ്പം സാധാരണ ഓപ്പൺ ഡോ"
    },
    {
      "t": "05:08",
