    {
      "t": "04:12",
      "text": ""
    },
    {
      "t": "04:14",
      "text": ""
    },
    {
      "t": "04:16",
      "text": "உம் உம் உம்"
    },
    {
      "t": "04:18",
      "text": ""
    },
    {
      "t": "04:20",
      "text": ""
    },
    {
      "t": "04:22",
      "text": ""
    },
    {
      "t": "04:24",
      "text": ""
    },
    {
      "t": "04:26",
      "text": "உச்ச"
    },
    {
      "t": "04:28",
      "text": "உ ச"
    },
    {
      "t": "04:30",
      "text": "உ உ உ உம்"
    },
    {
      "t": "04:32",
      "text": ""
    },
    {
      "t": "04:34",
      "text": ""
    },
    {
      "t": "04:36",
      "text": ""
    },
    {
      "t": "04:38",
      "text": ""
    },
    {
      "t": "04:40",
      "text": ""
    },
    {
      "t": "04:42",
      "text": "ஹ்"
    },
    {
      "t": "04:44",
      "text": "சொல்லுங்காரா"
    },
    {
      "t": "04:46",
      "text": "உ"
    },
    {
      "t": "04:48",
      "text": ""
    },
    {
      "t": "04:50",
      "text": "சொல்ல"
    },
    {
      "t": "04:52",
      "text": "எந்திரலப்ப நீங்க தண்ணில"
    },
    {
      "t": "04:54",
      "text": "வட பல்லண"
    },
    {
      "t": "04:56",
      "text": "ஓஹ"
    },
    {
      "t": "04:58",
      "text": "எக்கல"
    },
    {
      "t": "05:00",
      "text": "அடப்பல்லங்க"
    },
    {
      "t": "05:02",
      "text": "அவ்ழகதான் அட்ரெஸ் எல்லாம் வேணுமா என்ன"
    },
    {
      "t": "05:04",
      "text": "அரிசல வேணா"
    },
    {
      "t": "05:06",
      "text": "வட பனி"
    },
    {
      "t": "05:08",
      "text": "ச சுத்தாது வரிய இல்லலை நாளை எந்தரிய"
    },
    {
      "t": "05:10",
      "text": "க"
    },
    {
      "t": "05:12",
      "text": "ஆஹ"
    },
    {
      "t": "05:14",
      "text": "இருக்கலாம் எனக்கு நேட்ட திச்சிங்க ந"
    },
    {
      "t": "05:16",
      "text": "இங்க வந்து போர்ர்ஸ் ஆகுது"
    },
    {
      "t": "05:18",
      "text": "சரி"
    },
    {
      "t": "05:20",
      "text": "உம்"
    },
    {
      "t": "05:22",
      "text": ""
    },
    {
      "t": "05:24",
      "text": "போ"
    },
    {
      "t": "05:26",
      "text": "நான்் ஆட்டு உங்களுக்கு"
    },
    {
      "t": "05:28",
      "text": "ந வ பட்டு ந படி"
    },
    {
      "t": "05:30",
      "text": "க்கும்"
    },
    {
      "t": "05:32",
      "text": "என்ன ஆதுட்டு ஆ"
    },
    {
      "t": "05:34",
      "text": "எனக்கு என்ன பிடிக்கும் எனக்கு நிறைய"
    },
    {
      "t": "05:36",
      "text": "நிறைய டிரராாவல் பண்ணற"
    },
    {
      "t": "05:38",
      "text": "ரொம்ப பிடிக்க நிறைய டிரராாவல்ஸ்"
    },
    {
      "t": "05:40",
      "text": "ரொம்ப பிடிக்கும்"
    },
    {
      "t": "05:42",
      "text": ""
    },
    {
      "t": "05:44",
      "text": "பண்ண ரொம்ப பிடிக்கும்"
    },
    {
      "t": "05:46",
      "text": "போள மன் கேதன் டிராவல்"
    },
    {
      "t": "05:48",
      "text": "சவது"
    },
    {
      "t": "05:50",
      "text": "நான் இன்னும் உங்க கூட வரணும்"
    },
    {
      "t": "05:52",
      "text": ""
    },
    {
      "t": "05:54",
      "text": "கே்கறது என் உரிமைங்க வர்தும்"
    },
    {
      "t": "05:56",
      "text": "து உங்களோட உயரிய இன்டரெஸ்டுங்க"
    },
    {
      "t": "05:58",
      "text": "ஆ கண்டிப்பா"
    },
    {
      "t": "06:00",
      "text": "கண்டிப்ப அவ கூட வர மாட்டோன்"
    },
    {
      "t": "06:02",
      "text": "நமே எனக்கு தெரியாது"
    },
    {
      "t": "06:04",
      "text": "சரி சரி"
    },
    {
      "t": "06:06",
      "text": ""
    },
    {
      "t": "06:08",
      "text": ""
    },
    {
      "t": "06:10",
      "text": "சரி வேற"
    },
    {
      "t": "06:12",
      "text": "சொல்லுங்க மே"
    },
    {
      "t": "06:14",
      "text": "இ அப்படி போய் சாாம நல்லா இருக்காங்களா"
    },
    {
      "t": "06:16",
      "text": "ைப் நல்லா போயிட்டு இருக்கா"
    },
    {
      "t": "06:18",
      "text": "உம்"
    },
    {
      "t": "06:20",
      "text": "வயசு எடுக்கப்ப எதுப்பா அ வந்தீங்க"
    },
    {
      "t": "06:22",
      "text": "ஏ"
    },
    {
      "t": "06:24",
      "text": "கே்கறேன்"
    },
    {
      "t": "06:26",
      "text": "வயசு இருந்தாலும் இல்லைனாலும்"
    },
    {
      "t": "06:28",
      "text": "மத்தவங்களுக்கு நல்லா இருக்கும் அந்த அப்ப"
    },
    {
      "t": "06:30",
      "text": "ஆஹ்"
    },
    {
      "t": "06:32",
      "text": "பி நிறைய"
    },
    {
      "t": "06:34",
      "text": "இயா இதுல வந்து"
    },
    {
      "t": "06:36",
      "text": "கல்யாணம் ஆகாதவங்கதான் வராங்க நீங்கதான்"
    },
    {
      "t": "06:38",
      "text": "எனக்கு கல்யாண ஆ"
    },
    {
      "t": "06:40",
      "text": "அதனால நான் கேக்குறேன் ந இன்னைக்குான் ஓபன் பண்ணேன்"
    },
    {
      "t": "06:42",
      "text": "ஒரு நா"
    },
    {
      "t": "06:44",
      "text": "இருக்கேன் நாலுமே சிங்கி பசங்க தான்"
    },
    {
      "t": "06:46",
      "text": "ஓகேவா நீங்க தான் மேரிடு"
    },
    {
      "t": "06:48",
      "text": "நான் எக்க அதே"
    },
    {
      "t": "06:50",
      "text": "ான் அந்த பசங்களும் நோக்கத்து பிருக்காங்க"
    },
    {
      "t": "06:52",
      "text": "அதனால ரமனெண்டா தெரிய வந்து"
    },
    {
      "t": "06:54",
      "text": "அதனால"
    },
    {
      "t": "06:56",
      "text": "ந நக்கும்"
    },
    {
      "t": "06:58",
      "text": "டேட் பண்ணலான்ட்டு டேட்"
    },
    {
      "t": "07:00",
      "text": "பண்ணி லவ் பண்ணி"
    },
    {
      "t": "07:02",
      "text": "அந்த மாதிரி"
    },
    {
      "t": "07:04",
      "text": "சரி"
    },
    {
      "t": "07:06",
      "text": "உ"
    },
    {
      "t": "07:08",
      "text": "கே டிஃப்ரெண்டா தெரியுது எனக்கு"
    },
    {
      "t": "07:10",
      "text": "வந்தது அதுக்காக"
    },
    {
      "t": "07:12",
      "text": "கங்கிரஜுலேஷன்"
    },
    {
      "t": "07:14",
      "text": ""
    },
    {
      "t": "07:16",
      "text": "சந்தராங்கத்துஷனா சொல்லாதீங்க"
    },
    {
      "t": "07:18",
      "text": "வந்த நாலுமே மரண மக்க எல்லாம் லத்து"
    },
    {
      "t": "07:20",
      "text": "மட்டும்தான் எதுவுமே லவவுக்குதே"
    },
    {
      "t": "07:22",
      "text": "ஏராதுக்கு பொண்ணலலா"
    },
    {
      "t": "07:24",
      "text": "சரி ஒன்லி"
    },
    {
      "t": "07:26",
      "text": "உம் நஷகுமார்"
    },
    {
      "t": "07:28",
      "text": "மட்டும தான் அதுங்களுக்குல்லாம் தேவை"
    },
    {
      "t": "07:30",
      "text": "அவ்ளோதான் ஒன்லி செஷ அவ்வளோதான்"
    },
    {
      "t": "07:32",
      "text": "சரி சரி"
    },
    {
      "t": "07:34",
      "text": "உம் அதற வ"
    },
    {
      "t": "07:36",
      "text": "சரி நீங்க எதுக்காகா நீ நீங்க அப்ப"
    },
    {
      "t": "07:38",
      "text": "எனக்கு ஏன்னா நல்ல கேர்ள் ஃப்ரெண்ட் கிடை"
    },
    {
      "t": "07:40",
      "text": "ப்பாங்க டிரராாவல் பைக் டிரராாவல் போகலாம்"
    },
    {
      "t": "07:42",
      "text": "இல்லை ஏன்னா ஒரு ஹீல் ஸேஷன் கூட்டட்டு போலாம்"
    },
    {
      "t": "07:44",
      "text": "பப்புக்கு கூத்தும் போல"
    },
    {
      "t": "07:46",
      "text": "ஓ அந்த மாதிரி"
    },
    {
      "t": "07:48",
      "text": "அஹார் வச்சுக்கறதுக்கா"
    },
    {
      "t": "07:50",
      "text": "அப்பர் இருந்தாலும் சரி"
    },
    {
      "t": "07:52",
      "text": "பார்ட்ன கண்டியூ பண்ணால சரியாது உ"
    },
    {
      "t": "07:54",
      "text": "விருப்பம் அது அல்லாம் கிடைப்ப"
    },
    {
      "t": "07:56",
      "text": "ப்பான் பாக்க மற்றபடி வேற ஒும்ல்ல"
    },
    {
      "t": "07:58",
      "text": "கே கேே த பே"
    },
    {
      "t": "08:00",
      "text": "கிடடைப்பாங்க பட் ஆனா ஒய் இருக்கிற போய்"
    },
    {
      "t": "08:02",
      "text": "பண்றது தப்பு இல்லையா"
    },
    {
      "t": "08:04",
      "text": "அப்படி"
    },
    {
      "t": "08:06",
      "text": "தெரியல"
    },
    {
      "t": "08:08",
      "text": "ந பேேசறேன் நீங்க தப்பா எடுத்துக்காதங்க"
    },
    {
      "t": "08:10",
      "text": "ஏன்னா நான் அலோ பண்ண மாட்டேன்"
    },
    {
      "t": "08:12",
      "text": "அப்படி இருந்தா அதனால கேக்குறேன்"
    },
    {
      "t": "08:14",
      "text": "சரி சரி"
    },
    {
      "t": "08:16",
      "text": ""
    },
    {
      "t": "08:18",
      "text": "உங்களுக்கு என்ன இன்ட்ரெஸ்ட் இருக்கா"
    },
    {
      "t": "08:20",
      "text": ""
    },
    {
      "t": "08:22",
      "text": "எனக்கு இன்ட்ரஸ்ட் இருக்கு அதுக்குதான் டாும்"
    },
    {
      "t": "08:24",
      "text": "ப் அதது மாரீட பர்சன் கூட"
    },
    {
      "t": "08:26",
      "text": "டராாவல் பண்ணவோ ரீசன்ஷிப் ப"
    },
    {
      "t": "08:28",
      "text": "பனோ எனக்கு இன்ட்ரெஸ்ட் இல்ல"
    },
    {
      "t": "08:30",
      "text": "சரி ஓகே சரி உடம்பு பாத்துக்கோங்க"
    },
    {
      "t": "08:32",
      "text": "பீச்சர் எப்படியாவது மறுபடியும்"
    },
    {
      "t": "08:34",
      "text": "பேசுற சம்ப"
    },
    {
      "t": "08:36",
      "text": ""
    },
    {
      "t": "08:38",
      "text": "உ"
    },
    {
      "t": "08:40",
      "text": "அ"
    }
