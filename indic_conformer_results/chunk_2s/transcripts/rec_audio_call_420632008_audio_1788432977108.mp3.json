  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "ஹலோ ஹலோ"
    },
    {
      "t": "00:04",
      "text": "கேக்குதா ஹாய்"
    },
    {
      "t": "00:06",
      "text": "சஹ்"
    },
    {
      "t": "00:08",
      "text": ""
    },
    {
      "t": "00:10",
      "text": ""
    },
    {
      "t": "00:12",
      "text": "சென்னை"
    },
    {
      "t": "00:14",
      "text": "சரி"
    },
    {
      "t": "00:16",
      "text": "என்ன பண்றீங்க"
    },
    {
      "t": "00:18",
      "text": "ந உப்ப"
    },
    {
      "t": "00:20",
      "text": "பண்றே நீங்க"
    },
    {
      "t": "00:22",
      "text": "சரி ஹஸ்பண்ட்"
    },
    {
      "t": "00:24",
      "text": "இல்ல ஸ்பண்ட் இல்"
    },
    {
      "t": "00:26",
      "text": ""
    },
    {
      "t": "00:28",
      "text": "வே திங்கிலா"
    },
    {
      "t": "00:30",
      "text": "சிங்க தா"
    },
    {
      "t": "00:32",
      "text": "சரி சரி"
    },
    {
      "t": "00:34",
      "text": "அப்புறம் சாப்ப"
    },
    {
      "t": "00:36",
      "text": "உம் சாப்ப"
    },
    {
      "t": "00:38",
      "text": "நீ சாப்பீங்களா"
    },
    {
      "t": "00:40",
      "text": "அஸ் அ"
    },
    {
      "t": "00:42",
      "text": "எங்க பேரு"
    },
    {
      "t": "00:44",
      "text": "என் பேரு ராம்"
    },
    {
      "t": "00:46",
      "text": "ஆ"
    },
    {
      "t": "00:48",
      "text": "என்ன ரம் பண்றேங்க"
    },
    {
      "t": "00:50",
      "text": "என்ன ராம் பண்றீங்க சும்மாதான் ராம் இருக்கு"
    },
    {
      "t": "00:52",
      "text": "ஆமா"
    },
    {
      "t": "00:54",
      "text": "ஏன் அப்படி சிரக்கிறீங்க"
    },
    {
      "t": "00:56",
      "text": "காமெடியா சொ"
    },
    {
      "t": "00:58",
      "text": "இ ஆஹஹ"
    },
    {
      "t": "01:00",
      "text": "அப்புறோ"
    },
    {
      "t": "01:02",
      "text": "ஒ"
    },
    {
      "t": "01:04",
      "text": "பண்றீங்களா இல்ல வீட்ட சும்மாாதான் இருக்கீங்களா"
    },
    {
      "t": "01:06",
      "text": "சும்மாதான் இருக்கு வீட்டுல"
    },
    {
      "t": "01:08",
      "text": "போோத்துக்கு என்ன பண்றீ"
    },
    {
      "t": "01:10",
      "text": "ச"
    },
    {
      "t": "01:12",
      "text": "த்துக்குதுக்க வேலைக்கு போலாம் சோத்து எதுவும் பண்ண முடியும்"
    },
    {
      "t": "01:14",
      "text": "ா அப்புறம்"
    },
    {
      "t": "01:16",
      "text": "யார் சோறு கூடுவா ஆள் இருக்காங்களா சோறு கூட"
    },
    {
      "t": "01:18",
      "text": "உஹ சோ"
    },
    {
      "t": "01:20",
      "text": "ஓரளவுக்கு சோர்ஸ் இருக்கு அதனால"
    },
    {
      "t": "01:22",
      "text": "ஒன்னும் பராப்ள இல்"
    },
    {
      "t": "01:24",
      "text": "பரவாயில்லலைங்கா குட்டு இல்ல"
    },
    {
      "t": "01:26",
      "text": "அப்ப எந்த கம்மி"
    },
    {
      "t": "01:28",
      "text": "பபண்டமே இல்லையா எந்த இஎம்ஐ கட்டணும்"
    },
    {
      "t": "01:30",
      "text": "கூற எந்த தேவும் இல் சீரியஸா ரொம்ப"
    },
    {
      "t": "01:32",
      "text": "அப்பியா இருக்கீங்களாப்ப"
    },
    {
      "t": "01:34",
      "text": "எந்த கமி"
    },
    {
      "t": "01:36",
      "text": "பட்டி நம்ம உருவாக்கிறதுதல்ல அதனால தான் ஹாப்பி"
    },
    {
      "t": "01:38",
      "text": "எப்பியா இருக்கறேன்"
    },
    {
      "t": "01:40",
      "text": "உங்களிட்ட எல்லாமே இருக்கும் அதனால அ கம்"
    },
    {
      "t": "01:42",
      "text": "்மெ் உங்களுக்கு தேவையில்லாரே"
    },
    {
      "t": "01:44",
      "text": "எஸ்"
    },
    {
      "t": "01:46",
      "text": "ய அப்போ ஃபேமிலி கொஞ்சம் பெத்த"
    },
    {
      "t": "01:48",
      "text": "தமையேற்பான"
    },
    {
      "t": "01:50",
      "text": "பெஸ்ட் ஃபேமின உ ஒயஃப்ு"
    },
    {
      "t": "01:52",
      "text": "பையன் ரெண்டு வயசுல"
    },
    {
      "t": "01:54",
      "text": "உ"
    },
    {
      "t": "01:56",
      "text": "அவங்க மண்ணா அவங்க வேல அப்படி அப்படியே போயிட்டு இருக்கு"
    },
    {
      "t": "01:58",
      "text": "இந்தந்தப்பா அப்புமாந்தப்பா"
    },
    {
      "t": "02:00",
      "text": ""
    },
    {
      "t": "02:02",
      "text": "ஏங்க மேரி"
    },
    {
      "t": "02:04",
      "text": "இருந்து எப்படிங்க வேலைக்கு போகாம"
    },
    {
      "t": "02:06",
      "text": "ரன் பண்றீங்க"
    },
    {
      "t": "02:08",
      "text": "அநடதுக்க"
    },
    {
      "t": "02:10",
      "text": "ரன் பண்ண முடியா நான் பேேமிலியா"
    },
    {
      "t": "02:12",
      "text": "ஒண்ணு பிசினஸ் பண்ண"
    },
    {
      "t": "02:14",
      "text": "பண்ணும் இல்ன்னா இதது"
    },
    {
      "t": "02:16",
      "text": "வந்து இன்கம் சோர்ஸ் வரறதுக்கு ஏதாவது"
    },
    {
      "t": "02:18",
      "text": "இருதுக்கணும் ஏதாவது தன்கம் வருதா"
    },
    {
      "t": "02:20",
      "text": "வர வைக்கணும் இதுக்கப்புறம்"
    },
    {
      "t": "02:22",
      "text": "அப்புறந்தான்"
    },
    {
      "t": "02:24",
      "text": "ஆஹ் தெரியலவங்க"
    },
    {
      "t": "02:26",
      "text": "என கழி இந்த வேர்ல்ட்லயே ரொம்ப ஹாப்பிய"
    },
    {
      "t": "02:28",
      "text": "்டமன் தான் ராம் தான்"
    },
    {
      "t": "02:30",
      "text": "அயயயோ என்னாடது"
    },
    {
      "t": "02:32",
      "text": "ஓடிக்கட்டு இருக்காங்க நீ எவ்ளவு"
    },
    {
      "t": "02:34",
      "text": "நல்லா ஜாலியா இருக்குங்க வேலைக்கு போவாமா"
    },
    {
      "t": "02:36",
      "text": ""
    },
    {
      "t": "02:38",
      "text": "அப்புறம் உங்களுக்கு எ"
    },
    {
      "t": "02:40",
      "text": ""
    },
    {
      "t": "02:42",
      "text": "நார்மலா போயட்டுக்குன்"
    },
    {
      "t": "02:44",
      "text": "ரொம்ப சொல்லிக்கிற அளவுக்கல"
    },
    {
      "t": "02:46",
      "text": "உம்"
    },
    {
      "t": "02:48",
      "text": "பேரு"
    },
    {
      "t": "02:50",
      "text": "ஸ்்வேேதா மன ஸ்வேேதா ந"
    },
    {
      "t": "02:52",
      "text": "சென்னைதா"
    },
    {
      "t": "02:54",
      "text": "உம்"
    },
    {
      "t": "02:56",
      "text": ""
    },
    {
      "t": "02:58",
      "text": "என்ன பண்றீங்க"
    },
    {
      "t": "03:00",
      "text": "ந"
    },
    {
      "t": "03:02",
      "text": "ஒர்க் பண்றேன் நான் அகௌண்டன்ண்டா இருக்கேன்"
    },
    {
      "t": "03:04",
      "text": "படிச்சுட்டும் இருக்கேன் சிய படிச்சுட்டு இரு"
    },
    {
      "t": "03:06",
      "text": "சரி சரி"
    },
    {
      "t": "03:08",
      "text": "உஹம்"
    },
    {
      "t": "03:10",
      "text": "அதனாலதான் கேட்டேன் எப்படி உங்களால"
    },
    {
      "t": "03:12",
      "text": "ஜாலியா இருக்கும்ும் எனக்கு அடிய கி்டா இரு"
    },
    {
      "t": "03:14",
      "text": "கொக்குங்களேன் உங்க சொந்தத்துல யாராவது நல்ல"
    },
    {
      "t": "03:16",
      "text": "பையனா இருக்கானா இந்த மாதிரி"
    },
    {
      "t": "03:18",
      "text": "ஆஹ் என்னதான் மேரேஜ் பண்ணிக்கங்களா"
    },
    {
      "t": "03:20",
      "text": "நீங்கதான் அடி மாறிி"
    },
    {
      "t": "03:22",
      "text": "நான் உங்களுக்கெல்லாம் என்ன பண்ணிக்கணும்"
    },
    {
      "t": "03:24",
      "text": "நாட இது ஆஹ்"
    },
    {
      "t": "03:26",
      "text": "உம்"
    },
    {
      "t": "03:28",
      "text": "சரி சரி ஒன் சார்ல இல் இருக்கு"
    },
    {
      "t": "03:30",
      "text": "கட் பண்ணாதீங்க"
    },
    {
      "t": "03:32",
      "text": "சரி"
    },
    {
      "t": "03:34",
      "text": ""
    },
    {
      "t": "03:36",
      "text": ""
    },
    {
      "t": "03:38",
      "text": ""
    },
    {
      "t": "03:40",
      "text": ""
    },
    {
      "t": "03:42",
      "text": "உஹம்"
    },
    {
      "t": "03:44",
      "text": ""
    },
    {
      "t": "03:46",
      "text": ""
    },
    {
      "t": "03:48",
      "text": ""
    },
