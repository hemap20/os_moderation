    {
      "t": "00:02",
      "text": "ಆಯ್"
    },
    {
      "t": "00:04",
      "text": "ಎ"
    },
    {
      "t": "00:06",
      "text": "ಹ ನನ್"
    },
    {
      "t": "00:08",
      "text": "ತುಂಬಕೊ ನಿಮ್ದು"
    },
    {
      "t": "00:10",
      "text": ""
    },
    {
      "t": "00:12",
      "text": "ಹ ಎಲ್ಲಿ"
    },
    {
      "t": "00:14",
      "text": "ತಮ ಕರು"
    },
    {
      "t": "00:16",
      "text": "ಹ"
    },
    {
      "t": "00:18",
      "text": "ಏನ್ ಮಾಡತ ನದ"
    },
    {
      "t": "00:20",
      "text": "ಟೋಟಾ"
    },
    {
      "t": "00:22",
      "text": "ಎನ ಕೊಣದು"
    },
    {
      "t": "00:24",
      "text": "ನಾನಾ ಆಸ ಭಾಯ ನೀವು"
    },
    {
      "t": "00:26",
      "text": "ಮಜ್ಗಿದ್ದಯಾ"
    },
    {
      "t": "00:28",
      "text": "ಎಸ್ ಮಾರಡ್"
    },
    {
      "t": "00:30",
      "text": ""
    },
    {
      "t": "00:32",
      "text": "ಏನ್ ಹಂಗ್ ನೋಡ್ತಿದ್ರಾ ನ"
    },
    {
      "t": "00:34",
      "text": "ನ್ನು ದೇವ ತರ ಕಾಣಿಸ್ತಿದ್ದಿನ"
    },
    {
      "t": "00:36",
      "text": "ಹ ಮೊದ್ೆ ಆಗೀಾ ಅಂತ ಹೇಳಿದ್ರೆ ನಾದು"
    },
    {
      "t": "00:38",
      "text": "ಹ"
    },
    {
      "t": "00:40",
      "text": "ಹೌದಾ ಹ್ಮ"
    },
    {
      "t": "00:42",
      "text": "ಮದ್ುವವೆ ಆಗಿದೆ್ಮ"
    },
    {
      "t": "00:44",
      "text": "ಮತ್ತೆ ಊಟ ಮಾಡಿದಾರ"
    },
    {
      "t": "00:46",
      "text": "ಹ್ಮ್ ಹಾಗಿದ್ದೇನೆ"
    },
    {
      "t": "00:48",
      "text": "ನಿ ಹ್ಮ ಆಯ್ತು ಆತ"
    },
    {
      "t": "00:50",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "00:52",
      "text": "ಹ"
    },
    {
      "t": "00:54",
      "text": "ಏೇನ್ ಸಮಮಾಚಾರ"
    },
    {
      "t": "00:56",
      "text": "ಹೇಳಿ ಕೇಳೋಣ ನಿ"
    },
    {
      "t": "00:58",
      "text": "ಏ"
    },
    {
      "t": "01:00",
      "text": "ನನ್ಗಾ ಇಬ್ರು ಮಕ್ಕಳ"
    },
    {
      "t": "01:02",
      "text": ""
    },
    {
      "t": "01:04",
      "text": ""
    },
    {
      "t": "01:06",
      "text": "ಹ್ಮ್ ಓತ್ತೆ"
    },
    {
      "t": "01:08",
      "text": "ಏನ್ ಮಾಡ್ತಾರ ಅವರು"
    },
    {
      "t": "01:10",
      "text": "ಆ ಮಗಳು ಸೆಗಂಡ ಸ್ಟ್ಯಾಂಡರ್ಡ್"
    },
    {
      "t": "01:12",
      "text": "ಆ ಯು ಕೆ ಜಿ"
    },
    {
      "t": "01:14",
      "text": "ಕುಷ್ಟ ಮಾಡಜದ"
    },
    {
      "t": "01:16",
      "text": "ಹ ಎ ಮಾಡಾಗನು"
    },
    {
      "t": "01:18",
      "text": ""
    },
    {
      "t": "01:20",
      "text": "ಸೆಕೆಂಡ್ ಸ್ಟ್ಯಾಂಡರ್ಡು ಯು ಕೆ ಜಿ"
    },
    {
      "t": "01:22",
      "text": "ಚಂದ ಹ ಮಕ್ಕಳು"
    },
    {
      "t": "01:24",
      "text": "ಬಂದ"
    },
    {
      "t": "01:26",
      "text": "ಶ ಸರ್ಬ"
    },
    {
      "t": "01:28",
      "text": "ಮ್"
    },
    {
      "t": "01:30",
      "text": "ಮದ"
    },
    {
      "t": "01:32",
      "text": "ಅ"
    },
    {
      "t": "01:34",
      "text": "ಯಾರಿಗೆ ನನ್ ಗ"
    },
    {
      "t": "01:36",
      "text": "ಟ್ವೆಟಿಸ್"
    },
    {
      "t": "01:38",
      "text": "ಅಷ್ಟೇ ನಮ್ಕಿಂದ ಸಣ್ಣವರ"
    },
    {
      "t": "01:40",
      "text": ""
    },
    {
      "t": "01:42",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:44",
      "text": "ನಮ್ಗೆ"
    },
    {
      "t": "01:46",
      "text": "ಇಪ್ಪತ್ತ"
    },
    {
      "t": "01:48",
      "text": "ಪ್ರಥಮತ"
    },
    {
      "t": "01:50",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:52",
      "text": "ಕೆ ಓಕೆ ಮತ್ತೆ"
    },
    {
      "t": "01:54",
      "text": "ಮುದೆ ಮಾಡ್ಕೊಂಡಂಬಿದ್ದೀವಿಾ"
    },
    {
      "t": "01:56",
      "text": "ಹ"
    },
    {
      "t": "01:58",
      "text": "ಹದಿನೇಳೇಳು"
    },
    {
      "t": "02:00",
      "text": "ಹ"
    },
    {
      "t": "02:02",
      "text": "ಬ"
    },
    {
      "t": "02:04",
      "text": ""
    },
    {
      "t": "02:06",
      "text": ""
    },
    {
      "t": "02:08",
      "text": "ಹ"
    },
    {
      "t": "02:10",
      "text": "ಬದ ತಿ"
    },
    {
      "t": "02:12",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:14",
      "text": "ಟ"
    },
    {
      "t": "02:16",
      "text": "ಹ್ಮ ಇ"
    },
    {
      "t": "02:18",
      "text": "ಟ"
    },
    {
      "t": "02:20",
      "text": "ಹೇಳ್ಬೇಕಿಲ್ಲ ನೀವೇ"
    },
    {
      "t": "02:22",
      "text": "ನೆಟ್ವರ್ಕ್ ಇ ಯ"
    },
    {
      "t": "02:24",
      "text": "ಐತ ಮೆ"
    },
    {
      "t": "02:26",
      "text": "ಹೌದು"
    },
    {
      "t": "02:28",
      "text": ""
    },
    {
      "t": "02:30",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:32",
      "text": "ಮತ್ತೆ ಎಷ್ಟ್ ದಿನ ಆಯ್ತಾ ಆಪಿಿಗೆ"
    },
    {
      "t": "02:34",
      "text": ""
    },
    {
      "t": "02:36",
      "text": ""
    },
    {
      "t": "02:38",
      "text": ""
    },
    {
      "t": "02:40",
      "text": "ೆ ಮತ್ತೆ"
    },
    {
      "t": "02:42",
      "text": "ಬ ಬಿಟ್ಟಿದ್ದೀರಾ"
    },
    {
      "t": "02:44",
      "text": ""
    },
    {
      "t": "02:46",
      "text": "ಹಾ"
    },
    {
      "t": "02:48",
      "text": "ಏನ್ ರೀ ನಿ್ ಮೂರನೇಳಿರಿ"
    },
    {
      "t": "02:50",
      "text": "ಅದ ಅದಿಕಟ್ಟ ಅವ ತೋಟ ಕೊಡ"
    },
    {
      "t": "02:52",
      "text": ""
    },
    {
      "t": "02:54",
      "text": ""
    },
    {
      "t": "02:56",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:58",
      "text": "ನೆಟ್ವರ್ಕ್ ಬರ್ತಿದವಲ್ಲ"
    },
    {
      "t": "03:00",
      "text": "ಹ ತುಂಬಾ ಕಷ್ಟಕಡ್ಬೇಕತ್ತು"
    },
    {
      "t": "03:02",
      "text": ""
    },
    {
      "t": "03:04",
      "text": "ಹ"
    },
    {
      "t": "03:06",
      "text": "ಒಂದ ತಂಬ ಹಾಕ್ಬೇಕಿತ್ತು ಅಲ್ಲಿ"
    },
    {
      "t": "03:08",
      "text": ""
    },
    {
      "t": "03:10",
      "text": ""
    },
    {
      "t": "03:12",
      "text": "ಹ್ಮ ಹ"
    },
    {
      "t": "03:14",
      "text": "ಹಕೋಬೇಕು ನೀವ್ ಹೇಳುದ್ರೆ ಅಂತ"
    },
    {
      "t": "03:16",
      "text": "ಹ್ಮ್್ಮ ಅ ಮೊದ್ ಹಿದೀರ"
    },
    {
      "t": "03:18",
      "text": "ನಸ್ಪಡ್ತಿದ್ದಲ್ಲ"
    },
    {
      "t": "03:20",
      "text": ""
    },
    {
      "t": "03:22",
      "text": "ಹ ಮೊದ್ಲ ಹೇಳಿದ್ರೆ"
    },
    {
      "t": "03:24",
      "text": "ನಾನಕ ಭತಿ ಎ"
    },
    {
      "t": "03:26",
      "text": ""
    },
    {
      "t": "03:28",
      "text": "ಓ ಹೌದಾ"
    },
    {
      "t": "03:30",
      "text": "ಏನ್ ಕೆಲ್ಸ ಮಾಡ್ತಿದರಾ ನೀವುಕ ಕಡ"
    },
    {
      "t": "03:32",
      "text": "ಕ"
    },
    {
      "t": "03:34",
      "text": "ಕೆಳ ಕೆಮ್ಮ ಬಟ"
    },
    {
      "t": "03:36",
      "text": ""
    },
    {
      "t": "03:38",
      "text": "ಹ"
    },
    {
      "t": "03:40",
      "text": "ಅನ ಸಮಚಾರ ನ"
    },
    {
      "t": "03:42",
      "text": ""
    },
    {
      "t": "03:44",
      "text": ""
    },
    {
      "t": "03:46",
      "text": "ಹೇಳಿ ಕೇಳೋಣ ನಿಮ್ದೇ"
    },
    {
      "t": "03:48",
      "text": "ಹ್ಮ ಚಕ್ರಸ್ವತಿರನು ಕಾರಣ"
    },
    {
      "t": "03:50",
      "text": "ಯೇಳಳ್ತ"
    },
    {
      "t": "03:52",
      "text": ""
    },
    {
      "t": "03:54",
      "text": ""
    },
    {
      "t": "03:56",
      "text": "ಅಯ್ಯೋ ನೆಟ್ವರ್ಕ್ ಬರ್ತಿಲ್ಲಾ ಕಣ"
    },
    {
      "t": "03:58",
      "text": "ೀ ಎರಡ್ ಎರಡ್ ಪಾಯಿಂಟ್ ಆಗ್ಬಿಟ್ಟೈತೆ"
    },
    {
      "t": "04:00",
      "text": "ಇದ್ರಲ್ಲಿ ರೆಡ್ ಬಂದ್ಬಿಟ್ಟೈತು"
    },
    {
      "t": "04:02",
      "text": "ಏ ಮಣ"
    },
    {
      "t": "04:04",
      "text": "ಕಟ್ ಮಾಡಿ ಮತ್ತೆ ಮಾಡಿ ಅಷ್ಟೆ"
    },
    {
      "t": "04:06",
      "text": "ಕಟ್್ಮಡಿಿ ಮಾಡಿದ್ರೆ ಆಗಲ್ಲ ಅದ"
    },
    {
      "t": "04:08",
      "text": "ಬ ಸಿಗಲ್ಲ"
    },
    {
      "t": "04:10",
      "text": ""
    },
    {
      "t": "04:12",
      "text": ""
    },
    {
      "t": "04:14",
      "text": "ಬೇರೆಯ್ರು ಸಿತ"
    },
    {
      "t": "04:16",
      "text": "ಅಂತ ಗೊತ್ತಿಲ್ಲ ಇನ್ನುೂ ಇೂ ಅರ್ಥ ಇಲ್ಲ"
    },
    {
      "t": "04:18",
      "text": "ಎರಡು ದಿವಸ ಆಯ್ತು ಇವಾಗ ಮಾತಾಡಿರ್ತ"
    },
    {
      "t": "04:20",
      "text": "ಬೇರೆ ಮೇಕ"
    },
    {
      "t": "04:22",
      "text": "ಫೋನ್ ಮಾಡಿದ್ರೆ ಆಗಲ್ಲ ಬೇರೆ ಆಗ್ಬೇಕು"
    },
    {
      "t": "04:24",
      "text": ""
    },
    {
      "t": "04:26",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "04:28",
      "text": "ಏನು"
    },
    {
      "t": "04:30",
      "text": "ಹ"
    },
    {
      "t": "04:32",
      "text": "ನಿವ ಜಿನಾಯತ"
    },
    {
      "t": "04:34",
      "text": "ಹ್ಮ"
    },
    {
      "t": "04:36",
      "text": "ಹ ನನ್"
    },
    {
      "t": "04:38",
      "text": "ಬಂದು ಫೋರ್ ಡೇಸ್ ಆಯ್ತು"
    },
    {
      "t": "04:40",
      "text": "ಹೆ್ಜನ ಅಭಿಮಾನಿಗಳು"
    },
    {
      "t": "04:42",
      "text": "ಹ"
    },
    {
      "t": "04:44",
      "text": "ಒಬ್ಬರು"
    },
    {
      "t": "04:46",
      "text": "ಇಲ್ಲಕನ್ೀ"
    },
    {
      "t": "04:48",
      "text": "ಮಾತಡಬ ಎರಡು ಕಾಲು"
    },
    {
      "t": "04:50",
      "text": "ಅಷ್ಟೇ ನಾನ್ ಜ ಕಾಲ್ ಮಾಡ"
    },
    {
      "t": "04:52",
      "text": "ಸಏನುಾಡ್ತ ನಾನ"
    },
    {
      "t": "04:54",
      "text": "ನಾ ಕಿವ ಏನಾದ್ರು ಇಟ್ಕೊಂಡಿದ್ದೀನ"
    },
    {
      "t": "04:56",
      "text": "ಹ ನಾ ಕ ಸಯ್"
    },
    {
      "t": "04:58",
      "text": "ಬಂದು ಅಂತ ಕಲ್ ಅಂತ"
    },
    {
      "t": "05:00",
      "text": "ಆ"
    },
    {
      "t": "05:02",
      "text": "ಆಚಲಿ ನಾಲ್ಕ್ ದಿನದಿಂದ"
    },
    {
      "t": "05:04",
      "text": "ೆ ಅಂದ್ರೆ ಡೌನ್ಲೋಡ್ ಕೊಟರ"
    },
    {
      "t": "05:06",
      "text": "ನಿನ್ನೆ ಬಂದ ಒ ಕ"
    },
    {
      "t": "05:08",
      "text": "ಮಾತಾಡ ಅಂದ್ರೆ"
    },
    {
      "t": "05:10",
      "text": "ನಾರ್ಮಲ್ ಕಾಲಲ್ಲಿ ಹೋಗಿದ್ದೆ"
    },
    {
      "t": "05:12",
      "text": "ಹಾ ಹಾ"
    },
    {
      "t": "05:14",
      "text": "ಮಾತಾಡ್ದ ಅವರು ಹಂಗೆ ಒ"
    },
    {
      "t": "05:16",
      "text": "ಪ್ಪಂಟ್ ಹಾಕ್ಸ್ ಅಷ್ಟ ಇಲ್ಲಿ ಮಾತಾಡ್ದ ಹಂಗೆ ಈ"
    },
    {
      "t": "05:18",
      "text": "ಹಂಗೆ ಅಂದ್ರು ಆಮೇಲೆ ಕೋಪ ಬಂದು"
    },
    {
      "t": "05:20",
      "text": "ಟ್ಟ ಕಟ್ ಮಾಡ್ಬಿಟ್ಟಿ ಅ"
    },
    {
      "t": "05:22",
      "text": "ಆಫ್ಲೈನ್ ಅ"
    },
    {
      "t": "05:24",
      "text": "ಇವತ್ತು ತೋಡ್ತತ ಬಂದಿದ್ನಲ್ಲ"
    },
    {
      "t": "05:26",
      "text": "ಹ ಹಾನ್ ಮಾಡ ಒ"
    },
    {
      "t": "05:28",
      "text": "ನಿಮ್ಗಿಂತ ಹಂಚ ಒಬ್ರು ಬಂದಿದ್ರು"
    },
    {
      "t": "05:30",
      "text": "ಅವ್ರೇನೋ ಬ್ರೇಕ್"
    },
    {
      "t": "05:32",
      "text": "ಅಪ್ಪ ಐತಂತೆ ಅಂತ ಕಣ್ಣ"
    },
    {
      "t": "05:34",
      "text": "ನೀರ್ ಸುಡ್ಸ್ಕೊಂಡಿ"
    },
    {
      "t": "05:36",
      "text": "ಹ್ಮ"
    },
    {
      "t": "05:38",
      "text": ""
    },
    {
      "t": "05:40",
      "text": "ಓ ನಿಮ್ದ ನಂಬರ್ ಕೊಡಿ"
    },
    {
      "t": "05:42",
      "text": "ಮಾತಾಡೋಣ ನಾನ ಒಳ್ಳೆ ಹುಡುಗ"
    },
    {
      "t": "05:44",
      "text": "ಈಗ ಅನ್ಸಿದ್ರೆ ಅಷ್ಟೇ ಮಾತಾಡಿ ಇಲ್ಲ"
    },
    {
      "t": "05:46",
      "text": "ನೆ ಮಾತಾಡ್ಬೇಡಿ"
    },
    {
      "t": "05:48",
      "text": "ಹಗೆ"
    },
    {
      "t": "05:50",
      "text": "ಹಿಂಗೆ ಅಂತ ಕತೆ ಪುರಾಣ ಓಡ"
    },
    {
      "t": "05:52",
      "text": "ಅದ ತಲೆ ಕೆ ಇಟ್ಬಿಟ್ಟಿ"
    },
    {
      "t": "05:54",
      "text": ""
    },
