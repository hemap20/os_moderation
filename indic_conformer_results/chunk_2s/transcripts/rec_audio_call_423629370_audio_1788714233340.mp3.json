    {
      "t": "05:58",
      "text": "बच्चों को भी"
    },
    {
      "t": "06:00",
      "text": "हाथ ले लीजिए अपने छोड़ दीजिए ना"
    },
    {
      "t": "06:02",
      "text": "ठीक है"
