    {
      "t": "01:30",
      "text": "உம்"
    },
    {
      "t": "01:32",
      "text": "அதான் ஐடி கூ ஒரு சொன்னீங்கள"
    },
    {
      "t": "01:34",
      "text": "இன்ஸ்டா ஐடி நகி"
    },
    {
      "t": "01:36",
      "text": "என்ன பண்றீங்க"
    },
    {
      "t": "01:38",
      "text": ""
    },
    {
      "t": "01:40",
      "text": "ஆஹ் சும்மாதான் இருக்கேன்"
    },
    {
      "t": "01:42",
      "text": "நீங்க"
    },
    {
      "t": "01:44",
      "text": "என்ன"
    },
    {
      "t": "01:46",
      "text": ""
    },
    {
      "t": "01:48",
      "text": "என்ன"
    },
    {
      "t": "01:50",
      "text": "ச"
    },
    {
      "t": "01:52",
      "text": "ஹலோ கேக்குதா"
    },
    {
      "t": "01:54",
      "text": "கேக்குது சொல்லுங்க சொல்லுங்க"
