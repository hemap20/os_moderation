    {
      "t": "00:32",
      "text": ""
    },
    {
      "t": "00:34",
      "text": "எங்க"
    },
    {
      "t": "00:36",
      "text": ""
    },
    {
      "t": "00:38",
      "text": "ந வேடி என்ண்ணக்கு"
    },
    {
      "t": "00:40",
      "text": "உம்"
    },
    {
      "t": "00:42",
      "text": "சொல்லுங்க என கேடச்சு ஏார"
    },
    {
