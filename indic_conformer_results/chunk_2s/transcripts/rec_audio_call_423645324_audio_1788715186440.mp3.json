      "text": "நீங்க"
    },
    {
      "t": "00:46",
      "text": "பேசுறதான் கேட்கல கலியரா ஹெட்்போன்"
    },
    {
      "t": "00:48",
      "text": "வந்து கழட்டனீங்கன்னா நல்லா கேக்கும்"
    },
    {
      "t": "00:50",
      "text": ""
    },
    {
      "t": "00:52",
      "text": "ஆஹ"
    },
    {
      "t": "00:54",
      "text": "ஹல உஹம்"
    },
    {
      "t": "00:56",
      "text": "சொல்லுங்க எங்க இருந்து பேசுவீங்க"
    },
    {
      "t": "00:58",
      "text": "ஹலோ கேக்குது"
    },
    {
      "t": "01:00",
      "text": "சொல்லுங்க எங்கங்கஷ"
    },
    {
      "t": "01:02",
      "text": "நான் கோஞ"
    },
    {
      "t": "01:04",
      "text": "சொற நீங்க"
