    {
      "t": "01:06",
      "text": "ஆ"
    },
    {
      "t": "01:08",
      "text": "உங்க நேம் என்ன"
    },
    {
      "t": "01:10",
      "text": "வினோத்"
    },
    {
      "t": "01:12",
      "text": "நடி நம்ம பேசனோம்லா"
    },
    {
      "t": "01:14",
      "text": "உம் ஆல்ரடி"
    },
    {
      "t": "01:16",
      "text": "பேசிருக்கோம்லாம் நம்ம இல்லையா"
    },
    {
      "t": "01:18",
      "text": "அஹ"
    },
    {
      "t": "01:20",
      "text": "ஒரு நேம் பவித்ராான்"
    },
    {
      "t": "01:22",
      "text": "அதான் பேசனும்ல ஒரு டைம்"
