    },
    {
      "t": "01:28",
      "text": "ಸೀತಾ ಆಶ್ರಯಣ್ಯಸ್ತ"
    },
    {
      "t": "01:30",
      "text": "ಹ ಅಷ್ಟೇ ಸೀತಾನೆ"
    },
    {
      "t": "01:32",
      "text": "ಕೆ"
    },
    {
      "t": "01:34",
      "text": "ಈ ಜನ್ಪತಿ ಶೀತ"
    },
