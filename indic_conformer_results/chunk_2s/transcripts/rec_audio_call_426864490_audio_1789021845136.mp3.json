    },
    {
      "t": "02:18",
      "text": "ತ"
    },
    {
      "t": "02:20",
      "text": "ಚರಿವಾ"
    },
    {
      "t": "02:22",
      "text": "ಹಲೋ ನೆಟ್ವರ್ಕ್ ಇ"
    },
    {
      "t": "02:24",
      "text": "ನೆಟ್ವರ್ಕ್ ಇದೆ"
    },
    {
      "t": "02:26",
      "text": "ಮತ್ತೆ ವಾಸ"
    },
    {
      "t": "02:28",
      "text": "ವಯ್ಸ್ ಬೇಕಾಗ್ತದೆ"
    },
    {
      "t": "02:30",
      "text": "ಾ ಕೆ"
    },
    {
      "t": "02:32",
      "text": "ಹಂಗರೆ ಗೊತ್ತಿಲ್ಲ"
    },
    {
      "t": "02:34",
      "text": "ಈ"
    },
    {
      "t": "02:36",
      "text": "ಿದೆಯಾ"
    },
    {
      "t": "02:38",
      "text": "ಏನು"
    },
    {
      "t": "02:40",
      "text": "ಹಫಡಂ"
    },
    {
      "t": "02:42",
      "text": "ಹಾ ಹಾೌಸ್ ವೈಫ್"
    },
    {
      "t": "02:44",
      "text": "ಹಓ ಹ"
    },
    {
      "t": "02:46",
      "text": "ಹ"
    },
    {
      "t": "02:48",
      "text": "ಮು್ದಾಗಿದ್ಯಾಾ"
    },
    {
      "t": "02:50",
      "text": "ಇ ಹ್ಮ"
    },
