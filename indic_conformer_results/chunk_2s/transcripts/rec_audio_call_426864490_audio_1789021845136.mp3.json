    {
      "t": "04:00",
      "text": "ಹಲೋ"
    },
    {
      "t": "04:02",
      "text": "ಹಾ ಹೇಳ"
    },
    {
      "t": "04:04",
      "text": "ನನ್ನ ಹತ್ರ ಮಾತಾ ಇದಲ್ಲ"
    },
    {
      "t": "04:06",
      "text": "ಹೌದು ಎಷ್ಟಂದ ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "04:08",
      "text": "ಅಂತ ಆಪ"
    },
    {
      "t": "04:10",
      "text": "ಇದು"
    },
    {
      "t": "04:12",
      "text": "ಒಂದ್ ತಿಂ್ಗಳು ಹಿಂದೆನೆ ಮಾಡಿದ್ದೆ ಡೌನ್ಲೋಡ್"
    },
    {
      "t": "04:14",
      "text": "ಮಾಡಿಲ್ಲ"
    },
    {
      "t": "04:16",
      "text": "ಹ್ಮ ಹ್ಮ"
    },
    {
      "t": "04:18",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ಹ್ಮ್ಲ್ಲಿ"
    },
    {
      "t": "04:20",
      "text": "ಪಾ ಮಾತಾಡ್ರೆ"
    },
    {
      "t": "04:22",
      "text": "ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "04:24",
      "text": "ಹ್ಮ"
    },
    {
      "t": "04:26",
      "text": "ನಾ ನಾನ"
    },
    {
      "t": "04:28",
      "text": "ಹ ಯಾಕ ಬಂದಿದ್ದು"
    },
    {
      "t": "04:30",
      "text": "ಅಂದ್ರೆ ಬೀಡಿ ಏನು ಉದ್ದೇಶ ಇಲ್ಲ ಬಟ್"
    },
    {
      "t": "04:32",
      "text": "ನಮ ಇಂಟ್ರೆಸ್ಟ್"
    },
    {
      "t": "04:34",
      "text": "ಕಾನ್ಸೆಪ್ಟ ಗಳು ಟಾಪಿಕ್ ಗಳು"
    },
    {
      "t": "04:36",
      "text": "ಎಲ್ಲ ಇತ್ತಲ್ಲಾ ಆಪಲ್"
    },
    {
      "t": "04:38",
      "text": "ಸೊ ಆತರ ಎಲ್ಲಾ ಮಾತಾಡ್ಬೋದು"
    },
    {
      "t": "04:40",
      "text": "ನಾಲೆಡ್್ ಇಂಪ್ರೂವ್ ಆಗೆ"
    },
    {
      "t": "04:42",
      "text": "ರ ಇಂಟೆನ್ಷನ್ ಇಟ್ಕೊಂಡು"
    },
    {
      "t": "04:44",
      "text": "ಮಾಡಿದ್ದು ಬಟ್ಿಗೆ ಎಲ್ಲ ಬೀರೆಏ"
    },
    {
      "t": "04:46",
      "text": "ನ್ ಟೆನ್ಷನ್ ಇಂದ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "04:48",
      "text": "ಮುಟಲೂರು"
    },
    {
      "t": "04:50",
      "text": "ಕೆಲವರು ಚೆನ್ನಾಗ್ ಮಾತಾಡ್ತಾರೆ ನಿಮ ತರ"
    },
    {
      "t": "04:52",
      "text": "ಹ"
    },
    {
      "t": "04:54",
      "text": "ಇರ್ತಾರ ಈಗ ಇರ್ತಾರ"
    },
    {
      "t": "04:56",
      "text": "ಹೆಂಗೂ ಇರ್ತಾರೆ"
    },
    {
      "t": "04:58",
      "text": "ಗ"
    },
    {
      "t": "05:00",
      "text": "ಇಷ್ಟೇ ಅಲ್ವಾ"
    },
    {
      "t": "05:02",
      "text": "ಹಾ"
    },
    {
      "t": "05:04",
      "text": "ಅಷ್ಟೇ"
    },
    {
      "t": "05:06",
      "text": "ಅಲ್ವಾ ಅಂದ್ರೆ ಎಲ್ಲಾರು ಅದ ತರದಲ್ಲ"
    },
    {
      "t": "05:08",
      "text": "ಹ ಎಲ್ಲ ಒಂದೇ ತರ ಇರಲ್ಲ"
    },
    {
      "t": "05:10",
      "text": "ಪಾಪಾ ಏನನು ಅವ್ರ"
    },
    {
      "t": "05:12",
      "text": "ಪ್ರಾಬ್ಲಮ್ಗಳು ಗೊತ್ತಿಲ್ಲ"
    },
    {
      "t": "05:14",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "05:16",
      "text": "ಅಾರ ಆಲ್ಮೋಸ್ಟ್ ಶು"
    },
    {
      "t": "05:18",
      "text": "ಅೇ ಹುಡುಗಿರಲ್ಲ ಬರೋದು ಇದಕ್ಕೆಲ್ಲ"
    },
    {
      "t": "05:20",
      "text": "ಲೇಡೀಸು"
    },
    {
      "t": "05:22",
      "text": "ಇ ಖರ್ಚಿಗೆ ನಪ್ಪದುಡ್ಡು ಬರ"
    },
    {
      "t": "05:24",
      "text": "ಂತ ಆಮೋಸ್ಟ್ ಎಲ್ಲ ಅಧಿಕರ್ತಾರೆ"
    },
    {
      "t": "05:26",
      "text": "ಅಯೋ"
    },
    {
      "t": "05:28",
      "text": "ಬರುತ್ತೆ"
    },
    {
      "t": "05:30",
      "text": "ಇದ್ರ"
    },
    {
      "t": "05:32",
      "text": "ನಿಮ್ದದಲ್ಲಿ ಒ್ ಐ್ ನಿಮಿಷ ಮಾತಡಿದ್ರ ಐದು ರೂಪಾಯಿ"
    },
    {
      "t": "05:34",
      "text": "ಬರುತ್ ಅಷ್ಟ"
    },
    {
      "t": "05:36",
      "text": "ಹೌದಾ ಏನಬಿಲ್ಲ"
    },
    {
      "t": "05:38",
      "text": "ಅವ್ರು ಹೇಳ ಎಲ್ಲ ಟೂ ಹಂಡ್ರೆ ತ್ರೀ ಹಂಡ್ರೆಡ್ ಮಾಡತಾರೆ"
    },
    {
      "t": "05:40",
      "text": "ಅಲ್ಲು"
    },
    {
      "t": "05:42",
      "text": "ಗಂಟಾಂಗಂಗಟ್ಲೆ ಅದ್ನೇ ಒಂದು"
    },
    {
      "t": "05:44",
      "text": "ಹಾಬಿಿಯಗ ಮಾಡ್ಕೊಂಡ್ ಫುಲ್ ಮಾತ್"
    },
    {
      "t": "05:46",
      "text": "ಡದ್ರೆ ಅವಾಗ ವರ್ಕ್ೌಟ್ ಆಗತ್ತೇನು"
    },
    {
      "t": "05:48",
      "text": "ನ"
    },
    {
      "t": "05:50",
      "text": "ನಮ್ಗ ಒ್ ಐ್ ನಿಮಿ ೈಮ್ ಸಿಗುತ್ತ ಯಾರ್ದು"
    },
    {
      "t": "05:52",
      "text": "ಮಾತಾಡಿದ್ರೆ ಏನಾದ್ರು ಒಂದು"
    },
    {
      "t": "05:54",
      "text": "ಐಡಿಯಾಸ್ ಕೊಡ್ತಾರೆ ನಾಲೆಡ್ಜ್ ಇಂಪ್ರೂವ್"
    },
    {
      "t": "05:56",
      "text": "ಆ ತರ ಇಂಟೆನ್ನ್ ಇ"
