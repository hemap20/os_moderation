{
  "file_id": "rec_audio_call_426664916_audio_1788995286548.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 642.611,
  "processing_time_sec": 21.999780654907227,
  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "പില്ല"
    },
    {
      "t": "00:04",
      "text": "ഹലോ"
    },
    {
      "t": "00:06",
      "text": ""
    },
    {
      "t": "00:08",
      "text": "ഇത് മലപ്പുറം ഇതവിടന്ന"
    },
    {
      "t": "00:10",
      "text": "എട്ട വണ്ട"
    },
    {
      "t": "00:12",
      "text": "ഓക്കെ അല പേര് എന്താ"
    },
    {
      "t": "00:14",
      "text": "ബോബുൽ"
    },
    {
      "t": "00:16",
      "text": "എവിടെ പേരെന്താ"
    },
    {
      "t": "00:18",
      "text": "മുറിയ റിയ ഫാത്തിീൻ"
    },
    {
      "t": "00:20",
      "text": ""
    },
    {
      "t": "00:22",
      "text": "ആഞ"
    },
    {
      "t": "00:24",
      "text": "ൻ സ്റ്റഡിയണ് ഫാഷൻ ഡിസൈനിങ് ആണ്"
    },
    {
      "t": "00:26",
      "text": "സെക്കൻഡ് ഇയർ ആണ്"
    },
    {
      "t": "00:28",
      "text": "ആ ഇപ്പം തിരൂര് വർ"
    },
    {
      "t": "00:30",
      "text": "ണ്ട്ിയള എന്ത ചെയ്യുന്നേ"
    },
    {
      "t": "00:32",
      "text": "ഞാന ഇവിടെ ടു ഹഡ്രഡ"
    },
    {
      "t": "00:34",
      "text": "ന്നെയാണ് ഇവന്റ് മാനേജ്മെന്റ് വർക്ക് ചെയ്യുന്നത്"
    },
    {
      "t": "00:36",
      "text": "ഓക്കെ ഓക്കെ"
    },
    {
      "t": "00:38",
      "text": "ഓ സിംഗിൾ ആണോ അതോ മ മാരിീഡ് ആണോ"
    },
    {
      "t": "00:40",
      "text": "ൻ സംഗ ആാണ്"
    },
    {
      "t": "00:42",
      "text": ""
    },
    {
      "t": "00:44",
      "text": "ണം മാരേജ് ഇങ്ങനെ നോക്കുന്നുണ്ട്"
    },
    {
      "t": "00:46",
      "text": ""
    },
    {
      "t": "00:48",
      "text": "പിന്നെ"
    },
    {
      "t": "00:50",
      "text": "എത്രയപ്ല റേറ്റ്"
    },
    {
      "t": "00:52",
      "text": ""
    },
    {
      "t": "00:54",
      "text": "പറേക്കിന ആയി"
    },
    {
      "t": "00:56",
      "text": "തീല്ല അല്ലപ്പഴേക്കർക്കും"
    },
    {
      "t": "00:58",
      "text": "ആ"
    },
    {
      "t": "01:00",
      "text": "ആ ഞാൻ"
    },
    {
      "t": "01:02",
      "text": "ഇന്താ അപ്പ ഉറങ്ങിയി ഉറങ്ങിീട്ട് കാണുന്നത്"
    },
    {
      "t": "01:04",
      "text": "അ"
    },
    {
      "t": "01:06",
      "text": "ഉറങ്ങിയനി ടറ്റ ഒന്ന് കയറിയതാ"
    },
    {
      "t": "01:08",
      "text": "ആണോ"
    },
    {
      "t": "01:10",
      "text": "ഓക്കെ"
    },
    {
      "t": "01:12",
      "text": "ഉം"
    },
    {
      "t": "01:14",
      "text": "ഞാൻ ഉറങ്ങിയതാ പിന്നെ"
    },
    {
      "t": "01:16",
      "text": "പോസ്റ്റ്യപ്പ കേറത്"
    },
    {
      "t": "01:18",
      "text": "ആ"
    },
    {
      "t": "01:20",
      "text": ""
    },
    {
      "t": "01:22",
      "text": "പിന്നെ"
    },
    {
      "t": "01:24",
      "text": "എന്താണ് പരിപാടി"
    },
    {
      "t": "01:26",
      "text": "പിന്നെന്താ പിന്നെ"
    },
    {
      "t": "01:28",
      "text": "അ കുഴപ്പൊന്നില്ല"
    },
    {
      "t": "01:30",
      "text": "െല്ലാം വീട്ടില ഇരിക്കെണ്ട്"
    },
    {
      "t": "01:32",
      "text": "വീട്ടില് ഞാന് അമ്മ അവിടെ"
    },
    {
      "t": "01:34",
      "text": "അ"
    },
    {
      "t": "01:36",
      "text": "ാനോ ഞാനും"
    },
    {
      "t": "01:38",
      "text": "മജിയുണ്ട് പിന്നെ വാപ്പൻ"
    },
    {
      "t": "01:40",
      "text": "ബ്രതറൊക്കെ അപോട ആർക്ക"
    },
    {
      "t": "01:42",
      "text": "ആഹ് ഇപ്പൊ ഉമ്മച്ചി ാണ്"
    },
    {
      "t": "01:44",
      "text": "േ"
    },
    {
      "t": "01:46",
      "text": "ആ ഇത് എത്രയാ"
    },
    {
      "t": "01:48",
      "text": "ട്വന്റ്റി ഫോർ"
    },
    {
      "t": "01:50",
      "text": "തക് യ"
    },
    {
      "t": "01:52",
      "text": "വൻ"
    },
    {
      "t": "01:54",
      "text": "അതെ"
    },
    {
      "t": "01:56",
      "text": "ഇവൻ മേജ"
    },
    {
      "t": "01:58",
      "text": "ന്ണോ നാളെ വർക്കുണ്ടോ"
    },
    {
      "t": "02:00",
      "text": "നാളെ വർക്കല്ല നാളെ ഓഫ് ആണ"
    },
    {
      "t": "02:02",
      "text": "ആ"
    },
    {
      "t": "02:04",
      "text": "ഓക്കെ ഓക്കേ ഇതില എങ്ങനെയക്ക"
    },
    {
      "t": "02:06",
      "text": "ഫ്രോണ്ട്സൊക്കെങ്ങനെയ ഒരു ആറ്ററിമാരണാണ് കൂടുതൽ"
    },
    {
      "t": "02:08",
      "text": "ഇതില്"
    },
    {
      "t": "02:10",
      "text": "അങ്ങനെ കൊറേൊക്കെ വാര്ും കുറേ ഫേക്ക് കോൾസ്"
    },
    {
      "t": "02:12",
      "text": "ര പിന്നെ"
    },
    {
      "t": "02:14",
      "text": "അല്ലത്"
    },
    {
      "t": "02:16",
      "text": "ആന്റിിമാല്ലാത്ത ഒരു"
    },
    {
      "t": "02:18",
      "text": "പിള്ളേരു പരിഫ"
    },
    {
      "t": "02:20",
      "text": "ഓക്കെ ഓക്കേ അല്ലേ ഞാൻ"
    },
    {
      "t": "02:22",
      "text": "അങ്ങനെ കേട്ടിട്ടുണ്ട്"
    },
    {
      "t": "02:24",
      "text": "കുറെ കൂടുതൽ ആൻ"
    },
    {
      "t": "02:26",
      "text": "ഇസാണ് അത് ആട്ടോ ചച്ച്"
    },
    {
      "t": "02:28",
      "text": "ആൻഡീസ് ഒക്കെ ഉണ്ട് ആൻഡ"
    },
    {
      "t": "02:30",
      "text": "തുടർന്നും അധികം സംസാരിക്കാറില്ല"
    },
    {
      "t": "02:32",
      "text": ""
    },
    {
      "t": "02:34",
      "text": "അതിന്റെ താല്പര്യം ഇല്ലാണ്ടാണോ"
    },
    {
      "t": "02:36",
      "text": "ആിമാരോട്"
    },
    {
      "t": "02:38",
      "text": "വല്ിയ താല്പര്യം ഇടല്ല"
    },
    {
      "t": "02:40",
      "text": ""
    },
    {
      "t": "02:42",
      "text": "ഉ"
    },
    {
      "t": "02:44",
      "text": "അർജണ കേട്ടില്ല"
    },
    {
      "t": "02:46",
      "text": "അല്ല"
    },
    {
      "t": "02:48",
      "text": "വെർജിന ആണോോ"
    },
    {
      "t": "02:50",
      "text": "ആ"
    },
    {
      "t": "02:52",
      "text": "അഓക്കെ അഫെയർ ഉണ്ടോ"
    },
    {
      "t": "02:54",
      "text": "അഫൽ മുന്നേ ഉണ്ടായിരുന്നു"
    },
    {
      "t": "02:56",
      "text": "അ അത്രയില്ല"
    },
    {
      "t": "02:58",
      "text": "എന്റെറ്റ അവള തേച്ചിട്ട"
    },
    {
      "t": "03:00",
      "text": "ഓ തങ്ങ ത"
    },
    {
      "t": "03:02",
      "text": "അതയ"
    },
    {
      "t": "03:04",
      "text": "അ"
    },
    {
      "t": "03:06",
      "text": "ല്ലോ"
    },
    {
      "t": "03:08",
      "text": "നിക്ക്"
    },
    {
      "t": "03:10",
      "text": "മേ"
    },
    {
      "t": "03:12",
      "text": "ഇ"
    },
    {
      "t": "03:14",
      "text": "നീച്ചഗ"
    },
    {
      "t": "03:16",
      "text": "ഓന ചെറുത"
    },
    {
      "t": "03:18",
      "text": "ഓന് ചെറുതായിട്ട് മറ്റേ ഡ്രസ്"
    },
    {
      "t": "03:20",
      "text": "കേസത ആഹ"
    },
    {
      "t": "03:22",
      "text": "അപ്പൊ അത്"
    },
    {
      "t": "03:24",
      "text": "സീനായി വീട്ടിലാട്ടക്കാറുണ്ട്ണ്ട്"
    },
    {
      "t": "03:26",
      "text": "ഹരിവർണ"
    },
    {
      "t": "03:28",
      "text": "വേണ്ട നോക്കുന്നത് നല്ലത് അനെ"
    },
    {
      "t": "03:30",
      "text": "എന്ന മീസില ങ്ങൻ പെരിഞ്ഞളാം"
    },
    {
      "t": "03:32",
      "text": "അപ്പൊ പിന്നെ വേറെ കല്യാണം"
    },
    {
      "t": "03:34",
      "text": "കാപ്പട"
    },
    {
      "t": "03:36",
      "text": "ആഹ പിന്നെ വേറെന്ന"
    },
    {
      "t": "03:38",
      "text": "നോക്കണ ഇനി ടൈമിങ് ഉണ്ട്"
    },
    {
      "t": "03:40",
      "text": "നമുക്കൊരു"
    },
    {
      "t": "03:42",
      "text": "ജോബ് ഒക്കെ സെറ്റ്ായി കുറച്ച"
    },
    {
      "t": "03:44",
      "text": "നി ഒക്കെ കിട്ടി"
    },
    {
      "t": "03:46",
      "text": "അങ്ങനെ മതിന്ന് വിചാരിച്ചിട്ടുണ്ട്"
    },
    {
      "t": "03:48",
      "text": "ആഹ"
    },
    {
      "t": "03:50",
      "text": "ഓ സെക്ഷൽ റിലേഷൻ"
    },
    {
      "t": "03:52",
      "text": "ശെ"
    },
    {
      "t": "03:54",
      "text": "എക്ഷില റിലേഷൻ"
    },
    {
      "t": "03:56",
      "text": "വേണന്ന് ആഗ്രഹിക്കുന്നുണ്ട്"
    },
    {
      "t": "03:58",
      "text": "പക്ഷെ നമുക്കൊരു പറ്റ"
    },
    {
      "t": "04:00",
      "text": "ഒത്തി പേഴ്സണ കിട്ടുകാനെങ്കിൽ ചെയ്യും"
    },
    {
      "t": "04:02",
      "text": "അപ്പൊ ഇതുവര നടന്നിട്ടില്ല"
    },
    {
      "t": "04:04",
      "text": ""
    },
    {
      "t": "04:06",
      "text": "ആ ആ ഓനായിട്ട് നടന്നിട്ടുണ്ട്"
    },
    {
      "t": "04:08",
      "text": "ന്നിട്ടുണ്ട് എക്സിനേറ്റ്്"
    },
    {
      "t": "04:10",
      "text": "ഓക്കെ"
    },
    {
      "t": "04:12",
      "text": "ഇപ്പം നമുക്കത് മ"
    },
    {
      "t": "04:14",
      "text": "സ നുണ്ട് അക്ക"
    },
    {
      "t": "04:16",
      "text": "ആ അതാ ഞാൻ പറ"
    },
    {
      "t": "04:18",
      "text": "മേജ എക്യ"
    },
    {
      "t": "04:20",
      "text": "ചെയ"
    },
    {
      "t": "04:22",
      "text": "ആഹക്കേ"
    },
    {
      "t": "04:24",
      "text": "നമുക്ക"
    },
    {
      "t": "04:26",
      "text": "ബന്ധത്തിെ ആ"
    },
    {
      "t": "04:28",
      "text": "ആഹ ഏള എഴായിട്ടൂപ"
    },
    {
      "t": "04:30",
      "text": ""
    },
    {
      "t": "04:32",
      "text": "വിടെ"
    },
    {
      "t": "04:34",
      "text": "ആ യെസ് മലപ്പുറം"
    },
    {
      "t": "04:36",
      "text": "ഫൾ മ"
    },
    {
      "t": "04:38",
      "text": "പുറത്തോട്ട് വരണോ"
    },
    {
      "t": "04:40",
      "text": "ആഹ്"
    },
    {
      "t": "04:42",
      "text": "മലപ്പുറത്തട്ട് ബീച്ചിലോട്ട്"
    },
    {
      "t": "04:44",
      "text": "എന്നാൽ മതി കോഴിക്കോട്"
    },
    {
      "t": "04:46",
      "text": "കോഴിക്കോട് കോഴിക്കോട്"
    },
    {
      "t": "04:48",
      "text": "ബീസിലൊക്കെ ബീസില"
    },
    {
      "t": "04:50",
      "text": "അന്നാൽ മതി ഞങ്ങള അവിടെ ഉണ്ടാവും"
    },
    {
      "t": "04:52",
      "text": "ഞങ്ങ ഫ്ര ഒക്കെ ആട്ട് വരാ"
    },
    {
      "t": "04:54",
      "text": "ബീജിലോ"
    },
    {
      "t": "04:56",
      "text": ""
    },
    {
      "t": "04:58",
      "text": "അപ്പൊ എന് പറ"
    },
    {
      "t": "05:00",
      "text": "വരും വീട്ടില്"
    },
    {
      "t": "05:02",
      "text": ""
    },
    {
      "t": "05:04",
      "text": "ജസ്റ്റ് മീറ്റ് ചെയ്യാനല്ലേ ഫ്രണ്ട്സിന്റെ"
    },
    {
      "t": "05:06",
      "text": "എന്തെങ്കിലും പാട്ടാണോ"
    },
    {
      "t": "05:08",
      "text": "സെലിബ്രേഷനാണോ അങ്ങനെയൊക്കും പറയാണം"
    },
    {
      "t": "05:10",
      "text": "അപ്പൊ സ്റ്റേ"
    },
    {
      "t": "05:12",
      "text": "സ്റ്റേ വേണോ"
    },
    {
      "t": "05:14",
      "text": "അതേ വേണ്ട"
    },
    {
      "t": "05:16",
      "text": "ജറ്റ് എ"
    },
    {
      "t": "05:18",
      "text": "വേണ്ടി"
    },
    {
      "t": "05:20",
      "text": "ആഹ അ"
    },
    {
      "t": "05:22",
      "text": "രാവിലെ വന്നിട്ട് വൈകിട്ട് പോന്നാൽ പോരെ"
    },
    {
      "t": "05:24",
      "text": "ഓ അങ്ങനെയാണെങ്കിലും മതി"
    },
    {
      "t": "05:26",
      "text": "ആ"
    },
    {
      "t": "05:28",
      "text": "േ കുറച്ച് സീനാണ് വീട്ടിലെ"
    },
    {
      "t": "05:30",
      "text": "ഒരുരേഷ്ടം"
    },
    {
      "t": "05:32",
      "text": "അങ്ങനെയാണെങ്കി അങ്ങനെ നോക്ക"
    },
    {
      "t": "05:34",
      "text": "അവിടെ എവിടെെങ്കിലും സ്റ്റ"
    },
    {
      "t": "05:36",
      "text": "നോക്കാം"
    },
    {
      "t": "05:38",
      "text": "പിന്നെ"
    },
    {
      "t": "05:40",
      "text": "വല നൈറ്റ് ഫംഗഷൻ ആാണ്"
    },
    {
      "t": "05:42",
      "text": "ഫ്രണ്ടിന് വഡലി കിടക്കും"
    },
    {
      "t": "05:44",
      "text": "ബെറ്റ് ചെയ്ന്ന് വരും അങ്ങനെയൊക്കെ പറയണം"
    },
    {
      "t": "05:46",
      "text": "ഓ അത് കുഴപ്പ ഇില്ല ഞാൻ"
    },
    {
      "t": "05:48",
      "text": "ആണെങ്കിൽ രാവിലെ വന്നാൽ വൈകിട്ട് പോ"
    },
    {
      "t": "05:50",
      "text": ""
    },
    {
      "t": "05:52",
      "text": "ഓക്കെ"
    },
    {
      "t": "05:54",
      "text": "യാ"
    },
    {
      "t": "05:56",
      "text": "അത് ഫസ്റ്റ് ടൈം ആണോ അതോ"
    },
    {
      "t": "05:58",
      "text": "വാക്സിനേറ്റ് ചെയ്തിട്ടാണോ"
    },
    {
      "t": "06:00",
      "text": "വായിട്ട് ഞാാന ഇതരു ചെയ്തിട്ടില്ല"
    },
    {
      "t": "06:02",
      "text": ""
    },
    {
      "t": "06:04",
      "text": "ആണോ പിന്നെ ആരായിട്ട് ചെയ്"
    },
    {
      "t": "06:06",
      "text": "അല്ലാതെരു ഫ്രണ്ട് ആട്ട്"
    },
    {
      "t": "06:08",
      "text": "ചെയ്തു"
    },
    {
      "t": "06:10",
      "text": "ആ എക്സ്പീരിയൻസ ആാണ് അയാ"
    },
    {
      "t": "06:12",
      "text": "എനിക്ക്"
    },
    {
      "t": "06:14",
      "text": "എക്സ്പീരിയൻസ് മാത്രമേ ഉള്ളൂ"
    },
    {
      "t": "06:16",
      "text": "ക്കെ"
    },
    {
      "t": "06:18",
      "text": "ഫ്രണ്ട് എങ്ങനെ ബെസ്റ്റ്ിയാണ്"
    },
    {
      "t": "06:20",
      "text": "എസ് കെ ഒന്നും"
    },
    {
      "t": "06:22",
      "text": "ഫ്രണ്ട് പിന്നെ"
    },
    {
      "t": "06:24",
      "text": "ങ് പറ്റി പോയി"
    },
    {
      "t": "06:26",
      "text": "ഓക്കെ ഓക്കേ"
    },
    {
      "t": "06:28",
      "text": "വർക്കിനോടുത്തുള്ളതാ"
    },
    {
      "t": "06:30",
      "text": "എന്റെ മുന്നേ എ"
    },
    {
      "t": "06:32",
      "text": "പോസ്റ്റ് ചെയ്തപ്പും അറിയല്ല"
    },
    {
      "t": "06:34",
      "text": "ണ്ട് ആഹ"
    },
    {
      "t": "06:36",
      "text": "അങ്ങനെ പരിചയപ്പെട്ട"
    },
    {
      "t": "06:38",
      "text": ""
    },
    {
      "t": "06:40",
      "text": "ഓക്കെ"
    },
    {
      "t": "06:42",
      "text": "എന്നിട്ട് എങ്ങനെയാ കറക്റ്റ് എൻജോയ് ചെയ്ത്"
    },
    {
      "t": "06:44",
      "text": "എഞ്ചോ വി"
    },
    {
      "t": "06:46",
      "text": "ചെയ്തു കൊഴപ്പ ഇില്ല ഒരു"
    },
    {
      "t": "06:48",
      "text": "നാല അഞ്ച് മണിക്കൂർ ചെയ്തായിരുന്നു"
    },
    {
      "t": "06:50",
      "text": "ഉം"
    },
    {
      "t": "06:52",
      "text": "ത്ര"
    },
    {
      "t": "06:54",
      "text": "പശാങ്ങാ"
    },
    {
      "t": "06:56",
      "text": "ഒരുഓ"
    },
    {
      "t": "06:58",
      "text": "നല് ൗണ്ട് ചെയീതം"
    },
    {
      "t": "07:00",
      "text": "ആ"
    },
    {
      "t": "07:02",
      "text": "ആണോ"
    },
    {
      "t": "07:04",
      "text": "താനെ എൻജോയ് ചെയ്ത പോലെ ഓള എൻജോയ് ചെയ"
    },
    {
      "t": "07:06",
      "text": "പിന്നെ ശ"
    },
    {
      "t": "07:08",
      "text": "ാണ്െ"
    },
    {
      "t": "07:10",
      "text": ""
    },
    {
      "t": "07:12",
      "text": "എന്നാലല്ലേ സുഖമ ഉള്ളൂ"
    },
    {
      "t": "07:14",
      "text": "സർഗങ്ങ"
    },
    {
      "t": "07:16",
      "text": "ടുത്ത"
    },
    {
      "t": "07:18",
      "text": "നരകവും കാണിച്ചു കൊടുത്ത്"
    },
    {
      "t": "07:20",
      "text": ""
    },
    {
      "t": "07:22",
      "text": "ക്കെ ഓക്കെ"
    },
    {
      "t": "07:24",
      "text": "ഉം അപ്പൊ എന്താലും"
    },
    {
      "t": "07:26",
      "text": "മാരേജ് മാരേജ് കയക്കുന്നില്ല"
    },
    {
      "t": "07:28",
      "text": "അച്ചി വ"
    },
    {
      "t": "07:30",
      "text": "ടു ഇയർ ഒക്കെ കഴിഞ്ഞിട്ട് മതി അത്"
    },
    {
      "t": "07:32",
      "text": ""
    },
    {
      "t": "07:34",
      "text": "അതെത പതുക്കെിലൊക്കെ"
    },
    {
      "t": "07:36",
      "text": "അതെ അത്ക്ക"
    },
    {
      "t": "07:38",
      "text": "ഹയ മതി നിനക്ക് പെട്ടെന്ന് ലോക്കെണോ"
    },
    {
      "t": "07:40",
      "text": "ആ"
    },
    {
      "t": "07:42",
      "text": "ഇതു പറി"
    },
    {
      "t": "07:44",
      "text": ""
    },
    {
      "t": "07:46",
      "text": "അപ്പൊ ഞാൻ എന്നും വരട്ട"
    },
    {
      "t": "07:48",
      "text": "അ"
    },
    {
      "t": "07:50",
      "text": "ഉ"
    },
    {
      "t": "07:52",
      "text": "എന്നന്താ അയാൾ ഫ്രീ ആുന്ന"
    },
    {
      "t": "07:54",
      "text": "ന പ്ര"
    },
    {
      "t": "07:56",
      "text": "ഒര ഡേ നോക്കി പറഞ്ഞ അന്ന് ഫ്രീ ആവാം"
    },
    {
      "t": "07:58",
      "text": "ഉം"
    },
    {
      "t": "08:00",
      "text": "ഓക്കെ ഓക്കേ എന്നിട്ട്"
    },
    {
      "t": "08:02",
      "text": "വന്നിട്ട് ഇയാൾ ശരിക്കും സ്രഹപ്പിച്ച"
    },
    {
      "t": "08:04",
      "text": "ശ കേട്ടില്ല"
    },
    {
      "t": "08:06",
      "text": ""
    },
    {
      "t": "08:08",
      "text": "ഈ ഈ അല്ല ഇയാള് വന്നിട്ട്"
    },
    {
      "t": "08:10",
      "text": "കറക്റ്റ് ശരിക്കും സുഖിപ്പിച്ച് തരും"
    },
    {
      "t": "08:12",
      "text": "പിന്നെ സൂപ്പിച്ചു ത"
    },
    {
      "t": "08:14",
      "text": "രാവിലെോട്ട്ൈകിട്ട് ഒരു സമയമ ഇല്ല"
    },
    {
      "t": "08:16",
      "text": "അല്ലെ"
    },
    {
      "t": "08:18",
      "text": "ശർ"
    },
    {
      "t": "08:20",
      "text": "അപ്പൊ"
    },
    {
      "t": "08:22",
      "text": "നല്ല രീതിയിൽ സൂക്ഷിച്ച് തന്നിട്ട്ല്ലേ ഇടും"
    },
    {
      "t": "08:24",
      "text": ""
    },
    {
      "t": "08:26",
      "text": "അതെ അതെ അതെ ടൈമിങ്"
    },
    {
      "t": "08:28",
      "text": "ഏ"
    },
    {
      "t": "08:30",
      "text": "ആഹ ടൈം ഉണ്ട"
    },
    {
      "t": "08:32",
      "text": "എ"
    },
    {
      "t": "08:34",
      "text": "എന്തായാലും ക്ഷണിച്ചേ വീട്ടിൽ പോകൂ"
    },
    {
      "t": "08:36",
      "text": ""
    },
    {
      "t": "08:38",
      "text": "സ ടായ"
    },
    {
      "t": "08:40",
      "text": "റൗ"
    },
    {
      "t": "08:42",
      "text": ""
    },
    {
      "t": "08:44",
      "text": "ഉം ആ"
    },
    {
      "t": "08:46",
      "text": "ആഹ"
    },
    {
      "t": "08:48",
      "text": "തനിക്ക് എന്തൊക്കെയാണ് ഫാൻറസീസ്"
    },
    {
      "t": "08:50",
      "text": "ആഓർക്കെസ്്ട്ര ലനക്ക"
    },
    {
      "t": "08:52",
      "text": "എനിക്ക് ഇഷ്ടംുള്ളതോ എനിക്ക്"
    },
    {
      "t": "08:54",
      "text": "ചെയ്യാ ഇഷ്ടുള്ളത്ോ എന്നെ ചെയ്യാച്ചിട്ടുള്ളതോ"
    },
    {
      "t": "08:56",
      "text": "ഉം"
    },
    {
      "t": "08:58",
      "text": "തനിക്ക് ചെയ്യാന ഇഷ്ടമുള്ളു"
    },
    {
      "t": "09:00",
      "text": "എനിക്ക് ചെയ്യാൻ ഇഷ്ടുള്ളത്"
    },
    {
      "t": "09:02",
      "text": "എനിക്ക്ഷി"
    },
    {
      "t": "09:04",
      "text": "ിക്കനാണ് ഏറ്റവും ഇഷ്ടം"
    },
    {
      "t": "09:06",
      "text": "എന്ന"
    },
    {
      "t": "09:08",
      "text": "എനിക്ക്"
    },
    {
      "t": "09:10",
      "text": "ഉം"
    },
    {
      "t": "09:12",
      "text": "എനിക്ക് പുസി"
    },
    {
      "t": "09:14",
      "text": "രിക്കിയറണട്ടം"
    },
    {
      "t": "09:16",
      "text": "ആ"
    },
    {
      "t": "09:18",
      "text": "ആഹ ഓ"
    },
    {
      "t": "09:20",
      "text": "ലിക്ക നോദക്ക ഇഷ്ടം"
    },
    {
      "t": "09:22",
      "text": "എക്കുന്നത് ഭയങ്കര ഇഷ്ടമാണ്"
    },
    {
      "t": "09:24",
      "text": "ഉം"
    },
    {
      "t": "09:26",
      "text": "ഉം"
    },
    {
      "t": "09:28",
      "text": "നക്ക"
    },
    {
      "t": "09:30",
      "text": "ആ"
    },
    {
      "t": "09:32",
      "text": "ഞാൻ"
    },
    {
      "t": "09:34",
      "text": "അങ്ങനെ സാധനൊക്കെ കിട്ടി കഴിഞ്ഞാൽ നന്നായി"
    },
    {
      "t": "09:36",
      "text": "ക്ക് ചെയ്ത് കൊടുക്ക"
    },
    {
      "t": "09:38",
      "text": "ഉം"
    },
    {
      "t": "09:40",
      "text": "ഉ അതിനുള്ളിൽ എക്ക്"
    },
    {
      "t": "09:42",
      "text": "ിക്ക ഐറ്റംസ് ഒക്കെയും"
    },
    {
      "t": "09:44",
      "text": "എനിക്ക് നഷ്ടമാവും"
    },
    {
      "t": "09:46",
      "text": "ആവട്ടെ"
    },
    {
      "t": "09:48",
      "text": "ഉം"
    },
    {
      "t": "09:50",
      "text": "അതൊക്കെ ഇങ്ങനെ ലിക്ക് ചെയ്ത് കുടിക്കുന്നുല്ല"
    },
    {
      "t": "09:52",
      "text": ""
    },
    {
      "t": "09:54",
      "text": "ഇഷ്ടം പോലെയുണ്ട്"
    },
    {
      "t": "09:56",
      "text": "ആം"
    },
    {
      "t": "09:58",
      "text": "ഇഷ്ടംപലെയുണ്ട് ഇഷ്ടംപലെ ത"
    },
    {
      "t": "10:00",
      "text": "അത ആഹ"
    },
    {
      "t": "10:02",
      "text": "ആ അപ്പം ദാഹം തീരാൻ മാത്രം ഉണ്ട്"
    },
    {
      "t": "10:04",
      "text": "ആ ബോലെ"
    },
    {
      "t": "10:06",
      "text": "ഉം"
    },
    {
      "t": "10:08",
      "text": "ആഹ"
    },
    {
      "t": "10:10",
      "text": "അത് മതി നമുക്ക് കിട്ടിയാൽ മതി"
    },
    {
      "t": "10:12",
      "text": "അതൊക്കെ തല"
    },
    {
      "t": "10:14",
      "text": "ഉ"
    },
    {
      "t": "10:16",
      "text": "അപ്പ ഞ നിെ എങ്ങനെ കോണ്ടാക്ട് ചെയ്യ"
    },
    {
      "t": "10:18",
      "text": ""
    },
    {
      "t": "10:20",
      "text": "കോൺടാക്ട് ചെയ്യ"
    },
    {
      "t": "10:22",
      "text": "ഒരു തരം ഷെയർ ചെയ്യും"
    },
    {
      "t": "10:24",
      "text": "ഓക്കെ പറയൂ"
    },
    {
      "t": "10:26",
      "text": "ഉ"
    },
    {
      "t": "10:28",
      "text": "കെ നയൻ സി"
    },
    {
      "t": "10:30",
      "text": "ആഹ്"
    },
    {
      "t": "10:32",
      "text": "സിസ്"
    },
    {
      "t": "10:34",
      "text": "സക്സ്"
    },
    {
      "t": "10:36",
      "text": ""
    },
    {
      "t": "10:38",
      "text": "സിക്സ് റ്റ് ഫ"
    },
    {
      "t": "10:40",
      "text": "ത്രീ"
    },
    {
      "t": "10:42",
      "text": "ഉ"
