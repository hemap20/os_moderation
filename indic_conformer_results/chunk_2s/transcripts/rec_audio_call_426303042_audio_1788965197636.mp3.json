{
  "file_id": "rec_audio_call_426303042_audio_1788965197636.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 470.934,
  "processing_time_sec": 15.115760803222656,
  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": ""
    },
    {
      "t": "00:04",
      "text": ""
    },
    {
      "t": "00:06",
      "text": "ഹലോ ഹലോ"
    },
    {
      "t": "00:08",
      "text": "കേൾക്കാവോ"
    },
    {
      "t": "00:10",
      "text": "കേൾക്കാലോ എവിടന്നാണ്"
    },
    {
      "t": "00:12",
      "text": "ഇത് പാലക്കാട്"
    },
    {
      "t": "00:14",
      "text": "എവിടെ"
    },
    {
      "t": "00:16",
      "text": "ആഹ ഞാൻ വന്നിട്ട്"
    },
    {
      "t": "00:18",
      "text": "ുണ്ടല്ലോ കോഴിക്കോട്"
    },
    {
      "t": "00:20",
      "text": "എപ്പഴാ വന്നേ എന്താ പറയാന്േ"
    },
    {
      "t": "00:22",
      "text": ""
    },
    {
      "t": "00:24",
      "text": "ോ അന്ന്"
    },
    {
      "t": "00:26",
      "text": "പറയാൻ വിട്ടുപോയി ചെറിയ തിരക്കാണന്തോ"
    },
    {
      "t": "00:28",
      "text": "ഞാൻ എയർപോർട്ട"
    },
    {
      "t": "00:30",
      "text": "പിന്നെ നിങ്ങളുടെ അവിടെ"
    },
    {
      "t": "00:32",
      "text": "ബീച്ചണ്ടെല്ലാം കാപ്പാട് കാപ്പാടാ"
    },
    {
      "t": "00:34",
      "text": "ണോ അ വേറെ എന്തെങ്കാുംാണോ"
    },
    {
      "t": "00:36",
      "text": "ഉന്ന"
    },
    {
      "t": "00:38",
      "text": "അല്ല എന്താ പരിപാടി നമ്മളെന്ത്ാ ചെയ്യുന്നേ"
    },
    {
      "t": "00:40",
      "text": "ഇ ചെറുതായിട്ടൊ"
    },
    {
      "t": "00:42",
      "text": "വർക്ക് ചെയ്യ നിങ്ങളോ"
    },
    {
      "t": "00:44",
      "text": "ഉ് ചെറുതായിട്ട് എന്തായിട്ടാ വർക്ക് ചെയ്യുന്നേ"
    },
    {
      "t": "00:46",
      "text": "നിങ്ങെന്താ ചെയ്യുന്നത് പഠിക്ക"
    },
    {
      "t": "00:48",
      "text": "ർക്ക"
    },
    {
      "t": "00:50",
      "text": "ഞാൻ"
    },
    {
      "t": "00:52",
      "text": "ബിസിനസും കാര്യങ്ങളൊക്കെ ആയിട്ട് പോന്നുന്നു"
    },
    {
      "t": "00:54",
      "text": "ഓക്കെ എറെ ഏജ് എത്രന"
    },
    {
      "t": "00:56",
      "text": "എനിക്കിപ്പോ ട്വന്റി സെവൻ ആയി"
    },
    {
      "t": "00:58",
      "text": "ഓക്കെ ഞൻ"
    },
    {
      "t": "01:00",
      "text": "അും കേട്ടിട്ട് ഞാൻ പഠിക്കാൻ തോന്നിണ്ട്"
    },
    {
      "t": "01:02",
      "text": "ആ ചെറിയ ചക്കന പോലുണ്ട്"
    },
    {
      "t": "01:04",
      "text": "ആ സു"
    },
    {
      "t": "01:06",
      "text": "ത ത പ"
    },
    {
      "t": "01:08",
      "text": "ഞ്ച"
    },
    {
      "t": "01:10",
      "text": "ആ വേരല്ലേ ഓക്കേ"
    },
    {
      "t": "01:12",
      "text": "ആഹ ഓക്കെ സോറി സോറി"
    },
    {
      "t": "01:14",
      "text": "ചോ ചോദിച്ചിട്ടുണ്ടായിരുന്നില്ല അല്ലെ"
    },
    {
      "t": "01:16",
      "text": "വന്നില്ലല്ലോ"
    },
    {
      "t": "01:18",
      "text": "നിങ്ങളുടെ പേര്"
    },
    {
      "t": "01:20",
      "text": "റിയ"
    },
    {
      "t": "01:22",
      "text": "ര"
    },
    {
      "t": "01:24",
      "text": "എന്തൊക്കെയാണ്റിയ കോഴിക്കോട്"
    },
    {
      "t": "01:26",
      "text": "വിശേഷം"
    },
    {
      "t": "01:28",
      "text": "ഇ നല്ല പാങ്ങായിട്ട് പോകുന്നത്"
    },
    {
      "t": "01:30",
      "text": "ഉം അറിയാ എന്താ പരിപാടി"
    },
    {
      "t": "01:32",
      "text": "എതു"
    },
    {
      "t": "01:34",
      "text": "നീസാണ്"
    },
    {
      "t": "01:36",
      "text": "ാണോ ഓ തെ"
    },
    {
      "t": "01:38",
      "text": "ആഹഹാ അപ്പൊ എന്റെ ഏജ് ചോദിച്ചില്ലേ"
    },
    {
      "t": "01:40",
      "text": "റിയ എന്റെ ചേച്ചിയാണോ അനിയത്തിയാണോ"
    },
    {
      "t": "01:42",
      "text": "അ എ"
    },
    {
      "t": "01:44",
      "text": "ഗസിയ ഒരു ട്വന്റി ഫോർ"
    },
    {
      "t": "01:46",
      "text": "ഉം"
    },
    {
      "t": "01:48",
      "text": "താങ്ക് യു സർ"
    },
    {
      "t": "01:50",
      "text": "കറക്റ്റ് വരാ"
    },
    {
      "t": "01:52",
      "text": "ട്വന്റി ഫോർ കഴഞ്ഞ വ ട്വറി ഫോർ"
    },
    {
      "t": "01:54",
      "text": "അപ്പ"
    },
    {
      "t": "01:56",
      "text": "അപ്പൊ എന്റെ ഗ്രസ്സിങ് കറക്റ്റ് അല്ലേ"
    },
    {
      "t": "01:58",
      "text": "ആ ചട്ട"
    },
    {
      "t": "02:00",
      "text": "ിച്ചളായിട്ട് പത്ത്"
    },
    {
      "t": "02:02",
      "text": "ആ അപ്പൊ ബില"
    },
    {
      "t": "02:04",
      "text": "ബ"
    },
    {
      "t": "02:06",
      "text": "താങ്ക് യ"
    },
    {
      "t": "02:08",
      "text": "വീട്ടിലാണോ"
    },
    {
      "t": "02:10",
      "text": "വീട്ടിലാണ് നിങ്ങള എവിടെയള്ളെ"
    },
    {
      "t": "02:12",
      "text": "ഞാനും വീട്ടിലാണ് അച്ചനും അമ്മ ഇവിടി"
    },
    {
      "t": "02:14",
      "text": "ബ"
    },
    {
      "t": "02:16",
      "text": "ഈ ബാംഗ്ലൂര്"
    },
    {
      "t": "02:18",
      "text": "അല്ല ഞാൻ ബാംഗ്ൂല്ല ഞാൻ പാലക്കാട് അല്ലേ"
    },
    {
      "t": "02:20",
      "text": "ഓക്കെ അവരെന്ത പോ പോ"
    },
    {
      "t": "02:22",
      "text": "അല്ല കൂട്ട"
    },
    {
      "t": "02:24",
      "text": "പോയതല്ല അവ ചെിയ ബിസിനസും കാര്യങ്ങള"
    },
    {
      "t": "02:26",
      "text": "കൂ"
    },
    {
      "t": "02:28",
      "text": "അപ്പൊ അതിന്റെ ആവശ്യത്തിന്"
    },
    {
      "t": "02:30",
      "text": "പോയതാണ് ഇനിപ്പ നെക്സ്റ്റ് വീക്ക് തിരിച്ചു വരും"
    },
    {
      "t": "02:32",
      "text": "അപ്പൊ ആ നെക്സ്റ്റ് വീക്ക് ഒരാറ്റക്ക ആണല്ലേ"
    },
    {
      "t": "02:34",
      "text": "ആഹ നെക്സ്റ്റ് വീക്ക് ഒറ്റക്കായ"
    },
    {
      "t": "02:36",
      "text": "കൊണ്ട് എന്താ പറയുക ഇൻസ്റ്റാഗ്രാമിലെ ആഡ്"
    },
    {
      "t": "02:38",
      "text": "് കണ്ടിട്ടാണ് ഈ ഒരു ആപ്ലിക്കേഷനോട്ട്"
    },
    {
      "t": "02:40",
      "text": "വന്ന ഓ"
    },
    {
      "t": "02:42",
      "text": "ആഹ അപ്പോൊ എന്താ പറയാ"
    },
    {
      "t": "02:44",
      "text": "എട്ട് മണിക്കൊക്ക ഷോപ്പൊക്കെക്ലസ് ചെയ്ത് വീട്ട"
    },
    {
      "t": "02:46",
      "text": "വന്നു കഴിഞ്ഞൽ അറിയ പോലെയുള്ളവരോട്ം"
    },
    {
      "t": "02:48",
      "text": "സംസാരിച്ചിരിക്കുകന്ന് പറഞ്ഞാ രഹസ അല്ലേ"
    },
    {
      "t": "02:50",
      "text": "അതെ അതെ നല്ല രസമായിട്ട്"
    },
    {
      "t": "02:52",
      "text": "നല്ല"
    },
    {
      "t": "02:54",
      "text": "്പ പിള്ളവരുണ്ടെങ്കിൽ നല്ലതാണോ"
    },
    {
      "t": "02:56",
      "text": "ആഹ എന്താ പറയാം"
    },
    {
      "t": "02:58",
      "text": "ഇപ്പ ആക്ച്വല ഇപ്പോൊ എന്താ പറയാ നമ്മൾ നമ്മങ്ങനെ"
    },
    {
      "t": "03:00",
      "text": "വലിയൊരു ഏജ് ഡിഫറൻസ് ഇല്ലോ അപ്പൊ പിന്നെ"
    },
    {
      "t": "03:02",
      "text": "ന്പ"
    },
    {
      "t": "03:04",
      "text": "ആ സംസാരിക്കുമ്പോ നമുക്കരു"
    },
    {
      "t": "03:06",
      "text": "എ"
    },
    {
      "t": "03:08",
      "text": "ആ പിന്നെ"
    },
    {
      "t": "03:10",
      "text": "കേൾക്കാൻ നല്ല"
    },
    {
      "t": "03:12",
      "text": "സുന്ദരമായ ശബ്ദത്തിറെ"
    },
    {
      "t": "03:14",
      "text": "ഉടമയാണല്ലോ അപ്പൊ പിന്നെ നമക്കക്ക് ഒരു എന്ത"
    },
    {
      "t": "03:16",
      "text": "ഒരു ത്രില് ഉണ്ടാവല്ലോ"
    },
    {
      "t": "03:18",
      "text": "കൊല്ലേ ശത്തെ"
    },
    {
      "t": "03:20",
      "text": "ഞാന ഒന്ന് പങ്കി പോയിട്ടന്ന്"
    },
    {
      "t": "03:22",
      "text": "എല്ലാവരും എവിടെ വീട്ടില്െ"
    },
    {
      "t": "03:24",
      "text": "ഇ എല്ലരും ഉണ്ട"
    },
    {
      "t": "03:26",
      "text": "എങ്ങനാ"
    },
    {
      "t": "03:28",
      "text": "വീട്ടില എല്ലാരും ഉണ്ട് എല്ലും"
    },
    {
      "t": "03:30",
      "text": "േന്റെ റൂമിനാണ്"
    },
    {
      "t": "03:32",
      "text": "ഓ അതുകൊണ്ടാണല്ലോ ഇത്ര"
    },
    {
      "t": "03:34",
      "text": "ഫ്രീ ആയിട്ട് സംസാരിക്കുന്നല്ലേ"
    },
    {
      "t": "03:36",
      "text": "ഉം ഹം"
    },
    {
      "t": "03:38",
      "text": "വേറെന്താ ആക്ച്വലി ഞാനിപ്പ വ"
    },
    {
      "t": "03:40",
      "text": "വീക്ക് ആ ഒരു ആപ്ലിക്കേഷനിലട്ട് വന്നിട്ട്"
    },
    {
      "t": "03:42",
      "text": "ഓക്കെ"
    },
    {
      "t": "03:44",
      "text": "ോണൊക്കെ കണക്ഷൻ ഫ്രണ്ട്സ ഒക്കെ ആയി"
    },
    {
      "t": "03:46",
      "text": "യ് ഫ്രണ്ട്സും കാര്യങ്ങളും അങ്ങനെയല്ല"
    },
    {
      "t": "03:48",
      "text": "സത്യം പറഞ്ഞ ഞാൻ ഒരു തവണ ഇത് ഡിലീറ്റ്"
    },
    {
      "t": "03:50",
      "text": "ചെയതാണ് വീണ്ടും ഞാനിത് ഡൗൺലോഡ്"
    },
    {
      "t": "03:52",
      "text": "ല ചെയുകാണ് അ എനൊ പേടി ഉണ്ടായിരുന്നു എന്റെ നമ്പും"
    },
    {
      "t": "03:54",
      "text": "കാര്യങ്ങളക്കെ ഡിസ്ക്ലോ ആവും നമ്മ ഐഡന്റിറ്റി റി"
    },
    {
      "t": "03:56",
      "text": "യിലന്നൊക്കെ"
    },
    {
      "t": "03:58",
      "text": "അപ്പൊ പിന്നെ കൊഴപ്പില്ല"
    },
    {
      "t": "04:00",
      "text": "എന്താ പറയയാ ഒരിക്ക കണക്ട് ചെയ്ത് വീും കണക്"
    },
    {
      "t": "04:02",
      "text": "അപ്പ അത്തരം എന്താ പറയാ"
    },
    {
      "t": "04:04",
      "text": "നക്ക് എന്ത് വേ"
    },
    {
      "t": "04:06",
      "text": "എന്ത് വേണേങ്കും സംാോ കുഴപ്പമില്ലല്ലോ"
    },
    {
      "t": "04:08",
      "text": "ആന്"
    },
    {
      "t": "04:10",
      "text": "എവിടെല്ലാം സംസാരിച്ചത്"
    },
    {
      "t": "04:12",
      "text": "ഏയ് ആന്റിമാര അവ സം"
    },
    {
      "t": "04:14",
      "text": "ശരിണ്ടല്ലോ"
    },
    {
      "t": "04:16",
      "text": "ശരിയിലുണ്ടല്ലോ"
    },
    {
      "t": "04:18",
      "text": "അല്ല അങ്ങനെയല്ല"
    },
    {
      "t": "04:20",
      "text": "ആൻറ്റിമാരോടൊക്കെ നമുക്ക് സംാരിക്കും എന്താ പറയാ"
    },
    {
      "t": "04:22",
      "text": "നമ്മുടെ ഇതേ ഒരു ഏജിലുള്ളവരാ"
    },
    {
      "t": "04:24",
      "text": "സംസാരിക്കുമ്പോ നമുക്ക ഒരു രസുണ്ടാവും സംസാരിക്കും"
    },
    {
      "t": "04:26",
      "text": "അതെ അതെ ആ ശരിയ"
    },
    {
      "t": "04:28",
      "text": "വ വലിയ ശബ്ദത്തിന്ു ഉടമയോട് സംസാരിക്കും"
    },
    {
      "t": "04:30",
      "text": "നമുക്ക ത്ല്യ കട്ടത്തില്ല"
    },
    {
      "t": "04:32",
      "text": "ശരിയാ അല്ലെ"
    },
    {
      "t": "04:34",
      "text": "ആ അത കു"
    },
    {
      "t": "04:36",
      "text": "നല്ല വൈഭ ആൾക്കാര്ർ വേണം ന"
    },
    {
      "t": "04:38",
      "text": "അതെ സത്യം ആ ആയി"
    },
    {
      "t": "04:40",
      "text": "പാക്സി സത്ം പറഞ്ഞാ എന്ത പറയാ എനി എഫ് ആറും"
    },
    {
      "t": "04:42",
      "text": ""
    },
    {
      "t": "04:44",
      "text": "ഉണ്ടായിരുന്നില്ല എനിക്കരു ക്രിസ്ത്യ"
    },
    {
      "t": "04:46",
      "text": "പെൺകുട്ടിയുടെ ഒരു ഇഷ്ടം ഉണ്ടായിരുന്നു പക്ഷെ"
    },
    {
      "t": "04:48",
      "text": "അത് ഇഷ്ടം തുറന്ന് പറഞ്ഞപ്പോൾ അവര് നോ പറഞ്ഞു"
    },
    {
      "t": "04:50",
      "text": "ഓ ഓക്കെ"
    },
    {
      "t": "04:52",
      "text": "പക്ഷെ അതെന്റെ ഫാമിലിയെ ഫാമിലിയെ നന്നായിട്ട്"
    },
    {
      "t": "04:54",
      "text": "അറിയുന്നത് കൊണ്ടാവാം അല്ലെ എന്താ പറയാ"
    },
    {
      "t": "04:56",
      "text": "എന്റെ അച്ഛനേും അമ്മയും നന്നായിട്ട് അറ"
    },
    {
      "t": "04:58",
      "text": "എന്ന കൊൊണ്ടായിരിക്കും"
    },
    {
      "t": "05:00",
      "text": "പക്ഷെ അന്ന് എനിക്ക് തോന്നുന്നു ഞാൻം ബി ഒക്ക് പഠിക്കുന്നു"
    },
    {
      "t": "05:02",
      "text": "ഞാനിപ്പോ പിന്നെ എം ബി ബി എ ചെയ്തു"
    },
    {
      "t": "05:04",
      "text": "അതിനുശേഷം ഞൻ എം ബി എ കഴഞ്ഞ അതിനു ശേഷം"
    },
    {
      "t": "05:06",
      "text": "വൺ ഇയർ ഒരു അഡ്മിനി്ട്രേഷന്റെ കോഴസ് കഴഞ്ഞ ഇർ"
    },
    {
      "t": "05:08",
      "text": "ാഷൽ ബിസിനസിൽ അതിനന് ശേഷ ഞാൻ"
    },
    {
      "t": "05:10",
      "text": ""
    },
    {
      "t": "05:12",
      "text": "ആ അപ്പൊ നമ്മളിപ്പോ ബാംഗലൂർ"
    },
    {
      "t": "05:14",
      "text": "കൂടി നുക്ക് ബിസിനസ് എസ് ആറും അതുപല"
    },
    {
      "t": "05:16",
      "text": "സിറ്റി മജസ്റ്റിക് ഓപ്പം പാലക്കാടും പാലക്കാട്"
    },
    {
      "t": "05:18",
      "text": "ക്ക"
    },
    {
      "t": "05:20",
      "text": "ൾ സ്പെയർ പാ്സിന്റെ ബസിനാണ് ഫോക്കസ് ചെയ്ത്"
    },
    {
      "t": "05:22",
      "text": "രിക്കുന്നത് പ്രീമിയം കർല്ലാം"
    },
    {
      "t": "05:24",
      "text": "ഞാൻ ഒരുപാട് യാത്രക്കെ ചെയ"
    },
    {
      "t": "05:26",
      "text": "ഞാൻ കോഴിക്കോടൊക്കെ വന്നിട്ടണ്ട് ഒരുപാട്"
    },
    {
      "t": "05:28",
      "text": "ത്ത് വന്നിട്ടുണ്ട് അപ്പോ യാത്രയ്ക്ക് കൂടിയപ്പോ അമ്മ"
    },
    {
      "t": "05:30",
      "text": "അമ്മ പിടിച്ചിട്ട് എന്നെ ബിസിനസ്സിലോട്ടിട്ട്"
    },
    {
      "t": "05:32",
      "text": "ശ അതൂടെ"
    },
    {
      "t": "05:34",
      "text": "ആ കാര്യത്തിനരു തീരുമാനമായി അറിയാം"
    },
    {
      "t": "05:36",
      "text": "ഓ അപ്പൊ നെല്ലാുംറസ്ഥേ ആയി"
    },
    {
      "t": "05:38",
      "text": "എങ്ങനെയണ്ട് ലൈസ് എങ്ങനണ്ട് കേക്കട്ടെ"
    },
    {
      "t": "05:40",
      "text": "ലൈഫ് കൊഴപ്പില്ല നന്നായിട്ട് പോകുന്നു"
    },
    {
      "t": "05:42",
      "text": ""
    },
    {
      "t": "05:44",
      "text": "ഇപ്പ ആക്ച്വലി ഒരു വൺ വക്ക് സത്ം പറഞ്ഞുഴിഞ്ഞാൽ"
    },
    {
      "t": "05:46",
      "text": "എന്താ പറയാ വീട്ടിൽ ഞാൻ ഒറ്റ മകനാണ്"
    },
    {
      "t": "05:48",
      "text": "ഓ സ ബീ"
    },
    {
      "t": "05:50",
      "text": "ഇല്ല എനിക്ക് കസിൻസ് ഒരുപാട്"
    },
    {
      "t": "05:52",
      "text": "അതൊണ്ട് ആ ഒരു വിഷമന്നുംഞാൻ അനെ അറിഞ്ഞിട്ടില്ല"
    },
    {
      "t": "05:54",
      "text": "ആ ആ"
    },
    {
      "t": "05:56",
      "text": "അപ്പോൊ ഈ ഒരു വൺ വീക്ക് വീട്ടില്"
    },
    {
      "t": "05:58",
      "text": "റ്റായതുക കൊണ്ട് തന്നെ എന്താ പറയാെക്"
    },
    {
      "t": "06:00",
      "text": "കസിിന അമ്മയും വന്ന കഴിഞ്ഞാൽ ഇത് ഡ്രോപ്പ് ചെയ്യും"
    },
    {
      "t": "06:02",
      "text": "ആഓ"
    },
    {
      "t": "06:04",
      "text": "ഓ വെറുതെയിരിക്കുന്ന സമയത്ത് എന്താ പറയാം"
    },
    {
      "t": "06:06",
      "text": "നമുക്ക്ണ്ടത്തില്ല"
    },
    {
      "t": "06:08",
      "text": "ആഹ നമുക്ക് ഒരുരാഗ്രഹം ഉണ്ടാവത്തില്ലേ എന്താ"
    },
    {
      "t": "06:10",
      "text": "ഞാനൻപാട് ആഗ്രഹിച്ചിരുന്നു നമുക്ക്സ്റ്റ്"
    },
    {
      "t": "06:12",
      "text": "ഒരു പാർട്ട്ണർ ഉണ്ടായിരുന്നെങ്കിൽ നമ്മളിങ്ങനെ"
    },
    {
      "t": "06:14",
      "text": "വെറുതെ ഇരിക്കുന്ന സയനെ"
    },
    {
      "t": "06:16",
      "text": "ഫസ കയങ്ങളക്കെങ്ങനെ ഇമാജിൻ ചെയ്യൂലേ"
    },
    {
      "t": "06:18",
      "text": "ആ വെത"
    },
    {
      "t": "06:20",
      "text": "ആ വെറുതെ"
    },
    {
      "t": "06:22",
      "text": "ചിലപ്പോ നമ്മുടെ പ്രായത്തിറതാവാം"
    },
    {
      "t": "06:24",
      "text": "പില്ല എല്ലാംക്ക്"
    },
    {
      "t": "06:26",
      "text": "അപ്പ പിള്ളേര കുള്ള പ്രായം അയക്കുന്നു"
    },
    {
      "t": "06:28",
      "text": "കട്ടങ്ങ"
    },
    {
      "t": "06:30",
      "text": "കാണ് കഴിക്ക പ്രായ"
    },
    {
      "t": "06:32",
      "text": ""
    },
    {
      "t": "06:34",
      "text": "ആഹ ഞാൻ സത്യം പറഞ്ഞ"
    },
    {
      "t": "06:36",
      "text": "ഈ ഒരു വൺ വീ എന്ന് വച്ച കിാൽ ഒരുപാ മസ് ചെയ്ട്ടുണ്ട്"
    },
    {
      "t": "06:38",
      "text": "എന്ത എുംയ"
    },
    {
      "t": "06:40",
      "text": "ാത്ത ഒരു ട്രസ്്ാട്ട്"
    },
    {
      "t": "06:42",
      "text": "ണ്ടായിരുന്നെങ്കില"
    },
    {
      "t": "06:44",
      "text": "ആഹ എന്താ പറയാ നമ്മള"
    },
    {
      "t": "06:46",
      "text": "ചുമ്രിക്കുന്ന സമയത്ത് ഒരു"
    },
    {
      "t": "06:48",
      "text": "നൊക്കെ എടുത്ത് ആ"
    },
    {
      "t": "06:50",
      "text": "ഒരു ചിയസ് ഒക്കെ പറഞ്ഞഞ്"
    },
    {
      "t": "06:52",
      "text": "അ നമ്മള"
    },
    {
      "t": "06:54",
      "text": "ഇപ്പോ സിറ്റ് ഔട്ട് ഒക്കെയാണ് ഇരിക്കുന്നുണ്ടെങ്കിൽ ഒരു"
    },
    {
      "t": "06:56",
      "text": "ബാക്ക്ഗ്രൗണ്ട് കുറ സാഹിയത്തിൊക്കെ"
    },
    {
      "t": "06:58",
      "text": "പറയാണെങ്കിൽ ഒരു ബാക്ക്ഗ്രൗണ്ട്"
    },
    {
      "t": "07:00",
      "text": "ഒരു പ്രണയ ഗാനൊക്കെ വെച്ച്"
    },
    {
      "t": "07:02",
      "text": ""
    },
    {
      "t": "07:04",
      "text": "ഉം ഒട്ടായിട്ട ഹക്"
    },
    {
      "t": "07:06",
      "text": "ഇൊക്കെ ചെയ്തിട്ട് ഇത്രല്ലല്ലേ"
    },
    {
      "t": "07:08",
      "text": "പിന്നെല്ല"
    },
    {
      "t": "07:10",
      "text": "വേണമെങ്കിലും ഒരു ലപ്പിലോക്കെ കൂ"
    },
    {
      "t": "07:12",
      "text": "കുടിയവാ"
    },
    {
      "t": "07:14",
      "text": ""
    },
    {
      "t": "07:16",
      "text": ""
    },
    {
      "t": "07:18",
      "text": ""
    },
    {
      "t": "07:20",
      "text": ""
    },
    {
      "t": "07:22",
      "text": ""
    },
    {
      "t": "07:24",
      "text": "ഹലോ"
    },
    {
      "t": "07:26",
      "text": ""
    },
    {
      "t": "07:28",
      "text": "ഹലോ"
    },
    {
      "t": "07:30",
      "text": ""
    },
    {
      "t": "07:32",
      "text": "കോൾവി ഓട്ടോമാറ്റിക്കലി"
    },
    {
      "t": "07:34",
      "text": "ഇന്ദൻ"
    },
    {
      "t": "07:36",
      "text": ""
    },
    {
      "t": "07:38",
      "text": ""
    },
    {
      "t": "07:40",
      "text": ""
    },
    {
      "t": "07:42",
      "text": ""
    },
    {
      "t": "07:44",
      "text": "ഇത നാട്"
    },
    {
      "t": "07:46",
      "text": ""
    },
    {
      "t": "07:48",
      "text": ""
    },
    {
