  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "ഹലോ"
    },
    {
      "t": "00:04",
      "text": "ഹലോ ഹലോ ആ"
    },
    {
      "t": "00:06",
      "text": "ഹലോ"
    },
    {
      "t": "00:08",
      "text": "ഹലോ കേക്കാമോ"
    },
    {
      "t": "00:10",
      "text": "കക്കുമണ്ടല"
    },
    {
      "t": "00:12",
      "text": "എടെ സ്ഥല മ"
    },
    {
      "t": "00:14",
      "text": "അ"
    },
    {
      "t": "00:16",
      "text": "ഉ"
    },
    {
      "t": "00:18",
      "text": "എറണാളം"
    },
    {
      "t": "00:20",
      "text": "ഉ എന്ത്െന്നോ"
    },
    {
      "t": "00:22",
      "text": ""
    },
    {
      "t": "00:24",
      "text": "സൈഫാണ്"
    },
    {
      "t": "00:26",
      "text": "ഉ കൊല്ലത് എവിടെയാ"
    },
    {
      "t": "00:28",
      "text": ""
    },
    {
      "t": "00:30",
      "text": "ഡേറ്റൽസ് പറയാ"
    },
    {
      "t": "00:32",
      "text": "താല്പര്യ"
    },
    {
      "t": "00:34",
      "text": "ഉം"
    },
    {
      "t": "00:36",
      "text": "ജോലി ഉണ്ട"
    },
    {
      "t": "00:38",
      "text": "ഉം"
    },
    {
      "t": "00:40",
      "text": "ഹൗസ് വൈഫ് ആണോ"
    },
    {
      "t": "00:42",
      "text": "ആഹ"
    },
    {
      "t": "00:44",
      "text": "അത"
    },
    {
      "t": "00:46",
      "text": "എന്താ"
    },
    {
      "t": "00:48",
      "text": "എത്ര പയസണ്ട്"
    },
    {
      "t": "00:50",
      "text": "ക്ക ട്വന്ി ഫൈവ്"
    },
    {
      "t": "00:52",
      "text": "ഉം"
    },
    {
      "t": "00:54",
      "text": "എത്ര ഉണ്ട"
    },
    {
      "t": "00:56",
      "text": "ത്ത്"
    },
    {
      "t": "00:58",
      "text": "ഉം"
    },
    {
      "t": "01:00",
      "text": "ഇതില് കൊറായോ"
    },
    {
      "t": "01:02",
      "text": "ആ"
    },
    {
      "t": "01:04",
      "text": "മൂന്നല് മാസ ആുന്ന"
    },
    {
      "t": "01:06",
      "text": "ആരൊക്കെയ ഉണ്ടപ്പൊ"
    },
    {
      "t": "01:08",
      "text": "എന്ത്"
    },
    {
      "t": "01:10",
      "text": "വീട്ടിലാരൊക്കെയുണ്ട്"
    },
    {
      "t": "01:12",
      "text": "വീട്ടിൽപ്പം ഞാൻ തരിച്ചുള്ളൂ"
    },
    {
      "t": "01:14",
      "text": "ആ ഉ"
    },
    {
      "t": "01:16",
      "text": "ഉം"
    },
    {
      "t": "01:18",
      "text": "മരീഡാന്നല്ലേ പറഞ്ഞ"
    },
    {
      "t": "01:20",
      "text": "ഉ അതെ അതെ"
    },
    {
      "t": "01:22",
      "text": "ബസ്ലണ്ടോ"
    },
    {
      "t": "01:24",
      "text": "ഹസ്ബൻഡറ് പുറത്താണ് അബുദാബി"
    },
    {
      "t": "01:26",
      "text": "ഉം"
    },
    {
      "t": "01:28",
      "text": "ഉം"
    },
    {
      "t": "01:30",
      "text": "ഇള എന്താ പഠിച്ചതാ"
    },
    {
      "t": "01:32",
      "text": ""
    },
    {
      "t": "01:34",
      "text": "ഉ രേസണോ"
    },
    {
      "t": "01:36",
      "text": "ആ"
    },
    {
      "t": "01:38",
      "text": "എല്ല"
    },
    {
      "t": "01:40",
      "text": "ജോലിക്ക് ഒന്നും ട്രൈ ചെയ്തുല്ലേ"
    },
    {
      "t": "01:42",
      "text": "ഇല്ല ഇല്ല"
    },
    {
      "t": "01:44",
      "text": "ഉം"
    },
    {
      "t": "01:46",
      "text": "ഇത്രാണ്ല്ലേണ ക"
    },
    {
      "t": "01:48",
      "text": "എഭ"
    },
    {
      "t": "01:50",
      "text": "വൺ ഇയർ ആവുന്നതേ ഉള്ള"
    },
    {
      "t": "01:52",
      "text": "ഞാൻ ടടു ഇയർ ആയി കല്യാണം"
    },
    {
      "t": "01:54",
      "text": "ത്"
    },
    {
      "t": "01:56",
      "text": "ഉം"
    },
    {
      "t": "01:58",
      "text": "കുട്ടികളൊന്നും ഇല്ല"
    },
    {
      "t": "02:00",
      "text": "ായിട്ടില്ല"
    },
    {
      "t": "02:02",
      "text": "ആഫ"
    },
    {
      "t": "02:04",
      "text": "എചിനറ ജോലിുണ്ട്"
    },
    {
      "t": "02:06",
      "text": "വൈഫ"
    },
    {
      "t": "02:08",
      "text": "ആഹ"
    },
    {
      "t": "02:10",
      "text": "െ ഉ"
    },
    {
      "t": "02:12",
      "text": ""
    },
    {
      "t": "02:14",
      "text": "പിന്നെന്താ"
    },
    {
      "t": "02:16",
      "text": "ഉ വേറെ പ്രത്യേകിച്ച്"
    },
    {
      "t": "02:18",
      "text": "എന്താ പറയാൻ വന്നാ വൈഫ്"
    },
    {
      "t": "02:20",
      "text": "വൈഫന്"
    },
    {
      "t": "02:22",
      "text": "ോല"
    },
    {
      "t": "02:24",
      "text": "എന്താണ്"
    },
    {
      "t": "02:26",
      "text": "ബിസിന ആണ് എനിക്കരു തുണ"
    },
    {
      "t": "02:28",
      "text": "പിന്നെ"
    },
    {
      "t": "02:30",
      "text": ""
    },
    {
      "t": "02:32",
      "text": "ട്ടക്ക് വലത്ത്"
    },
    {
      "t": "02:34",
      "text": "എവിടെയാണ് എറണാകുളം തന്നെ"
    },
    {
      "t": "02:36",
      "text": "ആഹ"
    },
    {
      "t": "02:38",
      "text": "പേരെന്താ"
    },
    {
      "t": "02:40",
      "text": "നത്രന്ന് പറ"
    },
    {
      "t": "02:42",
      "text": "ആ ഓക്കെ"
    },
    {
      "t": "02:44",
      "text": "അണാമത് വന്നിട്ടുണ്ടോ"
    },
    {
      "t": "02:46",
      "text": "ആ"
    },
    {
      "t": "02:48",
      "text": "ഇടക്കൊക്കെ വരാറുണ്ട് ആണവിടെ"
    },
    {
      "t": "02:50",
      "text": ""
    },
    {
      "t": "02:52",
      "text": "എറണാകളത്തൊക്കെ വരാറുണ്ട്"
    },
    {
      "t": "02:54",
      "text": "തീരം പറയാൻ താല്പര്യമല്ലേ"
    },
    {
      "t": "02:56",
      "text": "ശരി ഏ"
    },
    {
      "t": "02:58",
      "text": "ഇല്ല ഇല്ല"
    },
    {
      "t": "03:00",
      "text": "ഏയ് ഞാന ഡേഞ്ചർ"
    },
    {
      "t": "03:02",
      "text": "ഞൻത്ര"
    },
    {
      "t": "03:04",
      "text": "ടെ കൊല്ലത്തെ എങ്ങനെ വരെ"
    },
    {
      "t": "03:06",
      "text": "പ്രോ പ്രോപ്പർ"
    },
    {
      "t": "03:08",
      "text": "എറണാകുളം തന്നെയാണോ ഷോപ്പ"
    },
    {
      "t": "03:10",
      "text": "ആ പാലാരിവട്ടം"
    },
    {
      "t": "03:12",
      "text": "ആഹ"
    },
    {
      "t": "03:14",
      "text": "ണ്ടോ"
    },
    {
      "t": "03:16",
      "text": "ആഹ അല്ല"
    },
    {
      "t": "03:18",
      "text": "ഷോപ്പ ഷോപ്പിന്റെ ഒന്നുംല്ല"
    },
    {
      "t": "03:20",
      "text": "ഞാന് മറ്റേ സ"
    },
    {
      "t": "03:22",
      "text": "ചാലൊക്കെ ചെയ്യുന്ന എനിക്ക് അത്യാവശ്യം"
    },
    {
      "t": "03:24",
      "text": "ഒരു ടെൻ കെ അബവ് ഫോളോേഴ്സ് ഒക്കെ"
    },
    {
      "t": "03:26",
      "text": "ആഹ"
    },
    {
      "t": "03:28",
      "text": "അതിന്ന് ചെറിയ"
    },
    {
      "t": "03:30",
      "text": "കളാവ്ൊക്കെ ചെയ്യാറുണ്ടോ പിന്നെ"
    },
    {
      "t": "03:32",
      "text": "ഫേസ്ബുക്ക നിന്ന് യൂടൂബ നി മോണ്ടൈസ് ആ കാ"
    },
    {
      "t": "03:34",
      "text": "ട്ടാറുണ്ട്"
    },
    {
      "t": "03:36",
      "text": "ഫേസ്ബുക്കിൽന്ന"
    },
    {
      "t": "03:38",
      "text": "ഫേസ്ബുക്ക  യൂട്യൂബ"
    },
    {
      "t": "03:40",
      "text": "കാ കിട്ടാറുണ്ട്"
    },
    {
      "t": "03:42",
      "text": "മോണിറ്റൈസ് ആയ ഒരു ചാനലൊക്കെ ഉണ്ട്"
    },
    {
      "t": "03:44",
      "text": "ആഹ"
    },
    {
      "t": "03:46",
      "text": "ഓ അൊ ഫേസ്ബുക്കിൽ നമുക്ക് എത്ര ഫോവേഴ്"
    },
    {
      "t": "03:48",
      "text": "ദിവസ ഒക്കെ ആയങ്ക അല്ലേ നുക്ക് പൈസ കിട്ടയുള്ളൂ"
    },
    {
      "t": "03:50",
      "text": "അത്രേള്ളൂ അത് ഫൈക്ക കഴിയണം പിന്നെൊരു"
    },
    {
      "t": "03:52",
      "text": "തേർി എല്ലാം കൂടെ അടിക്കണം എന"
    },
    {
      "t": "03:54",
      "text": "എ പോയിന്റ് ഫൈവ് ഉണ്ട്"
    },
    {
      "t": "03:56",
      "text": "അ നമുക്ക്ൊരു ഫൈവ് ക"
    },
    {
      "t": "03:58",
      "text": "ഫൈവ് ക ഫ"
    },
    {
      "t": "04:00",
      "text": "ഫോളോേ് ഉണ്ടെങ്കിൽ പേ്മെന്റ് കട്ട"
    },
    {
      "t": "04:02",
      "text": "അങ്ങനന്നല്ല അതിന് കൊറച്ച് കാര്യങ്ങളുണ്ട്"
    },
    {
      "t": "04:04",
      "text": "അതായത് ഇത്ര ദിവസത്തിുള്ളിൽ അങ്ങനെയൊക്കെ അതില്"
    },
    {
      "t": "04:06",
      "text": "കൊറെേ ഇത് വരുവേ സ്റ്റോറി എത്ര ഇടണം"
    },
    {
      "t": "04:08",
      "text": "അങ്ങനെയൊക്കെ കുറേ കാര്യങ്ങള് കഴിട്ട് അത്"
    },
    {
      "t": "04:10",
      "text": "ജനൻ നമ്മ"
    },
    {
      "t": "04:12",
      "text": "അവിടെ തന്നെ ഓൺ കണ്ടന്റ് ആയിരിക്കണം"
    },
    {
      "t": "04:14",
      "text": "അങ്ങെ കൊറെേ കാര്യങ്ങളണ്ട് ചുമ്മാ"
    },
    {
      "t": "04:16",
      "text": "ും കേട്ടില്ല"
    },
    {
      "t": "04:18",
      "text": "ഓ എനിക്കൊരു ടെൻ കെയിൽ കൂടുതലുണ്ട്"
    },
    {
      "t": "04:20",
      "text": "ഒളോസണ്ടാ"
    },
    {
      "t": "04:22",
      "text": "ആ ഫേസ്ബുക്കില് എന്താ"
    },
    {
      "t": "04:24",
      "text": "വൈനത്ത്"
    },
    {
      "t": "04:26",
      "text": "പ്രത്യേകിച്ചൊന്നും ഇ എന്റെ ഫോട്ടോസ്"
    },
    {
      "t": "04:28",
      "text": "വഡോസ്"
    },
    {
      "t": "04:30",
      "text": "കണ്ടൻ മോൈസേഷന ആായോ"
    },
    {
      "t": "04:32",
      "text": "ആ എനിക്ക് സംഭവങ്ങളൊന്നും"
    },
    {
      "t": "04:34",
      "text": "ട"
    },
    {
      "t": "04:36",
      "text": "പ്രഫ്യ"
    },
    {
      "t": "04:38",
      "text": "ചൂടൊക്കെ എടുക്കേണ്ടവരും ഉ"
    },
    {
      "t": "04:40",
      "text": "അതൊക്കെ എടുത്തിട്ടുണ്ട്"
    },
    {
      "t": "04:42",
      "text": "ഇപ്പം ഇ"
    },
    {
      "t": "04:44",
      "text": "കാണ കണ്ടന്റ് മോട്ടൈസേഷ ആ"
    },
    {
      "t": "04:46",
      "text": "മ ടുന്നതിനതിനെല്ലാം കാശ കിട്ടും"
    },
    {
      "t": "04:48",
      "text": "ഓ എനിക്ക"
    },
    {
      "t": "04:50",
      "text": "അതൊക്കെ ചെയ്യുന്നത് എങ്ങനെയാണെന്നുള്ളരി ഇത് അറിയത്തില്ല"
    },
    {
      "t": "04:52",
      "text": "്ോ"
    },
    {
      "t": "04:54",
      "text": "അത്യാവശ്യംസ ഒക്കെ ഉള്ള"
    },
    {
      "t": "04:56",
      "text": "ആറ്റൽന്നുംം തന്നെ ബ്ോക്ക് ചെയ്"
    },
    {
      "t": "04:58",
      "text": "ഡീറ്റെയിൽസ് ഒന്നും പറയാൻ താല്ര്യമില്ലല്ലേ"
    },
    {
      "t": "05:00",
      "text": "അല്ല"
    },
    {
      "t": "05:02",
      "text": "ഫേസ്ബുക്ക് മാത്രമ ഉള്ളൂ ഇൻസ്റ്റ"
    },
    {
      "t": "05:04",
      "text": "െ"
    },
    {
      "t": "05:06",
      "text": "പൈസൊന്നും കിട്ടത്തില്ല"
    },
    {
      "t": "05:08",
      "text": "ഫബുക്കില് കിട്ടും"
    },
    {
      "t": "05:10",
      "text": "ആ് ഇസ്റ്റ കിട്ടല്ലന്ന് അറിയാം ഇ"
    },
    {
      "t": "05:12",
      "text": "മ പിെ കുളബ് കാര്യങ്ങളൊക്കെ കിട്ടെിൽ അല്ല"
    },
    {
      "t": "05:14",
      "text": "പിന്നെ ന"
    },
    {
      "t": "05:16",
      "text": "മെസേജ ഒക്കെ കൂടുത പ്രമോഷനൊക്കെ വിളിക്ക"
    },
    {
      "t": "05:18",
      "text": "ഇൻസ്റ്റഗ്രാം വഴിയാ"
    },
    {
      "t": "05:20",
      "text": "അതാണോ"
    },
    {
      "t": "05:22",
      "text": "അതൊ എനിക്ക് യൂട്യൂബ്"
    },
    {
      "t": "05:24",
      "text": "യൂട്യൂബിനെക്കാളും കൂള് കട്ട ഫേസ്ബുക്ക്"
    },
    {
      "t": "05:26",
      "text": "ട്ട"
    },
    {
      "t": "05:28",
      "text": "ആഹ ഇൻസ്റ്റ"
    },
    {
      "t": "05:30",
      "text": "കൊളാബ്ൊക്കെ ചെയ്തിട്ടുണ്ടോഷ്ടല"
    },
    {
      "t": "05:32",
      "text": "ാണ്ട് കൊളാ്ൊക്കെ എപ്പോഴാണ് നമ്മള് കഴട്ട്"
    },
    {
      "t": "05:34",
      "text": "ഓ അപ്പൊ"
    },
    {
      "t": "05:36",
      "text": "അതൊക്കെ ചെയ്യുമ്പോൾ പേയ്മെന്റ് കിട്ടാറുണ്ടോ"
    },
    {
      "t": "05:38",
      "text": "ആ നമ്മളെപ്പരോ അതായത്"
    },
    {
      "t": "05:40",
      "text": "വിളിക്കവാന്നെങ്ക എന്താ വച്ചാ"
    },
    {
      "t": "05:42",
      "text": "ആങ്"
    },
    {
      "t": "05:44",
      "text": "മ"
    },
    {
      "t": "05:46",
      "text": "നമ്മളെപ്പോ ഒരാൾ വിളിച്ചത വെച്ച അപ്പം"
    },
    {
      "t": "05:48",
      "text": "ലൈവവിടാൻ വിളിക്കവാണെ പെർ ഡേ എന്റെ കാശ്"
    },
    {
      "t": "05:50",
      "text": "ആറായിരം രൂപയാണ്"
    },
    {
      "t": "05:52",
      "text": "അപ്പൊ അവര് ചോദ കുറച്ച് ഷോട്ടസ് കൊടുക്കാൻ"
    },
    {
      "t": "05:54",
      "text": "ഷോസ് എടുത്തിട്ട്"
    },
    {
      "t": "05:56",
      "text": "അതിന് നമ്മളൊന്നും മേടിക്കാറൊന്നുമില്ലല്ല"
    },
    {
      "t": "05:58",
      "text": "ലൈവ ഇടുന്ന  യൂട്യൂ് ലൈവ്"
    },
    {
      "t": "06:00",
      "text": ""
    },
    {
      "t": "06:02",
      "text": "പിന്നെ ലൈ വെച്ചാ അന്ന"
    },
    {
      "t": "06:04",
      "text": "തന്നെയടണണം ഇവ നോ യൂട്യൂ് ലൈവ"
    },
    {
      "t": "06:06",
      "text": "വേ ഓൺ ഗോയി അല്ലേ ലൈവ്"
    },
    {
      "t": "06:08",
      "text": "ആഹ മനസിലായിേ"
    },
    {
      "t": "06:10",
      "text": ""
    },
    {
      "t": "06:12",
      "text": "അല്ലാണ്ട് ഇപ്പൊ ഒരു എന്തെങ്കിലും"
    },
    {
      "t": "06:14",
      "text": "എ"
    },
    {
      "t": "06:16",
      "text": "ഡി എസ് ചെയ്യാനാണെ"
    },
    {
      "t": "06:18",
      "text": "ോപ്പിന്റെ ഷോപ്പിന്റെ പ്രൊോഷന ഒക്കെ ചെയ്യാറുണ്ട്"
    },
    {
      "t": "06:20",
      "text": "അത ചെറിയ ഷോർട്ട് പോലെ അങ്ങനെ"
    },
    {
      "t": "06:22",
      "text": "ചെയ്യാറുണ്ട് അതിനൊക്കെ"
    },
    {
      "t": "06:24",
      "text": "അറിയാവുന്ന ഒരാണ് ചെിയ പസ ക്യ ഇല്ലെങ്കിൽ ഒരു"
    },
    {
      "t": "06:26",
      "text": "അചച് രൂപ പതിനഞ്ച് രൂപൊക്കെ മേടിച്ചിട്ടുണ്ട്"
    },
    {
      "t": "06:28",
      "text": "പതിനഞ്ച്"
    },
    {
      "t": "06:30",
      "text": "പതിനഞ്ച് പന്ത്രണ്ടൊക്കെ മിനിമം കിട്ടും"
    },
    {
      "t": "06:32",
      "text": "നമ്മളറിയുന്നോട"
    },
    {
      "t": "06:34",
      "text": "അങ്ങനന്നും മിക്കറില്ല മൂന്ന നാ രപൊക്കാണ് മേിക്കുന്നത്"
    },
    {
      "t": "06:36",
      "text": ""
    },
    {
      "t": "06:38",
      "text": "ആഹ ഹഹ"
    },
    {
      "t": "06:40",
      "text": ""
    },
    {
      "t": "06:42",
      "text": ""
    },
    {
      "t": "06:44",
      "text": "ഇല്ല ഞാനങ്ങനെ ഇൻസ്റ്റത"
    },
    {
      "t": "06:46",
      "text": "ാൻ നോക്കുന്നുണ്ട് പക്ഷെ"
    },
    {
      "t": "06:48",
      "text": "കണ്ടിന്യൂസ് എന്തെിലുംട്ടെങ്കിൽ അല്ല ഇസ്റ്റ ഒരു"
    },
    {
      "t": "06:50",
      "text": "കണ്ടിന്ൂട കണ്ടന്"
    },
    {
      "t": "06:52",
      "text": "ആ അത"
    },
    {
      "t": "06:54",
      "text": "അതയര"
    },
    {
      "t": "06:56",
      "text": "ആകെ രണ്ട് ഫോൺ കൊണ്ട് നടക്കുന്ന അപ്പഴത്തെ"
    },
    {
      "t": "06:58",
      "text": "കിട്ടുന്ന ടമല്ലാം എഡിറ്റ് ചെയ്ത് ഇട്ടൊണ്ടിരിക്ക"
    },
    {
      "t": "07:00",
      "text": "ോ ടൈമില് എനിക്ക് അതുകൊണ്ട് ഗുണം ഉണ്ട്"
    },
    {
      "t": "07:02",
      "text": "ന"
    },
    {
      "t": "07:04",
      "text": "ഇട തോന്നുന്നു ര"
    },
    {
      "t": "07:06",
      "text": "ുള്ള ഏഴു ദിവസത്തിുള്ളിൽ അമ്പത് കേക്ക്"
    },
    {
      "t": "07:08",
      "text": "എക്സ്ട്ര ഇൻസന്റീ് പോലെ അമ്പത് ഡോർെ"
    },
    {
      "t": "07:10",
      "text": "കിട്ടും മറ്റണക്ക് അയ്യായിരം രൂപ കിട്ടും"
    },
    {
      "t": "07:12",
      "text": "അമ്പത് ഡോള ഓ അങ്ങനെയൊക്കെ ഉണ്ടില്ലേ"
    },
    {
      "t": "07:14",
      "text": "ഫേസ്ബുക്ക്ട്ടാ"
    },
    {
      "t": "07:16",
      "text": "ഫേസ്ബുക്കില ഇപ്പൊ എന്തൊക്കെയ ഇടുന്നബ"
    },
    {
      "t": "07:18",
      "text": "കണ്ടന്റൊക്കെ തന്നെ"
    },
    {
      "t": "07:20",
      "text": "എങ്ങനെ"
    },
    {
      "t": "07:22",
      "text": "ത സ്പോട്സ് ക്രിക്കറ്റ"
    },
    {
      "t": "07:24",
      "text": "ഞാസിന്റെക്രിക്കറ്റ് ചെയ്തി"
    },
    {
      "t": "07:26",
      "text": "ന്റെറിയിലൊക്കെ ഇടും ഓ"
    },
    {
      "t": "07:28",
      "text": "ഓ അതൊക്കെ കണ്ടിന്യൂസ് എടുത്ത് വെച്ച"
    },
    {
      "t": "07:30",
      "text": "ഉച്ചക്കുന്നുണ്ട് ഇടാൻൊ ഒരു കണ്ടന്റ് ഉണ്ട്"
    },
    {
      "t": "07:32",
      "text": "ണ്ട് പക്ഷെ എനിക്കങ്ങനെ"
    },
    {
      "t": "07:34",
      "text": "ഇടണം എന്നുള്ളൊരി ഇതൊക്ക ഉണ്ട് പക്ഷെനിക്ക് ഇടാന"
    },
    {
      "t": "07:36",
      "text": "കില്ലട്ടോ ഇട്ടാലോ കാശ് കട്ട"
    },
    {
      "t": "07:38",
      "text": "ത്ത പക്ഷയാ"
    },
    {
      "t": "07:40",
      "text": "അതെ"
    },
    {
      "t": "07:42",
      "text": "ക്ലിയർ ആവുന്നില്ലേ എന്താ"
    },
    {
      "t": "07:44",
      "text": "ഫോട്ടോസിനൊക്കെ കാശ കിട്ടും"
    },
    {
      "t": "07:46",
      "text": "ഫോട്ടോസിനെ എഴുതുന്നന്െല്ലാം"
    },
    {
      "t": "07:48",
      "text": "ഫോട്ടോ ഇട്ടാലും എഴുതുന്നതിനും എല്ലാം"
    },
    {
      "t": "07:50",
      "text": "കാശ കിട്ടും"
    },
    {
      "t": "07:52",
      "text": "ആഹ അതൊക്കെ എനിക്കറിയാം പക്ഷേ"
    },
    {
      "t": "07:54",
      "text": "ഇതൊക്കെ ക കണ്ടിന്യൂസ് ഇതാക്കണ്ടേ"
    },
    {
      "t": "07:56",
      "text": "ആഹ"
    },
    {
      "t": "07:58",
      "text": "എനിക്കത് അ ഇൻസ്റ്റ"
    },
    {
      "t": "08:00",
      "text": "ൻ കണ്ടിന്ൂസ് ഇ എന്റെ ഫോട്ടോസും വീ"
    },
    {
      "t": "08:02",
      "text": "ദിവസൊക്കെ ഇടാറുണ്ട്"
    },
    {
      "t": "08:04",
      "text": "അങ്ങനെ ഫോളോവേഴസ്"
    },
    {
      "t": "08:06",
      "text": "പ്രൈവറ്റ് അക്കൗണ്ട് ആായിരുന്നു അത്രയും നാള് ഇപ്പൊ ഒരു"
    },
    {
      "t": "08:08",
      "text": "മൂന്നല് മാസയിട്ടേ ഉള്ള"
    },
    {
      "t": "08:10",
      "text": "പബ്ിക്കൊക്കെ ഉണ്ടാക്കിയിട്ട്"
    },
    {
      "t": "08:12",
      "text": "ആ അത് കൂടുതൽ ഫോളോ"
    },
    {
      "t": "08:14",
      "text": "െൂെ കി"
    },
    {
      "t": "08:16",
      "text": "അന്നിന്റെ അനുസരിച്ച് നല്ലായിട്ട് കിട്ടുന്നുണ്ട്"
    },
    {
      "t": "08:18",
      "text": ""
    },
    {
      "t": "08:20",
      "text": "അപ്പൊ അത് വെച്ചിട്ട് എന്തെങ്കിലും നോക്കാ എന്നുള്ള"
    },
    {
      "t": "08:22",
      "text": "മോണൈ ആോ ഇല്ല അറിയണംാ പ്രശ്ം"
    },
    {
      "t": "08:24",
      "text": "മന"
    },
    {
      "t": "08:26",
      "text": "മറ്റ സഹായംല്ലന്ന് അറിയണം"
    },
    {
      "t": "08:28",
      "text": "അതെങ്ങനാ അറിയുന്ന ഫേസ്ബു"
    },
    {
      "t": "08:30",
      "text": "അത് തനക്ക്ങ്ങനെ പറ"
    },
    {
      "t": "08:32",
      "text": "ഇങ്ങനെ പറഞ്ഞുന്നൊന്നും മനസ്സിലാകത്തില്ല"
    },
    {
      "t": "08:34",
      "text": "അത് അതിന്റെ മറ്റേ"
    },
    {
      "t": "08:36",
      "text": "നമുക്ക് അതിന്റ ഇതൊക്കെ കാണം അതായ പ്ര"
    },
    {
      "t": "08:38",
      "text": "ഡാഷ്ബോർഡെ മോണിൈേഷൻഓ ഓപ്ഷൻ"
    },
    {
      "t": "08:40",
      "text": "പോട്ട് അ"
    },
    {
      "t": "08:42",
      "text": "അറിയണം എന്നാലേ അത് പറ്റത്തുള്ളൂ"
    },
    {
      "t": "08:44",
      "text": "ഓഹ"
    },
    {
      "t": "08:46",
      "text": "ഉം"
    },
    {
      "t": "08:48",
      "text": "ഉ അതിനകത്ത"
    },
    {
      "t": "08:50",
      "text": "ഇൻറസ്റ്റ് ഇൻട്രസ്റ്റ് ഉണ്ടോൊെ കൊടു"
    },
    {
      "t": "08:52",
      "text": "ഉ"
    },
    {
      "t": "08:54",
      "text": "ഞാാന അസഭവങ്ങളെല്ലാം ചെയ്തയാണ്"
    },
    {
      "t": "08:56",
      "text": ""
    },
    {
      "t": "08:58",
      "text": "ആളക്കെ"
    },
    {
      "t": "09:00",
      "text": "അ"
    },
    {
      "t": "09:02",
      "text": "ഞാൻ നോക്കൊന്നല്ല പിന്നെ ഇതിനെപ്പറ്റി"
    },
    {
      "t": "09:04",
      "text": "നമുക്കറിയാത്ത കൊണ്ട് അങ്ങെ ശ്രദ്ധിക്കുന്ന നോ"
    },
    {
      "t": "09:06",
      "text": "അായിരിക്കും"
    },
    {
      "t": "09:08",
      "text": "ഞാൻ പറ"
    },
    {
      "t": "09:10",
      "text": "ല്ലോ ന"
    },
    {
      "t": "09:12",
      "text": "ശ കിട്ടുന്ന ഒരു പരിപാടിയാ"
    },
    {
      "t": "09:14",
      "text": "അതാ അങ്ങനെ എന്തെങ്കിലും നോ"
    },
    {
      "t": "09:16",
      "text": "ഓക്കെങ്ക പറ്റ"
    },
    {
      "t": "09:18",
      "text": "ബംഗ"
    },
    {
      "t": "09:20",
      "text": "അതാണ്"
    },
    {
      "t": "09:22",
      "text": "എന്താ"
    },
    {
      "t": "09:24",
      "text": ""
    },
    {
      "t": "09:26",
      "text": ""
    },
    {
      "t": "09:28",
      "text": "അല്ല നോക്കുന്നുണ്ട്"
    },
    {
      "t": "09:30",
      "text": "ഞാൻ വിചാരിക്കുന്നത്"
    },
    {
      "t": "09:32",
      "text": "അതറാത്തത കൊണ്ട് ഞാൻ വിാരിക്കുന്നു ഇസ്റ്റാവഴി"
    },
    {
      "t": "09:34",
      "text": "ബീച്ചില് വ്യൂസ് റീച്ച ആയി കഴിഞ്ഞാൽ"
    },
    {
      "t": "09:36",
      "text": "കൊളാപ്പറേഷന്റെ ഏതെങ്കിലും കിട്ടുമല്ലോ"
    },
    {
      "t": "09:38",
      "text": "എന്നുള്ളരി ഇതാണ് ഞാൻ ഉദ്ദേശിക്കുന്നത്"
    },
