{
  "file_id": "rec_audio_call_426151853_audio_1788951260489.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 816.171,
  "processing_time_sec": 35.62565088272095,
  "segments": [
    {
      "t": "00:00",
      "text": "హరి"
    },
    {
      "t": "00:02",
      "text": ""
    },
    {
      "t": "00:04",
      "text": "హలో"
    },
    {
      "t": "00:06",
      "text": "హలో హా ఏక్కనించి"
    },
    {
      "t": "00:08",
      "text": "క"
    },
    {
      "t": "00:10",
      "text": "ఇలు విజవానించి"
    },
    {
      "t": "00:12",
      "text": ""
    },
    {
      "t": "00:14",
      "text": "విజయవాడ విజయవాడ"
    },
    {
      "t": "00:16",
      "text": "రా"
    },
    {
      "t": "00:18",
      "text": ""
    },
    {
      "t": "00:20",
      "text": "హ"
    },
    {
      "t": "00:22",
      "text": "ఏం చేస్తలేదు"
    },
    {
      "t": "00:24",
      "text": "హస్లోన్"
    },
    {
      "t": "00:26",
      "text": "ంట బర త అడేదిష ఉత"
    },
    {
      "t": "00:28",
      "text": "ఎను బటే"
    },
    {
      "t": "00:30",
      "text": "వాడరు చూస"
    },
    {
      "t": "00:32",
      "text": ""
    },
    {
      "t": "00:34",
      "text": "నివాస నాకను పేచన"
    },
    {
      "t": "00:36",
      "text": "కడిద అన్నా"
    },
    {
      "t": "00:38",
      "text": "ఆ"
    },
    {
      "t": "00:40",
      "text": "వాజనా క"
    },
    {
      "t": "00:42",
      "text": "ఇప్పుడుట్లత్తలే"
    },
    {
      "t": "00:44",
      "text": "న వయసు నాకిలిపడ"
    },
    {
      "t": "00:46",
      "text": ""
    },
    {
      "t": "00:48",
      "text": ""
    },
    {
      "t": "00:50",
      "text": "అనిపిస్తుందా"
    },
    {
      "t": "00:52",
      "text": "సప్పుడు అనిపిస్తుంది సూపర్ అనిపిస్తుంది"
    },
    {
      "t": "00:54",
      "text": "ఎస్తంట బట"
    },
    {
      "t": "00:56",
      "text": "చతున్నాస్"
    },
    {
      "t": "00:58",
      "text": "బీటెక్ చదువుతున్నాను కసే"
    },
    {
      "t": "01:00",
      "text": "సరదాగా వృతంలో మాట్లాడతాంని"
    },
    {
      "t": "01:02",
      "text": "అచ్చేనా"
    },
    {
      "t": "01:04",
      "text": "ఎ అ"
    },
    {
      "t": "01:06",
      "text": "ఇ అర అంద కడ్ ఉంట కద"
    },
    {
      "t": "01:08",
      "text": "అ లేర హోస్టల్"
    },
    {
      "t": "01:10",
      "text": "ఉన్నాను కదా వాళ్ళు ఇప్పుడు వస్తారు"
    },
    {
      "t": "01:12",
      "text": "అ"
    },
    {
      "t": "01:14",
      "text": "ఒక్కదాన్నే ఉన్నాను కదా హష"
    },
    {
      "t": "01:16",
      "text": "లో అందుకని అనస"
    },
    {
      "t": "01:18",
      "text": "స్ింగా ఉన్నాను కాలేజ కకి వెళ్ళిపోయినా పోయా"
    },
    {
      "t": "01:20",
      "text": "అపించింది నిద్ర"
    },
    {
      "t": "01:22",
      "text": "పట్టదు అట్టే ఇటి తిరిగి అను"
    },
    {
      "t": "01:24",
      "text": "నిద్ర పడతలేదు ఏవేవో"
    },
    {
      "t": "01:26",
      "text": "ఆలోచనలు స"
    },
    {
      "t": "01:28",
      "text": "ఇ"
    },
    {
      "t": "01:30",
      "text": "చద్దా అనుకొని చూస్తండి"
    },
    {
      "t": "01:32",
      "text": "తప్పు వచ్చింది వెంటనే ఇంకా"
    },
    {
      "t": "01:34",
      "text": "మాట్లాడాను ఆఫ్టర్నూన్ నుంచి"
    },
    {
      "t": "01:36",
      "text": "ఎట్లోనే కాల్స్"
    },
    {
      "t": "01:38",
      "text": "అందా"
    },
    {
      "t": "01:40",
      "text": "తెలన్ వల్ అక్వర కోరు వాళ"
    },
    {
      "t": "01:42",
      "text": "అంద్ర పల్ నంద వస్త"
    },
    {
      "t": "01:44",
      "text": ""
    },
    {
      "t": "01:46",
      "text": "అ అదక్ వస్తస్తాక"
    },
    {
      "t": "01:48",
      "text": "ఏ"
    },
    {
      "t": "01:50",
      "text": "వాళ్ాలకే బా వెళ్ళాలంట"
    },
    {
      "t": "01:52",
      "text": "ద కద"
    },
    {
      "t": "01:54",
      "text": "కావాలనిపిించకద"
    },
    {
      "t": "01:56",
      "text": "అదే ఇక్వల్ కుర్రగా"
    },
    {
      "t": "01:58",
      "text": "అ కొంచెం పెల్లవాక ఇప్పు"
    },
    {
      "t": "02:00",
      "text": "చాలా ఫ్రీగా మాట్లాడొచ్చు వీళ్ళు ఏంటో నాకు"
    },
    {
      "t": "02:02",
      "text": "ఏజ్ ఎక్కువైపోయినట్టుగా"
    },
    {
      "t": "02:04",
      "text": "అనే అని ఫీలింగ్ వచ్చేస్తుందిం"
    },
    {
      "t": "02:06",
      "text": "ఇంకాకటేస్తున్నాను"
    },
    {
      "t": "02:08",
      "text": ""
    },
    {
      "t": "02:10",
      "text": "ఏ మడ తల బా"
    },
    {
      "t": "02:12",
      "text": "చదువుకో ఎందుకు వచ్చి యాప్లు అంటున్నారు"
    },
    {
      "t": "02:14",
      "text": "అంతే కడ ఎందుకు"
    },
    {
      "t": "02:16",
      "text": "చ్చ అ టైలు"
    },
    {
      "t": "02:18",
      "text": "బాయ్ ఫ్రెం ఒక ఒకప్పుడు"
    },
    {
      "t": "02:20",
      "text": "ఇండడు పిలేడు"
    },
    {
      "t": "02:22",
      "text": "ఏ అప్పుడప్పుదు అప్పుడేంద"
    },
    {
      "t": "02:24",
      "text": "అవును"
    },
    {
      "t": "02:26",
      "text": "అంటే నా నా"
    },
    {
      "t": "02:28",
      "text": "సూపర్ సేన్ారు నేను ఫస్ట్ డేలా త"
    },
    {
      "t": "02:30",
      "text": "ఫర్రు ఇంకా"
    },
    {
      "t": "02:32",
      "text": "ఆ ప్రపోర్ట్ చేశాడు"
    },
    {
      "t": "02:34",
      "text": "నేనమ్మ చాలా రోజులుస్త"
    },
    {
      "t": "02:36",
      "text": "ఎస్ అని చెప్పలా ఎస్ అని చెప్పాను"
    },
    {
      "t": "02:38",
      "text": "ఆ తర్వాత ఇంకా బాగా"
    },
    {
      "t": "02:40",
      "text": "బాగా ఎంజాయ్ చేసావుంట"
    },
    {
      "t": "02:42",
      "text": "అట ఒక ప్రత్యసయి"
    },
    {
      "t": "02:44",
      "text": "అప్పుడ ఎలా ఉంటాడు వాడికి తె జాబ్ వచ్చాక"
    },
    {
      "t": "02:46",
      "text": "మరి ఎకువ పయింద వ సైకుతాను"
    },
    {
      "t": "02:48",
      "text": "బాష అవుతాడు కంప"
    },
    {
      "t": "02:50",
      "text": "బస్సు లో వచ్చింది బెంగళూరు లో"
    },
    {
      "t": "02:52",
      "text": "ఉంటాడుప్పుడు"
    },
    {
      "t": "02:54",
      "text": "ఇంకా కొట్టేస్తున్నాడు కొట్టే"
    },
    {
      "t": "02:56",
      "text": "చేయడానికి కూడా వచ్చేస్తున్నాడన్న భయ వేసి"
    },
    {
      "t": "02:58",
      "text": "ఇంకా నేను వాళ్ళ మమ్మీ చెప్పా"
    },
    {
      "t": "03:00",
      "text": "ప్పను ఇల్ ఎలా అనా కొద్దు"
    },
    {
      "t": "03:02",
      "text": "మాలాడి ఉప్పుకోరు మీకెస్"
    },
    {
      "t": "03:04",
      "text": "మా కాష్ట పేరు అ"
    },
    {
      "t": "03:06",
      "text": "చెప్తే అవునా"
    },
    {
      "t": "03:08",
      "text": "అలా ఏమండదు"
    },
    {
      "t": "03:10",
      "text": "కల్షియం ఉంది బాగుంటా నువ్వు"
    },
    {
      "t": "03:12",
      "text": "ఉండమ్మా బాగుంటావు అంటాను"
    },
    {
      "t": "03:14",
      "text": "వద్దాండి బాగా కొడతార"
    },
    {
      "t": "03:16",
      "text": "అడు నన్ను అని చెప్పే అంతే"
    },
    {
      "t": "03:18",
      "text": "మర పన్న పో ఆయ"
    },
    {
      "t": "03:20",
      "text": "సొంతోం చేస"
    },
    {
      "t": "03:22",
      "text": "రేపు ఇంకొకని చేసుకుని"
    },
    {
      "t": "03:24",
      "text": "ఉండగలుగుతవా"
    },
    {
      "t": "03:26",
      "text": "ఆ ఉండగలుగుతాను ఎందుక"
    },
    {
      "t": "03:28",
      "text": "ఎకంటే వాడు చేసింది సెక్స్ వాడే"
    },
    {
      "t": "03:30",
      "text": "హ్యాపీగా ఫీల్ అయ్యాడు నేనేం హ్యాపీ"
    },
    {
      "t": "03:32",
      "text": "పే ఫీలామనేతే"
    },
    {
      "t": "03:34",
      "text": "అ"
    },
    {
      "t": "03:36",
      "text": "అఓతేే"
    },
    {
      "t": "03:38",
      "text": "కొరికేడాలు గిచ్చేడాలు"
    },
    {
      "t": "03:40",
      "text": "ఇవన్నీ సైకు"
    },
    {
      "t": "03:42",
      "text": "గడ చేసాయి"
    },
    {
      "t": "03:44",
      "text": "వాడాకంది చ"
    },
    {
      "t": "03:46",
      "text": "వస్తు అస నేను చూడకుండానే చూసిస్తాను"
    },
    {
      "t": "03:48",
      "text": "ంటాడు ఎందుకెళ నేను"
    },
    {
      "t": "03:50",
      "text": "నేను హాస్టల్ల్లో ఉంటాను బయటికిెళ్ళ"
    },
    {
      "t": "03:52",
      "text": "తెచ్చుకోవాలి కదా నాకు"
    },
    {
      "t": "03:54",
      "text": "నిమ సోఫ్ అన్న తెచ్చు"
    },
    {
      "t": "03:56",
      "text": "ఎవరి తెస్తారు నాకు"
    },
    {
      "t": "03:58",
      "text": "ఎందుకు పోయిట్ కంటడా"
    },
    {
      "t": "04:00",
      "text": "సార్లు చూస్తాడు ఇన్స్టాగ్రామ్ అన్న"
    },
    {
      "t": "04:02",
      "text": "చెకింగ్ చేయడం నాకు చాలా కోపం"
    },
    {
      "t": "04:04",
      "text": "అక"
    },
    {
      "t": "04:06",
      "text": "లేద మ రాత"
    },
    {
      "t": "04:08",
      "text": "ఇంకెవరితోన్నా రిలేషన్ పెట్టుకోలేదా"
    },
    {
      "t": "04:10",
      "text": "అస్సలు పెట్టుకోలేదు"
    },
    {
      "t": "04:12",
      "text": "నెస్ట్ ఏంటి మరి"
    },
    {
      "t": "04:14",
      "text": "నెస్ట్"
    },
    {
      "t": "04:16",
      "text": "మంచిగా జాబ్ సంపాదించి ఒకటి"
    },
    {
      "t": "04:18",
      "text": "చూ చేసేసి తర్వాత"
    },
    {
      "t": "04:20",
      "text": "మా అమ్మ నా చెప్పేమని తెళ్లి చేసుకొని"
    },
    {
      "t": "04:22",
      "text": "ఉన్నాడవ"
    },
    {
      "t": "04:24",
      "text": "మరిప్పు ఎసంజస"
    },
    {
      "t": "04:26",
      "text": "గ ఉకి ఏం కోరుకల రాట్లే"
    },
    {
      "t": "04:28",
      "text": "అళ్ చేసుకోవాల"
    },
    {
      "t": "04:30",
      "text": "వస్తాను అందుకే గ్యాప్ లో వచ్చ"
    },
    {
      "t": "04:32",
      "text": "చ్చింద"
    },
    {
      "t": "04:34",
      "text": "కొ"
    },
    {
      "t": "04:36",
      "text": "వాడు నాకె"
    },
    {
      "t": "04:38",
      "text": "అయిపోతే నా కామ్ అప్పుడప్పుడు సెక్స్"
    },
    {
      "t": "04:40",
      "text": "చేయాలి అట్లాంత ముందు ఏం లేదు"
    },
    {
      "t": "04:42",
      "text": "సక్సస్ చేయాలిని ఇంట్ర ఎవ మాట్లా"
    },
    {
      "t": "04:44",
      "text": "అడితే బాగుంటందిని ఇంక వస్తున్నా"
    },
    {
      "t": "04:46",
      "text": "ఈ"
    },
    {
      "t": "04:48",
      "text": "మావులుగా అంతరి"
    },
    {
      "t": "04:50",
      "text": "రిలేషన్ లో ఉన్న వాళ్ళు ఎవరికైనా వస్తుది కదా"
    },
    {
      "t": "04:52",
      "text": "వస్తు"
    },
    {
      "t": "04:54",
      "text": "ఆ ఏం చేస్తాం అది"
    },
    {
      "t": "04:56",
      "text": "హార్మోన్స్ ప్రాబ్ల"
    },
    {
      "t": "04:58",
      "text": "మర ప్రస్తు"
    },
    {
      "t": "05:00",
      "text": "స్తు"
    },
    {
      "t": "05:02",
      "text": "ఏం చేస్తున్నాను దుడు"
    },
    {
      "t": "05:04",
      "text": "పెట్టుకొని పడుకుంటా లేకపోతే"
    },
    {
      "t": "05:06",
      "text": "ఫింగరింగ్ చేసుకుంటాను"
    },
    {
      "t": "05:08",
      "text": "రవలనే పెట్"
    },
    {
      "t": "05:10",
      "text": "కొదిక"
    },
    {
      "t": "05:12",
      "text": "ఎందుకు అమ్మా అప్పుడకే పడ్డాారు"
    },
    {
      "t": "05:14",
      "text": "కా నష్టాలు చాలు అ"
    },
    {
      "t": "05:16",
      "text": "పెట్టుకను బాబా"
    },
    {
      "t": "05:18",
      "text": "ఏమ బాగుంటారు అంల్ని పెట్టుకుంటేక్కడ ఉండదు"
    },
    {
      "t": "05:20",
      "text": "కదా ఎప్పుడ"
    },
    {
      "t": "05:22",
      "text": "నా"
    },
    {
      "t": "05:24",
      "text": "ఫైవ్"
    },
    {
      "t": "05:26",
      "text": "ఎజో"
    },
    {
      "t": "05:28",
      "text": "అచ్చ అచ్చా"
    },
    {
      "t": "05:30",
      "text": "త"
    },
    {
      "t": "05:32",
      "text": "వద్దు"
    },
    {
      "t": "05:34",
      "text": "కనీ వయి"
    },
    {
      "t": "05:36",
      "text": "అాలా లేదప్ప అంకుల్లా లేదు"
    },
    {
      "t": "05:38",
      "text": "మనిషిని కూడా అలా ఉండాలలే"
    },
    {
      "t": "05:40",
      "text": "అవును"
    },
    {
      "t": "05:42",
      "text": "స"
    },
    {
      "t": "05:44",
      "text": "అందే అది ని"
    },
    {
      "t": "05:46",
      "text": "వయసు ఎలా ఉందంటే"
    },
    {
      "t": "05:48",
      "text": "వయసు ఎలా"
    },
    {
      "t": "05:50",
      "text": "ఉందంటే ట్వంటీ సిక్స్"
    },
    {
      "t": "05:52",
      "text": "ట్వంట సెవెనా"
    },
    {
      "t": "05:54",
      "text": "అ"
    },
    {
      "t": "05:56",
      "text": "చవ సి"
    },
    {
      "t": "05:58",
      "text": "ఎక్స్ట్ ఎయిర్ెల్ త పెట్టుకుని అనుకో మళ్ళ రా"
    },
    {
      "t": "06:00",
      "text": "యాల అనిపిస్తుంది ఇదతే ార్ట్ అండ్ టెంపరీ"
    },
    {
      "t": "06:02",
      "text": "ఆ"
    },
    {
      "t": "06:04",
      "text": "వు కానీ తన నండడి మొదల్"
    },
    {
      "t": "06:06",
      "text": ""
    },
    {
      "t": "06:08",
      "text": "వదలలేదు నేనే"
    },
    {
      "t": "06:10",
      "text": ""
    },
    {
      "t": "06:12",
      "text": "బ్లాక్ లిస్ట్ లో పెట్టేారు"
    },
    {
      "t": "06:14",
      "text": "అ"
    },
    {
      "t": "06:16",
      "text": "అ రాలే నను మళ కమ్ట్టావ"
    },
    {
      "t": "06:18",
      "text": "ఇంకా వాడుదు చెచ్చిన కమిటావం"
    },
    {
      "t": "06:20",
      "text": "ఉపనా"
    },
    {
      "t": "06:22",
      "text": "కమ్టేనా మాలండలతో కమ్మిటయి"
    },
    {
      "t": "06:24",
      "text": "సట్"
    },
    {
      "t": "06:26",
      "text": "షార్ట్ లాగా వదిలేసుకోవి అంతే ఎందు"
    },
    {
      "t": "06:28",
      "text": "నాంగ్రెన్స్"
    },
    {
      "t": "06:30",
      "text": "ఆ"
    },
    {
      "t": "06:32",
      "text": "ఇ మ్యరజ"
    },
    {
      "t": "06:34",
      "text": "అయితే అంది"
    },
    {
      "t": "06:36",
      "text": "అరిే"
    },
    {
      "t": "06:38",
      "text": "మీ వైఫ్ ఉన్నారా"
    },
    {
      "t": "06:40",
      "text": "ఉన్నాన్ భయటన్నా"
    },
    {
      "t": "06:42",
      "text": "ఓకే పలాను"
    },
    {
      "t": "06:44",
      "text": "ఒక బాబు"
    },
    {
      "t": "06:46",
      "text": "ఓకే"
    },
    {
      "t": "06:48",
      "text": "ఏం చేసుకుంటారు మీరు"
    },
    {
      "t": "06:50",
      "text": "్రాఫటి స్థం పగజ"
    },
    {
      "t": "06:52",
      "text": "ఓకే"
    },
    {
      "t": "06:54",
      "text": "మీద ఇక్కడ"
    },
    {
      "t": "06:56",
      "text": "విజయవాడన పాపు"
    },
    {
      "t": "06:58",
      "text": "అది అమాపుర అంటడి ఇప్పు"
    },
    {
      "t": "07:00",
      "text": "అందు అప్పురంతా కరట"
    },
    {
      "t": "07:02",
      "text": "అన్నా పర్వాల తెలుస్తున్నారు"
    },
    {
      "t": "07:04",
      "text": "అ కొ"
    },
    {
      "t": "07:06",
      "text": "కొత్త పెళ్ళండి"
    },
    {
      "t": "07:08",
      "text": "పక్కన"
    },
    {
      "t": "07:10",
      "text": "ఓకే"
    },
    {
      "t": "07:12",
      "text": "అ"
    },
    {
      "t": "07:14",
      "text": "స్టడిజ పస జ"
    },
    {
      "t": "07:16",
      "text": ""
    },
    {
      "t": "07:18",
      "text": "కడిపోం"
    },
    {
      "t": "07:20",
      "text": "ఎవడ వచ్చి కోేకు"
    },
    {
      "t": "07:22",
      "text": "చేస"
    },
    {
      "t": "07:24",
      "text": "చెయాలి ఏజ్లో చేయాల్సిన ఏ్"
    },
    {
      "t": "07:26",
      "text": ""
    },
    {
      "t": "07:28",
      "text": "అ జయప్పుడు ఇప్పుడుయ"
    },
    {
      "t": "07:30",
      "text": "త"
    },
    {
      "t": "07:32",
      "text": "అే కదా ఆ తర్వాత మనమే"
    },
    {
      "t": "07:34",
      "text": "మ నారాయ"
    },
    {
      "t": "07:36",
      "text": "ఎంే చేసాడు ఆడ పెళ్ళి చేసుకుంటాడు"
    },
    {
      "t": "07:38",
      "text": "అంతే నపేళ్ళ చేసుకుంటా"
    },
    {
      "t": "07:40",
      "text": "ఎవరిన్న పళ్ళ చేసుకున్నాడు కూడా ఇంతకు ముందుేయారు"
    },
    {
      "t": "07:42",
      "text": "ఉండొచ్చు కా ఈ రోజు లే్యాపర్ ఎవరు"
    },
    {
      "t": "07:44",
      "text": "అందర కొంద"
    },
    {
      "t": "07:46",
      "text": "డినే చంగా మా కాలజలాంద"
    },
    {
      "t": "07:48",
      "text": ""
    },
    {
      "t": "07:50",
      "text": "ఇకా మంతకిద"
    },
    {
      "t": "07:52",
      "text": "ఇంకో విషయం చెబతాం హెు పడి"
    },
    {
      "t": "07:54",
      "text": "బస్ార్స్ కూడా ఎఫైర్ ఉంది"
    },
    {
      "t": "07:56",
      "text": ""
    },
    {
      "t": "07:58",
      "text": "హెచ్చు పడి ఉంటాడు కదా"
    },
    {
      "t": "08:00",
      "text": "మా మ్యాడమ్స్ తో కూడా ఎఫ"
    },
    {
      "t": "08:02",
      "text": "పెట్టుకుంటాడు హెచ్రి బాగుంటాడు"
    },
    {
      "t": "08:04",
      "text": "కా మనం కా"
    },
    {
      "t": "08:06",
      "text": "అయితే అయితే వస"
    },
    {
      "t": "08:08",
      "text": "అ"
    },
    {
      "t": "08:10",
      "text": "ఇంకా"
    },
    {
      "t": "08:12",
      "text": "ఇంట మరి"
    },
    {
      "t": "08:14",
      "text": "స"
    },
    {
      "t": "08:16",
      "text": "నతే"
    },
    {
      "t": "08:18",
      "text": "సజని"
    },
    {
      "t": "08:20",
      "text": "స"
    },
    {
      "t": "08:22",
      "text": "ఉ"
    },
    {
      "t": "08:24",
      "text": "ఇంకా"
    },
    {
      "t": "08:26",
      "text": "చెప్పంండి హైదరాబాద్"
    },
    {
      "t": "08:28",
      "text": "వస్తుంటావు మరి"
    },
    {
      "t": "08:30",
      "text": "చాల సార్ మా రిలేషన్స్"
    },
    {
      "t": "08:32",
      "text": "ల్నాడు అక్కడ"
    },
    {
      "t": "08:34",
      "text": "హైటెక్ హైటెక్ సట్"
    },
    {
      "t": "08:36",
      "text": "ా"
    },
    {
      "t": "08:38",
      "text": "కుక్కట్ పెళ్ళ కూడా ఉన్నారు"
    },
    {
      "t": "08:40",
      "text": "హ"
    },
    {
      "t": "08:42",
      "text": "ఇష్టము ఉంట"
    },
    {
      "t": "08:44",
      "text": "ఓకే"
    },
    {
      "t": "08:46",
      "text": "అంకాే"
    },
    {
      "t": "08:48",
      "text": "సప్మర్"
    },
    {
      "t": "08:50",
      "text": ""
    },
    {
      "t": "08:52",
      "text": "మీది ప్రాపర్ హటబదనా"
    },
    {
      "t": "08:54",
      "text": "కాదు విజవాడ"
    },
    {
      "t": "08:56",
      "text": "ఏలో"
    },
    {
      "t": "08:58",
      "text": "శవాల ఇదుద"
    },
    {
      "t": "09:00",
      "text": "ఎదా ఎలు"
    },
    {
      "t": "09:02",
      "text": "ఆ"
    },
    {
      "t": "09:04",
      "text": "అంటే ననుడాప్పు"
    },
    {
      "t": "09:06",
      "text": "ఉంటది అప్పుడు ఏ రెండు బస్"
    },
    {
      "t": "09:08",
      "text": "ఉంట కొత్త బ"
    },
    {
      "t": "09:10",
      "text": "అంటారు పాద పష్టాల"
    },
    {
      "t": "09:12",
      "text": "ప్ప బస్ స్టాండ్ారు"
    },
    {
      "t": "09:14",
      "text": "అ"
    },
    {
      "t": "09:16",
      "text": "నమ్ ఫ్రెండ్ది ఏూరే అది"
    },
    {
      "t": "09:18",
      "text": "అదేంటి ఆర్ఆర్ పేట అండి"
    },
    {
      "t": "09:20",
      "text": "తననుసారి తనంట తీసుకెళ్దు"
    },
    {
      "t": "09:22",
      "text": "అందుకని ఎల్లూరు ఎక్కడ"
    },
    {
      "t": "09:24",
      "text": "అదే అక్కడ నరు"
    },
    {
      "t": "09:26",
      "text": ""
    },
    {
      "t": "09:28",
      "text": "అదే చూసాను ఎలరు కొంచం"
    },
    {
      "t": "09:30",
      "text": "అంత పాటు వెళ్ళి చూసాను"
    },
    {
      "t": "09:32",
      "text": "అ"
    },
    {
      "t": "09:34",
      "text": "కా"
    },
    {
      "t": "09:36",
      "text": ""
    },
    {
      "t": "09:38",
      "text": "చెప్ప అన్న మేర"
    },
    {
      "t": "09:40",
      "text": "అ"
    },
    {
      "t": "09:42",
      "text": ""
    },
    {
      "t": "09:44",
      "text": ""
    },
    {
      "t": "09:46",
      "text": "ఫ్యామిలీ మీతోనే ఉంటందా ఎలాలో ఉంటారా"
    },
    {
      "t": "09:48",
      "text": "అ నాతనంట"
    },
    {
      "t": "09:50",
      "text": "ఓకే"
    },
    {
      "t": "09:52",
      "text": "అ"
    },
    {
      "t": "09:54",
      "text": "చేస్త అయితే"
    },
    {
      "t": "09:56",
      "text": "అందే చేస్తాం"
    },
    {
      "t": "09:58",
      "text": "అ"
    },
    {
      "t": "10:00",
      "text": "ఎలా వ తా మరి"
    },
    {
      "t": "10:02",
      "text": "వారసలే బాగుందా"
    },
    {
      "t": "10:04",
      "text": "అంత బాగుంది"
    },
    {
      "t": "10:06",
      "text": "మీ వైక ఎనీ వస్త"
    },
    {
      "t": "10:08",
      "text": "హౌస్ వైఫ్"
    },
    {
      "t": "10:10",
      "text": "ఓకే"
    },
    {
      "t": "10:12",
      "text": "రెంట రెం హౌస్"
    },
    {
      "t": "10:14",
      "text": "జనాక్కడ"
    },
    {
      "t": "10:16",
      "text": "రెంటడ్"
    },
    {
      "t": "10:18",
      "text": "అరే ఒను"
    },
    {
      "t": "10:20",
      "text": "చూసుకునేసుకోండి నేను చెప్ప"
    },
    {
      "t": "10:22",
      "text": "సంద"
    },
    {
      "t": "10:24",
      "text": "మేర ఎక్కడు"
    },
    {
      "t": "10:26",
      "text": "కల్ నగర్"
    },
    {
      "t": "10:28",
      "text": "ఓకే"
    },
    {
      "t": "10:30",
      "text": ""
    },
    {
      "t": "10:32",
      "text": ""
    },
    {
      "t": "10:34",
      "text": "మకేంటండి"
    },
    {
      "t": "10:36",
      "text": "అ చెప్పాల మీద"
    },
    {
      "t": "10:38",
      "text": "మీరే చెప్పాలి మరి ఇంకే"
    },
    {
      "t": "10:40",
      "text": ""
    },
    {
      "t": "10:42",
      "text": ""
    },
    {
      "t": "10:44",
      "text": "ఎే వస్ నాటకమయతే"
    },
    {
      "t": "10:46",
      "text": "ఎంజ జులర అడి"
    },
    {
      "t": "10:48",
      "text": "అంత ఎంజ"
    },
    {
      "t": "10:50",
      "text": "అంత తెవలేద"
    },
    {
      "t": "10:52",
      "text": "బ"
    },
    {
      "t": "10:54",
      "text": "ఆడస్"
    },
    {
      "t": "10:56",
      "text": "భారతదేశాంలో"
    },
    {
      "t": "10:58",
      "text": "ఇప్పుడు వచ్చే ఒక"
    },
    {
      "t": "11:00",
