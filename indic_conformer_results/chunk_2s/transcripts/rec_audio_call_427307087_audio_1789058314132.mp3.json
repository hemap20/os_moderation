    {
      "t": "01:48",
      "text": ""
    },
    {
      "t": "01:50",
      "text": "న్నాడా ఏమనా"
    },
    {
      "t": "01:52",
      "text": "ప చేవా గర్ల్ఫ్రెండ్స్తో"
    },
    {
      "t": "01:54",
      "text": "ఏం కోడసలేదు ఏం చేయలేదు"
    },
    {
      "t": "01:56",
      "text": "దండి మీదిరుకు"
