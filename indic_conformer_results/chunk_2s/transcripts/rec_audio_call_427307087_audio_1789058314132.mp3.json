    {
      "t": "00:52",
      "text": "పైజ"
    },
    {
      "t": "00:54",
      "text": "మాది బట్ హైదరాబాద్ లో ఉంటా"
    },
    {
      "t": "00:56",
      "text": "అవునా"
    },
    {
      "t": "00:58",
      "text": "ఈ ఎక్కడి నుంచో చెప్"
    },
    {
      "t": "01:00",
      "text": "పుచ్చు కద్దా"
    },
    {
      "t": "01:02",
      "text": "చెప్పనండి"
    },
    {
      "t": "01:04",
      "text": "అ రెడ్డిసా"
    },
    {
      "t": "01:06",
      "text": "ఆ"
    },
    {
      "t": "01:08",
      "text": "అ ఏం లే"
    },
    {
      "t": "01:10",
      "text": "కడప మారడ సంగ"
