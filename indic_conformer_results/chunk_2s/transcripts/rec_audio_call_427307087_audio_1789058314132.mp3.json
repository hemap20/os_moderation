    {
      "t": "00:20",
      "text": "ఇమంట"
    },
    {
      "t": "00:22",
      "text": "ఊహ అంటారు ఏంటండి బ"
    },
    {
      "t": "00:24",
      "text": "జప్పం"
    },
    {
      "t": "00:26",
      "text": "ఆ తూ"
    },
    {
