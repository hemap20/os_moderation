      "text": "ఆ అదింట"
    },
    {
      "t": "00:30",
      "text": "కాలేదా మరడ్"
    },
    {
      "t": "00:32",
      "text": "కాలేదండి"
    },
    {
      "t": "00:34",
      "text": "మరి అంటే"
    },
    {
      "t": "00:36",
      "text": "అంటారు మళ్ళీ లేదంటారు"
    },
    {
      "t": "00:38",
      "text": "ఉ అన్న"
    },
    {
      "t": "00:40",
      "text": "ఉ మన"
    },
    {
      "t": "00:42",
      "text": "అన్నారు మళ ఉహ అన్నారు"
    },
    {
      "t": "00:44",
      "text": "ఎక్కనండి ఊడిని"
    },
    {
      "t": "00:46",
      "text": "త బబ ఇన్నిగే అ"
    },
    {
      "t": "00:48",
      "text": "లేదన్నాఊన్నా"
    },
    {
      "t": "00:50",
      "text": "సరే లేకుండాండి"
