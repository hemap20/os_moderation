      "t": "18:22",
      "text": "உ"
    },
    {
      "t": "18:24",
      "text": ""
    },
    {
      "t": "18:26",
      "text": "ஆஹ்"
    },
    {
      "t": "18:28",
      "text": "ஒற்ற நோன்றியா"
    },
    {
      "t": "18:30",
      "text": "உஹம் உஹ"
    },
    {
      "t": "18:32",
      "text": "சொ"
    },
    {
      "t": "18:34",
      "text": "க்குிறே"
    },
    {
      "t": "18:36",
      "text": "உம்"
    },
    {
      "t": "18:38",
      "text": "சக்கிறியா"
    },
    {
      "t": "18:40",
      "text": "உம்ஹ"
    },
    {
      "t": "18:42",
      "text": "ந என்ன சொந்த"
    },
    {
      "t": "18:44",
      "text": "என்னா"
    },
    {
      "t": "18:46",
      "text": ""
    },
    {
      "t": "18:48",
      "text": ""
    },
    {
      "t": "18:50",
      "text": ""
    },
    {
      "t": "18:52",
      "text": "சொல்லுடி என்ன பண்றன்"
    },
    {
      "t": "18:54",
      "text": "ஆஹ"
    },
    {
      "t": "18:56",
      "text": "ஆம்"
    },
    {
      "t": "18:58",
      "text": "உஹம்ஹ"
    },
    {
