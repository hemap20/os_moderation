      "t": "19:28",
      "text": ""
    },
    {
      "t": "19:30",
      "text": "எப்போ பந்திரச"
    },
    {
      "t": "19:32",
      "text": "அப்போ அது வரைக்கும் செய்ய வேண்டியதுதான்"
    },
    {
      "t": "19:34",
      "text": "உஹம்"
    },
    {
      "t": "19:36",
      "text": "ம்"
    },
    {
      "t": "19:38",
      "text": "உங்களுக்கு என்ன ஆசை எது மாதிரி பண்ணணும்"
    },
    {
      "t": "19:40",
