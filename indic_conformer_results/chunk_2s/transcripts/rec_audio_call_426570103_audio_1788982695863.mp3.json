  "segments": [
    {
      "t": "00:00",
      "text": "ஹலோ"
    },
    {
      "t": "00:02",
      "text": "ஹலோ"
    },
    {
      "t": "00:04",
      "text": "ஹலோ"
    },
    {
      "t": "00:06",
      "text": ""
    },
    {
      "t": "00:08",
      "text": "ஆஹ் எந்த ஊர்ல நீங்க"
    },
    {
      "t": "00:10",
      "text": ""
    },
    {
      "t": "00:12",
      "text": "பிரச்சனை இல்லை நீங்க"
    },
    {
      "t": "00:14",
      "text": "அச்சா நீ"
    },
    {
      "t": "00:16",
      "text": "ம்"
    },
    {
      "t": "00:18",
      "text": "நரிட்ட"
    },
    {
      "t": "00:20",
      "text": "க"
    },
    {
      "t": "00:22",
      "text": "மாறிட்டா"
    },
    {
      "t": "00:24",
      "text": "பன் மேரடுங்க"
    },
    {
      "t": "00:26",
      "text": "ஆமா"
    },
    {
      "t": "00:28",
      "text": "நான் மேரி"
    },
    {
      "t": "00:30",
      "text": ""
    },
    {
      "t": "00:32",
      "text": "ஆஹ்"
    },
    {
      "t": "00:34",
      "text": "என்ன ஹஸ் வைஃப் ஆ இரு"
    },
    {
      "t": "00:36",
      "text": "அல்ல"
    },
    {
      "t": "00:38",
      "text": "ஆ் சரி"
    },
    {
      "t": "00:40",
      "text": "பக்க"
    },
    {
      "t": "00:42",
      "text": "ஏன் என்ன பொறுமைய பொரிய"
    },
    {
      "t": "00:44",
      "text": "பேச்ச"
    },
    {
      "t": "00:46",
      "text": "ஆ"
    },
    {
      "t": "00:48",
      "text": ""
    },
    {
      "t": "00:50",
      "text": "இல்லைங்க நான் பேசுறது"
    },
    {
      "t": "00:52",
      "text": "உங்களுக்கு லேட்டா கேள்து நிற"
    },
    {
      "t": "00:54",
      "text": ""
    },
    {
      "t": "00:56",
      "text": "உம் ஆமா"
    },
    {
      "t": "00:58",
      "text": "அதான்"
    },
    {
      "t": "01:00",
      "text": "டபுல்டபுராா சொல்றன்"
    },
    {
      "t": "01:02",
      "text": "ச"
    },
    {
      "t": "01:04",
      "text": "ஆஹ ஆஹ"
    },
    {
      "t": "01:06",
      "text": ""
    },
    {
      "t": "01:08",
      "text": ""
    },
    {
      "t": "01:10",
      "text": "சொல்லுங்க"
    },
    {
      "t": "01:12",
      "text": "என்ன சொல்லலும்"
    },
    {
      "t": "01:14",
      "text": ""
    },
    {
      "t": "01:16",
      "text": "எதன சொ"
    },
    {
      "t": "01:18",
      "text": "என்னன்னா சொல்லமாா"
    },
    {
      "t": "01:20",
      "text": ""
    },
    {
      "t": "01:22",
      "text": "உம்"
    },
    {
      "t": "01:24",
      "text": "என் நவா"
    },
    {
      "t": "01:26",
      "text": "நன சொல்ல"
    },
    {
      "t": "01:28",
      "text": "உண்மையா"
    },
    {
      "t": "01:30",
      "text": ""
    },
    {
      "t": "01:32",
      "text": "எப்படி இருக்கு"
    },
    {
      "t": "01:34",
      "text": ""
    },
    {
      "t": "01:36",
      "text": "ஆ"
    },
    {
      "t": "01:38",
      "text": ""
    },
    {
      "t": "01:40",
      "text": ""
    },
    {
      "t": "01:42",
      "text": "ஹலோ"
    },
    {
      "t": "01:44",
      "text": "உம்"
    },
    {
      "t": "01:46",
      "text": ""
    },
    {
      "t": "01:48",
      "text": "மாறாதான் இருப்பேன்"
    },
    {
      "t": "01:50",
      "text": ""
    },
    {
      "t": "01:52",
      "text": ""
    },
    {
      "t": "01:54",
      "text": "உம்"
    },
    {
      "t": "01:56",
      "text": ""
    },
    {
      "t": "01:58",
      "text": "அப்புறம் சுமார் அப்பீன்னா"
    },
    {
      "t": "02:00",
      "text": "எப்படிய சொல்றது"
    },
    {
      "t": "02:02",
      "text": "எப்படி சொல்லணும் சொல்லி தாங்க"
    },
    {
      "t": "02:04",
      "text": "ஆஹ"
    },
    {
      "t": "02:06",
      "text": ""
    },
    {
      "t": "02:08",
      "text": "ந"
    },
    {
      "t": "02:10",
      "text": "சொல்லுமா ஆமா"
    },
    {
      "t": "02:12",
      "text": "ஆஹ்"
    },
    {
      "t": "02:14",
      "text": ""
    },
    {
      "t": "02:16",
      "text": ""
    },
    {
      "t": "02:18",
      "text": "ரி"
    },
    {
      "t": "02:20",
      "text": "நீங்க இதுல எப்படி பேசுவீங்கப்ப என்ன"
    },
    {
      "t": "02:22",
      "text": "பேசுா எப்படி"
    },
    {
      "t": "02:24",
      "text": "வேணாலும் பேசுவேன்"
    },
    {
      "t": "02:26",
      "text": "உம்"
    },
    {
      "t": "02:28",
      "text": "ச நல்லா இருக்கீங்களா நல"
    },
    {
      "t": "02:30",
      "text": "ஹம்"
    },
    {
      "t": "02:32",
      "text": ""
    },
    {
      "t": "02:34",
      "text": "ரொ நாளா இருக்கீங்களா இந்தந்த ஆத்துல"
    },
    {
      "t": "02:36",
      "text": "உம் ஆமா"
    },
    {
      "t": "02:38",
      "text": ""
    },
    {
      "t": "02:40",
      "text": "உம்"
    },
    {
      "t": "02:42",
      "text": "கடைசியா எப்போ செக்ஸ் பண்ணுங்க"
    },
    {
      "t": "02:44",
      "text": "ரசியா"
    },
    {
      "t": "02:46",
      "text": "ஆஹ"
    },
    {
      "t": "02:48",
      "text": "போன வாரத்துல"
    },
    {
      "t": "02:50",
      "text": ""
    },
    {
      "t": "02:52",
      "text": "ஒரு வாரம் ஆச்சா"
    },
    {
      "t": "02:54",
      "text": "ஆ"
    },
    {
      "t": "02:56",
      "text": "என் ப்ச ம"
    },
    {
      "t": "02:58",
      "text": "இல்லையா"
    },
    {
      "t": "03:00",
      "text": "ஹஸ்பண்ட் இல்லைங்க"
    },
    {
      "t": "03:02",
      "text": "உம்"
    },
    {
      "t": "03:04",
      "text": "வீி ஒன்"
    },
    {
      "t": "03:06",
      "text": "உம்"
    },
    {
      "t": "03:08",
      "text": "ம்ம் இயர்ல ஒன் டைம்"
    },
    {
      "t": "03:10",
      "text": "உம்"
    },
    {
      "t": "03:12",
      "text": "இயர்லி ஒன் டைம்"
    },
    {
      "t": "03:14",
      "text": "ஏ"
    },
    {
      "t": "03:16",
      "text": "ப இருக்கா"
    },
    {
      "t": "03:18",
      "text": ""
    },
    {
      "t": "03:20",
      "text": "ம்"
    },
    {
      "t": "03:22",
      "text": ""
    },
    {
      "t": "03:24",
      "text": "எத்தனை வருஷமா ஒர்க் பண்றது உங்க"
    },
    {
      "t": "03:26",
      "text": "அ"
    },
    {
      "t": "03:28",
      "text": "மூணு வருஷமா இருக்காரு"
    },
    {
      "t": "03:30",
      "text": ""
    },
    {
      "t": "03:32",
      "text": "சல டைமல"
    },
    {
      "t": "03:34",
      "text": "மூடு வந்தா என்ன பண்ணிரு"
    },
    {
      "t": "03:36",
      "text": "ந்தத்துல வருவம்"
    },
    {
      "t": "03:38",
      "text": "உம்"
    },
    {
      "t": "03:40",
      "text": "ந"
    },
    {
      "t": "03:42",
      "text": "அப்படி இல்லைன்னா"
    },
    {
      "t": "03:44",
      "text": "கேனா புடிச்ச விந்துச்சுன்னா"
    },
    {
      "t": "03:46",
      "text": "சும்மா"
    },
    {
      "t": "03:48",
      "text": "கீழே மட்டும் வா வைக்க"
    },
    {
      "t": "03:50",
      "text": "சொல்லம்"
    },
    {
      "t": "03:52",
      "text": ""
    },
    {
      "t": "03:54",
      "text": ""
    },
    {
      "t": "03:56",
      "text": ""
    },
    {
      "t": "03:58",
      "text": "எடி நேர்ல வந்தா இ போன்லே தானா"
    },
    {
      "t": "04:00",
      "text": "உ இருக்கல"
    },
    {
      "t": "04:02",
      "text": "நவ"
    },
    {
      "t": "04:04",
      "text": "என்"
    },
    {
      "t": "04:06",
      "text": "தெரிஞ்ச ஒரு பையன் இருக்கும் பண்ணி கொடுப்போான்"
    },
    {
      "t": "04:08",
      "text": ""
    },
    {
      "t": "04:10",
      "text": ""
    },
    {
      "t": "04:12",
      "text": "எப்படின்னா சொன்"
    },
    {
      "t": "04:14",
      "text": "சனக்கக்கச்ச"
    },
    {
      "t": "04:16",
      "text": "உம் ஆமா நல்லா"
    },
    {
      "t": "04:18",
      "text": "ஹ அக்கி சொல்லுவான்"
    },
    {
      "t": "04:20",
      "text": "உ"
    },
    {
      "t": "04:22",
      "text": ""
    },
    {
      "t": "04:24",
      "text": "உம்"
    },
    {
      "t": "04:26",
      "text": ""
    },
    {
      "t": "04:28",
      "text": "நல்லா நடக்குவானா"
    },
    {
      "t": "04:30",
      "text": "ஆமா நக்க"
    },
    {
      "t": "04:32",
      "text": "அ"
    },
    {
      "t": "04:34",
      "text": ""
    },
    {
      "t": "04:36",
      "text": "அக்க"
    },
    {
      "t": "04:38",
      "text": "எ இந்த"
    },
    {
      "t": "04:40",
      "text": "உம்"
    },
    {
      "t": "04:42",
      "text": "பருப்புல்லாம் போ"
    },
    {
      "t": "04:44",
      "text": "சப்பு சப்புன்னு சாப்பி இருப்போான்"
    },
    {
      "t": "04:46",
      "text": ""
    },
    {
      "t": "04:48",
      "text": ""
    },
    {
      "t": "04:50",
      "text": "வீட்டு பக்கத்துே இருக்கறங்க"
    },
    {
      "t": "04:52",
      "text": "க"
    },
    {
      "t": "04:54",
      "text": "ஆமா"
    },
    {
      "t": "04:56",
      "text": ""
    },
    {
      "t": "04:58",
      "text": "அஸ்்பண்ட் இலார சலலை"
    },
    {
      "t": "05:00",
      "text": ""
    },
    {
      "t": "05:02",
      "text": "ஆமா இல்லாத அப்ப மட்டும்"
    },
    {
      "t": "05:04",
      "text": "உம்"
    },
    {
      "t": "05:06",
      "text": ""
    },
    {
      "t": "05:08",
      "text": "எப்படி கஷ்டம்"
    },
    {
      "t": "05:10",
      "text": "க எப்படி பண்ணா"
    },
    {
      "t": "05:12",
      "text": "எரி எப்பது சொல்ல"
    },
    {
      "t": "05:14",
      "text": "அமா"
    },
    {
      "t": "05:16",
      "text": "எங்க வீட்டு மாடி எங்க வீட்டு மாடில்ல"
    },
    {
      "t": "05:18",
      "text": "நான் இரு அவங்க விட்ட ம"
    },
    {
      "t": "05:20",
      "text": "வர பா்பப்போம்"
    },
    {
      "t": "05:22",
      "text": "ம்"
    },
    {
      "t": "05:24",
      "text": "அ"
    },
    {
      "t": "05:26",
      "text": "மாடி வந்து பாத்தீங்கன்னா"
    },
    {
      "t": "05:28",
      "text": "அப்படி ஜம்ப் பண்ணி வர மாதிரிதான் இருக்கும்"
    },
    {
      "t": "05:30",
      "text": ""
    },
    {
      "t": "05:32",
      "text": "ரொம்ப டிஸ்டன்ஸ்லாம் இல்"
    },
    {
      "t": "05:34",
      "text": ""
    },
    {
      "t": "05:36",
      "text": "அப்ப நைட்ல"
    },
    {
      "t": "05:38",
      "text": "ந எீ"
    },
    {
      "t": "05:40",
      "text": "ந பேசிருந்தன் போன் பேச"
    },
    {
      "t": "05:42",
      "text": "மாடியில போனே"
    },
    {
      "t": "05:44",
      "text": "அப்போ"
    },
    {
      "t": "05:46",
      "text": "பேசிட்டம்ந்தான்"
    },
    {
      "t": "05:48",
      "text": "உம்"
    },
    {
      "t": "05:50",
      "text": "ஆ எவிட்டுக்குக்கட்டுக்க"
    },
    {
      "t": "05:52",
      "text": "அதுவா பேசந்தா"
    },
    {
      "t": "05:54",
      "text": "உம்"
    },
    {
      "t": "05:56",
      "text": "ஆஹ் வர்கக்குதுனக்க"
    },
    {
      "t": "05:58",
      "text": "ஒனிக்கல"
    },
    {
      "t": "06:00",
      "text": "தன"
    },
    {
      "t": "06:02",
      "text": "அவன் எல்லாம் பேசுமே இருக்குமாோ திடீ"
    },
    {
      "t": "06:04",
      "text": "உம்"
    },
    {
      "t": "06:06",
      "text": "உம்"
    },
    {
      "t": "06:08",
      "text": "அப்ப சொன சரி"
    },
    {
      "t": "06:10",
      "text": ""
    },
    {
      "t": "06:12",
      "text": "அவ வந்துஸ எப்படி உங்ககிட்ட"
    },
    {
      "t": "06:14",
      "text": "கேட்டலாம்"
    },
    {
      "t": "06:16",
      "text": "ஆஹ் கேக்கல"
    },
    {
      "t": "06:18",
      "text": "உம் ஆ"
    },
    {
      "t": "06:20",
      "text": "கொஞ்சம் மளையெல்லாம் காமிச்சு கொடுத்தேன்"
    },
    {
      "t": "06:22",
      "text": "உம்"
    },
    {
      "t": "06:24",
      "text": ""
    },
    {
      "t": "06:26",
      "text": "ஆ நல்லா பாப்பான்"
    },
    {
      "t": "06:28",
      "text": "உம்"
    },
    {
      "t": "06:30",
      "text": ""
    },
    {
      "t": "06:32",
      "text": "ஹ"
    },
    {
      "t": "06:34",
      "text": "உ"
    },
    {
      "t": "06:36",
      "text": ""
    },
    {
      "t": "06:38",
      "text": "புரிய"
    },
    {
      "t": "06:40",
      "text": "நல்லா இருக்கும் நான் பாத்துுட்டே இருப்பேன்"
    },
    {
      "t": "06:42",
      "text": "உஹம்"
    },
    {
      "t": "06:44",
      "text": "அப்ப என்ன பப்பி கேட்டா ஏன்"
    },
    {
      "t": "06:46",
      "text": "ன அப்படி பாக்குற அப்படின்னுா"
    },
    {
      "t": "06:48",
      "text": "உம்"
    },
    {
      "t": "06:50",
      "text": "பத்த நும்ம்பல்ல"
    },
    {
      "t": "06:52",
      "text": "இந்த மாதிரி பண்ணணும் அப்படின்னா"
    },
    {
      "t": "06:54",
      "text": "கேட்டு"
    },
    {
      "t": "06:56",
      "text": "ம்ஓகே"
    },
    {
      "t": "06:58",
      "text": "மாடி மாறி"
    },
    {
      "t": "07:00",
      "text": "வச்ச"
    },
    {
      "t": "07:02",
      "text": "நை ம் தான்"
    },
    {
      "t": "07:04",
      "text": ""
    },
    {
      "t": "07:06",
      "text": "அமை கில"
    },
    {
      "t": "07:08",
      "text": "ந சரி"
    },
    {
      "t": "07:10",
      "text": "சாரி கட்டீங்களா"
    },
    {
      "t": "07:12",
      "text": "ஆங்க"
    },
    {
      "t": "07:14",
      "text": "அப்படி வந்து"
    },
    {
      "t": "07:16",
      "text": "ஆான் என்னமே"
    },
    {
      "t": "07:18",
      "text": "ான் அவன் அப்படி கீழ என் கால"
    },
    {
      "t": "07:20",
      "text": "பிரடிச்சுட்டு நக்கினாம"
    },
    {
      "t": "07:22",
      "text": ""
    },
    {
      "t": "07:24",
      "text": ""
    },
    {
      "t": "07:26",
      "text": "சரி"
    },
    {
      "t": "07:28",
      "text": "உம்"
    },
    {
      "t": "07:30",
      "text": ""
    },
    {
      "t": "07:32",
      "text": ""
    },
    {
      "t": "07:34",
      "text": ""
    },
    {
      "t": "07:36",
      "text": "என்ஜாய் பண்றீங்க கூடா"
    },
    {
      "t": "07:38",
      "text": "உஹம் உஹம்"
    },
    {
      "t": "07:40",
      "text": "ஆமா"
    },
    {
      "t": "07:42",
      "text": ""
    },
    {
      "t": "07:44",
      "text": "ஆமா புரியல"
    },
    {
      "t": "07:46",
      "text": "ஆமாடா"
    },
    {
      "t": "07:48",
      "text": ""
    },
    {
      "t": "07:50",
      "text": "ஏது பண்ணது இல்லையா"
    },
    {
      "t": "07:52",
      "text": ""
    },
    {
      "t": "07:54",
      "text": "ஆமல்லா பண்ணும்"
    },
    {
      "t": "07:56",
      "text": "தேங்க்ஸ் கொடுத்தா நும் பண்ணுவேன்"
    },
    {
      "t": "07:58",
      "text": "ஆஹ"
    },
    {
      "t": "08:00",
      "text": ""
    },
    {
      "t": "08:02",
      "text": ""
    },
    {
      "t": "08:04",
      "text": ""
    },
    {
      "t": "08:06",
      "text": "நீங்க எ போதும் போதும் சா"
    },
    {
      "t": "08:08",
      "text": "க்க பண்ணலாம்"
    },
    {
      "t": "08:10",
      "text": "ஆஹ் அப்பும்"
    },
    {
      "t": "08:12",
      "text": "சொல்ல மாட்டோங்க"
    },
    {
      "t": "08:14",
      "text": ""
    },
    {
      "t": "08:16",
      "text": "ஆ எடிக்குவே மாட்ட"
    },
    {
      "t": "08:18",
      "text": "எனனக்க"
    },
    {
      "t": "08:20",
      "text": "அத்து நேர்க்கணும்"
    },
    {
      "t": "08:22",
      "text": "உம்"
    },
    {
      "t": "08:24",
      "text": "அஹ் கூடி கிழஞ்ச"
    },
    {
      "t": "08:26",
      "text": "ஒக்கண"
    },
    {
      "t": "08:28",
      "text": "உம்"
    },
    {
      "t": "08:30",
      "text": "உஹம் ஓக தே"
    },
    {
      "t": "08:32",
      "text": "ஆமா"
    },
    {
      "t": "08:34",
      "text": ""
    },
    {
      "t": "08:36",
      "text": ""
    },
    {
      "t": "08:38",
      "text": ""
    },
    {
      "t": "08:40",
      "text": "உம்"
    },
    {
      "t": "08:42",
      "text": "எப்படினான் உ"
    },
    {
      "t": "08:44",
      "text": "ம்"
    },
    {
      "t": "08:46",
      "text": "எப்படில்லாம் உங்க வைக்கணும்"
    },
    {
      "t": "08:48",
      "text": "நீ"
    },
    {
      "t": "08:50",
      "text": "போக்குறல எப்படி ஒருத்தான"
    },
    {
      "t": "08:52",
      "text": "கோப்ரேட் பண்ண"
    },
    {
      "t": "08:54",
      "text": ""
    },
    {
      "t": "08:56",
      "text": "ூக்கி வி"
    },
    {
      "t": "08:58",
      "text": "ச்சடிக்க"
    },
    {
      "t": "09:00",
      "text": "எஷக் பண்ணம்"
    },
    {
      "t": "09:02",
      "text": "ம் சரி"
    },
    {
      "t": "09:04",
      "text": ""
    },
    {
      "t": "09:06",
      "text": "நக்கல மடிச்ச நால துக்கி"
    },
    {
      "t": "09:08",
      "text": "சொன்னித்து கூ சொல்ல"
    },
    {
      "t": "09:10",
      "text": "உம்"
    },
    {
      "t": "09:12",
      "text": ""
    },
    {
      "t": "09:14",
      "text": "ஆ"
    },
    {
      "t": "09:16",
      "text": "உ"
    },
    {
      "t": "09:18",
      "text": "ஆமா வெரி"
    },
    {
      "t": "09:20",
      "text": "திருச்ச போல"
    },
    {
      "t": "09:22",
      "text": "ஆ"
    },
    {
      "t": "09:24",
      "text": ""
    },
    {
      "t": "09:26",
      "text": "உ"
    },
    {
      "t": "09:28",
      "text": "ப்பண்ண சொல்ல"
    },
    {
      "t": "09:30",
      "text": "இ"
    },
    {
      "t": "09:32",
      "text": "உ மேல ரெண்டு பசை"
    },
    {
      "t": "09:34",
      "text": "நல்லா பால் படி"
    },
    {
      "t": "09:36",
      "text": "சப்ப ச"
    },
    {
      "t": "09:38",
      "text": "ப"
    },
    {
      "t": "09:40",
      "text": "எனக்கு முப்ப"
    },
    {
      "t": "09:42",
      "text": "ட்டு ச"
    },
    {
      "t": "09:44",
      "text": "புரியல"
    },
    {
      "t": "09:46",
      "text": "இப்பத்தெட்ட"
    },
    {
      "t": "09:48",
      "text": "நல்ல சைஸ் தா"
    },
    {
      "t": "09:50",
      "text": "நல்லா பால் பிடிக்கிறாங்க"
    },
    {
      "t": "09:52",
      "text": "மாய பத்த"
    },
    {
      "t": "09:54",
      "text": "உ"
    },
    {
      "t": "09:56",
      "text": "புரியல வாய பந்தாத"
    },
    {
      "t": "09:58",
      "text": "உஹம்"
    },
    {
      "t": "10:00",
      "text": "அ பத்த"
    },
    {
      "t": "10:02",
      "text": ""
    },
    {
      "t": "10:04",
      "text": "உடிச்சரைக்கும் உள்ள தல்ல வேண்டும்"
    },
    {
      "t": "10:06",
      "text": ""
    },
    {
      "t": "10:08",
      "text": ""
    },
    {
      "t": "10:10",
      "text": "அா"
    },
    {
      "t": "10:12",
      "text": "காசக்கு பால தச்ச"
    },
    {
      "t": "10:14",
      "text": "உம்"
    },
    {
      "t": "10:16",
      "text": "அப்படியே புரியவேன் கழ வந்து"
    },
    {
      "t": "10:18",
      "text": "உம்"
    },
    {
      "t": "10:20",
      "text": "பாய் வெடுச்சு"
    },
    {
      "t": "10:22",
      "text": "துக்க நாக்க"
    },
    {
      "t": "10:24",
      "text": "நம்பம்பி எதுக்கும்"
    },
    {
      "t": "10:26",
      "text": "உஹம் உம்"
    },
    {
      "t": "10:28",
      "text": "அ ச"
    },
    {
      "t": "10:30",
      "text": "ஏ"
    },
    {
      "t": "10:32",
      "text": "உக்குனச சொ"
    },
    {
      "t": "10:34",
      "text": "ல"
    },
    {
      "t": "10:36",
      "text": ""
    },
    {
      "t": "10:38",
      "text": "சொன்னா"
    },
    {
      "t": "10:40",
      "text": "என்"
    },
    {
      "t": "10:42",
      "text": "வச"
    },
    {
      "t": "10:44",
      "text": ""
    },
    {
      "t": "10:46",
      "text": "தே்த்த"
    },
    {
      "t": "10:48",
      "text": "உம்"
    },
    {
      "t": "10:50",
      "text": "ஏ அக்க வச"
    },
    {
      "t": "10:52",
      "text": "உஹம்"
    },
    {
      "t": "10:54",
      "text": "சொன்னி எப்படி இருக்கும்"
    },
    {
      "t": "10:56",
      "text": "ச்சக்கு"
    },
    {
      "t": "10:58",
      "text": "புலா"
    },
    {
      "t": "11:00",
      "text": "ப ச"
    },
    {
      "t": "11:02",
      "text": "ஏனும் அடிப்படின்னு சொல்லிக்க"
    },
    {
      "t": "11:04",
      "text": "ந"
    },
    {
      "t": "11:06",
      "text": "கக"
    },
    {
      "t": "11:08",
      "text": "மாடிப்படின்னு சொல்லிோப்போம்"
    },
    {
      "t": "11:10",
      "text": "றசி"
    },
    {
      "t": "11:12",
      "text": "சரி த"
    },
    {
      "t": "11:14",
      "text": ""
    },
    {
      "t": "11:16",
      "text": "அசிங்கமா பேசிருக்கோம்"
    },
    {
      "t": "11:18",
      "text": ""
    },
    {
      "t": "11:20",
      "text": "இமா பேசதா"
    },
    {
      "t": "11:22",
      "text": ""
    },
    {
      "t": "11:24",
      "text": "போன ஆசங்கே"
    },
    {
      "t": "11:26",
      "text": "உன்னாலே எவ்வளவு முடிதான் ஒணும்"
    },
    {
      "t": "11:28",
      "text": ""
    },
    {
      "t": "11:30",
      "text": ""
    },
    {
      "t": "11:32",
      "text": "ஆமா"
    },
    {
      "t": "11:34",
      "text": "ா போல"
    },
    {
      "t": "11:36",
      "text": "ஆம்"
    },
    {
      "t": "11:38",
      "text": ""
    },
    {
      "t": "11:40",
      "text": "போ கழ"
    },
    {
      "t": "11:42",
      "text": "க்கடி"
    },
    {
      "t": "11:44",
      "text": "ம்"
    },
    {
      "t": "11:46",
      "text": "போ க"
    },
    {
      "t": "11:48",
      "text": "வே வச்சன்டி"
    },
    {
      "t": "11:50",
      "text": "மாதிரி பண்ணா"
    },
    {
      "t": "11:52",
      "text": ""
    },
    {
      "t": "11:54",
      "text": "எவே"
    },
    {
      "t": "11:56",
      "text": "நால பிரிச்சு காமிப்பன்"
    },
    {
      "t": "11:58",
      "text": ""
    },
    {
      "t": "12:00",
      "text": "நீ நல்லா எரிச்சு காட்டுறிய"
    },
    {
      "t": "12:02",
      "text": "ஆமா"
    },
    {
      "t": "12:04",
      "text": "எரிக்குக்கனா அவர்த்து போ"
    },
    {
      "t": "12:06",
      "text": ""
    },
    {
      "t": "12:08",
      "text": "ம்"
    },
    {
      "t": "12:10",
      "text": ""
    },
    {
      "t": "12:12",
      "text": "எனக்கு ஆனா இப்ப பேர் எல்லாம் பேசினா"
    },
    {
      "t": "12:14",
      "text": "மூன்றாவது கஞைக்கு தக்குன்னு விளே வ"
    },
    {
      "t": "12:16",
      "text": "ஆ"
    },
    {
      "t": "12:18",
      "text": "கஞ்சியா"
    },
    {
      "t": "12:20",
      "text": ""
    },
    {
      "t": "12:22",
      "text": "விட்டு செய்யணும்"
    },
    {
      "t": "12:24",
      "text": "ச"
    },
    {
      "t": "12:26",
      "text": "சேவ"
    },
    {
      "t": "12:28",
      "text": "சூப்பர்லா"
    },
    {
      "t": "12:30",
      "text": "ம்"
    },
    {
      "t": "12:32",
      "text": "அப்ப நல்ல"
    },
    {
      "t": "12:34",
      "text": "வா"
    },
    {
      "t": "12:36",
      "text": "என்ங்க"
    },
    {
      "t": "12:38",
      "text": "ச வி வங்க வ நிகத"
    },
    {
      "t": "12:40",
      "text": "உஹம்"
    },
    {
      "t": "12:42",
      "text": ""
    },
    {
      "t": "12:44",
      "text": ""
    },
    {
      "t": "12:46",
      "text": ""
    },
    {
      "t": "12:48",
      "text": "சொல்லது"
    },
    {
      "t": "12:50",
      "text": "என் சொ"
    },
    {
      "t": "12:52",
      "text": ""
    },
    {
      "t": "12:54",
      "text": "எங்க இருக்குன்னு சொல்லு வந்து ஒருத்த"
    },
    {
      "t": "12:56",
      "text": ""
    },
    {
      "t": "12:58",
      "text": "நனான சொன்ன"
    },
    {
      "t": "13:00",
      "text": "உ சொன்னி"
    },
    {
      "t": "13:02",
      "text": "கிருஷ்ணகிர"
    },
    {
      "t": "13:04",
      "text": ""
    },
    {
      "t": "13:06",
      "text": "என் சொ"
    },
    {
      "t": "13:08",
      "text": "கிருஷ்ணகிரி"
    },
    {
      "t": "13:10",
      "text": "இனை"
    },
    {
      "t": "13:12",
      "text": "தெரிய"
    },
    {
      "t": "13:14",
      "text": "இங்க வந்த இருக்கண்டி"
    },
    {
      "t": "13:16",
      "text": "ஆஹ்"
    },
    {
      "t": "13:18",
      "text": ""
    },
    {
      "t": "13:20",
      "text": ""
    },
    {
      "t": "13:22",
      "text": ""
    },
    {
      "t": "13:24",
      "text": ""
    },
    {
      "t": "13:26",
      "text": "அட்டி வர உது வர"
    },
    {
      "t": "13:28",
      "text": ""
    },
    {
      "t": "13:30",
      "text": "ஆப்ப"
    },
    {
      "t": "13:32",
      "text": "உம் உம்"
    },
    {
      "t": "13:34",
      "text": "அவச"
    },
    {
      "t": "13:36",
      "text": "உஹம்"
    },
    {
      "t": "13:38",
      "text": "ஓ"
    },
    {
      "t": "13:40",
      "text": "சச்சிச்சா"
    },
    {
      "t": "13:42",
      "text": "சரி"
    },
    {
      "t": "13:44",
      "text": "நீ சொ"
    },
    {
      "t": "13:46",
      "text": ""
    },
    {
      "t": "13:48",
      "text": "உம் செய்யறண்டடி கம்பா"
    },
    {
      "t": "13:50",
      "text": "உ"
    },
    {
      "t": "13:52",
      "text": "டிக்கிறத்து"
    },
    {
      "t": "13:54",
      "text": ""
    },
    {
      "t": "13:56",
      "text": "இது"
    },
    {
      "t": "13:58",
      "text": "ல்லாம்க்க விக்கே நன்"
    },
    {
      "t": "14:00",
      "text": "இ க்கற"
    },
    {
      "t": "14:02",
      "text": "கொண்டே"
    },
    {
      "t": "14:04",
      "text": "ஆ விரப்ப"
    },
    {
      "t": "14:06",
      "text": "உஹ"
    },
    {
      "t": "14:08",
      "text": "சரிச்சரி"
    },
    {
      "t": "14:10",
      "text": "ஆஹ வத்து பே"
    },
    {
      "t": "14:12",
      "text": "அப்படி"
    },
    {
      "t": "14:14",
      "text": "இ எ"
    },
    {
      "t": "14:16",
      "text": "சபது சொரூணங்க"
    },
    {
      "t": "14:18",
      "text": "எ"
    },
    {
      "t": "14:20",
      "text": "சரித்தான் சல்ல"
    },
    {
      "t": "14:22",
      "text": "அது வேகமா"
    },
    {
      "t": "14:24",
      "text": "நலப ஒல ஒட்டு த"
    },
    {
      "t": "14:26",
      "text": "உ ஆ"
    },
    {
      "t": "14:28",
      "text": "ஆஹ சொமா"
    },
    {
      "t": "14:30",
      "text": "அ சரிட்டு"
    },
    {
      "t": "14:32",
      "text": "ச்ச"
    },
    {
      "t": "14:34",
      "text": "உம்"
    },
    {
      "t": "14:36",
      "text": ""
    },
    {
      "t": "14:38",
      "text": "ரமா பு கொத்த"
    },
    {
      "t": "14:40",
      "text": ""
    },
    {
      "t": "14:42",
      "text": ""
    },
    {
      "t": "14:44",
      "text": "ஏகமா குத்து குத்துன்னு குத்துவேன்"
    },
    {
      "t": "14:46",
      "text": "ஆான் கத்த ப"
    },
    {
      "t": "14:48",
      "text": "உம்"
    },
    {
      "t": "14:50",
      "text": "அ ந"
    },
    {
      "t": "14:52",
      "text": "உ பருப்பு இருக்கு"
    },
    {
      "t": "14:54",
      "text": "கர"
    },
    {
      "t": "14:56",
      "text": "அது விரல வச்சுச்சு"
    },
    {
      "t": "14:58",
      "text": "செேர்ந்துக்கிட்டு தேய்ச்சுக்கிட்டு நம்ம"
    },
    {
      "t": "15:00",
      "text": "ஆஹ"
    },
    {
      "t": "15:02",
      "text": "ஆமா"
    },
    {
      "t": "15:04",
      "text": "நல்ல"
    },
    {
      "t": "15:06",
      "text": "தேஜ தே பிரத்தக"
    },
    {
      "t": "15:08",
      "text": "சொ உஹ"
    },
    {
      "t": "15:10",
      "text": ""
    },
    {
      "t": "15:12",
      "text": "அப்படி உந்தல்ல எ"
    },
    {
      "t": "15:14",
      "text": "உ"
    },
    {
      "t": "15:16",
      "text": ""
    },
    {
      "t": "15:18",
      "text": "உம்"
    },
    {
      "t": "15:20",
      "text": "ச"
    },
    {
      "t": "15:22",
      "text": ""
    },
    {
      "t": "15:24",
      "text": "பொல"
    },
    {
      "t": "15:26",
      "text": "வந்து தண்ணி வருமமா"
    },
    {
      "t": "15:28",
      "text": ""
    },
    {
      "t": "15:30",
      "text": "ஆமா தண்ணி வருங்கான்"
    },
    {
      "t": "15:32",
      "text": "நக்கு"
    },
    {
      "t": "15:34",
      "text": "வஸ்த தானே"
    },
    {
      "t": "15:36",
      "text": "நி தப்படிவண"
    },
    {
      "t": "15:38",
      "text": "நிட்டுச்ச"
    },
    {
      "t": "15:40",
      "text": "ஓ"
    },
    {
      "t": "15:42",
      "text": ""
    },
    {
      "t": "15:44",
      "text": "என் இழியா"
    },
    {
      "t": "15:46",
      "text": "ஆ"
    },
    {
      "t": "15:48",
      "text": ""
    },
    {
      "t": "15:50",
      "text": "புறத"
    },
    {
      "t": "15:52",
      "text": "உஹம்"
    },
    {
      "t": "15:54",
      "text": ""
    },
    {
      "t": "15:56",
      "text": "உம்"
    },
    {
      "t": "15:58",
      "text": "இ"
    },
    {
      "t": "16:00",
      "text": "சொல்லலக்கதான்"
    },
    {
      "t": "16:02",
      "text": "உம்"
    },
    {
      "t": "16:04",
      "text": "நல்லா உம்ப"
    },
    {
      "t": "16:06",
      "text": ""
    },
    {
      "t": "16:08",
      "text": "ஆயனச்ச மாட்டா"
    },
    {
      "t": "16:10",
      "text": "புனமா"
    },
    {
      "t": "16:12",
      "text": "நான விட"
    },
    {
      "t": "16:14",
      "text": "ம்ன்ற"
    },
    {
      "t": "16:16",
      "text": "உம்"
    },
    {
      "t": "16:18",
      "text": "ஒன் ஹரு க அம்படியே படுத்துக்கிட்டே"
    },
    {
      "t": "16:20",
      "text": "கேன"
    },
    {
      "t": "16:22",
      "text": "அ உ"
    },
    {
      "t": "16:24",
      "text": "உஹம் உஹம் உ"
    },
    {
      "t": "16:26",
      "text": ""
    },
    {
      "t": "16:28",
      "text": "என் வேக்கா"
    },
    {
      "t": "16:30",
      "text": "டிட்டண்டதான்"
    },
    {
      "t": "16:32",
      "text": "உம்"
    },
    {
      "t": "16:34",
      "text": "உம்"
    },
    {
      "t": "16:36",
      "text": "உ கச்ச கச்ச ந ஆயி"
    },
    {
      "t": "16:38",
      "text": "சக்தி சக்த"
    },
    {
      "t": "16:40",
      "text": "உஹம் உ"
    },
    {
      "t": "16:42",
      "text": "நல்லா இருக்கும்"
    },
    {
      "t": "16:44",
      "text": ""
    },
    {
      "t": "16:46",
      "text": "நல்லாக்குண்டா"
    },
    {
      "t": "16:48",
      "text": "எச வத"
    },
    {
      "t": "16:50",
      "text": "ா இருக்கு பண்ணா என்னா"
    },
    {
      "t": "16:52",
      "text": ""
    },
    {
      "t": "16:54",
      "text": "உஹ"
    },
    {
      "t": "16:56",
      "text": ""
    },
    {
      "t": "16:58",
      "text": ""
    },
    {
      "t": "17:00",
      "text": "எப்போ பண்ணலாம்"
    },
    {
      "t": "17:02",
      "text": "ந"
    },
    {
      "t": "17:04",
      "text": "நிறைய எக்ஸ்பிளோர் பண்ணணும்"
    },
    {
      "t": "17:06",
      "text": "என்னமாா என்னமா"
    },
    {
      "t": "17:08",
      "text": "சொு"
    },
    {
      "t": "17:10",
      "text": "அ"
    },
    {
      "t": "17:12",
      "text": ""
    },
    {
      "t": "17:14",
      "text": ""
    },
    {
      "t": "17:16",
      "text": ""
    },
    {
      "t": "17:18",
      "text": "இ வாழ நா நினைச்சுப்ப"
    },
    {
      "t": "17:20",
      "text": "அ போடிய அந்த மாதிரி செய்ய வேண்ட"
    },
    {
      "t": "17:22",
      "text": "ஹம் ஹம்"
    },
    {
      "t": "17:24",
      "text": ""
    },
    {
      "t": "17:26",
      "text": ""
    },
    {
      "t": "17:28",
      "text": "நாளை"
    },
    {
      "t": "17:30",
      "text": "அஞ்சு ரவுண்ட் ஆறு ரவுண்டு போனும்"
    },
    {
      "t": "17:32",
      "text": "உஹம்"
    },
    {
      "t": "17:34",
      "text": ""
    },
    {
      "t": "17:36",
      "text": "ம்"
    },
    {
      "t": "17:38",
      "text": "தயடாயா"
    },
    {
      "t": "17:40",
      "text": "ம் ம்"
    },
    {
      "t": "17:42",
      "text": ""
    },
    {
      "t": "17:44",
      "text": "அம்மா சொல்ல டட"
    },
    {
      "t": "17:46",
      "text": ""
    },
    {
      "t": "17:48",
      "text": "வாட்டி உனக்கு வெளியே வந்தாலே யடு தான்"
    },
    {
      "t": "17:50",
      "text": "ஹ"
    },
    {
      "t": "17:52",
      "text": ""
    },
    {
      "t": "17:54",
      "text": ""
    },
    {
      "t": "17:56",
      "text": ""
    },
    {
      "t": "17:58",
      "text": "உம்"
    },
    {
      "t": "18:00",
      "text": "ஹஸ்பண்ட் அதானே ஒரு நாளைக்கு எத்தனை ட்டி பண்ணன்"
    },
    {
      "t": "18:02",
      "text": "உ"
    },
    {
      "t": "18:04",
      "text": "உஹம்"
    },
    {
      "t": "18:06",
      "text": "மன"
    },
    {
      "t": "18:08",
      "text": ""
    },
    {
      "t": "18:10",
      "text": "டெய்லியும் ஒ மூணு வாத்த"
    },
    {
      "t": "18:12",
      "text": ""
    },
    {
