{
  "file_id": "rec_audio_call_426864047_audio_1789021815416.mp3",
  "language": "kannada",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 827.15,
  "processing_time_sec": 30.976995944976807,
  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:02",
      "text": "ಹ ಹ"
    },
    {
      "t": "00:04",
      "text": "ಹಾಯ"
    },
    {
      "t": "00:06",
      "text": "ಹಾಯ್ ಯಾವರು"
    },
    {
      "t": "00:08",
      "text": "ನಾನ ಬಷ"
    },
    {
      "t": "00:10",
      "text": "ಮದ ನಿ ಬ ಅವರು"
    },
    {
      "t": "00:12",
      "text": "ನಮ್ದು ಹುಬ್ಳಗಿ ಏನ್ ಮಾಡ"
    },
    {
      "t": "00:14",
      "text": "ಕಕೊಂಡಿದ್ದೀರಿ"
    },
    {
      "t": "00:16",
      "text": "ಸ್ದ ಶಕ್ಯ"
    },
    {
      "t": "00:18",
      "text": "ಮೇಡಮ್ ಜೊತೆ ಮಾತಾಡ್ತಾ ಇಲ್ಲ"
    },
    {
      "t": "00:20",
      "text": "ಹೌದು"
    },
    {
      "t": "00:22",
      "text": "ತಿಂಡಿ ಆಯ್ತಾ"
    },
    {
      "t": "00:24",
      "text": "ಆ ನಾಷ್ಟತ ಇು ನ"
    },
    {
      "t": "00:26",
      "text": "ಎಲೆಕ್ಟ್ರಲ್ಟ"
    },
    {
      "t": "00:28",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:30",
      "text": "ನಸರ್ ಕುಮಾರ್ ಅಂತ"
    },
    {
      "t": "00:32",
      "text": "ಓಕೆ ಮನ್ ಮಾರದು"
    },
    {
      "t": "00:34",
      "text": "ನಾವು ಮೇರೆ"
    },
    {
      "t": "00:36",
      "text": ""
    },
    {
      "t": "00:38",
      "text": "ರದು"
    },
    {
      "t": "00:40",
      "text": "ಅ ಎಲ್ಲಿ ಒಂದ್ ಏರಿಯ ಕನ್ ಕೊೊಪ್ಪ ಅಂತ"
    },
    {
      "t": "00:42",
      "text": "ಗೋಪನ್"
    },
    {
      "t": "00:44",
      "text": ""
    },
    {
      "t": "00:46",
      "text": ""
    },
    {
      "t": "00:48",
      "text": ""
    },
    {
      "t": "00:50",
      "text": "ಹ್ಮ ಕರೆಕ್ಟ್"
    },
    {
      "t": "00:52",
      "text": "ಇಷ್ಟು ಒಳಗಡೆ ಹ"
    },
    {
      "t": "00:54",
      "text": "ಹೌದು"
    },
    {
      "t": "00:56",
      "text": "ಬಂದಿದ್ರಾ"
    },
    {
      "t": "00:58",
      "text": ""
    },
    {
      "t": "01:00",
      "text": "ನಾನೇಶ್ವರ್ ಬ"
    },
    {
      "t": "01:02",
      "text": "ಬ ಜ"
    },
    {
      "t": "01:04",
      "text": ""
    },
    {
      "t": "01:06",
      "text": ""
    },
    {
      "t": "01:08",
      "text": "ಎ"
    },
    {
      "t": "01:10",
      "text": ""
    },
    {
      "t": "01:12",
      "text": "ಹಾ"
    },
    {
      "t": "01:14",
      "text": "ಅವಾಗ ಬಂದಿದ್ದೆ ನೀವ ಏನ್ ಮಾಡ್ಕೊಂಡಿದ್ರ"
    },
    {
      "t": "01:16",
      "text": "ನೀ ಎಲ್ಲ"
    },
    {
      "t": "01:18",
      "text": "ಮನೇಲಿ ಇರೋದು ಹಸ್ಬೆಂಡ್ ಡ್ರೈವ"
    },
    {
      "t": "01:20",
      "text": "ಬರಿದ್ದಾರೆ"
    },
    {
      "t": "01:22",
      "text": "ಯಾವ್ದ ಕಾವ"
    },
    {
      "t": "01:24",
      "text": "ಟ"
    },
    {
      "t": "01:26",
      "text": "ಇಲ್ಲ ಬಸ್ಸನ್ ಡ್ರೈವರ್"
    },
    {
      "t": "01:28",
      "text": ""
    },
    {
      "t": "01:30",
      "text": "ಕೆ ಎಸ್ ಆರ್ಟ ಸಿಿನ ಕೆ ಎಸ್"
    },
    {
      "t": "01:32",
      "text": "ಹೌದು"
    },
    {
      "t": "01:34",
      "text": "ಮಕುಲೇಶನ್ ಇದ ಇದ್ರ"
    },
    {
      "t": "01:36",
      "text": "ಮಕ್ಕಳು ಇಬ್ಬರು ಮಕ್ಕಳು"
    },
    {
      "t": "01:38",
      "text": "ಹಳು ಇನ್ನ ಸ್ಕೂಲ್ ಹೋಗ"
    },
    {
      "t": "01:40",
      "text": "ಅ ಎಲ್ಲಾ ಚಕ್ಕೌ"
    },
    {
      "t": "01:42",
      "text": "ಇಲ್ಲ ಚಕ್ಕೋನ್ನ"
    },
    {
      "t": "01:44",
      "text": "ಹ್ಮ"
    },
    {
      "t": "01:46",
      "text": "ಏನ್ ಮಾಡಿದ್ ನಾಷ್ಟತ"
    },
    {
      "t": "01:48",
      "text": "ಶಾಸ ಉಪೇ"
    },
    {
      "t": "01:50",
      "text": "ಒಪ್ಪೇತು"
    },
    {
      "t": "01:52",
      "text": "ನೀ ಮ"
    },
    {
      "t": "01:54",
      "text": "ಮನಯಾಗ ಸ್ದ"
    },
    {
      "t": "01:56",
      "text": "ಅಕ್ ನಾನು ಒಬ್ಬಬೇಕ ಅದೇ ನೋಡಿ"
    },
    {
      "t": "01:58",
      "text": "ನಾವುೂ ಪ್ರತಿದಿಂದ"
    },
    {
      "t": "02:00",
      "text": "ಇನ್ನೇನು ಒಪ್ಪಿಟ್ಟ"
    },
    {
      "t": "02:02",
      "text": "ಹ್ಮ್ ಇ ಸಿಮ ನಕ"
    },
    {
      "t": "02:04",
      "text": "ಷ ಏನ ಗೊತ್ತಿತ್ತು"
    },
    {
      "t": "02:06",
      "text": "ಇಬ್ರು ಸೇಮ್ ಕಾಂಬಿನೇಷನ್"
    },
    {
      "t": "02:08",
      "text": "ಹ್ಮ ಎ"
    },
    {
      "t": "02:10",
      "text": "ನಿಮ್ ಹೆಸರು ಗೊತ್ತಾಗ್ಲಿಲ್ಲ ನಂಗೆ"
    },
    {
      "t": "02:12",
      "text": "ಕವಿತಾ"
    },
    {
      "t": "02:14",
      "text": "ತನ್ನನ್ನ ಹೆಸರು"
    },
    {
      "t": "02:16",
      "text": "ಹಾ ಎಳಕ್ುವ"
    },
    {
      "t": "02:18",
      "text": "ಸಮಾಚಾರ"
    },
    {
      "t": "02:20",
      "text": "ಎಲ್ಲ ಹೇಳ್ಬೇಕಕ್ ನೋ ನೀನಾ"
    },
    {
      "t": "02:22",
      "text": "ಎಷ್ಟ ದಿವೂ ಮಾಡ"
    },
    {
      "t": "02:24",
      "text": "ತಿ ಅಪ್ಪ"
    },
    {
      "t": "02:26",
      "text": "ಸುಮಾರು ದಿನ ಆಯ್ತು ಬ ಜಾಸ್ತಿ"
    },
    {
      "t": "02:28",
      "text": "ಜಸ್ತಿ ಬರ್ತಾ ಇರ್ಲಿಲ್ಲ ಇವತ್ತು ಬಂದೇನೆ"
    },
    {
      "t": "02:30",
      "text": "ಯಾಕ ಯೂಸ್ ಮಾಡತೀನಿ ನೀನು"
    },
    {
      "t": "02:32",
      "text": "ಹಾಂಗ ಸನೆ"
    },
    {
      "t": "02:34",
      "text": "ಮಯ ಆಗಿರ್ತಾನ ಎಲ್ಲಾ ಬೇಜಾರುಾಗತತಿ"
    },
    {
      "t": "02:36",
      "text": "ಮಕ್ಕ"
    },
    {
      "t": "02:38",
      "text": "ಕಷ್ಟ ಲಿಪ್ಪಾ ಟೈಮ ಪಸ್ ಮಾಡರ"
    },
    {
      "t": "02:40",
      "text": "ಮಕ್ಕಳು ಊರಲ್ಲೇದಾರ"
    },
    {
      "t": "02:42",
      "text": "ಇಲ್ಲಿ ಮ"
    },
    {
      "t": "02:44",
      "text": "ಎ ಹ"
    },
    {
      "t": "02:46",
      "text": "ನಮ್ಮ್ವನ್ ತ ಅವ್ರ ಮನ್ ಆಾಗಲ್ಲ ನಂತ ಅವ್ರ ಮನೆ"
    },
    {
      "t": "02:48",
      "text": "ಸರಿ"
    },
    {
      "t": "02:50",
      "text": "ಸಾರಿ ಪಾನಿಿನ ತೋಳ್ಳ"
    },
    {
      "t": "02:52",
      "text": ""
    },
    {
      "t": "02:54",
      "text": "ನಂತ ಅವ್ರ ಮನ್ಯಾಗದಾರ"
    },
    {
      "t": "02:56",
      "text": "ಗಟ್ಟ"
    },
    {
      "t": "02:58",
      "text": "ರಂತಲ್ಲ ಅದಾರ"
    },
    {
      "t": "03:00",
      "text": "ಯಾವಊರಾಗ"
    },
    {
      "t": "03:02",
      "text": "ಅಲ್ಲೇ ಊರು ಮುಂಡಗೋಡಂತೆ"
    },
    {
      "t": "03:04",
      "text": ""
    },
    {
      "t": "03:06",
      "text": "ಒಂದು ಓಡಿ ಇಲ್ಲ ಇದ್ರ"
    },
    {
      "t": "03:08",
      "text": "ಶಿರ್ಸಿ ರೋಡ್ ಹುಬ್ಬಳಿಯಿಂದ ಶಿರ್ಸಿ ರೋಡ್"
    },
    {
      "t": "03:10",
      "text": "ಹಾ ಸರಿ ಸರಿ ನಡ ಕರೆಕ್"
    },
    {
      "t": "03:12",
      "text": "ಕೆ"
    },
    {
      "t": "03:14",
      "text": "ತಪರ"
    },
    {
      "t": "03:16",
      "text": "ಪ್ರಾಪರ್ ನಂತ ಅವ್ರ ಮನ ಮಂಡೋಡ"
    },
    {
      "t": "03:18",
      "text": "ಹಾ"
    },
    {
      "t": "03:20",
      "text": "ಗಂಡಮನೆ ಅ ಕೂಡ"
    },
    {
      "t": "03:22",
      "text": "ಮುಡಗೋಡ"
    },
    {
      "t": "03:24",
      "text": "ಯಾವ ಊರಲ್ಲ"
    },
    {
      "t": "03:26",
      "text": "ನಿಮ ದೇಾವ ಕೆಷ್ಟ ಕವಿ"
    },
    {
      "t": "03:28",
      "text": "ನಮ್ಮದ"
    },
    {
      "t": "03:30",
      "text": "ಹಾ ಮರಾಠಿ"
    },
    {
      "t": "03:32",
      "text": "ಅದ ಕ ಅನ್ಕೊಂಡ"
    },
    {
      "t": "03:34",
      "text": "ನಾವು ಮರಾಠಿ ಸಿಕ್ಕಾಪಟ್ಟಿದ್ದ ಜನ"
    },
    {
      "t": "03:36",
      "text": "ಲ್ ಕಲ್ಪನಿಯ"
    },
    {
      "t": "03:38",
      "text": "ಹೌದು ಭಾಳ ಮಜೆದ"
    },
    {
      "t": "03:40",
      "text": "ನನಗೆ"
    },
    {
      "t": "03:42",
      "text": "ಬಾಳ ಆತ್ಮೀರ ಇದರು ಮರ ಪಾಪ್ಳ"
    },
    {
      "t": "03:44",
      "text": "ಸ್ ತಿಳ್ಕೊಂಡ್ರಿಂಗ ಹ"
    },
    {
      "t": "03:46",
      "text": "ಯಾರು ಮು"
    },
    {
      "t": "03:48",
      "text": "ಕೊದಾಗ"
    },
    {
      "t": "03:50",
      "text": "ಒಗುಡ್ದತ್ರ ಚಿಗಿ ಒಳಗಿದ್ರರು"
    },
    {
      "t": "03:52",
      "text": "ಓ ಚಗಲಿ"
    },
    {
      "t": "03:54",
      "text": "ಹಾ ದೀಪ ನೋಡಿ ಏನಲ್ಲಿ"
    },
    {
      "t": "03:56",
      "text": "ಮ ಹ"
    },
    {
      "t": "03:58",
      "text": "ಹ್ಮ ದೀಪಾ ದೀಪಾ"
    },
    {
      "t": "04:00",
      "text": "ದೀಪ ಅರವಲ್ಲೆ ಪಾಯ"
    },
    {
      "t": "04:02",
      "text": "ಅರಿದ್ವಾ"
    },
    {
      "t": "04:04",
      "text": "ಹಾ ದೀಪ ಹೌ"
    },
    {
      "t": "04:06",
      "text": "ಕೃಷನರಣ"
    },
    {
      "t": "04:08",
      "text": "ಏನ ನಾವ ಹೋಗೋದೇ ಎಲ್ಲ ನೋಡಿ"
    },
    {
      "t": "04:10",
      "text": "ನಮ್ರ ಅಲ್ಲ"
    },
    {
      "t": "04:12",
      "text": "ರವಿಷ್ಟ್ರಂಂತ ಈ ನಾಟಕ"
    },
    {
      "t": "04:14",
      "text": "ಇ ಕೆಲಸ ಸಂಗೀತಗಾರರು"
    },
    {
      "t": "04:16",
      "text": "ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "04:18",
      "text": "ಅವರು ನಿಮ್ ಮರಾಠ"
    },
    {
      "t": "04:20",
      "text": "ಬಾರಕ್ಲೋಸ್ ಭಬ್ಂ"
    },
    {
      "t": "04:22",
      "text": "ಹ್ಮ ಹಾ್ ಹಾ"
    },
    {
      "t": "04:24",
      "text": "ಅವರು ಸತ್ಮಲೆ ಅವ"
    },
    {
      "t": "04:26",
      "text": "ನಮ್ಮೊಳಗೆ ತಿಥಿ ಹೋಗಿದ್ದು ಹಳ್ಳು ಹೋಗಲ್ಲ"
    },
    {
      "t": "04:28",
      "text": "ಮಾನ್ಯವ್ ಮದುವೆ ಎತ್ತು ಹೋಗಿದ್ದೆ ನಮ್ಮ ಇಲ್ಲಿ ಕಾರ"
    },
    {
      "t": "04:30",
      "text": "ಅಿಕ ಬರೋ ಮಾಡಡಿ ಅಗ್ಲ ಹರಗಡೆೇ"
    },
    {
      "t": "04:32",
      "text": "ಹೌತವಾ"
    },
    {
      "t": "04:34",
      "text": "ಏನು ದೂರು ಮಾಡರಲಿಪ್ಪಾ ನಳಗುಡುಕ"
    },
    {
      "t": "04:36",
      "text": "ಹೌದು"
    },
    {
      "t": "04:38",
      "text": "ಎಲ್ಲ ದೂರ ದೂರ ದೂರ"
    },
    {
      "t": "04:40",
      "text": "ಮು"
    },
    {
      "t": "04:42",
      "text": "ನೋಡದವರು ಒಬ್ಬ್ರ ಇಂಟರ್ನಡ ಆ ಟೈ"
    },
    {
      "t": "04:44",
      "text": "ಮಾಡ ತರ ಹರಗ"
    },
    {
      "t": "04:46",
      "text": "ಹೌದು"
    },
    {
      "t": "04:48",
      "text": "ಎಲ್ಲಾ ಹಂಗ ಮಾಡ್ಬಿಟ್ಟಾವ"
    },
    {
      "t": "04:50",
      "text": ""
    },
    {
      "t": "04:52",
      "text": "ಹಲ್ಲಿ ಮ ಕಾತುರ ನ"
    },
    {
      "t": "04:54",
      "text": "ಫ್ರೆಂಡ್ಸ್ ಇದ್ರೆ ಹೋಗ್ಬಿಟ್ಟೆ ಮತ್ತು"
    },
    {
      "t": "04:56",
      "text": "ಬ"
    },
    {
      "t": "04:58",
      "text": "ಕಾತೋರಾಗಲ್ಲಿ ಫ್ರೆಂಡ್ಸ್"
    },
    {
      "t": "05:00",
      "text": "ಕದು"
    },
    {
      "t": "05:02",
      "text": "ಬಸು ಅಂತ ಹೇಳ ಒಬ್ಬ ಸೊಸೈಟಿ ಸೆಕ್ರೆಟರಿ"
    },
    {
      "t": "05:04",
      "text": "ರ"
    },
    {
      "t": "05:06",
      "text": "ಹ"
    },
    {
      "t": "05:08",
      "text": "ಪಂಚಾಯತ್ಾವಣ"
    },
    {
      "t": "05:10",
      "text": "ಆಾ"
    },
    {
      "t": "05:12",
      "text": "ಲಂಗಾಯಯ್ನ ಚಂದ ಬಸ್ಸು"
    },
    {
      "t": "05:14",
      "text": "ಅಲ್ಲಲ್ಲ ಬಸಕ್ರ"
    },
    {
      "t": "05:16",
      "text": "ಹ್ಮ"
    },
    {
      "t": "05:18",
      "text": "ರಾಜಕ ಪೈಕಿ"
    },
    {
      "t": "05:20",
      "text": "ಹಂಗಸವಪ ಐಕನಾ"
    },
    {
      "t": "05:22",
      "text": "ಗಂಗಾಮತ್ಲಿಪ್ಪಾ"
    },
    {
      "t": "05:24",
      "text": "ಹಾ ಹಾ ಹಾ"
    },
    {
      "t": "05:26",
      "text": "ಹ್ಮ ಹಾ"
    },
    {
      "t": "05:28",
      "text": "ಆಮೇಲೆ ಇನ್ನೊಬ್ರು ಗಿರೀಶ್ ಅಂತ ಹೇಳಿ"
    },
    {
      "t": "05:30",
      "text": "ರಂದು ಒಂದು್ರ ಪಕ"
    },
    {
      "t": "05:32",
      "text": "ಗಿರೀಶ ಹನುಮಂತ"
    },
    {
      "t": "05:34",
      "text": ""
    },
    {
      "t": "05:36",
      "text": "ಹನುಮತ್ ಅವರು"
    },
    {
      "t": "05:38",
      "text": "ಅಣ್ಣ ಒಬ್ರು ಎಸದ್ರ"
    },
    {
      "t": "05:40",
      "text": "ಸುರ್ಷೆಾಗ"
    },
    {
      "t": "05:42",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "05:44",
      "text": "ನ ಕದು ಹೋಗ್ತಲ್ಲ"
    },
    {
      "t": "05:46",
      "text": "ನಮ್ಮ ಇರ್ತಾನ"
    },
    {
      "t": "05:48",
      "text": "ಹೌತ್ಾ ಬಸ್ ಸ್ಟ್ಯಾಂಡ್ ಇಂದ ಒಳಗ್ ಹೋಗ್ಬೇಕು"
    },
    {
      "t": "05:50",
      "text": ""
    },
    {
      "t": "05:52",
      "text": "ಗೊ ಅ"
    },
    {
      "t": "05:54",
      "text": "ಪರಿಚ ನಮ ಅಂಗ"
    },
    {
      "t": "05:56",
      "text": "ಮ್ಮಂಡ ಓಡಲ್ಲ"
    },
    {
      "t": "05:58",
      "text": "ಪೀಕ್ಷ ಮಂದ ಬ"
    },
    {
      "t": "06:00",
      "text": "ಕಾಳ ಆಐತ ಕಾ ಕತ"
    },
    {
      "t": "06:02",
      "text": "ಚೋರಾಗ ಬಾಳ್ ಬಂದರ್ ಪರ್ಚ"
    },
    {
      "t": "06:04",
      "text": ""
    },
    {
      "t": "06:06",
      "text": "ಅರಿ ಏನ್್ರ್ತೀ ಕ್ಾತೇನೆ ಅವ್ರ"
    },
    {
      "t": "06:08",
      "text": "ಹ ನಡ ನ"
    },
    {
      "t": "06:10",
      "text": "ನಟ ಆಟ ಇಷ್ಟ"
    },
    {
      "t": "06:12",
      "text": "ಹ ಅ ಹಾನಮಾನ"
    },
    {
      "t": "06:14",
      "text": "ನಾವ ನಾಟಕದಕ್ಕನ್ ಮದುವೆ ಆದ್ನಲ್ಲಾ"
    },
    {
      "t": "06:16",
      "text": "ಶಮ್ಮ"
    },
    {
      "t": "06:18",
      "text": "ಹಾ"
    },
    {
      "t": "06:20",
      "text": "ಇ ಗಿ್ರ ಸರ್ಥ ಮಲ್ ಹೋಗ"
    },
    {
      "t": "06:22",
      "text": "ಬರ ಆ"
    },
    {
      "t": "06:24",
      "text": "ಅ ಈ ವಟ್ರ ಪೈಕಿ ಅಂದ್ರ ಅವ್ರ"
    },
    {
      "t": "06:26",
      "text": "ಎಸ"
    },
    {
      "t": "06:28",
      "text": "ಸರ್ಶೇಾಗ ಅವ್ರಣ್ಣ"
    },
    {
      "t": "06:30",
      "text": "ಹ್ಮ"
    },
    {
      "t": "06:32",
      "text": "ಅವ್ರಣ್ಣೊಬ್ಬ"
    },
    {
      "t": "06:34",
      "text": "ಪಕ್ಕ ನಾಗೇಶ್ಣಾವ"
    },
    {
      "t": "06:36",
      "text": ""
    },
    {
      "t": "06:38",
      "text": "ಹ್ಮ ಕರೆಕ್"
    },
    {
      "t": "06:40",
      "text": "ಹಾ"
    },
    {
      "t": "06:42",
      "text": "ಹ್ಮ ಹ  ಗಿರಿ್"
    },
    {
      "t": "06:44",
      "text": "ಜಸ್ನ ಪತ್ರ್ರ ಮಾಡೋಲ್ಲ"
    },
    {
      "t": "06:46",
      "text": "ಕವಿ ಅವ್ರನ್ನೆ ಮತ್ತೆ ಬೇರೆ ಯಾರು ಮಾಡ್ತಿದ್ದಿಲ್ಲ"
    },
    {
      "t": "06:48",
      "text": "ಹೌದಾ"
    },
    {
      "t": "06:50",
      "text": "ಹ"
    },
    {
      "t": "06:52",
      "text": "ಅ ಹೇಳಕರ್ತಿ ಎಷ್ಟುಂದು ಅ"
    },
    {
      "t": "06:54",
      "text": "ಬೆಂಗಳೂರು"
    },
    {
      "t": "06:56",
      "text": "ಏನ್ ನನಗ್ ಗೊತ್ತ"
    },
    {
      "t": "06:58",
      "text": "್ದಗೆ ಆಾಗ ಗಿರಿ ಸ್ವಪ್ನ ಇಲ್ಲ"
    },
    {
      "t": "07:00",
      "text": "ಹ ಊಟವ್ರಲ್ಲ ಮುಗೂ ಇದ್ರಾಗ ಇರ್ತಾರೆ"
    },
    {
      "t": "07:02",
      "text": "ಸಷ್ಟಷ್ಟ"
    },
    {
      "t": "07:04",
      "text": "ಹ ಬರಿಯಾರಲ್ಲ"
    },
    {
      "t": "07:06",
      "text": "ಹ"
    },
    {
      "t": "07:08",
      "text": "ವ ಹನುಮಂತ ಅನ್ನ ಹಬ್ಬೋದ"
    },
    {
      "t": "07:10",
      "text": "ಅವ್ರ ಮನ್ಯಾಗ ಗಿರೀಶ ಹನುಮಂತ್"
    },
    {
      "t": "07:12",
      "text": "ಆಮೇಲೆ"
    },
    {
      "t": "07:14",
      "text": "ಏ ಅವ್ರದೆಲ್ಲಿ"
    },
    {
      "t": "07:16",
      "text": "ಕಾೂರಿಗೆ ಎಂಟ್ರನ್ಸ್ ಹೋಗ್ತ ಅವ ಮುಡುಗೋ ಕಡೆಯಿಂದ"
    },
    {
      "t": "07:18",
      "text": "ಅಲ್ಲ ಮುಗಡ್ ಕಡೆಯಿಂದ"
    },
    {
      "t": "07:20",
      "text": "ಬ ಸ್ಟ್ಯಾಂಡ್ ಇಲ್ಲ ಅಲ್ಲ ಬಸ್ ಸ್ಟಂಡ್"
    },
    {
      "t": "07:22",
      "text": "ಕಿಲ್ಲ"
    },
    {
      "t": "07:24",
      "text": "ಬಸ್ ಸ್ಟ್ಯಾಂಡ್ ಮುಂದ ಐತ ಇನ್ನು ಹೇಳೋದಿ"
    },
    {
      "t": "07:26",
      "text": "ಅವಗ ಬಲಕೊಂದು ಮಟಾಯಐತಲ್ಲ"
    },
    {
      "t": "07:28",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "07:30",
      "text": "ಅಲ್ಲೇನ"
    },
    {
      "t": "07:32",
      "text": "ಹ ಮಠದಿಂದ"
    },
    {
      "t": "07:34",
      "text": "ಹಾಗೆ ರೋಡ್ ಆ ಕಡೆ"
    },
    {
      "t": "07:36",
      "text": "ಹಾ"
    },
    {
      "t": "07:38",
      "text": "ಅಲ್ಲಿ ಗರಿ"
    },
    {
      "t": "07:40",
      "text": "ಅಂತ ಹೇಳಿ"
    },
    {
      "t": "07:42",
      "text": "ಲ ಬ ಗ್ರಷಾದಾನ"
    },
    {
      "t": "07:44",
      "text": "ವರು"
    },
    {
      "t": "07:46",
      "text": "ಬಸ್ಸ್ಾಂಡ್"
    },
    {
      "t": "07:48",
      "text": "ಏ ಬಹಳ ಫ್ರೆಂಡ್"
    },
    {
      "t": "07:50",
      "text": "ಹೌದ"
    },
    {
      "t": "07:52",
      "text": "ಎ ಟ ಬ"
    },
    {
      "t": "07:54",
      "text": "ಹ"
    },
    {
      "t": "07:56",
      "text": "ಇಲ್ಲ ಆಳ"
    },
    {
      "t": "07:58",
      "text": ""
    },
    {
      "t": "08:00",
      "text": "ಕ"
    },
    {
      "t": "08:02",
      "text": "ತಿ ಜ ತಿಕ"
    },
    {
      "t": "08:04",
      "text": "ಹ ಹೌದಾ"
    },
    {
      "t": "08:06",
      "text": "ಹಾ"
    },
    {
      "t": "08:08",
      "text": "ನಾನ್ ನೋಡ ಆನ್ ಮಾಡಕ್ಕ ನಿ ಇನ್"
    },
    {
      "t": "08:10",
      "text": "ಏ"
    },
    {
      "t": "08:12",
      "text": "ಇಲ್ಲಪ್ಪಾ ಏನ್ ಮಾತಾಡಿದೀಯಾ"
    },
    {
      "t": "08:14",
      "text": "ಹ"
    },
    {
      "t": "08:16",
      "text": "ಏ ಮಾತಾಡಿ"
    },
    {
      "t": "08:18",
      "text": "ಸ್ಕೂಲ್ ನಾಗ ಮಾತಾಡ್ತಿದಲ್ಲ ಆತರ"
    },
    {
      "t": "08:20",
      "text": "ದೀಪಾ ಹೋಗ್ಲಿೀಪಾ ಅನ್ನೋದೊಂದು ಅಭ್ಯಾಸ"
    },
    {
      "t": "08:22",
      "text": "ಇರ್ಲಿ ಇರ್ಲಿ ಏನಾಗೋದಿಲ್ಲ"
    },
    {
      "t": "08:24",
      "text": "ನಮಗು ಹಂಗ ನಾವು ಮಾತಾಡೋದು"
    },
    {
      "t": "08:26",
      "text": ""
    },
    {
      "t": "08:28",
      "text": "ಅದಕ್ಕೆಲ್ಲ ಬೇಜಾರ"
    },
    {
      "t": "08:30",
      "text": "ಹ್ಮ್ ಚ"
    },
    {
      "t": "08:32",
      "text": "ಚೆನ್ನಾಗೈತಿ ಚೆನ್ನ ನೋಡ್ಕೊಂತ"
    },
    {
      "t": "08:34",
      "text": ""
    },
    {
      "t": "08:36",
      "text": "ಹಂಗೇನ ಇಲ್ಲಿದೆ ಅವರು"
    },
    {
      "t": "08:38",
      "text": "ಹ"
    },
    {
      "t": "08:40",
      "text": "ನಿ ಕ"
    },
    {
      "t": "08:42",
      "text": "ಮ ಇಮನ್ ೂದ ಅವದಲ್ಲ"
    },
    {
      "t": "08:44",
      "text": "ಹುಬ್ಬಳಿನ ಅದಾಗ ಹಕನ್"
    },
    {
      "t": "08:46",
      "text": "ಪಣ"
    },
    {
      "t": "08:48",
      "text": "ಗೋಪನ್ ಗಪ್ಪನ ಹ"
    },
    {
      "t": "08:50",
      "text": "ಹಾ ಅವ ದೂರ"
    },
    {
      "t": "08:52",
      "text": "ಅದ ಅಲ್ಲೇ ನಂಗೆ ಕೊಟ್ಟಿರೋದು"
    },
    {
      "t": "08:54",
      "text": "ಒಬ್ಬಳೆದ ಮತ್ತತ್ತ"
    },
    {
      "t": "08:56",
      "text": "ಅತಿಿಮ ಬಲೆ ಜೊತೆಗೆ"
    },
    {
      "t": "08:58",
      "text": "ಆತೇ ಮಾವ ಇಲ್ಲ ಜೊತೆಗಲ್ಲೋ"
    },
    {
      "t": "09:00",
      "text": "ಅವರು ಇನ್ನೊಬ್ಬ ಅವರ ತಮ್ಮ"
    },
    {
      "t": "09:02",
      "text": "ಜೊತೆಗದ ನಮ್ಮ ಮನ ಒ ತಮ್ಮ ಮುನ್ ಜೊತೆ"
    },
    {
      "t": "09:04",
      "text": ""
    },
    {
      "t": "09:06",
      "text": "ಕ ಬೇಕ ಮ ಹಾರಾಮ"
    },
    {
      "t": "09:08",
      "text": "ನಾಾನಾ ಮಾರಾಣ"
    },
    {
      "t": "09:10",
      "text": "ನ ನಾನ ಮಹಾರಾಜ ಅವನ್ ಬರ ಮಾಟ"
    },
    {
      "t": "09:12",
      "text": ""
    },
    {
      "t": "09:14",
      "text": "ಎಲ್ಲಲ್ಲಿ ಅ ದೀಪಕ್ಕೆ ಹುಬ್ಬಳ್ಳಿ ದೀಪ"
    },
    {
      "t": "09:16",
      "text": "ಗ ಗರೆಕ್ಟಗ"
    },
    {
      "t": "09:18",
      "text": "ಇಲ್ಲ ಹುಬ್ಬಳಿ ಡ್ ಪನ"
    },
    {
      "t": "09:20",
      "text": "ಸಂಜೆ ಪಡ್ತಾನ"
    },
    {
      "t": "09:22",
      "text": "ಹರಿ ಮದ ರೋಟಿ"
    },
    {
      "t": "09:24",
      "text": "ಎರಡುವಗೆಲ್ಲ ಬೆಳಿಗ್ ಹತ್ತನ"
    },
    {
      "t": "09:26",
      "text": "ಸಾಯಂಕಾಲ ಸರಿಸಸಿ ಹುಬ್ಳಿ ಮಾಡ್ತಾನ"
    },
    {
      "t": "09:28",
      "text": "ಹ"
    },
    {
      "t": "09:30",
      "text": "ಬ್ ಲೋಕಲ್ ಮಾಡ್ತಾರ"
    },
    {
      "t": "09:32",
      "text": "ಹಾ ಲೋಕಲ್ ಸಂಜೀ ಬಂದ್ಬಿಡ್ತವಿ"
    },
    {
      "t": "09:34",
      "text": "ನಾಲ್ಕ್ ಸಿಂಗಲ್ ಆರ್ ಸಿಂಗಲ್"
    },
    {
      "t": "09:36",
      "text": "ಮಾಡಿಲ್ಲ"
    },
    {
      "t": "09:38",
      "text": "ನಾಲ್ಕ್ ಸಿಂಗಲ್ಕ ಆರು ಸಿಂಗಲ್ ಇಕ್ಕ ನಾಕ"
    },
    {
      "t": "09:40",
      "text": "ಸಿಲ್ ಅಷ್ಟ"
    },
    {
      "t": "09:42",
      "text": "ಅಷ್ಟ ಮಾಡ ಬರ್ತಾ"
    },
    {
      "t": "09:44",
      "text": "ಹೆಂಗ್ ಹೋಗ ಯಾ"
    },
    {
      "t": "09:46",
      "text": "ೌ"
    },
    {
      "t": "09:48",
      "text": "ತ ಆಗ ಬೇಜಾರ ಆಗ"
    },
    {
      "t": "09:50",
      "text": "ಯಾರ"
    },
    {
      "t": "09:52",
      "text": "ಅ ಬೇಜಾರತ್ಲ್ಲಿ ಕವಿ"
    },
    {
      "t": "09:54",
      "text": "ಮನ ಆಗರ್ತಾನ"
    },
    {
      "t": "09:56",
      "text": "ಎಲ್ಲ ಬೆ"
    },
    {
      "t": "09:58",
      "text": "ಬಜಾರ್ತ"
    },
    {
      "t": "10:00",
      "text": "ಹಾ"
    },
    {
      "t": "10:02",
      "text": "ತಳದಕ್ ಹೋತ್ ನೋಡ್ ಬೇಜಾರಿ"
    },
    {
      "t": "10:04",
      "text": "ಸ ನೀ ಮಾತಾಡ ಬಾರಿ"
    },
    {
      "t": "10:06",
      "text": "ವಿಷಯಲ್ಲ ಸ ಶ"
    },
    {
      "t": "10:08",
      "text": "ಹೌದಾ"
    },
    {
      "t": "10:10",
      "text": "ಹ"
    },
    {
      "t": "10:12",
      "text": "ಹ್ಮ್ ಮತ್ತಾ"
    },
    {
      "t": "10:14",
      "text": "ಶಾವಣ ಮೋಸಮ ಮ"
    },
    {
      "t": "10:16",
      "text": "ಚಿನ್ನಂಗಲ್ಲ ಬಿಡಾಂಗಲ್ಲ ನಾನುು ತಿಳಿಾಟ್ಟಿದ್ದಿಲ್ಲ"
    },
    {
      "t": "10:18",
      "text": "ನಾವು ಏನ್ ತಿನ್ನ"
    },
    {
      "t": "10:20",
      "text": ""
    },
    {
      "t": "10:22",
      "text": "ನಮಗೂ ಅದ ಬಳೆ ನಿ"
    },
    {
      "t": "10:24",
      "text": "ಬಣ"
    },
    {
      "t": "10:26",
      "text": "ಲಂಗ್ವೇಜ್ ಕಿಂತನು ಏ"
    },
    {
      "t": "10:28",
      "text": "ನಾನ್ ವಜ್ ಚಗಳ್ಳಿ"
    },
    {
      "t": "10:30",
      "text": "ಕಖಾತೂರ್ಗೆ ಪಾಪ ಹಬ್ಬತ್"
    },
    {
      "t": "10:32",
      "text": "ತಕ್ಷಣ ಕರಿ ಅಂತ ಮಾಡ್ತಾರಲ್ಲ"
    },
    {
      "t": "10:34",
      "text": "ಹೌತವಾ"
    },
    {
      "t": "10:36",
      "text": "ಅವ ಪತಿಯ"
    },
    {
      "t": "10:38",
      "text": "ಜಾರಾಗಿ ಹೋಗೋದ ಮ್ರೆ ಅಷ್ಟು ಸರಿ"
    },
    {
      "t": "10:40",
      "text": "ಕರ್ಸ್ರೆ ಮರಿ ಹೊಣದದು ಕುರಿ ಹೊಣದು"
    },
    {
      "t": "10:42",
      "text": "ಹಾ"
    },
    {
      "t": "10:44",
      "text": "ಪಾಪಾ ಅವ ನಮ್ಮ ರವಿ"
    },
    {
      "t": "10:46",
      "text": "ರ್ಕ ದಾರಿನ ಹೊಸ"
    },
    {
      "t": "10:48",
      "text": "ತರದ ಹಬಟ್ಟ"
    },
    {
      "t": "10:50",
      "text": "ಹಓ"
    },
    {
      "t": "10:52",
      "text": "ಏನು ಮಾಡಕ್ ಆಗಲ್ಲ"
    },
    {
      "t": "10:54",
      "text": "ಅವ್ರದ ಮುಗಿತ ಅಂದ್ರೆ ಹೋಗ್ತಾ ಇರದ"
    },
    {
      "t": "10:56",
      "text": "ಯಾಪ"
    },
    {
      "t": "10:58",
      "text": "ಮತ್ಸಗಳು ಕಾಟ್ಟಲ ಬ"
    },
    {
      "t": "11:00",
      "text": "ಎಸ ಗದಲ್ಲ"
    },
    {
      "t": "11:02",
      "text": "ಸಗ"
    },
    {
      "t": "11:04",
      "text": "ಸತ್ತೆ ವಳ ಸಿಿಗುಲ್ಲ"
    },
    {
      "t": "11:06",
