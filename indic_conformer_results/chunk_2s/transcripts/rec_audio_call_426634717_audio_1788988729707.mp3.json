    },
    {
      "t": "00:06",
      "text": "கேக்குதா"
    },
    {
      "t": "00:08",
      "text": "உம்"
    },
    {
      "t": "00:10",
      "text": "க்கு ஜ"
    },
    {
      "t": "00:12",
      "text": "பச்சிய அப்பனா"
    },
    {
      "t": "00:14",
      "text": "பேசல"
    },
    {
      "t": "00:16",
      "text": "உ"
    },
    {
      "t": "00:18",
      "text": "கொஞ்சம் நம்பர் சொல்றியா"
    },
    {
      "t": "00:20",
      "text": "அலயட்டு"
    },
    {
      "t": "00:22",
      "text": "ஏ இதுல காய ம"
    },
    {
      "t": "00:24",
      "text": ""
    },
    {
      "t": "00:26",
      "text": "ந ந ப"
    },
    {
      "t": "00:28",
      "text": "மு வி"
    },
    {
      "t": "00:30",
      "text": "ஆமா"
    },
    {
      "t": "00:32",
      "text": "செமா மூடுலதான் இருக்குங்க"
    },
    {
      "t": "00:34",
      "text": "ம் ஆ"
    },
    {
      "t": "00:36",
      "text": "சமம் அ்வளவுதான் இருக்கேன்"
    },
    {
      "t": "00:38",
      "text": "அதான் நம்பர் சொல்லலாம்"
    },
    {
      "t": "00:40",
      "text": "நம் என்ன சொல்லுங்கட"
    },
    {
      "t": "00:42",
      "text": "இ"
    },
    {
      "t": "00:44",
      "text": "உம் நான் சும்ம போ"
    },
    {
      "t": "00:46",
      "text": "பேசட்டுப்படுான் அவளதான்"
    },
    {
      "t": "00:48",
      "text": "சரிய உங்களுக்கு கூட விரல போட்டா"
    },
    {
      "t": "00:50",
      "text": "கஞ்சி ஒழுுவமா"
    },
    {
      "t": "00:52",
      "text": "உம் கண்டச அன"
    },
    {
      "t": "00:54",
      "text": "து உம்"
    },
    {
      "t": "00:56",
      "text": "என்"
    },
    {
      "t": "00:58",
      "text": "சரி"
    },
    {
      "t": "01:00",
      "text": "வர வேண்டியது வர"
    },
    {
      "t": "01:02",
      "text": "உம்"
    },
    {
      "t": "01:04",
      "text": "உங்களுக்கு உட்டா உள்ள வடும்போது"
    },
    {
      "t": "01:06",
      "text": "ர் குபில"
    },
    {
      "t": "01:08",
      "text": "சரி பத்துக்கே போற"
    },
    {
      "t": "01:10",
      "text": "உ"
    },
    {
      "t": "01:12",
      "text": ""
    },
    {
      "t": "01:14",
      "text": "பேின்றனர்"
    },
    {
      "t": "01:16",
      "text": "உம் உம்"
    },
    {
      "t": "01:18",
      "text": "உம்"
    },
    {
      "t": "01:20",
      "text": "பிளீஸ் நம்பர் சொல்ல"
    },
    {
      "t": "01:22",
      "text": "பஜழ ப க"
    },
    {
