    {
      "t": "00:02",
      "text": "ஹலோம்"
    },
    {
      "t": "00:04",
      "text": "ஆஹ"
    },
    {
      "t": "00:06",
      "text": "என்ன இந்த கால் பண்றீங்க"
    },
    {
      "t": "00:08",
      "text": "நவமரமி"
    },
    {
      "t": "00:10",
      "text": "அம்பும்"
    },
    {
      "t": "00:12",
      "text": "ஓகே ஓகே ஆப்பய"
    },
    {
      "t": "00:14",
      "text": "ஓகேல்ல"
    },
    {
      "t": "00:16",
      "text": "என்ன என்ன பண்றீங்க"
    },
    {
      "t": "00:18",
      "text": "உம் அவருக்கு போயட்டு இரு"
    },
    {
      "t": "00:20",
      "text": "இருக்கேன் இப்போ சும்மாதான் ரூம்ல இருக்கேன்"
    },
    {
      "t": "00:22",
      "text": "நீவன்ிக்கு"
    },
    {
      "t": "00:24",
      "text": "உம் ே"
    },
    {
      "t": "00:26",
      "text": "ஓகே ஓகே நானும் ஒரு பிரைவேட் க"
    },
    {
      "t": "00:28",
      "text": "ஒர்க் பண்ணிட்டு இருக்கறே"
    },
    {
      "t": "00:30",
      "text": "லை நானும் ீவு்"
    },
    {
      "t": "00:32",
      "text": "எ ச"
    },
    {
      "t": "00:34",
      "text": "ம் அப்புறம் சொல்லுங்க லன்்சு முடி"
    },
    {
      "t": "00:36",
      "text": "வ"
    },
    {
      "t": "00:38",
      "text": "முடிஞ்சிட்டு தான் பாத்துருந்தேன்"
    },
    {
      "t": "00:40",
      "text": "ஓகே ஓகே என்ன சாப்பிட்டீங்க"
    },
    {
      "t": "00:42",
      "text": "சாாதம் தான் சாதம்"
    },
    {
      "t": "00:44",
      "text": "தயிர் ஆஹ"
    },
    {
      "t": "00:46",
      "text": "பயர் இரு"
    },
    {
      "t": "00:48",
      "text": ""
    },
    {
      "t": "00:50",
      "text": "சொல்ல லைஃப்ன்ன எப்படி போகுது"
    },
    {
      "t": "00:52",
      "text": "ஏதப்பு"
    },
    {
      "t": "00:54",
      "text": "உங்களுக்குஹ"
    },
    {
      "t": "00:56",
      "text": "உம்ம்"
    },
    {
      "t": "00:58",
      "text": ""
    },
    {
      "t": "01:00",
      "text": "அப்புறம் சொல்லுங்க"
    },
    {
      "t": "01:02",
      "text": "வேற"
    },
    {
      "t": "01:04",
      "text": "வேற என்ன சத்தரது"
    },
    {
      "t": "01:06",
      "text": "வேற என்ன சொல்ற இந்த எத்த நாள்"
    },
    {
      "t": "01:08",
      "text": "பேஸ் பண்ணிட்டு இருக்கீங்க"
    },
    {
      "t": "01:10",
      "text": "ப்பி பல ஜஸ்ட ஒரு ஒக்கா"
    },
    {
      "t": "01:12",
      "text": "வந்துட்டு"
    },
    {
      "t": "01:14",
      "text": "எப்படி பேசுறாங்க"
    },
    {
      "t": "01:16",
      "text": "ஒருொத்தரு ஜாலியா பேசுறாங்க"
    },
    {
      "t": "01:18",
      "text": "அத்த சக்ஸி அபசக்கான"
    },
    {
      "t": "01:20",
      "text": "உ உம்"
    },
    {
      "t": "01:22",
      "text": "யரு எப்படி பேசுறாங்களோ அப்படி பேிட்டு போயிருதான்"
    },
    {
      "t": "01:24",
      "text": "சரி"
    },
    {
      "t": "01:26",
      "text": "இ அவங்களுக்கு"
    },
    {
      "t": "01:28",
      "text": "ஜாலிய பேசகறது படிச்சிருக்கல்ல செக்ஸாக பேசகற"
    },
    {
      "t": "01:30",
      "text": "வச்சிருப்ப"
    },
    {
      "t": "01:32",
      "text": "இ ரண்டு மேேதா"
    },
    {
      "t": "01:34",
      "text": "ஏதோ ஒடு தான் சொல்லுவாும் ரெண்டு மூணு நா"
    },
    {
      "t": "01:36",
      "text": "ஜாலியா பேசுற கிட்ட"
    },
    {
      "t": "01:38",
      "text": "பே சங்க ச ச"
    },
    {
      "t": "01:40",
      "text": "சிகஸ பேசிதான்"
    },
    {
      "t": "01:42",
      "text": "ஆ"
    },
    {
      "t": "01:44",
      "text": "அப்ப"
    },
    {
      "t": "01:46",
      "text": "சொல்லுங்க"
    },
    {
      "t": "01:48",
      "text": "தொண்ணூறு ஐம்பதுா இல்ல"
    },
    {
      "t": "01:50",
      "text": "உம் சொந்தர ஐம்பது தான்"
    },
    {
      "t": "01:52",
      "text": "அே"
    },
    {
      "t": "01:54",
      "text": "வீடல வீட்டுல ம"
    },
    {
      "t": "01:56",
      "text": "மட்ட"
    },
    {
      "t": "01:58",
      "text": "ஆ"
    },
    {
      "t": "02:00",
      "text": "அப்புறம் கேர்ள் ஃப்ரண்ட்ஸ் எல்லாம் இருக்கிறாங்களா"
    },
    {
      "t": "02:02",
      "text": "ஆஹ் கேக்கண்ட அந்த இததுக்கு அல"
    },
    {
      "t": "02:04",
      "text": "ம் அத ஏங்க எல்லார"
    },
    {
      "t": "02:06",
      "text": "டையலாக் போடு க பண்ண இருந்தா ஏங்க"
    },
    {
      "t": "02:08",
      "text": "நாங்க இந்த இத்து போறோம் அப்படின்னு"
    },
    {
      "t": "02:10",
      "text": "உஹம் உண்மையான விஷயம் தானே"
    },
    {
