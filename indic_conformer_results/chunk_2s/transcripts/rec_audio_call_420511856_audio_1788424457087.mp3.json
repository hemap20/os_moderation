      "text": "சரியா போயிடால ஆமா"
    },
    {
      "t": "02:16",
      "text": ""
    },
    {
      "t": "02:18",
      "text": "சொல்லுங்க"
    },
    {
      "t": "02:20",
      "text": "உஹம் அப்புறம்"
    },
    {
      "t": "02:22",
      "text": "ஆஹ வே வே"
    },
    {
      "t": "02:24",
      "text": "என்ன சொ"
    },
    {
      "t": "02:26",
      "text": "சொல்றது யாரெல்ல கேட்கறதுன்னு தெரியவ"
    },
    {
      "t": "02:28",
      "text": "உம் உ"
    },
    {
      "t": "02:30",
      "text": "க்கங்களன்னு சொல்றேன்"
    },
    {
      "t": "02:32",
      "text": "புரியல ஏதாச்சும்"
    },
    {
      "t": "02:34",
      "text": "கேறங்க அதல்ல சொல்லுங்க"
    },
    {
      "t": "02:36",
      "text": "க்கத"
    },
    {
      "t": "02:38",
      "text": "உ"
    },
    {
      "t": "02:40",
      "text": ""
    },
    {
      "t": "02:42",
      "text": "நீங்க ஏதா"
    },
    {
      "t": "02:44",
      "text": "நான்தான் சொல்றேன் நீங்க"
    },
    {
      "t": "02:46",
      "text": "எ பேசனங்க"
    },
    {
      "t": "02:48",
      "text": "என்னா ஜாலியாாதான் பேசுறன் ஆனா சரி"
    },
    {
      "t": "02:50",
      "text": "சப்பசமாட்ட நார்மல்"
    },
    {
      "t": "02:52",
      "text": "ஓகே ஜாலியா பேச தான் போவம்"
