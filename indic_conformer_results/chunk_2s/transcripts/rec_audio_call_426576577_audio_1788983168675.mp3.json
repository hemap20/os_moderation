{
  "file_id": "rec_audio_call_426576577_audio_1788983168675.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 962.614,
  "processing_time_sec": 35.1939640045166,
  "segments": [
    {
      "t": "00:00",
      "text": "ஹலோ"
    },
    {
      "t": "00:02",
      "text": "ம் சொல்லுங்க"
    },
    {
      "t": "00:04",
      "text": "அஹ"
    },
    {
      "t": "00:06",
      "text": "இனம்"
    },
    {
      "t": "00:08",
      "text": "சர்லனா"
    },
    {
      "t": "00:10",
      "text": "புரியலங்க சம"
    },
    {
      "t": "00:12",
      "text": "மா"
    },
    {
      "t": "00:14",
      "text": "அனங்க தணேஷா"
    },
    {
      "t": "00:16",
      "text": "இல்ல இல்ல இதர தின"
    },
    {
      "t": "00:18",
      "text": "கௌதம் என்ன"
    },
    {
      "t": "00:20",
      "text": "ஓகே அப்போ தினேஷ்ன்றது"
    },
    {
      "t": "00:22",
      "text": "சல்ல நப்ப"
    },
    {
      "t": "00:24",
      "text": "ஐடியில பத்தா தான் வருது"
    },
    {
      "t": "00:26",
      "text": "ஓகே ஓகே ஓகே உம்"
    },
    {
      "t": "00:28",
      "text": "ஓகே"
    },
    {
      "t": "00:30",
      "text": "சொல்லோ"
    },
    {
      "t": "00:32",
      "text": "சேலம் ஸ்"
    },
    {
      "t": "00:34",
      "text": "ஓகே கே நந்துிருச்சிங்க"
    },
    {
      "t": "00:36",
      "text": "இப்ப எங்க இருக்கீங்க"
    },
    {
      "t": "00:38",
      "text": "பேச்ச"
    },
    {
      "t": "00:40",
      "text": "ஹம் உம்"
    },
    {
      "t": "00:42",
      "text": "பப்பன் கன"
    },
    {
      "t": "00:44",
      "text": "நீ"
    },
    {
      "t": "00:46",
      "text": "வட"
    },
    {
      "t": "00:48",
      "text": "ங்க உம் உம்"
    },
    {
      "t": "00:50",
      "text": "கே ஓகே ஆனதடு தாங்க"
    },
    {
      "t": "00:52",
      "text": "அப்படியா உம்"
    },
    {
      "t": "00:54",
      "text": "கேட்டு கேட்ட ச"
    },
    {
      "t": "00:56",
      "text": "இல்ல வாயசு கேட்ட"
    },
    {
      "t": "00:58",
      "text": "மேல் மாத்தல்ல சல ஆிட்ட"
    },
    {
      "t": "01:00",
      "text": "அப்படியா கே ஓகே"
    },
    {
      "t": "01:02",
      "text": "உம் பேபிஸ்"
    },
    {
      "t": "01:04",
      "text": "வேண்ட பாப்பா"
    },
    {
      "t": "01:06",
      "text": "ஓகே ஓகே ஸ்கூல் போறாங்களா"
    },
    {
      "t": "01:08",
      "text": "உம்"
    },
    {
      "t": "01:10",
      "text": "பெரிய பாப்பா எல்கேஜி"
    },
    {
      "t": "01:12",
      "text": "என்ன பாப்பாவுக்கு ரெண்டு வயசு"
    },
    {
      "t": "01:14",
      "text": "ஓகே சப்பர் சூப்பர்"
    },
    {
      "t": "01:16",
      "text": "் அவச்சான"
    },
    {
      "t": "01:18",
      "text": "பற"
    },
    {
      "t": "01:20",
      "text": "எற்ற உங்க சேலமா"
    },
    {
      "t": "01:22",
      "text": "நான்் இங்க ஷஃப் ஆி பைவ் ம்ஸ் ஆகதது"
    },
    {
      "t": "01:24",
      "text": "சேல மந்திர"
    },
    {
      "t": "01:26",
      "text": "ஆமா ஆமா"
    },
    {
      "t": "01:28",
      "text": "ஓகே செலவன் எங்க இருக்கீங்க"
    },
    {
      "t": "01:30",
      "text": "ஆத்தர்"
    },
    {
      "t": "01:32",
      "text": "ஆஹ ஓகே ஓகே"
    },
    {
      "t": "01:34",
      "text": "உம்"
    },
    {
      "t": "01:36",
      "text": "யாருக்குங்க"
    },
    {
      "t": "01:38",
      "text": "உங்கேஜ்"
    },
    {
      "t": "01:40",
      "text": "ி நன்"
    },
    {
      "t": "01:42",
      "text": ""
    },
    {
      "t": "01:44",
      "text": "ரெண்டு வயசு பெருச"
    },
    {
      "t": "01:46",
      "text": "சட்டி ஒண்டா"
    },
    {
      "t": "01:48",
      "text": "ஆமா ஆமா"
    },
    {
      "t": "01:50",
      "text": "பரவலாம் இருக்கட்டும் எனால என்ன"
    },
    {
      "t": "01:52",
      "text": "பேச கூடது"
    },
    {
      "t": "01:54",
      "text": "கூட அதெல்லாம்"
    },
    {
      "t": "01:56",
      "text": "அப்படின்னாங்கள என்ன அக்கம்னு சொல்ல"
    },
    {
      "t": "01:58",
      "text": ""
    },
    {
      "t": "02:00",
      "text": "கே என்ன சொல்லுங்க"
    },
    {
      "t": "02:02",
      "text": "உ ஆஹ"
    },
    {
      "t": "02:04",
      "text": "ஆளாம் முடியாது"
    },
    {
      "t": "02:06",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "02:08",
      "text": "வயசு நல்லா இருக்கு"
    },
    {
      "t": "02:10",
      "text": "தேங்கயூ"
    },
    {
      "t": "02:12",
      "text": "உம்"
    },
    {
      "t": "02:14",
      "text": "அ"
    },
    {
      "t": "02:16",
      "text": "சொல்லுங்க"
    },
    {
      "t": "02:18",
      "text": "இல்ல நீங்க எதவும் கேட்டுட்டு நீங்க சொல்லுங்க"
    },
    {
      "t": "02:20",
      "text": "ந அதுக்குள்ள நடு கேட்டுட்டு வர டக்குன்ன"
    },
    {
      "t": "02:22",
      "text": "நான் ஒண்ணும் கேட்க வரலேன்"
    },
    {
      "t": "02:24",
      "text": "வயச எங்க"
    },
    {
      "t": "02:26",
      "text": "அதுங்க ஊர்ல இருக்காங்க"
    },
    {
      "t": "02:28",
      "text": "ஊருக்கு போயிருக்காங்களா"
    },
    {
      "t": "02:30",
      "text": "ஆமாமாங்க அத"
    },
    {
      "t": "02:32",
      "text": "நீங்க வந்து குதுவ கலமா இருக்கலாம்னு வந்தீங்களா"
    },
    {
      "t": "02:34",
      "text": "என்னோட நீங்க தான் குதுக்கலாம்"
    },
    {
      "t": "02:36",
      "text": "இருக்கீங்க ஏன் உ சொ"
    },
    {
      "t": "02:38",
      "text": "ங்க ஓ நான் வந்து நிரந்தரமா"
    },
    {
      "t": "02:40",
      "text": "வந்துட்டனா"
    },
    {
      "t": "02:42",
      "text": "ப்பவி"
    },
    {
      "t": "02:44",
      "text": "அ"
    },
    {
      "t": "02:46",
      "text": "உம் உம்"
    },
    {
      "t": "02:48",
      "text": "உங்க கேசுறேன் பாப்பா"
    },
    {
      "t": "02:50",
      "text": "ஒ ஒரே பொண்ணு"
    },
    {
      "t": "02:52",
      "text": "தய சாட்சி"
    },
    {
      "t": "02:54",
      "text": "ஓகே ஓகே மேரேஜ் ஆய"
    },
    {
      "t": "02:56",
      "text": "மூணு நாலு வருஷம் அகுதான்"
    },
    {
      "t": "02:58",
      "text": ""
    },
    {
      "t": "03:00",
      "text": "லவ் மேரேஜ் ஆ"
    },
    {
      "t": "03:02",
      "text": "இல்லைங்க ஆரைஞ்சுதான்"
    },
    {
      "t": "03:04",
      "text": "நீங்களவா"
    },
    {
      "t": "03:06",
      "text": "இல்ல அரேஞ்ச"
    },
    {
      "t": "03:08",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "03:10",
      "text": "இந்த டை உங்களுக்கு தெளிவ வாங்கஸ் கேக்குிறீா நீ"
    },
    {
      "t": "03:12",
      "text": "கேக்குது என்ன பண்றீங்க"
    },
    {
      "t": "03:14",
      "text": "தங்கலையா"
    },
    {
      "t": "03:16",
      "text": "இல்ல இல்ல நான்"
    },
    {
      "t": "03:18",
      "text": "மவுத் பீஸ் கிட்ட போன் வச்சு"
    },
    {
      "t": "03:20",
      "text": "வாய் வச்சு பேசிட்டு இருக்கேன்"
    },
    {
      "t": "03:22",
      "text": "ஓகே ஓகே சரி சரி"
    },
    {
      "t": "03:24",
      "text": "சரி"
    },
    {
      "t": "03:26",
      "text": "பம் தூங்கிட்டாங்கள"
    },
    {
      "t": "03:28",
      "text": "ட்டாங்க மானரோட"
    },
    {
      "t": "03:30",
      "text": "நீங்க இருக்கிறது இல்ல நீங்க சொ எத்தனியே வந்திருக்கீங்க"
    },
    {
      "t": "03:32",
      "text": "தனி எனக்கு மாமனார்"
    },
    {
      "t": "03:34",
      "text": "யற ரெண்டு பேருமே இல்ல வேற வந்துட்டுா"
    },
    {
      "t": "03:36",
      "text": "இப்படி யாரோட இது இல்லாம நீ"
    },
    {
      "t": "03:38",
      "text": "தனியா வந்து இருக்கீங்க ரொம்ப இடுத்து"
    },
    {
      "t": "03:40",
      "text": "ரூம்ப எடுத்துல வீடு எடுத்து"
    },
    {
      "t": "03:42",
      "text": "அத சரி"
    },
    {
      "t": "03:44",
      "text": "இருக்கீங்க எனக்கு அம்மா வீடு சைடு ஒன் ஹஸ்"
    },
    {
      "t": "03:46",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "03:48",
      "text": "ஆஹ் எனக்கு அதது கொஞ்சம் கொஞ்ச"
    },
    {
      "t": "03:50",
      "text": "ன்ஸ்ட்ரஷன் ஒர்க்கு இருக்கு அது கொஞ்சம்"
    },
    {
      "t": "03:52",
      "text": "பெயிண்டிங் ஒர்க் முடிக்கணும்"
    },
    {
      "t": "03:54",
      "text": "சோ அது வரைக்கும் நீங்க"
    },
    {
      "t": "03:56",
      "text": "வாடகை எடுத்து தங்கிிருக்கேன்"
    },
    {
      "t": "03:58",
      "text": "அவங்க எல்லாம் வந்து எனக்கு சப்போர்ட் பண்றா"
    },
    {
      "t": "04:00",
      "text": "வரான் கேட்டேன் யாருமே"
    },
    {
      "t": "04:02",
      "text": "எல்லாம எப்படி சப்பர்ட் இல்லாம எங்க இருக்கீங்களாான் கேன்"
    },
    {
      "t": "04:04",
      "text": "அந்த மாதிரில்லாம் இருக்க முடியாது இருக்க"
    },
    {
      "t": "04:06",
      "text": "அங்க பக்கத்துல எனக்கு எல்லாருமே"
    },
    {
      "t": "04:08",
      "text": "அம்மா தாத்தா பாட்டி"
    },
    {
      "t": "04:10",
      "text": "அம்மா அப்பா அன பமிலி"
    },
    {
      "t": "04:12",
      "text": "சித்தி ஃபேமிலி தம்பி ஃேமிலி"
    },
    {
      "t": "04:14",
      "text": "சுத்தி இங்கதான் இருக்காங்க"
    },
    {
      "t": "04:16",
      "text": "ச"
    },
    {
      "t": "04:18",
      "text": "உம்"
    },
    {
      "t": "04:20",
      "text": "சரி சரி அதான் கேட்டன சரி"
    },
    {
      "t": "04:22",
      "text": "அப்பும் அங்கிருந்து ஆத்தர் வந்து தனிய இருக்கீங்க கேட்டன்"
    },
    {
      "t": "04:24",
      "text": "உம் இதுதான் நான் பொறந்து வளர்ந்த ஊரு"
    },
    {
      "t": "04:26",
      "text": "ஆக்சுவலா சென்னை சென்னைக்கு"
    },
    {
      "t": "04:28",
      "text": "கல்ாண மணிக்கு போய் பத்து வருஷம்"
    },
    {
      "t": "04:30",
      "text": "பத்து வருஷத்துக்கு அப்புறம் இப்பதான் வரேன்"
    },
    {
      "t": "04:32",
      "text": "ேேே"
    },
    {
      "t": "04:34",
      "text": "ஒரு கே போறீங்களா"
    },
    {
      "t": "04:36",
      "text": "உம்"
    },
    {
      "t": "04:38",
      "text": "ஒர்க போறீங்களா இ"
    },
    {
      "t": "04:40",
      "text": "இப்போதைக்கு எதுவும் ஒ இருக்கல்ல பாசங்கல்லாம் குடு"
    },
    {
      "t": "04:42",
      "text": "இருக்கா"
    },
    {
      "t": "04:44",
      "text": "உம்"
    },
    {
      "t": "04:46",
      "text": "எவ்வளவு நாால யூஸ் பண்ணீங்க ஆப்"
    },
    {
      "t": "04:48",
      "text": "ந ரொம்ப நாலு நாள்"
    },
    {
      "t": "04:50",
      "text": "இன்ஸ்டால் பண்ணன் ஆனா ரெகுலர்"
    },
    {
      "t": "04:52",
      "text": "யூசர் கிடையாது அகே ந வ"
    },
    {
      "t": "04:54",
      "text": "ஓகே கே"
    },
    {
      "t": "04:56",
      "text": "சேரிமா அதே மாதிரி நானே"
    },
    {
      "t": "04:58",
      "text": "ப் போனாங்கள மட்ட தான்ய பண்ணுவ அந்தபடி"
    },
    {
      "t": "05:00",
      "text": "வர மாட்டேன் ரொம்ப ரதுதான்"
    },
    {
      "t": "05:02",
      "text": "உம்"
    },
    {
      "t": "05:04",
      "text": "வயசு நல்ல அவ்ளோ பயமா"
    },
    {
      "t": "05:06",
      "text": "என் பயனல்ல"
    },
    {
      "t": "05:08",
      "text": "இந்த எதுக்கு தேவளாவது பிரச்சனை அந்த மாதிரி"
    },
    {
      "t": "05:10",
      "text": "ஹம் உஹம்"
    },
    {
      "t": "05:12",
      "text": "அவங்க எப்படி ஆல"
    },
    {
      "t": "05:14",
      "text": ""
    },
    {
      "t": "05:16",
      "text": "ஓகேதா ரொம்ப ச"
    },
    {
      "t": "05:18",
      "text": "கிடாது ரொம்ப கிடாது ஓகே"
    },
    {
      "t": "05:20",
      "text": "அ உம் உங்களுக்கு ரொம்ப"
    },
    {
      "t": "05:22",
      "text": "ரொம்ப பிடிக்குமா அவங்க வயச ஆச்ச"
    },
    {
      "t": "05:24",
      "text": "ரொம்ப பிடிக்கலாம் கிடையாது செவன்ி"
    },
    {
      "t": "05:26",
      "text": "்டிடி"
    },
    {
      "t": "05:28",
      "text": "சண்டை போட்டு எக்க குடிக்க"
    },
    {
      "t": "05:30",
      "text": "அவங்க என்ன படிச்சிருக்காங்க நீங்க என்ன படிச்சிருக்கீங்க"
    },
    {
      "t": "05:32",
      "text": "நம்பி மெக்கானிக்க"
    },
    {
      "t": "05:34",
      "text": "அவங்க வந்து எம் எஸ் பிஎட்"
    },
    {
      "t": "05:36",
      "text": "உம்"
    },
    {
      "t": "05:38",
      "text": "நானும் அதான்"
    },
    {
      "t": "05:40",
      "text": "நீக்க"
    },
    {
      "t": "05:42",
      "text": "ஓகே"
    },
    {
      "t": "05:44",
      "text": "நி சிக"
    },
    {
      "t": "05:46",
      "text": "அிசிக்"
    },
    {
      "t": "05:48",
      "text": "அப்படியடியா"
    },
    {
      "t": "05:50",
      "text": "ஆமா உம்"
    },
    {
      "t": "05:52",
      "text": ""
    },
    {
      "t": "05:54",
      "text": "அதனாலே பாப்பாக்கா"
    },
    {
      "t": "05:56",
      "text": "போலீங்கள தான் போகணும்"
    },
    {
      "t": "05:58",
      "text": "உம்"
    },
    {
      "t": "06:00",
      "text": "ஆமா போயிட்டு இரு"
    },
    {
      "t": "06:02",
      "text": "அப்படி உங்களுக்கு எடி உளுக்கு ஹஸ்பண்ட் எடி பிடிக்கும்"
    },
    {
      "t": "06:04",
      "text": "எனனக்குயச"
    },
    {
      "t": "06:06",
      "text": "அவளுக்கு சே்த்தாகது"
    },
    {
      "t": "06:08",
      "text": "ய"
    },
    {
      "t": "06:10",
      "text": "உம் அ அவர மத்தரனே அந்தடாங்க"
    },
    {
      "t": "06:12",
      "text": "அ"
    },
    {
      "t": "06:14",
      "text": "அவரோட கேரக்டருக்கு எனக்கு"
    },
    {
      "t": "06:16",
      "text": "மட்ட உள்ளவர யாக்குமே செட ஆது"
    },
    {
      "t": "06:18",
      "text": "சும்மா கோர"
    },
    {
      "t": "06:20",
      "text": "சொல்லணுமேனா நான் சொல்லல"
    },
    {
      "t": "06:22",
      "text": "ரொம்ப ரொம்ப ரொம்ப"
    },
    {
      "t": "06:24",
      "text": "ரொம்ப ரொம்ப நல்ல மனுஷன் அதாவது"
    },
    {
      "t": "06:26",
      "text": "ச அம்மா ஹியூமன் பீயிங் தான்"
    },
    {
      "t": "06:28",
      "text": "பயங்கரதஹென்ஸ்"
    },
    {
      "t": "06:30",
      "text": "இந்த உலகத்திலேயே சிறந்த அப்பா"
    },
    {
      "t": "06:32",
      "text": "சிறந்தமாப ச"
    },
    {
      "t": "06:34",
      "text": "ஒரு குருவுக்கு நல்ல சிஷயன்"
    },
    {
      "t": "06:36",
      "text": "அந்த மாதிரி"
    },
    {
      "t": "06:38",
      "text": "அ"
    },
    {
      "t": "06:40",
      "text": "ஆனா சிறந்த கணவரு கேட்ட"
    },
    {
      "t": "06:42",
      "text": "கட்டா அவக்கு அது மட்டும் வராது"
    },
    {
      "t": "06:44",
      "text": "எதனல"
    },
    {
      "t": "06:46",
      "text": "அவரு பனம் இருந்த அப்படிதான்"
    },
    {
      "t": "06:48",
      "text": "அப்படி எனக்கும் அவருக்கும் நிறைய வயசு வித்தியாசம்"
    },
    {
      "t": "06:50",
      "text": "ஓகே"
    },
    {
      "t": "06:52",
      "text": "ம த"
    },
    {
      "t": "06:54",
      "text": "ஆஹ்"
    },
    {
      "t": "06:56",
      "text": "அவர் வளர்ந்த விதம் வந்து"
    },
    {
      "t": "06:58",
      "text": "ஜென்ரேஷன்ல பெண்கள் வந்து"
    },
    {
      "t": "07:00",
      "text": "ங்க அம்மா எப்படி வாழ்ந்த வாழ்ந்தாங்க"
    },
    {
      "t": "07:02",
      "text": "அதாவது யார் என்ன"
    },
    {
      "t": "07:04",
      "text": "என்ன சொன்னாலும் பதில் பேசாமாம்"
    },
    {
      "t": "07:06",
      "text": "உ அந்த கதவுக்கு பின்ன"
    },
    {
      "t": "07:08",
      "text": "டி ஒளிிஞ்சிருந்து பதில் பேசுற அந்த மாதிரி"
    },
    {
      "t": "07:10",
      "text": "தசே"
    },
    {
      "t": "07:12",
      "text": "தி்ங்கிட்ட அடியே எஸ்பெக்ட்ண்ற அது எப்படி"
    },
    {
      "t": "07:14",
      "text": "அடிங்க முடியும்"
    },
    {
      "t": "07:16",
      "text": "எவளபை ஜந்தஷன் கூ"
    },
    {
      "t": "07:18",
      "text": "கேக்குது ச இவ்ள க"
    },
    {
      "t": "07:20",
      "text": "ஜென்ரேஷன்ல இருக்கீங்க எவ்வளவு பண்ண முடியும்"
    },
    {
      "t": "07:22",
      "text": "ஏ எப்படின்னா ஒரு எய்"
    },
    {
      "t": "07:24",
      "text": "கூட காபி கொட அப்படின்னா"
    },
    {
      "t": "07:26",
      "text": "இப்போ"
    },
    {
      "t": "07:28",
      "text": "என் பேயரு சொல்லி அட்டி"
    },
    {
      "t": "07:30",
      "text": "கொடுமான்னு சொன்னாலே நம்ம"
    },
    {
      "t": "07:32",
      "text": "பத்து பத்துட"
    },
    {
      "t": "07:34",
      "text": "கச கொடுங்க டீ கு கொடுங்க"
    },
    {
      "t": "07:36",
      "text": "அப்படின்னா குடுத்துருவோம் ஏய்"
    },
    {
      "t": "07:38",
      "text": "அப்படி சொன்னோம் செய்யணும்"
    },
    {
      "t": "07:40",
      "text": "நினைக்கிறவங்க கூட செய்ய மாட்டாங்க"
    },
    {
      "t": "07:42",
      "text": "அததான் அவரோட மேச்சர்"
    },
    {
      "t": "07:44",
      "text": "அப்படிதான் அவர் பேசுவார் அவரோட பேசுற"
    },
    {
      "t": "07:46",
      "text": "தோரனு டோனுது"
    },
    {
      "t": "07:48",
      "text": "நமக்கு ஏா நான"
    },
    {
      "t": "07:50",
      "text": "படிச்சிருக்கங்க என்ன"
    },
    {
      "t": "07:52",
      "text": "எனக்கு நானும் படிச்சிருக்கேன் நானும்"
    },
    {
      "t": "07:54",
      "text": "ஓரளவு நல்ல என்ன சொல்றது எங்க"
    },
    {
      "t": "07:56",
      "text": "அவரை விட நல்ல வசதியா வாழ்ந்த பொண்ணு"
    },
    {
      "t": "07:58",
      "text": "நல்லா படிச்சா பொண்ணு சின்ன"
    },
    {
      "t": "08:00",
      "text": "வயசு ச அப்புறம் எதுக்கு"
    },
    {
      "t": "08:02",
      "text": "இந்த மாதிரி ஏஜ் இருக்கு மேரேஜ் பண்ணீங்க அப்படி"
    },
    {
      "t": "08:04",
      "text": "இருக்கு அது வேற"
    },
    {
      "t": "08:06",
      "text": "விங்க விடங்க உ"
    },
    {
      "t": "08:08",
      "text": "ஓகே ஓகே ஓகே ஓகே"
    },
    {
      "t": "08:10",
      "text": "அப்புறம்"
    },
    {
      "t": "08:12",
      "text": "எவ்வளோ பெரிய சோகமான விஷயத்த கூட"
    },
    {
      "t": "08:14",
      "text": "அந்த லைட்ட சிரிச்சிட்டு பேசுறீங்கள"
    },
    {
      "t": "08:16",
      "text": "அத டக்குல மாறிக்குது"
    },
    {
      "t": "08:18",
      "text": "அது ஏன்னா எனக்கு பழக"
    },
    {
      "t": "08:20",
      "text": "போச்சுங்கது"
    },
    {
      "t": "08:22",
      "text": "எனக்கு அவற ஏனோ"
    },
    {
      "t": "08:24",
      "text": "எனக்கு சுத்தமா"
    },
    {
      "t": "08:26",
      "text": "நான் அவரு"
    },
    {
      "t": "08:28",
      "text": "கிட்ட இருந்த நான் வெளியில வந்துட்டேன்"
    },
    {
      "t": "08:30",
      "text": "எனக்கு மனசுல ஒரு சுத்தமா கிடையாது"
    },
    {
      "t": "08:32",
      "text": "ஏன்னா என்ன அந்த அளவுக்கு படுத்திட்டாரு"
    },
    {
      "t": "08:34",
      "text": "அதனது இப்போ"
    },
    {
      "t": "08:36",
      "text": "ஓ எப்படி தெரியுமா"
    },
    {
      "t": "08:38",
      "text": "இ ஒரே ஒரு"
    },
    {
      "t": "08:40",
      "text": "ஒரே ஒரு விஷயம் சொல்றேன் நீங்க அத"
    },
    {
      "t": "08:42",
      "text": "நையே முழுசா புரிஞ்சுப்பீங்க"
    },
    {
      "t": "08:44",
      "text": "சொல்லுங்க சொல்லுங்க எப்படனா"
    },
    {
      "t": "08:46",
      "text": "இப்ப எங்க வீட்டுக்கு அங்க சென்னனைில எனக்கு"
    },
    {
      "t": "08:48",
      "text": "எனக்கு வீட்டு வேலைக்குைக்கு ஆள் வருவாங்க பார்த்து"
    },
    {
      "t": "08:50",
      "text": "பத்த வ பெ தொடக்கடுவாங்க"
    },
    {
      "t": "08:52",
      "text": "வய"
    },
    {
      "t": "08:54",
      "text": "ஆ அது வரைக்கும் எங்கிட்ட நல்லாதான் பேசுவாரு"
    },
    {
      "t": "08:56",
      "text": "விசிரிச்சுட்டு வே பேசிட்டு இருப்பாரு காலையில"
    },
    {
      "t": "08:58",
      "text": "அவங்க பத்து மணிக்கு உள்ள"
    },
    {
      "t": "09:00",
      "text": "நன்றி ஆகும்போது"
    },
    {
      "t": "09:02",
      "text": "என்ன முண்டன்னு சொல்றது"
    },
    {
      "t": "09:04",
      "text": "பெண்டன்னு சொல்றது"
    },
    {
      "t": "09:06",
      "text": "கத்தியில் சொல்றது"
    },
    {
      "t": "09:08",
      "text": "அவரோட"
    },
    {
      "t": "09:10",
      "text": "ட்டோன்னு மாறிடும்டும்"
    },
    {
      "t": "09:12",
      "text": "நான் கேன் இவ்ள நேர நாங்கள தானே பேசுவம்"
    },
    {
      "t": "09:14",
      "text": "சொன்ன ஏன் ஒருத்தவங்க அவங்கட்டு இல்ல"
    },
    {
      "t": "09:16",
      "text": "யாராவது ஒருத்தக்கு முன்னாடி நான் அசிங்கப்படுத்தணும்னு"
    },
    {
      "t": "09:18",
      "text": "நக்கிறேன் அப்போ"
    },
    {
      "t": "09:20",
      "text": "உ பொண்டாட்டி நீ இன்னொருத்தவங்க முன்னாடி"
    },
    {
      "t": "09:22",
      "text": "தேர்ட் பர்சன் முன்னாடி அசிங்கப்படுத்தணும்னு"
    },
    {
      "t": "09:24",
      "text": "நினைக்கும் போதே அந்த இடத்து உனக்குலவ்வே இல்லன்னம்"
    },
    {
      "t": "09:26",
      "text": "உண்மைய உனக்கு"
    },
    {
      "t": "09:28",
      "text": "லவ் இருந்துச்சுன்னா நீ பண்ணம"
    },
    {
      "t": "09:30",
      "text": "மாட்டே அப்படி ஒரு விஷயம்"
    },
    {
      "t": "09:32",
      "text": "அப்படி பண்ணாலுமே ஒரு நாலு செேர்த்த"
    },
    {
      "t": "09:34",
      "text": "நம்மளுக்குள்ள பேசிக்கிற மாதிரி தான ஓகே"
    },
    {
      "t": "09:36",
      "text": "ஆமா நான் நான் கேப்பே நான் தப்பு"
    },
    {
      "t": "09:38",
      "text": "இ போன தப்ப ந இ"
    },
    {
      "t": "09:40",
      "text": "நான் தப்பு பண்ணதா நான் பண்ண மாட்டேங்க ஒன்னு"
    },
    {
      "t": "09:42",
      "text": "ே நான் பண்ணதாவே இருக்கட்டும்"
    },
    {
      "t": "09:44",
      "text": "அ"
    },
    {
      "t": "09:46",
      "text": "அப்படிய வந்திருக்கா"
    },
    {
      "t": "09:48",
      "text": "ஆஹ் புரியலாம்"
    },
    {
      "t": "09:50",
      "text": "இல்ல அப்படி அப்படியே இன்ச நடந்தக்கான ஒரு வேல"
    },
    {
      "t": "09:52",
      "text": "அவர் பேசுறதுக்கு"
    },
    {
      "t": "09:54",
      "text": "என்ன மாதிரே"
    },
    {
      "t": "09:56",
      "text": "இல்லலை ஏனா தப்பாிச்ச நடந்திருக்கான்னு கேடக்குறேன்"
    },
    {
      "t": "09:58",
      "text": "நான் தப்பு பண்ண மாதிரியா"
    },
    {
      "t": "10:00",
      "text": "இல்ல நீங்க பண்ண மாதிரில அவரு"
    },
    {
      "t": "10:02",
      "text": "பண்றோ நம்ள இருக்கு கே்கேன்"
    },
    {
      "t": "10:04",
      "text": "ஆஹ் இந்த மாதிரி நிறைய பண்ணுவாருங்க"
    },
    {
      "t": "10:06",
      "text": "ஓகே"
    },
    {
      "t": "10:08",
      "text": "இப்படிதான் என்ன என்ன ட்ரீட் பண்ற"
    },
    {
      "t": "10:10",
      "text": "விதமே இதான் இப்படிதான்"
    },
    {
      "t": "10:12",
      "text": "ச"
    },
    {
      "t": "10:14",
      "text": "நான் ஒரு பேக்கெட்ல இருந்து பணமே எடுடுத்திருக்க"
    },
    {
      "t": "10:16",
      "text": "மா"
    },
    {
      "t": "10:18",
      "text": "சொல்ல ஆ எதுக்கு என் பாக்கெட்ல"
    },
    {
      "t": "10:20",
      "text": "இருந்து அவங்க முன்னாடி கத்துவாரு அவங்கக்க"
    },
    {
      "t": "10:22",
      "text": "காதல விளற மாதிரி எதுக்கு பா"
    },
    {
      "t": "10:24",
      "text": "ந்து பணம் எடுத்த உனுக்குல்லாம் அறிவில் இல்"
    },
    {
      "t": "10:26",
      "text": "ல்லையா ஆஹ எத்தனை"
    },
    {
      "t": "10:28",
      "text": "முறை சொல்றது என் பேக்கெட்ல இருந்து காசு எடுக்காது"
    },
    {
      "t": "10:30",
      "text": "சொல்லி நீ கை வச்சாலே வழங்காதுன்ன உனக்கு"
    },
    {
      "t": "10:32",
      "text": "தெரியாதா"
    },
    {
      "t": "10:34",
      "text": "ோ பேசுறேங்க"
    },
    {
      "t": "10:36",
      "text": "இப்படிதான் ஒரு பேசுவாரு"
    },
    {
      "t": "10:38",
      "text": "கு கு கு கு கு"
    },
    {
      "t": "10:40",
      "text": "சரி சரி சரி"
    },
    {
      "t": "10:42",
      "text": "சரிம்மா சரிம்மா சரிமா"
    },
    {
      "t": "10:44",
      "text": "ஆமா"
    },
    {
      "t": "10:46",
      "text": "ஆ"
    },
    {
      "t": "10:48",
      "text": "அந்த மாதிரி இருக்கு மனுஷன்"
    },
    {
      "t": "10:50",
      "text": "கிட்ட நம்ாம எப்படிங்கா இருக்க முடியும்"
    },
    {
      "t": "10:52",
      "text": "உஹ"
    },
    {
      "t": "10:54",
      "text": "ஆ"
    },
    {
      "t": "10:56",
      "text": "ப சொ"
    },
    {
      "t": "10:58",
      "text": "வர்ும் பண்ண மாட்டா டவவர்ஸ் கொடுக்க மாட்டன்"
    },
    {
      "t": "11:00",
      "text": "தர"
    },
    {
      "t": "11:02",
      "text": "சமி நான் சொல்லிட்டு மான்"
    },
    {
      "t": "11:04",
      "text": "ஃப்ரெண்ட்ஷிப்பா இருக்கலாமா"
    },
    {
      "t": "11:06",
      "text": "ஏ க நீங்க"
    },
    {
      "t": "11:08",
      "text": "சும்மா இறங்கங்க"
    },
    {
      "t": "11:10",
      "text": "நல்ல நோனும் கே்கறோது"
    },
    {
      "t": "11:12",
      "text": "அப்பல்லாம் இல்ல நீவ்ள ஷே பண்ணறப்ப கேற"
    },
    {
      "t": "11:14",
      "text": "உம் அந்த மாதிரி"
    },
    {
      "t": "11:16",
      "text": "ந நம்ம ஃப்ரெண்ட்ஷிப்பா இருக்கணும் ஆனா அதது"
    },
    {
      "t": "11:18",
      "text": "அதை தாண்டி எனக்கு வேற எந்த இது"
    },
    {
      "t": "11:20",
      "text": "எனக்கு வேண்டாம் என் வேணா"
    },
    {
      "t": "11:22",
      "text": "அக்கன் கூட சொல்லிறான்ன்னு தப்பு கிடையாதுங்க"
    },
    {
      "t": "11:24",
      "text": "நீ சொல்லுங்க ரண்ட்ஷப்பா இருக்கு என்ன சொல்லுங்க"
    },
    {
      "t": "11:26",
      "text": "ிப் ஆும் எனக்கு உண்மையா சொல்ல"
    },
    {
      "t": "11:28",
      "text": "ா நான் கொஞ்சம் பிஸியா இருக்கேன் ஊருக்கு"
    },
    {
      "t": "11:30",
      "text": "வந்து ஏன்னா இங்க பசங்களை ப"
    },
    {
      "t": "11:32",
      "text": "துன்ன பண்றன்னா அது"
    },
    {
      "t": "11:34",
      "text": "அப்புறமேட்டு ஈவினி்ந்து டியூஷன் எடு"
    },
    {
      "t": "11:36",
      "text": "இ"
    },
    {
      "t": "11:38",
      "text": "நான் சொல்லிிறேன் நான எப்ப ஃப்ரீ"
    },
    {
      "t": "11:40",
      "text": "யோ அந்த மாதிரினசுட்டு பேசுன்னு தோணிச்சோ"
    },
    {
      "t": "11:42",
      "text": "பண்ணலாம் நீ ரண்ட்ஷிப்ன்னு சொன்னீா ஓகே"
    },
    {
      "t": "11:44",
      "text": "உஹம் எனங்க என்னன்ன"
    },
    {
      "t": "11:46",
      "text": "எ விஷயம் எனக்கு டைம் இருக்காது"
    },
    {
      "t": "11:48",
      "text": "அதுக்கப்புறம்ான் ஆசியா நானும் உங்ககிட்ட நம்ப"
    },
    {
      "t": "11:50",
      "text": "ஐடிிலாம் ஷேர் பண்ணிட்டேன்"
    },
    {
      "t": "11:52",
      "text": "உங்களை பரிதாவிக்க விடுறதுக்கு"
    },
    {
      "t": "11:54",
      "text": "மனசுல்ல அததான் சொல்ேன்"
    },
    {
      "t": "11:56",
      "text": "எது வேணா ஜஸ்ட் வேணா நீங்க ந"
    },
    {
      "t": "11:58",
      "text": "நம்பர் கொடு வா்ஸ்அப்ஹ மசேஜ் போட்டேன்"
    },
    {
      "t": "12:00",
      "text": "நம்பர் வேண்டாம் டலிகிராம் ஐடி வேண"
    },
    {
      "t": "12:02",
      "text": ""
    },
    {
      "t": "12:04",
      "text": "ந ஆச்சுவலா உனக்கு நான் சொல்லுேன்"
    },
    {
      "t": "12:06",
      "text": "வை யூஸ் பண்ணுவாங்க அதல்லாம் நான் சொல்றேன் இ"
    },
    {
      "t": "12:08",
      "text": "என்ன பட ந குடு பிரச்சனை இல்"
    },
    {
      "t": "12:10",
      "text": "ிராம"
    },
    {
      "t": "12:12",
      "text": "வாடஸ்அப்ுவாங்கான் இப்ப"
    },
    {
      "t": "12:14",
      "text": "கூ கம்பன சூஜி ந இருக்கு அ மாதிரி"
    },
    {
      "t": "12:16",
      "text": "சே பண்ணி வச்சுக்கன் அவ்ளான் வேற ஒன்னும் இல்ல"
    },
    {
      "t": "12:18",
      "text": "உஹம்"
    },
    {
      "t": "12:20",
      "text": "என்னோட பிரச்சனை எதுதவும்"
    },
    {
      "t": "12:22",
      "text": "எனக்கு அதது கொஞ்சம் பயம் அதான் வியம்"
    },
    {
      "t": "12:24",
      "text": "இல் ஒண்ணும் இல்ல நீ"
    },
    {
      "t": "12:26",
      "text": "நம்பர் ஆன் மட்டும் பாறேன்"
    },
    {
      "t": "12:28",
      "text": "ஃரீய டைம் கூப்பிடள"
    },
    {
      "t": "12:30",
      "text": ""
    },
    {
      "t": "12:32",
      "text": "மத்தபடி எது நல்லா இல்ல"
    },
    {
      "t": "12:34",
      "text": "னு சொன்னத குடுப்பீங்களா"
    },
    {
      "t": "12:36",
      "text": "ஆ"
    },
    {
      "t": "12:38",
      "text": "அப்படி இல்ல பேசலாம் பேசலாம் கொஞ்சம் பேசலாம்"
    },
    {
      "t": "12:40",
      "text": "ஆ"
    },
    {
      "t": "12:42",
      "text": "ஷேர் பண்றீங்களா"
    },
    {
      "t": "12:44",
      "text": "நான் பண்ன்"
    },
    {
      "t": "12:46",
      "text": "கொ்ச நேரம்"
    },
    {
      "t": "12:48",
      "text": "எனக்கு கொஞ்சம் டைம் வேணும்"
    },
    {
      "t": "12:50",
      "text": "இல் டைம்"
    },
    {
      "t": "12:52",
      "text": "எடு க் பிறங்கவ் நீ சொன்ன"
    },
    {
      "t": "12:54",
      "text": "அப்புற எனக்கு ஒரு மாின தான்டக்குடி கேன்"
    },
    {
      "t": "12:56",
      "text": "புரியல என்னது"
    },
    {
      "t": "12:58",
      "text": "எவ்வளவு ஹேட்டா இருக்கீங்க"
    },
    {
      "t": "13:00",
      "text": "ங்களே அதுக்காக தான் நம்பர் உடனேட்ட"
    },
    {
      "t": "13:02",
      "text": "அததான் இருக்குன்னா"
    },
    {
      "t": "13:04",
      "text": "நான் அதுல இருந்து வந்துட்டேன்"
    },
    {
      "t": "13:06",
      "text": "இப்பல்லாம் ஹோட்டல்லாம் இல்ல"
    },
    {
      "t": "13:08",
      "text": "எப்படி சொல்றதுன்னா"
    },
    {
      "t": "13:10",
      "text": "ஆஹ அது மாதிரி நடந்துச்சு"
    },
    {
      "t": "13:12",
      "text": "அது வந்த ஜஸ்ட் உங்க"
    },
    {
      "t": "13:14",
      "text": "இப்ப நான்ஹ ஹோட்டா இருக்கே நான்னு கேட்டன்"
    },
    {
      "t": "13:16",
      "text": "த்துல்ல ஏன் என்"
    },
    {
      "t": "13:18",
      "text": "இாக்கு"
    },
    {
      "t": "13:20",
      "text": "ஆ நான் இப்ப அவர்கிட்ட இருந்த நான் ஒரு விஷயம்"
    },
    {
      "t": "13:22",
      "text": "பா சொன்னும்ன் எதிர்பார்த்தாதான்"
    },
    {
      "t": "13:24",
      "text": "எனக்கு வலிக்கும்"
    },
    {
      "t": "13:26",
      "text": "அது எதுவுமே"
    },
    {
      "t": "13:28",
      "text": "எதிர்பாரக்கலகே"
    },
    {
      "t": "13:30",
      "text": "ஓகே"
    },
    {
      "t": "13:32",
      "text": "அப்புறம்"
    },
    {
      "t": "13:34",
      "text": "என்ன சாப்பீங்க நைட்டு"
    },
    {
      "t": "13:36",
      "text": "சப்பாத்தி"
    },
    {
      "t": "13:38",
      "text": "நமா கடில தானே"
    },
    {
      "t": "13:40",
      "text": "நான் தோசை சத்த"
    },
    {
      "t": "13:42",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "13:44",
      "text": "எப்ப தூங்கீங்க எப்ப காலந்திருப்பீங்க"
    },
    {
      "t": "13:46",
      "text": "ஐயோ இன்னைக்கு நான் முடிச்சிருக்கேன் நா"
    },
    {
      "t": "13:48",
      "text": "நாளைக்கு மும் நாளைக்குெல்லாம் முடிிச்சிருக்கே"
    },
    {
      "t": "13:50",
      "text": "மாட்டன் சொல்றேன் ஒவ்வொரு நாள்"
    },
    {
      "t": "13:52",
      "text": "சன் க பண்ட"
    },
    {
      "t": "13:54",
      "text": "பேயத நம்பர் ஷேர் பண்ணிட்டு போோ தயவுெயு"
    },
    {
      "t": "13:56",
      "text": ""
    },
    {
      "t": "13:58",
      "text": "சரி ஓகே ந"
    },
    {
      "t": "14:00",
      "text": "ந"
    },
    {
      "t": "14:02",
      "text": "நமிஷம் நைன் ஃபைவ்"
    },
    {
      "t": "14:04",
      "text": "ஆனா"
    },
    {
      "t": "14:06",
      "text": "னால் பேச முடியாது உங்களுக்கு"
    },
    {
      "t": "14:08",
      "text": "ஓே வா இல்ல நாம"
    },
    {
      "t": "14:10",
      "text": "க் பண்றன் நீ நீ ஃரீாள்ளட போ"
    },
    {
      "t": "14:12",
      "text": "ங்க எனக்கு ஒன்னும் கொஷம் நல்லா இரு"
    },
    {
      "t": "14:14",
      "text": "உம்"
    },
    {
      "t": "14:16",
      "text": "நன் பே"
    },
    {
      "t": "14:18",
      "text": "ிக"
    },
    {
      "t": "14:20",
      "text": "ூ சிக்ஸ்"
    },
    {
      "t": "14:22",
      "text": "டபுள் சிக்ஸ் டூ சிக்ஸ்"
    },
    {
      "t": "14:24",
      "text": "நைன் ஜீரோ ோர் செவன்"
    },
    {
      "t": "14:26",
      "text": ""
    },
    {
      "t": "14:28",
      "text": "நைன் ஜீரோ ஃபோர் செவன் ஆ"
    },
    {
      "t": "14:30",
      "text": "நம்பட்ட"
    },
    {
      "t": "14:32",
      "text": "ப"
    },
    {
      "t": "14:34",
      "text": "நைவ் டப சிக்ஸ் ூ ச"
    },
    {
      "t": "14:36",
      "text": "ிக ந ஜீோ"
    },
    {
      "t": "14:38",
      "text": "டீப் என்ன இருக்கும்"
    },
    {
      "t": "14:40",
      "text": "பாப்பா போட்டோ இருக்கும்"
    },
    {
      "t": "14:42",
      "text": "ஆ"
    },
    {
      "t": "14:44",
      "text": "மட்டும் போட்டிருக்கேன்"
    },
    {
      "t": "14:46",
      "text": "இததான் நம்பர்"
    },
    {
      "t": "14:48",
      "text": "க்க"
    },
    {
      "t": "14:50",
      "text": ""
    },
    {
      "t": "14:52",
      "text": "வந்திருக்கா மெசேஜ்"
    },
    {
      "t": "14:54",
      "text": ""
    },
    {
      "t": "14:56",
      "text": "உங்க பேர வரலையே"
    },
    {
      "t": "14:58",
      "text": "ஜா"
    },
    {
      "t": "15:00",
      "text": "ஆ"
    },
    {
      "t": "15:02",
      "text": "அங்க வந்து வரல"
    },
    {
      "t": "15:04",
      "text": "மெசேஜ் வந்திருக்கு டி"
    },
    {
      "t": "15:06",
      "text": "ராாம இருக்கா ஆ"
    },
    {
      "t": "15:08",
      "text": "மாஸ்டர் சிக்ஸ் த எிட்"
    },
    {
      "t": "15:10",
      "text": "அதுதான் என்"
    },
    {
      "t": "15:12",
      "text": "ரொம்ப தெ இருஞிச்சு தபி வரல"
    },
    {
      "t": "15:14",
      "text": "அ"
    },
    {
      "t": "15:16",
      "text": "சே் பண்ண நம்பர் சே் பண்ணன்"
    },
    {
      "t": "15:18",
      "text": "உஹம் சக்கு"
    },
    {
      "t": "15:20",
      "text": "நமாம்"
    },
    {
      "t": "15:22",
      "text": "உம் சொல்ல"
    },
    {
      "t": "15:24",
      "text": "ச"
    },
    {
      "t": "15:26",
      "text": "உம் அப்போ"
    },
    {
      "t": "15:28",
      "text": ""
    },
    {
      "t": "15:30",
      "text": "ஆஹ் யாருக்குமே பரைக்கும் நம்பருச்சு"
    },
    {
      "t": "15:32",
      "text": "ஷேர் பண்ணதே இல்லைங்க"
    },
    {
      "t": "15:34",
      "text": "உங்களுக்கு நான் எப்படி"
    },
    {
      "t": "15:36",
      "text": "கால் பண்ணோும் என்ன எல்லாமே டீட்டெய"
    },
    {
      "t": "15:38",
      "text": "வாட்அப்ல சொல்றாங்கள நான"
    },
    {
      "t": "15:40",
      "text": "அய்யோ"
    },
    {
      "t": "15:42",
      "text": "பயமா இருக்கல்ல இந்த மாதிரி ந"
    },
    {
      "t": "15:44",
      "text": "பண்ணதே இல்லையா திஸ் இஸ்ஸ்ட்"
    },
    {
      "t": "15:46",
      "text": "ஐயோ ந"
    },
    {
      "t": "15:48",
      "text": "நானும் வந்து உங்களுக்கு டார் எல்லாம் பண பண்ணன்"
    },
    {
      "t": "15:50",
      "text": "ங்க ஒரே சாப்ப"
    },
    {
      "t": "15:52",
      "text": "அதுல அந்த கால் பண்ணததுல வாட்ஸ்அப்ால்"
    },
    {
      "t": "15:54",
      "text": "பண்ணுவா வயச்கால"
    },
    {
      "t": "15:56",
      "text": "ரி"
    },
    {
      "t": "15:58",
      "text": "ஏய் பண்ணாதீங்க பண்ணாதீங்க பண்ணாதீங்க"
    },
    {
      "t": "16:00",
      "text": "ஹலோ"
    },
    {
      "t": "16:02",
      "text": ""
    }
