    {
      "t": "04:32",
      "text": "ആ ഫ"
    },
    {
      "t": "04:34",
      "text": "ഞ"
    },
    {
      "t": "04:36",
      "text": "ഞാൻ വീഡിയോക്ക വീഡിയോക്ക"
    },
    {
      "t": "04:38",
      "text": "വിളിക്കണംെന്ന്യ"
    },
    {
      "t": "04:40",
      "text": "ഞാൻ ഡ്രസ്സ എല്ലാംും"
    },
    {
      "t": "04:42",
      "text": "അപ്പൊ നീ ഫൈവ് ഹഡ്രഡ് റുപ്പീസ്"
    },
    {
      "t": "04:44",
      "text": "പേ ചെയ്യണം ആ നമ്പറ"
    },
    {
      "t": "04:46",
      "text": "അപ്പം ഞാൻ കാണ"
    },
    {
      "t": "04:48",
      "text": ""
    },
    {
      "t": "04:50",
      "text": "ഓക്കെ ആണോ"
    },
    {
      "t": "04:52",
      "text": "എല്ലാം ഊരിട്ട്"
    },
    {
      "t": "04:54",
      "text": "ട്ടാ"
    },
    {
      "t": "04:56",
      "text": "എങ്ങനെ കേ കേട്ടവ"
    },
    {
      "t": "04:58",
      "text": "വീഡിയോ കോൾസ് ചെയ്ത് എല്ലാം"
    },
    {
      "t": "05:00",
      "text": "ഊട്ട പേര്ത പോ"
    },
    {
      "t": "05:02",
      "text": "തെ മഷപ്പ് ദും കോക്കട്ടായി"
    },
    {
      "t": "05:04",
      "text": "ക്കെ ഞാൻ പറയുന്നതോ"
    },
    {
      "t": "05:06",
      "text": "കേൾക്കുന്നു അതന്നെ"
    },
    {
      "t": "05:08",
      "text": "വീഡിയോ കോള് ചെയ്ത"
    },
    {
      "t": "05:10",
      "text": "എല്ലാം ഊരിട്ട് പേര് ചെയ്തപ്പോ"
    },
    {
      "t": "05:12",
      "text": "പ്പ തന്നെ"
    },
    {
      "t": "05:14",
      "text": "എല്ലാം കളിപ്പിക്കും"
    },
    {
      "t": "05:16",
      "text": "ഇത്"
    },
    {
      "t": "05:18",
      "text": "ഇല്ലാ ഊര്ഞ"
    },
    {
      "t": "05:20",
      "text": "തന്നെ വീിയോ"
    },
    {
      "t": "05:22",
      "text": "ഫൈവ് ഹൺഡ്രഡും ആണ് അന്നേരം"
    },
    {
      "t": "05:24",
      "text": "ഞാാന എല്ലാം കാണിക്കും നമ്മള് നമ്മുടെ"
    },
    {
      "t": "05:26",
      "text": "ഇത്ൊ കറത്യമായിട്ട്"
    },
    {
      "t": "05:28",
      "text": "എല്ലാം ചെയ്യും എല്ലാലും"
    },
    {
      "t": "05:30",
      "text": "അങ്ങനെയല്ല അതുകൊണ്ടായ ഉണ്ടും"
    },
    {
      "t": "05:32",
      "text": "അതാണ് ഞാൻ കൊറെ"
    },
    {
      "t": "05:34",
      "text": "തിലിങ്ങനെ"
    },
    {
      "t": "05:36",
      "text": "ഞാൻ"
    },
    {
      "t": "05:38",
      "text": "എല്ലാം ഉരിയന്നന്ന് നിനക്ക് പോോതി"
