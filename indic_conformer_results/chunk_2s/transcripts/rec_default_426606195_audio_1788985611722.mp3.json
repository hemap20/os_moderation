    {
      "t": "00:06",
      "text": "ഹ് എവിടന്നാ വിടക്കുന്നത്"
    },
    {
      "t": "00:08",
      "text": "ഉം"
    },
    {
      "t": "00:10",
      "text": "ഉ ഞാൻ ആവരിക്കട്ട"
    },
    {
      "t": "00:12",
      "text": "ഇതി വന്നിട്ട് ഒരുപാട്"
    },
    {
      "t": "00:14",
      "text": "ആഹ"
    },
    {
      "t": "00:16",
      "text": "ആണോ"
    },
    {
      "t": "00:18",
      "text": "ഫ്രണ്ട്സ് ഒക്കെ ഉണ്ടോ"
    },
    {
      "t": "00:20",
      "text": ""
