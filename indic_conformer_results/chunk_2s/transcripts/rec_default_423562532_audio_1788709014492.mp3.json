    {
      "t": "00:14",
      "text": "ആഹ"
    },
    {
      "t": "00:16",
      "text": "എന്താ ചെയ്യണ"
    },
    {
      "t": "00:18",
      "text": "ശ"
    },
    {
      "t": "00:20",
      "text": "ആഹ കച്ചിരിപ്പട"
    },
    {
      "t": "00:22",
      "text": "എവിടെ"
    },
    {
      "t": "00:24",
      "text": "ആഹ ഹസ്ബൻ്"
    },
    {
      "t": "00:26",
      "text": "ും കാണേ രാത്രി"
    },
    {
      "t": "00:28",
      "text": "ുന്ന ഇല്ല"
    },
    {
      "t": "00:30",
      "text": "പുള്ളി വ പത്തിക്കോ അതു"
    },
    {
      "t": "00:32",
      "text": ""
    },
    {
      "t": "00:34",
      "text": "പിള്ളേരൊക്കെ"
    },
    {
      "t": "00:36",
      "text": "പിള്ളേരെണ്ടാണ് കട"
    },
    {
      "t": "00:38",
      "text": "അടിപൊളി"
    },
    {
      "t": "00:40",
      "text": "അപ്പ പറ്റിയ സമയണല്ലോ"
    },
    {
      "t": "00:42",
      "text": "അെ എപ്പല്ലക്ക്"
    },
    {
      "t": "00:44",
      "text": ""
    },
    {
      "t": "00:46",
      "text": "കുറ നാള ഉപയോഗിക്കണോ"
    },
    {
      "t": "00:48",
      "text": "ഴ് അങ്ങനെയുണ്ട്"
    },
    {
      "t": "00:50",
      "text": ""
    },
    {
      "t": "00:52",
      "text": "എന്ത് പറ വിളിക്കുന്നരൊക്കെ എന്താ പറ"
    },
    {
      "t": "00:54",
      "text": "എന്നടാ"
    },
    {
      "t": "00:56",
      "text": "വിളിക്കുന്നവരൊക്കെ എന്നന്താ പറയണേ"
    },
    {
      "t": "00:58",
      "text": "വിളിക്കുന്നവര്"
    },
    {
      "t": "01:00",
      "text": "എന്താ പറയ ജിപേ"
    },
    {
      "t": "01:02",
      "text": "വാട്സപ്പ് നമ്പർ തരുൂ"
    },
    {
      "t": "01:04",
      "text": "ഉ ഡയറക്റ്റ് ആയിട്ട് തരുന്നോോ"
    },
    {
      "t": "01:06",
      "text": "പതിനഞ്ച് ഇരുപ ഇരുത്തഞ്ചൊക്കെ തരാമ എന്നൊക്കെ"
    },
    {
      "t": "01:08",
      "text": "പറയുന്ന ഉ"
    },
    {
      "t": "01:10",
      "text": "ാ പറയുംനിക്ക്"
    },
    {
      "t": "01:12",
      "text": "താല്പര്യ ഇന്ന് തന്നെ പറയാം"
    },
    {
      "t": "01:14",
      "text": "ആ"
    },
    {
      "t": "01:16",
      "text": "അപ്പൊ കട്ട ചെയതന്ന് പ പോ"
    },
    {
      "t": "01:18",
      "text": "ഉ ഈപ്പന"
    },
    {
      "t": "01:20",
      "text": "അത് ൻ ചെയ്യാൻ പറ്റുമോ"
    },
    {
      "t": "01:22",
      "text": "എപ്പലത്ത് ഏ"
    },
    {
      "t": "01:24",
      "text": "പറ്റ ാനും ചെയ്യാൻ പറ്റുമോ"
    },
    {
      "t": "01:26",
      "text": "അ എങ്ങനെ"
    },
    {
      "t": "01:28",
      "text": "എന്റെ പേയ്മെന്റ്ൊക്കെ പറഞ്ഞേ"
    },
    {
      "t": "01:30",
      "text": "അത്ങ്ങനെ"
    },
    {
      "t": "01:32",
      "text": "അതിനകത്ത്െ സംസാരിച്ചോണ്ടിരിക്ക"
    },
    {
      "t": "01:34",
      "text": "സക്കെ കറിക്കൊണ്ടിരിക്കും അത് നമുക്ക്"
    },
    {
      "t": "01:36",
      "text": "െ തന്നെ ഇന്നന്ന് വിഡ്രോ ചെയ്തെടുക്കാം ലേഡി"
    },
    {
      "t": "01:38",
      "text": "ീസി മാത്രേ ഉള്ളൂ പോസിന് വെക്ക"
    },
    {
      "t": "01:40",
      "text": "നമുക്ക് തന്നെ നമ്മൾ ഈ"
    },
    {
      "t": "01:42",
      "text": "പ്പ"
    },
    {
      "t": "01:44",
      "text": "അ ഞാൻ അപ്പ ഇൻസ്റ്റാൾ ചെയ്യ"
    },
    {
      "t": "01:46",
      "text": "അവ വിള"
    },
    {
      "t": "01:48",
      "text": "ഈ മ കച്ചേരിപ്പള്ള"
    },
    {
      "t": "01:50",
      "text": "എവിയ താമസിക്കുന്നത്"
    }
