    {
      "t": "00:04",
      "text": "ஹலோ"
    },
    {
      "t": "00:06",
      "text": "ஹலோ"
    },
    {
      "t": "00:08",
      "text": "ஹலோ"
    },
    {
      "t": "00:10",
      "text": "ஆஹ"
    },
    {
      "t": "00:12",
      "text": "ஹல கேக்குதா"
    },
    {
      "t": "00:14",
      "text": "ம் பேக்குுது"
    },
    {
      "t": "00:16",
      "text": "ஆ எந்த ஒரு"
    },
    {
      "t": "00:18",
      "text": "என்ன பெங்களூர் நீ"
    },
    {
      "t": "00:20",
      "text": ""
    },
    {
      "t": "00:22",
      "text": ""
    },
    {
      "t": "00:24",
      "text": "நீங்க"
    },
    {
      "t": "00:26",
      "text": "ஆமா உ தமிழ்நாடு மாதிரி"
    },
    {
      "t": "00:28",
      "text": "மதுரை"
    },
    {
      "t": "00:30",
      "text": "உம்"
    },
    {
      "t": "00:32",
      "text": "உங்க பேரு"
    },
    {
      "t": "00:34",
      "text": "எ வ பிரசாத்"
    },
    {
      "t": "00:36",
      "text": "என்ன்னொட"
    },
    {
      "t": "00:38",
      "text": "ஒரு பேர் அச்சனா"
    },
    {
      "t": "00:40",
      "text": "உம் கதையனயச்சா"
    },
    {
      "t": "00:42",
      "text": "உம் சிங்க த"
    },
    {
      "t": "00:44",
      "text": ""
    },
    {
      "t": "00:46",
      "text": "சங்கல் த"
    },
    {
      "t": "00:48",
      "text": "உம்"
    },
    {
      "t": "00:50",
      "text": "அ"
    },
    {
      "t": "00:52",
      "text": "கொஞ்சம் ஒரு மாதிரி டவுட்ல்லாம் கேட்கும்ே"
    },
    {
      "t": "00:54",
      "text": "இருக்கலாமா ம் கே"
    },
    {
      "t": "00:56",
      "text": "இங்க"
    },
    {
      "t": "00:58",
      "text": "உம்"
    },
    {
      "t": "01:00",
      "text": "கேட்கலாமா"
    },
    {
      "t": "01:02",
      "text": "வேணாமா கேள்ங்க"
    },
    {
      "t": "01:04",
      "text": "அ"
    },
    {
      "t": "01:06",
      "text": "இல்ல எந்த மாதிரி டவுடன்னு உங்களுக்கு தெரியும்"
    },
    {
      "t": "01:08",
      "text": "உம்"
    },
    {
      "t": "01:10",
      "text": "உம்"
    },
    {
      "t": "01:12",
      "text": "கேக்குமா வேணாம் கேளு"
    },
    {
      "t": "01:14",
      "text": ""
    },
    {
      "t": "01:16",
      "text": "உம்"
    },
    {
      "t": "01:18",
      "text": "எனக்குஞ"
    },
    {
      "t": "01:20",
      "text": "கொஞ்சம் ஒரு மாதிரியா இருக்கு எப்படி கே"
    },
    {
      "t": "01:22",
      "text": ""
    },
    {
      "t": "01:24",
      "text": ""
    },
    {
      "t": "01:26",
      "text": "ம் ஹலோ"
    },
    {
      "t": "01:28",
      "text": "உம்"
    },
    {
      "t": "01:30",
      "text": "சொல்லுங்க உன்னு சொ"
    },
    {
      "t": "01:32",
      "text": "சொல் கேளுங்க நீ"
    },
    {
      "t": "01:34",
      "text": "கேட்டாதான் தெரியும்"
    },
    {
      "t": "01:36",
      "text": "நீ"
    },
    {
      "t": "01:38",
      "text": "உன் வயசு பார்த்தா கல்யாணம் ஆ வயு"
    },
    {
      "t": "01:40",
      "text": "உம்"
    },
    {
      "t": "01:42",
      "text": "அ"
    },
    {
      "t": "01:44",
      "text": "ஹலோ"
    },
    {
      "t": "01:46",
      "text": "சொல்லு"
    },
    {
      "t": "01:48",
      "text": "சொல்லுங்க"
    },
    {
      "t": "01:50",
      "text": ""
    },
    {
      "t": "01:52",
      "text": "ஹலோ"
    },
    {
      "t": "01:54",
      "text": "ஹலோ"
    },
    {
      "t": "01:56",
      "text": "கேக்குதான்ம் கே"
    },
    {
      "t": "01:58",
      "text": "அது"
    },
    {
      "t": "02:00",
      "text": "உம் இல்ல நீங்க"
    },
    {
      "t": "02:02",
      "text": "எப்படி ஆரம்பிக்க"
    },
    {
      "t": "02:04",
      "text": "தெரியலையே நீங்களே கொஞ்சம் ஆரம்பிக்கிறீங்களா"
    },
    {
      "t": "02:06",
      "text": ""
    },
    {
      "t": "02:08",
      "text": "உ"
    },
    {
      "t": "02:10",
      "text": "என்"
    },
    {
      "t": "02:12",
      "text": "படிக்க"
    },
    {
      "t": "02:14",
      "text": "என்ன பிடிக்கும்"
    },
    {
      "t": "02:16",
      "text": "முக்க"
    },
    {
      "t": "02:18",
      "text": "சாப்பிட்டீங்க"
    },
    {
      "t": "02:20",
      "text": "எல்லாமே பிடிக்கும் உங்களுக்கு"
    },
    {
      "t": "02:22",
      "text": "எனக்கு நல்லா"
    },
    {
      "t": "02:24",
      "text": "படிக்க"
    },
    {
      "t": "02:26",
      "text": "ம் என்ன கலர் ட்ரெஸ் போட்டிருக்கீங்க"
    },
    {
      "t": "02:28",
      "text": "உம்"
    },
    {
      "t": "02:30",
      "text": "ா ரெட்டு் கலரு எல்ல"
    },
    {
      "t": "02:32",
      "text": "ல மிக்ஸ் ரெட்டு கலரு"
    },
    {
      "t": "02:34",
      "text": "ரெெ"
    },
    {
      "t": "02:36",
      "text": "அவர் என்ல்ல"
    },
    {
      "t": "02:38",
      "text": ""
    },
    {
      "t": "02:40",
      "text": "கோபமா பேசுற மாதிரி இருக்கு"
    },
    {
      "t": "02:42",
      "text": "என்னங்க"
    },
    {
      "t": "02:44",
      "text": "ஓம்"
    },
    {
      "t": "02:46",
      "text": "ஆஹ்"
    },
    {
      "t": "02:48",
      "text": "போமா பேசுறீங்களா"
    },
    {
      "t": "02:50",
      "text": "இல்லங்க ஆமாளதான"
    },
    {
      "t": "02:52",
      "text": "பேசிட்டு இருக்கேன்"
    },
    {
      "t": "02:54",
      "text": "உம்"
    },
    {
      "t": "02:56",
      "text": "சரியில இருக்கீங்கன்னா"
    },
    {
      "t": "02:58",
      "text": "நைட்டில இருக்கீங்களா"
    },
    {
      "t": "03:00",
      "text": "நைட்டு இல்லத"
    },
    {
      "t": "03:02",
      "text": ""
    },
    {
      "t": "03:04",
      "text": "உம் ஓகே"
    },
    {
      "t": "03:06",
      "text": "சப்ப நை"
    },
    {
      "t": "03:08",
      "text": "அ"
    },
    {
      "t": "03:10",
      "text": "சொன்னீங்களா லோ கலரு வித் ரெட்டு்"
    },
    {
      "t": "03:12",
      "text": ""
    },
    {
      "t": "03:14",
      "text": "போமா பேச"
    },
    {
      "t": "03:16",
      "text": "உம்"
    },
    {
      "t": "03:18",
      "text": "வேற அடுடுத்த கேள்வி கேக்குவ"
    },
    {
      "t": "03:20",
      "text": "உம் சரிங்க"
    },
    {
      "t": "03:22",
      "text": "உம் என்ன"
    },
    {
      "t": "03:24",
      "text": "கலர் போட்டிருக்கீங்க"
    },
    {
      "t": "03:26",
      "text": "கல்லோக்கு"
    },
    {
      "t": "03:28",
      "text": "நைட்டி"
    },
    {
      "t": "03:30",
      "text": "உம்"
    },
    {
      "t": "03:32",
      "text": ""
    },
    {
      "t": "03:34",
      "text": "வேற"
    },
    {
      "t": "03:36",
      "text": ""
    },
    {
      "t": "03:38",
      "text": "உஹம்"
    },
    {
      "t": "03:40",
      "text": "வேற என்ன கத போட்டிரு"
    },
    {
      "t": "03:42",
      "text": "வேற"
    },
    {
      "t": "03:44",
      "text": "என்ன கலரா வேற என்ன போட்டிருக்கீன்ன கேக்கு"
    },
    {
      "t": "03:46",
      "text": "உம்"
    },
    {
      "t": "03:48",
      "text": "வேற என்ன பராப்பு"
    },
    {
      "t": "03:50",
      "text": "போட்டிருக்க மு"
    },
    {
      "t": "03:52",
      "text": "உம் சொல்லுங்க"
    },
    {
      "t": "03:54",
      "text": "கீழாப்பாவட கட்ட இருக்குே"
    },
    {
      "t": "03:56",
      "text": ""
    },
    {
      "t": "03:58",
      "text": "ஓகே"
    },
    {
      "t": "04:00",
      "text": "என்ன கலர் போட்டிருக்கீங்க ரெண்டும்"
    },
    {
      "t": "04:02",
      "text": "அவட கூட எல்லோ"
    },
    {
      "t": "04:04",
      "text": "ல"
    },
    {
      "t": "04:06",
      "text": "ம்"
    },
    {
      "t": "04:08",
      "text": "அற"
    },
    {
      "t": "04:10",
      "text": ""
    },
    {
      "t": "04:12",
      "text": ""
    },
    {
      "t": "04:14",
      "text": "ஹலோ"
    },
    {
      "t": "04:16",
      "text": "உம்"
    },
    {
      "t": "04:18",
      "text": "அது என்ன கலர்"
    },
    {
      "t": "04:20",
      "text": "அதுவும் எல்லோ கலர் சொன்ன"
    },
    {
      "t": "04:22",
      "text": "உம்"
    },
    {
      "t": "04:24",
      "text": "மேதான்"
    },
    {
      "t": "04:26",
      "text": "மேடம் எல்லாம்"
    },
    {
      "t": "04:28",
      "text": "எல்லாமே எல்ாக்கள் இருக்கும்"
    },
    {
      "t": "04:30",
      "text": "உள்ளே எல்லோ தானா"
    },
    {
      "t": "04:32",
      "text": "உம்"
    },
    {
      "t": "04:34",
      "text": "சொல்லக்கலாம்"
    },
    {
      "t": "04:36",
      "text": "என்னவேல்லவா"
    },
    {
      "t": "04:38",
      "text": "உம்"
    },
    {
      "t": "04:40",
      "text": "உம்"
    },
    {
      "t": "04:42",
      "text": "உங்களுக்கு எத்தனை வயசா"
    },
    {
      "t": "04:44",
      "text": ""
    },
    {
      "t": "04:46",
      "text": "எனக்க ்வன்ட்டிஃபைவ்"
    },
    {
      "t": "04:48",
      "text": "ன்ி ைவ்"
    },
    {
      "t": "04:50",
      "text": "இது வரைக்கும் யாரு கூட"
    },
    {
      "t": "04:52",
      "text": "படைைய இருக்கீங்களா"
    },
    {
      "t": "04:54",
      "text": "ரெண்டு வருஷம்த்து"
    },
    {
      "t": "04:56",
      "text": "ம நேர வாங்க ஃப்ரெண்டு இருந்தாங்க"
    },
    {
      "t": "04:58",
      "text": "உம்"
    },
    {
      "t": "05:00",
      "text": "அஹங்கட"
    },
    {
      "t": "05:02",
      "text": "அ இங்கக்கசிங்க பண்ணிருக்கேன்"
    },
    {
      "t": "05:04",
      "text": "க"
    },
    {
      "t": "05:06",
      "text": "என்ன பண்ணிருக்கீங்க"
    },
    {
      "t": "05:08",
      "text": "ப்படி இங்கே பேசிங்க எல்லாம் பண்ணியிருக்க"
    },
    {
      "t": "05:10",
      "text": "ஓகே"
    },
    {
      "t": "05:12",
      "text": "பண்ணிருக்கீங்களா சரி"
    },
    {
      "t": "05:14",
      "text": "ீங்களம்"
    },
    {
      "t": "05:16",
      "text": "ல்லாம் பண்ண மேரேஜ் பண்ணி"
    },
    {
      "t": "05:18",
      "text": "ட்டு இருந்தோம்"
    },
    {
      "t": "05:20",
      "text": "வீல பேசிருந்தாங்க பே"
    },
    {
      "t": "05:22",
      "text": "ச்சுவார்த்தை நடல்லன்ன இருந்துச்சு"
    },
    {
      "t": "05:24",
      "text": "அதுக்கப்புறம் முதல்ல ஒத்துக்கிட்டாங்க"
    },
    {
      "t": "05:26",
      "text": "அதுக்கப்புறமா ரெண்டாவது வட்டி"
    },
    {
      "t": "05:28",
      "text": "மாப்பிள்ள வீட்டுல பே"
    },
    {
      "t": "05:30",
      "text": "ாங்கள வேண்டாம்னு சொல்லிட்டாங்க"
    },
    {
      "t": "05:32",
      "text": "கிறிஸ்டியான நாங்க இருந்துனால"
    },
    {
      "t": "05:34",
      "text": "ஆமக்கு"
    },
    {
      "t": "05:36",
      "text": "கிறிஸ்டியன் பொண்ணுகம் தேவன் சொல்லிாங்க"
    },
    {
      "t": "05:38",
      "text": "ரிஜெக்ட் பண்ணிட்டாங்க"
    },
    {
      "t": "05:40",
      "text": "சரி ஓகே"
    },
    {
      "t": "05:42",
      "text": "உம்"
    },
    {
      "t": "05:44",
      "text": ""
    },
    {
      "t": "05:46",
      "text": "சரி உங்க வாட்ஸ்அப் நம்பர் கிடைக்குமா"
    },
    {
      "t": "05:48",
      "text": ""
    },
    {
      "t": "05:50",
      "text": "வேண்ட இதுலயே பேசுங்க"
    },
    {
      "t": "05:52",
      "text": "உஹ"
    },
    {
      "t": "05:54",
      "text": "எப்படி பேசுனா உங்களுக்கு பே பண்ண முடியும் நான் ஏதோ"
    },
    {
      "t": "05:56",
      "text": "உங்களுக்கு ஏதோ பே பண்ணி விட்டு உங்களை"
    },
    {
      "t": "05:58",
      "text": "பாத்துக்கேன் உம்"
    },
    {
      "t": "06:00",
      "text": "ஏத அமௌண்ட பே"
    },
    {
      "t": "06:02",
      "text": "பண்ணிட்டு வீடியா காலல பாக்குறோனே"
    },
    {
      "t": "06:04",
      "text": "ம் வீடு கல"
    },
    {
      "t": "06:06",
      "text": "யார் பேச சொ பேச நார்மலாக"
    },
    {
      "t": "06:08",
      "text": "ான பேசிட்டு இருக்கோம்"
    },
    {
      "t": "06:10",
      "text": "உம் எல்லங்காம்"
    },
    {
      "t": "06:12",
      "text": "இப்போ ஒரு இரநூறுூவா ஐநூறுூவபா பே பண்ணி"
    },
    {
      "t": "06:14",
      "text": "அவங்க வீடிய கல பாறாங்க அத"
    },
    {
      "t": "06:16",
      "text": ""
    },
    {
      "t": "06:18",
      "text": "உம் உ"
    },
    {
      "t": "06:20",
      "text": "சும்மா பேசுறேனா நார்மல்க"
    },
    {
      "t": "06:22",
      "text": "ும் பேசுவாிரி பண்ணம்"
    },
    {
      "t": "06:24",
      "text": "நந்தமதிரி பண்ண"
    },
    {
      "t": "06:26",
      "text": "உம்"
    },
    {
      "t": "06:28",
      "text": "உம்"
    },
    {
      "t": "06:30",
      "text": "இல்லலைங்களோ"
    },
    {
      "t": "06:32",
      "text": "அந்த மாதிரிான இல்"
    },
    {
      "t": "06:34",
      "text": "ு சொன்ன"
    },
    {
      "t": "06:36",
      "text": "அந்த மாதிரி இல்லையா"
    },
    {
      "t": "06:38",
      "text": "உம்"
    },
    {
      "t": "06:40",
      "text": "உம் சரிங்க"
    },
    {
      "t": "06:42",
      "text": "அமா சப்ப பேச"
    },
    {
      "t": "06:44",
      "text": "சமா மாங்கப்பா பேசினேன்"
    },
    {
      "t": "06:46",
      "text": "சரி அது கூள்ளது பண்ண"
    },
    {
      "t": "06:48",
      "text": "பண்ணிருக்கீங்களா"
    },
    {
      "t": "06:50",
      "text": "அதான் சொன்னாங்க பண்ணதல்லட்டு"
    },
    {
      "t": "06:52",
      "text": "செக்ஸ் பண்ணது"
    },
    {
      "t": "06:54",
      "text": "தவிர வேற எெல்லாம் பண்ணுவங்க"
    },
    {
      "t": "06:56",
      "text": "உம்"
    },
    {
      "t": "06:58",
      "text": "காசு இருக்கான்"
    },
    {
      "t": "07:00",
      "text": "உம் பண்ண"
    },
    {
      "t": "07:02",
      "text": "லாமா பண்ண ஆசை இரு"
    },
    {
      "t": "07:04",
      "text": "உம் இல்ல"
    },
    {
      "t": "07:06",
      "text": "உம்"
    },
    {
      "t": "07:08",
      "text": "இல்லங்க சும்மா"
    },
    {
      "t": "07:10",
      "text": "பேசும் ஜாலியா பேசும் மனசா பேசுவும்"
    },
    {
      "t": "07:12",
      "text": "நளதான்"
    },
    {
      "t": "07:14",
      "text": "சரி அத"
    },
    {
      "t": "07:16",
      "text": "நீங்க ஒடலியா இருக்கீா உருண்டா இருக்கீங்களா உங்க பத்தி"
    },
    {
      "t": "07:18",
      "text": "நான் வரணிப்பேன்"
    },
    {
      "t": "07:20",
      "text": "ஆமா மீடியம தான்"
    },
    {
      "t": "07:22",
      "text": "உம்"
    },
    {
      "t": "07:24",
      "text": "என்ன சைஸ் போ"
    },
    {
      "t": "07:26",
      "text": "போடுறீங்க உள்ளல"
    },
    {
      "t": "07:28",
      "text": "ச தேரட்டி"
    },
    {
      "t": "07:30",
      "text": "போட"
    },
    {
      "t": "07:32",
      "text": "கன"
    },
    {
      "t": "07:34",
      "text": "கேளா பட்டி"
    },
    {
      "t": "07:36",
      "text": "நடி"
    },
    {
      "t": "07:38",
      "text": "ந"
    },
    {
      "t": "07:40",
      "text": "ஓகே"
    },
    {
      "t": "07:42",
      "text": "எனக்கு ஒரே மூட இரு"
    },
    {
      "t": "07:44",
      "text": "உம்"
    },
    {
      "t": "07:46",
      "text": "எனக்கு கொஞ்சம் மூடா இருக்கு"
    },
    {
      "t": "07:48",
      "text": "மூட அக்க"
    },
    {
      "t": "07:50",
      "text": "இலை"
    },
    {
      "t": "07:52",
      "text": "உம்"
    },
    {
      "t": "07:54",
      "text": "உம் ஆஹ்"
    },
    {
      "t": "07:56",
      "text": "சக்கல்ல சாரங்க"
    },
    {
      "t": "07:58",
      "text": "கொஞ்ச அந்த மூடு வந்து"
    },
    {
      "t": "08:00",
      "text": "ஒரு மாதிரி இகே பண்ணுவாங்க அந்த மாதிரி"
    },
    {
      "t": "08:02",
      "text": "மன்னிச்சுக்கே"
    },
    {
      "t": "08:04",
      "text": "ம் பேசுறேன்"
    },
    {
      "t": "08:06",
      "text": "அவங்க"
    },
    {
      "t": "08:08",
      "text": "எனக்கு ரொம்ப புிடிச்சிருக்கு"
    },
    {
      "t": "08:10",
      "text": "உம்"
    },
    {
      "t": "08:12",
      "text": "ஹ உம்"
    },
    {
      "t": "08:14",
      "text": "கப்படுத்தக்கன்"
    },
    {
      "t": "08:16",
      "text": "அல்லது"
    },
    {
      "t": "08:18",
      "text": "நீ கொ தவியும்"
    },
    {
      "t": "08:20",
      "text": "உஹம்"
    },
    {
      "t": "08:22",
      "text": "என்"
    },
    {
      "t": "08:24",
      "text": "ஹலோ"
    },
    {
      "t": "08:26",
      "text": "இ"
    },
    {
      "t": "08:28",
      "text": "உங்களை கடுற்பண பண்ணிட்டு இருக்கேன் நான்"
    },
    {
      "t": "08:30",
      "text": "எப்படி இருப்பீங்க நான்"
    },
    {
      "t": "08:32",
      "text": "உம் ஏ உம்"
    },
    {
      "t": "08:34",
      "text": "ஹலோ"
    },
    {
      "t": "08:36",
      "text": "ஆஹ ஹலோஹ"
    },
    {
      "t": "08:38",
      "text": "ஹலோ"
    },
    {
      "t": "08:40",
      "text": "கேக்குதா"
    },
    {
      "t": "08:42",
      "text": ""
    },
    {
      "t": "08:44",
      "text": "ஹலோ"
    },
    {
      "t": "08:46",
      "text": "ஹ"
    },
    {
      "t": "08:48",
      "text": "உம்"
    },
    {
      "t": "08:50",
      "text": "கேக்குதா"
    },
    {
      "t": "08:52",
      "text": "உம் கேக்குது"
    },
    {
      "t": "08:54",
      "text": "அஐ வேணும்"
    },
    {
      "t": "08:56",
      "text": "ஒரு மாிரியா இருக்குட"
    },
    {
      "t": "08:58",
      "text": "பே உம்"
    },
    {
      "t": "09:00",
      "text": "பேசுங்க"
    },
    {
      "t": "09:02",
      "text": "நீங்க பேசுதீங்களா கொஞ்சம் மூட"
    },
    {
      "t": "09:04",
      "text": ""
    },
    {
      "t": "09:06",
      "text": ""
    },
    {
      "t": "09:08",
      "text": "ஹலோ"
    },
    {
      "t": "09:10",
      "text": ""
    },
    {
      "t": "09:12",
      "text": ""
    },
    {
      "t": "09:14",
      "text": ""
    },
    {
      "t": "09:16",
      "text": ""
    },
    {
      "t": "09:18",
      "text": "ஹ ஹலோ"
    },
    {
      "t": "09:20",
      "text": "உம் சொல்லுங்க"
    },
    {
      "t": "09:22",
      "text": ""
    },
    {
      "t": "09:24",
      "text": ""
    },
    {
      "t": "09:26",
      "text": "ஹலோஹ"
    },
    {
      "t": "09:28",
      "text": "ஆ"
    },
    {
      "t": "09:30",
      "text": "கேக்குதாம் கேக்குது"
    },
    {
      "t": "09:32",
      "text": "அல"
    },
    {
      "t": "09:34",
      "text": "நம்பர் தரீங்களா பிளீஸ்"
    },
    {
      "t": "09:36",
      "text": "ஹ இப்பதான் சொன்னு"
    },
    {
      "t": "09:38",
      "text": "நான் இதுலயே பேசுறேன் சொல்லிட்டு"
    },
    {
      "t": "09:40",
      "text": "அப்ப இதுல பேசுங்க"
    },
    {
      "t": "09:42",
      "text": "கொஞ்சம் நல்லா பேச மாடறீங்களே"
    },
    {
      "t": "09:44",
      "text": "அதனாலதான்"
    },
    {
      "t": "09:46",
      "text": "சாண்டே கே கதுிய"
    },
    {
      "t": "09:48",
      "text": "ஆமா நீங்க"
    },
    {
      "t": "09:50",
      "text": "சரி"
    },
    {
      "t": "09:52",
      "text": "ரொம்ப ஓப்பனா கேக்குறேன் உங்கள்டிட்ட"
    },
    {
      "t": "09:54",
      "text": "உம்"
    },
    {
      "t": "09:56",
      "text": "ரெண்டாயிரம் ரூபா"
    },
    {
      "t": "09:58",
      "text": "என்னங்க"
    },
    {
      "t": "10:00",
      "text": "ரெண்டாயிர"
    },
    {
      "t": "10:02",
      "text": "ரபா மௌட்டு சார்ேன் வீடியோ காால் தான்"
    },
    {
      "t": "10:04",
      "text": "உம் ரண்டாயிரம்"
    },
    {
      "t": "10:06",
      "text": "கொடுக்கற மாதிரி"
    },
    {
      "t": "10:08",
      "text": "மயங்க"
    },
    {
      "t": "10:10",
      "text": "ஜமா"
    },
    {
      "t": "10:12",
      "text": "யாரும் கொடுக்க மாட்டாங்க ரெண்டாயிரம்க்கு யார"
    },
    {
      "t": "10:14",
      "text": "கொடுப்பாங்கங்க"
    },
    {
      "t": "10:16",
      "text": "என்ன நான் தரேன் எனக்கு வீடியக்கல"
    },
    {
      "t": "10:18",
      "text": "வரீங்களா"
    },
    {
      "t": "10:20",
      "text": "இப்பதான் சொன்னங்க வீடியோ க"
    },
    {
      "t": "10:22",
      "text": "பேசு பேசு நார்மல் பா"
    },
    {
      "t": "10:24",
      "text": "பேசுவ என்ன பேசு சொன்ன"
    },
    {
      "t": "10:26",
      "text": "என்"
    },
    {
      "t": "10:28",
      "text": "பார்த்தாக்கன்னா நல்லா அழகா பார்கும்"
    },
    {
      "t": "10:30",
      "text": "ஆன"
    },
    {
      "t": "10:32",
      "text": "அவ்வளோ அழவா இருக்க மாட்டேங்க அதுக்குனால"
    },
    {
      "t": "10:34",
      "text": "சொ"
    },
    {
      "t": "10:36",
      "text": "இருக்கது மாநகரக்கம்"
    },
    {
      "t": "10:38",
      "text": "நல்லதான் இருக்கு"
    },
    {
      "t": "10:40",
      "text": "சரி நான் நல்லா"
    },
    {
      "t": "10:42",
      "text": "கொஞ்சம் ஒரு மாதிரியாவ பேசட்டுமா"
    },
    {
      "t": "10:44",
      "text": "உம்"
    },
    {
      "t": "10:46",
      "text": "கொஞ்சம் பேட்"
    },
    {
      "t": "10:48",
      "text": "யூஸ் பண்ணி பேசமா"
    },
    {
      "t": "10:50",
      "text": "உம்"
    },
    {
      "t": "10:52",
      "text": "உம் பேசுவா"
    },
    {
      "t": "10:54",
      "text": "வேணாம"
    },
    {
      "t": "10:56",
      "text": ""
    },
    {
      "t": "10:58",
      "text": "நீ அம்மாௌவு் போட்டறோம்னா சொல்லுங்க"
    },
    {
      "t": "11:00",
      "text": "நல்லம்பரு கொடுக்கும்து முதல்ல போட"
    },
    {
      "t": "11:02",
      "text": "நீ"
    },
    {
      "t": "11:04",
      "text": "எப்படி எல்லாம் பேசனீன்னா"
    },
    {
      "t": "11:06",
      "text": "வீடியோ கால்ல புல்லா வரேன்ன சொல்லங்க நான்"
    },
    {
      "t": "11:08",
      "text": "உங்க ரெடி பண்றேன் ரெண்டாயிரம் ரூபா்"
    },
    {
      "t": "11:10",
      "text": ""
    },
    {
      "t": "11:12",
      "text": "ந ந ந உமா ந"
    },
    {
      "t": "11:14",
      "text": "மாத்திரம் காமிக்கும் அவ்வளவு தான் சும்மா"
    },
    {
      "t": "11:16",
      "text": "பேசோம் ஜாலியா பேசோம் அவ்வளவுதான்"
    },
    {
      "t": "11:18",
      "text": "ரமசா பேசறேன் அவ்வளவுதான்"
    },
    {
      "t": "11:20",
      "text": "மேல மட்டும் காமி"
    },
    {
      "t": "11:22",
      "text": "தானா பபைவ் ஹண்ட்ரட்"
    },
    {
      "t": "11:24",
      "text": ""
    },
    {
      "t": "11:26",
      "text": "ஓகேவாம்"
    },
    {
      "t": "11:28",
      "text": "சன்னோக்க"
    },
    {
      "t": "11:30",
      "text": "ஆஜமாா"
    },
    {
      "t": "11:32",
      "text": "உம் ஃபர்ஸ்ட்ட் ப்ே பண்ணுவ"
    },
    {
      "t": "11:34",
      "text": "வக்காம"
    },
    {
      "t": "11:36",
      "text": "ஏமாத்திட்டீங்கன்னா"
    },
    {
      "t": "11:38",
      "text": "ஏன் மக்க மாட்டான நீங்க"
    },
    {
      "t": "11:40",
      "text": "சொன்னாத நீங்க சொல்ற நம்பிக்கிறத"
    },
    {
      "t": "11:42",
      "text": "நானே வரேன் இப்ப நல்லாட்டு எல்லாக்கும் வந்தருக்கன்"
    },
    {
      "t": "11:44",
      "text": "ஸ்ட"
    },
    {
      "t": "11:46",
      "text": "அங்க சொல்லிட்டல்லே"
    },
    {
      "t": "11:48",
