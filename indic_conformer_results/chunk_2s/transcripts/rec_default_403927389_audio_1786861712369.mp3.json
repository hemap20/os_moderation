  "decoding": "ctc",
  "audio_duration_sec": 704.9130625,
  "processing_time_sec": 24.88345432281494,
  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "ಅಲ್ಲ"
    },
    {
      "t": "00:04",
      "text": "ಇನ್ಫೈ"
    },
    {
      "t": "00:06",
      "text": "ಸ್ ಿಪ್ ಲೆಫ್ಟ"
    },
    {
      "t": "00:08",
      "text": ""
    },
    {
      "t": "00:10",
      "text": ""
    },
    {
      "t": "00:12",
      "text": "ನ"
    },
    {
      "t": "00:14",
      "text": "ಆಯ್"
    },
    {
      "t": "00:16",
      "text": "ನಿಲ್ಲಿದ್ದ"
    },
    {
      "t": "00:18",
      "text": "ಬ್ಯಾಂಗ್ನಾ ಇವ"
    },
    {
      "t": "00:20",
      "text": "ನ್ನ"
    },
    {
      "t": "00:22",
      "text": "ನಾನ ಬ್ಯಾಂಗ್ಳೂರು ಇಲ್ಲಿ ಬ್ಯಾಂಗ್ಳೂರು"
    },
    {
      "t": "00:24",
      "text": "ಗಾಂಧಿಿನಗರ"
    },
    {
      "t": "00:26",
      "text": "ಹ"
    },
    {
      "t": "00:28",
      "text": "ಕ ಕೆ"
    },
    {
      "t": "00:30",
      "text": "ಹ್ಮ್ ನಂಗ್ದ ಹೆೇಬ್ಬಾರ"
    },
    {
      "t": "00:32",
      "text": "ಏನ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ"
    },
    {
      "t": "00:34",
      "text": "ಆ ನಾ ಬ ಬಿಿಸ್ಿನಸ್ ಮಾಡ"
    },
    {
      "t": "00:36",
      "text": "ಮಾಡ್ಕೊಂಡಿದಿ ನೀವ ನ್ ಮಾಡ್ಕೊಂಡಿದೀ್ರ"
    },
    {
      "t": "00:38",
      "text": "ನ ಕ್ಲಿನಿಕ್ ಸ್ಿನ್"
    },
    {
      "t": "00:40",
      "text": "ಹೇರ್ ಕ್ಲಿನಿಕ್"
    },
    {
      "t": "00:42",
      "text": "ಓ ಹ"
    },
    {
      "t": "00:44",
      "text": "ಪಕ್ಷೆ"
    },
    {
      "t": "00:46",
      "text": "ಎಲ್ಲಿ ಬಂದ್ಬಿಟ್ಟು"
    },
    {
      "t": "00:48",
      "text": "ಮ್ಯರಿೀಡಾ ಸಿಂಗಲ್"
    },
    {
      "t": "00:50",
      "text": "ನಾ ಕಿನ್ ಲೆಫ್ಟ್"
    },
    {
      "t": "00:52",
      "text": "ನಾನ್ ಆಕ್ಚುಲಿ ಮ್ಯಾರಡ್"
    },
    {
      "t": "00:54",
      "text": "ಹಟಟಾ"
    },
    {
      "t": "00:56",
      "text": "ಕಿೋಮೀಟರ್"
    },
    {
      "t": "00:58",
      "text": "ದ ರೋಡ್ ಸರಿ"
    },
    {
      "t": "01:00",
      "text": "ಏನ್ ಪರ್ಪಸ್ಗೆ ಬಂದಿದ್ದು"
    },
    {
      "t": "01:02",
      "text": "ಯಾರೋ ನಿಮ ತರ"
    },
    {
      "t": "01:04",
      "text": "ಚೆನ್ನಾಗಿರೋಬ್ಬ ಫ್ರಂಡ್ ಸಿಗ್ತಾರೆ ಅಂತ ಬಂದ"
    },
    {
      "t": "01:06",
      "text": "ಹ್ಮ"
    },
    {
      "t": "01:08",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:10",
      "text": "ಇ"
    },
    {
      "t": "01:12",
      "text": "ಮತ್ತೆ ಆಯ್ತಾ ತಿಂಡಿ ಎಲ್ಲ"
    },
    {
      "t": "01:14",
      "text": "ಆಯ್ತು ರಿಮ್ಸ್ ಆಯ್ತಾ"
    },
    {
      "t": "01:16",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:18",
      "text": "ಎಲ್ಲಿಂದ ನೀವು"
    },
    {
      "t": "01:20",
      "text": "ಏನಿದ್ದ ನೇಟಿವ್ ಯಾವುದು"
    },
    {
      "t": "01:22",
      "text": "ನೇಟಿವವ್ಲ್ಲ ಬಾಂಗ್ಳೂರು"
    },
    {
      "t": "01:24",
      "text": "ಪ"
    },
    {
      "t": "01:26",
      "text": "ಕಪರ್ ಬೆಂಗ್ಳೂರ್"
    },
    {
      "t": "01:28",
      "text": "ಸೊ ನೀವ ಇರೋದ್ ಮನೆ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ"
    },
    {
      "t": "01:30",
      "text": ""
    },
    {
      "t": "01:32",
      "text": "ಇಲ್ಲ ನಮ್ದೇ ನಮ್ದೇ ಓನರ್ಸ್"
    },
    {
      "t": "01:34",
      "text": "ಓಕೆ ನ್"
    },
    {
      "t": "01:36",
      "text": "ಎಲ್ಲಿ ಹೆಬ್ಬಾಳದಲ್ಲ"
    },
    {
      "t": "01:38",
      "text": "ಸ್ಟ್ರಟ್ ಹೆಬಳ"
    },
    {
      "t": "01:40",
      "text": "ನನ್ ಸಿಸ್ಟರ್ ಇದ್ದಾರೆ ಬಿಗ್ ಸಿಸ್ಟರ್"
    },
    {
      "t": "01:42",
      "text": "ಇವಾಗ ಸಿಸ್ಟರ್ ಜೊತೆ ಇೆಯಲ್ಲಿ್ಟ"
    },
    {
      "t": "01:44",
      "text": "ಸಿಸ್ಟರ್ ಮನೆಗೆ ಬಂದಿದ್ದೀನಿ ನಮ್ದು ಎಲ್ಲ ಒನ್"
    },
    {
      "t": "01:46",
      "text": "ಪ್ರಾಪರ್ ಹೌಸ್ಲ್ಲ ಉದಯನಗರ ಟನ್"
    },
    {
      "t": "01:48",
      "text": "ಅಪ್ಪ ಅಮ್ಮ"
    },
    {
      "t": "01:50",
      "text": "ಎಲ್ಲ ಅಲ್ಲ ಇದ"
    },
    {
      "t": "01:52",
      "text": "ಕ್ಷಿ"
    },
    {
      "t": "01:54",
      "text": "ಸೊ ಇುವ"
    },
    {
      "t": "01:56",
      "text": "ರಿಲೇಟೆಡ್ ಟು ಹೇರ್"
    },
    {
      "t": "01:58",
      "text": "ಚ ವರ್ಕಂಗ್"
    },
    {
      "t": "02:00",
      "text": "ಎಸ್ ಎ ಸ್ಟಾಫ್"
    },
    {
      "t": "02:02",
      "text": "ಎರ್ಿನಿ"
    },
    {
      "t": "02:04",
      "text": "ಯ ಸ್ಕಿನ್ ನ ೇ"
    },
    {
      "t": "02:06",
      "text": "ಕ್ಲಿನಿಕ್ ಎಚ್ ಪಿ ಆರ್ ಲೇಔುಡ್"
    },
    {
      "t": "02:08",
      "text": "ಕ ೆ"
    },
    {
      "t": "02:10",
      "text": "ಇನ್ನೂರ ಹತ್ರ ಆಯತು ಸೊ ಅದಿಕ್ಕೆನ್ಸ"
    },
    {
      "t": "02:12",
      "text": "ಎಷ್ಟ ಮನೆಯಿಂದ ಇಲ್ಲಿ ನೀ ಏರ್ ಆಗುತ್ತ ಅಂತೇಳ್ಬಿ"
    },
    {
      "t": "02:14",
      "text": "ಕೆ"
    },
    {
      "t": "02:16",
      "text": "ನೀವ ಏನ್ ಪರ್ಪಸ್ಗೆ ಬಂದಿರೋದಿಲ್ಲ"
    },
    {
      "t": "02:18",
      "text": "ಹ್ಮ"
    },
    {
      "t": "02:20",
      "text": "ಹ್ಮ್ ಫ್ರೆಂಡ್ ಕಖಾಲಿ ಇತಲ್ಲ"
    },
    {
      "t": "02:22",
      "text": "ಬಸ್ ಸುನನೆ ಇ್ದ ಕಿ ದೋಸ್ತಿಗೆ ಬನ್ನಿ"
    },
    {
      "t": "02:24",
      "text": "ಕಾಲ್ ಮಾಡಿ ಮಾತಾಡಿ"
    },
    {
      "t": "02:26",
      "text": "ಹದುೆ"
    },
    {
      "t": "02:28",
      "text": "ಸಾರಿ ಕಮ್ಮಗ ನ್"
    },
    {
      "t": "02:30",
      "text": "ದ"
    },
    {
      "t": "02:32",
      "text": "ದೋಸ್ತನ್ನ ಮಾಡ್ಕೊೊಳ್ಳೋದಕ್ಕೆೋೋ"
    },
    {
      "t": "02:34",
      "text": "ವರ್ಷ ಬರ"
    },
    {
      "t": "02:36",
      "text": "ದೋಸ್ತನಾ ದೋಸ್ತ ಯಾರ"
    },
    {
      "t": "02:38",
      "text": "ಹ್ಮ್ ಅೆ"
    },
    {
      "t": "02:40",
      "text": "ೂಸಿನ ದೋಸಾ"
    },
    {
      "t": "02:42",
      "text": "ಅಲ್ಲೋ"
    },
    {
      "t": "02:44",
      "text": "್ರೆ ನನ್ಗೆ ಅಡ್ವರ್ಟೈಸ್ಮೆಂಟ್"
    },
    {
      "t": "02:46",
      "text": "ಇಲ್ಲಿ"
    },
    {
      "t": "02:48",
      "text": "ಸರಿ ನೋಡಣ ಒಳ್ಳೆ ಫ್ರೆಂಡ್ ಸಿಗ್ತಾರೆ"
    },
    {
      "t": "02:50",
      "text": "ಎ"
    },
    {
      "t": "02:52",
      "text": "ಎಷ್ಟ್ ದಿನ ಆಯ್ತು ನೀ್ ಬಂದ್ಬಿಟ್ಟು"
    },
    {
      "t": "02:54",
      "text": "ಒನ್ ವೀಕ್ ಆಯ್ತು"
    },
    {
      "t": "02:56",
      "text": "ಇಲ್ಲಿ ನೋಡ್ರೆ ಎಲ್ಲಾ ಮ್ಯಾರೇಜ್ ಆಗಿರೋರು"
    },
    {
      "t": "02:58",
      "text": "ಏಜ್ಡ್ ಪೀಪಲ್ ಸಿಕ್ಸ್ಟಿ ಸೆ"
    },
    {
      "t": "03:00",
      "text": "ವಟಿ ಮೈಕ್ ಗಂತರ"
    },
    {
      "t": "03:02",
      "text": "ಎಲ್ಲ ಇಷ್ಟೇ ಇದೇ ತರ ಸಿಕ್ತ"
    },
    {
      "t": "03:04",
      "text": "ಂಗ ಸ"
    },
    {
      "t": "03:06",
      "text": "ಒಬ್ರು ಸಿಕ್ಕುದಲ್ಲ ನಾನು"
    },
    {
      "t": "03:08",
      "text": "ಅನ್ಮಾರಿಡ್ ಪರ್ಸನ್ ಜೊತೆ ಮಾತಾಡುವ್ಿಲ್ಲ"
    },
    {
      "t": "03:10",
      "text": "ನಂತರ ಎಲ್ರುೂ ಮ್ಯರಿಟ್ ಸಿಕ್ತಾ ಇದಾರೆ"
    },
    {
      "t": "03:12",
      "text": ""
    },
    {
      "t": "03:14",
      "text": "ಅಲ್ ಒಲ್ಲ ನಿಮ್ ತರ"
    },
    {
      "t": "03:16",
      "text": "ಒ ಟೂ ಮೆಂಬರ್ಸ್ ನೀನ್ ಮಿಕ್ಕಿದ"
    },
    {
      "t": "03:18",
      "text": "ನಲ್ಲ ಸಕ್ಸ್ಟಿ ಪ್ಲಸ್ ಸಕ್ಸ್ಟಿ"
    },
    {
      "t": "03:20",
      "text": "ವಾಟ್ ದ ಆರ್ ಸಚಿಂಗ್ ವಾಟ್ ವಲ್"
    },
    {
      "t": "03:22",
      "text": "ು"
    },
    {
      "t": "03:24",
      "text": "ಒ ಒಡ್"
    },
    {
      "t": "03:26",
      "text": "ಸಿಕ್ಸ್ಟಿ ಪ್ಲಸ್ ಅವರಿಗೆಲ್ಲ ಏನ್ ಮಾಡು"
    },
    {
      "t": "03:28",
      "text": "ೌದು ಏನಕ್ ಏನ್ ಪಾಪ ಸಿಕ್ ಬರ್ತೀರಾ"
    },
    {
      "t": "03:30",
      "text": "ಕೇಳಿದ್ ಅವ್ ಹೇಳ್ತಾರೆ ಸುಮನೆ ಟೈಮ್ ಪಾಸ್"
    },
    {
      "t": "03:32",
      "text": "ನ ಇ ಇ"
    },
    {
      "t": "03:34",
      "text": "ಮ"
    },
    {
      "t": "03:36",
      "text": "ವಾಟ್ ದ ವಲ್ ಡೂ"
    },
    {
      "t": "03:38",
      "text": "ಟೈಮ ಪ"
    },
    {
      "t": "03:40",
      "text": "ಲ್ಲ"
    },
    {
      "t": "03:42",
      "text": "ಎಲ್ಲಿ ಹೊಟ್ಟಿದ್ದೀರಾ"
    },
    {
      "t": "03:44",
      "text": "ಸರಿ"
    },
    {
      "t": "03:46",
      "text": "ಎಲ್ಲೋ ಒಡ್ ಉಡ್ಟ್ಟ ಗಿರ ಕಾರಲ್ಲ"
    },
    {
      "t": "03:48",
      "text": "ರಿಟರ್ನ್ ಬರ್ತಾ ಇದೀನಿ ಇಸ್ ಅದ್ಕ್ಕೆ"
    },
    {
      "t": "03:50",
      "text": "ಬೆ್ಯಾಂಗ್ಳೂರುಗೆ"
    },
    {
      "t": "03:52",
      "text": "ಬೆಂಗ್ೂರ್ಗೆ ಇಟನಾ ನಿಮ್ದ"
    },
    {
      "t": "03:54",
      "text": "ಆಕ್ ನ ನೋಡ್ಲಿ ಬಂದಿದ್ದೆ ನಾನು"
    },
    {
      "t": "03:56",
      "text": "ಪ್ರಾಪರ್ ಬಂದ್ಬಿಟ್ಟು ದರ್"
    },
    {
      "t": "03:58",
      "text": "ರ್ಗ ಚಿತ್ರದುರ್ಗ"
    },
    {
      "t": "04:00",
      "text": "ಶ"
    },
    {
      "t": "04:02",
      "text": "ಚಿತ್ರದುರ್ಗಂಟ್"
    },
    {
      "t": "04:04",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "04:06",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "04:08",
      "text": "ಗ ತೆಲುಗು ಮಾತಾಡ್ತೀರ"
    },
    {
      "t": "04:10",
      "text": "ಇಲ್ಲ ಚಿತ್ರದುರ್ಗ ಕರ್ನಾಟಕದದಲ್ಲಿದೆ"
    },
    {
      "t": "04:12",
      "text": ""
    },
    {
      "t": "04:14",
      "text": "ಹ ತುಂಬಾ ಜನ"
    },
    {
      "t": "04:16",
      "text": "ತೆಲುಗು ಮಾತಾಡ್ತಾರಲ್ವಾ ನಕ್ಕೆ"
    },
    {
      "t": "04:18",
      "text": "ದಲ್ಲಾತರ"
    },
    {
      "t": "04:20",
      "text": "ಚಿತ್ರದುರ್ಗ ಪಾವಗ"
    },
    {
      "t": "04:22",
      "text": "ಆವಲ್ಪ"
    },
    {
      "t": "04:24",
      "text": "ಹೊಸಪೇಟೆ ಅಂತಂದ್ರೆ ಸ್ವಲ್ಪ ಆಂಧ್ರ ಬೆಲ್ಟ್"
    },
    {
      "t": "04:26",
      "text": "ಪ್ರ"
    },
    {
      "t": "04:28",
      "text": "ಓ ಅಂದ್ರೆ ಬಡ"
    },
    {
      "t": "04:30",
      "text": ""
    },
    {
      "t": "04:32",
      "text": "ಎಲ್ಲಾ ಆಯಾ ಮಾತಾಡ್ತಾರೆ"
    },
    {
      "t": "04:34",
      "text": "ಬೋರ್ಡರ್ಲ್ಲ ಅಲ್ಲಿ"
    },
    {
      "t": "04:36",
      "text": ""
    },
    {
      "t": "04:38",
      "text": "ಹ ಎ ಎಲ್ಲ"
    },
    {
      "t": "04:40",
      "text": "ತ ಬಾಗ್ತ ನಿಮ್ಮ"
    },
    {
      "t": "04:42",
      "text": ""
    },
    {
      "t": "04:44",
      "text": "ಹೌದು ಇವಾಗ ನಮ್ ಕಡೆನೂ ಅಷ್ಟೆ ಸ್ವಲ್ಪ"
    },
    {
      "t": "04:46",
      "text": "ಭಜನಾ ಉಸ್ಕೋಟೆ ಕೋಲಾರ ಹೋದ್ರೆಲ್ಲ"
    },
    {
      "t": "04:48",
      "text": "ತಲುಗು ಮಾದದಲ್ಲಿ"
    },
    {
      "t": "04:50",
      "text": "ಸೊ ಹ"
    },
    {
      "t": "04:52",
      "text": "ನಿಮ್ಮ ಅಪ್ಪ ಅಮ್ಮ ಏನ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "04:54",
      "text": "ತುಂಬತ್ತ ಬೆಲೆ"
    },
    {
      "t": "04:56",
      "text": "ಕನ್ನಡದವ್ ಸಿಗುದ"
    },
    {
      "t": "04:58",
      "text": "ಪಾಪ ನಿ ತರ"
    },
    {
      "t": "05:00",
      "text": ""
    },
    {
      "t": "05:02",
      "text": ""
    },
    {
      "t": "05:04",
      "text": "ಆಲ್ಮೋಸ್ಟ್ ಇವಾಗ್ಲೂ ಕೂಡ ನಾ"
    },
    {
      "t": "05:06",
      "text": "ಮಾತಾಡಿದೀಿ ಆಲ್ಮೋಸ್ಟ್ ಮಾತಾಡಿರೋದ್ರ"
    },
    {
      "t": "05:08",
      "text": "ಕಲ್ಕದ ಅವ್ರು ಇಲ್ವೇ ಇಲ್ಲ"
    },
    {
      "t": "05:10",
      "text": ""
    },
    {
      "t": "05:12",
      "text": "ತುಂಬಾರ ೇರು"
    },
    {
      "t": "05:14",
      "text": "ಅ"
    },
    {
      "t": "05:16",
      "text": "ಫಸ್ಟ್ ರಿಯಲ್ ಎಸ್ಟೇಟ್ ಮಾಡ್ತಿದ್ರು"
    },
    {
      "t": "05:18",
      "text": "ಆಕ್ಸಿಡೆಂಟ್ ಆದ್ಮೇಲೆ ಇವಾಗ ಮನೇಲಿ ಇರ್ತಾರೆ"
    },
    {
      "t": "05:20",
      "text": "ಅಮ್ಮ ಮನೆಯಲ್ಲ ಎತಾರೆ"
    },
    {
      "t": "05:22",
      "text": "ಸೊ ನಾನ್ ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ ನ"
    },
    {
      "t": "05:24",
      "text": "ಸಿಸ್ಟರು ಇದ ಮುಳ"
    },
    {
      "t": "05:26",
      "text": "ಮಾಡ್ತಿದ್ದಾಳೆ ಅಣ್ಣ"
    },
    {
      "t": "05:28",
      "text": "ನಮ್ಮನ್ನ ಅ ನೋಡ್ಕಂತ ಎೇಟ್"
    },
    {
      "t": "05:30",
      "text": ""
    },
    {
      "t": "05:32",
      "text": ""
    },
    {
      "t": "05:34",
      "text": "ಅಪ್ಪಮ್ಮ"
    },
    {
      "t": "05:36",
      "text": "ಅಂದ್ರೆ ನನ್ ಕೇಳಿಸ್ಲಿಲ್ಲ ನೆಟ್ವರ್ಕ್ ತುಂಬಾ"
    },
    {
      "t": "05:38",
      "text": "ಅಪ್ಪ ರಿಯಲ್ ಎಸ್ಟೇಟ್ ಮಾಡ್ತಿದ್ರು"
    },
    {
      "t": "05:40",
      "text": "ಫೈ್ ಫೈವ್ ಇಸ್ ಬ್ಯಾಕ್"
    },
    {
      "t": "05:42",
      "text": "ಕಲ್ ಅವ್ರಿಗೆ ಒಂದು ಆಕ್ಸಿಡೆಂಟ್ ಆಯ್ತು"
    },
    {
      "t": "05:44",
      "text": "ಮನೆ ಭೇದ"
    },
    {
      "t": "05:46",
      "text": "ಮಮ್ಮಿ ಹಸ ಬ"
    },
    {
      "t": "05:48",
      "text": "ಅಮ್ಮಾನ ಮನೆಯಲ್ಲ ಇೇರ್ತಾರೆ"
    },
    {
      "t": "05:50",
      "text": "ನಾನ್ ಇವಾಗ ರೀೆಂಟ್ ಆಗ ಒನ್ ಮಂತ್ ಆಯ್ತು"
    },
    {
      "t": "05:52",
      "text": "ಆಯ್ುನಿಗೆ ಚೆನ್ನ"
    },
    {
      "t": "05:54",
      "text": "ಆಫ್ಟರ್ ಡಿಗ್ರಿ ಸುಮ್ಮನೆ ಇದ್ದೆ ಸರಿ"
    },
    {
      "t": "05:56",
      "text": "ಕಡಿಗೆ"
    },
    {
      "t": "05:58",
      "text": ""
    },
    {
      "t": "06:00",
      "text": "ಹ್ಮ"
    },
    {
      "t": "06:02",
      "text": "ಕ"
    },
    {
      "t": "06:04",
      "text": ""
    },
    {
      "t": "06:06",
      "text": "ಬಿಕೋಮ"
    },
    {
      "t": "06:08",
      "text": "ಬಿಕೋಮ"
    },
    {
      "t": "06:10",
      "text": "ಹ ನೀ ಫಲ್ಡಿಂಗ್ ಮ ನೀ"
    },
    {
      "t": "06:12",
      "text": "ಈ ಫೀಲ್ಡ್ ಅಲ್ಲಿ ಏನ್ ಹೋಗಿದ್ದೀರಾ"
    },
    {
      "t": "06:14",
      "text": "ಹ"
    },
    {
      "t": "06:16",
      "text": "ಈ ಫೀಲ್ಡ್ ಅಲ್ಲಿ"
    },
    {
      "t": "06:18",
      "text": "ಬ ಈೀಲ್ಡ್"
    },
    {
      "t": "06:20",
      "text": "ಏನಂದ್ರೆ ಜಾಸ್ತಿ ಸ್ಕಿನ್ ಬಗ್ಗೆ"
    },
    {
      "t": "06:22",
      "text": "ಇಲ್ವಾ ಅದು ಸಿಕ್ಸ್ ಮಂತ್ ಕೋರ್ಸ್ ಇರುತ್ತೆ"
    },
    {
      "t": "06:24",
      "text": "ಅಷ್ಟಕ ನ ಕೋರ್ಸ್ ಮಾಡ್ಕೊಂಡಿದ"
    },
    {
      "t": "06:26",
      "text": "ರಿಿಯಲಿ ಕ್ಲಿನಿಕ ಆರ್ ಇಸ್ ಇಟ್"
    },
    {
      "t": "06:28",
      "text": "ಬ್ಯೂಟಿ ಸೆಂಟರ್"
    },
    {
      "t": "06:30",
      "text": "ಯಾ"
    },
    {
      "t": "06:32",
      "text": "ಇಲ್ಲ ಹೇರ್ಸ್ ಅಂಡ್ ಸ್ಕಿನ್ ಸ್ಕಿನ್ ಅಂಡ್ ಹೇರ್"
    },
    {
      "t": "06:34",
      "text": "ಡಾಕ್ಟರ್್ದಾರೆ"
    },
    {
      "t": "06:36",
      "text": "ನರ್ಸ್ಗಳಿದ್ದಾರೆ ಒ"
    },
    {
      "t": "06:38",
      "text": "ಸ್ಟಟ್ ನ್ ದ ರೂಡ್ ಕ"
    },
    {
      "t": "06:40",
      "text": ""
    },
    {
      "t": "06:42",
      "text": "ನಾನು ಉಳೇ ನಿಸ್ಪಾ"
    },
    {
      "t": "06:44",
      "text": "ನಾನು"
    },
    {
      "t": "06:46",
      "text": "ಸ್ಪೇ"
    },
    {
      "t": "06:48",
      "text": "ಸೊ ಇಟ್ಸ್ ಲೈಕ್ ಅ ಸ್ಮ ಓನ್ಲಿ"
    },
    {
      "t": "06:50",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "06:52",
      "text": "ೆ"
    },
    {
      "t": "06:54",
      "text": "ಆಲ್ಮೋಸ್ಟ್ ಪಾತ್ರರಾನೇ ಬಿಟ್ಟೆ"
    },
    {
      "t": "06:56",
      "text": "ಅಷ್ಟು ಇಲ್ಲ ಓವರ್ ನಾರ್ಮಲ್ ಸ್ವಾದ"
    },
    {
      "t": "06:58",
      "text": "ಇದು ಸ್ಕಿನ್ ಕೇರ್ಗೆ"
    },
    {
      "t": "07:00",
      "text": "ಮ ಹ"
    },
    {
      "t": "07:02",
      "text": "ಮೋಸ್ಟ್ ಫೇೇಶಿಯಲ್ಸ್ ಇಲ್ಲ ಇರುತ್ತೆ ಮಸಾಜ್ಗೆ"
    },
    {
      "t": "07:04",
      "text": "ದೆ ಇರಲ್ಲ ಸ್ಫಾನಲ್ಲಿ ಮಸ"
    },
    {
      "t": "07:06",
      "text": "ಚಲ್ಲದ ಅಂತಲ್ಲ ಇ"
    },
    {
      "t": "07:08",
      "text": "ಇದೆಲ್ಲಾ ಮೆಡಿಸಿನ್ ಇಂದ ಯೂಸ್ ಮಾಡ"
    },
    {
      "t": "07:10",
      "text": "ಮಾಡಿ ಫೇಶಿಯಲ್ಸ್ ಎ"
    },
    {
      "t": "07:12",
      "text": "ಂ ಕೊಡ್"
    },
    {
      "t": "07:14",
      "text": "ಮೆಡಿಕ"
    },
    {
      "t": "07:16",
      "text": "ಮೆಡಿಕಲ್ಸ್ ಪ ಅಂತ ಹೇಳ್ಬೋದು"
    },
    {
      "t": "07:18",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "07:20",
      "text": "ಹ್ಮ್ ಮ"
    },
    {
      "t": "07:22",
      "text": "ಹೇಳ್ಬೇಕು"
    },
    {
      "t": "07:24",
      "text": ""
    },
    {
      "t": "07:26",
      "text": "ಮತ್ತೆ ನಿಮ್ದು ಹೇಗಿದೆ ಬಿಸ್ಸ್"
    },
    {
      "t": "07:28",
      "text": "ಒಬ್ರೇ ನಾನ"
    },
    {
      "t": "07:30",
      "text": "ಸ ನಮಗೆ ಇಲ್ಲ"
    },
    {
      "t": "07:32",
      "text": "ಅಕ್ಕ ಇದ್ದಾರೆ ಅವರೆಲ್ಲಾ"
    },
    {
      "t": "07:34",
      "text": "ಕು"
    },
    {
      "t": "07:36",
      "text": "ಹಾ"
    },
    {
      "t": "07:38",
      "text": "ಲಾಸ್ ಶ"
    },
    {
      "t": "07:40",
      "text": "ಎಂಟಿಪೈಡ್ ಕಕ್ಟ್"
    },
    {
      "t": "07:42",
      "text": "ಲಾಟ್ಟ"
    },
    {
      "t": "07:44",
      "text": "ಾ ಲಸ್ೋಟ"
    },
    {
      "t": "07:46",
      "text": "ಕೈರ"
    },
    {
      "t": "07:48",
      "text": "ನೋಟದದ ಕ ಕ್ದ"
    },
    {
      "t": "07:50",
      "text": ""
    },
    {
      "t": "07:52",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "07:54",
      "text": "ಹೇಳಿ ಮತ್ತೆ"
    },
    {
      "t": "07:56",
      "text": "ಸಮ"
    },
    {
      "t": "07:58",
      "text": "ಗ"
    },
    {
      "t": "08:00",
      "text": "ನಲ್ವ ಸ್ವಲ್ಪತೀರಿ"
    },
    {
      "t": "08:02",
      "text": ""
    },
    {
      "t": "08:04",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ಆದ್ರೆ ಇ"
    },
    {
      "t": "08:06",
      "text": "ಮಾಡ್ತ"
    },
    {
      "t": "08:08",
      "text": "ನಾನೆಲ್ಲಾ ಸಿಟಿ ಹೊರ್ಗಡೆ ಇದ್ದಾಗ ಅಷ್ಟು"
    },
    {
      "t": "08:10",
      "text": "ನಿ್ ಮಐಸ ಏನ್ ಮಾಡ್ಕೊಂಡ"
    },
    {
      "t": "08:12",
      "text": "ನನ್ನ ಒಟ್ಟ"
    },
    {
      "t": "08:14",
      "text": "ವೈಫ್ ಅದು ಬ್ಯಾಂಕ್ ಬ್ಯಾಂಕ್ಲ್ಲಿ ಹೋಗ್ತಾಳೆ"
    },
    {
      "t": "08:16",
      "text": ""
    },
    {
      "t": "08:18",
      "text": "ಬ್ಯಾಂಕ ಕನರ ಬ್ಯಾಂಕ್"
    },
    {
      "t": "08:20",
      "text": "ಬ್ಯಾಂಕ್ ವರ್ಕ್ ಮಾಡ್ತಿದಾರಾ"
    },
    {
      "t": "08:22",
      "text": "ಎಬ"
    },
    {
      "t": "08:24",
      "text": "ಒಾಯ"
    },
    {
      "t": "08:26",
      "text": ""
    },
    {
      "t": "08:28",
      "text": "ಹ"
    },
    {
      "t": "08:30",
      "text": "ಹ ಹ್ಮ್"
    },
    {
      "t": "08:32",
      "text": "ಕಾರಿಂದಾಗಿ"
    },
    {
      "t": "08:34",
      "text": "ೆ ಮತ್ತೆ್ಮ"
    },
    {
      "t": "08:36",
      "text": "ಹ್ಮ"
    },
    {
      "t": "08:38",
      "text": "ಎಗೇನ್ ಕ್ಯಾರಿಂಗ ಓ"
    },
    {
      "t": "08:40",
      "text": ""
    },
    {
      "t": "08:42",
      "text": "ಒ ಮ ಅಡರಾ"
    },
    {
      "t": "08:44",
      "text": ""
    },
    {
      "t": "08:46",
      "text": ""
    },
    {
      "t": "08:48",
      "text": "ಹೌದು"
    },
    {
      "t": "08:50",
      "text": "ಕಿಸಿ ಕಸ ದ"
    },
    {
      "t": "08:52",
      "text": "ೌಂಡ್ ಮಾಡ್ತಿರ್ವಿ"
    },
    {
      "t": "08:54",
      "text": "ಂಗಫ ಬಿ"
    },
    {
      "t": "08:56",
      "text": "ಸಿಗೆ ಬಂದಿದ್ದೆ ಮತ್ತೆ ಉಡುಪಿ"
    },
    {
      "t": "08:58",
      "text": "ಯ ಆಕ್"
    },
    {
      "t": "09:00",
      "text": "ಮುಕಿಗೆ ಬಂದಿದೆ ಮುಲಕಿಂದತ್ತೆ ಉಡುಪಿ ಹೋಗ್ಬಟ್ಟು"
    },
    {
      "t": "09:02",
      "text": "ಆ"
    },
    {
      "t": "09:04",
      "text": "ದೇವಸ್ಥಾನಕ್ಕೆ ಹೋಗಿ"
    },
    {
      "t": "09:06",
      "text": "ರಿಟರ್ನ್ ಬರ್ತಾ ಇದನಿ"
    },
    {
      "t": "09:08",
      "text": ""
    },
    {
      "t": "09:10",
      "text": "ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "09:12",
      "text": "ಕೆ ಹಂದುನಾ ನೀವು ಪ್ರ"
    },
    {
      "t": "09:14",
      "text": "ಲ್ಲಿ ಬಟ್ಟು ಏನು ಇಲ್ಲ"
    },
    {
      "t": "09:16",
      "text": "ಕೃಷ್ಣ ಮಟ್ಟದಲ್ಲಿ ಏನ"
    },
    {
      "t": "09:18",
      "text": "ಇಲ್ಲ ಅ ಹಾಚ್ಕೊಳಕ್ಕೆ"
    },
    {
      "t": "09:20",
      "text": "ಹ್ಮ"
    },
    {
      "t": "09:22",
      "text": "ಹ"
    },
    {
      "t": "09:24",
      "text": "ಹ್ಮ"
    },
    {
      "t": "09:26",
      "text": "ಓ ಕೃಷ್ಣಮಠ ಮಾತ್ರ ನೋಡ್ಕೊಂಡ"
    },
    {
      "t": "09:28",
      "text": "ಬಂದರ"
    },
    {
      "t": "09:30",
      "text": ""
    },
    {
      "t": "09:32",
      "text": "ಮತ್ತೆನ ಸಾಚ"
    },
    {
      "t": "09:34",
      "text": "ಮತ್ತೆ ಏನ್ ಸಂಡೆ ಸ್ಪೆಷಲ್ ವೆಜ್"
    },
    {
      "t": "09:36",
      "text": "ನಾನ್ ವೆಜ್ ನೀವು"
    },
    {
      "t": "09:38",
      "text": ""
    },
    {
      "t": "09:40",
      "text": "ಹಲೋ"
    },
    {
      "t": "09:42",
      "text": ""
    },
    {
      "t": "09:44",
      "text": "ಹ"
    },
    {
      "t": "09:46",
      "text": "ಹಲೋ"
    },
    {
      "t": "09:48",
      "text": "ಹಲೋ ವೆಜಿಟೇರಿಯನ್"
    },
    {
      "t": "09:50",
      "text": "ಅಯ ಪು"
    },
    {
      "t": "09:52",
      "text": "ಪ ಪ್ಯೋರ್ ಪ್ಯೋರ್ ಹಂಡ್ರೆಡ್ ಪರ್ಸೆಟ್"
    },
    {
      "t": "09:54",
      "text": "ಫೆಟ್ ನಾನ್ ವೆಜಿಟೇರಿಯನ್"
    },
    {
      "t": "09:56",
      "text": ""
    },
    {
      "t": "09:58",
      "text": ""
    },
    {
      "t": "10:00",
      "text": ""
    },
    {
      "t": "10:02",
      "text": "ಹ ಗಾ ನಾನಲ ಪಿ"
    },
    {
      "t": "10:04",
      "text": "ವೆಜಿಟೇರಿಯನ್"
    },
    {
      "t": "10:06",
      "text": "ನಂ ಸುಳ್ಳಲ್ಲ ಅಭ್ಯಾಸ ಇಲ್ಲ ನಾನ್ ಸುಳ್ಳ"
    },
    {
      "t": "10:08",
      "text": "ಫ್ರೆಂಡ್ಶಿಪ್ ಮರಲ್ಲ"
    },
    {
      "t": "10:10",
      "text": "ಪ್ಯೂರ್ ನ ವೆಜಿಟೇರಿಯನ"
    },
    {
      "t": "10:12",
      "text": "ಅಂದ್ರೆ ಡೈಲಿ ನ"
    },
    {
      "t": "10:14",
      "text": "ಅಲ್ಲ ನನ ಇರ್ಲೇ ಬೇಕ"
    },
    {
      "t": "10:16",
      "text": "ಲ್ಲ ಇದರು ತೊಂದ್ರರೆ"
    },
    {
      "t": "10:18",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "10:20",
      "text": "ಇಲ್ಲಾಂದ್ರರು ವೆಜ್ಜ್ ಆರಾಮಾಗಿ"
    },
    {
      "t": "10:22",
      "text": "ಬಟ್ ವಾರದಲ್"
    },
    {
      "t": "10:24",
      "text": "ಎಟ್ೀಸ್ಟ್ ತ್ರೀ ಟೈ್ಸ್ ತಿಂತೀಿ ನಾನನ್ ವೀಕ್ಲಿ"
    },
    {
      "t": "10:26",
      "text": "ಎಕ್ಸೆಪ್ಟ ಸ್ಯಾಟರ್ಡೆ"
    },
    {
      "t": "10:28",
      "text": "ಹ ಐ ತ್ರೀ ಟೈಮ್ಸ್"
    },
    {
      "t": "10:30",
      "text": "ಇನ್ ಅ ವೀಕ್"
    },
    {
      "t": "10:32",
      "text": ""
    },
    {
      "t": "10:34",
      "text": ""
    },
    {
      "t": "10:36",
      "text": ""
    },
    {
