      "text": "കൊൈക്കറ"
    },
    {
      "t": "00:22",
      "text": "എ"
    },
    {
      "t": "00:24",
      "text": "വർക്ക് ചെയ്യുന്നു"
    },
    {
      "t": "00:26",
      "text": "ഉ എവിടെ"
    },
    {
      "t": "00:28",
      "text": "ഞാൻ ദുബായില"
    },
    {
      "t": "00:30",
      "text": "ദുബായ"
    },
    {
      "t": "00:32",
      "text": ""
    },
    {
      "t": "00:34",
      "text": "നിങ്ങങ്ങള് പഠിക്കാം"
    },
    {
      "t": "00:36",
      "text": "ആ ശരി"
    },
    {
      "t": "00:38",
      "text": "ഹൗസ് വൈഫ ആ"
    },
    {
      "t": "00:40",
      "text": "കണ്ടാ പറയിലാലോ"
    },
    {
      "t": "00:42",
      "text": "ലക്കില്ലല്ലഹ"
    },
    {
      "t": "00:44",
      "text": "ആഹ"
    },
    {
      "t": "00:46",
      "text": "ഇയർ വല്ല സെക്ക് ഇയർ ഫ"
    },
    {
      "t": "00:48",
      "text": "ഫസ്റ്റ് ഇയറ"
    },
    {
      "t": "00:50",
      "text": "നൂട നെടിക്കട്ട"
    },
    {
      "t": "00:52",
      "text": "ആഹ്"
    },
    {
      "t": "00:54",
      "text": "ട്ട"
    },
    {
      "t": "00:56",
      "text": "വേ"
    },
    {
      "t": "00:58",
      "text": ""
    },
    {
      "t": "01:00",
      "text": "ശടരിക്ക"
    },
    {
      "t": "01:02",
      "text": "എത്ര വയസല്ലേ"
    },
    {
      "t": "01:04",
      "text": "കുട്ടിക്ക"
    },
    {
      "t": "01:06",
      "text": "ണ്ട് ഒരു വഴ ആണ പോണ്ട"
    },
    {
      "t": "01:08",
      "text": ""
    },
    {
      "t": "01:10",
      "text": "എന്താ പറയിലല്ലോ"
    },
    {
      "t": "01:12",
      "text": "അന്തന്നാണ്"
    },
    {
      "t": "01:14",
      "text": "ഉട്ടരെ വേൻമ്പ പിടിച്ച കെട്ടി"
    },
    {
      "t": "01:16",
      "text": ""
    },
    {
      "t": "01:18",
      "text": "ഏ"
    },
    {
      "t": "01:20",
      "text": "ഞാനായിട്ട് കണ്ട പോയി"
    },
    {
      "t": "01:22",
      "text": "ഇന ആായിട്ട്"
    },
    {
      "t": "01:24",
      "text": "ലവ് മോരേജ ആ"
    },
    {
      "t": "01:26",
      "text": "ആ"
    },
    {
      "t": "01:28",
      "text": "ഓപ്പന്ന"
    },
    {
      "t": "01:30",
      "text": "പത്ര വയസ്സ"
    },
    {
      "t": "01:32",
      "text": ""
    },
    {
      "t": "01:34",
      "text": "അതും പറ"
    },
    {
      "t": "01:36",
      "text": "യ ലക്ക് ലൈ"
    },
    {
      "t": "01:38",
      "text": "ട് ട്വന് ീ"
    },
    {
      "t": "01:40",
      "text": ""
    },
    {
      "t": "01:42",
      "text": ""
    },
    {
      "t": "01:44",
      "text": "ഉ"
    },
    {
      "t": "01:46",
      "text": "എന്തായാല"
    },
    {
      "t": "01:48",
      "text": "ഞെട്ടലായി"
    },
    {
      "t": "01:50",
      "text": "ബിട്ടി"
    },
    {
      "t": "01:52",
      "text": "ഒരുപാട് പേര് നക്കാറുണ്ട് ശരി"
    },
    {
      "t": "01:54",
      "text": "ചിലരാണും ചിലര"
    },
    {
      "t": "01:56",
      "text": "അ"
    },
    {
      "t": "01:58",
      "text": "ഞാൻ പിന്നെ ഉറങ്ങിണീച്ചിട്ട്"
    },
    {
      "t": "02:00",
      "text": "രിോ ഇത"
    },
    {
      "t": "02:02",
      "text": "ാക്കി കുിക്കറയണ്ട്"
    },
    {
      "t": "02:04",
      "text": "എന്ത ചെയ്യാ"
    },
    {
      "t": "02:06",
      "text": "ഓ അത് ശരിയല്ലേ"
    },
    {
      "t": "02:08",
      "text": "ഹ നീ ഇത് പറഞ്ഞ എക്സിബിഷൻ കാണാൻ പറ്റും"
    },
    {
      "t": "02:10",
      "text": ""
    },
    {
      "t": "02:12",
      "text": "ചരെ കണ്ട് കന്ന"
    },
    {
      "t": "02:14",
      "text": "വി"
    },
    {
      "t": "02:16",
      "text": "ആ സത്യോ ഞാൻ വിചാരിച്ച"
    },
    {
      "t": "02:18",
      "text": "ഏതോ സ്കൂള പഠിക്കുന്ന"
    },
    {
      "t": "02:20",
      "text": "കോളേജിൽ പഠിക്കുന്ന കുട്ടിയണോ"
    },
    {
      "t": "02:22",
      "text": "ഉ ആഹ"
    },
    {
      "t": "02:24",
      "text": "ഉ"
    },
    {
      "t": "02:26",
      "text": "പി പിന്നെ എണീട്ട്"
    },
    {
      "t": "02:28",
      "text": "പട്ടൊക്കെ തുറക്കാൻ മാറ്റിയയിട്ടാണ്"
    },
    {
      "t": "02:30",
      "text": "എക്ക് എ ആക്ഷ കാണ"
    },
    {
      "t": "02:32",
      "text": "അ ന"
    },
    {
      "t": "02:34",
      "text": "തടപ്പ കൊടുക്കരു പരിപാടിയല്ല"
    },
    {
      "t": "02:36",
      "text": "ആഹ ആഹ"
    },
    {
      "t": "02:38",
      "text": "ലെറ്റ് ബട്ട"
    },
    {
      "t": "02:40",
      "text": "ഓൺ ദിസ് ലൈറ്റ്"
    },
    {
      "t": "02:42",
      "text": "പ്രധണ"
    },
    {
      "t": "02:44",
      "text": "എന്താ"
    },
    {
      "t": "02:46",
      "text": "ഇതിന്റെ മുഖന്നണ"
    },
    {
      "t": "02:48",
      "text": "പളോ"
    },
    {
      "t": "02:50",
      "text": "അച് നലത്ത"
    },
    {
      "t": "02:52",
      "text": "വ ക്യാമറ കുറ"
    },
    {
      "t": "02:54",
      "text": "ഉ ആ"
    },
    {
      "t": "02:56",
      "text": "ഇപ്പളാ"
    },
    {
      "t": "02:58",
      "text": "എട്ട കണ"
    },
    {
      "t": "03:00",
      "text": "ഓക്കെ"
    },
    {
      "t": "03:02",
      "text": "കൊറങ്ങണീട്ട"
    },
    {
      "t": "03:04",
      "text": "അതിന്റെ ക്ഷണണംണ്ട് പിന്നെ"
    },
    {
      "t": "03:06",
      "text": "അപ്പ വലിയൊരു ചണ്ടല്ല അപ്പൊ നല്ല"
    },
    {
      "t": "03:08",
      "text": "ഞ"
    },
    {
      "t": "03:10",
      "text": "അല്ല ഞാൻ ഉറങ്ങിയത് ആറ മണിക്കാണ്"
    },
    {
      "t": "03:12",
      "text": "ഉ"
    },
    {
      "t": "03:14",
      "text": "ആറ ആറരക്ക്െ നൂവി"
    },
    {
      "t": "03:16",
      "text": "പോയി വന്ന്"
    },
    {
      "t": "03:18",
      "text": "പിന്നെ ഫോൺ നോക്കി കിടന്നു"
    },
    {
      "t": "03:20",
      "text": "ഔരംഗാബാദ്ട്ട"
    },
    {
      "t": "03:22",
      "text": "പിന്നെ"
    },
    {
      "t": "03:24",
      "text": "ങ്ങറങ്ങ പോയി"
    },
    {
      "t": "03:26",
      "text": "ഉം ഉ"
    },
    {
      "t": "03:28",
      "text": ""
    },
    {
      "t": "03:30",
      "text": "ആ കുടിപ്പ തരു"
    },
    {
      "t": "03:32",
      "text": "സ്നാപ്പ"
    },
    {
      "t": "03:34",
      "text": "ആപ്പൊ എടുത്ത"
    },
    {
      "t": "03:36",
      "text": "ഒരുപാടായിരുന്നു"
    },
    {
      "t": "03:38",
      "text": "പ്പ എടുത്തിട്ട് ആക്ച്വലി ഞാന്"
    },
    {
      "t": "03:40",
      "text": "ു വീക്സ്  വീക്സ്"
    },
    {
      "t": "03:42",
      "text": "ല്ല കഴിഞ്ഞ മാസം"
    },
    {
      "t": "03:44",
      "text": "ആ അട്ടലന്ന അ"
    },
    {
      "t": "03:46",
      "text": "പ്പ ഡൗൺലോഡ് ആാക്കി"
    },
    {
      "t": "03:48",
      "text": "യൂസ് ചെയ്ത്ക്കിരുന്നു പിന്നെ"
    },
    {
      "t": "03:50",
      "text": "നല്ല ചിലവാന്ന് കണ്ടപ്പോ ഞാൻ ഡിലീറ്റ് ആയി"
    },
    {
      "t": "03:52",
      "text": "പിന്നെ"
    },
    {
      "t": "03:54",
      "text": "ഇന്ന് രാവിലെ ഒന്ന് ഡൗൺലോഡ് ആ"
    },
    {
      "t": "03:56",
      "text": "ബോടിച്ചട്ട"
    },
    {
      "t": "03:58",
      "text": "ഉം ഉം"
    },
    {
      "t": "04:00",
      "text": "എ ഇങ്ങനെ ഉണ്ട്സക്ക"
    },
    {
      "t": "04:02",
      "text": "ചെിലവ് കൂടുതലാണ്"
    },
    {
      "t": "04:04",
      "text": "എൻ കൂടലല്ലേ"
    },
    {
      "t": "04:06",
      "text": "ഇടക്ക് നമ്മള് നല്ല ആൾക്കാരെ കിട്ടി"
    },
    {
      "t": "04:08",
      "text": "ഇങ്ങനെ സംസാരിക്കുമ്പോായിരിക്കും നമ്മള മിനി"
    },
    {
      "t": "04:10",
      "text": "അപ്പ പെെന്ന്"
    },
    {
      "t": "04:12",
      "text": "അടുത്തറിയ വ"
    },
    {
      "t": "04:14",
      "text": "വിട്ട്"
    },
    {
      "t": "04:16",
      "text": "ഇതെങ്ങനെ റീചാർജ് ചെയ്യ"
    },
    {
      "t": "04:18",
      "text": "ല്ല സ്പെഷ്യലി വീഡിയോ കോളിന് നല്ല"
    },
    {
      "t": "04:20",
      "text": "പൈസ കട്ടാവ പോ"
    },
    {
      "t": "04:22",
      "text": "ന രീതി"
    },
    {
      "t": "04:24",
      "text": "ഉ അതുകൊണ്ട്"
    },
    {
      "t": "04:26",
      "text": "ക്കട്ട"
    },
    {
      "t": "04:28",
      "text": ""
    },
    {
      "t": "04:30",
      "text": "ഉം"
    },
    {
      "t": "04:32",
      "text": ""
    },
    {
      "t": "04:34",
      "text": "ഉ ഫഡക്കസഴിച്ച"
    },
    {
      "t": "04:36",
      "text": "ായി"
    },
    {
      "t": "04:38",
      "text": ""
    },
    {
      "t": "04:40",
      "text": ""
    },
    {
      "t": "04:42",
      "text": "ഇവൻ ട്വൻ സവൻ"
    },
    {
      "t": "04:44",
      "text": "പതിനൊന്ന് ഇരുപത്തിേഴ്"
    },
    {
      "t": "04:46",
      "text": "അ"
    },
    {
      "t": "04:48",
      "text": "പതിനൊന്ന് മണിരും"
    },
    {
      "t": "04:50",
      "text": "അതിനികന്നരയാണ പോ"
    },
    {
      "t": "04:52",
      "text": "കറക് അ നന്ദ"
    },
    {
      "t": "04:54",
      "text": "വരാവാ പോ"
    },
    {
      "t": "04:56",
      "text": "അല്ല എന്റെപ്പ"
    },
    {
      "t": "04:58",
      "text": "പറസ വേണംന്ന് പറഞ്ഞു"
    },
    {
      "t": "05:00",
      "text": "ആ ശരി"
    },
    {
      "t": "05:02",
      "text": "എന്റെ ഉമ്മിച്ച് പുറത്തു പോണംന്ന് പറഞ്ഞെ"
    },
    {
      "t": "05:04",
      "text": "എ കൊണ്ടു പോവാനായിട്ട്"
    },
    {
      "t": "05:06",
      "text": "പറഞ്ഞ"
    },
    {
      "t": "05:08",
      "text": ""
    },
    {
      "t": "05:10",
      "text": "ആഹ ഓക്കെ ഓെ ഓെ"
    },
    {
      "t": "05:12",
      "text": "അങ്ങന"
    },
    {
      "t": "05:14",
      "text": "ചെയ"
    },
    {
      "t": "05:16",
      "text": "കൊണ്ടുവ"
    },
    {
      "t": "05:18",
      "text": "പത്ത് മണിയാകുമ്പ വരും നമ്മ ഇതുവരെും"
    },
    {
      "t": "05:20",
      "text": "പിന്നെ ച അതൊ"
    },
    {
      "t": "05:22",
      "text": ""
    },
    {
      "t": "05:24",
      "text": "ഞാൻ റെഡിയായിട്ടൊന്നും മസമല്ല"
    },
    {
      "t": "05:26",
      "text": "നള് ദുബായി നി ഇങ്ങ വരണ്ടേ"
    },
    {
      "t": "05:28",
      "text": "ഓഹ അങ്ങാനെ"
    },
    {
      "t": "05:30",
      "text": "പ്പായിന്ന് വന്ന്"
    },
    {
      "t": "05:32",
      "text": "ആയി ആഹ"
    },
    {
      "t": "05:34",
      "text": "അവര് ദുബായിലാണ് അവര് പോ"
    },
    {
      "t": "05:36",
      "text": "പു പോണംന്ന് പറു"
    },
    {
      "t": "05:38",
      "text": "അവര് അവിടുന്ന് നീ"
    },
    {
      "t": "05:40",
      "text": "ഇവിടന്ന് പോകുന്ന നല്ലല്ലേ ഓ"
    },
    {
      "t": "05:42",
      "text": "ഏ ഞാന ഇവിടെ ഞ"
    },
    {
      "t": "05:44",
      "text": "ഞൻ ഇവിടന്ന് നാളെ പോട്ടോളൂ പുറത്തോട്ട്"
    },
    {
      "t": "05:46",
      "text": "പിങ്ങട്ടല്ല"
    },
    {
      "t": "05:48",
      "text": "ഓക്കെ ഓക്കെ ഓക്കെ"
    },
    {
      "t": "05:50",
      "text": "എന്ന് ബേബിന്നെ ഉറക്കിയിട്ട്"
