{
  "file_id": "rec_audio_call_424886004_audio_1788837418505.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 334.101,
  "processing_time_sec": 11.195895910263062,
  "segments": [
    {
      "t": "00:00",
      "text": "అ"
    },
    {
      "t": "00:02",
      "text": ""
    },
    {
      "t": "00:04",
      "text": "ఆ పెద్దమ్మా"
    },
    {
      "t": "00:06",
      "text": "హలో"
    },
    {
      "t": "00:08",
      "text": "ఎ పొలాం నగర్ వేరు"
    },
    {
      "t": "00:10",
      "text": "హలో"
    },
    {
      "t": "00:12",
      "text": "హలో"
    },
    {
      "t": "00:14",
      "text": "అస పలమనగర కి న"
    },
    {
      "t": "00:16",
      "text": "ఏనును"
    },
    {
      "t": "00:18",
      "text": "రా మమ్మీ వళ్ళేదు"
    },
    {
      "t": "00:20",
      "text": "ఒక్కదన్న ఉన్నా"
    },
    {
      "t": "00:22",
      "text": "బట్లో ఎప్పుడు"
    },
    {
      "t": "00:24",
      "text": ""
    },
    {
      "t": "00:26",
      "text": "ఆ"
    },
    {
      "t": "00:28",
      "text": "మా సిస్టర్ ఉంది"
    },
    {
      "t": "00:30",
      "text": "అ మ సిిస్టర్ నిక్కడకన్నా"
    },
    {
      "t": "00:32",
      "text": "మరి నను వచ్చ"
    },
    {
      "t": "00:34",
      "text": "ఎందుకు"
    },
    {
      "t": "00:36",
      "text": "కలిసి అలా మాట్లాడుకో"
    },
    {
      "t": "00:38",
      "text": "కొందం కాఫీ ద ఒకకుంట"
    },
    {
      "t": "00:40",
      "text": "కల్పి"
    },
    {
      "t": "00:42",
      "text": "స"
    },
    {
      "t": "00:44",
      "text": "ఆ"
    },
    {
      "t": "00:46",
      "text": "గ ఫ్రెండ్స్ మ్యరేజ"
    },
    {
      "t": "00:48",
      "text": "ఎ సింగలా"
    },
    {
      "t": "00:50",
      "text": "ఏను సింగిల్ ను మరిడా"
    },
    {
      "t": "00:52",
      "text": "లేదు"
    },
    {
      "t": "00:54",
      "text": "మరి ఓన్లీ అంకుల్స్"
    },
    {
      "t": "00:56",
      "text": "చట మాట్లాడడి ఎాలలాన్నాడాల"
    },
    {
      "t": "00:58",
      "text": "ఈ"
    },
    {
      "t": "01:00",
      "text": "ఏం మాట్లాడతాం"
    },
    {
      "t": "01:02",
      "text": "ననే"
    },
    {
      "t": "01:04",
      "text": "బధలా వచ్చిన అబ్బాంది ఇంట్కి మాళ్ళ"
    },
    {
      "t": "01:06",
      "text": "ప్లేర్ అనేది వచ్చినంత"
    },
    {
      "t": "01:08",
      "text": "ఏమ ఇ వాళ్ళకి ఏమై"
    },
    {
      "t": "01:10",
      "text": "మా వాళ్ళకి ఏమి కాలే"
    },
    {
      "t": "01:12",
      "text": "మామ్మీ వాళ్ళు పొలం దగ్గరికి వెళ్లారని"
    },
    {
      "t": "01:14",
      "text": "ఏదో ఇలా అార్చంది నేనో బాధలు ఉన్నా"
    },
    {
      "t": "01:16",
      "text": "ఏం బాధలు ఉన్నావున్నా"
    },
    {
      "t": "01:18",
      "text": "ఒ మీలాంటి ఒక అబ్బాయి"
    },
    {
      "t": "01:20",
      "text": "మ్ అట్లా అయిపోయింది లైఫ్ మొత్తం"
    },
    {
      "t": "01:22",
      "text": "అచ్చా"
    },
    {
      "t": "01:24",
      "text": "ఓ హాస్పిటల్ పనిస్తా"
    },
    {
      "t": "01:26",
      "text": "హ"
    },
    {
      "t": "01:28",
      "text": ""
    },
    {
      "t": "01:30",
      "text": "వాచ్ పలే లో ఉందావాను"
    },
    {
      "t": "01:32",
      "text": "ఎందుకు"
    },
    {
      "t": "01:34",
      "text": "ఇ స్టార్ట్వుతు"
    },
    {
      "t": "01:36",
      "text": "లే"
    },
    {
      "t": "01:38",
      "text": "ఎక్కడతో"
    },
    {
      "t": "01:40",
      "text": "సరి"
    },
    {
      "t": "01:42",
      "text": "అ"
    },
    {
      "t": "01:44",
      "text": ""
    },
    {
      "t": "01:46",
      "text": "వాడడ వదిలెత్తే బలపడాల్సిన అవసరం"
    },
    {
      "t": "01:48",
      "text": "అ"
    },
    {
      "t": "01:50",
      "text": "నయ ఇంట్లో దాకా వచ్చినాక కూడావు"
    },
    {
      "t": "01:52",
      "text": "వదులైతే బాధపడకుండాే ఏం చేసుకుంటారు"
    },
    {
      "t": "01:54",
      "text": "మీస అదా"
    },
    {
      "t": "01:56",
      "text": "అక్కనే హైదరాబాద్ లో ఉండేది"
    },
    {
      "t": "01:58",
      "text": "గాని ఇక అట్లా అయిపోయిన వాళ్ళ ఉండే"
    },
    {
      "t": "02:00",
      "text": "తీస"
    },
    {
      "t": "02:02",
      "text": "వాాజపే ఉండేని"
    },
    {
      "t": "02:04",
      "text": "అప్పుడు"
    },
    {
      "t": "02:06",
      "text": "అ"
    },
    {
      "t": "02:08",
      "text": "ఎవరు"
    },
    {
      "t": "02:10",
      "text": "ను"
    },
    {
      "t": "02:12",
      "text": "ఏ న ఎప్ప నను ఎప్పు కనెక్టే"
    },
    {
      "t": "02:14",
      "text": ""
    },
    {
      "t": "02:16",
      "text": "నువ్ అవున కాదా చెప్పుదా నేను చెప్పు"
    },
    {
      "t": "02:18",
      "text": ""
    },
    {
      "t": "02:20",
      "text": "చెప్పు నేను ఎప్పుడని చెప్పానని"
    },
    {
      "t": "02:22",
      "text": "చెప్పినావు కాబట్టి మాట్లాడుతు"
    },
    {
      "t": "02:24",
      "text": "తు నా గుడుతచ్చి"
    },
    {
      "t": "02:26",
      "text": "హ"
    },
    {
      "t": "02:28",
      "text": "నా వాాలేదను"
    },
    {
      "t": "02:30",
      "text": "అలాా"
    },
    {
      "t": "02:32",
      "text": "బ చ పేళ"
    },
    {
      "t": "02:34",
      "text": "ద ను"
    },
    {
      "t": "02:36",
      "text": "బాజ్పేల అని బాజపేలు కావాలి"
    },
    {
      "t": "02:38",
      "text": "ఇంకా వేరు ఇకావేరుంది"
    },
    {
      "t": "02:40",
      "text": "హాస్పిటల్ లో వర్కు చేసినవాడు"
    },
    {
      "t": "02:42",
      "text": "అరవిందలా"
    },
    {
      "t": "02:44",
      "text": "అరిే"
    },
    {
      "t": "02:46",
      "text": "భింద చేయలే పేలే"
    },
    {
      "t": "02:48",
      "text": ""
    },
    {
      "t": "02:50",
      "text": "అరవిిందోనే ఏయిప్పిన మాక"
    },
    {
      "t": "02:52",
      "text": "ఏ మ ఎవని వాటుకుని ఎవ"
    },
    {
      "t": "02:54",
      "text": "నీక ఏం కొడుతున్నా"
    },
    {
      "t": "02:56",
      "text": ""
    },
    {
      "t": "02:58",
      "text": "నగ నిన్ వదలేష్ నోడైతే"
    },
    {
      "t": "03:00",
      "text": "ఇట్కనే కదా వేసింది"
    },
    {
      "t": "03:02",
      "text": "ఇక్కడ ఐటిఐ"
    },
    {
      "t": "03:04",
      "text": "జాబ్ చేస్తుంటాడు కదా"
    },
    {
      "t": "03:06",
      "text": "అరదాంగారు"
    },
    {
      "t": "03:08",
      "text": "ఐటిఐ లో ఏదో జాబ్ లో చేస్తాడు కదాండి"
    },
    {
      "t": "03:10",
      "text": "న్నా"
    },
    {
      "t": "03:12",
      "text": "అ"
    },
    {
      "t": "03:14",
      "text": "ఏం అప్పుడు మాట్లాడ వస్తుంది"
    },
    {
      "t": "03:16",
      "text": ""
    },
    {
      "t": "03:18",
      "text": "అరే నింతనా ఇన్ని గుర్ద"
    },
    {
      "t": "03:20",
      "text": "స్తేను కానీ ససం గుతు పెట్టుకోలే వెంది అబ్బ"
    },
    {
      "t": "03:22",
      "text": "నాగడద ముదు"
    },
    {
      "t": "03:24",
      "text": "నాకున్న టెన్షన్కి ఏం"
    },
    {
      "t": "03:26",
      "text": "పె టెన్షన్"
    },
    {
      "t": "03:28",
      "text": "మాటలు వస్తున్నాయి మ టెన్షన్ ఏయిందామ్"
    },
    {
      "t": "03:30",
      "text": "అ మాకా చ అడదాం కా"
    },
    {
      "t": "03:32",
      "text": "ఉంటగాట్లా"
    },
    {
      "t": "03:34",
      "text": ""
    },
    {
      "t": "03:36",
      "text": "అడి అమ్మా"
    },
    {
      "t": "03:38",
      "text": "చెప్పాన చెప్పిన ఆల్రెడీ మాంచి"
    },
    {
      "t": "03:40",
      "text": "ఎజా్ చేయ్యబడుతున్న నాను చెప్పేష్"
    },
    {
      "t": "03:42",
      "text": ""
    },
    {
      "t": "03:44",
      "text": "ఏ"
    },
    {
      "t": "03:46",
      "text": "డి"
    },
    {
      "t": "03:48",
      "text": "కావట్లేదు ట్రై చేస్తున్నా"
    },
    {
      "t": "03:50",
      "text": "దామరి నం చెక్ష"
    },
    {
      "t": "03:52",
      "text": "చన్న మైండ్ సెట్ అంత మ"
    },
    {
      "t": "03:54",
      "text": "చేేస్తాం"
    },
    {
      "t": "03:56",
      "text": "అబ్బ అట్లా రామ్బంట"
    },
    {
      "t": "03:58",
      "text": "అట్లా మస్తర్"
    },
    {
      "t": "04:00",
      "text": "అంటి"
    },
    {
      "t": "04:02",
      "text": "నన్నది జస్ట్ సెక్స్వల్ ఎంజాయ్"
    },
    {
      "t": "04:04",
      "text": "ంట ఇస్తూ ఉంటానుక అంత"
    },
    {
      "t": "04:06",
      "text": "నవ్వులు కూడా వేస్తా అని చెప్పా నేను"
    },
    {
      "t": "04:08",
      "text": ""
    },
    {
      "t": "04:10",
      "text": "బాధపడుతున్నావు బాధపడకుండా నేను మార్చ"
    },
    {
      "t": "04:12",
      "text": "స్తాంే ఎంజాయ్ చేసి చేయడానికి"
    },
    {
      "t": "04:14",
      "text": "చెప్పే"
    },
    {
      "t": "04:16",
      "text": "న"
    },
    {
      "t": "04:18",
      "text": "వస్తాను నేను చెప్పను"
    },
    {
      "t": "04:20",
      "text": "నేను చేసేంత ఖాళీ లేని వస్తు"
    },
    {
      "t": "04:22",
      "text": ""
    },
    {
      "t": "04:24",
      "text": "ఎందు కాాలని మస్ట్ కమెంట్యరా"
    },
    {
      "t": "04:26",
      "text": "నల కమ్మట"
    },
    {
      "t": "04:28",
      "text": "కాదు కానీ"
    },
    {
      "t": "04:30",
      "text": "అరే అరే"
    },
    {
      "t": "04:32",
      "text": "ై నాకు ఇంటరెస్ట్"
    },
    {
      "t": "04:34",
      "text": "వు పన"
    },
    {
      "t": "04:36",
      "text": "ఇీగ నన్ కమిట్మెంట్ సిగల్ేను"
    },
    {
      "t": "04:38",
      "text": "ఇచ్చి ఇబ్బంది పెట్టాలను"
    },
    {
      "t": "04:40",
      "text": "స్ట్రైట్ అ సక్"
    },
    {
      "t": "04:42",
      "text": "మాసజాచ్చ"
    },
    {
      "t": "04:44",
      "text": ""
    },
    {
      "t": "04:46",
      "text": "శ బబ"
    },
    {
      "t": "04:48",
      "text": "అ"
    },
    {
      "t": "04:50",
      "text": "స్ట్రేట్ ఫార్వర్డ్ అన్నట్టు"
    },
    {
      "t": "04:52",
      "text": "అ"
    },
    {
      "t": "04:54",
      "text": "కాంప్రమ"
    },
    {
      "t": "04:56",
      "text": "ఉండది నకు నచ్చినాంగ నాకు నచ్చినా"
    },
    {
      "t": "04:58",
      "text": "వ్వు మంచి ఇద్ద్రం కమిట్"
    },
    {
      "t": "05:00",
      "text": "అద"
    },
    {
      "t": "05:02",
      "text": "మ చసో టెన్ రిలీజ్ చేస్"
    },
    {
      "t": "05:04",
      "text": "నావవు బోలే నా బో నావుకున చె"
    },
    {
      "t": "05:06",
      "text": "నవ్వుకోవడం హ్యాపీనెస్ ఎక్వ"
    },
    {
      "t": "05:08",
      "text": "హపీెస్ దరు"
    },
    {
      "t": "05:10",
      "text": ""
    },
    {
      "t": "05:12",
      "text": "మంచి అనిపిస్తే మళ్ళీ కలుస్తాం అట్లనే"
    },
    {
      "t": "05:14",
      "text": ""
    },
    {
      "t": "05:16",
      "text": ""
    },
    {
      "t": "05:18",
      "text": "హలో"
    },
    {
      "t": "05:20",
      "text": "చెట్కో జడ సార్కుం జడాల స"
    },
    {
      "t": "05:22",
      "text": "ైఫ్లా"
    },
    {
      "t": "05:24",
      "text": ""
    },
    {
      "t": "05:26",
      "text": ""
    },
    {
      "t": "05:28",
      "text": "హలో"
    },
    {
      "t": "05:30",
      "text": "హ"
    },
    {
      "t": "05:32",
      "text": "చెప్పు నీకు ఇంత చెప్పినా నువవు అదే"
    },
    {
      "t": "05:34",
