    {
      "t": "00:06",
      "text": "ஹலோ"
    },
    {
      "t": "00:08",
      "text": ""
    },
    {
      "t": "00:10",
      "text": ""
    },
    {
      "t": "00:12",
      "text": "ஹலோ கேக்குதா"
    },
    {
      "t": "00:14",
      "text": "ஆஹ் கேக்கு சொல்லுங்க"
    },
    {
      "t": "00:16",
      "text": "உம் சாப்பிட்டாச்சா என்ன"
    },
    {
      "t": "00:18",
      "text": "பண்ணிக்கிறக்கீங்க"
    },
    {
      "t": "00:20",
      "text": "எந்த ஒருரு"
    },
    {
      "t": "00:22",
      "text": "நான் புதுக்கோட்டை"
    },
    {
      "t": "00:24",
      "text": "ஓ"
    },
    {
      "t": "00:26",
      "text": "சரி சரி ஹ"
    },
    {
      "t": "00:28",
      "text": "பேரு"
    },
    {
      "t": "00:30",
      "text": "ஜாஸ்த"
    },
    {
      "t": "00:32",
      "text": "அஸ்ின்"
    },
    {
      "t": "00:34",
      "text": ""
    },
    {
      "t": "00:36",
      "text": "தேங்க்யூ என்ன பண்ணிக்கிருக்கே"
    },
    {
      "t": "00:38",
      "text": "இ"
    },
    {
      "t": "00:40",
      "text": "இ்ச ரெஸ்ட் நைக்கல"
    },
    {
      "t": "00:42",
      "text": "உஹம்"
    },
    {
      "t": "00:44",
      "text": "சரி சரி"
    },
    {
      "t": "00:46",
      "text": "என்ன ஊருக்கு"
    },
    {
      "t": "00:48",
      "text": "ஹ"
    },
    {
      "t": "00:50",
      "text": "நானா என்னத்தை கேட்குறியன்"
    },
    {
      "t": "00:52",
      "text": "சாப்பலாம்னு கேக்குறீல என்ன"
    },
    {
      "t": "00:54",
      "text": "என் கிட்டா"
    },
    {
      "t": "00:56",
      "text": "ஹஸ்"
    },
    {
      "t": "00:58",
      "text": "ஹவுஸ் ஒயஃப் தான் வீட்டு வேலை பாரத்துுக்கக்கறேன்"
    },
    {
      "t": "01:00",
      "text": "சரி சரி"
    },
    {
      "t": "01:02",
      "text": "ஹ"
    },
    {
      "t": "01:04",
      "text": "ச"
    },
    {
      "t": "01:06",
      "text": "உஹம் அப்புறம் வீட்டுல"
    },
    {
      "t": "01:08",
      "text": "எல்லாரும் நல்லா இருக்காங்களா"
    },
    {
      "t": "01:10",
      "text": "க்கு என்ன ்பெஷல்"
    },
    {
      "t": "01:12",
      "text": ""
    },
    {
      "t": "01:14",
      "text": "சாப்பாடு ஏன் ஒரு சிலப்போ"
    },
    {
      "t": "01:16",
      "text": "சொல்றீலேமா"
    },
    {
      "t": "01:18",
      "text": "எப்பம்பது தயிர் சாப்பாடு தான்"
    },
    {
      "t": "01:20",
      "text": "அச்சா அச்சா"
    },
    {
      "t": "01:22",
      "text": "அதெல்லாம் சாப்பா நீங்கன்னா ஐயர் வீட்டு பையன்ன"
    },
    {
      "t": "01:24",
      "text": "ஏல்லல்லங்க"
    },
    {
      "t": "01:26",
      "text": "ஆஹ ப ஏ த எப்ப"
    },
    {
      "t": "01:28",
      "text": "இந்த வெயிலுக்கு தய சாப்பாடு தான் ந"
    },
    {
      "t": "01:30",
      "text": "ல்லது என்னாலும் தயத்த"
    },
    {
      "t": "01:32",
      "text": "சாப்போட்ட அது ஒரு இதாக தான்ும்"
    },
    {
      "t": "01:34",
      "text": "டன்சன் ஆகும்"
    },
    {
      "t": "01:36",
      "text": "உஹம் பாப்பா"
    },
    {
      "t": "01:38",
      "text": "அதல தான் இது போயிருண்டா"
    },
    {
      "t": "01:40",
      "text": "பேக்லோர்லான் வோல தயற்றப்படற"
    },
    {
      "t": "01:42",
      "text": "ப்பம்ப"
    },
    {
      "t": "01:44",
      "text": "உ கடில போய் பிரியாணி வாங்கி"
    },
    {
      "t": "01:46",
      "text": "நீங்க வேண்டியதானே"
    },
    {
      "t": "01:48",
      "text": "அப்படலாம்றதுக்கு பட்ஜெட் வேணும்"
    },
    {
      "t": "01:50",
      "text": "ஆமா அது வே"
    },
    {
      "t": "01:52",
      "text": "ான் ஒன்னும் இருநூறுூபா முன்னூறுா"
    },
    {
      "t": "01:54",
      "text": "ரோ விறக்குிது சாப்பாடு"
    },
    {
      "t": "01:56",
      "text": "ஆமா அஹ"
    },
    {
      "t": "01:58",
      "text": ""
    },
    {
      "t": "02:00",
      "text": "நல்லா இருண்டா பீஸ் பண்றீங்க"
    },
    {
      "t": "02:02",
      "text": "நான் நீ எத்த தான் இனதான்"
    },
    {
      "t": "02:04",
      "text": "டு பண்ணு"
    },
    {
      "t": "02:06",
      "text": "இந்தாவட ஒரு பண்ணி"
    },
    {
      "t": "02:08",
      "text": "அப்ப இப்பதான் வெரிபிகேஷனுக்கு போ"
    },
    {
      "t": "02:10",
      "text": "படிச்சாங்கவங்க"
    },
    {
      "t": "02:12",
      "text": "வெரிபிகேஷன் பண்ணவும் இப்ப காசு"
    },
    {
      "t": "02:14",
      "text": "வருது ஆ"
    },
    {
      "t": "02:16",
      "text": "உஹம்"
    },
    {
      "t": "02:18",
      "text": "உம் கேக்குறங்க காால்ச"
    },
    {
      "t": "02:20",
      "text": "பேசின இாண்டு ஒரு காலத்துில பேசின ஒரு"
    },
    {
      "t": "02:22",
      "text": "பத்து கால் பேசிருப்பேன் அப்புண்டு"
    },
    {
      "t": "02:24",
      "text": "உம்"
    },
    {
      "t": "02:26",
      "text": "நான் சும்மாாதான் அவளோட"
    },
    {
      "t": "02:28",
      "text": "பண்ண ஒரு அக்கா சொன்னாங்க இந்த ஆப்"
    },
    {
      "t": "02:30",
      "text": "அப்ப ஏஈத்து அப்படின்ட்டு"
    },
    {
      "t": "02:32",
      "text": "உம் சமாத அவ்ளோ"
    },
    {
      "t": "02:34",
      "text": "பண்ணி பார்த்தா அது வருது கால் வருது"
    },
    {
      "t": "02:36",
      "text": "உம்"
    },
    {
      "t": "02:38",
      "text": "ஹ உம்"
    },
    {
      "t": "02:40",
      "text": "ஸ்லா"
    },
    {
      "t": "02:42",
      "text": "உஹ"
    },
    {
      "t": "02:44",
      "text": "ஒவ்வொருத்தவோ நல்லா பேசுகிறாங்க"
    },
    {
      "t": "02:46",
      "text": "ஆனா ஹண்ட்ரட் பர்சன்் உங்களை மட்டும்"
    },
    {
      "t": "02:48",
      "text": "பேச மாட்டறாங்க"
    },
    {
      "t": "02:50",
      "text": "உஹம் வே எப்படி"
    },
    {
      "t": "02:52",
      "text": "த்த பேச ரெங்கத்"
    },
    {
      "t": "02:54",
      "text": "ஏன் ரூடா பேசுறாங்களா"
    },
    {
      "t": "02:56",
      "text": "ஆமா உம்"
    },
    {
      "t": "02:58",
      "text": "உம் ரொம்பதான் இதான் பேசுறா"
    },
    {
      "t": "03:00",
      "text": "என்ன சொன்னாங்க"
    },
    {
      "t": "03:02",
      "text": ""
    },
    {
      "t": "03:04",
      "text": "அதான் அந்த செக்ஸ் பண்ணுறத பிடிக்குமா அப்படிய"
    },
    {
      "t": "03:06",
      "text": "ஏப்படலாமா"
    },
    {
      "t": "03:08",
      "text": "ஆஹ் தான் கேக்குறாங்க வேற என்னத்த"
    },
    {
      "t": "03:10",
      "text": "க ஜோரத"
    },
    {
      "t": "03:12",
      "text": "ஓம்"
    },
    {
      "t": "03:14",
      "text": "உம்"
    },
    {
      "t": "03:16",
      "text": ""
    },
    {
      "t": "03:18",
      "text": "ல்ல இருக்கட்டும் என்ன பண்றது"
    },
    {
      "t": "03:20",
      "text": "இதுதான் பண்ணணும்"
    },
    {
      "t": "03:22",
      "text": "உம் ந"
    },
    {
      "t": "03:24",
      "text": "ட்டங்க இப்படிதான் பேசுவாங்கன்னு தெரியும்"
    },
    {
      "t": "03:26",
      "text": "அப்புறம் என்ன பண்ணுறது"
    },
    {
      "t": "03:28",
      "text": "பேசிட்டு போக நீடம்"
    },
    {
      "t": "03:30",
      "text": "பேசுறதுல என்ன வர போோது ஒன்னு வரப்பற"
    },
    {
      "t": "03:32",
      "text": "ில் பேசிட்டு போக வேடியிய தான்"
    },
    {
      "t": "03:34",
      "text": "உம்"
    },
    {
      "t": "03:36",
      "text": "ஆ தச போலதுே"
    }
