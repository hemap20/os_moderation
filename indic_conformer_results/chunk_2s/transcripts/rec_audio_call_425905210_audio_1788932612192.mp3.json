    {
      "t": "08:22",
      "text": "ంట"
    },
    {
      "t": "08:24",
      "text": "ంట మాట్లాడుతం దరుతద"
    },
    {
      "t": "08:26",
      "text": "గ"
    },
    {
      "t": "08:28",
      "text": "స్తవు నీకు ఎట్ ఎట్లా అంటే బాగుంటు"
    },
    {
      "t": "08:30",
      "text": ""
    },
    {
      "t": "08:32",
      "text": "బాగుంటారు ఇలాంటివి మానట్లు వస్తుంటే"
    },
    {
      "t": "08:34",
      "text": "మ"
    },
    {
      "t": "08:36",
      "text": "మేము డబ్బులు ఎస్ పని చేసిన"
    },
    {
      "t": "08:38",
      "text": "ఇ ఎడ మాపిద"
    },
    {
      "t": "08:40",
      "text": "కొట్టుకోడానికి ఈజ అయిపోంది"
    },
    {
      "t": "08:42",
      "text": "ఫ"
    },
    {
      "t": "08:44",
      "text": "అదే"
    },
    {
      "t": "08:46",
      "text": "అదక నంద ఉంట"
    },
    {
      "t": "08:48",
      "text": "అదప్పు ఎ"
    },
    {
      "t": "08:50",
      "text": "యస వంటకుమ పోద"
    },
    {
      "t": "08:52",
      "text": "హ"
    },
    {
      "t": "08:54",
      "text": "అదిల్ ఎది"
    },
    {
      "t": "08:56",
      "text": "డబ్బులు వసుకొని కాల్ చేస్తాంట"
    },
    {
      "t": "08:58",
      "text": ""
    },
    {
      "t": "09:00",
      "text": ""
    },
    {
      "t": "09:02",
      "text": "పేజన్ పట్టి మా"
    },
    {
      "t": "09:04",
      "text": "పా ఉంటాయి ఇడు"
    },
    {
      "t": "09:06",
      "text": "నాకంత న కరక్ట్ న కరక్ట్"
    },
    {
      "t": "09:08",
      "text": "ఫ తీ ఇయర్స్ నుండి"
    },
    {
      "t": "09:10",
      "text": "అ"
    },
    {
      "t": "09:12",
      "text": "పటితేస్తే"
    },
    {
      "t": "09:14",
      "text": "బట్టిచ్చంట అంతే"
    },
    {
      "t": "09:16",
      "text": "కావాలా ఉంటుంది బా"
    },
    {
      "t": "09:18",
      "text": ""
    },
    {
      "t": "09:20",
      "text": "ప పిఎస్"
    },
    {
      "t": "09:22",
      "text": "హ"
    },
    {
      "t": "09:24",
      "text": "మాత ప్రయసులు చవనిపిస్తుంది"
    },
    {
      "t": "09:26",
      "text": "అా"
    },
    {
      "t": "09:28",
      "text": "ఇదాంగలే"
    },
    {
      "t": "09:30",
      "text": "అంటే కొంట మ చేంది"
    },
    {
      "t": "09:32",
      "text": "కొ ముందుగాే చేసిపోతే"
    },
    {
      "t": "09:34",
      "text": "సర్వస్ లోన్"
    },
    {
      "t": "09:36",
      "text": "అవసరం"
    },
    {
      "t": "09:38",
      "text": ""
    },
    {
      "t": "09:40",
      "text": "ఎట్లా ఎట్లా"
    },
    {
      "t": "09:42",
      "text": ""
    },
    {
      "t": "09:44",
      "text": ""
    },
    {
      "t": "09:46",
      "text": "పోంట చేకుడా"
    },
    {
      "t": "09:48",
      "text": "ఆా"
    },
    {
      "t": "09:50",
      "text": ""
    },
    {
      "t": "09:52",
      "text": ""
    },
    {
      "t": "09:54",
      "text": "ఏ"
    },
    {
      "t": "09:56",
      "text": "ఇచ్చరి"
    },
    {
      "t": "09:58",
      "text": "అస"
    },
    {
      "t": "10:00",
      "text": "అంట"
    },
    {
      "t": "10:02",
      "text": "ఏ ఇ మలా"
    },
    {
      "t": "10:04",
      "text": ""
    },
    {
      "t": "10:06",
      "text": "స ఈ"
    },
    {
      "t": "10:08",
      "text": "జ మస్తలే బ"
