      "text": "അെ"
    },
    {
      "t": "04:42",
      "text": ""
    },
    {
      "t": "04:44",
      "text": ""
    },
    {
      "t": "04:46",
      "text": "അപ്പൊൊക്കെ"
    },
    {
      "t": "04:48",
      "text": "കാണോ"
    },
    {
      "t": "04:50",
