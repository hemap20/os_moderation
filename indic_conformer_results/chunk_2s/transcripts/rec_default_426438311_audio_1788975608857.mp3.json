  "segments": [
    {
      "t": "00:00",
      "text": "ഉ"
    },
    {
      "t": "00:02",
      "text": "ഹലോ"
    },
    {
      "t": "00:04",
      "text": "മറ്റേത്ത്തോളൂ"
    },
    {
      "t": "00:06",
      "text": "എവിടെയാ"
    },
    {
      "t": "00:08",
      "text": "ഞാൻ കണ്ണൂര്"
    },
    {
      "t": "00:10",
      "text": "എവിടാ കണ്ണൂട"
    },
    {
      "t": "00:12",
      "text": "എവിടെപ്പ ഉള്ളത് നാട്ടിലല്ലേ"
    },
    {
      "t": "00:14",
      "text": "ഏ നാട്ടിലല്ല"
    },
    {
      "t": "00:16",
      "text": ""
    },
    {
      "t": "00:18",
      "text": "ബാംഗ്ോ അ പപ്പ ഭ"
    },
    {
      "t": "00:20",
      "text": "എനെ ഹരസിിംഗേ"
    },
    {
      "t": "00:22",
      "text": "ഫനലി റെഡിക്ക പ"
    },
    {
      "t": "00:24",
      "text": "മസാമ"
    },
    {
      "t": "00:26",
      "text": "ആ കൊറയ്ക്കിന പട്ടിയോടടെ ഒന്നും ഇണ്ടാണ്ടിരിക്കില്ല"
    },
    {
      "t": "00:28",
      "text": "അട്ട"
    },
    {
      "t": "00:30",
      "text": "ആ"
    },
    {
      "t": "00:32",
      "text": "ക്ക്േ തത്തമ്മ"
    },
    {
      "t": "00:34",
      "text": "കത്തമ്മ കത്തമ്മ"
    },
    {
      "t": "00:36",
      "text": "ഇതല്ല സവാള"
    },
    {
      "t": "00:38",
      "text": "പറ സവാള"
    },
    {
      "t": "00:40",
      "text": "ഏ"
    },
    {
      "t": "00:42",
      "text": "പക്ഷി നോട്ടൊക്കെ ഇണ്ട അവിടെ"
    },
    {
      "t": "00:44",
      "text": "തങ്കത്തെ താമരാ"
    },
    {
      "t": "00:46",
      "text": "നഴ"
    },
    {
      "t": "00:48",
      "text": "ചെയ് പരമ്പ കൊണ്ടേ"
    },
    {
      "t": "00:50",
      "text": "ഉ ഇൻസ്റ്റഗ്രാം"
    },
    {
      "t": "00:52",
      "text": "ത"
    },
    {
      "t": "00:54",
      "text": "പഴപ്പിച്ചു പിള്ളേരെ"
    },
    {
      "t": "00:56",
      "text": "ഉം അ"
    },
    {
      "t": "00:58",
      "text": "ള ഞാൻ"
    },
    {
      "t": "01:00",
      "text": "ഞൻ തൃശ്ശൂര്"
    },
    {
      "t": "01:02",
      "text": "എന്താ ചെയ്യണേ"
    },
    {
      "t": "01:04",
      "text": "ഞാനിപ്പൊ ഗൾഫിലാണ്"
    },
    {
      "t": "01:06",
      "text": "എന്തൊക്കെയ"
    },
    {
      "t": "01:08",
      "text": ""
    },
    {
      "t": "01:10",
      "text": "ഇ കമ്മ മൂന്നക്കപ്പ"
    },
    {
      "t": "01:12",
      "text": "എങ്ങന തായി"
    },
    {
      "t": "01:14",
      "text": "തനസ"
    },
    {
      "t": "01:16",
      "text": "അ ചെയ"
    },
    {
      "t": "01:18",
      "text": "ണ വിളിച്ച"
    },
    {
      "t": "01:20",
      "text": ""
    },
    {
      "t": "01:22",
      "text": "അല്ല"
    },
    {
      "t": "01:24",
      "text": "ചേച്ചിക്ക് എന്താ കാലിപ്പ്"
    },
    {
      "t": "01:26",
      "text": "മി ജീത"
    },
    {
      "t": "01:28",
      "text": ""
    },
    {
      "t": "01:30",
      "text": "അയിേ"
    },
    {
      "t": "01:32",
      "text": "ഇള അവിടെന്ന പോയി"
    },
    {
      "t": "01:34",
      "text": "വീട്ടില ആാരൊക്കെയുണ്ട്"
    },
    {
      "t": "01:36",
      "text": "ആമ മാപ്പ"
    },
    {
      "t": "01:38",
      "text": "ആഏ"
    },
    {
      "t": "01:40",
      "text": "ഫാമിലി മാത്രം"
    },
    {
      "t": "01:42",
      "text": "കൈ വേണ്ട"
    },
    {
      "t": "01:44",
      "text": "വിട്ടട്ടണ്ട്"
    },
    {
      "t": "01:46",
      "text": "എന്നന്താ ചെയ"
    },
    {
      "t": "01:48",
      "text": "മറ്റെ"
    },
    {
      "t": "01:50",
      "text": "ഒ നട്ടില"
    },
    {
      "t": "01:52",
      "text": "പിള്ളർ എന്താ അടിക്കുന്ന"
    },
    {
      "t": "01:54",
      "text": "എൽ കെ ജി ഒരാള്"
    },
    {
      "t": "01:56",
      "text": "എോ ഞാൻത്ര"
    },
    {
      "t": "01:58",
      "text": "അത്രണ്ട് പറയും"
    },
    {
      "t": "02:00",
      "text": ""
    },
    {
      "t": "02:02",
      "text": "ഒരു നാല്പ്പത്തഞ്ച്"
    },
    {
      "t": "02:04",
      "text": "രാമ്മള്"
    },
    {
      "t": "02:06",
      "text": "ആ"
    },
    {
      "t": "02:08",
      "text": "നാപ്പത്"
    },
    {
      "t": "02:10",
      "text": "തേർട്ടി എഏറ്റ്"
    },
    {
      "t": "02:12",
      "text": "കേട്ട കുഴപ്പമില്ല ഒരു വർഷം കന്ന്"
    },
    {
      "t": "02:14",
      "text": ""
    },
    {
      "t": "02:16",
      "text": "ഏജ"
    },
    {
      "t": "02:18",
      "text": "നോട്ടമാറ്റോ"
    },
    {
      "t": "02:20",
      "text": "ആ"
    },
    {
      "t": "02:22",
      "text": "ആ"
    },
    {
      "t": "02:24",
      "text": "എങ്ങനെയണ്ട് ബാംഗ്ലൂരിലൈപ്പൊക്കെ"
    },
    {
      "t": "02:26",
      "text": ""
    },
    {
      "t": "02:28",
      "text": "ആ"
    },
    {
      "t": "02:30",
      "text": "വള്ളതല്ല"
    },
    {
      "t": "02:32",
      "text": "എന്ത"
    },
    {
      "t": "02:34",
      "text": ""
    },
    {
      "t": "02:36",
      "text": "ല്ല"
    },
    {
      "t": "02:38",
      "text": "അ"
    },
    {
      "t": "02:40",
      "text": "എന്തട്ട ബാംഗ്ലൂലായി ഭയങ്കരടിപൊളിയണ്ടോ സർ"
    },
    {
      "t": "02:42",
      "text": "സല്ല"
    },
    {
      "t": "02:44",
      "text": "ആ പററെ"
    },
    {
      "t": "02:46",
      "text": "ില്ല അടിപൊി എന്നന്റെ കൂടെ നിൽിക്കുന്നവരും പറയു"
    },
    {
      "t": "02:48",
      "text": "അ എന്താ കാരണം"
    },
    {
      "t": "02:50",
      "text": "കൊള്ളുവല്ല"
    },
    {
      "t": "02:52",
      "text": "നമ്മള അവിടന്നൊക്കെ വരുന്ന ബിണ്ടപ്പ മാത്രം"
    },
    {
      "t": "02:54",
      "text": "എടന്ന്ോന്നിടുട്ട"
    },
    {
      "t": "02:56",
      "text": "ഞാൻ ബാംഗ്ലൂർ ഇണ്ടായിരന്നോളെ എനിക്കറ"
    },
    {
      "t": "02:58",
      "text": "ചച്ച"
    },
    {
      "t": "03:00",
      "text": ""
    },
    {
      "t": "03:02",
      "text": "ഞാൻ ബാംഗ്ലൂര്ണ്ടായിരുന്നു"
    },
    {
      "t": "03:04",
      "text": "ള"
    },
    {
      "t": "03:06",
      "text": "എനക്ക് ഇഷ്ട"
    },
    {
      "t": "03:08",
      "text": "ഉം"
    },
    {
      "t": "03:10",
      "text": "ഇട്ടല എന്തതിനാ കയറിയക്കുന്ന"
    },
    {
      "t": "03:12",
      "text": "ഇല്ലന്നില്ല"
    },
    {
      "t": "03:14",
      "text": "അറിയത"
    },
    {
      "t": "03:16",
      "text": "അ്യോ"
    },
    {
      "t": "03:18",
      "text": "ഭാര്യയുടെ നമ്പർ തന്നണെ"
    },
    {
      "t": "03:20",
      "text": "െപ്പ"
    },
    {
      "t": "03:22",
      "text": "സംസാരിക്കുന്നു എന്തോ"
    },
    {
      "t": "03:24",
      "text": "എന്റെ കാര്യക്ക്റിയാലോ ഞാൻ അതിലുള്ളത്"
    },
    {
      "t": "03:26",
      "text": "ഭക്കറിയാവോ"
    },
    {
      "t": "03:28",
      "text": "അപ്പെന്ത"
    },
    {
      "t": "03:30",
      "text": "ഭാര്യയുടെ ഇതണ്ടെന്ന് ച്യാൻ അറിയാവോ"
    },
    {
      "t": "03:32",
      "text": "പ"
    },
    {
      "t": "03:34",
      "text": "പേ പററയാ"
    },
    {
      "t": "03:36",
      "text": "അയനെന്താ കൊഴപ്പന്ന സംസാരിക്ക"
    },
    {
      "t": "03:38",
      "text": "എന്താ പ്രശ്നം"
    },
    {
      "t": "03:40",
      "text": ""
    },
    {
      "t": "03:42",
      "text": "ഫ്രീഡ"
    },
    {
      "t": "03:44",
      "text": "പോഹല"
    },
    {
      "t": "03:46",
      "text": "ആളായിട്ടൊ ഒന്ന് സംസാരിച്ചു വച്ച എന്താ പ്രശ്നം"
    },
    {
      "t": "03:48",
      "text": "ഉ"
    },
    {
      "t": "03:50",
      "text": "കായിന"
    },
    {
      "t": "03:52",
      "text": "ഉ"
    },
    {
      "t": "03:54",
      "text": "സംഭവിക്കും"
    },
    {
      "t": "03:56",
      "text": "എന്തെങ്കും സംഭവിക്കോ"
    },
    {
      "t": "03:58",
      "text": "ഉ"
    },
    {
      "t": "04:00",
      "text": "നല്ല ദോഷം"
    },
    {
      "t": "04:02",
      "text": "അച്ച"
    },
    {
      "t": "04:04",
      "text": "ഫുട്ടേജ്"
