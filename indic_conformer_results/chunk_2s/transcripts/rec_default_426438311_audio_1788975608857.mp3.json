    {
      "t": "04:16",
      "text": "ആ"
    },
    {
      "t": "04:18",
      "text": "നട്ടിക്ക് വന്നില്ലോ ഓണത്തിന്"
    },
    {
      "t": "04:20",
      "text": "ഇല്ലല്ല ഞാനിപ്പ"
