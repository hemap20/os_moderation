  "segments": [
    {
      "t": "00:00",
      "text": "அஹ"
    },
    {
      "t": "00:02",
      "text": "ஐ"
    },
    {
      "t": "00:04",
      "text": ""
    },
    {
      "t": "00:06",
      "text": "என்ன ஒரு"
    },
    {
      "t": "00:08",
      "text": "சலம் த"
    },
    {
      "t": "00:10",
      "text": "ந நாமக்கல்"
    },
    {
      "t": "00:12",
      "text": "நாமக்கால் யோ"
    },
    {
      "t": "00:14",
      "text": "பத்ற்கத்த ச்டி"
    },
    {
      "t": "00:16",
      "text": ""
    },
    {
      "t": "00:18",
      "text": "சேலத்துலங்க"
    },
    {
      "t": "00:20",
      "text": "நயாவ கால் ரோடதா சீல்நாயக்க பி"
    },
    {
      "t": "00:22",
      "text": "ட்டவாயபஸ்"
    },
    {
      "t": "00:24",
      "text": ""
    },
    {
      "t": "00:26",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "00:28",
      "text": "உஹம்"
    },
    {
      "t": "00:30",
      "text": "டேட்டா மீட் பண்ணலாமா"
    },
    {
      "t": "00:32",
      "text": "ாய த சடடைம்ஸ்"
    },
    {
      "t": "00:34",
      "text": "சம்டைம்ஸ் இது மாதிரி"
    },
    {
      "t": "00:36",
      "text": "கயா தப"
    },
    {
      "t": "00:38",
      "text": "வசா"
    },
    {
      "t": "00:40",
      "text": "ஆஹ்"
    },
    {
      "t": "00:42",
      "text": "சொய"
    },
    {
      "t": "00:44",
      "text": "ே ஒ கால் பேபி நீங்க"
    },
    {
      "t": "00:46",
      "text": "வாக்கிங் ஆர் ஸ்டடிங் ஒ் டூயி்"
    },
    {
      "t": "00:48",
      "text": "ஒர்க்கிங் தமிழே பேசுங்க"
    },
    {
      "t": "00:50",
      "text": ""
    },
    {
      "t": "00:52",
      "text": ""
    },
    {
      "t": "00:54",
      "text": "ஓகே என்ன ஒர்க் பண்றீங்க"
    },
    {
      "t": "00:56",
      "text": ""
    },
    {
      "t": "00:58",
      "text": "ஹியூமன் ரிசோர்ஸ்"
    },
    {
      "t": "01:00",
      "text": "நீங்க"
    },
    {
      "t": "01:02",
      "text": "வாக்கிங நயட்டி"
    },
    {
      "t": "01:04",
      "text": "எட்டா எ"
    },
    {
      "t": "01:06",
      "text": "பட் நோ ம் ந் வர்கக்கிங்"
    },
    {
      "t": "01:08",
      "text": "சஸ்ிலே ஆப்"
    },
    {
      "t": "01:10",
      "text": "இப்ப நான்"
    },
    {
      "t": "01:12",
      "text": "பண்றீங்க சும்மாதான் இருக்கேன்"
    },
    {
      "t": "01:14",
      "text": ""
    },
    {
      "t": "01:16",
      "text": "ஜாம் சத்"
    },
    {
      "t": "01:18",
      "text": "ஜாப் சரிச்சிங்கா"
    },
    {
      "t": "01:20",
      "text": "எஸ்"
    },
    {
      "t": "01:22",
      "text": "வெயிங்பார்"
    },
    {
      "t": "01:24",
      "text": "ஆஹ"
    },
    {
      "t": "01:26",
      "text": "உம் ஒரு கல்்பவி இருக்கு"
    },
    {
      "t": "01:28",
      "text": "கே கேங்க என்ன"
    },
    {
      "t": "01:30",
      "text": "பண்றாங்க ஸ்கூல்"
    },
    {
      "t": "01:32",
      "text": "பாறங்க என்ன"
    },
    {
      "t": "01:34",
      "text": "தூங்குறாங்களா ஆமாப்ப"
    },
    {
      "t": "01:36",
      "text": "ந ிங"
    },
    {
      "t": "01:38",
      "text": "ல யாரா இருக்கா வீட்டுல யா இருக்கா"
    },
    {
      "t": "01:40",
      "text": "நீங்க பேபி"
    },
    {
      "t": "01:42",
      "text": "உம் ஏன்"
    },
    {
      "t": "01:44",
      "text": "நீங்க வரீங்களா"
    },
    {
      "t": "01:46",
      "text": "அதா கட்டுே"
    },
    {
      "t": "01:48",
      "text": "ஓகே வெிட்டிங்"
    },
    {
      "t": "01:50",
      "text": "ஜவள ம"
    },
    {
      "t": "01:52",
      "text": "ட்ட"
    },
    {
      "t": "01:54",
      "text": "தெரியலங்க எனக்கு அப்படியெல்லாம்"
    },
    {
      "t": "01:56",
      "text": "சும்மா சொல்லுங்க"
    },
    {
      "t": "01:58",
      "text": "எவ்வளவு குடிப்ப"
    },
    {
      "t": "02:00",
      "text": "ப்படிங்க"
    },
    {
      "t": "02:02",
      "text": "அஐயா இப்ப போ"
    },
    {
      "t": "02:04",
      "text": "புரியில"
    },
    {
      "t": "02:06",
      "text": "இதுஃல் நட ந லோ"
    },
    {
      "t": "02:08",
      "text": "எனக்கு சத்தியம்"
    },
    {
      "t": "02:10",
      "text": "தெரியல நான் அப்படிலாம் பண்ணன்"
    },
    {
      "t": "02:12",
      "text": "சொ"
    },
    {
      "t": "02:14",
      "text": "சொல்லுங்க அடவும்"
    },
    {
      "t": "02:16",
      "text": "உமைதாங்க"
    },
    {
      "t": "02:18",
      "text": "எந்த பண்ண"
    },
    {
      "t": "02:20",
      "text": "ட்ரிங்க்ஸ் பண்ணீங்களா"
    },
    {
      "t": "02:22",
      "text": "சிப்பவே சார்"
    },
    {
      "t": "02:24",
      "text": "கிடைச்சிட்டுதான் இருக்கேன் சொல்லுங்க"
    },
    {
      "t": "02:26",
      "text": ""
    },
    {
      "t": "02:28",
      "text": "அப்புற என்ன இது தம்மு"
    },
    {
      "t": "02:30",
      "text": "தம் ிராய பண்ண"
    },
    {
      "t": "02:32",
      "text": "மே பி கொடுங்க வேனா ட்ரை"
    },
    {
      "t": "02:34",
      "text": "பண்ற இங்க வாங்க"
    },
    {
      "t": "02:36",
      "text": "ஓக்குே"
    },
    {
      "t": "02:38",
      "text": "தெரியலையே"
    },
    {
      "t": "02:40",
      "text": "ஓகே"
    },
    {
      "t": "02:42",
      "text": ""
    },
    {
      "t": "02:44",
      "text": "ஓகே"
    },
    {
      "t": "02:46",
      "text": "ஓகே"
    },
    {
      "t": "02:48",
      "text": "ம்மு ட்ரை பண்ணுது"
    },
    {
      "t": "02:50",
      "text": "நட் க் தட்ஸ் ம"
    },
    {
      "t": "02:52",
      "text": "க்ம"
    },
    {
      "t": "02:54",
      "text": "நீ"
    },
    {
      "t": "02:56",
      "text": "அ அ"
    },
    {
      "t": "02:58",
      "text": "வ"
    },
    {
      "t": "03:00",
      "text": "நீ வெறும் வயந்தானா"
    },
    {
      "t": "03:02",
      "text": "ஆஹ் அதுக்கே பாடி தாங்கு"
    },
    {
      "t": "03:04",
      "text": "பால்ஸ் ஆஃப் பைன் குடித்து"
    },
    {
      "t": "03:06",
      "text": "ஸுல்லா வேறன்னு வருது"
    },
    {
      "t": "03:08",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "03:10",
      "text": "செ் டை"
    },
    {
      "t": "03:12",
      "text": "ஆ எத்தனை பாய் ஃப்ரெண்ட் இருக்காங்க"
    },
    {
      "t": "03:14",
      "text": "ந"
    },
    {
      "t": "03:16",
      "text": "டோண்ட் ஹவ் ம ண்டஸ்"
    },
    {
      "t": "03:18",
      "text": "தமிழே பேசுங்கான எங்க"
    },
    {
      "t": "03:20",
      "text": "ந ரிமோட்ல தாங்க வா"
    },
    {
      "t": "03:22",
      "text": "பண்றேன் எனக்கு பாய்ரெண்ட்ஸ் எல்லாம் கிடையாது"
    },
    {
      "t": "03:24",
      "text": "அவ்வாக்கு வந்து சவுதியான்"
    },
    {
      "t": "03:26",
      "text": "சிங்கப்பூர் அந்த மாதிரிதான்"
    },
    {
      "t": "03:28",
      "text": "எனக்கு லோக்கல்ல யாரையுமே தெரிய"
    },
    {
      "t": "03:30",
      "text": "ஓகே ஓகே சால"
    },
    {
      "t": "03:32",
      "text": "இது பண்ணலாமா மீட் பண்ணலாமா"
    },
    {
      "t": "03:34",
      "text": "சேல வேண்டா மீட் பண்ணா என்ன"
    },
    {
      "t": "03:36",
      "text": "ங்க என்ன வேணும்"
    },
    {
      "t": "03:38",
      "text": "நீங்க தான் வேணும்"
    },
    {
      "t": "03:40",
      "text": "அப்ப"
    },
    {
      "t": "03:42",
      "text": ""
    },
    {
      "t": "03:44",
      "text": "ஆஹ"
    },
    {
      "t": "03:46",
      "text": "தாராளம்மா"
    },
    {
      "t": "03:48",
      "text": "என்னும் பண்ணுவீங்க சொல்லுங்க"
    },
    {
      "t": "03:50",
      "text": "ஏ என்ன பண்ணணும்"
    },
    {
      "t": "03:52",
      "text": "இது வாட்ஸ்அப் நம்பர் கொடுீங்களா"
    },
    {
      "t": "03:54",
      "text": "புரிய வாட்ப் நடு"
    },
    {
      "t": "03:56",
      "text": "ா்ஸ்ப்"
    },
    {
      "t": "03:58",
      "text": "உம் ஆச்சி ரமா ச"
    },
    {
      "t": "04:00",
      "text": "ப்பற எல்லாருமே என் மாதிரி சேக்காயம்"
    },
    {
      "t": "04:02",
      "text": "மாத்துறாங்க இ ரெடி"
    },
    {
      "t": "04:04",
      "text": "சரி தமிழ் பேசனால"
    },
    {
      "t": "04:06",
      "text": "ஆ நீங்க பே பண்ணும்"
    },
    {
      "t": "04:08",
      "text": "ஓகேன நான் வாட்ஸ்அப் நம்பர்"
    },
    {
      "t": "04:10",
      "text": "கொடுக்க ரெி ஓகே"
    },
    {
      "t": "04:12",
      "text": "எவ்ளோ பண்ணி"
    },
    {
      "t": "04:14",
      "text": "ங்க எனக்கு அப்புடல்லாம் கேட்க தெரியாது"
    },
    {
      "t": "04:16",
      "text": ""
    },
    {
      "t": "04:18",
      "text": "ஹம் ஹம் ஹம்"
    },
    {
      "t": "04:20",
      "text": "எனக்கு ஏமாந்துச்ச"
    },
    {
      "t": "04:22",
      "text": "ங்கிற கிரட் இல்லாம இருந்தான் எனக்குக்கும்"
    },
    {
      "t": "04:24",
      "text": "ஓகே"
    },
    {
      "t": "04:26",
      "text": "நான் நம்பிக்கலாம கடைசிாக"
    },
    {
      "t": "04:28",
      "text": "இருப்பேன் ஏ எனக்கு என்ன வந்து"
    },
    {
      "t": "04:30",
      "text": "மே"
    },
    {
      "t": "04:32",
      "text": ""
    },
    {
      "t": "04:34",
      "text": "கே"
    },
    {
      "t": "04:36",
      "text": "எனக்கு இந்த மாரி ஒரு ரிலேஷன்ஷிப் தேவைப்படுாது"
    },
    {
      "t": "04:38",
      "text": "ேட்ட ஓகே"
    },
    {
      "t": "04:40",
      "text": "என் ண்ட"
    },
    {
      "t": "04:42",
      "text": "யாரையும் ட்ரெஸ்ட் பண்ண மாட்டேன் எல்லாம்"
    },
    {
      "t": "04:44",
      "text": "பேக்ப்ப எல்லையுமே ஏமாத்துறாங்க"
    },
    {
      "t": "04:46",
      "text": "இந்த ஆப்ல முத கொண்டு"
    },
    {
      "t": "04:48",
      "text": "எல்லாருமே யாரு நம்மனால ஏமாத்த"
    },
    {
      "t": "04:50",
      "text": "இருக்கும்பத"
    },
    {
      "t": "04:52",
      "text": "க்குன்னு கால் கட் பண்ணிட்டு ஓடிடுறாங்க"
    },
    {
      "t": "04:54",
      "text": "ட்ரெஸ் ரிமூவ் பண்ண சொல்லுவாங்க"
    },
    {
      "t": "04:56",
      "text": "பன ஓடி"
    },
    {
      "t": "04:58",
      "text": "வாங்க சரி நம்ப"
    },
    {
      "t": "05:00",
      "text": "உங்களுக்கு நம்பிக்கை தான் நம்பர் கொடுங்க"
    },
    {
      "t": "05:02",
      "text": "ஆப் பண்றேன் சேல வந்த"
    },
    {
      "t": "05:04",
      "text": "சலம் வண்டா மீ"
    },
    {
      "t": "05:06",
      "text": "மீட் பண்ணா என்ன பண்ணுவீங்க சொல்லுங்க"
    },
    {
      "t": "05:08",
      "text": "ச ச"
    },
    {
      "t": "05:10",
      "text": "அஹ"
    },
    {
      "t": "05:12",
      "text": "மேட்ரு தான் ஜாலியாக இருக்கலாம்"
    },
    {
      "t": "05:14",
      "text": "ஓகே"
    },
    {
      "t": "05:16",
      "text": "நாட்டு நாட்டு ப"
    },
    {
      "t": "05:18",
      "text": "வட்டு ஏமாத்திட்டு போக மாட்டீங்கல்ல"
    },
    {
      "t": "05:20",
      "text": "ஆமாதுெல்லாம் போகமாட்டேன்"
    },
    {
      "t": "05:22",
      "text": "ஆனா எல்லாருமே ஏமா"
    },
    {
      "t": "05:24",
      "text": "ாங்களே இதுப்ப ம பாடி"
    },
    {
      "t": "05:26",
      "text": "ிீ"
    },
    {
      "t": "05:28",
      "text": "ம்"
    },
    {
      "t": "05:30",
      "text": "சோகேவ இது நம்"
    },
    {
      "t": "05:32",
      "text": "கொடுங்க வாட்ஸ்அப் நம்பர் கொடுங்க"
    },
    {
      "t": "05:34",
