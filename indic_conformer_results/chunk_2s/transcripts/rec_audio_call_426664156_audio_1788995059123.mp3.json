    {
      "t": "05:48",
      "text": "ఎయిట్ర్స్ క"
    },
    {
      "t": "05:50",
      "text": "అంటే మీకు మ్యారీడా"
    },
    {
      "t": "05:52",
      "text": "మారేజ పట్ట"
