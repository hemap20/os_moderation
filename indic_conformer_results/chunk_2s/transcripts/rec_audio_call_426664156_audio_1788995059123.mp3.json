      "t": "08:34",
      "text": "అ"
    },
    {
      "t": "08:36",
      "text": "లో హలో"
    },
    {
      "t": "08:38",
      "text": "అలాంటి వాడికి ఒక అవకాశం ఇవ్వచ్చు కదా"
    },
    {
      "t": "08:40",
      "text": ""
    },
    {
      "t": "08:42",
      "text": "ఎ టైపు కాయాదుగా"
    },
    {
      "t": "08:44",
      "text": "ఏదు"
    },
    {
      "t": "08:46",
      "text": "ఆడుకుంటున్నాం ఒక సారి"
