    {
      "t": "08:54",
      "text": "మీద"
    },
    {
      "t": "08:56",
      "text": "థర్టీ టూ"
    },
    {
      "t": "08:58",
      "text": "ఓకే ఓకే అతేే మీరు కూడా తర్"
    },
    {
      "t": "09:00",
      "text": "సు"
    },
    {
      "t": "09:02",
      "text": "అవు న"
    },
    {
      "t": "09:04",
      "text": "ఓకే"
    },
    {
      "t": "09:06",
      "text": "నెంబర్ ఇస్తారు నోట్ చేసుకుొని నీ ఎప్పుడు"
    },
    {
      "t": "09:08",
      "text": "ఒకసారి అట్లా మెసేజ్ చేయండి"
    },
    {
      "t": "09:10",
      "text": "ఇంతకు మీ పేరు"
    },
    {
      "t": "09:12",
      "text": "కానీ వదులేమ"
    },
    {
      "t": "09:14",
      "text": ""
    }
