    {
      "t": "04:00",
      "text": "ನೀವು"
    },
    {
      "t": "04:02",
      "text": "ಹ ನಿಮ್ಗೆ ಸಿಕ್ಕಿದಾರಾ"
    },
    {
      "t": "04:04",
      "text": "ಹ್ಮ ಸಕ್ಕಾರ"
    },
    {
      "t": "04:06",
      "text": ""
    },
    {
      "t": "04:08",
      "text": "ಹ್ಮ ಅದೇ"
    },
    {
      "t": "04:10",
      "text": "ಹೋಗಿ ಎಲ್ಲ ಕೂಡ ಆಗಿದೆ"
    },
    {
      "t": "04:12",
      "text": "ಎಂತ ಹಾಗಾದ್ರೆ ಅಲ್ವಾ"
    },
    {
      "t": "04:14",
      "text": "ತುಂಬ ದರದು"
    },
    {
      "t": "04:16",
      "text": "ಹೋಗ್ತೀರಾ"
    },
    {
      "t": "04:18",
      "text": "ಬೆಂ್ಗಳೂರು"
    },
    {
      "t": "04:20",
      "text": "ಹ್ಮ್ ಹ್ಮ"
    },
    {
      "t": "04:22",
      "text": "ೋಟ"
    },
    {
      "t": "04:24",
      "text": "ಇಲ್ಲ ರೀ ಒಂದ್ ತಿಂಗ್ ಆಯ್ತಂತ ಹೇಳಿ"
    },
    {
      "t": "04:26",
      "text": "ಹೇಳದಲ್ವ ನಂಗೆ ಸಿಕ್ಕೋವರಲ್ಲಿ ಮೂರು ಜನ"
    },
    {
      "t": "04:28",
      "text": "ಹ ಇಬ್ರು ಮೈಸೂರಿನವರು"
    },
    {
      "t": "04:30",
      "text": "ಬ್ಯಾಂಗ್ಳೂರ್ನವರು ಸೊ ಅವ್ರರಿಗೆ ಇಲ್ಲಿ ಬರ್ಲಿಕ್ಕ"
    },
    {
      "t": "04:32",
      "text": "ನನಗೆ ಅಲ್ಲಿ ಹೋಗ್ಲಿಕ್ಕೆ ಆಲ್ಲ"
    },
    {
      "t": "04:34",
      "text": "ಮಾತಾಡುದು ಮಾತ್ರ ನಾವು"
    },
    {
      "t": "04:36",
      "text": "ಸಿತೀರ"
    },
    {
      "t": "04:38",
      "text": "ಅವ್ರ ಇಲ್ಲಿ ಬರ್ಬೇಕಲ್ಲ ರೀ"
    },
    {
      "t": "04:40",
      "text": "ಬರೋದಿಲ್ಲಲ್ಲ ಅವರು"
    },
    {
      "t": "04:42",
      "text": "ಬಂದ್ರ ಸಿತರ"
    },
    {
      "t": "04:44",
      "text": "ಬಂದ್ರೆ ಸಿಗ್ಬೋದು"
    },
    {
      "t": "04:46",
      "text": "ಬಟ್ ಅವರು ಬರಕ್ ಬ"
    },
    {
      "t": "04:48",
      "text": "ಬರಲ್ಲ ಅಂತ ಹೇಳಿದ್ರು ಹಾಗೆ"
    },
    {
      "t": "04:50",
      "text": "ಆ ಮಾತಾಡ್ತೀವಿ"
    },
    {
      "t": "04:52",
      "text": "ಆಹ ಸ್ನಪಲಿ"
    },
    {
      "t": "04:54",
      "text": "ನಂಬರ್ ಕೊಟ್ಟಿದ್ದೀನಿ ಐ ಡಿ"
    },
    {
      "t": "04:56",
      "text": "ಕೊಟ್ಟಿದೆ ಹಾಗೆ ಅದ್ರಲ್ಲಿ ಮೆಸೇಜು ಕಾಲ್ ಮಾಡ"
    },
    {
      "t": "04:58",
      "text": "ಕೂಡ ಮಾತಾಡ್ತಾ ಇರ್ತವಿ ಹಾಗೆ"
    },
    {
      "t": "05:00",
      "text": "ಏನಾದ"
    },
    {
      "t": "05:02",
      "text": "ಬೇಕು ಅಂತ ಹೇಳಿದ್ರೆ ಅದ್ರಲ್ಲ ಇದ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "05:04",
      "text": "ನನಗ ನ ಬೇಕು ಅಂತ ಅನ್ಸಿದ"
    },
    {
      "t": "05:06",
      "text": "ಆದ್ರೆ ಸ್ಕನ್ ಕಳಸಿದ ಅವ"
    },
    {
      "t": "05:08",
      "text": "ಆತಾರೆ ಹಾಗೆ ಆತರ ಮಾತಾಡ್ತೇವೆ"
    },
    {
      "t": "05:10",
      "text": "ಹ"
