    {
      "t": "01:08",
      "text": ""
    },
    {
      "t": "01:10",
      "text": "ಫೋನ್ಲ್ಲ ಮತ್ತೆ"
    },
    {
      "t": "01:12",
      "text": "ಹಾ ಇಲ್ಲ ಅವಳೂ"
    },
    {
      "t": "01:14",
      "text": "ಅವಳು ಕೂಡ ಆ್ಯಪ ಅಲ್ಲಿ ಯೂಸ್ ಮಾಡ್ತಾಳೆ"
    },
    {
      "t": "01:16",
      "text": "ಹಾ ಹಾ"
    },
    {
      "t": "01:18",
      "text": ""
    },
    {
      "t": "01:20",
      "text": "ಅವ್ಳು ಬೇರೆ ಯಾಪ್ ಯೂಸ್ ಮಾಡ್ತಾರೆ ನಾನ್ ಬ"
    },
    {
      "t": "01:22",
