  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:02",
      "text": "ഹലോ ഹലോ"
    },
    {
      "t": "00:04",
      "text": "ആഹ കേക്കുന്നുണ്ടോ"
    },
    {
      "t": "00:06",
      "text": "കേക്കുന്നല്ലോ രാാ"
    },
    {
      "t": "00:08",
      "text": "എന്റെ പേര് അജുമനാണ്"
    },
    {
      "t": "00:10",
      "text": "മലപ്പുറത്തന്നാണ് നമ്മള്"
    },
    {
      "t": "00:12",
      "text": "ആഹ എന്നോടെ പേര്"
    },
    {
      "t": "00:14",
      "text": "അശ്വതി എന്റെ സ്ഥലം കൊല്ലത്താണ്"
    },
    {
      "t": "00:16",
      "text": "ആ ഞാൻ കൊല്ലത്തുന്നാണ് സംസാരിക്കുന്നത്"
    },
    {
      "t": "00:18",
      "text": "ആ എത്ര വയസുണ്ട്"
    },
    {
      "t": "00:20",
      "text": "എക്കെ മുപ്പത്താറ്"
    },
    {
      "t": "00:22",
      "text": "ആഹ"
    },
    {
      "t": "00:24",
      "text": "മരിഡ ആാണ് അപ്പൊ"
    },
    {
      "t": "00:26",
      "text": "ആഹ ഇപ്പന്നരടാ"
    },
    {
      "t": "00:28",
      "text": "ഹസ്ബൻഡ എന്തന്നെ"
    },
    {
      "t": "00:30",
      "text": "ഹസ്ബഡ ഡ്രൈവർ ആ"
    },
    {
      "t": "00:32",
      "text": "ഉ"
    },
    {
      "t": "00:34",
      "text": "ആപ്പടുത്തിട്ട് പറയോ"
    },
    {
      "t": "00:36",
      "text": "ഇല്ല"
    },
    {
      "t": "00:38",
      "text": "ഇന്ന് ഇന്നലെ എടുത്തിട്ടിട്ടുണ്ടായിരുന്നു"
    },
    {
      "t": "00:40",
      "text": "ഇന്ന് അവർ വിളിച്ചെല്ലാം ഒഓക്കെ ആക്കിയിട്ട്"
    },
    {
      "t": "00:42",
      "text": "നമുക്ക് എന്താണന്ന് എനിക്ക അറിയില്ല"
    },
    {
      "t": "00:44",
      "text": "സംഭവം എന്താ ഇതിനകത്ത് സംസാരിക്ക"
    },
    {
      "t": "00:46",
      "text": "വെന്ത കട്ട"
    },
    {
      "t": "00:48",
      "text": "പേ്മെന്റ് കിട്ടും നിക്ക്"
    },
    {
      "t": "00:50",
      "text": "മിനട്ടന"
    },
    {
      "t": "00:52",
      "text": "എങ്ങനെ നമുക്ക് പേ്മെന്റ് നമ്മൾ അക്കൗണ്ടിൽ വരുോ"
    },
    {
      "t": "00:54",
      "text": "ഇതിിന എത്ത കോ"
    },
    {
      "t": "00:56",
      "text": "പോയാനായിട്ടായിരിക്കും നിറിയില്ല"
    },
    {
      "t": "00:58",
      "text": "ട്ട ഓ"
    },
    {
      "t": "01:00",
      "text": "അങ്ങനെയ"
    },
    {
      "t": "01:02",
      "text": "പിന്നെ"
    },
    {
      "t": "01:04",
      "text": "ചറിയോ അപ്പത്തെറിയോ"
    },
    {
      "t": "01:06",
      "text": "ഉം"
    },
    {
      "t": "01:08",
      "text": "വീട്ടൊത്ത വേറെ വർക്കല്ല പറ"
    },
    {
      "t": "01:10",
      "text": "ഇപ്പോടുത്തെ കാര്യം"
    },
    {
      "t": "01:12",
      "text": "ഇല്ലില്ല ഇത് ഓണ ആാക്കിയാലല്ലേ"
    },
    {
      "t": "01:14",
      "text": "മറ്റ ഓഡിയോ കോ"
    },
    {
      "t": "01:16",
      "text": "ല്ലേ കോള വരുത്തുള്ള"
    },
    {
      "t": "01:18",
      "text": "ഉ പിന്നെ അന്റെ"
    },
    {
      "t": "01:20",
      "text": "ഹസ്ബൻഡ് വീടില്ല ഹസ്ബൻഡ് ഞാനിട്ട് ശകം"
    },
    {
      "t": "01:22",
      "text": "മി ഇപ്പൊ രണ്ടിവസ"
    },
    {
      "t": "01:24",
      "text": "സണ മണ്ട ഷകത കത"
    },
    {
      "t": "01:26",
      "text": "പുള്ളിങ്ങോട്ട് വത്തില്ല"
    },
    {
      "t": "01:28",
      "text": "ഓക്കെ ഇതിനകത്ത്"
    },
    {
      "t": "01:30",
      "text": "ഓപ്പൺ ോക്ക് കറണ സംഭവംുണ്ട്"
    },
    {
      "t": "01:32",
      "text": "ആ"
    },
    {
      "t": "01:34",
      "text": "അദ്ദേത്തികുള്ള ഒരു ആൾക്കാരൊക്കെ പ്പുണ്ട്"
    },
    {
      "t": "01:36",
      "text": "ക്ക ചോിച്ചിട്ട വരി"
    },
    {
      "t": "01:38",
      "text": "ഒന്ന്ച്ച"
    },
    {
      "t": "01:40",
      "text": "എ വെച്ചാൽ നമ്മള് ഓപ്പൺ ആയിട്ട്"
    },
    {
      "t": "01:42",
      "text": "സംസാരിക്കാൻ പറ്റ"
    },
    {
      "t": "01:44",
      "text": "അ് മോശമായിട്ട് പറഞ്ഞ"
    },
    {
      "t": "01:46",
      "text": "അല് ഇതിനകത്ത് നമ്മളെ വിളിച്ചച്ച് അവരുടെ"
    },
    {
      "t": "01:48",
      "text": "അവരോട് പറഞ്ഞാ മതി എന്നാ പറഞ്ഞേ"
    },
    {
      "t": "01:50",
      "text": "അങ്ങനല്ല"
    },
    {
      "t": "01:52",
      "text": "ആഹ അതെനിിക്ക അറിയില്ല"
    },
    {
      "t": "01:54",
      "text": "ആ അങ്ങനെ"
    },
    {
      "t": "01:56",
      "text": "മോസ്റ്റ ആൾക്കാരും അങ്ങനെ വരി"
    },
    {
      "t": "01:58",
      "text": "അപ്പണ്ടൊക്കെ ചോദിച്ചിട്ട വര"
    },
    {
      "t": "02:00",
      "text": "ഓ"
    },
    {
      "t": "02:02",
      "text": "അപ്പൊ ഇയാൾക്ക് താല്പര്യമല്ലാന്ന്ണ്ടാണ്"
    },
    {
      "t": "02:04",
      "text": ""
    },
    {
      "t": "02:06",
      "text": "ആ ഞാൻ കട്ട ആാക്കിോവിട നേരത്തെ"
    },
    {
      "t": "02:08",
      "text": "ഒരു ചെറക്കനാണോ നിക്കാറല്ല"
    },
    {
      "t": "02:10",
      "text": "ചോ്"
    },
    {
      "t": "02:12",
      "text": "അല്ല നീളം വണ്ുണ്ടോ"
    },
    {
      "t": "02:14",
      "text": "അങ്ങനെ കാ"
    },
    {
      "t": "02:16",
      "text": "കാണിച്ച തരു എന്നക്കെ ചോദിച്ചു അപ്പൾ ഞാൻ്ലോ്ത്"
    },
    {
      "t": "02:18",
      "text": "കട്ടാക്കി ബ്ലോക്ക"
    },
    {
      "t": "02:20",
      "text": "അണ്ടക്ക വിട്ട്"
    },
    {
      "t": "02:22",
      "text": "അത പറഞ്ഞതിനകത്ത് അങ്ങനത്തെ കുറച്ച് പ്രശ്നങ്ങ"
    },
    {
      "t": "02:24",
      "text": "ണ്ട് ശ്രദ്ധച്ച് യസ ചെയ്യാട്ടാ"
    },
    {
      "t": "02:26",
      "text": "ഉം"
    },
    {
      "t": "02:28",
      "text": "ഫുട്ടിച്ചോ"
    }
  ],
  "full_text": "ഹലോ ഹലോ ഹലോ ആഹ കേക്കുന്നുണ്ടോ കേക്കുന്നല്ലോ രാാ എന്റെ പേര് അജുമനാണ് മലപ്പുറത്തന്നാണ് നമ്മള് ആഹ എന്നോടെ പേര് അശ്വതി എന്റെ സ്ഥലം കൊല്ലത്താണ് ആ ഞാൻ കൊല്ലത്തുന്നാണ് സംസാരിക്കുന്നത് ആ എത്ര വയസുണ്ട് എക്കെ മുപ്പത്താറ് ആഹ മരിഡ ആാണ് അപ്പൊ ആഹ ഇപ്പന്നരടാ ഹസ്ബൻഡ എന്തന്നെ ഹസ്ബഡ ഡ്രൈവർ ആ ഉ ആപ്പടുത്തിട്ട് പറയോ ഇല്ല ഇന്ന് ഇന്നലെ എടുത്തിട്ടിട്ടുണ്ടായിരുന്നു ഇന്ന് അവർ വിളിച്ചെല്ലാം ഒഓക്കെ ആക്കിയിട്ട് നമുക്ക് എന്താണന്ന് എനിക്ക അറിയില്ല സംഭവം എന്താ ഇതിനകത്ത് സംസാരിക്ക വെന്ത കട്ട പേ്മെന്റ് കിട്ടും നിക്ക് മിനട്ടന എങ്ങനെ നമുക്ക് പേ്മെന്റ് നമ്മൾ അക്കൗണ്ടിൽ വരുോ ഇതിിന എത്ത കോ പോയാനായിട്ടായിരിക്കും നിറിയില്ല ട്ട ഓ അങ്ങനെയ പിന്നെ ചറിയോ അപ്പത്തെറിയോ ഉം വീട്ടൊത്ത വേറെ വർക്കല്ല പറ ഇപ്പോടുത്തെ കാര്യം ഇല്ലില്ല ഇത് ഓണ ആാക്കിയാലല്ലേ മറ്റ ഓഡിയോ കോ ല്ലേ കോള വരുത്തുള്ള ഉ പിന്നെ അന്റെ ഹസ്ബൻഡ് വീടില്ല ഹസ്ബൻഡ് ഞാനിട്ട് ശകം മി ഇപ്പൊ രണ്ടിവസ സണ മണ്ട ഷകത കത പുള്ളിങ്ങോട്ട് വത്തില്ല ഓക്കെ ഇതിനകത്ത് ഓപ്പൺ ോക്ക് കറണ സംഭവംുണ്ട് ആ അദ്ദേത്തികുള്ള ഒരു ആൾക്കാരൊക്കെ പ്പുണ്ട് ക്ക ചോിച്ചിട്ട വരി ഒന്ന്ച്ച എ വെച്ചാൽ നമ്മള് ഓപ്പൺ ആയിട്ട് സംസാരിക്കാൻ പറ്റ അ് മോശമായിട്ട് പറഞ്ഞ അല് ഇതിനകത്ത് നമ്മളെ വിളിച്ചച്ച് അവരുടെ അവരോട് പറഞ്ഞാ മതി എന്നാ പറഞ്ഞേ അങ്ങനല്ല ആഹ അതെനിിക്ക അറിയില്ല ആ അങ്ങനെ മോസ്റ്റ ആൾക്കാരും അങ്ങനെ വരി അപ്പണ്ടൊക്കെ ചോദിച്ചിട്ട വര ഓ അപ്പൊ ഇയാൾക്ക് താല്പര്യമല്ലാന്ന്ണ്ടാണ്  ആ ഞാൻ കട്ട ആാക്കിോവിട നേരത്തെ ഒരു ചെറക്കനാണോ നിക്കാറല്ല ചോ് അല്ല നീളം വണ്ുണ്ടോ അങ്ങനെ കാ കാണിച്ച തരു എന്നക്കെ ചോദിച്ചു അപ്പൾ ഞാൻ്ലോ്ത് കട്ടാക്കി ബ്ലോക്ക അണ്ടക്ക വിട്ട് അത പറഞ്ഞതിനകത്ത് അങ്ങനത്തെ കുറച്ച് പ്രശ്നങ്ങ ണ്ട് ശ്രദ്ധച്ച് യസ ചെയ്യാട്ടാ ഉം ഫുട്ടിച്ചോ",
