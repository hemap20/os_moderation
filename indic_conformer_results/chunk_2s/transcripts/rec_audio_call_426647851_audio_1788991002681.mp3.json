  "audio_duration_sec": 896.661,
  "processing_time_sec": 32.407857179641724,
  "segments": [
    {
      "t": "00:00",
      "text": "హలో"
    },
    {
      "t": "00:02",
      "text": "హయి"
    },
    {
      "t": "00:04",
      "text": "అతే"
    },
    {
      "t": "00:06",
      "text": "హైదరాబాద్ ని"
    },
    {
      "t": "00:08",
      "text": "హ"
    },
    {
      "t": "00:10",
      "text": "చెవాడా"
    },
    {
      "t": "00:12",
      "text": "విజయవాడ అమ్మాయి ఇంకా పడుకోకుండా"
    },
    {
      "t": "00:14",
      "text": "నే ఉందా"
    },
    {
      "t": "00:16",
      "text": "అ"
    },
    {
      "t": "00:18",
      "text": "ఏం చేస్తుంది ఏమని"
    },
    {
      "t": "00:20",
      "text": "ఇందాక లేట్"
    },
    {
      "t": "00:22",
      "text": ""
    },
    {
      "t": "00:24",
      "text": "హ"
    },
    {
      "t": "00:26",
      "text": "త ప స"
    },
    {
      "t": "00:28",
      "text": ""
    },
    {
      "t": "00:30",
      "text": "పర్పస్ ప్రస్తుానికి"
    },
    {
      "t": "00:32",
      "text": "మాట్లాడుతున్నా"
    },
    {
      "t": "00:34",
      "text": "మీది"
    },
    {
      "t": "00:36",
      "text": "ఏన్న"
    },
    {
      "t": "00:38",
      "text": "అదపోపచ్చ"
    },
    {
      "t": "00:40",
      "text": "మనీయాయా"
    },
    {
      "t": "00:42",
      "text": ""
    },
    {
      "t": "00:44",
      "text": "వీడియో కల్ స"
    },
    {
      "t": "00:46",
      "text": "అనే"
    },
    {
      "t": "00:48",
      "text": "ఇష్టం ఉంటే ఎన్ని ఇష్టాలు చేస్తా"
    },
    {
      "t": "00:50",
      "text": "అదే"
    },
    {
      "t": "00:52",
      "text": "మన"
    },
    {
      "t": "00:54",
      "text": "ఉంటే చేస్తాను ఇష్టాలు"
    },
    {
      "t": "00:56",
      "text": "ఏదంత చేయనా"
    },
    {
      "t": "00:58",
      "text": "ఓకే ఓకే"
    },
    {
      "t": "01:00",
      "text": "మంత"
    },
    {
      "t": "01:02",
      "text": "ఫైవ్ హండ్రెడ్"
    },
    {
      "t": "01:04",
      "text": "ట"
    },
    {
      "t": "01:06",
      "text": "వాళ్ళ ఇష్టము"
    },
    {
      "t": "01:08",
      "text": "కది"
    },
    {
      "t": "01:10",
      "text": "ఫై్ండ్రె ఎక్కువ కా ఇక్కడ చేసిన అంతేవుద్ కా"
    },
    {
      "t": "01:12",
      "text": ""
    },
    {
      "t": "01:14",
      "text": "ఇక్కడేసి సిక్స్ హండ్రెడ్ సిక్స్"
    },
    {
      "t": "01:16",
      "text": "అే టై"
    },
    {
      "t": "01:18",
      "text": "ట్ ఉంటంది కదా ఇప్పుడు ఏ టైం"
    },
    {
      "t": "01:20",
      "text": "వాళ్ళ ఇష్ట వాళ్ళ ఎంతసే మాట్లాడతారు ఒక"
    },
    {
      "t": "01:22",
      "text": "మ మాట్లాడలా మా"
    },
    {
      "t": "01:24",
      "text": "అవును"
    },
    {
      "t": "01:26",
      "text": "అంతే ఇ"
    },
    {
      "t": "01:28",
      "text": "వాళ్ళు టైం అడిగి అమౌంట్ కూడా వాళ్ళు చెప్ారు"
    },
    {
      "t": "01:30",
      "text": "అే నుంచి ఓకే అంటడి ఓకేండి"
    },
    {
      "t": "01:32",
      "text": ""
    },
    {
      "t": "01:34",
      "text": "ఓకే"
    },
    {
      "t": "01:36",
      "text": "ఏ చూపిస్తాన్ని చూపిస్తా"
    },
    {
      "t": "01:38",
      "text": "ఆ"
    },
    {
      "t": "01:40",
      "text": "అంటే వీడకల్ం ఫేస్యితే చూ"
    },
    {
      "t": "01:42",
      "text": "ఓ"
    },
    {
      "t": "01:44",
      "text": "అ"
    },
    {
      "t": "01:46",
      "text": "మారిడయా ను"
    },
    {
      "t": "01:48",
      "text": "నస"
    },
    {
      "t": "01:50",
      "text": "ఓకే"
    },
    {
      "t": "01:52",
      "text": "ఎందుకని"
    },
    {
      "t": "01:54",
      "text": "స్ేశంది యూపిిఓ"
    },
    {
      "t": "01:56",
      "text": "ఎందు చూదే ఎప్పుడ"
    },
    {
      "t": "01:58",
      "text": "ప్రబ్ంస"
    },
    {
      "t": "02:00",
      "text": "ఓకే"
    },
    {
      "t": "02:02",
      "text": "కానీ కడ చాల బ"
    },
    {
      "t": "02:04",
      "text": "ఫేస్ చూపిస్తున్నారు కదా"
    },
    {
      "t": "02:06",
      "text": "అది వాలిచ్చం కదా ఇప్పుడు"
    },
    {
      "t": "02:08",
      "text": "ది నా ఇష్టం లేదా"
    },
    {
      "t": "02:10",
      "text": "ఏదే ప్రాబ్లమ్ వా ఎవదో వచ్చితే"
    },
    {
      "t": "02:12",
      "text": "చ్చర్ క"
    },
    {
      "t": "02:14",
      "text": "ఉ"
    },
    {
      "t": "02:16",
      "text": ""
    },
    {
      "t": "02:18",
      "text": ""
    },
    {
      "t": "02:20",
      "text": "ఇప్పుడ లేయిచావా"
    },
    {
      "t": "02:22",
      "text": "సై ఉందాక ఎప్పుడ"
    },
    {
      "t": "02:24",
      "text": "చ చ"
    },
    {
      "t": "02:26",
      "text": "ఓకే అవునుంగ"
    },
    {
      "t": "02:28",
      "text": "మని మనిక అా అర్జ గ"
    },
    {
      "t": "02:30",
      "text": "ుస"
    },
    {
      "t": "02:32",
      "text": "అర్జెంటనానే"
    },
    {
      "t": "02:34",
      "text": "త"
    },
    {
      "t": "02:36",
      "text": "నాకు ఎప్పుడోసిన వాసలే అప్పుడ"
    },
    {
      "t": "02:38",
      "text": "హస్ండ్ంత"
    },
    {
      "t": "02:40",
      "text": "ఓకే"
    },
    {
      "t": "02:42",
      "text": "బానే వస్తా"
    },
    {
      "t": "02:44",
      "text": "దాలో కరెక్ట్గా"
    },
    {
      "t": "02:46",
      "text": "తెలీదు నేను ఎక్కువ రో"
    },
    {
      "t": "02:48",
      "text": "అవ్వలేదు ప్స్ నేను ఎక్కువ యూజ్ చే్యను"
    },
    {
      "t": "02:50",
      "text": ""
    },
    {
      "t": "02:52",
      "text": "ఏం చేస్తుంటావు"
    },
    {
      "t": "02:54",
      "text": "ను నువ్వే పను చేసేస్తున్నా"
    },
    {
      "t": "02:56",
      "text": ""
    },
    {
      "t": "02:58",
      "text": "ఈ యాప్ ఇంకా వారం కూడా అవ్వలేదు నాకు"
    },
    {
      "t": "03:00",
      "text": "ఆఓ"
    },
    {
      "t": "03:02",
      "text": "ఎలా అంద మరి"
    },
    {
      "t": "03:04",
      "text": "అదా మర"
    },
    {
      "t": "03:06",
      "text": "బ"
    },
    {
      "t": "03:08",
      "text": "బానే ఉందిరా అంటే"
    },
    {
      "t": "03:10",
      "text": "మరి అలు కనెక్ట్ అవదు మహాచ చిరా్"
    },
    {
      "t": "03:12",
      "text": "ఉంటుంది ఎంతసేపు ట్రై చేస్తే"
    },
    {
      "t": "03:14",
      "text": "ఇప్పుడు కనెక్ట్ అవుతుంది ఎంత బిజీ ఉంటారు జన"
    },
    {
      "t": "03:16",
      "text": "అదే"
    },
    {
      "t": "03:18",
      "text": "అే ఎంద బానక"
    },
    {
      "t": "03:20",
      "text": "కనె తర అందరికి"
    },
    {
      "t": "03:22",
      "text": "లేదు నైట్ టైం అసలు ఎ"
    },
    {
      "t": "03:24",
      "text": "అంత బిజీ ఉంటుంది తెలుసా"
    },
    {
      "t": "03:26",
      "text": "అవు అంటే నేను ఫస్ట్ వేరే"
    },
    {
      "t": "03:28",
      "text": "ూసా నాకు అది నచ్చట్లేదుని"
    },
    {
      "t": "03:30",
      "text": "ద స"
    },
    {
      "t": "03:32",
      "text": "పేరేవంట"
    },
    {
      "t": "03:34",
      "text": "కన"
    },
    {
      "t": "03:36",
      "text": "ఓకే"
    },
    {
      "t": "03:38",
      "text": "ే ఇది"
    },
    {
      "t": "03:40",
      "text": "ఆ మ"
    },
    {
      "t": "03:42",
      "text": "గుారువట్లేని నాకు నచ్చ"
    },
    {
      "t": "03:44",
      "text": "పచ్చ వచ్చ ఎంత చెప్పన వయి"
    },
    {
      "t": "03:46",
      "text": "అ"
    },
    {
      "t": "03:48",
      "text": "ఇందులో బాగా జనం బాగా ఉన్నట్టు"
    },
    {
      "t": "03:50",
      "text": "న్నారు ఫుల్లు ఎప్పుడు చూసినా"
    },
    {
      "t": "03:52",
      "text": "కాల్స్ బిజీలోనే ఉంటారు"
    },
    {
      "t": "03:54",
      "text": "అందరు అమ్మాయిలు అందర"
    },
    {
      "t": "03:56",
      "text": "ఇ ఊర్గా త్వరగా కనెక్ట్ అవుతు మా"
    },
    {
      "t": "03:58",
      "text": "మల్కి ఫుల్లీ బిజీ"
    },
    {
      "t": "04:00",
      "text": "అదే చెప్తున్నా అబ్బాయిలకి"
    },
    {
      "t": "04:02",
      "text": "నేను చాలా సేపు ట్రై చేస్తే కానీ కనెక్ట్"
    },
    {
      "t": "04:04",
      "text": "దు ఎందుకంట అందరు బిజీగా ఉంటారు అమ్మాయిలు"
    },
    {
      "t": "04:06",
      "text": "అప్పుడు మీదవర"
    },
    {
      "t": "04:08",
      "text": "ఒక మంచి పర్సనిెండ్"
    },
    {
      "t": "04:10",
      "text": "సుకోవాలి మనీ స ఏక అతా"
    },
    {
      "t": "04:12",
      "text": "పదుగా మాజం ఇద ఉంటు"
    },
    {
      "t": "04:14",
      "text": "నవా"
    },
    {
      "t": "04:16",
      "text": "బ మరి"
    },
    {
      "t": "04:18",
      "text": "ెడ్ మకుస"
    },
    {
      "t": "04:20",
      "text": "స స్నాప్ అంత"
    },
    {
      "t": "04:22",
      "text": "మరి అదేంట నన్ను"
    },
    {
      "t": "04:24",
      "text": "వవచ్చ కద"
    },
    {
      "t": "04:26",
      "text": "అ"
    },
    {
      "t": "04:28",
      "text": "హ"
    },
    {
      "t": "04:30",
      "text": "అప్పుడప్పుడు మనీ కోసం నువ్వే చెయి"
    },
    {
      "t": "04:32",
      "text": ""
    },
    {
      "t": "04:34",
      "text": "అంటే డైలీ అయితే"
    },
    {
      "t": "04:36",
      "text": "మాట్లాడుద్దా అంటున్నారా"
    },
    {
      "t": "04:38",
      "text": "ఓకే"
    },
    {
      "t": "04:40",
      "text": "అంటే నేను"
    },
    {
      "t": "04:42",
      "text": "అ ైయనా మ"
    },
    {
      "t": "04:44",
      "text": "డ నాట్లేదు"
    },
    {
      "t": "04:46",
      "text": "నాకు మనీ అవష్టం"
    },
    {
      "t": "04:48",
      "text": "ఉన్నప్పుడే ఇంకా హాప్ లో గ రా"
    },
    {
      "t": "04:50",
      "text": "మీ కళా"
    },
    {
      "t": "04:52",
      "text": "ఓకే అంటే చెప్పండి మీకు"
    },
    {
      "t": "04:54",
      "text": "అవసరం ఉన్నప్పుడు మీరు మైసేజ్ చేయండి"
    },
    {
      "t": "04:56",
      "text": "ఇన్వస్ట్ ప నావ"
    },
    {
      "t": "04:58",
      "text": "చ అట్లా"
    },
    {
      "t": "05:00",
      "text": "ఓకే"
    },
    {
      "t": "05:02",
      "text": "కానీ నువ్వు ఎలా ఉంటావు బాగుంటావా"
    },
    {
      "t": "05:04",
      "text": "అను"
    },
    {
      "t": "05:06",
      "text": "అంటా పలేదు"
    },
    {
      "t": "05:08",
      "text": ""
    },
    {
      "t": "05:10",
      "text": "ఫిగర్ చెప్పు"
    },
    {
      "t": "05:12",
      "text": "ఎక్కనంటే"
    },
    {
      "t": "05:14",
      "text": "నక"
    },
    {
      "t": "05:16",
      "text": "పటిే"
    },
    {
      "t": "05:18",
      "text": "సీ కత పోర్వ"
    },
    {
      "t": "05:20",
      "text": "తెస్"
    },
    {
      "t": "05:22",
      "text": "ట్"
    },
    {
      "t": "05:24",
      "text": "అదేంటి నడుముగా నడుము పెద్దది"
    },
    {
      "t": "05:26",
      "text": "జస్ట్"
    },
    {
      "t": "05:28",
      "text": "ఆ"
    },
    {
      "t": "05:30",
      "text": "నడుము ఎలాథర్టీ ఫోర్ ఉుంది చెస్ ర్టీ టూ ఉంటంది"
    },
    {
      "t": "05:32",
      "text": ""
    },
    {
      "t": "05:34",
      "text": "అలాగే ఉంది థర్టీ త్రీ  థర్టీ"
    },
    {
      "t": "05:36",
      "text": "అంది టెస్ కూడా అ"
    },
    {
      "t": "05:38",
      "text": "ఇంచ కొంచ"
    },
    {
      "t": "05:40",
      "text": "నడువంట నడువంటవా"
    },
    {
      "t": "05:42",
