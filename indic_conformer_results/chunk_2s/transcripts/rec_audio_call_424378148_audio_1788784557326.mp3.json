    {
      "t": "00:02",
      "text": "ஹல ஆ"
    },
    {
      "t": "00:04",
      "text": ""
    },
    {
      "t": "00:06",
      "text": "மற்றும்த்தம்"
    },
    {
      "t": "00:08",
      "text": "என்ன ஒே சவுண்டா இருக்கு"
    },
    {
      "t": "00:10",
      "text": "சம்"
    },
    {
      "t": "00:12",
      "text": "ஒரு ஃபேன் டுதா ஓகே ஓகே"
    },
    {
      "t": "00:14",
      "text": "தங்கந்து பேசிங்கப்ப"
    },
    {
      "t": "00:16",
      "text": "ந பெங்கூர்"
    },
    {
      "t": "00:18",
      "text": "ோ"
    },
    {
      "t": "00:20",
      "text": "உஹ்"
    },
    {
      "t": "00:22",
      "text": "கோபீ"
    },
    {
      "t": "00:24",
      "text": "பூஜாூா"
    },
    {
      "t": "00:26",
      "text": "என்ந்த கொந்தங்க"
    },
    {
      "t": "00:28",
      "text": "ந ந சரி"
    },
    {
      "t": "00:30",
      "text": "ஷம ஆம்"
    },
    {
      "t": "00:32",
      "text": "கம்பல் ஒர்க் பண்ணுறேன்"
    },
    {
      "t": "00:34",
      "text": "ஓகா"
    },
    {
      "t": "00:36",
      "text": "சிங்கனா கம்பட்டடா"
    },
    {
      "t": "00:38",
      "text": "ஆ சங்கல்"
    },
    {
      "t": "00:40",
      "text": "என்ன வயசா"
    },
    {
      "t": "00:42",
      "text": "்வன்ட்டிஃோர்"
    },
    {
      "t": "00:44",
      "text": "ஓகோ"
    },
    {
      "t": "00:46",
      "text": "மங்கல்க"
    },
    {
      "t": "00:48",
      "text": "உங்களை விட ஒரு ரெண்டு வயசு பே"
    },
    {
      "t": "00:50",
      "text": "ண்ணுங்க"
    },
    {
      "t": "00:52",
      "text": "ந ச"
    },
    {
      "t": "00:54",
      "text": "ரி"
    },
    {
      "t": "00:56",
      "text": "லைஃ எப்படி"
    },
    {
      "t": "00:58",
      "text": "போகுது உந்த ஆசை படி போகுது"
    },
    {
      "t": "01:00",
      "text": "உம் உம் இன்னைக்குதான் வந்தேந்த"
    },
    {
      "t": "01:02",
      "text": "சப்புல"
    },
    {
      "t": "01:04",
      "text": "பேசுறாங்க பிடிச்சிருக்கா யாரயாச்சும்"
    },
    {
      "t": "01:06",
      "text": "இன்னும் ஏதோ பேசவே இல்லை நீதான் செகண்ட்"
    },
    {
      "t": "01:08",
      "text": "க பசு நாால் கட்டாயடுச்சு"
    },
    {
      "t": "01:10",
      "text": "ஓ ஓகே"
    },
    {
      "t": "01:12",
      "text": "உம்"
    },
    {
      "t": "01:14",
      "text": "உன்ற"
    },
    {
      "t": "01:16",
      "text": "ஓகே அல"
    },
    {
      "t": "01:18",
      "text": "என் ப"
    },
    {
      "t": "01:20",
      "text": "கா"
    },
    {
      "t": "01:22",
      "text": "முடிஞ்ச த்ரீ தேர்ட்டிக்கு"
    },
    {
      "t": "01:24",
      "text": "சரி வந்து அப்படியே படல படுத்துச்சே"
    },
    {
      "t": "01:26",
      "text": "என்ன பண்றதுன்னு நினைச்சுிட்டே இருந்தேன்"
    },
    {
      "t": "01:28",
      "text": "சரி நீ நய தே"
    },
    {
      "t": "01:30",
      "text": "ல் பண்ணன் இன்ஸ்டாகிராம்ல பாத்தன்னா"
    },
    {
      "t": "01:32",
      "text": "சரி நக்கு"
    },
    {
      "t": "01:34",
      "text": "ஏதாச்சும் கேட்டாலும் பார்த்தலும் அதுனு தெரிஞ்சு"
    },
    {
      "t": "01:36",
      "text": "க்கலாம் இா தூக்கமே வராது"
    },
    {
      "t": "01:38",
      "text": "ஓ எதோ பத்திர் நீ இன்ன பையா"
    },
    {
      "t": "01:40",
      "text": "என்னாப்ப பத்திதான்"
    },
    {
      "t": "01:42",
      "text": "சரி இன்ஸ்டால் பண்ணி வச்சு"
    },
    {
      "t": "01:44",
      "text": "இப்போ ஞாபம்ந்துதான் ப"
    },
    {
      "t": "01:46",
      "text": "பண்ணிஸ் கால்"
    },
    {
      "t": "01:48",
      "text": "பேச எப்படிச்ச நல்ல"
    },
    {
      "t": "01:50",
      "text": "பேசாங்க"
    },
    {
      "t": "01:52",
      "text": "அடிதான் சட நார்ல்"
    },
    {
      "t": "01:54",
      "text": "ல்ல இ"
    },
    {
      "t": "01:56",
      "text": "பாத்தீங்கன்னா அவங்கள பத்தி சொன்னாங்க"
    },
    {
      "t": "01:58",
      "text": "பத்தி கேட்டாங்க"
    },
    {
      "t": "02:00",
      "text": "ச நம"
    },
    {
      "t": "02:02",
      "text": "போச்ச"
    }
  ],
