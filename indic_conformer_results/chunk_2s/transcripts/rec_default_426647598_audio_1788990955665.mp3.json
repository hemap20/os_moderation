    },
    {
      "t": "00:14",
      "text": "ஹலோ"
    },
    {
      "t": "00:16",
      "text": "கேக்குட்டா"
    },
    {
      "t": "00:18",
      "text": "எங்க இருந்து பேசுறீங்க"
    },
    {
      "t": "00:20",
      "text": ""
    },
    {
      "t": "00:22",
      "text": "ஆான் சென்னை நீங்க"
    },
    {
      "t": "00:24",
      "text": "நாம் பேங்களூர்"
    },
    {
      "t": "00:26",
      "text": "என்ன பேருங்க"
    },
    {
      "t": "00:28",
      "text": ""
    },
    {
      "t": "00:30",
      "text": "என் பேர் அசோக் உங்க பேர்"
    },
    {
      "t": "00:32",
      "text": "எப்ப நிலா"
    },
    {
      "t": "00:34",
      "text": "அசோக் மேரிடா"
    },
    {
      "t": "00:36",
      "text": "அன்மரிடா"
    },
    {
      "t": "00:38",
      "text": ""
    },
    {
      "t": "00:40",
      "text": "அந்த அந்த"
    },
    {
      "t": "00:42",
      "text": ""
    },
    {
      "t": "00:44",
      "text": "செக்னல் ச"
    },
    {
      "t": "00:46",
      "text": ""
    },
    {
      "t": "00:48",
      "text": "பேசுது ஸ்ட்ரக் ஆகுது"
    },
    {
      "t": "00:50",
      "text": ""
    },
    {
      "t": "00:52",
      "text": "ஹலோ"
    },
    {
      "t": "00:54",
      "text": "சேஸ் கட்டும் தெரியல"
    },
    {
      "t": "00:56",
      "text": "ஆ வா"
    },
    {
      "t": "00:58",
      "text": "ஆ சொல்லுங்க"
    },
    {
      "t": "01:00",
      "text": "அசோக் எவ்வளவு நல்லா இருக்கீங்க"
    },
    {
      "t": "01:02",
      "text": ""
    },
    {
      "t": "01:04",
      "text": "ஆஹ்"
    },
    {
      "t": "01:06",
      "text": "போர் டேஸ் உம்"
    },
    {
      "t": "01:08",
      "text": "எப்படி பேசுலானா நீங்க"
    },
    {
      "t": "01:10",
      "text": ""
    },
    {
      "t": "01:12",
      "text": "உ"
    },
    {
      "t": "01:14",
      "text": "வோலும் எப்படி வேணாலும்"
    },
    {
      "t": "01:16",
      "text": "உம்"
    },
    {
      "t": "01:18",
      "text": "போோ டேஸல யாட்டியும்"
    },
    {
      "t": "01:20",
      "text": "ரேர் மீட் பண்ணியிருக்கீங்களா"
    },
    {
      "t": "01:22",
      "text": ""
    },
    {
      "t": "01:24",
      "text": "புரியல போ"
    },
    {
      "t": "01:26",
      "text": "பேசி அததுாவது கலெக்ட் பண்ணியிருக்கீங்க"
    },
    {
      "t": "01:28",
      "text": "ான் கேட்டேன்"
    },
    {
      "t": "01:30",
      "text": ""
    },
    {
      "t": "01:32",
      "text": "இதுக்கு அப்புறம் தான் பண்ண"
    },
    {
      "t": "01:34",
      "text": "அதுக்கப்புறம் தான் பண்ண"
    },
    {
      "t": "01:36",
      "text": "உம் அப்போ"
    },
    {
      "t": "01:38",
      "text": "பிசிக்கல் ரிலேஷன்ஷிப் எந்தத இல்லையா"
    },
    {
      "t": "01:40",
      "text": ""
    },
    {
      "t": "01:42",
      "text": "உக்க நீ"
    },
    {
      "t": "01:44",
      "text": "வாப்ப வெஜினா"
    },
    {
      "t": "01:46",
      "text": "உம்"
    },
    {
      "t": "01:48",
      "text": "ஏ"
    },
    {
      "t": "01:50",
      "text": "என்னச்சே"
    },
    {
      "t": "01:52",
      "text": "கண்டு"
    },
    {
      "t": "01:54",
      "text": "ஆ ஓகே ஓகே"
    },
    {
      "t": "01:56",
      "text": "மிஸ் பண்ணிட்டீங்களேப்பா லைப"
    },
    {
      "t": "01:58",
      "text": "உம்"
    },
    {
      "t": "02:00",
      "text": "அப்ப ரு"
    },
    {
      "t": "02:02",
      "text": "ஆஹ"
    },
    {
      "t": "02:04",
      "text": "அ என்க்கு"
    },
    {
      "t": "02:06",
      "text": "பண்ணிட்டீங்களா இப்ப எல்லாம்"
    },
    {
      "t": "02:08",
      "text": "கமிட்ெண்ட் தான் இருக்கும் என்ஜாய்மெண்ட் இருக்கா"
    },
    {
      "t": "02:10",
      "text": ""
    },
    {
      "t": "02:12",
      "text": "உம்"
    },
    {
      "t": "02:14",
      "text": "என்ன"
    },
    {
      "t": "02:16",
      "text": ""
    },
    {
      "t": "02:18",
      "text": "உம்"
    },
    {
      "t": "02:20",
      "text": "ஆ ஆ"
    },
    {
      "t": "02:22",
      "text": "சொல்லல சரி"
    },
    {
      "t": "02:24",
      "text": "நான் இன்னைக்கு தான் இன்ஸ்டால் பண்ண இந்த ஆப் எனக்கு"
    },
    {
      "t": "02:26",
      "text": "அதிகமா தெரியாது எப்படி பேசணும்னு சொல்லி"
    },
    {
      "t": "02:28",
      "text": "சொல்லுங்க பேசிடலாம்"
    },
    {
      "t": "02:30",
      "text": ""
    },
    {
      "t": "02:32",
      "text": ""
    },
    {
      "t": "02:34",
      "text": "உம்"
    },
    {
      "t": "02:36",
      "text": "உஹ ஓக்கே தாான"
    },
    {
      "t": "02:38",
      "text": "ஓப்பனா பேசலாம்டானே வந்துிரு"
    },
    {
      "t": "02:40",
      "text": "இருக்கீங்க நீங்க உப்பனவே எதனாலும் கேட்கலாம்"
    },
    {
      "t": "02:42",
      "text": ""
    },
    {
      "t": "02:44",
      "text": ""
    },
    {
      "t": "02:46",
      "text": ""
    },
    {
      "t": "02:48",
      "text": "ஏ நீங்க கேளுங்க"
    },
    {
      "t": "02:50",
      "text": "எ"
    },
    {
      "t": "02:52",
      "text": "எனக்கு தெரிஞ்சவரை கேட்டு வச்சுட்டேன் சரி ரியல்"
    },
    {
      "t": "02:54",
      "text": "் பண்ணட் பண்ணலாமா"
    },
    {
      "t": "02:56",
      "text": ""
    },
    {
      "t": "02:58",
      "text": ""
    },
    {
      "t": "03:00",
      "text": "ட்ட ஆஹ"
    },
    {
      "t": "03:02",
      "text": "நீ ஏட்டு"
    },
    {
      "t": "03:04",
      "text": "ஊர்ச்சுன்னா சென்னையா"
    },
    {
      "t": "03:06",
      "text": ""
    },
    {
      "t": "03:08",
      "text": "நான் வரேன் உம்"
    },
    {
      "t": "03:10",
      "text": "அமௌண்ட் எதுவும் தேவையில்ல"
    },
    {
      "t": "03:12",
      "text": "புல்பில் சாட்டிஸ்ஃபேக்ஷன் ஒன்ன"
    },
    {
      "t": "03:14",
      "text": "அடல"
    },
    {
      "t": "03:16",
      "text": ""
    },
    {
      "t": "03:18",
      "text": "பயப்படாத கடத்திட்டுல்லாம் போ"
    },
    {
      "t": "03:20",
      "text": "பு"
    },
    {
      "t": "03:22",
      "text": "எதுவும் தேவையில்லடா புல்ஃபில் பண்ணா"
    },
    {
      "t": "03:24",
      "text": "போதும் நானே வரேன் சென்னை"
    },
    {
      "t": "03:26",
      "text": "ஆஹ்"
    },
    {
      "t": "03:28",
      "text": "ஒன கொக்கே"
    },
    {
      "t": "03:30",
      "text": "கேட்டேன்"
    },
    {
      "t": "03:32",
      "text": "உம்"
    },
    {
      "t": "03:34",
      "text": "உம் அங்க மட் பண்"
    },
    {
      "t": "03:36",
      "text": "கேட்டாங்க இருக்கா இல்ல நீ பெங்களூர் வர"
    },
    {
      "t": "03:38",
      "text": "நான் டிக்கெட் பட்டுதேன்"
    },
    {
      "t": "03:40",
      "text": "ஆஹ"
    },
    {
      "t": "03:42",
      "text": "நீ ஒ"
    },
    {
      "t": "03:44",
      "text": "கே்கலங்க அப்படின்னு ஹங்க் ஆகுது"
    },
    {
      "t": "03:46",
      "text": "நாட்டுக்கு"
    },
    {
      "t": "03:48",
      "text": "டிெ் போட்டுத நீ பேங்களூர்ரியான்னு கேட்டேன்"
    },
    {
      "t": "03:50",
      "text": ""
    },
    {
      "t": "03:52",
      "text": "உம்"
    },
    {
      "t": "03:54",
      "text": "உம் அதரேன் உம்"
    },
    {
      "t": "03:56",
      "text": "ஓகே"
    },
    {
      "t": "03:58",
      "text": "உம்"
    },
    {
