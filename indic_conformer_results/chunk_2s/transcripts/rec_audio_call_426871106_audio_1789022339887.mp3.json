{
  "file_id": "rec_audio_call_426871106_audio_1789022339887.mp3",
  "language": "kannada",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 288.005,
  "processing_time_sec": 10.541286945343018,
  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ ಹಲೋ"
    },
    {
      "t": "00:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": ""
    },
    {
      "t": "00:06",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:08",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:10",
      "text": "ಹೇಳಏ್ರಿ"
    },
    {
      "t": "00:12",
      "text": "ಏನ್ೀ ಮಾಡ್ತಾಿದ್ದೀರಾ"
    },
    {
      "t": "00:14",
      "text": "ಹಾ"
    },
    {
      "t": "00:16",
      "text": "ಕೂತ್ಕೊಂಡಿದ್ದೀ ರೇ"
    },
    {
      "t": "00:18",
      "text": "ಕುೂತ್ಕೊಂಡು ಏನ್ ಮಾಡಾ್ತಾಿದ್ದೀರಾ"
    },
    {
      "t": "00:20",
      "text": "ಏನ್ ಮಾಡಣ"
    },
    {
      "t": "00:22",
      "text": "ಕೂ ಕಗ್ರೀ"
    },
    {
      "t": "00:24",
      "text": "ಎಲ್ಲಿ ನಿಮ್ಗೆ ಯಾವರು ನಿಮ"
    },
    {
      "t": "00:26",
      "text": ""
    },
    {
      "t": "00:28",
      "text": "ಹಾ ಹಬ್ಳಿ"
    },
    {
      "t": "00:30",
      "text": "ಹುಬ್ಡಿಿನ"
    },
    {
      "t": "00:32",
      "text": "ನಿನ್ನೆ ಮಾತಾಡಿದ್ರ ನನ್ನತ್ರ ನೀವು"
    },
    {
      "t": "00:34",
      "text": "ಹಾ"
    },
    {
      "t": "00:36",
      "text": "ವ"
    },
    {
      "t": "00:38",
      "text": "ಇಲ್ಲಿವಾ"
    },
    {
      "t": "00:40",
      "text": "ಏನು ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ"
    },
    {
      "t": "00:42",
      "text": "ಹಾೌಸ್ ವೈಫ್ ಹಾ"
    },
    {
      "t": "00:44",
      "text": "ಹ್ಮ"
    },
    {
      "t": "00:46",
      "text": "ಹಾ"
    },
    {
      "t": "00:48",
      "text": "ಹ"
    },
    {
      "t": "00:50",
      "text": "ಹೋ"
    },
    {
      "t": "00:52",
      "text": "ಹ್ಮ"
    },
    {
      "t": "00:54",
      "text": "ಹೇಳಿ ಏನೋ ಮಾಡಿ"
    },
    {
      "t": "00:56",
      "text": "ನೀವೇನ್ ಮಾಡಕೊಂಡ"
    },
    {
      "t": "00:58",
      "text": "ನಾನ್ ಕೆಲ್ಸ"
    },
    {
      "t": "01:00",
      "text": "ಮಾಡ್ಕೊಂಡಿದ್ದೀನಿ ಏನು"
    },
    {
      "t": "01:02",
      "text": "ಅಲ್ತ ಬಡಿಿ"
    },
    {
      "t": "01:04",
      "text": "ಯಾವುದೋ ಒಂದು ಕೆಲಸ ಏನು ಮಾಡ್ತೀರ"
    },
    {
      "t": "01:06",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:08",
      "text": ""
    },
    {
      "t": "01:10",
      "text": ""
    },
    {
      "t": "01:12",
      "text": "ಏನ್ ಏನ್ ಮಾಡ್ಬೇಕು ನೀವು ಹೇಳ"
    },
    {
      "t": "01:14",
      "text": "ಬೇಕು ಏನ್ ಮಾಡ್ತೀರಾ ಯಾಕ ನೀವು"
    },
    {
      "t": "01:16",
      "text": "ಹ ಟಮ ಪಸ್ ಮಾಡ"
    },
    {
      "t": "01:18",
      "text": "ಮುಕತನಪ್ಪು"
    },
    {
      "t": "01:20",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:22",
      "text": ""
    },
    {
      "t": "01:24",
      "text": "ಸರಿ ಸರಿ ಕಂಡು ಟೈಮ್ ಪಾಸ್ ಮಾಡಿ"
    },
    {
      "t": "01:26",
      "text": "ಚಾಕರಿ"
    },
    {
      "t": "01:28",
      "text": "ಸುಮ್ಮಕಾಳ"
    },
    {
      "t": "01:30",
      "text": "ಹೇಳ್ಬಾ ಹೇಳ್ಬಾರೀ"
    },
    {
      "t": "01:32",
      "text": "ಹ ಮಾಡ್"
    },
    {
      "t": "01:34",
      "text": "ನಾನೇನ್ ಹೇಳಿ"
    },
    {
      "t": "01:36",
      "text": "ಮಾಡಬಾರ್ದುಂತ ಅವ್ರವರು ಇಷ್ಟ"
    },
    {
      "t": "01:38",
      "text": "ಎ"
    },
    {
      "t": "01:40",
      "text": "ನ ಬ"
    },
    {
      "t": "01:42",
      "text": "ಒಂದು ಒಂದು ಒಂದು ವರ್ಷ ಆಯಿತು"
    },
    {
      "t": "01:44",
      "text": "ವಾ ಹಾ"
    },
    {
      "t": "01:46",
      "text": "ಎಷ್ಟು ಖರ್ಚು ಮಾಡಿದ್ದೀರಾ"
    },
    {
      "t": "01:48",
      "text": "ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "01:50",
      "text": "ಅಪ್ಪಾ ಅದೇವ್ರೆ"
    },
    {
      "t": "01:52",
      "text": "ಹ್ಮ"
    },
    {
      "t": "01:54",
      "text": "ಅಂತ ಲಕ್ಷ ಹ್ಮ್"
    },
    {
      "t": "01:56",
      "text": "ಕಾರ"
    },
    {
      "t": "01:58",
      "text": "ತೇ ಈ ಲಯನ್"
    },
    {
      "t": "02:00",
      "text": "ಏನಿಲ್ಲಲ್ಲ ಸುಮ್ಮನೆ ಕರ್ಸ್ಂತ ಬೈಕ್ ಒಂದ"
    },
    {
      "t": "02:02",
      "text": "ಅಲ್ಲ ಅಲ್ಲ"
    },
    {
      "t": "02:04",
      "text": "ಲಕ್ಷ ಅದೇ ಅಪ್ಪಮ್ಮಗು"
    },
    {
      "t": "02:06",
      "text": "ಕೊಟ್ಟಿದ್ದ ಎಷ್ಟು ಖುಷಿ ಪಡರು ಒಂದು್ ಲಕ್ಷ"
    },
    {
      "t": "02:08",
      "text": "ಅದುೇ ಕಟ್ಟಕ್ಟ ಅಲ್ಲವಾ"
    },
    {
      "t": "02:10",
      "text": "ಇವೇ"
    },
    {
      "t": "02:12",
      "text": "ಚ ಮಾಡ್ತೀನಿ ಆನ"
    },
    {
      "t": "02:14",
      "text": "ಅದೇ ದುಡ್ಡಿದ್ರೆ ಅಪ್ಪ ಅಮ್ಮ"
    },
    {
      "t": "02:16",
      "text": "ಅಕ್ಕ ತಂಗಿ ಅಣ್ಣ ತಂಬಾ ಏನು"
    },
    {
      "t": "02:18",
      "text": "ಅದು ಕೊಡಸ್ಬದು"
    },
    {
      "t": "02:20",
      "text": "ಇಲ್ವಾ ಇ ರರಿ ಫಷ್ಟಟ್ ತೆಗೀನಿ ಯಕು ನೀ"
    },
    {
      "t": "02:22",
      "text": "ನಿಷ್ಟ"
    },
    {
      "t": "02:24",
      "text": "ಅದು ನನ್ನ ನನ್ನ ಲೆಕ್ಕಕ್ಕೆ"
    },
    {
      "t": "02:26",
      "text": "ನಾನು ಹೇಳಿದೆ ಕರೆಕ್ಟ ಕರೆಕ್"
    },
    {
      "t": "02:28",
      "text": "ಹ್ಮ ನನ್ ಕಡೆ ಏನಾದ್"
    },
    {
      "t": "02:30",
      "text": "ಅದ್ರ ಇದ್ದಿದ್ರೆ ಅಷ್ಟು"
    },
    {
      "t": "02:32",
      "text": "ಎಷ್ಟು ಹೊತ್ಗ ನಾನನ್ ಮಾಗಲಿ ಬರ್"
    },
    {
      "t": "02:34",
      "text": "ಮಾಡಸ ಆಕ್ತಿದತೆ"
    },
    {
      "t": "02:36",
      "text": "ೋ"
    },
    {
      "t": "02:38",
      "text": "ನಾ ನೆಕ್ಸ್ಟ್ಗೆ ಏನಾದ್ ಚ"
    },
    {
      "t": "02:40",
      "text": "ಕೊಡಿಸ್ತಿದ್ದೆ ನಾನ ನಿಮ ಎಸಾ"
    },
    {
      "t": "02:42",
      "text": "ಹ್ಮ್ ಎಕ್ಕೆ"
    },
    {
      "t": "02:44",
      "text": "ಪ್ರೆಸೆಂಟ್ ಇಲ್ವಾ"
    },
    {
      "t": "02:46",
      "text": "ಪ್ರೆಸೆಂಟ್ ಅಂದ್ರೆ"
    },
    {
      "t": "02:48",
      "text": "ಸಿಂಗಲ್ ಪೇರೆಂಟು"
    },
    {
      "t": "02:50",
      "text": "ಸಿಂಗಿಲ್ ಪೇರಂಟಾ"
    },
    {
      "t": "02:52",
      "text": "ಹ್ಮ್ ಸಿಂಗಲ್ ಪೇರೆಂಟ್"
    },
    {
      "t": "02:54",
      "text": "ಂಟಗ ಎಕ್ಸ್ ಕೆೇಂಗ್ರ ಕೊಡಿಸ್ತೀರಾ"
    },
    {
      "t": "02:56",
      "text": "ಕೊಡ್ಿಸತೀನಿ ಅವನ್"
    },
    {
      "t": "02:58",
      "text": "ಕೆಡೋದಚ್ಚೆ ನನ್ ಕೊಡೋದಚ್ಚೆ"
    },
    {
      "t": "03:00",
      "text": "ರಿ ನಿಮ್ಮಂತ ಅವ ರೀ"
    },
    {
      "t": "03:02",
      "text": "ಇರೋದರಿಿಂದ ಈ ಪ್ರಪಂಚ ಇವತ್ತು ಉಳಿದರ"
    },
    {
      "t": "03:04",
      "text": "ಯಕ್ರೀ"
    },
    {
      "t": "03:06",
      "text": "ಏನ ಸನ್ನೆಗೆ"
    },
    {
      "t": "03:08",
      "text": "ಯಾಕೇಳ್ರಿ"
    },
    {
      "t": "03:10",
      "text": "ಹನ್ನೆ ಹಂಗ"
    },
    {
      "t": "03:12",
      "text": "ನನ್ು ಮಕ್ಳ ಕಯತ"
    },
    {
      "t": "03:14",
      "text": "ಯಕ್ಸ್ಗಾತಿಯನ್ನು ಕೊಡಸ್ತಿದ್ನಪ್ಪ"
    },
    {
      "t": "03:16",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "03:18",
      "text": "ಇಲ್ಲಾ ಅಂದ್ರೆ ಒಂದ್ ಜಜಾಕ್ ಹೋಗಿ ಸಕತ್ತ"
    },
    {
      "t": "03:20",
      "text": "ಪಾರ್ಟಿ ಮಾಡ್ತಿದ್ದು ದುಡ್ಡಿ"
    },
    {
      "t": "03:22",
      "text": "ಎಲ್ಗ ಹೋಗಿದ್ರ"
    },
    {
      "t": "03:24",
      "text": "ರೆಸಾರ್ಟ್ಗೆ ಹೋಗಿ ಪಾರ್ಟಿ ಮಾಡ್ತಿದ್ದ್ವು ಅಂದೆ"
    },
    {
      "t": "03:26",
      "text": "ಏನ್ ಮಾಡ್ತರ ರಸಾರಡ್ ಕ ಕೊಪಡಿ ಹಂಗ ಪಾಿ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "03:28",
      "text": "ಪಾರ್ಟಿ ಅಂದ್ರೆ ಮಾ"
    },
    {
      "t": "03:30",
      "text": "ಮುಲಿ ಪಾರ್ಟಿಣೋದು ತಿನ್ನೋದು"
    },
    {
      "t": "03:32",
      "text": "ಹಾ ಮಾಡ್ ಕುಡದು"
    },
    {
      "t": "03:34",
      "text": "ಇಲ್ಲ ಪಾದ ಹ್ಯಾಬಿಟ್ಟಲ್ಲ"
    },
    {
      "t": "03:36",
      "text": "ಕ್ಯಾಪಿಟಲ"
    },
    {
      "t": "03:38",
      "text": "ಮಾಡ್ಕೊಳ್ಳ"
    },
    {
      "t": "03:40",
      "text": "ಸವಸನ ಬಿೇಡ"
    },
    {
      "t": "03:42",
      "text": "ಏನ ಹಿಂಗ ಅಂತೀರಾ"
    },
    {
      "t": "03:44",
      "text": "ಹ"
    },
    {
      "t": "03:46",
      "text": "ಒಂದು ಲಕ್ಷ ಅಂದ್ರೆ ್ಣ ನನಗೆ"
    },
    {
      "t": "03:48",
      "text": "ಯಶರ್ ಹ"
    },
    {
      "t": "03:50",
      "text": "ನ"
    },
    {
      "t": "03:52",
      "text": "ಕೊಟ್ಟಿಯನ್ ಗಟ್ಟಲೆ ದುಡ್ಡಿದ ಏನು ಮಾಡಾನ"
    },
    {
      "t": "03:54",
      "text": "ಹೊಡಿ ಹಂದ ಐದು ಲಕ್ಷ ಹಂದ"
    },
    {
      "t": "03:56",
      "text": "ಐದಾರು ಸಾವಿರ"
    },
    {
      "t": "03:58",
      "text": "ಸಾಕಾ ಸಾಕ"
    },
    {
      "t": "04:00",
      "text": "ಏನ್ ಮಾಡ್ತರಾ ಐದ ಸಾವ ಹಡ್ಕೊಂಡು"
    },
    {
      "t": "04:02",
      "text": "ನಾ ನೆಕ್ಸ್ಟ್ಗೆ ಏನಾದ್ೂ ಕೊಡ್ತೀನತಿ"
    },
    {
      "t": "04:04",
      "text": "ಎ"
    },
    {
      "t": "04:06",
      "text": "ನೀವ ಏನ್ೀ ಕೊಡ್ಸೀರ ಅವರೇ ಕೊಡ್ತಾರ"
    },
    {
      "t": "04:08",
      "text": "ಕಡ"
    },
    {
      "t": "04:10",
      "text": "ತಾರೆ ಆದ್ರೆ ನಮ"
    },
    {
      "t": "04:12",
      "text": "ನಮ್ದ ಒಂಥರ ಹಠ ನ"
    },
    {
      "t": "04:14",
      "text": "ಕೊಡಸ್್ಬೇಕು ಅವ್ರ ಕಡೆಯಿಂದ ನಮ್ಗೆ ಏನು ಬೇಡ"
    },
    {
      "t": "04:16",
      "text": ""
    },
    {
      "t": "04:18",
      "text": "ನಮ್ಗ ಆತ್ರ ಟ್ರಿಮು ಇಲ್ಲ"
    },
    {
      "t": "04:20",
      "text": ""
    },
    {
      "t": "04:22",
      "text": "ಹಂಗೆ ಕರೆಕ್ಟ್ ಕಣರಿ ಫಾಸ್ಟ್"
    },
    {
      "t": "04:24",
      "text": "ಆಪ್ ನನ್ ಇನ್ಸ್ಟಾಲ್ ಮಾಡ್ಬಿಟ್ಟುದ"
    },
    {
      "t": "04:26",
      "text": "ಹುಡುಗ ಹೋಗಬಿಟ್ಟು ಚೆನ್ನಾಗಿ ನಾನು ಕೊಡ್್ತೀನಿ"
    },
    {
      "t": "04:28",
      "text": "ಹ"
    },
    {
      "t": "04:30",
      "text": "ಹುಡ್ಗಿ ಪಾಯಸದು ಜಾಸ್ತಿಿನ ಟೈಮ್"
    },
    {
      "t": "04:32",
      "text": "ಟೈಮ"
    },
    {
      "t": "04:34",
      "text": "ತೊಡ್ಟ್ಟು"
    },
    {
      "t": "04:36",
      "text": "ಗಿಫತ ಅಲ್ಲ"
    },
    {
      "t": "04:38",
      "text": "ಅಂಥವ್ರು ಇದ್ದಾರೆ ಸುಮಾರು ಜನ"
    },
    {
      "t": "04:40",
      "text": "ನಾನ್ ನೋಡರ್ ಪ್ರ"
    },
    {
      "t": "04:42",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "04:44",
      "text": "ಟೈಮ"
    },
    {
      "t": "04:46",
      "text": "ಚೂರು ಪ್ರೀತಿ"
