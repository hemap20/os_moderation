    },
    {
      "t": "00:10",
      "text": "வேலூர் என்ன பண்றீங்க"
    },
    {
      "t": "00:12",
      "text": "ஆஹ ஸ்டீஸ் முடிச்சட்டு வீடட்டு்ல இருக்கேன்"
    },
    {
      "t": "00:14",
      "text": "நீரிய கல்லோ கொச்சுவன"
    },
    {
      "t": "00:16",
      "text": "ஏச"
    },
    {
      "t": "00:18",
      "text": "உ"
    },
    {
