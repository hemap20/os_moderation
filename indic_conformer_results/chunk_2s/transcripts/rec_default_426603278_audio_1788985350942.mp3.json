    {
      "t": "00:30",
      "text": "ನಿಮ"
    },
    {
      "t": "00:32",
      "text": "ನ"
    },
    {
      "t": "00:34",
      "text": "ಟ್ವೆಂಟಿ ಸೆವೆನ್ ನಿಮಗೆ"
    },
    {
      "t": "00:36",
      "text": "ಹ್ಮಂತ ಮೂರುಸ ಚಕ್ಕಳ ಬಿಿ"
    },
    {
      "t": "00:38",
      "text": ""
    },
    {
      "t": "00:40",
      "text": "ಹ"
    },
    {
      "t": "00:42",
      "text": "ಟ್ವೆ ಟ್ವೆಂಟಿ ಫೈವ್ ನನ್ಗೆ"
    },
    {
      "t": "00:44",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "00:46",
      "text": "ಬೇಕು ಅಂತ"
    },
    {
      "t": "00:48",
      "text": "ಮನ್ ಮೀ ಜಾವಾಗ್ಲೇ ಅಲ್ವೋ ಗೊತ್ತಾಗದು"
    },
    {
      "t": "00:50",
      "text": "ಆ"
    },
    {
      "t": "00:52",
      "text": "ಹಾ"
    },
    {
      "t": "00:54",
      "text": "ಟ್ವೆಟಿ ಕ ಟ್ಿ  ಟ್ವೆಂಟ"
    },
    {
      "t": "00:56",
      "text": "ಪ ಈ"
    },
    {
      "t": "00:58",
      "text": "ಟ್ವೆಂಟಿ ತ್ರ್ರೀ ನ"
    },
    {
      "t": "01:00",
      "text": "ಟ್ವೆಂಟಿ ಫೋರ್ ಹ್ಮ"
    },
    {
      "t": "01:02",
      "text": "ಕಂಪ್ಲೀಟ್ ಆಗಿಲ್ಲ"
    },
    {
      "t": "01:04",
      "text": "ಹ್ಮ್ ವಂತ ಕೇಪು"
    },
    {
      "t": "01:06",
      "text": "ಹ"
    },
    {
      "t": "01:08",
      "text": "ಎಂತ ಕ ಅು"
    },
    {
      "t": "01:10",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:12",
      "text": "ಈ"
    },
    {
      "t": "01:14",
      "text": "ಮಕ ಗ"
    },
    {
      "t": "01:16",
      "text": "ಹೌಟ್ರು ಅನ್ಸುತ್ತೆ"
    },
    {
      "t": "01:18",
      "text": "ಖಂಡಿತ ಹೌದು ಅದ"
    },
    {
      "t": "01:20",
      "text": "ಕತ್"
    },
    {
      "t": "01:22",
      "text": "ಕೌಟ್ರ"
    },
    {
      "t": "01:24",
      "text": "ಅದ ಹೆಂಗ ಗೊತ್ತಾಯ್ತು"
    },
    {
      "t": "01:26",
      "text": "ಹ ಗೌ"
    },
    {
      "t": "01:28",
      "text": "ನ ಈಸಿಲಿ ಕ್ಯಾಚ್ ಮಾಡ"
    },
    {
      "t": "01:30",
      "text": "ಹೌದು"
    },
    {
      "t": "01:32",
      "text": "ನನ್ಗದು"
    },
    {
      "t": "01:34",
      "text": "ನಾನ ಗ ನ ಗೊತ್ತಾಾಗೋಗುತೆ"
    },
    {
      "t": "01:36",
      "text": "ಈ ತೀಟಿ ಉಮಿ ಚಲ್ಲ"
    },
    {
      "t": "01:38",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ತನೂ"
    },
    {
      "t": "01:40",
      "text": ""
    },
    {
      "t": "01:42",
      "text": "ಯ ಕರೆಕ್ಟ್ ಕೇಳ್್ರಿ ಕೆ"
    },
    {
      "t": "01:44",
      "text": "ಕೃತನೆ"
    },
    {
      "t": "01:46",
      "text": "ಇಲ್ಲ ಎ"
    },
    {
      "t": "01:48",
      "text": "ಚಾನ್ಸಲ್ಲ"
    },
    {
      "t": "01:50",
      "text": "ಚಛಾನ್ಸ ಇಲ್ಲ ನಾವು ಗಡ್"
    },
    {
      "t": "01:52",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:54",
      "text": "ಅದಕ್ಕೇನೆ ಹೇಳ್ತಿರ ನನ್ ಇಷ್ಟೆ ಅಂತ"
    },
    {
      "t": "01:56",
      "text": ""
    },
    {
      "t": "01:58",
      "text": "ಹ"
    },
    {
      "t": "02:00",
      "text": "ಎಪ್ಪ"
    },
    {
      "t": "02:02",
      "text": "ಹ ಎ ಯ"
    },
    {
      "t": "02:04",
      "text": "ಹ"
    },
    {
      "t": "02:06",
      "text": "ಹೇಳುದ ನ ಟೈಮ್ ಬಾಸ್ಗೆ ಅಂತ ಹೇಳಿ"
    },
    {
      "t": "02:08",
      "text": "ಅೇ ಮಾಡಿ ಟೈಸ್ರಲ್ಲ"
    },
    {
      "t": "02:10",
      "text": "ಬರಬ"
    },
    {
      "t": "02:12",
      "text": "ಬೆಂ್ಗಳೂರುಕ"
    },
    {
      "t": "02:14",
      "text": "ಬೆಂಗದಾ ಹೇಳವ ಪಲಡಸ"
    },
    {
      "t": "02:16",
      "text": "ಮೈಸೂರ್ ಬಂದ್ರೆ ಸಿ"
    },
    {
      "t": "02:18",
      "text": "ಇರ್ತೀರಾ ಬತಾನೇ ಹೇಳ್ತೀನಿ ತುಂಬ"
    },
    {
      "t": "02:20",
      "text": "ಹ ಎಲ್ಲಿ"
    },
    {
      "t": "02:22",
      "text": "ಹಾ"
    },
    {
      "t": "02:24",
      "text": "ಎಲ್ಲಿ ಹತ್ತೀರಾ"
    },
    {
      "t": "02:26",
      "text": "ಅಮ್ಮ ನೋಡ ಬರ್ತೀನಿ"
    },
    {
      "t": "02:28",
      "text": "ನೀವುಂತ ಬೇಸರತ"
    },
    {
      "t": "02:30",
      "text": "ಇಲ್ಲ ಅಮ್ಮ"
    },
    {
      "t": "02:32",
      "text": "ಚಾ"
    },
    {
      "t": "02:34",
      "text": ""
    },
    {
      "t": "02:36",
      "text": "ಹ ಮಟ್ಟಕ್ಕೆ"
    },
    {
      "t": "02:38",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:40",
      "text": "ಸಿಗ್ತೀರಾ ಅಂದ್ರೆ ಒಂದ"
    },
    {
      "t": "02:42",
      "text": "ಹಲ್ಲಲ್ಲ"
    },
    {
      "t": "02:44",
      "text": "ಲ್ಲ ಆಗ್ತಾರೆಲ್ಲ ್ರೀ"
    },
    {
      "t": "02:46",
      "text": "ಎಲ್ಲಪಿ ಎಲ್ಲಪಡಿ"
    },
    {
      "t": "02:48",
      "text": "ಮತ್ತ ಇವಾಗ ನ್ ಮನೇಲಿ ಇದ್ರ ಅಥವಾ"
    },
    {
      "t": "02:50",
      "text": "ರೋಡ್ಲ್ಲಿ ಇದ್ದರಾ"
    },
    {
      "t": "02:52",
      "text": "ಾಗಿಂಗ ಮಾತದಕ್ಕೆ"
    },
    {
      "t": "02:54",
      "text": "ಹ ನೀ ನೀನ ಮಲಿಿ"
    },
    {
      "t": "02:56",
      "text": ""
    },
    {
      "t": "02:58",
      "text": "ಸಿಂಗಲ್ಾ"
    },
    {
      "t": "03:00",
      "text": "ಇಲ್ಲ ಟಬ್ಬಲ್"
    },
    {
      "t": "03:02",
      "text": "ಬಿ"
    },
    {
      "t": "03:04",
      "text": "ಷ್ಟ"
    },
    {
      "t": "03:06",
      "text": "ಡ್ಾರಟ್ಟ ಮಾತಾಡಿ"
    },
    {
      "t": "03:08",
      "text": ""
    },
    {
      "t": "03:10",
      "text": "ಗವುೋ"
    },
    {
      "t": "03:12",
      "text": "ಹುಡ್ಗಿ ರಗಡಗಿರದ್ ಬಿಟ್ಟಿ"
    },
    {
      "t": "03:14",
      "text": "ವೀಟ್ಲ ಮೂಡಕಡಯ"
    },
    {
      "t": "03:16",
      "text": "ತು ಯಾರೀ"
    },
    {
      "t": "03:18",
      "text": "ನೀವ"
    },
    {
      "t": "03:20",
      "text": "ೆ ಕರೆಕ್ಟ್ ಹೇಳೇಳು ನಿಜ ಹೇಳಿ ಮಜ"
    },
    {
      "t": "03:22",
      "text": "ತರ್ ಬ ಆನಸ್ಟ್"
