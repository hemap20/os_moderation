    {
      "t": "03:24",
      "text": "ಎಸಿ"
    },
    {
      "t": "03:26",
      "text": "ಬಿಾನ ಗ ಟ ತನ"
    },
    {
      "t": "03:28",
      "text": "ಅಲ್ಲ"
    },
    {
      "t": "03:30",
      "text": "ಹ"
    },
    {
      "t": "03:32",
      "text": "ಯ ನೀನ್ ಎಸ್ಸಿ ಈ ತರ ಕನ್"
    },
    {
      "t": "03:34",
      "text": ""
    },
    {
      "t": "03:36",
      "text": "ತಡ"
    },
    {
      "t": "03:38",
      "text": "ಂದ ಸರಿ"
    },
    {
      "t": "03:40",
      "text": "ಕಥ ಕೆತ್ತಬರು"
    },
    {
      "t": "03:42",
      "text": "ಹೌದಾ ಏನ್ ಗೊತ್ತಾಗುತ್ತೆ"
    },
    {
      "t": "03:44",
      "text": "ಯ ಕರೆಕ್ಟ್ ಹೇಳ ನಿಮ"
    },
    {
      "t": "03:46",
      "text": "ನೀ ನಳೆ ನೀ ನಳೆಗೆೆ ಹಳಪೊಂಡಡ"
    },
    {
      "t": "03:48",
      "text": ""
    },
    {
      "t": "03:50",
      "text": "ನಾಲೆ ಮುಟ್ಕಣ ಹೇಳ್ತಿರೋದೇ"
    },
    {
      "t": "03:52",
      "text": ""
    },
    {
      "t": "03:54",
      "text": "ಎಸ್ ಸಿ ಕರೆಕ್ಟ್ಸಿ"
    },
    {
      "t": "03:56",
      "text": "ಓ ಬ"
    },
    {
      "t": "03:58",
      "text": "ಹೌದು ಇ"
    },
    {
      "t": "04:00",
      "text": ""
    },
    {
      "t": "04:02",
      "text": "ನೀನ್ ತಪ್ಪಿಷ್ಟ"
    },
    {
      "t": "04:04",
      "text": "ಬಿಟ್ಟಿ ಕರೆಕ್ಟ ಮಾತಾಡು"
    },
    {
      "t": "04:06",
      "text": "ಕಪ್ಪತಷ್ಟೇ ಇಲ್ಲ"
    },
    {
      "t": "04:08",
      "text": "ಮಾಡಡ್ತಿದ್ದೀನಿ ಅದನ್ನ ಹೇಳುತ್ತಲ್ಲ"
    },
    {
      "t": "04:10",
      "text": "ಪಸಲ ಕಟ"
    },
    {
      "t": "04:12",
      "text": "ದ"
    },
    {
      "t": "04:14",
      "text": "ಪರ್ಸ್ನ ಕನೆಕ್ಟ್ ಆಗ್ಬೋುದ ಅಂದೆ"
    },
    {
      "t": "04:16",
      "text": "ಅಂದ್ರೆ"
    },
    {
      "t": "04:18",
      "text": "ಇನ್ಷ್ಟಾ"
    },
    {
      "t": "04:20",
      "text": "ವಾಟ್ಸಆಪ್ ನಂಬರ್"
    },
    {
      "t": "04:22",
      "text": "ನ ಬರ್ಕ್ಕ ನಾನೇನ್ ಮಾಡ್ಲಿ"
    },
    {
      "t": "04:24",
      "text": "ನಿಮಸ ಇಟ್ಕೊಂಡು ನೀವ್ ನ್ ಮಾಡ್ತೀವಿ"
    },
    {
      "t": "04:26",
      "text": "ೆ"
    },
    {
      "t": "04:28",
      "text": "ಇಷ್ಟ ಇಟ್ಕೊಂಡು ಏನ್ ಬರ್ತೀನ"
    },
    {
      "t": "04:30",
      "text": ""
    },
    {
      "t": "04:32",
      "text": "ನ"
    },
    {
      "t": "04:34",
      "text": "ಏನು"
    },
    {
      "t": "04:36",
      "text": "ಅಲ್ಲಿ ಇನ್ಷ್ಟ ಯೂಸ್ ಮಾಡ"
    },
    {
      "t": "04:38",
      "text": "ಒೋ"
    },
    {
      "t": "04:40",
      "text": "ತಾಯಿ ದೇವ್ರನ ತ"
    },
    {
      "t": "04:42",
      "text": "ತಲೆ ಮೇಲೆ ಉಡ್ತೀನಿ"
    },
    {
      "t": "04:44",
      "text": "ಸೀರೆಸಗಳ್ತ"
    },
    {
      "t": "04:46",
      "text": "ಬಟ್ಲ್ಲ ಕಾಫಿಡಿ ಮಾಡುತ್ತೆ"
    },
    {
      "t": "04:48",
      "text": "ಇ"
    },
    {
      "t": "04:50",
      "text": "ಮ ಸುಳ್ಳಡ ನೀ"
    },
    {
      "t": "04:52",
      "text": "ಸೀರೆ ಸ ಎ"
    },
    {
      "t": "04:54",
      "text": "ನಿ ಸ"
    },
    {
      "t": "04:56",
      "text": "ಗೋಡ ತಮ್ಮ"
    },
    {
      "t": "04:58",
      "text": "ಆಯ್ತು"
    },
    {
      "t": "05:00",
      "text": "ಹಾಗ ವಾಟ್ಸಪ್"
    },
    {
      "t": "05:02",
      "text": "ಹ್ಮ"
    },
    {
      "t": "05:04",
      "text": "ಮಷಲ್ಲ ಕಡ ನ ಮನ ಪೈತ್"
    },
    {
      "t": "05:06",
      "text": "ಅಲೋ ನೀನ್ಗೇನ್ ಕಾಲ್ ಮಾಡ್ಕ ಹ್ಬೋದು"
    },
    {
      "t": "05:08",
      "text": "ಕೂಡ ಪುರ್ಸ ನನಗೂ ಇಲ್ಲ ನನಗೂ"
    },
    {
      "t": "05:10",
      "text": "ನೀ ನೀ ವೋಗ ಅಷ್ಟ"
    },
    {
      "t": "05:12",
      "text": "ಅಷ್ಟಲ್ಲ ಪ್ರ್ರೀಡ್ ಇಕ್ಕೋ ಕೂಡ"
    },
    {
      "t": "05:14",
      "text": "ಕಾಕೊಂಡು ಕುೂತ್ಕೊಳ್ಳ"
    },
    {
      "t": "05:16",
      "text": "ಬಂದಾಗ ಟೆಕ್ಸ್ಟ್ ಹಾಕ್ತೀನಿ"
    },
    {
      "t": "05:18",
      "text": "್ರೆ ಸಿಗ್ಬಹುದು ನಾರ್ಮಲ್ ಆಗಿ ಇಲ್ಲಾಂದ್ರೆ"
    },
    {
      "t": "05:20",
      "text": "ಬೇಕ ಮೀನ್ ದಾರ ನೀನ್"
    },
    {
      "t": "05:22",
      "text": "ನಂದಾರಿ ನನ್ಗೆ"
    },
    {
      "t": "05:24",
      "text": "ನಮಗೆ ಹಿಂಗೆ ಹುಡುಗಿ"
    },
    {
      "t": "05:26",
      "text": "ಇದ್ದೇ ಬೀಳ್ಬೇಕು ನ ಹಸ"
    },
    {
      "t": "05:28",
      "text": "ನನಗಿಲ್ಲ"
