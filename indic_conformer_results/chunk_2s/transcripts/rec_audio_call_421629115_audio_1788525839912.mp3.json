{
  "file_id": "rec_audio_call_421629115_audio_1788525839912.mp3",
  "language": "kannada",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 592.907,
  "processing_time_sec": 20.161936044692993,
  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲಾವು"
    },
    {
      "t": "00:02",
      "text": "ಹ"
    },
    {
      "t": "00:04",
      "text": "ಆಯ"
    },
    {
      "t": "00:06",
      "text": "ಹ ಇಲ್ಲಿಂದ"
    },
    {
      "t": "00:08",
      "text": "ನಾವು ಕಾಣ್ೋದಂತ ನೀ"
    },
    {
      "t": "00:10",
      "text": "ನೀ ನಾ್ ಬೆಂಗ್ಳೂರು ಏನ್ ಮಾಡ"
    },
    {
      "t": "00:12",
      "text": "ೊಂಡ ಸರ್ ನಾನ್ ಬ್ಯಾಂಗ್ೂ ಬರ್"
    },
    {
      "t": "00:14",
      "text": "ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "00:16",
      "text": "ಹ್ಮ್ ಹ್ಮ್್ ಏನ್ ಮಾಡ್ತ ಇದೀರ ಇನ್ನು ಆಫೀಸಲ್ಲಿ"
    },
    {
      "t": "00:18",
      "text": "ನ್ಸೆ"
    },
    {
      "t": "00:20",
      "text": "ಇನ್ನು ಆಫೀಸ್ ಎಲ್ಲೇ ಇದ್ದೀರನ್ಸುತ್ತ"
    },
    {
      "t": "00:22",
      "text": "ವರ್ಫ್ರ್ ಹ"
    },
    {
      "t": "00:24",
      "text": "ಮತ್ತೆ ಯಾರು"
    },
    {
      "t": "00:26",
      "text": "ನ್ ಸೌಂಡ್ ಎಲ್ಲ ಇಷ್ಟೊಂದು ಕೇಳಿಸ್ತಿದೆ"
    },
    {
      "t": "00:28",
      "text": "ವಿಂಡೋ ಹತ್ರ ಕತಿದನ ಅದಕ್ಕೆ"
    },
    {
      "t": "00:30",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ಮ್ಯಾರಡ್ ಅನ್ಮ್ಯರಿ"
    },
    {
      "t": "00:32",
      "text": "ನೀವೇನ್ ಕಲ್ಲಿದ್ದೀರಾ"
    },
    {
      "t": "00:34",
      "text": "ನಾನು ಇಲ್ಲ ಮನೆಕ್ ಬಂದೆ"
    },
    {
      "t": "00:36",
      "text": "ಹೊರ್ಕಲ್ಲ ಮುಗಿಸಕೊಂಡಿ"
    },
    {
      "t": "00:38",
      "text": "ಏನ್ ಜಾಬ್ು ಏನ್ ಜಾಬ್ ಮಾಡ್ತ"
    },
    {
      "t": "00:40",
      "text": "ಗ್ರಾಫಿಕ್ ಗ್ರಾಫಿಕ್ ಡಿಸೈನರ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "00:42",
      "text": "ಗ್ರಾಫಿಕ್"
    },
    {
      "t": "00:44",
      "text": "ಹ್ಮ ಗ್ರಾಫಕ್"
    },
    {
      "t": "00:46",
      "text": ""
    },
    {
      "t": "00:48",
      "text": "ಹೇಳ ಸ ಎಷ್ಟನ"
    },
    {
      "t": "00:50",
      "text": "ಹ"
    },
    {
      "t": "00:52",
      "text": "ಕೃಪಾ ಕಂಡ್ರೆ ಬರದ್ ನಾನ ಇದಕ್ಕೆ"
    },
    {
      "t": "00:54",
      "text": "ದಾವಕಾರ್ ಮ ಜತ ಇಲ್ಲ ಅ"
    },
    {
      "t": "00:56",
      "text": "ಆರ ಸ ಅಪೂಪಕ್ಕೆ ಬನ್ನಿ ನಾವು ತ್ರೀ ಡೇಸ್"
    },
    {
      "t": "00:58",
      "text": "ಆಾಯ್ತು ಇದ್ರ ಹಬಗ್ಗೆ"
    },
    {
      "t": "01:00",
      "text": "ಕೆಲ್ಸಕ್ಕೆ ಏನಾದ ಪ್ರೆಷರ್ ಇರುತ್ತೆ"
    },
    {
      "t": "01:02",
      "text": "ಬಾಡಿ ರಿಲ್ಯಾಕ್ಸ್ ಆಗಲ್ಲ ಅಲ್ಲ ಅದಕ್ಕೆ"
    },
    {
      "t": "01:04",
      "text": "ಬ"
    },
    {
      "t": "01:06",
      "text": "ಅವ್ರವ್ರ ವರ್ಕ್ ಇರುತ್ತೆ ಸರ್ ಇದು ಹ್ಯಾ ಬಗ್"
    },
    {
      "t": "01:08",
      "text": "ಷ್ಟೊ ಗೊತ್ತರ ಡೇಸ್ ಆಯ್ ನಾ"
    },
    {
      "t": "01:10",
      "text": "ಹಡಿಯೋ ಸ್ಟೋಡಿಯೋ ಟೋಂಗ"
    },
    {
      "t": "01:12",
      "text": "ಯಟಿಸ"
    },
    {
      "t": "01:14",
      "text": "ನವ"
    },
    {
      "t": "01:16",
      "text": "ಲ ಊಟಿ ಸಂತ ಅಂದ"
    },
    {
      "t": "01:18",
      "text": "ಏನ್ಸ"
    },
    {
      "t": "01:20",
      "text": "ಔಟ್ ಈಸ್ ಆಪ್"
    },
    {
      "t": "01:22",
      "text": "ಹ"
    },
    {
      "t": "01:24",
      "text": "ಆ ಆಪ್ ಹೆಂಗಿದೆ"
    },
    {
      "t": "01:26",
      "text": "ಸ ಇಲ್ಲ ಸರ್ ಸ್ಟೋಡಿಯೋ"
    },
    {
      "t": "01:28",
      "text": "ಟಾಪ್ಸ್ ಮಾಡ್ಬೇಕಾದ್ರೆ ಗಲ್ಸ ಮಾಡ್ತಾರೆ ಅಂತ"
    },
    {
      "t": "01:30",
      "text": "ಅನ್ಕೊಂಡೋಗ ಕಲ್ಸಿಲ್ಲ ಜಸ್ಟ್ ಆಡಿಯೋ ಾಕ್ಸ್"
    },
    {
      "t": "01:32",
      "text": "ಫ್ರೆಂಡ್ಲಿ ಟಾಕ್ಸ್ ಅಷ್ಟೇ ನಾಟ್ ವ"
    },
    {
      "t": "01:34",
      "text": "ಡಿಯ ಇಂಡಿಸೆಂಟ್ ಆಗಿ ಮಾತಾಡಿದ್ರೆ"
    },
    {
      "t": "01:36",
      "text": "ಕಾಲ್ ಅವರೇ ಕಟ್ ಮಾಡ್ಬಿಡ್ತಾರೆ"
    },
    {
      "t": "01:38",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ಹ್ಮ್ ಹ್ಮ ಹ್ಮ್ ಇದು ನಮ್ಗೆ ಅವಶ"
    },
    {
      "t": "01:40",
      "text": "ಅವಶಕತೆ ಇಲ್ಲ ಸರ್ ಏನ್ ಸರ್ ಸೋಷಿಯಲ್ ಮೀಡಿಯಾದಲ್ಲಿ"
    },
    {
      "t": "01:42",
      "text": "ಅ ಬಾಯ್ಸ ಒಂಥರ"
    },
    {
      "t": "01:44",
      "text": "ಅಂದ್ರೆ ಇದ್ರ ಬಯಸ್ಗಿಂತ ಗ"
    },
    {
      "t": "01:46",
      "text": "ಕಲ್ಸೆ ಬೋರ್ಡ್ ಆಗಿದ್ದಾರೆ ಅಂತ ಕಶ್ಯ ಕೇಳೆ"
    },
    {
      "t": "01:48",
      "text": "ಪಟ್ಟೆ ತುಂಬಾ ಅ"
    },
    {
      "t": "01:50",
      "text": "ತುಂಬಾ ಇದಾರೆ"
    },
    {
      "t": "01:52",
      "text": "ನಾರ್ಮಲ್ ಟಾಕ್ಸ್ನ್ನೋ"
    },
    {
      "t": "01:54",
      "text": "ಂತ ತುಂಬಾ ಅಂದ್ರೆ ಫಿಸಿಕಲ್ ಸೆಕ್ಸ್"
    },
    {
      "t": "01:56",
      "text": "ಸ್ಟಾಕ್ಸ್ ದಾಸ್ತಿ ಆಪಲ್"
    },
    {
      "t": "01:58",
      "text": "ಇದೇನ್ ಸರ್ ಹಾಕ್ ಮಾಡ್ಕೊಂಡಿರೋ ಸೋಷಲ್ ಮೀಡಿಯ"
    },
    {
      "t": "02:00",
      "text": "ಮಾಡ್ಕೊಬಿಟ್ಟವರು ಇದಾರೆ ಆಂಟಿ ತಿರುರಿಗೆಿ ಜಾತಿ"
    },
    {
      "t": "02:02",
      "text": "ಇತಾರೆ ಅಂತ ಕೇಳ್ಪಟ್ಟೆ"
    },
    {
      "t": "02:04",
      "text": "ೋಗ ಜಾಸ್ತಿ ಇರ್ತಾರೆ ಹುಡುಗಿರು ಇರ್ತಾರೆ"
    },
    {
      "t": "02:06",
      "text": "ವಯಸಟ್ಟ ಇಡ್ತಾರೆ"
    },
    {
      "t": "02:08",
      "text": "ಗಿರಿ ಇರ್ಬಹುದು ಬಟ್ ಅವರು"
    },
    {
      "t": "02:10",
      "text": "ಅದೆಲ್ಲ ಅಲ್ವಸ"
    },
    {
      "t": "02:12",
      "text": "ಅಲ್ಲ ಏನ್ ಗೊತ್ತಾ ಮೆನ್ಸಲ್ಲಿ"
    },
    {
      "t": "02:14",
      "text": "ಇವಾಗ ಕೆಲವೊಂದು ಇವಾಗ ನಿಮ್"
    },
    {
      "t": "02:16",
      "text": "ಮನ್ಸಲ್ಲಿ ಏನೋ ಒಂದು ಮಾತುಗಳಿರುತ್ತೆ"
    },
    {
      "t": "02:18",
      "text": "ಅದು ಫಿಸಿಕಲ್ ಆಗಿರ್ಬೋದು"
    },
    {
      "t": "02:20",
      "text": "ಇಲ್ಲಾ್ರೆ ನಾರ್ಮಲ್ ಟಾಕ್ಸ್ ಏನಾದಿರ್ಬಹುದು"
    },
    {
      "t": "02:22",
      "text": "ಆಚ್ ಕಡೆ ಏಳ್ಕಳಕ"
    },
    {
      "t": "02:24",
      "text": "ಗ ಯಾರ ಜೊತೆನೆ"
    },
    {
      "t": "02:26",
      "text": "ಇದೆಲ್ಲ ಬಂದು್ ಹೇಳ್ಕೊಂಡಿ"
    },
    {
      "t": "02:28",
      "text": "ೇಲ್ ಗೇಟ್"
    },
    {
      "t": "02:30",
      "text": "ಹ ಸರಿ ಏನಂತಾರೆ ಎಂಜಾಯ್ಮೆಂಟ್ ಸಿಗುತ್ತಾ"
    },
    {
      "t": "02:32",
      "text": "ಕಂಫರ್ಟಬಲ್ ಸಿಗುತ್ತ"
    },
    {
      "t": "02:34",
      "text": "ಅವ್ರ ಅವ್ರಗ್ ಸಿಗುತ್ತೆ ಇವ್ರ ಇವ್ರಕ್ ಕೊಡ್ತಾರೆ"
    },
    {
      "t": "02:36",
      "text": "ಹೌದಂಗ ಆಗ"
    },
    {
      "t": "02:38",
      "text": "ಅಂತ ಹಕೊ"
    },
    {
      "t": "02:40",
      "text": "ನಿಮ್ಗೆ ಅದಿ ಅರ್ನಿಂಗ್ ಆಗ"
    },
    {
      "t": "02:42",
      "text": "ನೋ ಎಲ್ಲ ಸ ತ್ರ ಡೇಸ್ ಆಯತು ನನ್ಕ"
    },
    {
      "t": "02:44",
      "text": "ಸಟ ಮಾಡಲ್ಲ ವರ್ಫ್ರ್ೋ್"
    },
    {
      "t": "02:46",
      "text": "ವಕ್ ಇತ್ತೆ"
    },
    {
      "t": "02:48",
      "text": "ಒಂದು ನಿಮ್ದ ಇವಾಗ ಹೋಗ"
    },
    {
      "t": "02:50",
      "text": "ನಿಮ್ಗೆ ಏನ್ ಕರೆನ್ಸಿ ಕಟ್ ಆಗತ್ತಾ"
    },
    {
      "t": "02:52",
      "text": "ಯಾ"
    },
    {
      "t": "02:54",
      "text": "ಅಂದ್ರೆ ನೀವ್ ಎಷ್ಟುಕ್ ಹಾಕ್ಸ್ಕೊಳ್ತೀರಾ"
    },
    {
      "t": "02:56",
      "text": "ಅ ಡಿಫೆನ್ಸ್ ಆಫ್ ಫುಟ್ಟ"
    },
    {
      "t": "02:58",
      "text": "ಇವಾಗ ನೋಡಿ ಇಂಟೆಸ್ಟಿಂಗ ಆ ಕನ್ೂನ್"
    },
    {
      "t": "03:00",
      "text": "ಓದ್ತಿದ್ರೆ ಮಾತಾಡ್ಬೇಕ"
    },
    {
      "t": "03:02",
      "text": "ಅಂತ ಅನ್ಸಿದ್ರೆ ಒಣ್ಣು ಹಾಕತೀರಿ ಮ"
    },
    {
      "t": "03:04",
      "text": "ತಡಬಾರ್ದು ಅಂತ ಅನ್ಸ್ರೆಲ್ಲಿಗೆ ಮುಗಿಬೇಕು"
    },
    {
      "t": "03:06",
      "text": "ಅನ್ಸದ್ರೆ ವಿಜಷ್ಟ"
    },
    {
      "t": "03:08",
      "text": "ಅ ಅವರ ಅವ"
    },
    {
      "t": "03:10",
      "text": "ಎಲ್ಲ ಕೆಲಸ ಬಿಸಿಿ ಇದ್ದಾಗ ಟಾಕ್ ಮಾತಾಡಕ್"
    },
    {
      "t": "03:12",
      "text": "ಹಾಗಲ್ಲ ಕಟ್ ಮಾಡ್ಬಿಟ್ಟಿರ್ತಾರೆ ಇಲ್ಲ ಅವರೇ ಮಾಡ"
    },
    {
      "t": "03:14",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "03:16",
      "text": "ಜಾಸ್ಿಂದ ತುಂಬಾ ಜನಕ್ಕೆ"
    },
    {
      "t": "03:18",
      "text": "ಕೆ ಬೆನಿಫಿಟ್ಸ್ ಗೊತ್ತಾ"
    },
    {
      "t": "03:20",
      "text": "ನಿಫಿಟ್ಸ್ ಯಾರಗ"
    },
    {
      "t": "03:22",
      "text": "ಪರ್ಸಲ್ ನಂಬರ್ ಕುೂರಂತರ"
    },
    {
      "t": "03:24",
      "text": "ನಂಬರ್ ಕೊಟ್ಟಿ ಮೀಟ್ ಆಗಿರೋ ಗಂಟ"
    },
    {
      "t": "03:26",
      "text": "ಇದಾರೆ"
    },
    {
      "t": "03:28",
      "text": "ನಾರ್ಮಲ್ ಆಗ ಇದಲ್ಲೇ ಮಾತಾಡ್ಕೊಂಡ್ ಬಂಟ"
    },
    {
      "t": "03:30",
      "text": "ಇದಾರೆ ಈ ಸೋಷಿಯಲ್ ಮೀಡಿಯಾ ಗಂಟಾಗ ಹೋಗಿದೆ"
    },
    {
      "t": "03:32",
      "text": "ಎಲ್ಲಾ ತರನೂ ಇದ್ದಾರೆ"
    },
    {
      "t": "03:34",
      "text": "ಬಟ್ ರೆಕಾರ್ಡಿಂಗ್ ಇಲ್ಲ ಅಂತ ಅದೊಂದು ಪ್ಲಸ್"
    },
    {
      "t": "03:36",
      "text": "ಂಗ್ ಮಾಡಕ್ ಆಗಲ್ಲ"
    },
    {
      "t": "03:38",
      "text": "ನಾವ್ ಏನ್ ಮಾತಾಡ್ತಿರೋ ನಮಗಷ್ಟೇ ಗೊ"
    },
    {
      "t": "03:40",
      "text": "ಇರುತ್ತೆ ನಾವು ವೀಡಿಯೋ ಕಾಲ್ ಅಲ್ಲಿ ಏನ್ ಮಾಡ"
    },
    {
      "t": "03:42",
      "text": "ಮಾತಾಡ್ತಿರೋ ಏನ್ ತೋರ್ಸುದ್ರು ಕೂಡ ಇದಲ್ಲಿ"
    },
    {
      "t": "03:44",
      "text": "ರೆಕಾರ್ಡ್ ಆಗಲ್ಲ"
    },
    {
      "t": "03:46",
      "text": "ಯಾವದೇ ತರ ಫೆಸಿಲಿಟಿ ಇಲ್ಲ"
    },
    {
      "t": "03:48",
      "text": "ಲ್ ಸೇಫ್ಟಿ್ರೆ"
    },
    {
      "t": "03:50",
      "text": "್ಮ ಅ ಸ್ಕ"
    },
    {
      "t": "03:52",
      "text": "ಕುುಲ್ ಮಕ್ಳಗ್ ಬಂದಿದ್ದಾರಂತೆ"
    },
    {
      "t": "03:54",
      "text": "ಹ್ಮ್ ಸ್ಕೂಲ್ ಮಕ್ಳ"
    },
    {
      "t": "03:56",
      "text": "ಹೇಳ ದ ಇಲ್ಲ ಸ್ಕೂಲ್"
    },
    {
      "t": "03:58",
      "text": "ಕುರುಪಟವರಕ್ಕ ಅಂತ"
    },
    {
      "t": "04:00",
      "text": "ಎಷ್ಟು ವರ್ಷ ಇರೋರು ಬೇಕಾದಾರರು ಬರ್ತಾರ್ ಕಂಡು"
    },
    {
      "t": "04:02",
      "text": "ಅವ್ರ ಅವ್ರ ಪರ್ಸ"
    },
    {
      "t": "04:04",
      "text": "ನ್ ಮಾಡ್ರ ಏ ನ್ ಮಾಡ್ಕೊಂಡ ತಿಂಡಿಗಳು ತಗೊೊಂಡ"
    },
    {
      "t": "04:06",
      "text": "ಹುಡುಗಿರ್ರಿಗೆ ಹತ್ರ ತಗೊಂತಾರೆ"
    },
    {
      "t": "04:08",
      "text": "ಹ್ಮ್ ಅದು ಒಂದ್ಿನ ಸಾವಿರಾಯ"
    },
    {
      "t": "04:10",
      "text": "ಮಾಡ್ಬೋುದು್ಮ"
    },
    {
      "t": "04:12",
      "text": "ಹ ಆರಾಮಾಗಿ ಮಾಡ್ಬೋದು ಕುೂತ್ಕೊಂಡೆ"
    },
    {
      "t": "04:14",
      "text": "ಹೆಂಗೆ ಹಾಗಗಾದ ಸಾವಿರ ರೂಪಾಯಿ ಅಂತೆ"
    },
    {
      "t": "04:16",
      "text": "ಏನ್ ಗೊತ್ತಾ"
    },
    {
      "t": "04:18",
      "text": "ಇದಲ್ಲಿ ಸಾವಿರ"
    },
    {
      "t": "04:20",
      "text": "ರಪಾಯ ಮಾಡೋ ಎಡ್ ಸಾವಿ ರಪಾಯಿ ಮಾಡೋರು ಮೂರು ಸಾವಿರ"
    },
    {
      "t": "04:22",
      "text": "ರಪಾಯಿ ಮಾಡೋ್ ಬರೀ ಸಕ್ಸ್ ಬಗ್ಗೆೇನೆ ಮಾತಾಡೋರು"
    },
    {
      "t": "04:24",
      "text": "ಹಯ ಅದೆ ಆ ತರ ಮಾ"
    },
    {
      "t": "04:26",
      "text": "ತಡ್ಕೊಂಡು ಹೋದ್ರೆ ಲರ್ನಿಂಗ್ಲಸ್್ಲಸ್"
    },
    {
      "t": "04:28",
      "text": "ಆಗ್ತಾ ಇರತ್ತೆ ಅಲ್ವಾೇ"
    },
    {
      "t": "04:30",
      "text": "ಏನ್ ಗೊತ್ತಾ ಇವಾಗ ನಾವು"
    },
    {
      "t": "04:32",
      "text": "ಬೇರೆಯವ್ರ ಜೊತೆ ಹೋಗಿ ಮಲಗದ ಹೆಂಗ ಇಿದೆ ಇದ"
    },
    {
      "t": "04:34",
      "text": "ಮಾತಾಡ್ಬಿಟ್ಟು ನಾವು ಅವ್ರಿಗೂ ಖುಷಿ ತರಿಸಿ"
    },
    {
      "t": "04:36",
      "text": "ನಮಗೂ ಖುಷಿ ತಗೊಂಡಿ ಅರ್ನಿಂಗ್ ಮಾಡ"
    },
    {
      "t": "04:38",
      "text": "ಡಂಗಿದೆ"
    },
    {
      "t": "04:40",
      "text": "ಹ್ಮ್ ಹೌದು"
    },
    {
      "t": "04:42",
      "text": "ಇವಾಗ ನೀ ಹೇಳ್ತೀರಾ ಡಸೆಂಟ್ ಹಾಕ್ಸು"
    },
    {
      "t": "04:44",
      "text": "ಅದು ತಾಕ್ಸ ಇದು ತಾಕ್ಸ ಅಂತ ಕೆಲವೊಬ್ಬರು"
    },
    {
      "t": "04:46",
      "text": "ನ ರೊಮಟಿಕ"
    },
    {
      "t": "04:48",
      "text": "ಮಾತಾಡೋದಕ್ಕೋಸ್ಕರನೇ ಬರೋರು ಅವ್ರ"
    },
    {
      "t": "04:50",
      "text": "ಪರ್ಸನ್ ಅವ್ರು ಮಾತಾಡ್ಕೋತಾರೆ ಬೇಡ"
    },
    {
      "t": "04:52",
      "text": "ಬರೀ ಸೋಷಲ್ ಸೊಸೈಟಿ ಬಗ್ಗೆ ಹ"
    },
    {
      "t": "04:54",
      "text": "ಹೇಗ್ ತಿಳ್ಕೊಬೇಕು ಅನ್ನೋ ಮಾತಾಡೋ್ರು ಅದು"
    },
    {
      "t": "04:56",
      "text": "ಹಗ ಏನ್ ನಡೀತದೆ ಅನ್ನ ಕೇಳ್ಕೊಂಡೆ"
    },
    {
      "t": "04:58",
      "text": "ಮಾತಾಡ್ಬೋಡಿ ಏನ್ ನಡೀ"
    },
    {
      "t": "05:00",
      "text": "ಈಗ ಗೊತ್ತಾಯ್ತ ಯಾ ದೈವಸ್ೂ"
    },
    {
      "t": "05:02",
      "text": "ಜಾಸ್ತಿ ಆಗ್ತದೆ ಅ ಈಗದ ಹುಡುಗರೆ ಸಕ"
    },
    {
      "t": "05:04",
      "text": "ಹೊರಡ್ೋಗಿದ್ದಾರೆ ಹ್ಮ"
    },
    {
      "t": "05:06",
      "text": "ಹ್ಮ್ ಸುಡುಗರು ಎ"
    },
    {
      "t": "05:08",
      "text": "ಕುಂತವರು ಮದ್ವೆ ಅದಕ್ಕೆ"
    },
    {
      "t": "05:10",
      "text": "ಏನ್ ಮಾಡಕ್ ಆಗಲ್ಲ ಕನ್್ರಿ ನೀವ"
    },
    {
      "t": "05:12",
      "text": "ಒಬ್ಬ್ ಯಾರು ಒರ"
    },
    {
      "t": "05:14",
      "text": "ನಮ್ ರರುಮಲ್ಾಿ ಮುಚ್ಚದಿದ್ರೆ"
    },
    {
      "t": "05:16",
      "text": "ಸಾಕು ಮಾಡೇಡಮ ಮುಂಚೆ"
    },
    {
      "t": "05:18",
      "text": "ಹ್ಮ್ ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "05:20",
      "text": "ಹ ಗೊತ್ತಾಗ್ಲೇ ಇಲ್ಲಲ್ಲ"
    },
    {
      "t": "05:22",
      "text": "ಅಲ್ಲ ನೀವು ಮ್ಯಾರಿಡ್ಾ ಅಂದೆ"
    },
    {
      "t": "05:24",
      "text": "ಇಲ್ಲ ಸರ್ ನನ್ ಹೇಗ್ ಬೇಕೋ ಹಾಗಿದೆ"
    },
    {
      "t": "05:26",
      "text": "ಬ್ಯಾಂಕರ್ ವರ್ಕ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ ನಮಗೂ ಸೋಷಿಯಲ್"
    },
    {
      "t": "05:28",
      "text": "ಮೀಡಾ ಅಂದ್ರ ಭಯ ಯಾಕಂದೆಫೋನಲ್ಲಿ ಒಬ್್ರ ಜೊತೆ"
    },
    {
      "t": "05:30",
      "text": "ಹುಡುಗರ ಜೊತೆ ಮಾತಾಡಕಕ್ಕೆ ಎದರ್ಕೊಳ್ಳೋರು"
    },
    {
      "t": "05:32",
      "text": "ನೋಡೋಣ ಕೆಲ್ಸದ ಇದೇನ್ ಹ"
    },
    {
      "t": "05:34",
      "text": "ನ ಅಂತ ಬಂದಾಗ ಅವ್ ಶೇರ್ ಮಾಡ್ತಾರೆ ನ"
    },
    {
      "t": "05:36",
      "text": "ಅವರೆಲ್ಲಾ ಶೇರ್ ಮಾಡ್ತಿದ್ರು ಮೇಡಮ್ ಅಂಗ"
    },
    {
      "t": "05:38",
      "text": "ಒಟ್ಟಿಗ ಅ ಕೇಳಸಕೊತಾ ಇದೀನಿ"
    },
    {
      "t": "05:40",
      "text": "ನ್ಾಗಿಂತ ಕೆಲವುುದು ಸ"
    },
    {
      "t": "05:42",
      "text": "ವಿಷಯಗಳು ಕೇಳ್ಪಟ್ಟೆ ಅಂದ್ರೆ"
    },
    {
      "t": "05:44",
      "text": "ಗೊತ್ತಿನ ತ"
    },
    {
      "t": "05:46",
      "text": "ತ್ತು"
    },
    {
      "t": "05:48",
      "text": "ಇಷ್ಟೊಂದು ಒಳ್ಳೆಯರಾಗಿರಕ"
    },
    {
      "t": "05:50",
      "text": "ಬಡಿ ಒಳ್ಳೇದಕ್ಕೆ ಶಾಲ ಎಲ್ಲ ಈ ಜಾಲದಲ್ಲಿ"
    },
    {
      "t": "05:52",
      "text": "ರ್ ನಾನ್ ವೀಡಿಯೋ ಟಾಕ್ ಶೋ ಪರ್ಸನ್"
    },
    {
      "t": "05:54",
      "text": "ಅದೆ ಕಂಸಿನ ಮಾತ್ ಕೊಡೋದು ನಮ್ಗೆ"
    },
    {
      "t": "05:56",
      "text": "ಬೇಕಾಗ ಅವಶ್ಯಕತೆ ನೂ ಇಲ್ಲ ಅಲ್ವಾ"
    },
    {
      "t": "05:58",
      "text": "ಅೀ ಅಪ್ಪಾ ದೇವ್ರೇ"
    },
    {
      "t": "06:00",
      "text": "ನೀವು ಪರ್ಸನಲ್ ನಂಬರ್ ಯಾರು ಬಂದ"
    },
    {
      "t": "06:02",
      "text": "ಕೇಳಲ್ಲ ಕೊಡಿ ಅಂತಾನ ಈ"
    },
    {
      "t": "06:04",
      "text": "ಪರ್ಸನಲ್ ಆಗಿ ಇನ್ಸ್ಟಾ ಕೊಡಿ ವಾಟ್ಸ್ಪ್"
    },
    {
      "t": "06:06",
      "text": "ಕೊಡಿ ಸ್ನಾಪ್ ಕೊಡಿ"
    },
    {
      "t": "06:08",
      "text": "ಯಾರು"
    },
    {
      "t": "06:10",
      "text": "ಆಲ್ಮೋಸ್ಟ್ ಈ ಇದಲ್ಲಿ ಯೂಸ್ ಮಾಡೋರು ಯಾರು ಕೇಳ"
    },
    {
      "t": "06:12",
      "text": "ಹೇಳಲ್ಲ ಇದಲ್ಲಿ ಏನು"
    },
    {
      "t": "06:14",
      "text": "ಇದಲ್ಲಿ ನೀವು್ ಚೆನ್ನ್ ಮಾತಾಡ್ತೀರಾ ನಿಮ್"
    },
    {
      "t": "06:16",
      "text": "ಆಗೆ ನೀವು ಚೆನ್ನಾಗಿರ್ತೀರ ನಾವು"
    },
    {
      "t": "06:18",
      "text": "ಚೆನ್ನಾಗಿರ್ತೀರ ಅನ್ನೋದೇ ಅಷ್ಟೇ ಆಪ್"
    },
    {
      "t": "06:20",
      "text": "ಹೌದು ಇಲ್ಲಲ್ಲ ಗೊತ್ತ"
    },
    {
      "t": "06:22",
      "text": "ಇದರ ವಿಷಯ ಕೇಳ ಸ್ವಲ್ಪ ಈ ವಿಷಯದಲ್ಲಿ ತಿಳ್ಕೊಂಡಿ"
    },
    {
      "t": "06:24",
      "text": "ಆಪ್ಪಲ್ಲಿ ನಿಜ"
    },
    {
      "t": "06:26",
      "text": "ನಿಮ ನಿಮಗೆ ಸೆಕ್ಸ್ ಬ"
    },
    {
      "t": "06:28",
      "text": "ಏನ್ ಗೊತ್ತಿಲ್ಲವೋ ಎಲ್ಲರೂ ತಿಳಿಸ ಕೊಡ್ತಾರೆ"
    },
    {
      "t": "06:30",
      "text": "ನಾವೇನ್ ಕೇಳದೇ ಇಲ್ವಲ್ಲ ಅ್ರ"
    },
    {
      "t": "06:32",
      "text": "ಾಗ ನಾವ ಯಕ್ೇಬೇಕು ಅವ್ರು ಯಾ"
    },
    {
      "t": "06:34",
      "text": "ಕಲ್ಲ ಆಟಾ ಮಟ್ಟೆ ಕಟ್ಟಾ ಕದು"
    },
    {
      "t": "06:36",
      "text": "ಯಾ"
    },
    {
      "t": "06:38",
      "text": "ನನ್ನ ಫೋನ್ ಮಾಡಿದ್ರ ಬ ರೊಮ್ಯಾಂಟಕ್ ಮಾತಾಡಣ"
    },
    {
      "t": "06:40",
      "text": "ನಂದಷ್ಟಟ್ಟೊ್ಬಟ್ಟೆ ಕಾಲ್ ಕಟ್ ಆಗುತ್ತದು"
    },
    {
      "t": "06:42",
      "text": "ಯಾರು ಈ ಆಪಲ್ಲಾ"
    },
    {
      "t": "06:44",
      "text": "ಹೌ"
    },
    {
      "t": "06:46",
      "text": "ನನ್ ಪ್ರಕಾರ ನನ್ಗ್ ಮಾತ್ರ ಇಲ್ಲ"
    },
    {
      "t": "06:48",
      "text": "ನಾನು ಮೇಡಮ್ ಮಾತಾಡ್ತೀರಾ ಅಂತ ಹೇಳ"
    },
    {
      "t": "06:50",
      "text": "ಇಲ್ಲ ಸರ್ ನಾವು ಬರೀ ಫ್ರೆಂಡ್ಲಿ"
    },
    {
      "t": "06:52",
      "text": "ಜಸ್ಟ್"
    },
    {
      "t": "06:54",
      "text": "ಕಟ್ಟಾಗಲ್ಲ ಅವರೇ ಕೊಟ್ ಮಾಡದು"
    },
    {
      "t": "06:56",
      "text": "ಮಾಡ್ತಾರೆ ಅದೇ ಬೇಡ ಅಂದ್ರೆ ದ ಕಟ್ಟಟ್"
    },
    {
      "t": "06:58",
      "text": "ಮಾಡ್ತಾರ ಮಾಡ್ಕೊಂಡ್ ಹೋಗ್ಲಿ ಬಿಡಿ"
    },
    {
      "t": "07:00",
      "text": "ಹ್ಞ ಅವವಶ್ಯಕತೆ"
    },
    {
      "t": "07:02",
      "text": "ಅ್ರೆ ಬೇರೆಯವ್ರ ಕಾಲ್ ಮಾಡ್ಲಿ ಅಷ್ಟೇ"
    },
    {
      "t": "07:04",
      "text": "ಹ ಏನ್ ಅಲ್ಲ ಗೊತ್ತಿಲ್ಲ"
    },
    {
      "t": "07:06",
      "text": "ಎಲ್ಲ ಗೊತ್ತಿಲ್ಲ ಈ ಹುಡುಗರ್ಗ ಅದೇ ಕೆಲ್ಸನ"
    },
    {
      "t": "07:08",
      "text": "ನೀ"
    },
    {
      "t": "07:10",
      "text": "ೀ ಹುಡುಗುರು ಅಂತ ಹೇಳಕ್ ಹೋಗಬೇಡಿ"
    },
    {
      "t": "07:12",
      "text": "್ ಎಕ್"
    },
    {
      "t": "07:14",
      "text": "ನನಗೆ ಎಲ್ಲಾ ಪ ಚೆನ್ನಾಗಿದೆ ನಾನು ಇದಲ್ಲಿೆಲ್ಲಾ"
    },
    {
      "t": "07:16",
      "text": "ಮಾತಾಡರ"
    },
    {
      "t": "07:18",
      "text": "್ಮ ಇಶಿನ ಚಾಪಕೊಂಡ"
    },
    {
      "t": "07:20",
      "text": "ಪೂರಿ"
    },
    {
      "t": "07:22",
      "text": "ರೀೆಂಟ್ ಆ ನಾ ಹಾಕಿದ್ದ ಒ ಮಂತ್ ಇಬೋೇ ಅಷ್ಟೆ"
    },
    {
      "t": "07:24",
      "text": "ಒಂದು"
    },
    {
      "t": "07:26",
      "text": "ಮಂತ್ಲಿ ಇದು ಸಿಕ್ಸ್ ೈಮ ಸೆವೆನ್ ೈಮ್ ಆನ್ಲೈನ್"
    },
    {
      "t": "07:28",
      "text": "ತ್ತರತ್ ನ"
    },
    {
      "t": "07:30",
      "text": "ನಂದೇನಿದು ಸೆವೆನ್ ಕೋಲ್ಸ್ ಅನ್ಸುತ್ತ"
    },
    {
      "t": "07:32",
      "text": "ಅದು ಟ ಮಿನಿಟ್ ಟ ಮಿಸ್ ಎಲ್ಲ ಆಟೋಮೇಿಕ್"
    },
    {
      "t": "07:34",
      "text": "ಹ್ಮ ಹ್ಮ್"
    },
    {
      "t": "07:36",
      "text": "ನೀವು್ ಮಾತಾಡಿರಲ್ ಚೆನ್ನಾಗಿ ಅದಕ್ಕೆೇ"
    },
    {
      "t": "07:38",
      "text": "ತ್ ಮಾಡಿಡ್ತಾರೆ"
    },
    {
      "t": "07:40",
      "text": "ನಾವ್ ಏನ್ ಬೇಡ ಇವ್ರ ಹತ್ರ"
    },
    {
      "t": "07:42",
      "text": "ಮದ ನಾನೇ ಬೇಿಸಸ್ಕಬೇಕ ಅ ಅವ್ರೇ ಕಟ್"
    },
    {
      "t": "07:44",
      "text": "ಇಸ್ಕಳದ ಅಂತೆ ಎಲ್ಲ ಅಂಕಲ್ ಗಳು ಫೋನ್ ಮಾಡ"
    },
    {
      "t": "07:46",
      "text": "ಹೇಳ್ತೆ ಡಾಕ್ಟರ್ಸ್ ಮಾಡಿದ್ದಾರೆಾರೆಪ್ಪೌನ್ ನನ್ಗೆ"
    },
    {
      "t": "07:48",
      "text": "ಹ ಮೇಡಮ್ ಏನ ಸರ್ ನೀವ್ ಯ"
    },
    {
      "t": "07:50",
      "text": "ಸರ್ ಡಾಕ್ಟ್ರಾಗ ಫೋನ್ ಮಾಡ್ತೀರ ಅಂದ್ರ ಇಲ್ಲ"
    },
    {
      "t": "07:52",
      "text": "ಫ್ರೀಯಾಗಿ ಕ ಕುತಿರ್ತಿ ಮಾಡ್ತೀವಿ ಅಂತಾರೆ"
    },
    {
      "t": "07:54",
      "text": "ಬಸ್ ಡ್ರೈವರ್ ಮಾಡಿದ್ದಾರೆ"
    },
    {
      "t": "07:56",
      "text": "ಹ್ಮ್ ಬಿಟಿ ಎಷ್ಟು"
    },
    {
      "t": "07:58",
      "text": "ಡ್ರೈವರ್ಸ ಮಾಡಿದ್ದಾರೆ"
    },
    {
      "t": "08:00",
      "text": "ಹ್ಮ ಮೇಡಸರ್ ನೀವು್ ಎಲ್ಲಿಂದ ಯಾವ"
    },
    {
      "t": "08:02",
      "text": "ಅವ್ರಗ್ ಹೋಗತೀರ ಸರ್ ಫೋ ಅಲ್ ಮಾತಡ್ಕೊಂಡೇ ಹಯತ"
    },
    {
      "t": "08:04",
      "text": "ಸರ್ ಗುದ್ಗಿದ್ದಿದ್ರೆ ಏನ್ ಸರ್ ಅಂದ್ರೆ"
    },
    {
      "t": "08:06",
      "text": "ಹ ಇಲ್ಲ ಮಚಾರ್ ಕರೆಕ್ಟ ಆಗ ಓಿಸ್ತಾ ಇದೀನಿ"
    },
    {
      "t": "08:08",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "08:10",
