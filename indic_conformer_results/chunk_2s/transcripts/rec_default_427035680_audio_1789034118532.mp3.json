    {
      "t": "01:58",
      "text": "ആല്ലോ"
    },
    {
      "t": "02:00",
      "text": "തമാരുടൊയവരൊക്കെ"
    },
    {
      "t": "02:02",
      "text": "ന്ന സകടു മാരിഡ് ആയ"
