    {
      "t": "01:12",
      "text": "ആഹം"
    },
    {
      "t": "01:14",
      "text": "ഉ ആഹ"
    },
    {
      "t": "01:16",
      "text": "ഇയാൾ എന്താ ചെയ്യുന്നത്"
