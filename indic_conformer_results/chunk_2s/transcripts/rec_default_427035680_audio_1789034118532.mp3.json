    },
    {
      "t": "00:06",
      "text": "നടടന്ന"
    },
    {
      "t": "00:08",
      "text": "വടാ സ്ഥലം"
    },
    {
      "t": "00:10",
      "text": "എന്തൗ"
    },
    {
      "t": "00:12",
      "text": "എന്ത ഉടെ"
    },
    {
      "t": "00:14",
      "text": "ഞാന എവിടൂര്"
    },
    {
      "t": "00:16",
      "text": "ആ കൊന്ത ചെയന്ന"
    },
    {
      "t": "00:18",
      "text": "സയി സണ"
    },
    {
      "t": "00:20",
      "text": "എത്ര വയസുണ്ട്"
    },
    {
      "t": "00:22",
      "text": "ട്വൻറ്റി സവൻ"
    },
    {
      "t": "00:24",
      "text": "അസല എന്തയാണ്"
    },
    {
      "t": "00:26",
      "text": "എന്താടോ കേട്ടില്ല"
    },
    {
      "t": "00:28",
      "text": "അസ്ല എന്താ ചെയ്യുന്നേ"
    },
    {
      "t": "00:30",
      "text": "ചേട്ടൻ നാട്ടിലില്ല"
    },
    {
      "t": "00:32",
      "text": "പറ്റേക്കള്ള"
    },
    {
      "t": "00:34",
      "text": "ഉം അച്ഛന വേണ്ട"
    },
    {
      "t": "00:36",
      "text": "പിന്നെ ഞാൻ"
    },
    {
      "t": "00:38",
      "text": "ഞനൻ വെളിയി ആായിയിരുന്നു ഇല്ലേ പിന്നെ വന്ന"
    },
    {
      "t": "00:40",
      "text": "ഓക്കെ എവിടെ"
    },
    {
      "t": "00:42",
      "text": "പോയിട്ട്"
    },
    {
      "t": "00:44",
      "text": "എന്താ ചെയന്നെ"
    },
    {
      "t": "00:46",
      "text": "ആക്ക സു ആക്കർ"
    },
    {
      "t": "00:48",
      "text": "ആപ്പ കു"
    },
    {
      "t": "00:50",
      "text": "ഒരു"
    },
    {
      "t": "00:52",
      "text": "മന ആമസ ഇ"
    },
    {
      "t": "00:54",
      "text": "കറ പിന്നോടട"
    },
    {
      "t": "00:56",
      "text": "ന"
    },
    {
      "t": "00:58",
      "text": "കുഴപ്പൊന്നും ഇല്ല"
    },
    {
      "t": "01:00",
      "text": "എടക്ക എടക്കറങ്ങ"
    },
    {
      "t": "01:02",
      "text": "ഉ കൊള്ള അടില്ല നല്ല"
    },
    {
      "t": "01:04",
      "text": "ഉ കൊ"
    },
    {
      "t": "01:06",
      "text": "അടിപൊളിയണല്ലോന്ന് പറഞ്ഞ"
    },
    {
      "t": "01:08",
      "text": "ഇന ദ അപ്പത്തക്കരന്നന"
    },
    {
      "t": "01:10",
      "text": "അല്ലെ അതല്ലേ കണ അടിപൊളിയ"
