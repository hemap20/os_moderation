    },
    {
      "t": "00:12",
      "text": "ക്കേ എന്ത് ചെയ്യമാം"
    },
    {
      "t": "00:14",
      "text": "ഞാന മുത്ത"
    },
    {
      "t": "00:16",
      "text": "വക്ക് ചെയ്യൻ ഉണ്ടായിരുന്നു"
    },
    {
      "t": "00:18",
      "text": "അ ഒന്നും ചെയ്യുന്നില്ല"
    },
    {
      "t": "00:20",
      "text": "ഓക്കെ ഒങ്ങിയക്കാണല്ലോ"
    },
    {
      "t": "00:22",
      "text": "രാത്രി ഉറപ്പള്ള"
    },
    {
      "t": "00:24",
      "text": "ഞ ആ രല്ല പ"
    },
    {
      "t": "00:26",
      "text": "ഇത് ഞാൻ ഇന്നാൽ രാവിലെ"
    },
    {
      "t": "00:28",
      "text": "സോറി ഇന്നലെെട്ടഴി"
    },
    {
      "t": "00:30",
      "text": "ക്ക"
    },
    {
      "t": "00:32",
      "text": ""
    },
    {
      "t": "00:34",
      "text": "ഇല്ലെന്താ പരിപാടി ഉറങ്ങാതരുന്നു"
    },
    {
      "t": "00:36",
      "text": "എനിക്ക് രാവിലെ കുറച്ച് പൈസ"
