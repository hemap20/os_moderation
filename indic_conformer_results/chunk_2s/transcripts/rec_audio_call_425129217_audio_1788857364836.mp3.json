{
  "file_id": "rec_audio_call_425129217_audio_1788857364836.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "decoding": "ctc",
  "audio_duration_sec": 477.331,
  "processing_time_sec": 22.819818019866943,
  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "ஹலோ"
    },
    {
      "t": "00:04",
      "text": "சொல்லுங்க"
    },
    {
      "t": "00:06",
      "text": "உம் சொன்னீங்க"
    },
    {
      "t": "00:08",
      "text": "எங்க இருந்து பேச"
    },
    {
      "t": "00:10",
      "text": "ஆஹ் கோயம்புத்தூர்"
    },
    {
      "t": "00:12",
      "text": "கோயம்பு தரா"
    },
    {
      "t": "00:14",
      "text": "ஆமா நீங்க"
    },
    {
      "t": "00:16",
      "text": "என் தூத்தபடிங்க"
    },
    {
      "t": "00:18",
      "text": "சரி சரி சிங்கிளா மேரடா"
    },
    {
      "t": "00:20",
      "text": "சிங்கல் தங்க"
    },
    {
      "t": "00:22",
      "text": "சரி சரி"
    },
    {
      "t": "00:24",
      "text": "சபேஷா"
    },
    {
      "t": "00:26",
      "text": "உம் சாப்பிட்டாச்சுங்க நீங்க"
    },
    {
      "t": "00:28",
      "text": "உம் சாப்பிட்டு பேரு"
    },
    {
      "t": "00:30",
      "text": "மதங்க"
    },
    {
      "t": "00:32",
      "text": "சரி ச வயசு"
    },
    {
      "t": "00:34",
      "text": "ரஜிமன"
    },
    {
      "t": "00:36",
      "text": "இருபத்தி மூணா"
    },
    {
      "t": "00:38",
      "text": "ஆமாங்க"
    },
    {
      "t": "00:40",
      "text": "சரி சரி என்ன"
    },
    {
      "t": "00:42",
      "text": "வே ப ச"
    },
    {
      "t": "00:44",
      "text": "ஆஐஸ்கிரீம் கம்பன"
    },
    {
      "t": "00:46",
      "text": "ம் சரி சரி"
    },
    {
      "t": "00:48",
      "text": "உம்"
    },
    {
      "t": "00:50",
      "text": "சொல்ல"
    },
    {
      "t": "00:52",
      "text": "உம் சொல்லு"
    },
    {
      "t": "00:54",
      "text": "சொல்லணும்"
    },
    {
      "t": "00:56",
      "text": "அல்ல"
    },
    {
      "t": "00:58",
      "text": "வயசை கட்டு வயச கட்டு கட் பிட்டு போயறாங்க"
    },
    {
      "t": "01:00",
      "text": "உம்"
    },
    {
      "t": "01:02",
      "text": "அயச்ச கேட்டு கடண்ணிட்டு போயிடுறாங்களா"
    },
    {
      "t": "01:04",
      "text": "ஆஹ் ஆ ப"
    },
    {
      "t": "01:06",
      "text": "தெரியல எதுக்கு"
    },
    {
      "t": "01:08",
      "text": "உம்ம் நீ"
    },
    {
      "t": "01:10",
      "text": "ரொம்ப சின்ன பையன் எாம் இந்த ஆப்புப்ல வந்தா அவரு க"
    },
    {
      "t": "01:12",
      "text": "அப்படி தானே போவாங்க"
    },
    {
      "t": "01:14",
      "text": "அ என்ன"
    },
    {
      "t": "01:16",
      "text": "ஆஹ்"
    },
    {
      "t": "01:18",
      "text": "அது என்னம உண்மை தாங்க"
    },
    {
      "t": "01:20",
      "text": "உம் உம்"
    },
    {
      "t": "01:22",
      "text": "சொல்லுங்க அவங்க"
    },
    {
      "t": "01:24",
      "text": "ரைஸ் ஏத்த இத தான் பேச முடியும்"
    },
    {
      "t": "01:26",
      "text": "உங்ககிட்ட பேச முடியதுல"
    },
    {
      "t": "01:28",
      "text": "ஏன் பேச முடியாது இப்ப"
    },
    {
      "t": "01:30",
      "text": "பேசனா பேசுதான் செய் போறோம்"
    },
    {
      "t": "01:32",
      "text": "உம் உம் தெ வயச"
    },
    {
      "t": "01:34",
      "text": "சொல்ீங்களா"
    },
    {
      "t": "01:36",
      "text": "உஹம்"
    },
    {
      "t": "01:38",
      "text": "ஹ"
    },
    {
      "t": "01:40",
      "text": "அதான்"
    },
    {
      "t": "01:42",
      "text": "நான் வேறந்தே"
    },
    {
      "t": "01:44",
      "text": "ரெண்டு குழந்தை இருக்கு எனக்கு வசமா"
    },
    {
      "t": "01:46",
      "text": "உக்கதுே அதுமா"
    },
    {
      "t": "01:48",
      "text": "ஓகேங்க"
    },
    {
      "t": "01:50",
      "text": "உஹம் உம்"
    },
    {
      "t": "01:52",
      "text": "நீங்க என்னந்த பேசுவ"
    },
    {
      "t": "01:54",
      "text": "பண்றீங்க உம்"
    },
    {
      "t": "01:56",
      "text": "நான் தனியா இருக்குன்னு யூஸ் பண்ணேன்"
    },
    {
      "t": "01:58",
      "text": "நீங்க எது கேஸ் பண்றீங்கன்னு கேட்டன்"
    },
    {
      "t": "02:00",
      "text": "நான் சும்மா போர் அடிக்குத"
    },
    {
      "t": "02:02",
      "text": "உஹம் காய"
    },
    {
      "t": "02:04",
      "text": "வரும் பேசினா ஏதாவது சும்மாட்ட"
    },
    {
      "t": "02:06",
      "text": "ம் கிடைக்குமா பேசனா"
    },
    {
      "t": "02:08",
      "text": "சரிங்க சரிங்க"
    },
    {
      "t": "02:10",
      "text": "உம்"
    },
    {
      "t": "02:12",
      "text": "உம்"
    },
    {
      "t": "02:14",
      "text": "நல்லா பேசுறாங்களா"
    },
    {
      "t": "02:16",
      "text": "உம் அததான் நல்லா பேசன்"
    },
    {
      "t": "02:18",
      "text": "நான் போய் எனக்கு"
    },
    {
      "t": "02:20",
      "text": "புிடிக்கதல பிரச்சினது"
    },
    {
      "t": "02:22",
      "text": "புரியல எனக்கு புரிய"
    },
    {
      "t": "02:24",
      "text": "படிக்கிறது கட பண்ணிடுவேன் நார்மல பேசா பேச"
    },
    {
      "t": "02:26",
      "text": "செக்ஸா பேசா கட் பண்ணி"
    },
    {
      "t": "02:28",
      "text": "ஓ சரிங்க சரிங்க"
    },
    {
      "t": "02:30",
      "text": "உனக்கு எப்படி"
    },
    {
      "t": "02:32",
      "text": "எக்ஸா பேசணுமோ"
    },
    {
      "t": "02:34",
      "text": "ச"
    },
    {
      "t": "02:36",
      "text": "ஆான் அம பேசினாலே போகுதும்"
    },
    {
      "t": "02:38",
      "text": "உஹம்"
    },
    {
      "t": "02:40",
      "text": "ஹம்"
    },
    {
      "t": "02:42",
      "text": "ல்லாவ பண்ணிட்டு இருக்க"
    },
    {
      "t": "02:44",
      "text": "அப்படிய"
    },
    {
      "t": "02:46",
      "text": "உம்"
    },
    {
      "t": "02:48",
      "text": "சன"
    },
    {
      "t": "02:50",
      "text": "உம்"
    },
    {
      "t": "02:52",
      "text": "சொல்லாம"
    },
    {
      "t": "02:54",
      "text": "எல்லாம் பேசலாம்னு சொேல்லிட்டு வந்தாங்க"
    },
    {
      "t": "02:56",
      "text": "உம் உஹம் சொும்மா இ"
    },
    {
      "t": "02:58",
      "text": "அப்படி டிரெஸ் எல்லாம்ட முடியாாம்"
    },
    {
      "t": "03:00",
      "text": "என்னங்க"
    },
    {
      "t": "03:02",
      "text": "ரசம் எல்லாம் போடாமல் வந்து பேசுறீங்க"
    },
    {
      "t": "03:04",
      "text": "சும்மா பேசுறீங்க"
    },
    {
      "t": "03:06",
      "text": "ஆஹ்"
    },
    {
      "t": "03:08",
      "text": "சார பலனு பேச"
    },
    {
      "t": "03:10",
      "text": "உம் உஹம்"
    },
    {
      "t": "03:12",
      "text": "உம்"
    },
    {
      "t": "03:14",
      "text": "சொல்லுங்க"
    },
    {
      "t": "03:16",
      "text": ""
    },
    {
      "t": "03:18",
      "text": "உம் நல்லாதான் போயட்டு"
    },
    {
      "t": "03:20",
      "text": "சரி சரி"
    },
    {
      "t": "03:22",
      "text": "உம் அப்புற"
    },
    {
      "t": "03:24",
      "text": "அப்புறம்"
    },
    {
      "t": "03:26",
      "text": "உம்"
    },
    {
      "t": "03:28",
      "text": ""
    },
    {
      "t": "03:30",
      "text": "தழுண"
    },
    {
      "t": "03:32",
      "text": "உம்"
    },
    {
      "t": "03:34",
      "text": "யா வந்து இப்போதைக்கு உ"
    },
    {
      "t": "03:36",
      "text": "பேசல நீங்க அவளுங்கா பேசலாம்"
    },
    {
      "t": "03:38",
      "text": "நல்லா இரு"
    },
    {
      "t": "03:40",
      "text": ""
    },
    {
      "t": "03:42",
      "text": "புரியில"
    },
    {
      "t": "03:44",
      "text": "நீங்க நல்லா பேச உனே நல்லா இருக்கீங்க"
    },
    {
      "t": "03:46",
      "text": "நல்லா இருக்கா"
    },
    {
      "t": "03:48",
      "text": "உம் சரி சரி இப்படி"
    },
    {
      "t": "03:50",
      "text": "ஹாராமும் போல்ல பிடு"
    },
    {
      "t": "03:52",
      "text": "வரீங்களா வெறியாக்காம் வரீங்களா"
    },
    {
      "t": "03:54",
      "text": "விிரக"
    },
    {
      "t": "03:56",
      "text": "அதன்ன பனங்க"
    },
    {
      "t": "03:58",
      "text": "அ பண்ண நீங்க"
    },
    {
      "t": "04:00",
      "text": "நீங்க தான் கொடுக்கணும் நான் ஆர்டர்ன் பண்ணேன்"
    },
    {
      "t": "04:02",
      "text": "இதுல விடியியக்கள் வரலாம்"
    },
    {
      "t": "04:04",
      "text": "ஓ"
    },
    {
      "t": "04:06",
      "text": "ஹம் அப்புறனா"
    },
    {
      "t": "04:08",
      "text": ""
    },
    {
      "t": "04:10",
      "text": "ஹம்"
    },
    {
      "t": "04:12",
      "text": "ஏ ஓ சீக்கிற"
    },
    {
      "t": "04:14",
      "text": "ச"
    },
    {
      "t": "04:16",
      "text": "சீக்கதுக்கு வந்த இல்ல சும்மாாதாங்க"
    },
    {
      "t": "04:18",
      "text": "உம் உம் அம்ப ர"
    },
    {
      "t": "04:20",
      "text": "மா"
    },
    {
      "t": "04:22",
      "text": "ல்லல்ல அப்போ"
    },
    {
      "t": "04:24",
      "text": "சரி வீடியோ காரு நீங்க தான வீடியோ காரு வரீங்களா"
    },
    {
      "t": "04:26",
      "text": "கேக்குற சரி அதுன்னு பண்ணுங்கறேன்"
    },
    {
      "t": "04:28",
      "text": "நீ கூப்பிடுங்கிறேன் அட்டன் பண்றன்"
    },
    {
      "t": "04:30",
      "text": "ங்கிறேன் அப்பறம் யசிக்கிறேன்ல"
    },
    {
      "t": "04:32",
      "text": ""
    },
    {
      "t": "04:34",
      "text": "ஹ"
    },
    {
      "t": "04:36",
      "text": "சொல்ல"
    },
    {
      "t": "04:38",
      "text": "சொ சல்லு"
    },
    {
      "t": "04:40",
      "text": "தம்பி சொன்னா கேக்கலாம்ல"
    },
    {
      "t": "04:42",
      "text": "உஹம்"
    },
    {
      "t": "04:44",
      "text": "ஏஸ்"
    },
    {
      "t": "04:46",
      "text": "என்ன அனுத்து"
    },
    {
      "t": "04:48",
      "text": "ஒன்னும் இல்ல"
    },
    {
      "t": "04:50",
      "text": "உம் அப்ப சொல்லேன்"
    },
    {
      "t": "04:52",
      "text": "உ"
    },
    {
      "t": "04:54",
      "text": "சொல்லுங்க சொல்லுங்க"
    },
    {
      "t": "04:56",
      "text": ""
    },
    {
      "t": "04:58",
      "text": "ஆமா"
    },
    {
      "t": "05:00",
      "text": "ஆஹ்"
    },
    {
      "t": "05:02",
      "text": "சொல்லுங்க"
    },
    {
      "t": "05:04",
      "text": "ஆஹன்ட்டு இருக்க"
    },
    {
      "t": "05:06",
      "text": "சொ சொ நீ சொங்கே"
    },
    {
      "t": "05:08",
      "text": "ஏதாட்டும்"
    },
    {
      "t": "05:10",
      "text": "வே நீி பேச மாட்டோ"
    },
    {
      "t": "05:12",
      "text": "அ பேச ஒரு மாணிகை இருக்குங்க"
    },
    {
      "t": "05:14",
      "text": "எப்படி இருக்கு"
    },
    {
      "t": "05:16",
      "text": "ஃபஸ்ட் டைம் பேுறேன் அந்த மணிக்கு இ இருக்குது"
    },
    {
      "t": "05:18",
      "text": "உம் உம்"
    },
    {
      "t": "05:20",
      "text": "அட்டு பேசலோ"
    },
    {
      "t": "05:22",
      "text": "முன்னாடி யாரிட்டையும் அவ்வளவா பேசல"
    },
    {
      "t": "05:24",
      "text": "உஹம் உம்"
    },
    {
      "t": "05:26",
      "text": "சரி சரி"
    },
    {
      "t": "05:28",
      "text": "என்ன பண்ணிட்டு இருக்க"
    },
    {
      "t": "05:30",
      "text": "சும்மாாதாங்க உட்காந்துட்டு இரு"
    },
    {
      "t": "05:32",
      "text": "ஆஹ்"
    },
    {
      "t": "05:34",
      "text": "உம்"
    },
    {
      "t": "05:36",
      "text": "சல்லல"
    },
    {
      "t": "05:38",
      "text": "சொல்லுங்க"
    },
    {
      "t": "05:40",
      "text": "உஹம்"
    },
    {
      "t": "05:42",
      "text": "செல்லுங்கன"
    },
    {
      "t": "05:44",
      "text": "தொல்லந"
    },
    {
      "t": "05:46",
      "text": "நீ"
    },
    {
      "t": "05:48",
      "text": "ஒர்க் பாக்கீங்களா இல்ல வீட்லதான் இருக்கீங்களா"
    },
    {
      "t": "05:50",
      "text": "மறக்குவ"
    },
    {
      "t": "05:52",
      "text": "இந்தங்க"
    },
    {
      "t": "05:54",
      "text": "நான் கோயம்புத்தூர் இருக்கேன்"
    },
    {
      "t": "05:56",
      "text": "சரிங்க சரிங்க"
    },
    {
      "t": "05:58",
      "text": "உம்"
    },
    {
      "t": "06:00",
      "text": "உம்"
    },
    {
      "t": "06:02",
      "text": "கம்பெனிக்கு"
    },
    {
      "t": "06:04",
      "text": "அப்பே நீங்க"
    },
    {
      "t": "06:06",
      "text": "உம் னந்த மேடம்"
    },
    {
      "t": "06:08",
      "text": "ஓ சரிங்க சரிங்க"
    },
    {
      "t": "06:10",
      "text": "உம் உம்"
    },
    {
      "t": "06:12",
      "text": "ஆமா"
    },
    {
      "t": "06:14",
      "text": ""
    },
    {
      "t": "06:16",
      "text": "நீ இதுல ஆன்லைன்ல எப்போ"
    },
    {
      "t": "06:18",
      "text": ""
    },
    {
      "t": "06:20",
      "text": "உம் நான் நட்டு ஒரு எட்டு மணிக்கா இருந்தங்க"
    },
    {
      "t": "06:22",
      "text": "எட்டு மணிக்கு வ"
    },
    {
      "t": "06:24",
      "text": "உம்"
    },
    {
      "t": "06:26",
      "text": "உஹம்"
    },
    {
      "t": "06:28",
      "text": "அப்புறம் டைம் கிடைக்கும எல்லாம் ஒரு"
    },
    {
      "t": "06:30",
      "text": "நாளைக்கு ஒன்பது மணிக்கு வருறன்"
    },
    {
      "t": "06:32",
      "text": "சரிங்க சரிங்க"
    },
    {
      "t": "06:34",
      "text": "எப்படி டைம் கிடைக்காது"
    },
    {
      "t": "06:36",
      "text": "ஆ இது பண்ண"
    },
    {
      "t": "06:38",
      "text": "ரெண்டு மணி ஒரு மணி ரெண்டு மணிக்கு மச்சு"
    },
    {
      "t": "06:40",
      "text": "ச"
    },
    {
      "t": "06:42",
      "text": "ஓ அவ்ளோ டைம்ங்கது"
    },
    {
      "t": "06:44",
      "text": "ஆ"
    },
    {
      "t": "06:46",
      "text": "நேத்தெல்ல ரெண்டரை வரைக்கும் இருந்தேன்"
    },
    {
      "t": "06:48",
      "text": "சரிங்க சரிங்க"
    },
    {
      "t": "06:50",
      "text": "உஹம்"
    },
    {
      "t": "06:52",
      "text": "தூக்க வரலனா இருக்கு"
    },
    {
      "t": "06:54",
      "text": "ஓகேங்க ஓகே"
    },
    {
      "t": "06:56",
      "text": "ஆ தானே காசு தானே பேசன"
    },
    {
      "t": "06:58",
      "text": "பேசிட்டு இருப்பத்தான"
    },
    {
      "t": "07:00",
      "text": ""
    },
    {
      "t": "07:02",
      "text": "சொல்லு"
    },
    {
      "t": "07:04",
      "text": ""
    },
    {
      "t": "07:06",
      "text": ""
    },
    {
      "t": "07:08",
      "text": "ச நல்லத்தரு"
    },
    {
      "t": "07:10",
      "text": "நாட்டுும் பேசுங்கங்க"
    },
    {
      "t": "07:12",
      "text": "எனக்கு என்ன பேசனன்னு தெரியல அவ"
    },
    {
      "t": "07:14",
      "text": "ானான் அமதே இருக்கேன்"
    },
    {
      "t": "07:16",
      "text": "ஆ ச"
    },
    {
      "t": "07:18",
      "text": "ஜாலியானா செக்ஸ் பத்தி பேச மாட்டேன்"
    },
    {
      "t": "07:20",
      "text": "ஜாலையே பேசிட்டு போங்க வேற"
    },
    {
      "t": "07:22",
      "text": "ரொம்ப செக்ஸ் பத்தி பேச"
    },
    {
      "t": "07:24",
      "text": "வந்து நானே கற்பண்ணி விட்டுருன்"
    },
    {
      "t": "07:26",
      "text": "ஓ"
    },
    {
      "t": "07:28",
      "text": "சரிங்க சரி"
    },
    {
      "t": "07:30",
      "text": "ஆனும் அப்படி பேச மாட்டேன் காலப்படாதது"
    },
    {
      "t": "07:32",
      "text": "ஆஹ்"
    },
    {
      "t": "07:34",
      "text": "ரொம்ப போன"
    },
    {
      "t": "07:36",
      "text": "எடுத்த உன்னே அப்படியே முட"
    },
    {
      "t": "07:38",
      "text": "இருக்குங்க எப்படி வரீங்களா அப்படி வறீங்களா"
    },
    {
      "t": "07:40",
      "text": "எப்படி காமிக்க முடியுமா விளியக்களை காட்ட முடியுமா அத"
    },
    {
      "t": "07:42",
      "text": "கட்ட முடியு அப்படின்னு நானே கட்டட்டுன்"
    },
    {
      "t": "07:44",
      "text": "ச சரி"
    },
    {
      "t": "07:46",
      "text": "ச"
    },
    {
      "t": "07:48",
      "text": "சொல்லுங்க"
    },
    {
      "t": "07:50",
      "text": "உம்"
    },
    {
      "t": "07:52",
      "text": ""
    },
    {
      "t": "07:54",
      "text": "சொல்ல"
    },
    {
      "t": "07:56",
      "text": "ஓ"
    }
