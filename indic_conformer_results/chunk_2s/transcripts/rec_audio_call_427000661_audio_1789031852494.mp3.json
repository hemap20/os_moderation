    {
      "t": "02:30",
      "text": "അ"
    },
    {
      "t": "02:32",
      "text": "ശരിതന്നെനല്ലാ"
    },
    {
      "t": "02:34",
      "text": "ഉം"
    },
    {
      "t": "02:36",
      "text": "ഇന്ന ശതാണല്ല"
