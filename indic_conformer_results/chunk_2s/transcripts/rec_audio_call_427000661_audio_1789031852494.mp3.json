    {
      "t": "02:44",
      "text": "വീഴുതിലേക്ക് കിടക്ക"
    },
    {
      "t": "02:46",
      "text": ""
    },
    {
      "t": "02:48",
      "text": "ഏ"
    },
    {
      "t": "02:50",
      "text": "പിന്നെ വെളുതിലേക്ക് കിടക്കാലോ"
    },
    {
      "t": "02:52",
      "text": "അതെ"
