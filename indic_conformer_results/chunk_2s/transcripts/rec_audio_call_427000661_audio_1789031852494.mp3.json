    {
      "t": "05:04",
      "text": "ആാ മനസ്സിലാവല്ല"
    },
    {
      "t": "05:06",
      "text": "ഉം ഉം ഉ ഉ അതിാസ്ിലേ"
    },
    {
      "t": "05:08",
      "text": "തങ്ങ"
    },
    {
      "t": "05:10",
      "text": "ശേഷ്ടിക്കണ്ട ഇത് കേരി"
    },
    {
      "t": "05:12",
      "text": "ഇതി ഇതിലപ്പോ എന്തോ"
