    },
    {
      "t": "00:14",
      "text": "హా ఎక్కనాచ్చ"
    },
    {
      "t": "00:16",
      "text": "పైక్ల చ"
    },
    {
      "t": "00:18",
      "text": "ఎని వి"
    },
    {
      "t": "00:20",
      "text": "విజయవా సత్రారు"
    },
    {
      "t": "00:22",
      "text": "ఎకాాలరి"
    },
    {
      "t": "00:24",
      "text": "మ్యారీడ్ అండి ఏం"
    },
    {
      "t": "00:26",
      "text": ""
    },
    {
      "t": "00:28",
      "text": ""
    },
    {
      "t": "00:30",
      "text": "అలాత"
    },
    {
      "t": "00:32",
      "text": "హలో"
    },
    {
      "t": "00:34",
      "text": "కు పంగం"
    },
    {
      "t": "00:36",
      "text": "చెప్పండి మ్యాన్ హౌస్ మదర్ మీద"
    },
    {
      "t": "00:38",
      "text": "సింగల్ సింగిల్"
    },
    {
      "t": "00:40",
      "text": "మీరు పర్పస్"
    },
    {
      "t": "00:42",
      "text": "ెం పర్పస్ అండి మీరు"
    },
    {
      "t": "00:44",
      "text": "నేను రియల్ మీట విడి"
    },
    {
      "t": "00:46",
      "text": "కొ"
    },
    {
      "t": "00:48",
      "text": "ఓకే"
    },
    {
      "t": "00:50",
      "text": "ఇంట్రెస్ట్ందా మకు"
    },
    {
      "t": "00:52",
      "text": "ఏడ కాలుజస్తా"
    },
    {
      "t": "00:54",
      "text": "ఏప్లనా"
    },
    {
      "t": "00:56",
      "text": "లేదండి వాట్సాప్ అ ఇన్స్టాగ్రామ్"
    },
    {
      "t": "00:58",
      "text": "అరే"
    },
    {
      "t": "01:00",
      "text": "మాచ కొష"
    },
    {
      "t": "01:02",
      "text": "చెప్పండి అ మరి ఎప్పుడండి వాట్సాప్"
    },
    {
      "t": "01:04",
      "text": "వాట్సప్ వాసప్"
    },
    {
      "t": "01:06",
      "text": "ఇన్స్టాగ్రామ్"
    },
    {
      "t": "01:08",
      "text": "విసాకనిసా"
    },
    {
      "t": "01:10",
      "text": "చేస్తా"
    },
    {
      "t": "01:12",
      "text": "మట్ అమౌంట"
    },
    {
      "t": "01:14",
      "text": "ఎంత"
    },
    {
      "t": "01:16",
      "text": "త అంట"
    },
    {
      "t": "01:18",
      "text": "సార్ కన్ఫర్మేషన్ చె"
    },
    {
      "t": "01:20",
      "text": "పేట్"
    },
    {
      "t": "01:22",
      "text": "మీ కన్ఫార్మషన్"
    },
    {
      "t": "01:24",
      "text": "ే పేమెంటట్ే సాంటనా"
    },
    {
      "t": "01:26",
      "text": "విడిపల్"
    },
    {
      "t": "01:28",
      "text": "కాల్ చేస్ కన్ఫర్మేషన్ చె పేమెంట్ేస్తా"
    },
    {
      "t": "01:30",
      "text": ""
    },
    {
      "t": "01:32",
      "text": "అవునుర అమౌంట్ వస్తే నేను కాల్ చేస్తా అంటన్నాను"
    },
    {
      "t": "01:34",
      "text": "బట్ ఐడియా చెప్తాను"
    },
    {
      "t": "01:36",
      "text": "అయని చెప్పండి"
    },
    {
      "t": "01:38",
      "text": "చెప్పండి ఏడి"
    },
    {
      "t": "01:40",
      "text": "ఎమౌంట్ చేస్తాయి పాలు చేస్తాం"
