  "segments": [
    {
      "t": "00:00",
      "text": ""
    },
    {
      "t": "00:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": "ಹಾ ಎಲ್ಲಿಂದ"
    },
    {
      "t": "00:06",
      "text": "ನಾನ ಬಂಗಳೂರು"
    },
    {
      "t": "00:08",
      "text": "ನಿಮ್ದ"
    },
    {
      "t": "00:10",
      "text": "ಾನ್ ಬ್ಯಾಂಗ್ಳೂರುಟ"
    },
    {
      "t": "00:12",
      "text": "ಓ್ವಾ ಬೆಂಗಳೂರ್ನಲ್ಲ ಎಲ್ಲಿ"
    },
    {
      "t": "00:14",
      "text": "ಆಂಧ್ರ ನಗರ್"
    },
    {
      "t": "00:16",
      "text": "ಕೆ"
    },
    {
      "t": "00:18",
      "text": "ಓ ಓಕೆ ಕೆಾ ಜಯನಗರದಲ್ಲಿಲ್ಲಿದ್ದೇ ಬೆಂಗ್ೂರು"
    },
    {
      "t": "00:20",
      "text": "ಹ"
    },
    {
      "t": "00:22",
      "text": "ಹ ಹಾ ನ"
    },
    {
      "t": "00:24",
      "text": "ಮತ್ತೆ ಏನ್ ಸಮಾಚಾರ"
    },
    {
      "t": "00:26",
      "text": "ಹೇಳ್ಬೇಕು ಏನ್ ಮಾಡ"
    },
    {
      "t": "00:28",
      "text": "ಕುೊಂಡಿದ್ದೀರಾ"
    },
    {
      "t": "00:30",
      "text": "ಹ ನಥಿಂಗ್ ಮಚ ಆ"
    },
    {
      "t": "00:32",
      "text": "ಅವ ಬಿಿಸಿನಸ್ ಅಷ್ಟೆ"
    },
    {
      "t": "00:34",
      "text": "ಏನ್ ಬಿಸಿಸಿನಸ"
    },
    {
      "t": "00:36",
      "text": "ಸರಿ"
    },
    {
      "t": "00:38",
      "text": "ಏನ್ ಬಿಿಸಿನಸ್ ಒಂದಪ್ಪ"
    },
    {
      "t": "00:40",
      "text": "ಆಐ ಹವ ಅ ಸ್ಕೆಚಿಂಗ್ ಬಿಿಸನೆಸ್"
    },
    {
      "t": "00:42",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:44",
      "text": "ನ ಹೆಸರುೋ"
    },
    {
      "t": "00:46",
      "text": "ಈ ಶ್ರೇಯಾ ಅಂತ"
    },
    {
      "t": "00:48",
      "text": "ಹ"
    },
    {
      "t": "00:50",
      "text": "ವರಿ ನೈಸ್ ನೈಸ್"
    },
    {
      "t": "00:52",
      "text": "ಹೌಬ"
    },
    {
      "t": "00:54",
      "text": ""
    },
    {
      "t": "00:56",
      "text": "ಶ್ರೇಯಷ"
    },
    {
      "t": "00:58",
      "text": "ರ್ಭಕ್ಕೆ ಆಳ್ಳು"
    },
    {
      "t": "01:00",
      "text": "ಹಾ"
    },
    {
      "t": "01:02",
      "text": "ಹ್ಮ್ ನಡ"
    },
    {
      "t": "01:04",
      "text": "ಹ್ಮ"
    },
    {
      "t": "01:06",
      "text": "ಮತ್ತೆ ನೀವೇನ್ ಬರ್ತನಿದ್ದೀರಾ"
    },
    {
      "t": "01:08",
      "text": "ನಾನು ಬಿಸ್ನೆೆಸ್ ಮ್ಯಾಾನ ನಾನು"
    },
    {
      "t": "01:10",
      "text": "ಮ್ಯಾನುಫ್ಯಾಕ್ಚರ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "01:12",
      "text": "ಆ ಫ್ಯಾಬ್ರಿಕ್ಸ್"
    },
    {
      "t": "01:14",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "01:16",
      "text": "ಓಕೆ ನ"
    },
    {
      "t": "01:18",
      "text": "ನಿಮಷ ಒ ನಿಮ್ಷ"
    },
    {
      "t": "01:20",
      "text": ""
    },
    {
      "t": "01:22",
      "text": "ಹ"
    },
    {
      "t": "01:24",
      "text": ""
    },
    {
      "t": "01:26",
      "text": "ಹ"
    },
    {
      "t": "01:28",
      "text": "ಹೇಳಿಸಿ"
    },
    {
      "t": "01:30",
      "text": "ಹ್ಮ ಹ್ಮ"
    },
    {
      "t": "01:32",
      "text": ""
    },
    {
      "t": "01:34",
      "text": "ಮತ್ತುತ್ತ"
    },
    {
      "t": "01:36",
      "text": "ಮತ್ತೆ ಹೇಳ್ಬೇಕಪ್ಪಾ ನೀವೇ"
    },
    {
      "t": "01:38",
      "text": "ಸೇ ಸರ"
    },
    {
      "t": "01:40",
      "text": "ಶ್ರೇಯ್"
    },
    {
      "t": "01:42",
      "text": "ೇಸಲ ನನ್ನ ಹೆಸರು ಶ್ರೇಯಾ"
    },
    {
      "t": "01:44",
      "text": "ಶ್ರೀಯಾ ಓಕೆ ಓಕೆ ಶ್ರೀಯಾ"
    },
    {
      "t": "01:46",
      "text": "ಕೆ ಅದನ್ನೇ ಶ್ರೇಯಸ್ ಬರ್ಲಿ ಅಂತ ನ"
    },
    {
      "t": "01:48",
      "text": "ಅದನ್ನ ಎಸ್ ಎಸ್ ಹಾಕ್ಬಿ"
    },
    {
      "t": "01:50",
      "text": "ಸ ಸ ಹುಡುಗಸ್ತ್ರ ಆಗುತ್ತ"
    },
    {
      "t": "01:52",
      "text": "ಕೆ ಅನಸ್"
    },
    {
      "t": "01:54",
      "text": "ಕೆ ಶ್ರಯಾ ಹಳ್ಬೇಕ"
    },
    {
      "t": "01:56",
      "text": "ಖುಷ್ರ ಅವರ"
    },
    {
      "t": "01:58",
      "text": "ಹ ಹ್ಮ ಸೊ"
    },
    {
      "t": "02:00",
      "text": "ಏಕ ಇಷ್ಟತ್ ನೆ ಆಪ್ ಯಸ್"
    },
    {
      "t": "02:02",
      "text": "ಮಾಡದ"
    },
    {
      "t": "02:04",
      "text": "ಮೇ ಸಿಕ್ಕೆಷ್ಟ್ಟ"
    },
    {
      "t": "02:06",
      "text": "ಥಂಗ್ಸ್ ಒಂದು"
    },
    {
      "t": "02:08",
      "text": "ಮೇಜರ ಫೈಟ್ ಆಯ್ತು"
    },
    {
      "t": "02:10",
      "text": "ಫಿಂದ"
    },
    {
      "t": "02:12",
      "text": "ಹ್ಮ್ ನಿಂಗೆ ಬಂದೆ ಹಾಲಿಡ"
    },
    {
      "t": "02:14",
      "text": "ಅಂದ್ರೆ ಒಂದು ಬಿಸ್ೆಸ್ ಮೇಲೆ"
    },
    {
      "t": "02:16",
      "text": "ಎತ್ತ ಬಂದಿದ್ದೀಿ ನಾಳೆ ನೈಟ್ ವಾಪಸ್"
    },
    {
      "t": "02:18",
      "text": ""
    },
    {
      "t": "02:20",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "02:22",
      "text": "ಆ ಟೆನ್ಷನ್ ಕಳಕ್ ಸುಮನೆ ಆ್ಯಪಲ್ ಬಂದೆ"
    },
    {
      "t": "02:24",
      "text": "ಅದೇನ ಇವಾಗ ಅ್ ಚನ್ನಾಗ ಬಂದೆ ಒಂದ್ವಲ್"
    },
    {
      "t": "02:26",
      "text": "ಪತ ಆಯ್ತು"
    },
    {
      "t": "02:28",
      "text": ""
    },
    {
      "t": "02:30",
      "text": ""
    },
    {
      "t": "02:32",
      "text": "ಕೆ"
    },
    {
      "t": "02:34",
      "text": "ಸೆಕಂಡ"
    },
    {
      "t": "02:36",
      "text": "ಸರಿ"
    },
    {
      "t": "02:38",
      "text": "ಈಷರ್ ತರ ಮೇಚ ಅಲ್ಲಿ ಟೂರ್"
    },
    {
      "t": "02:40",
      "text": "ರೀಸನ್ಸ್ ಯು ಸ ಎತ ಫಸ್ಟ್ ಒನ್"
    },
    {
      "t": "02:42",
      "text": "ಸ"
    },
    {
      "t": "02:44",
      "text": "ಬರ್ತಲ್ಲ"
    },
    {
      "t": "02:46",
      "text": ""
    },
    {
      "t": "02:48",
      "text": ""
    },
    {
      "t": "02:50",
      "text": "ಎ್ದಕ್ಕೆ"
    },
    {
      "t": "02:52",
      "text": "ನಾ ಅಂದ  ನೀಿನಾ"
    },
    {
      "t": "02:54",
      "text": "ನನ್ನ್ದ ಬರ್ತಿದ್ದೆ"
    },
    {
      "t": "02:56",
      "text": ""
    },
    {
      "t": "02:58",
      "text": "ಐ ವಸ್ ಹಾವಂಗ್ ಅ ಲಿಟಿಲ್ ಫನ್"
    },
    {
      "t": "03:00",
      "text": "ಪೀಪಲ್"
    },
    {
      "t": "03:02",
      "text": "ಸ ಕ್ರೇಜಿ ಪೀತಲ"
    },
    {
      "t": "03:04",
      "text": "ಫನ್ ಇನ್ ದ ಸೆಸ್ ನಾಟ್ ಎನಿ ಸೆಕ್ಸುಲ್ ಫನ್"
    },
    {
      "t": "03:06",
      "text": "ವೆರಿ ಡಿಫಟ್"
    },
    {
      "t": "03:08",
      "text": "್ಫ ವರಿರ್ಬ"
    },
    {
      "t": "03:10",
      "text": "ಹ ಜಸ್"
    },
    {
      "t": "03:12",
      "text": "್ರೈಬಿಂಗ್ ಟು ಯು ಬಿಕಾಸ್ ನೀವೇನಾದ್ೂ"
    },
    {
      "t": "03:14",
      "text": "ತಪ್ಪ ತಿಳ್ಕೋಬಾರುದಲ್ಲ ಈ ಆಪಲ್ ನೈನ್ಟಿ"
    },
    {
      "t": "03:16",
      "text": "ಪರ್ಸೆಂಟ್ ಜನರು ಬರೋದೇ ಅದಕ್ಕೋಸ್ಕರ"
    },
    {
      "t": "03:18",
      "text": "ಹ ಪ್ರಬಲತ"
    },
    {
      "t": "03:20",
      "text": ""
    },
    {
      "t": "03:22",
      "text": "ಓ ಐಡೋಂ ನ ಇಫ ಯ ಯೂಸ್ ದ ಆಪ್"
    },
    {
      "t": "03:24",
      "text": "ಬ ಯ ನ ತಪ"
    },
    {
      "t": "03:26",
      "text": "ಂದು ತರ್ಟಿ ತರ್ಟಿ ಫೈ"
    },
    {
      "t": "03:28",
      "text": "ಆಯಪ್ ಯೂಸ್ ಮಾಡಿ"
    },
    {
      "t": "03:30",
      "text": "ಯಕು ಒ ಸ ಡಿಲೀಟ್ ಮಾಡ್ಬೇಕಷ್ಟೇ"
    },
    {
      "t": "03:32",
      "text": "ಕ"
    },
    {
      "t": "03:34",
      "text": "ಸೊ ಆಲ್ರೆಡಿ ನೋಡ್ಬಿಟ್ಟಿದ್ದೀರಾ ಆಂಟಿಗಳನ್ನೆಲ್ಲ"
    },
    {
      "t": "03:36",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "03:38",
      "text": "ಅದ ಯಾವ್ದೋ ಪ್ರ"
    },
    {
      "t": "03:40",
      "text": "ಚೆಕ್ ಮಾಡಿ"
    },
    {
      "t": "03:42",
      "text": "ಮ್ಯಾಚ್ಫ ಪ್ರೊಫೈಲ್ ಮ್ಯಾಚ್ ಫ ಪ್ರೊಫೈಲ್ ಅಂತ್ಕ್"
    },
    {
      "t": "03:44",
      "text": "ಮಾಡೋದು ಬರದು ಹೋಗೋದು ಬ"
    },
    {
      "t": "03:46",
      "text": "ಹೋಗೋದು ಯಾವವು್ದೋ ಇ ಎರಡು ಬಂತು ಅಂತ"
    },
    {
      "t": "03:48",
      "text": "ಮ್ಮ ಓ ಮಕ"
    },
    {
      "t": "03:50",
      "text": "ಗಾಡ್ ಸಾಕೋ ನಸ್ತ"
    },
    {
      "t": "03:52",
      "text": "ಇಷ್ಟಾದ್ಮೇಲ್ಲಿ ಯಾರು ಇರಲ್ಲ"
    },
    {
      "t": "03:54",
      "text": "ರಾತ್ರಿ ಟೈಮ್ ಅಲ್ಲಿ ಪ"
    },
    {
      "t": "03:56",
      "text": "ಪಂಟಿಗಳು ಗಂಡಂದ ಎಲ್ಲ ಬಂದಿರ್ತ"
    },
    {
      "t": "03:58",
      "text": "ಇವಾಗ ಬರ್ ಸಿಗ್ಬೇಕಂದ್ರೆ"
    },
    {
      "t": "04:00",
      "text": "ಅವರು ಬೆಳಿಗ್ಗೆ ಟೈಮ್ ಬರ್ತಾರೆ"
    },
    {
      "t": "04:02",
      "text": "ಗಂಡಂದ್ರನೆಲ್ಲಾ ಕೆಲ್ಸಕ್ ಕಳಸಿ"
    },
    {
      "t": "04:04",
      "text": "ಈ ಆಪಿ ಬಂದ ನೇೇಕಡ"
    },
    {
      "t": "04:06",
      "text": "ಕುತ್ಕೊಂತಾರೆ"
    },
    {
      "t": "04:08",
      "text": "ಅ ನ"
    },
    {
      "t": "04:10",
      "text": "ಎಕ್ಸಾಕ್ಟ್ಲಿ ವ"
    },
    {
      "t": "04:12",
      "text": ""
    },
    {
      "t": "04:14",
      "text": "ನೈಟ್ ಂಬಿ"
    },
    {
      "t": "04:16",
      "text": "ಫೈನ್ ಪೀಪಲ್ ಇ ದ"
    },
    {
      "t": "04:18",
      "text": "ಯು ಯೂಸ್ ಒಂಟ್"
    },
    {
      "t": "04:20",
      "text": "ಟೈಮ್ ಇನ್ ದ ಡೇ ಯಾಕಾನ ಯಾರ"
    },
    {
      "t": "04:22",
      "text": "ಯೂಸ್ ಮಾಡ್ತಿದ್ದೀನ ಅಂತ ಕೈ ಕಾ ಮುಕೊಂಡಂಬಿಟ್ಟು"
    },
    {
      "t": "04:24",
      "text": "ಡಿಲೀಟ್ ಮಾಡಿಬಿಟ್ಟ್ರ ಎಸಿಿಗೆ ಹೋಗ್ತಿರ"
    },
    {
      "t": "04:26",
      "text": "ಆಟಮ್ೋ  ಇಟ್ ನಾವು ಒನ್"
    },
    {
      "t": "04:28",
      "text": "ಹ್ಮ ಬ್ಯಾಟ"
    },
    {
      "t": "04:30",
      "text": "ಸೊ ಅಲ್ಲ ನಿಮ್ಮ ಹತ್ರ ಮಾತಾಡ್"
    },
    {
      "t": "04:32",
      "text": "ತರೇಂದ್ರ ದ ಯೂರ್ ಆಬ"
    },
    {
      "t": "04:34",
      "text": "ಸರ್"
    },
    {
      "t": "04:36",
      "text": "ಇವರಬೇಕ ನ"
    },
    {
      "t": "04:38",
      "text": "ತ ಯ"
    },
    {
      "t": "04:40",
      "text": "ಐ ಎಮ ಅವೇಕ್ ಬಿಕೋಸ್ ಐ ೋಂಟ್ ಹ್"
    },
    {
      "t": "04:42",
      "text": "ಹಸ್ಬಂಡ ಆ ರ ಶಡ್ ಬಿಫ್ರಡ್  ಆಫ್"
    },
    {
      "t": "04:44",
      "text": "ಐ ಡೋಂಟ್ ವಾಂಟ್ ಮಿ ಐ ಹಾವ್ ಎನ್್"
    },
    {
      "t": "04:46",
      "text": "ಮಿ ಫಾರ್ ಲೈಫ್ ಹೋ ನ"
    },
    {
      "t": "04:48",
      "text": "ಮೆನಿ ಥಿಂಗ್ಸ್ ಲೈಕ್ ದಟ್"
    },
    {
      "t": "04:50",
      "text": "ಆಯ ಆ್ ಆೇಕ್ ಬಿಕಸ್ ಐ ವೋಂಟ್ ು ಆ"
    },
    {
      "t": "04:52",
      "text": "ನಷ್ಟ"
    },
    {
      "t": "04:54",
      "text": ""
    },
    {
      "t": "04:56",
      "text": "ನೈಂಟಿ ಪರ್ಸೆಂಟ್ ಇವ"
    },
    {
      "t": "04:58",
      "text": "ಟೆನ್ ಪರ್ಸೆಂಟ್"
    },
    {
      "t": "05:00",
      "text": "ಅಫ್ಕೋರ್ಸ್"
    },
    {
      "t": "05:02",
      "text": ""
    },
    {
      "t": "05:04",
      "text": "ತ್ತ"
    },
    {
      "t": "05:06",
      "text": "ಸೊಮಗೈ ಹಲ್ ಗಮ್ ಹಲ್"
    },
    {
      "t": "05:08",
      "text": "ಟಲ್"
    },
    {
      "t": "05:10",
      "text": "ಹ ಇಲಸ್ಕೋಟ್"
    },
    {
      "t": "05:12",
      "text": "ಯು ಟಾಕ್ ವಿತ್ ಗೈಸ್ ದ ನೈಟ್"
    },
    {
      "t": "05:14",
      "text": "ಟಲ್ ಹೆಮ ಯ"
    },
    {
      "t": "05:16",
      "text": "ಯಾರಾದ್ರರು ಸ್ವಲ್ಪ ತಲೆ ಕೆಟ್ಟೋರು ಬಂದ್ರೆ"
    },
    {
      "t": "05:18",
      "text": "ಈಗ ಹರ್ಟ್ ಮಾಡ್ಬಿಟ್ಟು ಕಳ್ಸ ಬಿಿಡ್ತೀನಿ"
    },
    {
      "t": "05:20",
      "text": "ಐ ವ ಸುಮನೆ ಪ್ಲೇಂಗ್ ವಿ"
    },
    {
      "t": "05:22",
      "text": ""
    },
    {
      "t": "05:24",
      "text": "ಲೈ ಬ್ರ ಸ"
    },
    {
      "t": "05:26",
      "text": "ಸೋಲ್ಬರು ಅಂತ ಅಂದ ಆಯ್ಗ"
    },
    {
      "t": "05:28",
      "text": "ವೆರಿ ಬೆಸ್ಟ್ ಐ ಟೋಲ್ಡಮ ಹ"
    },
    {
      "t": "05:30",
      "text": "ನೋಡರಿ ಕಾಲ್ಮಿ ಲೈಕ್ ದಾಟ್ ಅಂತ"
    },
    {
      "t": "05:32",
      "text": "ಅಂದ ನೀ ಈವ ಒಸ್್ ಲೈಕ್ ಹೋಗಲಿ ಬಿಡಿಏ"
    },
    {
      "t": "05:34",
      "text": "ನನ್ ಈಗೂ ಏನ್ ಅರ್ಟ್ ಆಗಲ್ಲ ನಾನಗ"
    },
    {
      "t": "05:36",
      "text": "ನ್ ಸಣ್ಣದಲ್ಲಾ ತೇಳದಾ"
    },
    {
      "t": "05:38",
      "text": "ಅವ್ನ್ ಹೇಳಿದತ್ ಫೈವ್ ಸೆಕೆಂಡ್ಸ್ ಅಲ್ಲ"
    },
    {
      "t": "05:40",
      "text": "ಕಟ್ ಮಾಡ್ಬಿಟ್ಟ ಅದು"
    },
    {
      "t": "05:42",
      "text": ""
    },
    {
      "t": "05:44",
      "text": "ೋ ನೋ ವಾಟ್ ಕೈೋ ಪೀಪಲ್ ಆರ್ ಕಂಗ್"
    },
    {
      "t": "05:46",
      "text": "ದ"
    },
    {
      "t": "05:48",
      "text": "ಐ ಎ್ ಟೇೇಕಿಂಗ್ ಫನ್ ಔಟ್"
    },
    {
      "t": "05:50",
      "text": "ಪ್ರಾಫಿಟ್ ಅಷ್ಟೇಟ ಮ"
    },
    {
      "t": "05:52",
      "text": "ಗಡ್"
    },
    {
      "t": "05:54",
      "text": ""
    },
    {
      "t": "05:56",
      "text": "ವಾಟ್ ಯು ವಂಟ್"
    },
    {
      "t": "05:58",
      "text": "ಅಷ್ಟೇ ಯಾವ್ದ್ರೂ ಬಗೆತಲ್ಲಿ"
    },
    {
      "t": "06:00",
      "text": "ಈ ಆಯರಿ ಇಡ"
    },
    {
      "t": "06:02",
      "text": "ತಿಂಗ್ ಫಸ್ಟ್ ನು ಕಷ್ಟ"
    },
    {
      "t": "06:04",
      "text": "ರವಾಗಿ ಯೂಸ್ ಮಾಡ್ತಿದ್ದೆ ಈ ಆಪ್ನ"
    },
    {
      "t": "06:06",
      "text": "ಈ ಆಂಟಿಗಳು ಮುಖನೆಲ್ಲಾ ನೋಡಿ ನೋಡಿ"
    },
    {
      "t": "06:08",
      "text": "ನೋಡಿ ದೆವ್ವದ್ ಮುಖಗಳೆಲ್ಲಾ ನೋಡಿ ನೋಡಿ"
    },
    {
      "t": "06:10",
      "text": "ಆಮೇಲೆ ಈ ಕಡೆ ಶಿಫ್ಟ್ ಆಗಿದ್ದು ನೋಡೋಣ"
    },
    {
      "t": "06:12",
      "text": "ಮಾತಾಡಿ ಹುಡುಗರು ಹೆಂಗಿದಾರೆ ಅಂತ"
    },
    {
      "t": "06:14",
      "text": "ಅಂತ ಅದ್ರಲ್ಲಿ"
    },
    {
      "t": "06:16",
      "text": "ಇದು ವಾಸಿ ಹುಡುಗರು"
    },
    {
      "t": "06:18",
      "text": "ೈನ್ ಕೆಲೊಬ್ರು ಚನ್ನಾಗ್ ಮಾತಾಡ್ತಾರೆ"
    },
    {
      "t": "06:20",
      "text": "ಕೆಲವೊಬ್ರು ದೇಲ್ ಕ"
    },
    {
      "t": "06:22",
      "text": "ೇಕೆಡ್ ಗ ಇಸ್ ಆಲ್ೋ ಕೇಕೆಡ್"
    },
    {
      "t": "06:24",
      "text": ""
    },
    {
      "t": "06:26",
      "text": "ಅ ಬಟ್"
    },
    {
      "t": "06:28",
      "text": "ಕಂಪಾರಿಟಿವ್ಲಿ ಇ ಬೆಟರ್"
    },
    {
      "t": "06:30",
      "text": "ಹ್ಮ"
    },
    {
      "t": "06:32",
      "text": "ಇ"
    },
    {
      "t": "06:34",
      "text": "ಸ ಒಣನ್ ಯು ಎನ್ ಎ ವೈಫ"
    },
    {
      "t": "06:36",
      "text": "ಕೂಡಿಲ್ಲ"
    },
    {
      "t": "06:38",
      "text": "ಇದ್ರ ಮೇಲೆ ಏನ್ ಹೇಳ"
    },
    {
      "t": "06:40",
      "text": "ಅದಕ್ಕೆ ನಂಗ ಆಗಲ್ಲ ಬಿಟ್ಬಿಡಿ"
    },
    {
      "t": "06:42",
      "text": "ನತ್ತ ಕೆಸ"
    },
    {
      "t": "06:44",
      "text": "ಬಬಿ"
    },
    {
      "t": "06:46",
      "text": "ಒ ಬ್ರಜರ್ಸ್ ನವಿ ಸ"
    },
    {
      "t": "06:48",
      "text": "ನೋಟ"
    },
    {
      "t": "06:50",
      "text": "ಐ ಹಾವ್ ಐ"
    },
    {
      "t": "06:52",
      "text": "ಬ್್ ಗಟ್"
    },
    {
      "t": "06:54",
      "text": "ಆಯ ಕನ್ ಸಿೀ ಸಮಸ್ ಗ ಪ್ರಬ್ಲ"
    },
    {
      "t": "06:56",
      "text": "ಸ ಇ"
    },
    {
      "t": "06:58",
      "text": "ಎಂತ ಸಿವ ನೀ"
    },
    {
      "t": "07:00",
      "text": "ಬಹ ಪ್ರಾಬಲಮ್"
    },
    {
      "t": "07:02",
      "text": "ನೀವ ಯಾವ ಪ್ರಾಬ್ಲಮ್ ಇದ"
    },
    {
      "t": "07:04",
      "text": "ಯುಫಂಡಂಗ್ ಸೋ ಮೆನ ಪೀಪಲ್ ಇ"
    },
    {
      "t": "07:06",
      "text": "ಸೋಮ್ಯ ಪ್ರಾಬ್ಲಮ್"
    },
    {
      "t": "07:08",
      "text": "ಪ್ರೋವತ್ತುಫಕುಸ"
    },
    {
      "t": "07:10",
      "text": "ಐ ಡಂಟ್ ಹಾವ್ನಿ ಪ್ರಾಬ್ಲಮ ಆಮ್"
    },
    {
      "t": "07:12",
      "text": "ಟಾಿಂಗ್ ಟ ಪೀಪಲ್ ಫಾರ್ ಟೂ ಅವರ್ಸ್ ್ಟ್ರೇಟ್"
    },
    {
      "t": "07:14",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "07:16",
      "text": "ಏ ಆ"
    },
    {
      "t": "07:18",
      "text": "ಟೈಂ ಪಾಸಂಗ ಅಷ್ಟ"
    },
    {
      "t": "07:20",
      "text": "ಹ್ಮ್ ಹ್ಮ್"
    },
    {
      "t": "07:22",
      "text": "ನೈಸ್ ಪೀಪಲ್ ಗಟ್ ಕನೆಕ್ಟಡ್ ದ"
    },
    {
      "t": "07:24",
      "text": "ಚ್ ಎ ಲಾಂಗ್ಟೈ್"
    },
    {
      "t": "07:26",
      "text": ""
    },
    {
      "t": "07:28",
      "text": "ಯ"
    },
    {
      "t": "07:30",
      "text": "ಅಂಡರ್ಸ್ಂಡ್ಯ ತ ಇನ್ನೊಂದು"
    },
    {
      "t": "07:32",
      "text": "ಒಂದು ಬೆಳಗ್ಗೆ ಟೈಮಲ್ಲಿ ಯಸ್ ಮಾಡ ಯಾರಲ್ಲಿ"
    },
    {
      "t": "07:34",
      "text": "ಅಯ ಆಗ"
    },
    {
      "t": "07:36",
      "text": ""
    },
    {
      "t": "07:38",
      "text": "ಎಲ್ಲ ಹ್ಮ"
    },
    {
      "t": "07:40",
      "text": "ಹ್ಮ ಬಟರ್"
    },
    {
      "t": "07:42",
      "text": "ಏನು"
    },
    {
      "t": "07:44",
      "text": "ಆಫರ್ ಸಿಕ್ತು ಎರಡ್ ಸಾವಿರ ರೂಪಾಯಿ"
    },
    {
      "t": "07:46",
      "text": "ಕೊಟ್ರೆ ಐ್ ಸಾವಿರ ಅಕ್ಕ ಐದ ಸಾವರು ಇದ"
    },
    {
      "t": "07:48",
      "text": "ಯಾವವುೋ ಒೆ ಜಾಕ್ ಪಟ್ ಅಂತ ರೀಚಾರ್ಜ್ ಮಾಡ"
    },
    {
      "t": "07:50",
      "text": "ಅದನ್ನ ಖಾಲಿ ಮಾಡ್ತೀನಿ ಅಷ್ಟು"
    },
    {
      "t": "07:52",
      "text": "ಬ್ರ ಆಯ"
    },
    {
      "t": "07:54",
      "text": "ಅವ್ರ ಕಾಯಿನ್ಸ್ ಹಿಗೆ ಹಿಂಗೆ ಹಿಂಗೆ"
    },
    {
      "t": "07:56",
      "text": "ಖಾಲಿ ಆಗ್ತಾ ಇರುತ್ತ"
    },
    {
      "t": "07:58",
      "text": "ಫರ್ವನ್"
    },
    {
      "t": "08:00",
      "text": "ಫರ್ ಒನ್ ಸೆಕೆಂಡ್  ಸಮಥಿಂಗ್ ಟೆನ್"
    },
    {
      "t": "08:02",
      "text": ""
    },
    {
      "t": "08:04",
      "text": "ದಸ್ ಒನ್ ಲೇಡಿಮ್"
    },
    {
      "t": "08:06",
      "text": "ಟಲ್ಮಿ ವಾಟ್ಾವ್ ಟ ಶೋ ಸಾರ್ ಟಲ್ಮಿ ವಿ"
    },
    {
      "t": "08:08",
      "text": "ಎಟು ಸೊಲ ಸತ್ಗೆ ವಾಟ್ಸ್ಸಪ್ ನಂಬರ್"
    },
    {
      "t": "08:10",
      "text": "ಗಿಮಿ ದ ಗಿಮಿ ದ ಆಐ ಸಟ್ ಬ"
    },
    {
      "t": "08:12",
      "text": "ಆಲ್ಸ್ ಆಐ ಹೆ್ ನಾಟ್ ಕ ಟ ಗ್ ಯು ವಾಟ್"
    },
    {
      "t": "08:14",
      "text": "ವಾಟ್ಪ್ ನಂಬಸ್ ಕ್"
    },
    {
      "t": "08:16",
      "text": "ಐ ಒಟಟ"
    },
    {
      "t": "08:18",
      "text": "ಶೇರ್ ಸಮಥಂಗ್ ಇನ್ ದ ಮೂಮೆಂಟ್ ಆಐ"
    },
    {
      "t": "08:20",
      "text": "ಸ್ಟಾಿಂಗ ನ್ಲಿ ಸಿ್ಟ ಓನಿ್"
    },
    {
      "t": "08:22",
      "text": "ಂಗರ್ ಟಾಪ್"
    },
    {
      "t": "08:24",
      "text": "ಸೆ"
    },
    {
      "t": "08:26",
      "text": "ಸ"
    },
    {
      "t": "08:28",
      "text": "ನಾಟ್ ಓಪನ್ ದ ಟಾಪ್ಫರ್ ಎ ಲಾಂಗ್ ಲೈಫ ಟ"
    },
    {
      "t": "08:30",
      "text": "ಬಿಕಾಸ್ ಇಟ್ಲ್ಟ್ ಡಿಸನೆಕ್ೆಡ್"
    },
    {
      "t": "08:32",
      "text": "ಪ್ಲೀಸ್ ಗಿ ಮ ಈ ವಾಟ್ಸಪ್ ನಂಬರ್"
    },
    {
      "t": "08:34",
      "text": "ಹ"
    },
    {
      "t": "08:36",
      "text": "ಹ್ಮ್ ನೋ"
    },
    {
      "t": "08:38",
      "text": ""
    },
    {
      "t": "08:40",
      "text": "ಸ್ಪಟ್ಟೆ ಡಿಸಕಕ್ಟ್ ನಷ್ಟೆ"
    },
    {
      "t": "08:42",
      "text": "ನ"
    },
    {
      "t": "08:44",
      "text": "ಬಜಫೀಲ್ಡ್ ವಿಟ್"
    },
    {
      "t": "08:46",
      "text": ""
    },
    {
      "t": "08:48",
      "text": "ಹ್ಮ್್ಮ"
    },
    {
      "t": "08:50",
      "text": "ಸರಿ ವಿ ಪಂಡಿತರ"
    },
    {
      "t": "08:52",
      "text": "ಸರಿ"
    },
    {
      "t": "08:54",
      "text": "ಯು ಆರ್ ಆಲ್ಸೋ ನೈಸ್ ಎಕ್ಸ್ಪೀರಿಯನ್ಸ್ಡ್ ಅೆ"
    },
    {
      "t": "08:56",
      "text": "ಮ"
    },
    {
      "t": "08:58",
      "text": "ಎಂದ"
    },
    {
      "t": "09:00",
      "text": "ಅಂದ್ರೆ ಬಂದು ಹುಡುಗುರೆ ಎಲ್ಲಾ ಚೆನ್ನಾಗಿ"
    },
    {
      "t": "09:02",
      "text": "ಇರಿಟೇಷನ್ ಮಾಡಿದ್ದಾರೆ ಅಂತ"
    },
    {
      "t": "09:04",
      "text": "ಯಾರಾ"
    },
    {
      "t": "09:06",
      "text": "ಅವ್ರು ಬರ್ತಾರೆ ಎಲ್ಲಾ ತ ಕೊಂಡ ಇಟ್ಟುಕೊಂಡಿ"
    },
    {
      "t": "09:08",
      "text": "ನಾನ್ ಎರಡ್ ಸೆಕೆಂಡ್ ನೋಡಲ್ಲ ಕಟ್ಟ"
    },
    {
      "t": "09:10",
      "text": "ಮಾಡ್ಬಿಡ್ ಹಯ್ತಾ ಇರ್ತೀನ ಅಷ್ಟೇ"
    },
    {
      "t": "09:12",
      "text": ""
    },
    {
      "t": "09:14",
      "text": "ಹ"
    },
    {
      "t": "09:16",
      "text": "ಸ ಒಂದ್ ಆಪ್ ಅಂದ್ಮೇಲೆ ಚೆನ್ನಾಗಿರೋದು"
    },
    {
      "t": "09:18",
      "text": "ಇರದದೆ ಕೆಟ್ಟದ್ದಾಗಿರೋದು ಇರುತ್ತೆ"
    },
    {
      "t": "09:20",
      "text": "ಇಫ್ ಆಐ ಎಮ್ ಬೆನಿಫಿಟಿ್್ರಮ ದಿಸ ಆಪ್"
    },
    {
      "t": "09:22",
      "text": "ಇಫ್ ಐ ಆಮ್ಾವಿಂಗ್ ಅ ಪೀಸ್ ಆಫ್ೈಂಡ್"
    },
    {
      "t": "09:24",
      "text": "ಂಡ್ ವೈ ವಿಲ ಲೆಟ್ಸ್"
    },
    {
      "t": "09:26",
      "text": "ತಮ್ ಆಸಲ್ಫ ರೋಂಡ್ ಮೈ ಪೀಸ್ ಆಫ್ ಮೈಂಡ್"
    },
    {
      "t": "09:28",
      "text": "ಬರ್ತಾರಾ ಚೆನ್ನಾಗಿಲ್ವಾ ಕಟ್ ಮಾಡ್ತ"
    },
    {
      "t": "09:30",
      "text": "ಹೋಯ್ತಾ ಇರ್ತೀನಿ ಅಷ್ಟೇ"
    },
    {
      "t": "09:32",
      "text": "ಅ"
    },
    {
      "t": "09:34",
      "text": "ು ನ ಸಾಟ್ಟ"
    },
    {
      "t": "09:36",
      "text": "ಹ್ಮ್"
    },
    {
      "t": "09:38",
      "text": "ಇಸ್ ನೈ ಸ್ಟಾಕ್ ಇನ್ ಪ ಯೂಟಿ"
    },
    {
      "t": "09:40",
      "text": "ಚಲ ಗುಡ್ ನೈಟ್"
    },
    {
      "t": "09:42",
      "text": "ಗುಡ್ ನೈಟ್"
