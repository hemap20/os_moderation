    {
      "t": "01:40",
      "text": "వెరీ స్ట్రాంగ్"
    },
    {
      "t": "01:50",
      "text": "బాగుంది కదా"
    },
    {
      "t": "02:00",
      "text": "చూపియవా కింద కింద చూపియవా"
