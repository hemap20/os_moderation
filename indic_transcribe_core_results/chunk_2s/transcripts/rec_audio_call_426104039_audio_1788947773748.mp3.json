{
  "file_id": "rec_audio_call_426104039_audio_1788947773748.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 217.398,
  "processing_time_sec": 15.662584781646729,
  "segments": [
    {
      "t": "00:00",
      "text": "ஆ"
    },
    {
      "t": "00:02",
      "text": "ஹலோ"
    },
    {
      "t": "00:04",
      "text": "ஓகே"
    },
    {
      "t": "00:06",
      "text": "ஹலோ"
    },
    {
      "t": "00:08",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:10",
      "text": "ம்"
    },
    {
      "t": "00:12",
      "text": "ஹலோ கேட்குதா"
    },
    {
      "t": "00:14",
      "text": "ஆ கேட்குது சொல்லுங்கள்"
    },
    {
      "t": "00:16",
      "text": "ம் சாப்பிட்டாச்சா என்ன"
    },
    {
      "t": "00:18",
      "text": "பண்ணிக்கிறீங்க"
    },
    {
      "t": "00:20",
      "text": "இன்ட்ராக்ட் ஆகி எந்த ஒரு"
    },
    {
      "t": "00:22",
      "text": "நான் புதுக்கோட்டை"
    },
    {
      "t": "00:24",
      "text": "ஓகே"
    },
    {
      "t": "00:26",
      "text": "சரி சரிங்க"
    },
    {
      "t": "00:28",
      "text": "வேறு"
    },
    {
      "t": "00:30",
      "text": "கேஸ்"
    },
    {
      "t": "00:32",
      "text": "ஸ்விம்"
    },
    {
      "t": "00:34",
      "text": "நைஸ் நேம்"
    },
    {
      "t": "00:36",
      "text": "தேங்க் யூ என்ன பண்ணிக்கிறீங்க"
    },
    {
      "t": "00:38",
      "text": "எப்"
    },
    {
      "t": "00:40",
      "text": "இன்னும் கொஞ்சம் ரெஸ்ட்டுங்க இன்னைக்கு வர"
    },
    {
      "t": "00:42",
      "text": "ஓ"
    },
    {
      "t": "00:44",
      "text": "டூ டூ"
    },
    {
      "t": "00:46",
      "text": "என்ன ஒர்க்கு"
    },
    {
      "t": "00:48",
      "text": "ஆ"
    },
    {
      "t": "00:50",
      "text": "நானா என்னத்தை கேட்குறீயே"
    },
    {
      "t": "00:52",
      "text": "சாப்பிடலான்னு கேட்குறீங்களா என்ன"
    },
    {
      "t": "00:54",
      "text": "நன்கெதையாக"
    },
    {
      "t": "00:56",
      "text": "மூணு ஹவுஸ் ஹவுஸ்"
    },
    {
      "t": "00:58",
      "text": "ஹவுஸ் ஒய்ஃப் தான் வீட்டு வேலை பார்த்துக்கிட்ருக்குறேன்"
    },
    {
      "t": "01:00",
      "text": "சரி சரி"
    },
    {
      "t": "01:02",
      "text": "ஓகே"
    },
    {
      "t": "01:04",
      "text": "சரிங்க"
    },
    {
      "t": "01:06",
      "text": "ம் அப்புறம் வீட்டில்"
    },
    {
      "t": "01:08",
      "text": "எல்லாரும் நல்லா இருக்காங்களா"
    },
    {
      "t": "01:10",
      "text": "அதுக்கு என்ன ஸ்பெஷல்"
    },
    {
      "t": "01:12",
      "text": "நிக்கிலஸ் ப்ரெஷர்ஸ்"
    },
    {
      "t": "01:14",
      "text": "சாப்பாடு ஏன் ஒரு சிலப்பம்"
    },
    {
      "t": "01:16",
      "text": "தொழிலே"
    },
    {
      "t": "01:18",
      "text": "எப்பவும் போல் தயிர் சாப்பாடு தான்"
    },
    {
      "t": "01:20",
      "text": "அச்சச்சா"
    },
    {
      "t": "01:22",
      "text": "அதெல்லாம் சாப்பிடா நீங்கன்னா ஐயர் வீட்டு பையனா"
    },
    {
      "t": "01:24",
      "text": "இல்லை இல்லைங்க"
    },
    {
      "t": "01:26",
      "text": "ஆ அப்போ என் தாயி சாப்பாடு"
    },
    {
      "t": "01:28",
      "text": "இந்த வெயிலுக்கு தயிர் சாப்பாடு தான் நல்லா இருக்கும்"
    },
    {
      "t": "01:30",
      "text": "நல்லது என்னதான் தயிர்"
    },
    {
      "t": "01:32",
      "text": "சாப்பாடும் அது ஒரு இதாக தான் இருக்கும்"
    },
    {
      "t": "01:34",
      "text": "டென்ஷன் ஆகும் ம் ம்"
    },
    {
      "t": "01:36",
      "text": "ஆ"
    },
    {
      "t": "01:38",
      "text": "தலை தை இது பயிரிண்டா"
    },
    {
      "t": "01:40",
      "text": "பேச்சுலர்னு வேலை தேவைப்படுறது"
    },
    {
      "t": "01:42",
      "text": "அப்புறம்"
    },
    {
      "t": "01:44",
      "text": "கடையில் போய் பிரியாணி வாங்கி"
    },
    {
      "t": "01:46",
      "text": "நீ திங்க வேண்டியதுதானே"
    },
    {
      "t": "01:48",
      "text": "ஆப்பிள் ஆனதுக்கு பட்ஜெட் வேணுங்களா"
    },
    {
      "t": "01:50",
      "text": "ஆமாம் அதுவும் வேணும்"
    },
    {
      "t": "01:52",
      "text": "இதுதான் இரநூறுவா முந்நூறுவா"
    },
    {
      "t": "01:54",
      "text": "ப்ரோன்னு விற்கிது சாப்பாடு"
    },
    {
      "t": "01:56",
      "text": "ஆமாம்"
    },
    {
      "t": "01:58",
      "text": "சரி"
    },
    {
      "t": "02:00",
      "text": "நல்லா இருக்குங்க டயபெட்டிஸ் பண்ணுறீங்க"
    },
    {
      "t": "02:02",
      "text": "நான் நேற்று தான் என்னை"
    },
    {
      "t": "02:04",
      "text": "ஃபோன் நோட் பண்ணு"
    },
    {
      "t": "02:06",
      "text": "இந்த ஆர்டர் பண்ணி"
    },
    {
      "t": "02:08",
      "text": "அப்போ இப்போ தான் வெரிஃபிகேஷனுக்கு ஃபோன் எடுக்கணும்"
    },
    {
      "t": "02:10",
      "text": "படிச்சாங்க அவங்க"
    },
    {
      "t": "02:12",
      "text": "வெரிஃபிகேஷன் பண்ணவும் இப்போ காசு"
    },
    {
      "t": "02:14",
      "text": "வருது ஆ"
    },
    {
      "t": "02:16",
      "text": "ஆ"
    },
    {
      "t": "02:18",
      "text": "ம் கேட்குறாங்க கால்ஸ்"
    },
    {
      "t": "02:20",
      "text": "பேசினீங்களான்னு ஒரு காலத்துலேயும் பேசினா ஒரு பத்து"
    },
    {
      "t": "02:22",
      "text": "பத்து கால் பீஸ் இருப்பேன் அப்புடின்ட்டு"
    },
    {
      "t": "02:24",
      "text": "ம்"
    },
    {
      "t": "02:26",
      "text": "நான் சும்மா தான் டவுனோட"
    },
    {
      "t": "02:28",
      "text": "பண்ணிணேன் ஒரு அக்கா சொன்னாங்க இந்த ஆப்"
    },
    {
      "t": "02:30",
      "text": "அப்போ ஈத்து அப்படின்ட்டு"
    },
    {
      "t": "02:32",
      "text": "ம் சும்மா தான் டவுன்லோட் பண்ணி"
    },
    {
      "t": "02:34",
      "text": "ஓப்பன் பண்ணி பார்த்தா அது வருது கால் வருது"
    },
    {
      "t": "02:36",
      "text": "இல்லை"
    },
    {
      "t": "02:38",
      "text": "ஆ"
    },
    {
      "t": "02:40",
      "text": "உங்களுக்கு வந்துட்டு ஒரு ஒரு பொருள்"
    },
    {
      "t": "02:42",
      "text": "ஓஹோ"
    },
    {
      "t": "02:44",
      "text": "ஒவ்வொருத்தவங்களும் நல்லா பேசுகிறாங்க"
    },
    {
      "t": "02:46",
      "text": "ஆனால் ஹண்ட்ரட் பர்சன்ட் உங்களை மட்டும்"
    },
    {
      "t": "02:48",
      "text": "பேச மாட்டேறாங்க"
    },
    {
      "t": "02:50",
      "text": "ம் வேற எப்படி வேணாலும்"
    },
    {
      "t": "02:52",
      "text": "அப்படித்தான் பேசுகிறாங்க"
    },
    {
      "t": "02:54",
      "text": "ஏன் ரூடாக பேசுகிறாங்களா"
    },
    {
      "t": "02:56",
      "text": "ஆமாம் ம்"
    },
    {
      "t": "02:58",
      "text": "ம் ரொம்ப தான் இதாக பேசுறாங்க"
    },
    {
      "t": "03:00",
      "text": "என்ன சொன்னாங்க"
    },
    {
      "t": "03:02",
      "text": "ஓகே சார்"
    },
    {
      "t": "03:04",
      "text": "அதுதான் அந்த செக்ஸ் பண்ணுறது பிடிக்குமா போய்"
    },
    {
      "t": "03:06",
      "text": "அப்ளை பண்ணலாமா"
    },
    {
      "t": "03:08",
      "text": "ஆ அதான் கேட்குறாங்க வேற என்ன தேவை"
    },
    {
      "t": "03:10",
      "text": "இது ஜோக் தான்"
    },
    {
      "t": "03:12",
      "text": "ம்"
    },
    {
      "t": "03:14",
      "text": "ம்"
    },
    {
      "t": "03:16",
      "text": "ம்"
    },
    {
      "t": "03:18",
      "text": "நல்லா இருக்கட்டும் என்ன பண்ணுறது"
    },
    {
      "t": "03:20",
      "text": "ஆமாம் இதுதான் பண்ணணும்"
    },
    {
      "t": "03:22",
      "text": "ம்"
    },
    {
      "t": "03:24",
      "text": "வந்துட்டோம் இப்படி தான் பேசுவாங்கன்னு தெரியும்"
    },
    {
      "t": "03:26",
      "text": "அப்புறம் என்ன பண்ணுறது"
    },
    {
      "t": "03:28",
      "text": "பேசிட்டு போக வேண்டியதுதாங்க"
    },
    {
      "t": "03:30",
      "text": "பேசுறதுல என்ன வரப்போகுது ஒன்னு வரப்போகுது"
    },
    {
      "t": "03:32",
      "text": "அதில் பேசிட்டு போக வேண்டியது தான்"
    },
    {
      "t": "03:34",
      "text": "ம்"
    },
    {
      "t": "03:36",
      "text": "உப்பு சம்பா தானே"
    }
  ],
