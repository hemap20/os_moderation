{
  "file_id": "rec_audio_call_426857427_audio_1789021321811.mp3",
  "language": "kannada",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 702.721125,
  "processing_time_sec": 259.8043575286865,
  "segments": [
    {
      "t": "00:00",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": "ಹಲೋ ಹಾಂ"
    },
    {
      "t": "00:06",
      "text": "ಆಯ್"
    },
    {
      "t": "00:08",
      "text": "ಶ್ರೀನಾಥ್"
    },
    {
      "t": "00:10",
      "text": "ನಿಮ್ಮ ಹೆಸರು"
    },
    {
      "t": "00:12",
      "text": "ವಿಶಾಲತೆ"
    },
    {
      "t": "00:14",
      "text": "ಯಾವ ಊರು"
    },
    {
      "t": "00:16",
      "text": "ಬೆಂಗ್ಳೂರು ಒಂದು"
    },
    {
      "t": "00:18",
      "text": "ನಂದು ಬೆಂಗ್ಳೂರು"
    },
    {
      "t": "00:20",
      "text": "ಧನ್ಯವಾದಗಳು"
    },
    {
      "t": "00:22",
      "text": "ಏನು ಹೇಳು"
    },
    {
      "t": "00:24",
      "text": "ಏನು ಮಾಡ್ಕೊಂಡು"
    },
    {
      "t": "00:26",
      "text": "ನಾನು ಬ್ಯಾಂಕಲ್ಲಿ ವರ್ಕ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "00:28",
      "text": "ಮಾಡ್ತೀನಿ ನೀವು"
    },
    {
      "t": "00:30",
      "text": "ಯಾವ ಬ್ಯಾಂಕು"
    },
    {
      "t": "00:32",
      "text": "ಬಂಧನ್ ಬ್ಯಾಂಕು"
    },
    {
      "t": "00:34",
      "text": "ಓ ಮೈ ಗಾಡ್"
    },
    {
      "t": "00:36",
      "text": "ನಾನು ಚೆನ್ನಾ ಸ್ಮಾಲ್ ಫಿನಾನ್ಸ್"
    },
    {
      "t": "00:38",
      "text": "ಬ್ಯಾಂಕಲ್ಲಿ ವರ್ಕ್ ಮಾಡೋದು"
    },
    {
      "t": "00:40",
      "text": "ಓಹೋಕೆ"
    },
    {
      "t": "00:42",
      "text": "ಆ ಕಡೆ ಇರೋದು ನನಗೆ"
    },
    {
      "t": "00:44",
      "text": "ಕೆ ಆರ್ ಪುರಮ್"
    },
    {
      "t": "00:46",
      "text": "ನೀವಿರೋದು"
    },
    {
      "t": "00:48",
      "text": "ಫೋರ್ ಮಂತ್ಸ್"
    },
    {
      "t": "00:50",
      "text": "ಓಪನ್ ಮಾಡಲಾ ಓಕೆ"
    },
    {
      "t": "00:52",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:54",
      "text": "ಮತ್ತೆ ಟಿಪ್ ಒನ್ ಆಯಿತಾ"
    },
    {
      "t": "00:56",
      "text": "ಕ್ಯಾನ್ಸರ್ನ ಆಯ್ತು"
    },
    {
      "t": "00:58",
      "text": "ಹೀಗೆ ಮುದ್ದೆ ಆಯಿತಾ"
    },
    {
      "t": "01:00",
      "text": "ನಂದಾಯಿತು"
    },
    {
      "t": "01:02",
      "text": "ಇವತ್ತು ಹೋಗಿ ಅಲ್ವಾ ಲೈವ್"
    },
    {
      "t": "01:04",
      "text": "ಇವತ್ತು ಲೀವಲ್ಲಿದ್ದೆ ನೀನು"
    },
    {
      "t": "01:06",
      "text": "ನಾನು ಅಷ್ಟೇ"
    },
    {
      "t": "01:08",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:10",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:12",
      "text": "ಮತ್ತೇನು ಸಮಸ್ಯೆದ"
    },
    {
      "t": "01:14",
      "text": "ಏಳು ಓಕೆನಾ"
    },
    {
      "t": "01:16",
      "text": "ಹೀಗೆ"
    },
    {
      "t": "01:18",
      "text": "ಹೇಗೆ ನಡೀತಿದೆ ಟೂರಿಸಂ"
    },
    {
      "t": "01:20",
      "text": "ಚಿನ್ನ"
    },
    {
      "t": "01:22",
      "text": "ಎಂದು"
    },
    {
      "t": "01:24",
      "text": "ನಮ್ಮದು"
    },
    {
      "t": "01:26",
      "text": "ಥ್ಯಾಂಕ್ ಯು"
    },
    {
      "t": "01:28",
      "text": "ನಮ್ಮ ಹಸಿಮು"
    },
    {
      "t": "01:30",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:32",
      "text": "ನಿಮ್ಮ ಪೇಪರ್ ಇವರು"
    },
    {
      "t": "01:34",
      "text": "ದಾವಣಗೆರೆ"
    },
    {
      "t": "01:36",
      "text": "ಓಕೆ ಇಲ್ಲಿ ಫ್ಯಾಮಿಲಿ ಮ್ಯಾರೀಡಾ ನೀವು"
    },
    {
      "t": "01:38",
      "text": "ಇನ್ನು ಮತ್ತೆ"
    },
    {
      "t": "01:40",
      "text": "ಪೇಜ್ ಹೇಳ್ರಿ"
    },
    {
      "t": "01:42",
      "text": "ಎಲ್ಲ"
    },
    {
      "t": "01:44",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:46",
      "text": "ಮ್ಯಾರೀಡಾ ನೀವು"
    },
    {
      "t": "01:48",
      "text": "ನಾನು ಮ್ಯಾರೀಡ್ ಅದ್ರಾಗೆ ಕೇಳಿದೆ"
    },
    {
      "t": "01:50",
      "text": "ನಾನು"
    },
    {
      "t": "01:52",
      "text": "ತಿಳಿಯೋಕೆ ಬಂದಿದ್ದೀರಾ ನೀವು ವಯಸ್ಸು ಕಂಡು"
    },
    {
      "t": "01:54",
      "text": "ನನ್ನ ಪ್ರಕಾರ"
    },
    {
      "t": "01:56",
      "text": "ವ್ಯಾಪಾರ ಬಂದವರು ನನ್ನ ಆಂಧ್ರ ಕಡೆ"
    },
    {
      "t": "01:58",
      "text": "ಇಲ್ಲಿ ಏರಿಯಾ ಮ್ಯಾನೇಜರ್ ಆಗಿದ್ದೀನಿ"
    },
    {
      "t": "02:00",
      "text": "ಓಕೆ ಓ"
    },
    {
      "t": "02:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:06",
      "text": "ನಿಮ್ಮ ಫ್ಯಾಮಿಲಿ ಅವರೆಲ್ಲ ಅಲ್ಲಿ ಇರೋದಾ"
    },
    {
      "t": "02:08",
      "text": "ಹೌದು"
    },
    {
      "t": "02:10",
      "text": "ಹೌದು"
    },
    {
      "t": "02:12",
      "text": "ನೀವೇನು ಪೇಜ್ ಇದೆ ಗೊತ್ತಾಯ್ತಮ್ಮ"
    },
    {
      "t": "02:14",
      "text": "ಇಲ್ಲೇ ರೂಮ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀನಿ ಮುಂಚೆ"
    },
    {
      "t": "02:16",
      "text": "ಅಲ್ಲೇ ವರ್ಕ್ ಮಾಡ್ತೀವಿ ನಮ್ಮೂರಿಂದನೇ ಅಲ್ಲಿಂದ ಟೆನ್"
    },
    {
      "t": "02:18",
      "text": "ಬರ್ಬೋದು ಇಲ್ಲಿಗೆ ಪ್ರಮೋಷನ್ ಕೊಟ್ಟರು"
    },
    {
      "t": "02:20",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "02:22",
      "text": "ಪ್ಯಾಕೇಜ್ ಎಲ್ಲ ಚೆನ್ನಾಗಿ ಕೊಟ್ಟಿದ್ದಾರಾ"
    },
    {
      "t": "02:24",
      "text": "ಹಾಂ ಚೆನ್ನಾಗಿದೆ ಇಡೀ ಇಡೀ"
    },
    {
      "t": "02:26",
      "text": "ಏಯ್ಟಿ ಫೈವ್ ಬರುತ್ತೆ"
    },
    {
      "t": "02:28",
      "text": "ಸಾಕು ನೋಡಿ"
    },
    {
      "t": "02:30",
      "text": "ಲೀವ್ಗಳು ಇನ್ನೇನು ಚೆನ್ನಾಗೆ ಇರುತ್ತಾ ಬ್ಯಾಂಕ್"
    },
    {
      "t": "02:32",
      "text": "ಕರ್ಸಿಗೆ"
    },
    {
      "t": "02:34",
      "text": "ಹೌದು ಈ ಸ್ಯಾಟರ್ಡೆ ಸಂಡೇ ಮಂಡೇ"
    },
    {
      "t": "02:36",
      "text": "ಮುಗಿಸೇ ಗಲಿವು"
    },
    {
      "t": "02:38",
      "text": "ನಂಗೂ ಅಷ್ಟೇ ನಾನು ನಾಳೆ ಊರಿಗೆ ಹೋಗ್ತೀನಿ"
    },
    {
      "t": "02:40",
      "text": "ಹಾಂ ಓಕೆ"
    },
    {
      "t": "02:42",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:44",
      "text": "ಎಷ್ಟು ದಿನ ಆಯ್ತು"
    },
    {
      "t": "02:46",
      "text": "ಆ್ಯಪ್ ಯೂಸ್ ಮಾಡೋಕೆ ಶುರು ಮಾಡಿ"
    },
    {
      "t": "02:48",
      "text": "ನಾನು ನಿನ್ನೆ ಬಂದೆ ಒಬ್ಬನೇ ಇರ್ತೀನಿ ಬೆಂಗಳೂರಿಗೆ"
    },
    {
      "t": "02:50",
      "text": "ಯಾರೋ ಪೆನ್ಸಿಲ್ ತಗೊಂಡು ಬಂದೆ"
    },
    {
      "t": "02:52",
      "text": "ನಾನು ಬಂದು ಒಂದು ಮಂತ್ ಆಯ್ತು ಇಲ್ಲಿ ಬೆಂಗ್ಳೂರಿಗೆ"
    },
    {
      "t": "02:54",
      "text": "ಅಷ್ಟೇನಾ"
    },
    {
      "t": "02:56",
      "text": "ಹಾಂ ಹಾಂ"
    },
    {
      "t": "02:58",
      "text": "ಹಾಂ ಚೆನ್ನಾಗ್ ಅನಿಸ್ತಿದ್ಯಾ"
    },
    {
      "t": "03:00",
      "text": "ಏನಿಲ್ಲ"
    },
    {
      "t": "03:02",
      "text": "ಬೆಂಗ್ಳೂರು ಚೆನ್ನಾಗ್ ಅನ್ನಿಸ್ತಾ ಇದೆ"
    },
    {
      "t": "03:04",
      "text": "ಆಕ್ಚುಲಿ ಹೊಸ ಊರಲ್ವಾ"
    },
    {
      "t": "03:06",
      "text": "ಅಡ್ಜಸ್ಟ್ ಆಗಬೇಕು"
    },
    {
      "t": "03:08",
      "text": "ಬೇಕಲ್ವಾ ನಮಗೂ"
    },
    {
      "t": "03:10",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:12",
      "text": "ಆಗುತ್ತೆ ಬಿಡಿ ತಲೆ ಕೆಡಿಸ್ಕೊಬೋದು"
    },
    {
      "t": "03:14",
      "text": "ಬೆಂಗಳೂರು ತುಂಬ ಚೆನ್ನಾಗಿದೆ"
    },
    {
      "t": "03:16",
      "text": "ಎಲ್ರಿಗೂ ಅಡ್ಜಸ್ಟ್ ಆಗುತ್ತೆ"
    },
    {
      "t": "03:18",
      "text": "ನೀವು ಇಜ್ಲಾಯ್ತು ಪಂಕ್ತಿ"
    },
    {
      "t": "03:20",
      "text": "ನಾ"
    },
    {
      "t": "03:22",
      "text": "ಬೆಂಗ್ಳೂರು ಬಂದು ಮೂರು ವರ್ಷ ಆಯಿತು"
    },
    {
      "t": "03:24",
      "text": "ಓಕೆ"
    },
    {
      "t": "03:26",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:28",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:30",
      "text": "ಮತ್ತೆ ಹಿಂಗೆ ತಿಂದು ನಿಲ್ಲೋಕೆ"
    },
    {
      "t": "03:32",
      "text": "ದೋಸೆ ಮಾಡಿದೆ"
    },
    {
      "t": "03:34",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:36",
      "text": "ಆಚೆನಾ"
    },
    {
      "t": "03:38",
      "text": "ಹೌದು"
    },
    {
      "t": "03:40",
      "text": "ಹಾಂ ಫುಡ್ ಎಲ್ಲ ಸೇರಿಸಿ"
    },
    {
      "t": "03:42",
      "text": "ಸೆಟ್ ಆಯಿತಾ"
    },
    {
      "t": "03:44",
      "text": "ಸೆಟ್ ಆಗಬೇಕು ಸೆಟ್"
    },
    {
      "t": "03:46",
      "text": "ಮಾಡ್ಕೊಬೇಕು ನಾವೇ"
    },
    {
      "t": "03:48",
      "text": "ಇಲ್ಲ ಏನು ಗೊತ್ತಾ ಬೆಂಗಳೂರು ಪೇಜಿಗೆ"
    },
    {
      "t": "03:50",
      "text": "ಅಲ್ಲೆಲ್ಲ ಜಾಸ್ತಿ ಆಂಧ್ರ ಪಿ ಜಿಗಳು"
    },
    {
      "t": "03:52",
      "text": "ಇರೋದಾ ಫುಡ್ ಎಲ್ಲ ನಿಮ್ಗೆ"
    },
    {
      "t": "03:54",
      "text": "ಅಡ್ಜಸ್ಟ್ ಆಗೋ ಥರಾನೇ ಇರುತ್ತೆ"
    },
    {
      "t": "03:56",
      "text": "ಅದೇನು ವರಿ ಮಾಡ್ಕೊ ಆಂಧ್ರ ಆಂಧ್ರ"
    },
    {
      "t": "03:58",
      "text": "ಅಂದ್ರೆ ನಮ್ದು ಆಂಧ್ರ ಅಲ್ಲ ಕರ್ನಾಟಕ ಬಾರ್ಡರ್"
    },
    {
      "t": "04:00",
      "text": "ಯಾವ ಊರು"
    },
    {
      "t": "04:02",
      "text": "ಇತ್ಕಡೆ"
    },
    {
      "t": "04:04",
      "text": "ಈ ಜಾಬ್ ಕಡೆ ಗಮನ ಕೊಡೋದು ಕುಪ್ಪಂ"
    },
    {
      "t": "04:06",
      "text": "ಕೇಳೋದ್ ಅಂತ"
    },
    {
      "t": "04:08",
      "text": "ಸೈಡು ಆಂ"
    },
    {
      "t": "04:10",
      "text": "ಕೊಲ್ಲೋಣ"
    },
    {
      "t": "04:12",
      "text": "ಕೋಲಾರ ಸೈಡಾ"
    },
    {
      "t": "04:14",
      "text": "ಕಲಾ ಮಹಾರಾಜರು"
    },
    {
      "t": "04:16",
      "text": "ನೈನ್ಲಿ"
    },
    {
      "t": "04:18",
      "text": "ಹೌದು"
    },
    {
      "t": "04:20",
      "text": "ನಾನು ಫಸ್ಟ್"
    },
    {
      "t": "04:22",
      "text": "ಬೆಂಗಳೂರಿಗೆ ಬಂದಾಗ ಅಲ್ಲಿ ಕೋಲಾರ"
    },
    {
      "t": "04:24",
      "text": "ನಸ್ಲಾಪುರ"
    },
    {
      "t": "04:26",
      "text": "ಅದ್ರಲ್ಲಿ ಒಂದು ಐಫೋನ್ ಮ್ಯಾನುಫ್ಯಾಕ್ಚರಿಂಗ್ ಕಂಪನಿ ಇದೆ"
    },
    {
      "t": "04:28",
      "text": "ಗೊತ್ತಿಲ್ಲ"
    },
    {
      "t": "04:30",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:32",
      "text": "ವಿಸ್ಟ್ರಾನ್ ಅಂತ ಇತ್ತು ಇವಾಗ"
    },
    {
      "t": "04:34",
      "text": "ಸ್ಟಾರ್ಟ್ ಆಗಿದೆ"
    },
    {
      "t": "04:36",
      "text": "ಟಾಯ್ಲೆಟ್ಸ್ ಆಗಿದೆ"
    },
    {
      "t": "04:38",
      "text": "ಅಲ್ಲೇ ಫಸ್ಟ್ ನಾನು"
    },
    {
      "t": "04:40",
      "text": "ವರ್ಕ್ ಮಾಡಿದ್ದು"
    },
    {
      "t": "04:42",
      "text": "ಓಕೆ ಎಷ್ಟು ದಿನ ಮಾಡ್ತೀರಿ ನೀವು ಇಲ್ಲಿ ವರ್ಕು"
    },
    {
      "t": "04:44",
      "text": "ಓಹ್"
    },
    {
      "t": "04:46",
      "text": "ಅಲ್ಲ ಅಲ್ಲೊಂದು"
    },
    {
      "t": "04:48",
      "text": "ಟೆನ್ ಮಂತ್ಸ್ ಮಾಡಿದೆ"
    },
    {
      "t": "04:50",
      "text": "ಸಿಕ್ಕಾಪಟ್ಟೆ ಕಷ್ಟ ಆಯಿತು ಅಲ್ಲೆಲ್ಲ"
    },
    {
      "t": "04:52",
      "text": "ಇವುಗಳು ಇರ್ತಾ ಇರ್ಲಿಲ್ವಾ ಬೇರೆ"
    },
    {
      "t": "04:54",
      "text": "ಕಡೆ ಇಂಟರ್ವ್ಯೂ ಕೊಡೋಕು ಆಗ್ತಿರ್ಲಿಲ್ಲ"
    },
    {
      "t": "04:56",
      "text": "ಅನ್ನಿಸ್ಬೇಕಾಗ್ಬಿಟ್ಟಿದೆ"
    },
    {
      "t": "04:58",
      "text": "ಆಮೇಲೆ ಅಲ್ಲಿ ಬಿಟ್ಟು"
    },
    {
      "t": "05:00",
      "text": "ಹ್ಞೂ ಮತ್ತೆ ಬೇಗ"
    },
    {
      "t": "05:02",
      "text": "ಬೆಂಗ್ಳೂರು ಬಂದು ಒನ್ ವೀಕ್ ಅಲ್ಲಿ"
    },
    {
      "t": "05:04",
      "text": "ಹೋಗಿಕೊಂಡೆ ಬೇರೆ ಕಡೆ ಅಲ್ಲಿ"
    },
    {
      "t": "05:06",
      "text": "ಹಿಂದಿನ ವರ್ಕು ಇದ್ರಲ್ಲಿ ಹಿಂದಿನ ಹಿಂದಿನ"
    },
    {
      "t": "05:08",
      "text": "ಇನ್ನೂರು ರೂಪಾಯಿ ಗೋಲ್ಡ್ ಲೋನ್"
    },
    {
      "t": "05:10",
      "text": "ಓಹ್ ಬೋಲ್ನಲ್ಲ"
    },
    {
      "t": "05:12",
      "text": "ಓಕೆ ಏನು ಕ್ಯಾಶರಾ ಬಿಸ್ನೆಸ್ಸಾ ಸೇಲ್ಸ್"
    },
    {
      "t": "05:14",
      "text": "ಸೇರಿಸಿ ಸೇರಿಸಿ"
    },
    {
      "t": "05:16",
      "text": "ಸೊ ಮುಂಚೆ ಆಪರೇಷನ್ ಅಲ್ಲಿ ಮಾಡ್ತಿದ್ದೆ"
    },
    {
      "t": "05:18",
      "text": "ಸಿಕ್ಕಾಪಟ್ಟೆ ಪ್ರೆಷರ್ ಕೊಡ್ತಾರೆ ಆ ಕಡೆ"
    },
    {
      "t": "05:20",
      "text": "ಸೇಲ್ಸು ಮಾಡಬೇಕು ಆಪ್ರೇಷನು ನೋಡ್ಬೇಕು"
    },
    {
      "t": "05:22",
      "text": "ಮಾಡ್ಕೋಬೇಕು ಅದೇ ಚಿ ಇವಾಗ"
    },
    {
      "t": "05:24",
      "text": "ಸೇರಿಸಿದ ಜಾನಪದ ಇಲ್ಲಿ"
    },
    {
      "t": "05:26",
      "text": "ಸಿಕ್ಸ್ ಮಂತ್ಸ್ ಆಯಿತು ನನ್ನ"
    },
    {
      "t": "05:28",
      "text": "ಜಾಯಿನ್ ಆಗಿ ಹಾಂ"
    },
    {
      "t": "05:30",
      "text": "ಹಾಂ ಇದು ಸೇಲ್ ಸೇಲ್ ಮಾಡ್ತೀವಿ"
    },
    {
      "t": "05:32",
      "text": "ಹಾಂ"
    },
    {
      "t": "05:34",
      "text": "ನಿಮ್ಗೆ ಇನ್ಸೆಂಟಿವ್ ಎಲ್ಲ ಬರುತ್ತಲ್ವಾ"
    },
    {
      "t": "05:36",
      "text": "ಹ್ಞೂ ಸೋಂಟು ಬಾರೋ"
    },
    {
      "t": "05:38",
      "text": "ಇರುತ್ತೆ ಬಟ್ ಕಷ್ಟ"
    },
    {
      "t": "05:40",
      "text": "ನಾನು ಗೋಲ್ಡ್ ಲೋನಲ್ಲಿ ಮಾಡೋದು"
    },
    {
      "t": "05:42",
      "text": "ಹೌದು ಗೋಲ್ಡನ್ನು ಅಂದರೆ"
    },
    {
      "t": "05:44",
      "text": "ಲೊಕೇಶನ್ ಮೇಲೆ ಡಿಪೆಂಡ್ ಆಗುತ್ತೆ"
    },
    {
      "t": "05:46",
      "text": "ಮಂಗಳಸೂರ್ ಕರಿಚೇರಿ ಅಲ್ವಾ"
    },
    {
      "t": "05:48",
      "text": "ಹೌದು ಕಡಿಮೆ ರೋಡ್"
    },
    {
      "t": "05:50",
      "text": "ಒಳ್ಳೆಯದೇ"
    },
    {
      "t": "05:52",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "05:54",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "05:56",
      "text": "ನೀನು ಮತ್ತೆ"
    },
    {
      "t": "05:58",
      "text": "ಹೇಳಿ ಕೇಳೋಣ"
    },
    {
      "t": "06:00",
      "text": "ನೀನಿಲ್ಲಮ್ಮ"
    },
    {
      "t": "06:02",
      "text": "ಏನಿಲ್ಲ ಕಲಾ"
    },
    {
      "t": "06:04",
      "text": "ಮಿಸ್ ಮಾಡ್ಕೋತಿದ್ದೀರಾ"
    },
    {
      "t": "06:06",
      "text": "ದಾಸವಾಳದ ದಿನಾಲು"
    },
    {
      "t": "06:08",
      "text": "ಫ್ಯಾಮಿಲಿ ಮಿಸ್ ಆಗುತ್ತೆ ಇನ್ನೇನು ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "06:10",
      "text": "ಮತ್ತು ಊರಿಗೋಸ್ಕರ"
    },
    {
      "t": "06:12",
      "text": "ಮಾಡಬೇಕಲ್ವಾ"
    },
    {
      "t": "06:14",
      "text": "ಓಕೆ ಇದು ಬೇರೆ ದಿವ್ಸ"
    },
    {
      "t": "06:16",
      "text": "ಇದೆಯಾ"
    },
    {
      "t": "06:18",
      "text": "ಇದೆ ಪಾಪು ಇದೆ"
    },
    {
      "t": "06:20",
      "text": "ಪನ್ ಪಾಪನಾ ಹೌದು"
    },
    {
      "t": "06:22",
      "text": "ಹೌದು ಅಕ್ಕ ಪಾಪ"
    },
    {
      "t": "06:24",
      "text": "ಕಂಡು"
    },
    {
      "t": "06:26",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "06:28",
      "text": "ಬಂದಾಗಿಂದ ಹೋಗಿಲ್ವಾ"
    },
    {
      "t": "06:30",
      "text": "ಏನಿಲ್ಲ"
    },
    {
      "t": "06:32",
      "text": "ಬೆಂಗಳೂರು ಬಂದಾಗಿಂದ ಹೋಗಿಲ್ವಾ"
    },
    {
      "t": "06:34",
      "text": "ಅವ್ರಿಗೆ ಇಲ್ಲ ಹೋಗ್ತೀನಿ"
    },
    {
      "t": "06:36",
      "text": "ನಾನು ಅದಕ್ಕೆ ಇಲ್ಲಿ ಕಾರ್ ತಗೊಂಡು"
    },
    {
      "t": "06:38",
      "text": "ಇಟ್ಕೊಂಡಿದ್ದೀನಿ ಯಾವಾಗ ಮುನ್ಸ್ಬಾರ್ದು ಕಲರ್"
    },
    {
      "t": "06:40",
      "text": "ಇನ್ನು ಟ್ರೈನಿಂಗ್ ಇನ್ನು"
    },
    {
      "t": "06:42",
      "text": "ಎಲ್ಲ ಹೋಗಲ್ಲ ತುಂಬ ಲೇಟ್ ಆಗುತ್ತೆ ಅಂದ್ಬಿಟ್ಟು ಕರಲ್ ಉಂಟು"
    },
    {
      "t": "06:44",
      "text": "ಹಾಂ"
    },
    {
      "t": "06:46",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "06:48",
      "text": "ಆ ಥರನೇ ಇದೆ"
    },
    {
      "t": "06:50",
      "text": "ಬಿಡಿ ಹೋಗಿ ಬರ್ಬೋದು ಕೇರ್ಫುಲ್"
    },
    {
      "t": "06:52",
      "text": "ಅಲ್ವಾ ಈ ಕಡೆ ಸೈಡ್ ಎಲ್ಲ ಇದ್ದಿದ್ದು"
    },
    {
      "t": "06:54",
      "text": "ಸ್ವಲ್ಪ ಕಷ್ಟ ಆಗ್ತಿತ್ತು"
    },
    {
      "t": "06:56",
      "text": "ಹೌದು ಹ್ಞೂ"
    },
    {
      "t": "06:58",
      "text": "ಅಲ್ಲಿಂದ ಅಲ್ಲೋಗಿ"
    },
    {
      "t": "07:00",
      "text": "ಹೋಗ್ಬೋದು ಏನು ಅನ್ಸೋಲ್ಲ"
    },
    {
      "t": "07:02",
      "text": "ಸರಿ"
    },
    {
      "t": "07:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "07:06",
      "text": "ಮತ್ತೆ ಇಡೀ ಅಂಶ"
    },
    {
      "t": "07:08",
      "text": "ಸಮಾಚಾರ ನೀನು ಹೇಳು"
    },
    {
      "t": "07:10",
      "text": "ಇಲ್ಲ ಅಮ್ಮ"
    },
    {
      "t": "07:12",
      "text": "ಮತ್ತು ಊರಿಗೆ ಹೋಗೋದು ನಾಳೆನಾ"
    },
    {
      "t": "07:14",
      "text": "ಹ್ಞೂ ನಾಳೆ ನಾಳೆ"
    },
    {
      "t": "07:16",
      "text": "ನಾಳೆ ಲೀವ್ ಇಲ್ಲ ನಾಳೆ ಆಫ್ಟರ್"
    },
    {
      "t": "07:18",
      "text": "ಪರ್ಮಿಷನ್ ತಗೊಂಡು ಹೋಗ್ತೀವಿ"
    },
    {
      "t": "07:20",
      "text": "ಹಾ ಹೋಗಿ ಸ್ಯಾಟರ್ಡೆ"
    },
    {
      "t": "07:22",
      "text": "ಸಂಡೆ ಮಂಡೆ ಮಂಡೆ ಬರ್ತೀನಿ"
    },
    {
      "t": "07:24",
      "text": "ಮಂಡೆನೆ ಹಬ್ಬ"
    },
    {
      "t": "07:26",
      "text": "ನಮ್ಮೂರಲ್ಲಿ ಪಂಚಮಿನು ಅವಾಗ್ಲೇ ಮಾಡ್ತೀವಿ"
    },
    {
      "t": "07:28",
      "text": "ನೋಡಬೇಕು ಸೊ ಮಂಡೆ ಬರಲ್ಲ"
    },
    {
      "t": "07:30",
      "text": "ಹಾಂ"
    },
    {
      "t": "07:32",
      "text": "ಟ್ಯೂಸ್ಡೇ ಇಲ್ಲಾಂದರೆ ವೆನ್ಸ್ಡೇ"
    },
    {
      "t": "07:34",
      "text": "ಬರಬೇಕು ಅಂತ ಅನ್ಕೊಂಡಿದ್ದೀನಿ ನಾನು ಇಲ್ಲಿ"
    },
    {
      "t": "07:36",
      "text": "ಬೇಕು ಒಂದು ಮಂತ್ ಆಯಿತು ಊರಿಗೆ ಹೋಗಿ"
    },
    {
      "t": "07:38",
      "text": "ಹೋಗೇ ಇಲ್ಲ"
    },
    {
      "t": "07:40",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "07:42",
      "text": "ಮಿಸ್ ಮಾಡ್ಕೋತಿದ್ದೀನಿ"
    },
    {
      "t": "07:44",
      "text": "ಇಲ್ಲಿ"
    },
    {
      "t": "07:46",
      "text": "ಈ ವೀಕೆಂಡ್ ಅಲ್ಲೆಲ್ಲ ಎಲ್ಲಿ ಹೋಗ್ತೀಯಾ ಏನು ಮಾಡ್ತೀಯಾ ಫಿಲ್ಮ್"
    },
    {
      "t": "07:48",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "07:50",
      "text": "ಈ ಥರ ಯಾರು ಇಲ್ಲ"
    },
    {
      "t": "07:52",
      "text": "ಫಿಫ್ಟೀನ್ ಡೇಸ್ ಕೊಂಡ್ ಟೈಮ್ ಹೋಗ್ತಿದೆ"
    },
    {
      "t": "07:54",
      "text": "ಇದು ಸ್ವಲ್ಪ"
    },
    {
      "t": "07:56",
      "text": "ಈ ಲಾಸ್ಟ್ ಮಂತ್"
    },
    {
      "t": "07:58",
      "text": "ಆಕ್ಟಿವಿಟೀಸು ಅದು ಇದು ಒಂದು"
    },
    {
      "t": "08:00",
      "text": "ಅಂತಂದು ಲೀವ್ ಟೈಮಲ್ಲೂನು"
    },
    {
      "t": "08:02",
      "text": "ಹೋಗೋಕ್ಕಾಗ್ಲಿಲ್ವಾ"
    },
    {
      "t": "08:04",
      "text": "ನಂಗೂ ಬೇರೆ ಹುಷಾರಿದೆಯಲ್ಲ"
    },
    {
      "t": "08:06",
      "text": "ಹಂಗಾಗಿ ಹೋಗಲಿಲ್ಲ ಸೆಕೆಂಡ್"
    },
    {
      "t": "08:08",
      "text": "ಸೆಕೆಂಡ್ ತರ್ಟೆಡ್ ಫೋರ್ತ್ ತರ್ಟೆಡ್ ನಾರ್ಮಲ್"
    },
    {
      "t": "08:10",
      "text": "ಹೋಗ್ಬೇಕು ತಾನೆ"
    },
    {
      "t": "08:12",
      "text": "ಮಾತ್ರ ಈ ಸಲನ ಎಲ್ಲೋ"
    },
    {
      "t": "08:14",
      "text": "ಹೋಗೋದಿಲ್ಲ ಸುಮ್ನೆ ಪಿ ಜಿ ಲೈನ್ಸ್ ಇದೆ"
    },
    {
      "t": "08:16",
      "text": "ಹೋದ್ರೆ ಆಫೀಸು ಇಲ್ಲಾಂದರೆ ಇಸ್ಕಾಂಟೆಂಟ್"
    },
    {
      "t": "08:18",
      "text": "ಅಷ್ಟೇ ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "08:20",
      "text": "ಅಪ್ಪ"
    },
    {
      "t": "08:22",
      "text": "ಬೋರಿಂಗ್ ಆಗ್ತಿತ್ತು"
    },
    {
      "t": "08:24",
      "text": "ಸೇಮ್ ನಂದೇದೇ ಪ್ರಾಬ್ಲಮ್"
    },
    {
      "t": "08:26",
      "text": "ಹಿಂದೆ"
    },
    {
      "t": "08:28",
      "text": "ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "08:30",
      "text": "ಏನೋ ಒಂಥರ"
    },
    {
      "t": "08:32",
      "text": "ಆಫೀಸ್ಗೆ ಹೋದ್ರೆ ಸ್ಕೂಲ್ ಯಾವ ಕಡೆ ಹೋಗ್ಬೇಕು"
    },
    {
      "t": "08:34",
      "text": "ಕೋ ಅನ್ಸುತ್ತೆ ಬೆಳಗ್ಗೆ ಬೆಳಗ್ಗೆನೆ ಆಡೋದು"
    },
    {
      "t": "08:36",
      "text": "ಒಂದು ಗಂಟೆ ತಗೋತಾರೆ"
    },
    {
      "t": "08:38",
      "text": "ಆದ"
    },
    {
      "t": "08:40",
      "text": "ಇನ್ನರ್ ಕಾಂಡ್ರ ಅಂತಾರ"
    },
    {
      "t": "08:42",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "08:44",
      "text": "ಏನು ಹೇಳಪ್ಪ ಅಂದರೆ"
    },
    {
      "t": "08:46",
      "text": "ಅನ್ಕಲ್ತವಂತಾರ ಅಂದೆ"
    },
    {
      "t": "08:48",
      "text": "ಕಾನ್ಕಾಲು ನಮ್ಗೆ"
    },
    {
      "t": "08:50",
      "text": "ರಿಮೋಟ್ ತಗೋತಾರೆ ಬ್ರಾಂಚ್ ಅವರು ಅಡಲ್ಟ್"
    },
    {
      "t": "08:52",
      "text": "ತಗೋತಾರೆ ನಮ್ದು ಬ್ರಾಂಡ್ ಪ್ಯಾಂಟಿಂಗ್ ವೈಸ್"
    },
    {
      "t": "08:54",
      "text": "ಈ ಕಡೆ ಇವರು"
    },
    {
      "t": "08:56",
      "text": "ರೂ ಸಾಯಿಸ್ತಾರೆ ಆ ಕಡೆ ನಮ್ಮ ಗೋಲ್ಡ್"
    },
    {
      "t": "08:58",
      "text": "ಟೀಮ್ ಅವರು ಸಾಯಿಸ್ತಾರೆ ಟಾರ್ಗೆಟ್"
    },
    {
      "t": "09:00",
      "text": "ಇಲ್ಲಾಂದ್ರೆ ಬಟ್ ಕಂಪ್ಲೀಟ್"
    },
    {
      "t": "09:02",
      "text": "ಟಾರ್ಗೆಟ್ ಎಲ್ಲ ಕೇಳಲ್ಲ ಪಾಪ ಒಳ್ಳೆಯವ್ರು ಇದ್ದಾರೆ"
    },
    {
      "t": "09:04",
      "text": "ಅರ್ಥ ಮಾಡ್ಕೋತಾರೆ ಗೋಲ್ಡ್ ಅಂತ"
    },
    {
      "t": "09:06",
      "text": "ಅಲ್ವಾ ಹೌದು"
    },
    {
      "t": "09:08",
      "text": "ಸುಮ್ಮನೆ ತಗೊಬಂದು ಇಡಲ್ಲ ಯಾರೂ"
    },
    {
      "t": "09:10",
      "text": "ಅವರು ಟ್ರಸ್ಟ್ ಬರಬೇಕು ನಮ್ಮ ಬ್ರ್ಯಾಂಡ್"
    },
    {
      "t": "09:12",
      "text": "ಕಾನ್ಸೋಲ್ ಇರೋರು ಅರ್ಥ ಮಾಡ್ಕೊಳಲ್ಲ ಹೆಂಗ"
    },
    {
      "t": "09:14",
      "text": "ಮಾಡ್ತಾರೆ ಗೊತ್ತಾ ಇವ್ರದ್ದೇ"
    },
    {
      "t": "09:16",
      "text": "ಅಷ್ಟೇ ನಂಗೆ ಅದೆಲ್ಲ ಗೊತ್ತಿಲ್ಲ ಬ್ರೇಕ್ ಅಷ್ಟೇ"
    },
    {
      "t": "09:18",
      "text": "ಅಂತಾರೆ ಹಂಗೆ ಹೇಳಿದಾಗೆಲ್ಲ ನಾನು ಸುಮ್ಮನೆ ಎದ್ದು ಬಂದ್ಬಿಟ್ಟೆ"
    },
    {
      "t": "09:20",
      "text": "ಹ್ಞೂ ಹ್ಞೂ ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "09:22",
      "text": "ಅಯ್ಯೋ ಎಲ್ಲಿಂದ ತಗೋ"
    },
    {
      "t": "09:24",
      "text": "ಬರೋಕಾಗುತ್ತೆ ನೀವೇ ಹೇಳಿ"
    },
    {
      "t": "09:26",
      "text": "ಅದು ಹೇಳು"
    },
    {
      "t": "09:28",
      "text": "ಹ್ಞೂ ಅದಕ್ಕೆ ಹೇಳ್ತಾರೆ"
    },
    {
      "t": "09:30",
      "text": "ಓಕೆ ಮಾಡ್ತೀನಿ ಅಂತ ಹೇಳ್ತೀನಿ"
    },
    {
      "t": "09:32",
      "text": "ಫಾಲೋ ಅಪ್ ಇರ್ತವೆ ನಮ್ದು ಹೆಂಗ್ ಗೊತ್ತಾ"
    },
    {
      "t": "09:34",
      "text": "ವಸ್ತು ಥಲೇ ವಸ್ತು"
    },
    {
      "t": "09:36",
      "text": "ಇವಾಗ ಇಲ್ಲಿ ಬರ್ತೀನಿ ಅಂತ ಹೇಳಿರ್ತಾರೆ"
    },
    {
      "t": "09:38",
      "text": "ಒನ್ ಅವರ್ ಸಾಕಲ್ವಾ ನಿಮಗೆ"
    },
    {
      "t": "09:40",
      "text": "ಎಂತ ಬ್ಯಾಂಕಿಗೆ ಹೋದ್ರು ಯಾವುದೇ"
    },
    {
      "t": "09:42",
      "text": "ಸಿಗೋದ್ರು ಇಪ್ಪತ್ತು"
    },
    {
      "t": "09:44",
      "text": "ಹತ್ತರಿಂದ ಮೂವತ್ತು ನಿಮಿಷದಲ್ಲಿ ಮಾಡಿ ಮುಗಿಸಿಬಿಡ್ತೇನೆ"
    },
    {
      "t": "09:46",
      "text": "ಮ್ಯಾಕ್ಸಿಮಮ್ ಒನ್ ಅವರ್ ಅಂದ್ಕೊಳ್ಳಿ"
    },
    {
      "t": "09:48",
      "text": "ಹೌದು ಇಲ್ಲಿಗೆ"
    },
    {
      "t": "09:50",
      "text": "ಹೇಳಿರ್ತಾರೆ ಬರ್ತೀನಿ ಓಕೆ ಹಂಗೆ ಹಿಂಗೆ"
    },
    {
      "t": "09:52",
      "text": "ಎಲ್ಲ ಹೇಳಿರ್ತಾರೆ ಒನ್ ವೀಕ್ ಒನ್ ಮಂತ್"
    },
    {
      "t": "09:54",
      "text": "ಚಿಂದ ಎಲ್ಲ ಫಾಲೋ ಅಪ್ ಇಟ್ಕೊಂಡಿರ್ತೀನಿ"
    },
    {
      "t": "09:56",
      "text": "ಮೇಡಮ್ ಇವತ್ತು ಬರ್ತೀನಿ ಇಲ್ಲ ನಾಳೆ ಬೆಳಗ್ಗೆ"
    },
    {
      "t": "09:58",
      "text": "ಮುಂಜಾನೆ ಬರ್ತೀನಿ ಮೇಡಮ್ ನಂಗೆ ಅರ್ಜೆಂಟ್ ಇದೆ ಹಂಗೆ"
    },
    {
      "t": "10:00",
      "text": "ಅಂತ ಹೇಳಿರ್ತಾರೆ ಕಾಲನ್ ಮಾಡಿದ್ರೆ ಫೋರ್"
    },
    {
      "t": "10:02",
      "text": "ರೆಸ್ಪಾಂಡ್ ಮಾಡಲ್ಲ ಆಮೇಲೆ"
    },
    {
      "t": "10:04",
      "text": "ಒಂದು ಸ್ವಲ್ಪ ದಿನ ಬಿಟ್ಟ ಮೇಲೆ ಗೊತ್ತಾಗುತ್ತೆ"
    },
    {
      "t": "10:06",
      "text": "ಇಲ್ಲ ಮೇಡಮ್ ಅಲ್ಲಿ ಇಂಟ್ರೆಸ್ಟ್ ಕಮ್ಮಿ"
    },
    {
      "t": "10:08",
      "text": "ಮತ್ತೆ ಗೊತ್ತಿರೋರು ಬೇರೆ ನಾವು ಇಂಟ್ರೆಸ್ಟ್"
    },
    {
      "t": "10:10",
      "text": "ಪೇ ಮಾಡಿಲ್ಲ ಅಂದ್ರೂ ಗೋಲ್ಡನ್ ಅಕ್ಷರ"
    },
    {
      "t": "10:12",
      "text": "ಆಗಲ್ಲ ನಿಮ್ಮದು ನಂಬಿಕೆ ಇಲ್ಲ ಮೇಡಮ್ ಅಲ್ಲಿ"
    },
    {
      "t": "10:14",
      "text": "ಏನು"
    },
    {
      "t": "10:16",
      "text": "ಏಳು ಅದು"
    },
    {
      "t": "10:18",
      "text": "ಇಲ್ಲ ಕೇಳೋದೇ ಇಲ್ಲ ಬರ್ತೀನಿ ಬರ್ತೀನಿ"
    },
    {
      "t": "10:20",
      "text": "ಡ್ರಾಪ್ ಕೊಟ್ಟು ಲಾಸ್ಟ್ ಮಿನಿಟೇ ತಯಾರಿಸಿಬಿಡ್ತೀನಿ"
    },
    {
      "t": "10:22",
      "text": "ಅಯ್ಯೋ"
    },
    {
      "t": "10:24",
      "text": "ಹಾಂ"
    },
    {
      "t": "10:26",
      "text": "ಕಷ್ಟಗಳು"
    },
    {
      "t": "10:28",
      "text": "ಅಂತ ಚೆನ್ನಾಗಿ"
    },
    {
      "t": "10:30",
      "text": "ಇರಲ್ಲ ಆದರೆ ಹೆಂಗ್ ಮಾಡೋದು"
    },
    {
      "t": "10:32",
      "text": "ಆಕ್ಟಿವೇಶನ್ ಆಯ್ತು ಅಂದ್ರೆ"
    },
    {
      "t": "10:34",
      "text": "ಯಾರು ಕೇಳಲ್ಲ ಇಷ್ಟು ಸ್ವಲ್ಪ"
    },
    {
      "t": "10:36",
      "text": "ಫಿಶ್ ಉಸಿರಾಡಕ್ಕೆ ಅಡ್ರ್ಗೆ"
    },
    {
      "t": "10:38",
      "text": "ಕೊಡ್ಸೋರೆ"
    },
    {
      "t": "10:40",
      "text": "ಆಯ್ತು ಅಂದ್ರೆ"
    },
    {
      "t": "10:42",
      "text": "ಡಯಾಬಿಟಿಸ್ಗೆಲ್ಲ ಹೋದ್ವಿ ಅಂದರೆ"
    },
    {
      "t": "10:44",
      "text": "ಎಲ್ಲ ಪ್ರಾಡಕ್ಟ್ಸು ಮಾಡಬೇಕು"
    },
    {
      "t": "10:46",
      "text": "ಹೌದಾ"
    },
    {
      "t": "10:48",
      "text": "ನೀವ್ಯಾವುದು"
    },
    {
      "t": "10:50",
      "text": "ಏನೇನು"
    },
    {
      "t": "10:52",
      "text": "ಅಂದ್ರೆ ಯಾವ್ದ್ರಲ್ಲಿ ಮಾಡೋದು ಯಾವ್ದು ಉಪಯೋಗ"
    },
    {
      "t": "10:54",
      "text": "ನನ್ನ ಮನೆ ಎನ್ ಪಿ ಎ"
    },
    {
      "t": "10:56",
      "text": "ಡಿಪಾರ್ಟ್ಮೆಂಟ್ ನಂದು"
    },
    {
      "t": "10:58",
      "text": "ಅಂದರೆ ಓಡಿ"
    },
    {
      "t": "11:00",
      "text": "ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "11:02",
      "text": "ಓಡಿ ಅಂದರೆ ಓಡಿ ಬರುತ್ತಲ್ವಾ"
    },
    {
      "t": "11:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "11:06",
      "text": "ಆ ಕಸ್ಟಮರ್ಸ್ಗೆ ನಾನು ಮಾಡಿದ ಕೈಯಲ್ಲಿ ನಾನು ಫಾಲೋ ಅಪ್ ಮಾಡಿಸ್ಬೇಕು"
    },
    {
      "t": "11:08",
      "text": "ಕಲೆಕ್ಷನ್ ಮಾಡ್ಸೋದು"
    },
    {
      "t": "11:10",
      "text": "ಹಾಂ ಹೌದು"
    },
    {
      "t": "11:12",
      "text": "ಅದು ಸ್ವಲ್ಪ ಇರಿಟೇಷನ್"
    },
    {
      "t": "11:14",
      "text": "ಸೊ ಐ"
    },
    {
      "t": "11:16",
      "text": "ಸೈಕೋ ಡಬಲ್ ಸೈಕ್ ಇದು"
    },
    {
      "t": "11:18",
      "text": "ಅಯ್ಯೋ ಇಲ್ಲಿ ನಾವು ಸರ್ವ"
    },
    {
      "t": "11:20",
      "text": "ಹೋಗ್ತಿದ್ದಾರೆ ಅವರು ಹೆಮ್ಮದಿ"
    },
    {
      "t": "11:22",
      "text": "ಅಂತ ಇರ್ತಾರೆ ಗೊತ್ತಾ ಅಂದ್ರೆ ಬೇರೆ ಬ್ರಾಂಚ್"
    },
    {
      "t": "11:24",
      "text": "ಮ್ಯಾನೇಜರು ಅವರು ಕನೆಕ್ಷನ್"
    },
    {
      "t": "11:26",
      "text": "ಸೆಕ್ಷನ್ನಲ್ಲೇ ಇರೋದು ಟ್ರಾನ್ಸ್ಲೇಟರು"
    },
    {
      "t": "11:28",
      "text": "ಅವರು ಒಂದೊಂದು ಸಲ"
    },
    {
      "t": "11:30",
      "text": "ಅಂದರೆ ಸ್ಟಾರ್ಟಿಂಗ್"
    },
    {
      "t": "11:32",
      "text": "ಅವ್ರದ್ದು ಅಂಚೆ ಟ್ರೈನಿಂಗ್ ಹೋದ್ರೆ ಫಸ್ಟ್"
    },
    {
      "t": "11:34",
      "text": "ಆಗಿದ್ರಲ್ಲ ನಾನು ಒಬ್ಬಳೇ"
    },
    {
      "t": "11:36",
      "text": "ಎಲ್ಲ ಸ್ವಲ್ಪ ಚಿಕ್ಕ ಹುಡುಗಿ ಅಂತ ಹೇಳಿ ಚೆನ್ನಾಗಿ ಮಾತಾಡಿ"
    },
    {
      "t": "11:38",
      "text": "ಅವಾಗ ಕಾಲ್ ಮಾಡ್ಬಿಟ್ಟು"
    },
    {
      "t": "11:40",
      "text": "ಐದು ಅಂಚು ನಂಬರ್ ಕೊಡ್ತೀನಿ"
    },
    {
      "t": "11:42",
      "text": "ಕೊಡ್ತೀನಿ"
    }
  ],
  "full_text": "ಹ್ಞೂ ಹಲೋ ಹಲೋ ಹಾಂ ಆಯ್ ಶ್ರೀನಾಥ್ ನಿಮ್ಮ ಹೆಸರು ವಿಶಾಲತೆ ಯಾವ ಊರು ಬೆಂಗ್ಳೂರು ಒಂದು ನಂದು ಬೆಂಗ್ಳೂರು ಧನ್ಯವಾದಗಳು ಏನು ಹೇಳು ಏನು ಮಾಡ್ಕೊಂಡು ನಾನು ಬ್ಯಾಂಕಲ್ಲಿ ವರ್ಕ್ ಮಾಡ್ತೀನಿ ಮಾಡ್ತೀನಿ ನೀವು ಯಾವ ಬ್ಯಾಂಕು ಬಂಧನ್ ಬ್ಯಾಂಕು ಓ ಮೈ ಗಾಡ್ ನಾನು ಚೆನ್ನಾ ಸ್ಮಾಲ್ ಫಿನಾನ್ಸ್ ಬ್ಯಾಂಕಲ್ಲಿ ವರ್ಕ್ ಮಾಡೋದು ಓಹೋಕೆ ಆ ಕಡೆ ಇರೋದು ನನಗೆ ಕೆ ಆರ್ ಪುರಮ್ ನೀವಿರೋದು ಫೋರ್ ಮಂತ್ಸ್ ಓಪನ್ ಮಾಡಲಾ ಓಕೆ ಹ್ಞೂ ಮತ್ತೆ ಟಿಪ್ ಒನ್ ಆಯಿತಾ ಕ್ಯಾನ್ಸರ್ನ ಆಯ್ತು ಹೀಗೆ ಮುದ್ದೆ ಆಯಿತಾ ನಂದಾಯಿತು ಇವತ್ತು ಹೋಗಿ ಅಲ್ವಾ ಲೈವ್ ಇವತ್ತು ಲೀವಲ್ಲಿದ್ದೆ ನೀನು ನಾನು ಅಷ್ಟೇ ಹ್ಞೂ ಹ್ಞೂ ಮತ್ತೇನು ಸಮಸ್ಯೆದ ಏಳು ಓಕೆನಾ ಹೀಗೆ ಹೇಗೆ ನಡೀತಿದೆ ಟೂರಿಸಂ ಚಿನ್ನ ಎಂದು ನಮ್ಮದು ಥ್ಯಾಂಕ್ ಯು ನಮ್ಮ ಹಸಿಮು ಹ್ಞೂ ನಿಮ್ಮ ಪೇಪರ್ ಇವರು ದಾವಣಗೆರೆ ಓಕೆ ಇಲ್ಲಿ ಫ್ಯಾಮಿಲಿ ಮ್ಯಾರೀಡಾ ನೀವು ಇನ್ನು ಮತ್ತೆ ಪೇಜ್ ಹೇಳ್ರಿ ಎಲ್ಲ ಹಾಂ ಮ್ಯಾರೀಡಾ ನೀವು ನಾನು ಮ್ಯಾರೀಡ್ ಅದ್ರಾಗೆ ಕೇಳಿದೆ ನಾನು ತಿಳಿಯೋಕೆ ಬಂದಿದ್ದೀರಾ ನೀವು ವಯಸ್ಸು ಕಂಡು ನನ್ನ ಪ್ರಕಾರ ವ್ಯಾಪಾರ ಬಂದವರು ನನ್ನ ಆಂಧ್ರ ಕಡೆ ಇಲ್ಲಿ ಏರಿಯಾ ಮ್ಯಾನೇಜರ್ ಆಗಿದ್ದೀನಿ ಓಕೆ ಓ ಹ್ಞೂ ಹ್ಞೂ ನಿಮ್ಮ ಫ್ಯಾಮಿಲಿ ಅವರೆಲ್ಲ ಅಲ್ಲಿ ಇರೋದಾ ಹೌದು ಹೌದು ನೀವೇನು ಪೇಜ್ ಇದೆ ಗೊತ್ತಾಯ್ತಮ್ಮ ಇಲ್ಲೇ ರೂಮ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀನಿ ಮುಂಚೆ ಅಲ್ಲೇ ವರ್ಕ್ ಮಾಡ್ತೀವಿ ನಮ್ಮೂರಿಂದನೇ ಅಲ್ಲಿಂದ ಟೆನ್ ಬರ್ಬೋದು ಇಲ್ಲಿಗೆ ಪ್ರಮೋಷನ್ ಕೊಟ್ಟರು ಓಕೆ ಓಕೆ ಪ್ಯಾಕೇಜ್ ಎಲ್ಲ ಚೆನ್ನಾಗಿ ಕೊಟ್ಟಿದ್ದಾರಾ ಹಾಂ ಚೆನ್ನಾಗಿದೆ ಇಡೀ ಇಡೀ ಏಯ್ಟಿ ಫೈವ್ ಬರುತ್ತೆ ಸಾಕು ನೋಡಿ ಲೀವ್ಗಳು ಇನ್ನೇನು ಚೆನ್ನಾಗೆ ಇರುತ್ತಾ ಬ್ಯಾಂಕ್ ಕರ್ಸಿಗೆ ಹೌದು ಈ ಸ್ಯಾಟರ್ಡೆ ಸಂಡೇ ಮಂಡೇ ಮುಗಿಸೇ ಗಲಿವು ನಂಗೂ ಅಷ್ಟೇ ನಾನು ನಾಳೆ ಊರಿಗೆ ಹೋಗ್ತೀನಿ ಹಾಂ ಓಕೆ ಹ್ಞೂ ಎಷ್ಟು ದಿನ ಆಯ್ತು ಆ್ಯಪ್ ಯೂಸ್ ಮಾಡೋಕೆ ಶುರು ಮಾಡಿ ನಾನು ನಿನ್ನೆ ಬಂದೆ ಒಬ್ಬನೇ ಇರ್ತೀನಿ ಬೆಂಗಳೂರಿಗೆ ಯಾರೋ ಪೆನ್ಸಿಲ್ ತಗೊಂಡು ಬಂದೆ ನಾನು ಬಂದು ಒಂದು ಮಂತ್ ಆಯ್ತು ಇಲ್ಲಿ ಬೆಂಗ್ಳೂರಿಗೆ ಅಷ್ಟೇನಾ ಹಾಂ ಹಾಂ ಹಾಂ ಚೆನ್ನಾಗ್ ಅನಿಸ್ತಿದ್ಯಾ ಏನಿಲ್ಲ ಬೆಂಗ್ಳೂರು ಚೆನ್ನಾಗ್ ಅನ್ನಿಸ್ತಾ ಇದೆ ಆಕ್ಚುಲಿ ಹೊಸ ಊರಲ್ವಾ ಅಡ್ಜಸ್ಟ್ ಆಗಬೇಕು ಬೇಕಲ್ವಾ ನಮಗೂ ಹ್ಞೂ ಆಗುತ್ತೆ ಬಿಡಿ ತಲೆ ಕೆಡಿಸ್ಕೊಬೋದು ಬೆಂಗಳೂರು ತುಂಬ ಚೆನ್ನಾಗಿದೆ ಎಲ್ರಿಗೂ ಅಡ್ಜಸ್ಟ್ ಆಗುತ್ತೆ ನೀವು ಇಜ್ಲಾಯ್ತು ಪಂಕ್ತಿ ನಾ ಬೆಂಗ್ಳೂರು ಬಂದು ಮೂರು ವರ್ಷ ಆಯಿತು ಓಕೆ ಹ್ಞೂ ಹ್ಞೂ ಮತ್ತೆ ಹಿಂಗೆ ತಿಂದು ನಿಲ್ಲೋಕೆ ದೋಸೆ ಮಾಡಿದೆ ಹ್ಞೂ ಆಚೆನಾ ಹೌದು ಹಾಂ ಫುಡ್ ಎಲ್ಲ ಸೇರಿಸಿ ಸೆಟ್ ಆಯಿತಾ ಸೆಟ್ ಆಗಬೇಕು ಸೆಟ್ ಮಾಡ್ಕೊಬೇಕು ನಾವೇ ಇಲ್ಲ ಏನು ಗೊತ್ತಾ ಬೆಂಗಳೂರು ಪೇಜಿಗೆ ಅಲ್ಲೆಲ್ಲ ಜಾಸ್ತಿ ಆಂಧ್ರ ಪಿ ಜಿಗಳು ಇರೋದಾ ಫುಡ್ ಎಲ್ಲ ನಿಮ್ಗೆ ಅಡ್ಜಸ್ಟ್ ಆಗೋ ಥರಾನೇ ಇರುತ್ತೆ ಅದೇನು ವರಿ ಮಾಡ್ಕೊ ಆಂಧ್ರ ಆಂಧ್ರ ಅಂದ್ರೆ ನಮ್ದು ಆಂಧ್ರ ಅಲ್ಲ ಕರ್ನಾಟಕ ಬಾರ್ಡರ್ ಯಾವ ಊರು ಇತ್ಕಡೆ ಈ ಜಾಬ್ ಕಡೆ ಗಮನ ಕೊಡೋದು ಕುಪ್ಪಂ ಕೇಳೋದ್ ಅಂತ ಸೈಡು ಆಂ ಕೊಲ್ಲೋಣ ಕೋಲಾರ ಸೈಡಾ ಕಲಾ ಮಹಾರಾಜರು ನೈನ್ಲಿ ಹೌದು ನಾನು ಫಸ್ಟ್ ಬೆಂಗಳೂರಿಗೆ ಬಂದಾಗ ಅಲ್ಲಿ ಕೋಲಾರ ನಸ್ಲಾಪುರ ಅದ್ರಲ್ಲಿ ಒಂದು ಐಫೋನ್ ಮ್ಯಾನುಫ್ಯಾಕ್ಚರಿಂಗ್ ಕಂಪನಿ ಇದೆ ಗೊತ್ತಿಲ್ಲ ಹ್ಞೂ ವಿಸ್ಟ್ರಾನ್ ಅಂತ ಇತ್ತು ಇವಾಗ ಸ್ಟಾರ್ಟ್ ಆಗಿದೆ ಟಾಯ್ಲೆಟ್ಸ್ ಆಗಿದೆ ಅಲ್ಲೇ ಫಸ್ಟ್ ನಾನು ವರ್ಕ್ ಮಾಡಿದ್ದು ಓಕೆ ಎಷ್ಟು ದಿನ ಮಾಡ್ತೀರಿ ನೀವು ಇಲ್ಲಿ ವರ್ಕು ಓಹ್ ಅಲ್ಲ ಅಲ್ಲೊಂದು ಟೆನ್ ಮಂತ್ಸ್ ಮಾಡಿದೆ ಸಿಕ್ಕಾಪಟ್ಟೆ ಕಷ್ಟ ಆಯಿತು ಅಲ್ಲೆಲ್ಲ ಇವುಗಳು ಇರ್ತಾ ಇರ್ಲಿಲ್ವಾ ಬೇರೆ ಕಡೆ ಇಂಟರ್ವ್ಯೂ ಕೊಡೋಕು ಆಗ್ತಿರ್ಲಿಲ್ಲ ಅನ್ನಿಸ್ಬೇಕಾಗ್ಬಿಟ್ಟಿದೆ ಆಮೇಲೆ ಅಲ್ಲಿ ಬಿಟ್ಟು ಹ್ಞೂ ಮತ್ತೆ ಬೇಗ ಬೆಂಗ್ಳೂರು ಬಂದು ಒನ್ ವೀಕ್ ಅಲ್ಲಿ ಹೋಗಿಕೊಂಡೆ ಬೇರೆ ಕಡೆ ಅಲ್ಲಿ ಹಿಂದಿನ ವರ್ಕು ಇದ್ರಲ್ಲಿ ಹಿಂದಿನ ಹಿಂದಿನ ಇನ್ನೂರು ರೂಪಾಯಿ ಗೋಲ್ಡ್ ಲೋನ್ ಓಹ್ ಬೋಲ್ನಲ್ಲ ಓಕೆ ಏನು ಕ್ಯಾಶರಾ ಬಿಸ್ನೆಸ್ಸಾ ಸೇಲ್ಸ್ ಸೇರಿಸಿ ಸೇರಿಸಿ ಸೊ ಮುಂಚೆ ಆಪರೇಷನ್ ಅಲ್ಲಿ ಮಾಡ್ತಿದ್ದೆ ಸಿಕ್ಕಾಪಟ್ಟೆ ಪ್ರೆಷರ್ ಕೊಡ್ತಾರೆ ಆ ಕಡೆ ಸೇಲ್ಸು ಮಾಡಬೇಕು ಆಪ್ರೇಷನು ನೋಡ್ಬೇಕು ಮಾಡ್ಕೋಬೇಕು ಅದೇ ಚಿ ಇವಾಗ ಸೇರಿಸಿದ ಜಾನಪದ ಇಲ್ಲಿ ಸಿಕ್ಸ್ ಮಂತ್ಸ್ ಆಯಿತು ನನ್ನ ಜಾಯಿನ್ ಆಗಿ ಹಾಂ ಹಾಂ ಇದು ಸೇಲ್ ಸೇಲ್ ಮಾಡ್ತೀವಿ ಹಾಂ ನಿಮ್ಗೆ ಇನ್ಸೆಂಟಿವ್ ಎಲ್ಲ ಬರುತ್ತಲ್ವಾ ಹ್ಞೂ ಸೋಂಟು ಬಾರೋ ಇರುತ್ತೆ ಬಟ್ ಕಷ್ಟ ನಾನು ಗೋಲ್ಡ್ ಲೋನಲ್ಲಿ ಮಾಡೋದು ಹೌದು ಗೋಲ್ಡನ್ನು ಅಂದರೆ ಲೊಕೇಶನ್ ಮೇಲೆ ಡಿಪೆಂಡ್ ಆಗುತ್ತೆ ಮಂಗಳಸೂರ್ ಕರಿಚೇರಿ ಅಲ್ವಾ ಹೌದು ಕಡಿಮೆ ರೋಡ್ ಒಳ್ಳೆಯದೇ ಹ್ಞೂ ಹ್ಞೂ ನೀನು ಮತ್ತೆ ಹೇಳಿ ಕೇಳೋಣ ನೀನಿಲ್ಲಮ್ಮ ಏನಿಲ್ಲ ಕಲಾ ಮಿಸ್ ಮಾಡ್ಕೋತಿದ್ದೀರಾ ದಾಸವಾಳದ ದಿನಾಲು ಫ್ಯಾಮಿಲಿ ಮಿಸ್ ಆಗುತ್ತೆ ಇನ್ನೇನು ಮಾಡ್ತೀರಾ ಮತ್ತು ಊರಿಗೋಸ್ಕರ ಮಾಡಬೇಕಲ್ವಾ ಓಕೆ ಇದು ಬೇರೆ ದಿವ್ಸ ಇದೆಯಾ ಇದೆ ಪಾಪು ಇದೆ ಪನ್ ಪಾಪನಾ ಹೌದು ಹೌದು ಅಕ್ಕ ಪಾಪ ಕಂಡು ಹ್ಞೂ ಬಂದಾಗಿಂದ ಹೋಗಿಲ್ವಾ ಏನಿಲ್ಲ ಬೆಂಗಳೂರು ಬಂದಾಗಿಂದ ಹೋಗಿಲ್ವಾ ಅವ್ರಿಗೆ ಇಲ್ಲ ಹೋಗ್ತೀನಿ ನಾನು ಅದಕ್ಕೆ ಇಲ್ಲಿ ಕಾರ್ ತಗೊಂಡು ಇಟ್ಕೊಂಡಿದ್ದೀನಿ ಯಾವಾಗ ಮುನ್ಸ್ಬಾರ್ದು ಕಲರ್ ಇನ್ನು ಟ್ರೈನಿಂಗ್ ಇನ್ನು ಎಲ್ಲ ಹೋಗಲ್ಲ ತುಂಬ ಲೇಟ್ ಆಗುತ್ತೆ ಅಂದ್ಬಿಟ್ಟು ಕರಲ್ ಉಂಟು ಹಾಂ ಹ್ಞೂ ಆ ಥರನೇ ಇದೆ ಬಿಡಿ ಹೋಗಿ ಬರ್ಬೋದು ಕೇರ್ಫುಲ್ ಅಲ್ವಾ ಈ ಕಡೆ ಸೈಡ್ ಎಲ್ಲ ಇದ್ದಿದ್ದು ಸ್ವಲ್ಪ ಕಷ್ಟ ಆಗ್ತಿತ್ತು ಹೌದು ಹ್ಞೂ ಅಲ್ಲಿಂದ ಅಲ್ಲೋಗಿ ಹೋಗ್ಬೋದು ಏನು ಅನ್ಸೋಲ್ಲ ಸರಿ ಹ್ಞೂ ಮತ್ತೆ ಇಡೀ ಅಂಶ ಸಮಾಚಾರ ನೀನು ಹೇಳು ಇಲ್ಲ ಅಮ್ಮ ಮತ್ತು ಊರಿಗೆ ಹೋಗೋದು ನಾಳೆನಾ ಹ್ಞೂ ನಾಳೆ ನಾಳೆ ನಾಳೆ ಲೀವ್ ಇಲ್ಲ ನಾಳೆ ಆಫ್ಟರ್ ಪರ್ಮಿಷನ್ ತಗೊಂಡು ಹೋಗ್ತೀವಿ ಹಾ ಹೋಗಿ ಸ್ಯಾಟರ್ಡೆ ಸಂಡೆ ಮಂಡೆ ಮಂಡೆ ಬರ್ತೀನಿ ಮಂಡೆನೆ ಹಬ್ಬ ನಮ್ಮೂರಲ್ಲಿ ಪಂಚಮಿನು ಅವಾಗ್ಲೇ ಮಾಡ್ತೀವಿ ನೋಡಬೇಕು ಸೊ ಮಂಡೆ ಬರಲ್ಲ ಹಾಂ ಟ್ಯೂಸ್ಡೇ ಇಲ್ಲಾ