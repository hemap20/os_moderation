      "text": "ఈ"
    },
    {
      "t": "00:14",
      "text": "ఎప్పటినుంచో చేస్తున్నారు యాప్"
    },
    {
      "t": "00:16",
      "text": "ఓకే"
    },
    {
      "t": "00:18",
      "text": "నేనా అండి"
    },
    {
      "t": "00:20",
      "text": "జస్ట్ ఫిఫ్టీన్ ట్వంటీ డేస్ అంతే"
    },
    {
      "t": "00:22",
      "text": "మీరు"
    },
    {
      "t": "00:24",
      "text": "జస్ట్ వన్ డే అండి"
    },
    {
      "t": "00:26",
      "text": "పర్వాలేదు"
