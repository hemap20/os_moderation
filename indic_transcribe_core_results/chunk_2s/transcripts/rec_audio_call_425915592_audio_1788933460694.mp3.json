    },
    {
      "t": "00:06",
      "text": "ഹലോ"
    },
    {
      "t": "00:08",
      "text": "കേൾക്കുന്നുണ്ടോ"
    },
    {
      "t": "00:10",
      "text": "സലോഡിയ"
    },
    {
      "t": "00:12",
      "text": "ഇത് പാലക്കാട്"
    },
    {
      "t": "00:14",
      "text": "ആ"
    },
    {
      "t": "00:16",
      "text": "നിങ്ങളോ"
    },
    {
      "t": "00:18",
      "text": "ഒരു"
    },
    {
      "t": "00:20",
      "text": "ഞാൻ മാർക്കറ്റിംഗ് എക്സിക്യൂട്ടീവ് ആയിട്ട്"
    },
    {
      "t": "00:22",
      "text": "ഓക്കെ നിങ്ങളെന്താ ചെയ്യുന്നത്"
    },
    {
      "t": "00:24",
      "text": "ആ"
    },
    {
      "t": "00:26",
      "text": "പൾസിൽ ഇപ്പം"
    },
    {
      "t": "00:28",
      "text": "എവിടുന്നാ"
    },
    {
      "t": "00:30",
      "text": "ഉം"
    },
    {
      "t": "00:32",
      "text": "ശരി"
    },
    {
      "t": "00:34",
      "text": "അവര്"
    },
    {
      "t": "00:36",
      "text": "എത്ര ഏജ് ഒക്കെ ഉണ്ട്"
    },
    {
      "t": "00:38",
      "text": "ഉണ്ട്"
    },
    {
      "t": "00:40",
      "text": "എനിക്ക് തരത്തില്ല"
    },
    {
      "t": "00:42",
      "text": "പോകാം"
    },
    {
      "t": "00:44",
      "text": "എനിക്ക് തേർട്ടി ഫൈവ്"
    },
    {
      "t": "00:46",
      "text": "ആ"
    },
    {
      "t": "00:48",
      "text": "ഹസ്ബൻഡൊക്കെ അപ്പോൾ"
    },
    {
      "t": "00:50",
      "text": "ഓ എന്താ എടുക്കുന്നത്"
    },
    {
      "t": "00:52",
      "text": "വിദ്യാർത്ഥികൾക്ക്"
    },
    {
      "t": "00:54",
      "text": "വൈഫൈ"
    },
    {
      "t": "00:56",
      "text": "ഉണ്ട് രണ്ട് മക്കളുണ്ട്"
    },
    {
      "t": "00:58",
      "text": "ആ"
    },
    {
      "t": "01:00",
      "text": "ബൈബിളിൽ"
    },
    {
      "t": "01:02",
      "text": "ഹലോ എസ് വൈ ഫൈവ്"
    },
    {
      "t": "01:04",
      "text": "ആണ് ഇപ്പോൾ പുറത്ത് പോയേക്കണു"
    },
    {
      "t": "01:06",
      "text": "ഉം ഉം"
    },
    {
      "t": "01:08",
      "text": "മക്കളെ കണ്ടോ"
    },
    {
      "t": "01:10",
      "text": "മക്കളെ എട്ടിലും"
    },
    {
      "t": "01:12",
      "text": "നാലിലും"
    },
    {
      "t": "01:14",
      "text": "ആ"
    },
    {
      "t": "01:16",
      "text": "ഉം ഉം"
    },
    {
      "t": "01:18",
      "text": "നിങ്ങളുടെയോ"
    },
    {
      "t": "01:20",
      "text": "ആ"
    },
    {
      "t": "01:22",
      "text": "രണ്ടുപേരും ഒന്നില്"
    },
    {
      "t": "01:24",
      "text": "ഒന്നുമില്ല"
    },
    {
      "t": "01:26",
      "text": "ചെറിയ പിള്ളേരാണ്"
    },
    {
      "t": "01:28",
      "text": "ആ ഹസ്ബൻഡ്"
    },
    {
      "t": "01:30",
      "text": "ഡ്രൈ"
    },
    {
      "t": "01:32",
      "text": "ഇറോൺ ആ ടീച്ചറിന്"
    },
    {
      "t": "01:34",
      "text": "അവിടെ കാലാവസ്ഥ ഒക്കെ ഉണ്ടോ"
    },
    {
      "t": "01:36",
      "text": "കപ്പില ചൂടാക്കുക"
    },
    {
      "t": "01:38",
      "text": "പാലക്കാടല്ലേ"
    },
    {
      "t": "01:40",
      "text": "ചൂടാ"
    },
    {
      "t": "01:42",
      "text": "ഇത് എത്രയാണ്"
    },
    {
      "t": "01:44",
      "text": "ഏകദേശം"
    },
    {
      "t": "01:46",
      "text": "ഒരു ടു വീക്സ് ത്രീ വീക്സ് ഒക്കെ ആയി"
    },
    {
      "t": "01:48",
      "text": "എങ്ങനെയുണ്ട് പോകണത്"
    },
    {
      "t": "01:50",
      "text": "എനിക്ക്"
    },
    {
      "t": "01:52",
      "text": "കുഴപ്പമില്ലാന്ന് തോന്നിയത്"
    },
    {
      "t": "01:54",
      "text": "നിങ്ങൾക്ക്"
    },
    {
      "t": "01:56",
      "text": "കുഴപ്പമില്ല"
    },
    {
      "t": "01:58",
      "text": "നിങ്ങളങ്ങനെ"
    },
    {
      "t": "02:00",
      "text": "എങ്ങനെ നോർമൽ നോർമൽ ടോപ്പ്"
    },
    {
      "t": "02:02",
      "text": "സ്റ്റോക്ക് മാത്രമേ ഉള്ളൂ അതെല്ലാം ഉണ്ടോ സംസാരിക്കുമോ"
    },
    {
      "t": "02:04",
      "text": "നോർമൽ"
    },
    {
      "t": "02:06",
      "text": "നോർമൽ മാത്രമേ ഉള്ളു"
    },
    {
      "t": "02:08",
      "text": "ഓക്കെ"
    },
    {
      "t": "02:10",
      "text": "പിന്നെ എങ്ങനെ ചെറിയ"
    },
    {
      "t": "02:12",
      "text": "ആ"
    },
    {
      "t": "02:14",
      "text": "ഇൻസ്റ്റ ഇൻസ്റ്റ ത്രൂ"
    },
    {
      "t": "02:16",
      "text": "ഉം ഉം"
    },
    {
      "t": "02:18",
      "text": "പിന്നെ"
    },
    {
      "t": "02:20",
      "text": "ആ"
    },
    {
      "t": "02:22",
      "text": "എല്ലാം സുഖമാണ്"
    },
    {
      "t": "02:24",
      "text": "പത്തുശ്രീ"
    },
    {
      "t": "02:26",
      "text": "ലവ് മേജർ ഉണ്ട്ടാ"
    },
    {
      "t": "02:28",
      "text": "ആ"
    },
    {
      "t": "02:30",
      "text": "ലവ് വിത്ത് അറേഞ്ച്"
    },
    {
      "t": "02:32",
      "text": "അങ്ങനെ പറയുന്നതുകൊണ്ട് കുഴപ്പമില്ല"
    },
    {
      "t": "02:34",
      "text": "ഇല്ല ഇല്ല ഞാൻ കൂടെ വന്നു കഴിഞ്ഞാൽ"
    },
    {
      "t": "02:36",
      "text": "ഏ"
    },
    {
      "t": "02:38",
      "text": "ഇപ്പം"
    },
    {
      "t": "02:40",
      "text": "ഞങ്ങൾക്കും അങ്ങനെ തന്നെയാണെന്ന് തോന്നുന്നു"
    },
    {
      "t": "02:42",
      "text": "ഓക്കെ"
    },
    {
      "t": "02:44",
      "text": "എങ്ങനെ പോകണമെന്ന് അറിയത്തില്ല"
    },
    {
      "t": "02:46",
      "text": "കുട്ടികളെ"
    },
    {
      "t": "02:48",
      "text": "വലിയ ഉഷാറാണ് വലിയ കുഴപ്പമൊന്നുമില്ല"
    },
    {
      "t": "02:50",
      "text": "മ്മ്"
    },
    {
      "t": "02:52",
      "text": "എല്ലാ"
    },
    {
      "t": "02:54",
      "text": "വലിയ കുഴപ്പമില്ലാന്ന് പോകുന്നുണ്ട്"
    },
    {
      "t": "02:56",
      "text": "ഓക്കേ"
    },
    {
      "t": "02:58",
      "text": "എന്താ ഇതിനകത്ത്"
    },
    {
      "t": "03:00",
      "text": "ആൾക്കാരെ വിളിച്ചിട്ട് സംസാരിക്കുക കൂടുതലും"
    },
    {
      "t": "03:02",
      "text": "ഇപ്പോൾ"
    },
    {
      "t": "03:04",
      "text": "കൂടുതലും ആൾക്കാര് ഓപ്പൺ ഡോക്കിനാണ് വരുന്നത്"
    },
    {
      "t": "03:06",
      "text": "അത് കത്തരുത്"
    },
    {
      "t": "03:08",
      "text": "അതെ അതെ നമ്മൾ"
    },
    {
      "t": "03:10",
      "text": "ഒരു മൂന്ന് ദിവസം ചാരിക്കും"
    },
    {
      "t": "03:12",
      "text": "ആ"
    }
  ],
