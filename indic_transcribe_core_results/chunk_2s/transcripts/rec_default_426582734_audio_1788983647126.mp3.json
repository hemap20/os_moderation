    {
      "t": "05:18",
      "text": "ఓకే"
    },
    {
      "t": "05:20",
      "text": "అండ్"
    },
    {
      "t": "05:22",
      "text": "ఇంటర్సెట్ చేసుకుంటాను"
    },
    {
      "t": "05:24",
      "text": "మీరు చేసుకుంటారా"
    },
    {
      "t": "05:26",
      "text": "వాట్సాప్ మీ"
    },
    {
      "t": "05:28",
      "text": "ఇంట్రడ్యూస్ మహాత్మా గాంధీ"
