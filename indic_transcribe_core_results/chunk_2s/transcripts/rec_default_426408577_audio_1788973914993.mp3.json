{
  "file_id": "rec_default_426408577_audio_1788973914993.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 735.366,
  "processing_time_sec": 49.63135027885437,
  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "హాయ్"
    },
    {
      "t": "00:04",
      "text": "హాయ్ హాయ్ హలో"
    },
    {
      "t": "00:06",
      "text": "సరే"
    },
    {
      "t": "00:08",
      "text": "హలో హలో"
    },
    {
      "t": "00:10",
      "text": "అదేవిధంగా"
    },
    {
      "t": "00:12",
      "text": "హలో హలో"
    },
    {
      "t": "00:14",
      "text": "హలో"
    },
    {
      "t": "00:16",
      "text": "హలో వెల్కమ్"
    },
    {
      "t": "00:18",
      "text": "ఎక్కడ నుంచి"
    },
    {
      "t": "00:20",
      "text": "చిత్తూరు మేరు"
    },
    {
      "t": "00:22",
      "text": "సరే మేడం"
    },
    {
      "t": "00:24",
      "text": "మ్యారేజ్ అనుకుంటాం"
    },
    {
      "t": "00:26",
      "text": "అన్నీ మాట్లాడొచ్చా"
    },
    {
      "t": "00:28",
      "text": "ఆ"
    },
    {
      "t": "00:30",
      "text": "మీ ఆయన ఏం చేస్తుంటారు"
    },
    {
      "t": "00:32",
      "text": "తను బయటకు వెళ్ళి"
    },
    {
      "t": "00:34",
      "text": "పనికి వెళ్తుంటాడు"
    },
    {
      "t": "00:36",
      "text": "ఆల్రెడీ మనం మాట్లాడాము అనుకుంటా కదా"
    },
    {
      "t": "00:38",
      "text": "అవును రకరకాల"
    },
    {
      "t": "00:40",
      "text": "అనిపిస్తుంది మాట్లాడే పని అందుకే"
    },
    {
      "t": "00:42",
      "text": "ఆ"
    },
    {
      "t": "00:44",
      "text": "తిన్నారా లేదా"
    },
    {
      "t": "00:46",
      "text": "బేస్ నవ్వు"
    },
    {
      "t": "00:48",
      "text": "ఈరోజు అయిందా ఏమన్నా మాకు మీది"
    },
    {
      "t": "00:50",
      "text": "నేను తప్ప"
    },
    {
      "t": "00:52",
      "text": "జై హింద్"
    },
    {
      "t": "00:54",
      "text": "మీకు ఇంట్రెస్ట్ కదా ఆయనకి ఇంట్రెస్ట్ పెడదాం"
    },
    {
      "t": "00:56",
      "text": "నైట్ సఫర్ మేమే"
    },
    {
      "t": "00:58",
      "text": "డిస్టబెన్స్ అంటే"
    },
    {
      "t": "01:00",
      "text": "డెస్క్టాప్ కాకుండా ప్రసాద్"
    },
    {
      "t": "01:02",
      "text": "శాంతంగా పడుకుంటాము"
    },
    {
      "t": "01:04",
      "text": "డే టైంలో చూసుకుంటాం"
    },
    {
      "t": "01:06",
      "text": "ఓ ఎలా ఇష్టం నీకు ఎలా"
    },
    {
      "t": "01:08",
      "text": "క్లాస్ వేయించుకోవడం ఇష్టం"
    },
    {
      "t": "01:10",
      "text": "నాకు రొమాన్స్"
    },
    {
      "t": "01:12",
      "text": "తో పాటు సెక్స్ సిస్టమ్"
    },
    {
      "t": "01:14",
      "text": "ఓకే"
    },
    {
      "t": "01:16",
      "text": "కాకపోతే మా ఆయన త్వరగా"
    },
    {
      "t": "01:18",
      "text": "త్వరగా అయిపోగొట్టేస్తాడు నాకు ఎక్కువ"
    },
    {
      "t": "01:20",
      "text": "టైం కావాలనే ఇష్టం"
    },
    {
      "t": "01:22",
      "text": "హ్యాంగ్ అవుతుంది అట్లా పెట్టుకుంటారు"
    },
    {
      "t": "01:24",
      "text": "వాటిలో పెట్టుకోండి"
    },
    {
      "t": "01:26",
      "text": "తీసుకుంటావా"
    },
    {
      "t": "01:28",
      "text": "అవును అవును అవును అవును మేడం"
    },
    {
      "t": "01:30",
      "text": "బట్ వీడియోస్ చూస్తే"
    },
    {
      "t": "01:32",
      "text": "స్థానం సో"
    },
    {
      "t": "01:34",
      "text": "ట్రై చేయాలని అయితే ఇంట్రెస్ట్ ఉంది"
    },
    {
      "t": "01:36",
      "text": "ఇద్దరు చూస్తారా వీడియో"
    },
    {
      "t": "01:38",
      "text": "ఓకే"
    },
    {
      "t": "01:40",
      "text": "ఆయనకి నేను చూపిస్తాను"
    },
    {
      "t": "01:42",
      "text": "అయ్యా అయ్యా అవునా"
    },
    {
      "t": "01:44",
      "text": "కరెంట్ అఫైర్స్ ఇంకెవరితో"
    },
    {
      "t": "01:46",
      "text": "చే"
    },
    {
      "t": "01:48",
      "text": "చేస్తే ఎందుకే ఇలా ఫీల్ అవుతావు"
    },
    {
      "t": "01:50",
      "text": "అర్థమవుతుందా"
    },
    {
      "t": "01:52",
      "text": "నిజంగా కానీ"
    },
    {
      "t": "01:54",
      "text": "నాకు ఊర్లో అయితే ట్రైన్"
    },
    {
      "t": "01:56",
      "text": "ట్రై చేసే వాళ్ళు ఉన్నారు బట్ వీళ్ళు"
    },
    {
      "t": "01:58",
      "text": "ఏజ్లో అలా రిలేషన్ పెట్టుకుంటాం"
    },
    {
      "t": "02:00",
      "text": "అంటే అందరికీ తెలిసిపోతుంది"
    },
    {
      "t": "02:02",
      "text": "వస్తానే"
    },
    {
      "t": "02:04",
      "text": "నేను"
    },
    {
      "t": "02:06",
      "text": "చూస్తున్నావా ఏంటి యాప్లో"
    },
    {
      "t": "02:08",
      "text": "యాప్లోనే చూస్తున్నాను"
    },
    {
      "t": "02:10",
      "text": "బట్ యాప్లో కూడా డైరెక్ట్ మీట్ అవ్వాలి"
    },
    {
      "t": "02:12",
      "text": "కావాలని అంటున్నారు కానీ"
    },
    {
      "t": "02:14",
      "text": "కాస్త భయం ఉంది ఎవరు ఎలా ఉంటారు"
    },
    {
      "t": "02:16",
      "text": "చేస్తారో తెలీదు"
    },
    {
      "t": "02:18",
      "text": "అందుకనేసి నేను ఆలోచిస్తున్నాను"
    },
    {
      "t": "02:20",
      "text": "ధైర్యం చేయట్లే"
    },
    {
      "t": "02:22",
      "text": "ఏ ఊరన్నా"
    },
    {
      "t": "02:24",
      "text": "చిత్తూరు"
    },
    {
      "t": "02:26",
      "text": "నాకేమైనా ఛాన్స్ ఇస్తావా"
    },
    {
      "t": "02:28",
      "text": "వెంటనే కాదు"
    },
    {
      "t": "02:30",
      "text": "కొద్ది రోజులు మనం మాట్లాడదాం నీకు నేను ఒక"
    },
    {
      "t": "02:32",
      "text": "ఓకే అంటే నేను మాట్లాడుతున్నాను అన్నింటికి వెళ్ళి"
    },
    {
      "t": "02:34",
      "text": "ఓకే అనుకుంటాను ఓకే"
    },
    {
      "t": "02:36",
      "text": "ఓకే డాడ్"
    },
    {
      "t": "02:38",
      "text": "కింద చూపి వస్తావా"
    },
    {
      "t": "02:40",
      "text": "ఆ"
    },
    {
      "t": "02:42",
      "text": "ఇందులో చూపించలేం కదా"
    },
    {
      "t": "02:44",
      "text": "ఉండేది కాదు వాట్సాప్ వాట్సాప్"
    },
    {
      "t": "02:46",
      "text": "నెంబర్"
    },
    {
      "t": "02:48",
      "text": "వెంటనే ఇవ్వలేను"
    },
    {
      "t": "02:50",
      "text": "అయ్యయ్యో"
    },
    {
      "t": "02:52",
      "text": "నేనే మళ్ళీ ఇబ్బంది పెట్టాను"
    },
    {
      "t": "02:54",
      "text": "అని కాదు అబ్బో బాబు"
    },
    {
      "t": "02:56",
      "text": "పదే పదే కాల్ చేసేవాడిని కూడా కాదు"
    },
    {
      "t": "02:58",
      "text": "మూడు చర్చ అంటే"
    },
    {
      "t": "03:00",
      "text": "నాకు బిజినెస్ ఉంది నేను బిజినెస్ చేస్తాను"
    },
    {
      "t": "03:02",
      "text": "అలా"
    },
    {
      "t": "03:04",
      "text": "ఊరికే విసిగించేవాడిని"
    },
    {
      "t": "03:06",
      "text": "మనకు కూడా కాదు ఫ్యామిలీ ఉంటుంది"
    },
    {
      "t": "03:08",
      "text": "ఉంటుంది కదా నీకైనా నాకైనా"
    },
    {
      "t": "03:10",
      "text": "మరి"
    },
    {
      "t": "03:12",
      "text": "సరే"
    },
    {
      "t": "03:14",
      "text": "ఓకే"
    },
    {
      "t": "03:16",
      "text": "ఆ"
    },
    {
      "t": "03:18",
      "text": "ఇంకా"
    },
    {
      "t": "03:20",
      "text": "ఫంక్షన్ మోడ్లో ఉన్నా"
    },
    {
      "t": "03:22",
      "text": "ఓకే"
    },
    {
      "t": "03:24",
      "text": "ఓకే బట్ ట్రై"
    },
    {
      "t": "03:26",
      "text": "ట్రై చేస్తాను"
    },
    {
      "t": "03:28",
      "text": "అంటే ఫోన్"
    },
    {
      "t": "03:30",
      "text": "ఆ"
    },
    {
      "t": "03:32",
      "text": "ఇలా పెట్టి చూపిస్తాను సైడ్"
    },
    {
      "t": "03:34",
      "text": "ఎలా"
    },
    {
      "t": "03:36",
      "text": "కనిపిస్తే చూడు"
    },
    {
      "t": "03:38",
      "text": "నువ్వు ఫేస్ చూపించు"
    },
    {
      "t": "03:40",
      "text": "ఎప్పుడైనా కనిపిస్తుంది నాకు ఇక్కడ"
    },
    {
      "t": "03:42",
      "text": "కానీ అక్కడ క్లియర్గా మాట్లాడొద్దు"
    },
    {
      "t": "03:44",
      "text": "వచ్చానే అంతే"
    },
    {
      "t": "03:46",
      "text": "ఈ చుట్టు స్థానం"
    },
    {
      "t": "03:48",
      "text": "చూడటానికి"
    },
    {
      "t": "03:50",
      "text": "షాపింగ్ షాప్"
    },
    {
      "t": "03:52",
      "text": "షెడ్యూల్డ్ ట్రైనింగ్ ఇచ్చాడు"
    },
    {
      "t": "03:54",
      "text": "చేత్తో చేసుకుంటావా బాగా"
    },
    {
      "t": "03:56",
      "text": "పశ్చిమ"
    },
    {
      "t": "03:58",
      "text": "మీ ఆయన సూపర్ బైట్"
    },
    {
      "t": "04:00",
      "text": "పెట్టకపోతే అలానేనా చేసేది"
    },
    {
      "t": "04:02",
      "text": "అదే నువ్వు నీ రూమ్ చూసుకో"
    },
    {
      "t": "04:04",
      "text": "చూపించలేదు ఒకసారి"
    },
    {
      "t": "04:06",
      "text": "చిప్ప చిప్ప"
    },
    {
      "t": "04:08",
      "text": "తిప్పు ఏం కాదు తిప్పు"
    },
    {
      "t": "04:10",
      "text": "ఓకే"
    },
    {
      "t": "04:12",
      "text": "అవును"
    },
    {
      "t": "04:14",
      "text": "అందరు కూర్చున్నారు"
    },
    {
      "t": "04:16",
      "text": "ఓకే"
    },
    {
      "t": "04:18",
      "text": "సందర్భం ఏం లేదు"
    },
    {
      "t": "04:20",
      "text": "చెప్పేది"
    },
    {
      "t": "04:22",
      "text": "సరే"
    },
    {
      "t": "04:24",
      "text": "ఏమున్నాయి"
    },
    {
      "t": "04:26",
      "text": "ఏమనను కార్ని"
    },
    {
      "t": "04:28",
      "text": "బ్రహ్మా ఇంత సిక్స్"
    },
    {
      "t": "04:30",
      "text": "ఎందుకున్నావు నిన్ను మీ ఆయన దొంగకి పోవడం ఏంటి"
    },
    {
      "t": "04:32",
      "text": "ఇంత కసి పొగుడున్నావు మనిషి"
    },
    {
      "t": "04:34",
      "text": "అదేవిధంగా"
    },
    {
      "t": "04:36",
      "text": "సీజర్స్ ఆఫ్ మైండ్"
    },
    {
      "t": "04:38",
      "text": "చేయవచ్చు"
    },
    {
      "t": "04:40",
      "text": "మొడ్డలు మొడ్డలు అవ్వట్లేదు"
    },
    {
      "t": "04:42",
      "text": "ఓకే"
    },
    {
      "t": "04:44",
      "text": "ఓకే"
    },
    {
      "t": "04:46",
      "text": "దగ్గరలో పెట్టు ఫోన్ మంచిదా"
    },
    {
      "t": "04:48",
      "text": "నైటీ పైథాన్ మొత్తం"
    },
    {
      "t": "04:50",
      "text": "షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత షాప్ ఓపెన్ చేసిన తర్వాత"
    },
    {
      "t": "04:52",
      "text": "కీరా రైతా పెట్టుకున్నాం"
    },
    {
      "t": "04:54",
      "text": "ఓకే"
    },
    {
      "t": "04:56",
      "text": "క్యారెట్"
    },
    {
      "t": "04:58",
      "text": "దానికి అన్నీ ట్రై చేశారు"
    },
    {
      "t": "05:00",
      "text": "ఓకే"
    },
    {
      "t": "05:02",
      "text": "ఓకే"
    },
    {
      "t": "05:04",
      "text": "ఆల్రెడీ మంచి మూడ్లో ఉన్న"
    },
    {
      "t": "05:06",
      "text": "పట్టిందా"
    },
    {
      "t": "05:08",
      "text": "ఓకే"
    },
    {
      "t": "05:10",
      "text": "హలో"
    },
    {
      "t": "05:12",
      "text": "ఓకే"
    },
    {
      "t": "05:14",
      "text": "ఓకే"
    },
    {
      "t": "05:16",
      "text": "ఓకే"
    },
    {
      "t": "05:18",
      "text": "హలో"
    },
    {
      "t": "05:20",
      "text": "ఓకే"
    },
    {
      "t": "05:22",
      "text": "మంచి మూవ్ ఆల్రెడీ"
    },
    {
      "t": "05:24",
      "text": "ఆ"
    },
    {
      "t": "05:26",
      "text": "ఓకే"
    },
    {
      "t": "05:28",
      "text": "మనిషి మూడ్లో ఉన్నట్టున్నామండి"
    },
    {
      "t": "05:30",
      "text": "అర్థమవుతుందా"
    },
    {
      "t": "05:32",
      "text": "అవునా"
    },
    {
      "t": "05:34",
      "text": "ఆ"
    },
    {
      "t": "05:36",
      "text": "ఎలా ఉంది"
    },
    {
      "t": "05:38",
      "text": "కాదు మంచి మూడ్లో ఉన్నట్టున్న వంటలు"
    },
    {
      "t": "05:40",
      "text": "మాటలు"
    },
    {
      "t": "05:42",
      "text": "ఓకే"
    },
    {
      "t": "05:44",
      "text": "ఊళ్ళో ఉన్నారా లేదా"
    },
    {
      "t": "05:46",
      "text": "అల్"
    },
    {
      "t": "05:48",
      "text": "హలో"
    },
    {
      "t": "05:50",
      "text": "ఓకే"
    },
    {
      "t": "05:52",
      "text": "నోట్లో పెట్టుకో ఫింగర్స్ రెండు"
    },
    {
      "t": "05:54",
      "text": "మైండ్ ఫుల్ ఆన్సర్"
    },
    {
      "t": "05:56",
      "text": "ఓకే"
    },
    {
      "t": "05:58",
      "text": "రెండు ఫింగర్స్ నోట్లో పెట్టుకో మంచిగా మంచిగా"
    },
    {
      "t": "06:00",
      "text": "ఏమో"
    },
    {
      "t": "06:02",
      "text": "మంచి మూడ్లో ఉన్నట్టు"
    },
    {
      "t": "06:04",
      "text": "చా"
    },
    {
      "t": "06:06",
      "text": "అంటే వన్ వీక్ అవుతుంది"
    },
    {
      "t": "06:08",
      "text": "చూసి"
    },
    {
      "t": "06:10",
      "text": "తరవాత"
    },
    {
      "t": "06:12",
      "text": "వావ్"
    },
    {
      "t": "06:14",
      "text": "షూర్"
    },
    {
      "t": "06:16",
      "text": "తొందర"
    },
    {
      "t": "06:18",
      "text": "ఇక్కడ అయితే ఫేమస్"
    },
    {
      "t": "06:20",
      "text": "సరిగ్గా చూపించుడు ఇవన్నీ ఉంటాయి"
    },
    {
      "t": "06:22",
      "text": "వాట్సాప్లో అయితే పోస్ట్స్ ఉపయోగపడతాయి చూసుకోవచ్చు"
    },
    {
      "t": "06:24",
      "text": "ఒక పది నిమిషాలు మాట్లాడతాను"
    },
    {
      "t": "06:26",
      "text": "అక్కడ నువ్వు సాటిస్ఫై అవుతావు నేను"
    },
    {
      "t": "06:28",
      "text": "అర్థమైందా"
    },
    {
      "t": "06:30",
      "text": "ఇంకా"
    },
    {
      "t": "06:32",
      "text": "ఉంది దాంట్లో కౌంటర్ ఇచ్చేయి"
    },
    {
      "t": "06:34",
      "text": "ప్లే స్టోర్లో వ్లాగ్"
    },
    {
      "t": "06:36",
      "text": "ఆ కళ ఉంటుంది నా దానికి"
    },
    {
      "t": "06:38",
      "text": "కాదు నాది ఐఫోన్"
    },
    {
      "t": "06:40",
      "text": "నాకు ఆ తెలుసు"
    },
    {
      "t": "06:42",
      "text": "తెలుసా"
    },
    {
      "t": "06:44",
      "text": "బ్లాక్ కాల్ దాల్చిన కారు"
    },
    {
      "t": "06:46",
      "text": "అన్నది మాత్రమే"
    },
    {
      "t": "06:48",
      "text": "రీఛార్జ్ చేయడానికి కూడా వస్తలేదు నీకు"
    },
    {
      "t": "06:50",
      "text": "కావాలంటే వాట్సాప్లో నేను డబ్బులు వేస్తాను"
    },
    {
      "t": "06:52",
      "text": "వెయ్యి వెయ్యి"
    },
    {
      "t": "06:54",
      "text": "కావాలంటే పిల్లలకి"
    },
    {
      "t": "06:56",
      "text": "మాట్లాడడం"
    },
    {
      "t": "06:58",
      "text": "ఎందుకంటే"
    },
    {
      "t": "07:00",
      "text": "అంటే మంచి మనోడు మనోడు"
    },
    {
      "t": "07:02",
      "text": "నువ్వు సాటిస్ఫై అవుతావు నేను సాటిస్ఫై అవుతాను"
    },
    {
      "t": "07:04",
      "text": "ఏమంటావు"
    },
    {
      "t": "07:06",
      "text": "నెంబర్"
    },
    {
      "t": "07:08",
      "text": "రావడానికి ఆలోచిస్తున్నాను అంతే"
    },
    {
      "t": "07:10",
      "text": "అయ్యో నేను అంటే"
    },
    {
      "t": "07:12",
      "text": "అంతగానో ఇబ్బందులు పెడుతున్నావు"
    },
    {
      "t": "07:14",
      "text": "నేనే మోసపోయా చాలా మంది దగ్గర"
    },
    {
      "t": "07:16",
      "text": "అట్లా అట్లా"
    },
    {
      "t": "07:18",
      "text": "ఎందుకని"
    },
    {
      "t": "07:20",
      "text": "పడు"
    },
    {
      "t": "07:22",
      "text": "అర్థం కాలేదు"
    },
    {
      "t": "07:24",
      "text": "అమ్మ"
    },
    {
      "t": "07:26",
      "text": "ఎలా మోసపోయాం"
    },
    {
      "t": "07:28",
      "text": "డబ్బులు వేసాక చూపిస్తాను"
    },
    {
      "t": "07:30",
      "text": "మాట్లాడతామంటారు కాల్ మాట్లాడతామంటారు మళ్ళీ వేయండి"
    },
    {
      "t": "07:32",
      "text": "మాట్లాడారు అలా"
    },
    {
      "t": "07:34",
      "text": "ఆ"
    },
    {
      "t": "07:36",
      "text": "ఓకే"
    },
    {
      "t": "07:38",
      "text": "సరేలే"
    },
    {
      "t": "07:40",
      "text": "చెప్పు"
    },
    {
      "t": "07:42",
      "text": "సరే"
    },
    {
      "t": "07:44",
      "text": "నేను అమ్మను చెప్పు"
    },
    {
      "t": "07:46",
      "text": "నైన్ జీరో త్రీ జీరో"
    },
    {
      "t": "07:48",
      "text": "అదే"
    },
    {
      "t": "07:50",
      "text": "అంటే అక్కడ"
    },
    {
      "t": "07:52",
      "text": "ఇద్దరం మంచిగా వీడియోలు కూడా చూడొచ్చు కదా మాట్లాడదాం"
    },
    {
      "t": "07:54",
      "text": "ప్రతి ఒక్కసారి అందుకోసమని"
    },
    {
      "t": "07:56",
      "text": "నేను చెప్పు"
    },
    {
      "t": "07:58",
      "text": "చెప్పు"
    },
    {
      "t": "08:00",
      "text": "నెంబర్ చెప్పు చెప్తాను"
    },
    {
      "t": "08:02",
      "text": "అక్కడ చెప్తా నేను"
    },
    {
      "t": "08:04",
      "text": "నెంబర్ చెప్పు నైన్ జీరో త్రీ"
    },
    {
      "t": "08:06",
      "text": "తీసుకుందాం"
    },
    {
      "t": "08:08",
      "text": "ఫోర్ ఎయిట్ నైన్"
    },
    {
      "t": "08:10",
      "text": "అవును"
    },
    {
      "t": "08:12",
      "text": "సెవెన్ ఎయిట్ ఫైవ్"
    },
    {
      "t": "08:14",
      "text": "నైన్ జీరో త్రీ"
    },
    {
      "t": "08:16",
      "text": "జీరో ఫోర్ ఎయిట్ నైన్ సెవెన్ ఎయిట్ ఫైవ్"
    },
    {
      "t": "08:18",
      "text": "ఓకే"
    },
    {
      "t": "08:20",
      "text": "మెసేజ్ చెయ్యి"
    },
    {
      "t": "08:22",
      "text": "ఓకే"
    },
    {
      "t": "08:24",
      "text": "ఆ"
    },
    {
      "t": "08:26",
      "text": "ఆ"
    },
    {
      "t": "08:28",
      "text": "ఓకే"
    },
    {
      "t": "08:30",
      "text": "ఓకే"
    },
    {
      "t": "08:32",
      "text": "అరుస్తావా"
    },
    {
      "t": "08:34",
      "text": "అపార"
    },
    {
      "t": "08:36",
      "text": "అరిస్తే సౌండ్ బయటకు వస్తుంది"
    },
    {
      "t": "08:38",
      "text": "కుశగణారం"
    },
    {
      "t": "08:40",
      "text": "అలా రావాలా"
    },
    {
      "t": "08:42",
      "text": "కానీ మీ ఆయన వాళ్ళ దగ్గర"
    },
    {
      "t": "08:44",
      "text": "ఓకే"
    },
    {
      "t": "08:46",
      "text": "రెండు నిమిషాలు అయిపోతుంది"
    },
    {
      "t": "08:48",
      "text": "అర్థం ఏమైంది"
    },
    {
      "t": "08:50",
      "text": "ఊట్లో పెట్టగానే"
    },
    {
      "t": "08:52",
      "text": "పడిపోద్దా అని"
    },
    {
      "t": "08:54",
      "text": "పిల్లలున్నారా"
    },
    {
      "t": "08:56",
      "text": "మీకు"
    },
    {
      "t": "08:58",
      "text": "ఎంతమంది"
    },
    {
      "t": "09:00",
      "text": "అవును"
    },
    {
      "t": "09:02",
      "text": "నైస్"
    },
    {
      "t": "09:04",
      "text": "సే చేయలేదు ఇంకా"
    },
    {
      "t": "09:06",
      "text": "చేస్తున్నాం"
    },
    {
      "t": "09:08",
      "text": "ఓకే"
    },
    {
      "t": "09:10",
      "text": "నీకు ఎవరితో దంగ"
    },
    {
      "t": "09:12",
      "text": "తీసుకోవాలనిపించలేదా ఎప్పుడు"
    },
    {
      "t": "09:14",
      "text": "వెనకాల పిక్చర్ చాలా సార్లు ఉంటుంది"
    },
    {
      "t": "09:16",
      "text": "అలా అలా కాదు"
    },
    {
      "t": "09:18",
      "text": "మీ ఊర్లో కానీ మీ ఇంట్లో మాత్రం"
    },
    {
      "t": "09:20",
      "text": "మారుతీ కానీ అలా ఎవరూ లేరా"
    },
    {
      "t": "09:22",
      "text": "అయ్యా"
    },
    {
      "t": "09:24",
      "text": "సార్"
    },
    {
      "t": "09:26",
      "text": "స్కాన్ పెట్టనా"
    },
    {
      "t": "09:28",
      "text": "ఆ"
    },
    {
      "t": "09:30",
      "text": "స్కాన్"
    },
    {
      "t": "09:32",
      "text": "చాలా స్పీడ్గా ఉన్నావే బాబు నువ్వు"
    },
    {
      "t": "09:34",
      "text": "వ్యాసక్తి"
    },
    {
      "t": "09:36",
      "text": "సైజెస్ వేయలేదు ఇంకా స్కానర్ అంట"
    },
    {
      "t": "09:38",
      "text": "అంతే అంతే"
    },
    {
      "t": "09:40",
      "text": "ఎంతమందితో మాట్లాడావు"
    },
    {
      "t": "09:42",
      "text": "చెప్పు"
    },
    {
      "t": "09:44",
