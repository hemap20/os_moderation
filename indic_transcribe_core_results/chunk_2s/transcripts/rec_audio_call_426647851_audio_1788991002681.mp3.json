{
  "file_id": "rec_audio_call_426647851_audio_1788991002681.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 896.661,
  "processing_time_sec": 58.62537884712219,
  "segments": [
    {
      "t": "00:00",
      "text": "హలో"
    },
    {
      "t": "00:02",
      "text": "హాయ్"
    },
    {
      "t": "00:04",
      "text": "అదే విధంగా"
    },
    {
      "t": "00:06",
      "text": "హైదరాబాద్ నుంచి"
    },
    {
      "t": "00:08",
      "text": "నువ్వు"
    },
    {
      "t": "00:10",
      "text": "చేవాడ"
    },
    {
      "t": "00:12",
      "text": "విజయవాడ అమ్మాయి ఇంకా పడుకోకుండా"
    },
    {
      "t": "00:14",
      "text": "తాము ఇల్లు కనే ఉందా"
    },
    {
      "t": "00:16",
      "text": "అయ్యో"
    },
    {
      "t": "00:18",
      "text": "ఏం చేస్తుంది ఆమెని"
    },
    {
      "t": "00:20",
      "text": "రాయాలని చెప్పాను ఇందాకే లేట్"
    },
    {
      "t": "00:22",
      "text": "అవును"
    },
    {
      "t": "00:24",
      "text": "అవును"
    },
    {
      "t": "00:26",
      "text": "తప్పకుండా"
    },
    {
      "t": "00:28",
      "text": "అబ్బో"
    },
    {
      "t": "00:30",
      "text": "పర్పస్ ప్రస్తుతానికి"
    },
    {
      "t": "00:32",
      "text": "ఇంకేం మాట్లాడుతున్నాం"
    },
    {
      "t": "00:34",
      "text": "మీది"
    },
    {
      "t": "00:36",
      "text": "నేను"
    },
    {
      "t": "00:38",
      "text": "అదే పర్పస్లోనే"
    },
    {
      "t": "00:40",
      "text": "మనీయా"
    },
    {
      "t": "00:42",
      "text": "అవును సార్"
    },
    {
      "t": "00:44",
      "text": "వీడియో కాల్స్"
    },
    {
      "t": "00:46",
      "text": "అనే అవసరం"
    },
    {
      "t": "00:48",
      "text": "ఇష్టం ఉంటే ఎన్ని స్టార్లు చేస్తాం"
    },
    {
      "t": "00:50",
      "text": "లేకపోతే లేదు"
    },
    {
      "t": "00:52",
      "text": "ఏంటది"
    },
    {
      "t": "00:54",
      "text": "అవసరం ఉంటే చేస్తాను వినిస్తాను"
    },
    {
      "t": "00:56",
      "text": "లేదంటే చేయనా"
    },
    {
      "t": "00:58",
      "text": "ఓకే ఓకే"
    },
    {
      "t": "01:00",
      "text": "మెంతా"
    },
    {
      "t": "01:02",
      "text": "ఫైవ్ హండ్రెడ్"
    },
    {
      "t": "01:04",
      "text": "టైం అది"
    },
    {
      "t": "01:06",
      "text": "వాళ్ళ ఇష్టము"
    },
    {
      "t": "01:08",
      "text": "కానీ"
    },
    {
      "t": "01:10",
      "text": "ఫైవ్ హండ్రెడ్ ఎక్కువ కదా ఇక్కడ చేసినా అంతే అవుతుంది కదా"
    },
    {
      "t": "01:12",
      "text": "అదే"
    },
    {
      "t": "01:14",
      "text": "ఇక్కడ వేస్తే సిక్స్ హండ్రెడా సిక్స్"
    },
    {
      "t": "01:16",
      "text": "ఓకే అంటే టైము"
    },
    {
      "t": "01:18",
      "text": "లిమిట్ ఉంటుంది కదా ఇప్పుడు ఏం టైం"
    },
    {
      "t": "01:20",
      "text": "వాళ్ళ ఇష్టం వాళ్ళు ఎంతసేపు మాట్లాడతారు ఒకళ్ళు"
    },
    {
      "t": "01:22",
      "text": "ఒకలా మాట్లాడతారు ఇంకొకలా మాట్లాడతారు"
    },
    {
      "t": "01:24",
      "text": "అవును"
    },
    {
      "t": "01:26",
      "text": "అందులోనే"
    },
    {
      "t": "01:28",
      "text": "వాళ్ళు టైం అడిగే అమౌంట్ కూడా వాళ్ళు చెప్తారు"
    },
    {
      "t": "01:30",
      "text": "ఓకే అంటే ఓకే లేదంటే"
    },
    {
      "t": "01:32",
      "text": "అంతేలే"
    },
    {
      "t": "01:34",
      "text": "ఓకే"
    },
    {
      "t": "01:36",
      "text": "నేను ఏం చూపిస్తాను అన్నీ చూపిస్తాను"
    },
    {
      "t": "01:38",
      "text": "హలో"
    },
    {
      "t": "01:40",
      "text": "అంటే వీడియో కాల్లో ఫేస్ అయితే చూపించలేదు"
    },
    {
      "t": "01:42",
      "text": "ఓకేనా"
    },
    {
      "t": "01:44",
      "text": "ఓకే"
    },
    {
      "t": "01:46",
      "text": "మ్యారీడా నువ్వు"
    },
    {
      "t": "01:48",
      "text": "నేను కూర్చోలేను"
    },
    {
      "t": "01:50",
      "text": "ఓకే"
    },
    {
      "t": "01:52",
      "text": "ఓకే ఎందుకని"
    },
    {
      "t": "01:54",
      "text": "ప్లేస్ ఎందుకు చూపించావు"
    },
    {
      "t": "01:56",
      "text": "ఎందుకు రేపు ఎప్పుడైనా"
    },
    {
      "t": "01:58",
      "text": "కనెక్ట్ అవ్వకుండా ఉండడం కోసం"
    },
    {
      "t": "02:00",
      "text": "ఓకే"
    },
    {
      "t": "02:02",
      "text": "కానీ ఇంకా చాలా మంది"
    },
    {
      "t": "02:04",
      "text": "ఫేస్ చూపిస్తున్నారు కదా"
    },
    {
      "t": "02:06",
      "text": "అది వాళ్ళ ఇష్టం కదా ఇప్పుడు"
    },
    {
      "t": "02:08",
      "text": "ఇది నా ఇష్టం కదా"
    },
    {
      "t": "02:10",
      "text": "రేపు ప్రాబ్లం వస్తే ఎవరో వచ్చి తీరుస్తారు"
    },
    {
      "t": "02:12",
      "text": "పిక్చర్ థరమా"
    },
    {
      "t": "02:14",
      "text": "అవును"
    },
    {
      "t": "02:16",
      "text": "షెడ్యూల్డ్ ట్రైనింగ్ ఇన్ దిస్ కంట్రీ"
    },
    {
      "t": "02:18",
      "text": "ఆ"
    },
    {
      "t": "02:20",
      "text": "ఇప్పుడే లేచావా"
    },
    {
      "t": "02:22",
      "text": "బ్యాగ్ ఎప్పుడో"
    },
    {
      "t": "02:24",
      "text": "చూడవచ్చా"
    },
    {
      "t": "02:26",
      "text": "ఓకే అవును సార్ ఇంకెందుకు"
    },
    {
      "t": "02:28",
      "text": "అంతే కదా మరి నీకు ఇప్పుడు నీకు అంత అర్జెంట్గా డబ్బులు"
    },
    {
      "t": "02:30",
      "text": "డబ్బులు అవసరం ఏమవుతాయి"
    },
    {
      "t": "02:32",
      "text": "అర్జెంట్గా ఏం లేదు"
    },
    {
      "t": "02:34",
      "text": "తొమ్మిది"
    },
    {
      "t": "02:36",
      "text": "నాకు ఎప్పుడో వచ్చిన వాసుదే అప్పుడే"
    },
    {
      "t": "02:38",
      "text": "రాసుకుంటా అంతే"
    },
    {
      "t": "02:40",
      "text": "ఓకే"
    },
    {
      "t": "02:42",
      "text": "బాగానే వస్తుంది"
    },
    {
      "t": "02:44",
      "text": "అంతే కదా ఇందులో కరెక్ట్గా"
    },
    {
      "t": "02:46",
      "text": "తెలీదు నేను ఎక్కువ రోజులు"
    },
    {
      "t": "02:48",
      "text": "అవ్వలేదు ప్లస్ నేను ఎక్కువ యూస్ చేయను"
    },
    {
      "t": "02:50",
      "text": "అవునా"
    },
    {
      "t": "02:52",
      "text": "ఏం చేస్తుంటావు"
    },
    {
      "t": "02:54",
      "text": "నువ్వే పని చేసేస్తున్నావు"
    },
    {
      "t": "02:56",
      "text": "ఆటో"
    },
    {
      "t": "02:58",
      "text": "ఈ యాప్ ఇంకా వారం కూడా అవ్వలేదు నాకు"
    },
    {
      "t": "03:00",
      "text": "ఆ"
    },
    {
      "t": "03:02",
      "text": "ఎలా ఉన్నారు"
    },
    {
      "t": "03:04",
      "text": "ఎలా ఉంది మరి"
    },
    {
      "t": "03:06",
      "text": "బాగుంది"
    },
    {
      "t": "03:08",
      "text": "బాగానే ఉందిరా అంటే"
    },
    {
      "t": "03:10",
      "text": "మరి అసలు కనెక్ట్ అవ్వదు మహా చిరాకుగా"
    },
    {
      "t": "03:12",
      "text": "ఇంకా ఉంటుంది ఎంతసేపు ట్రై చేస్తే అప్పుడు"
    },
    {
      "t": "03:14",
      "text": "అప్పుడు కనెక్ట్ అవుతుంటారు ఎంత బిజీ ఉంటారు జనాలు"
    },
    {
      "t": "03:16",
      "text": "అదే అదే"
    },
    {
      "t": "03:18",
      "text": "ఓకే ఎందుకంటే బాగానే కష్టం"
    },
    {
      "t": "03:20",
      "text": "కనెక్ట్ అవుతారు అందరికి"
    },
    {
      "t": "03:22",
      "text": "లేదు నైట్ టైం అసలు ఎంత"
    },
    {
      "t": "03:24",
      "text": "ఎంత బిజీ ఉంటుంది తెలుసా"
    },
    {
      "t": "03:26",
      "text": "అవును అంటే నేను ఫస్ట్ వేరే"
    },
    {
      "t": "03:28",
      "text": "యూస్ చేశాను నాకు అది నచ్చట్లేదని"
    },
    {
      "t": "03:30",
      "text": "దీనికి వచ్చేసా"
    },
    {
      "t": "03:32",
      "text": "వేరేవంటే"
    },
    {
      "t": "03:34",
      "text": "మనకు తవ్వ"
    },
    {
      "t": "03:36",
      "text": "అట్లా ఓకే"
    },
    {
      "t": "03:38",
      "text": "ఓకే ఇది"
    },
    {
      "t": "03:40",
      "text": "ఆ"
    },
    {
      "t": "03:42",
      "text": "సరిగ్గా రావట్లేదు కానీ నాకు నచ్చలేదు"
    },
    {
      "t": "03:44",
      "text": "వచ్చేలా అంటే క్రియత్వాన్ని వైచ్యం"
    },
    {
      "t": "03:46",
      "text": "సరళంగా ఉంది సార్"
    },
    {
      "t": "03:48",
      "text": "ఇందులో బాగా జనం బాగా ఉన్నట్టు"
    },
    {
      "t": "03:50",
      "text": "ఉన్నారు ఫుల్ ఎప్పుడు చూసినా"
    },
    {
      "t": "03:52",
      "text": "ఇక కాల్స్ బిజీలోనే ఉంటారు"
    },
    {
      "t": "03:54",
      "text": "అందరూ అమ్మాయిలందరూ"
    },
    {
      "t": "03:56",
      "text": "ఊరికే త్వరగా కనెక్ట్ అవుతాయి మాకు"
    },
    {
      "t": "03:58",
      "text": "అమ్మాయిలకి ఫుల్ బిజీ"
    },
    {
      "t": "04:00",
      "text": "అదే చెప్తున్నా అబ్బాయిలకి"
    },
    {
      "t": "04:02",
      "text": "నేను చాలా సేపు ట్రై చేస్తే కానీ కనెక్ట్"
    },
    {
      "t": "04:04",
      "text": "సెట్ అవ్వదు ఎందుకంటే అందరూ బిజీగా ఉంటారు అమ్మాయిలు"
    },
    {
      "t": "04:06",
      "text": "అప్పుడు మీరు ఎవరు"
    },
    {
      "t": "04:08",
      "text": "ఒక మంచి పర్సన్ ని తీసుకొని సెండ్ చేస్తాను"
    },
    {
      "t": "04:10",
      "text": "చేసుకోవాలి మనీ సేవ్ అవుతాయి"
    },
    {
      "t": "04:12",
      "text": "ఇది పదిగా మాట్లాడడానికి ఇది ఉంటుంది"
    },
    {
      "t": "04:14",
      "text": "నో"
    },
    {
      "t": "04:16",
      "text": "బహుమారి"
    },
    {
      "t": "04:18",
      "text": "లైన్ లైన్ మనకు"
    },
    {
      "t": "04:20",
      "text": "చూసేసినా ఫాదర్"
    },
    {
      "t": "04:22",
      "text": "మరి అదే అంటున్నాను"
    },
    {
      "t": "04:24",
      "text": "నువ్వే అవ్వచ్చు కదా"
    },
    {
      "t": "04:26",
      "text": "ట్రైన్లో"
    },
    {
      "t": "04:28",
      "text": "ఆ"
    },
    {
      "t": "04:30",
      "text": "అప్పుడప్పుడు మనీ కోసం నువ్వే చేయి"
    },
    {
      "t": "04:32",
      "text": "అదే"
    },
    {
      "t": "04:34",
      "text": "అంటే డైలీ అయితే"
    },
    {
      "t": "04:36",
      "text": "మాట్లాడొద్దు అంటున్నారా అంటున్నారు"
    },
    {
      "t": "04:38",
      "text": "ఓకే"
    },
    {
      "t": "04:40",
      "text": "అంటే నేనైతే"
    },
    {
      "t": "04:42",
      "text": "దయనీయమై మార్"
    },
    {
      "t": "04:44",
      "text": "నాకు లేదు"
    },
    {
      "t": "04:46",
      "text": "నాకు మనీ అవసరం లేదు"
    },
    {
      "t": "04:48",
      "text": "ఉన్నప్పుడే ఇంకా హ్యాప్లోకి రావాలి"
    },
    {
      "t": "04:50",
      "text": "అందుకనే మీకు అలా"
    },
    {
      "t": "04:52",
      "text": "ఓకే అంటే చెప్పండి మీకు"
    },
    {
      "t": "04:54",
      "text": "అవసరం ఉన్నప్పుడు మీరు మెసేజ్ చేయండి"
    },
    {
      "t": "04:56",
      "text": "నేను రెస్పాండ్ అవుతాను నాకు అవసరం ఉన్నప్పుడు"
    },
    {
      "t": "04:58",
      "text": "మేము మెసేజ్ చేస్తాం అట్లా"
    },
    {
      "t": "05:00",
      "text": "ఓకే"
    },
    {
      "t": "05:02",
      "text": "కానీ నువ్వు ఎలా ఉంటావు బాగుంటావా"
    },
    {
      "t": "05:04",
      "text": "రండి"
    },
    {
      "t": "05:06",
      "text": "ఉంటా ఉంటే పర్లేదు"
    },
    {
      "t": "05:08",
      "text": "పచ్చి"
    },
    {
      "t": "05:10",
      "text": "ఫిగర్ చెప్పు"
    },
    {
      "t": "05:12",
      "text": "ఎందుకంటే"
    },
    {
      "t": "05:14",
      "text": "నడుస్తాయి"
    },
    {
      "t": "05:16",
      "text": "థర్టీన్"
    },
    {
      "t": "05:18",
      "text": "ఫ్రీగా థర్టీ ఫోర్ అవుతుంది"
    },
    {
      "t": "05:20",
      "text": "చేస్తే"
    },
    {
      "t": "05:22",
      "text": "కరెక్ట్"
    },
    {
      "t": "05:24",
      "text": "అదేంటి నడుము నడుము పెద్దది"
    },
    {
      "t": "05:26",
      "text": "జస్ట్ కెన్ మై"
    },
    {
      "t": "05:28",
      "text": "ఆ"
    },
    {
      "t": "05:30",
      "text": "నడుము ఎలా థర్టీ ఫోర్ ఉంటుంది చెస్ట్ థర్టీ టూ ఉంటుంది"
    },
    {
      "t": "05:32",
      "text": "ఓకే"
    },
    {
      "t": "05:34",
      "text": "నాకు అలాగే ఉంది థర్టీ త్రీయో థర్టీ"
    },
    {
      "t": "05:36",
      "text": "ఒక రెండు టెస్టులు"
    },
    {
      "t": "05:38",
      "text": "అంతే ఇంజక్షన్"
    },
    {
      "t": "05:40",
      "text": "నడుము నడుము అంటున్నావా"
    },
    {
      "t": "05:42",
      "text": "ఆహా లేదు మేడం"
    },
    {
      "t": "05:44",
      "text": "కర్మశాల"
    },
    {
      "t": "05:46",
      "text": "కరెక్ట్ ఉంటుందా"
    },
    {
      "t": "05:48",
      "text": "పొట్టే మీద"
    },
    {
      "t": "05:50",
      "text": "మరి నడుము ఎట్లా థర్టీ త్రీ థర్టీ ఫోర్ ఉంది"
    },
    {
      "t": "05:52",
      "text": "ఏమంటారు"
    },
    {
      "t": "05:54",
      "text": "రూల్ ఉందా"
    },
    {
      "t": "05:56",
      "text": "నడుము సన్నగా ఉంటుంది నువ్వు అంటే నువ్వు"
    },
    {
      "t": "05:58",
      "text": "సరిగా అంటే ఎక్కడ చూసుకోవాలి"
    },
    {
      "t": "06:00",
      "text": "అక్కడ చూసుకోవట్లేదు అంటే"
    },
    {
      "t": "06:02",
      "text": "వారాహి వృద్ధులారా"
    },
    {
      "t": "06:04",
      "text": "నడుము అంటే"
    },
    {
      "t": "06:06",
      "text": "బోర్డు పైన చూసుకోవాలి"
    },
    {
      "t": "06:08",
      "text": "ఆహా"
    },
    {
      "t": "06:10",
      "text": "సరే"
    },
    {
      "t": "06:12",
      "text": "సైజ్ ఎలా చెప్తారు"
    },
    {
      "t": "06:14",
      "text": "చెస్టు"
    },
    {
      "t": "06:16",
      "text": "అంటే నిప్పుల్స్ పైన ఎక్కి పెట్టుకోండి"
    },
    {
      "t": "06:18",
      "text": "పెట్టుకోవాలి"
    },
    {
      "t": "06:20",
      "text": "అంటే బోర్డు పైన"
    },
    {
      "t": "06:22",
      "text": "కనిపెట్టాలి కింద"
    },
    {
      "t": "06:24",
      "text": "యాస్ పైన యాస్ పైనుంచి ఫ్రంట్"
    },
    {
      "t": "06:26",
      "text": "అంటుకు పెట్టాలి అది ఫిగర్"
    },
    {
      "t": "06:28",
      "text": "ఆ"
    },
    {
      "t": "06:30",
      "text": "మళ్ళీ"
    },
    {
      "t": "06:32",
      "text": "అమ్మాయిలు చెప్తారు"
    },
    {
      "t": "06:34",
      "text": "సరే కదా థర్టీ ఫోర్"
    },
    {
      "t": "06:36",
      "text": "ట్వంటీ ఎయిట్ థర్టీ సిక్స్"
    },
    {
      "t": "06:38",
      "text": "ఫిక్స్ అయినట్టుగా సో అది అలా చెప్తాను"
    },
    {
      "t": "06:40",
      "text": "ఇస్తారన్నమాట"
    },
    {
      "t": "06:42",
      "text": "ఆ"
    },
    {
      "t": "06:44",
      "text": "ఆ"
    },
    {
      "t": "06:46",
      "text": "సో మేబీ నీకు నచ్చదు"
    },
    {
      "t": "06:48",
      "text": "కొంచెం సన్నగా ఉంటుంది"
    },
    {
      "t": "06:50",
      "text": "కొంచెం కిందకి చూసుకుంటున్నావు అంతే నువ్వు ప్యాంటు"
    },
    {
      "t": "06:52",
      "text": "సైజు చెప్తున్నట్టును"
    },
    {
      "t": "06:54",
      "text": "అవును కొంచెం"
    },
    {
      "t": "06:56",
      "text": "బెంగళూరు"
    },
    {
      "t": "06:58",
      "text": "ప్యాంట్ సైజు అలాగ అది వేరు అలాగ అది చెప్పలేం"
    },
    {
      "t": "07:00",
      "text": "పైన చెప్పాలి"
    },
    {
      "t": "07:02",
      "text": "నడువంటే"
    },
    {
      "t": "07:04",
      "text": "ఆ"
    },
    {
      "t": "07:06",
      "text": "అదేవిధంగా"
    },
    {
      "t": "07:08",
      "text": "ఆ"
    },
    {
      "t": "07:10",
      "text": "బాయ్ ఫ్రెండ్ ఉన్నాడా"
    },
    {
      "t": "07:12",
      "text": "అదే అదే వాడు గురైతే వస్తాడు"
    },
    {
      "t": "07:14",
      "text": "ఇంకా ఇంట్రెస్ట్ లేదండి"
    },
    {
      "t": "07:16",
      "text": "జరగదు"
    },
    {
      "t": "07:18",
      "text": "ఓకే అయ్యిందా అంతా"
    },
    {
      "t": "07:20",
      "text": "అహం లేదు"
    },
    {
      "t": "07:22",
      "text": "అదేంట్రా"
    },
    {
      "t": "07:24",
      "text": "ఓకే"
    },
    {
      "t": "07:26",
      "text": "అదేంటండి"
    },
    {
      "t": "07:28",
      "text": "మరి బాయ్ ఫ్రెండ్ నుండి ఏం చేయాలి"
    },
    {
      "t": "07:30",
      "text": "చేయలేదంటే"
    },
    {
      "t": "07:32",
      "text": "చెప్పా కదా"
    },
    {
      "t": "07:34",
      "text": "ఇది ఉండదు బాయ్ ఫ్రెండ్ ఉన్నా సరే"
    },
    {
      "t": "07:36",
      "text": "కానీ ఇక్కడ కాదు"
    },
    {
      "t": "07:38",
      "text": "అదే అదే అదే"
    },
    {
      "t": "07:40",
      "text": "బట్ మేము ఎక్కువ మీట్ అయింది కూడా"
    },
    {
      "t": "07:42",
      "text": "అదే మనం తినే"
    },
    {
      "t": "07:44",
      "text": "అయ్యో"
    },
    {
      "t": "07:46",
      "text": "లాంగ్ డిస్టెన్స్లో ఎంతే ఉంటాయి"
    },
    {
      "t": "07:48",
      "text": "ఆ"
    },
    {
      "t": "07:50",
      "text": "అసలు మీట్"
    },
    {
      "t": "07:52",
      "text": "హిట్ అయినప్పుడు కూడా ఏమి జరగలేదా మూడు"
    },
    {
      "t": "07:54",
      "text": "అలాగే"
    },
    {
      "t": "07:56",
      "text": "ఆ"
    },
    {
      "t": "07:58",
      "text": "కేసులు ప్రెస్ బీన్స్ అయినాయా"
    },
    {
      "t": "08:00",
      "text": "ఆహా"
    },
    {
      "t": "08:02",
      "text": "ఓకే"
    },
    {
      "t": "08:04",
      "text": "అవేం చేస్తావు"
    },
    {
      "t": "08:06",
      "text": "నమస్తే"
    },
    {
      "t": "08:08",
      "text": "అవే చేస్తా ఉంటున్నా"
    },
    {
      "t": "08:10",
      "text": "ఏం చేస్తాం"
    },
    {
      "t": "08:12",
      "text": "ఉంటానా"
    },
    {
      "t": "08:14",
      "text": "తను నిన్ను కిస్"
    },
    {
      "t": "08:16",
      "text": "చేశాడు"
    },
    {
      "t": "08:18",
      "text": "అవునా"
    },
    {
      "t": "08:20",
      "text": "అవునా"
    },
    {
      "t": "08:22",
      "text": "ఇంకా ఊడిపోవడం"
    },
    {
      "t": "08:24",
      "text": "పట్టుకోవాలి కదా"
    },
    {
      "t": "08:26",
      "text": "లేదు నేను చేస్తాను"
    },
    {
      "t": "08:28",
      "text": "అవునా పట్టుకో"
    },
    {
      "t": "08:30",
      "text": "ఎలా తొమ్మిది"
    },
    {
      "t": "08:32",
      "text": "అస్సలు టచ్ చేయలేదా"
    },
    {
      "t": "08:34",
      "text": "ఆహా"
    },
    {
      "t": "08:36",
      "text": "అందుకే బ్రేకప్ అయింది నీకు"
    },
    {
      "t": "08:38",
      "text": "ఆ"
    },
    {
      "t": "08:40",
      "text": "ఓకే సార్"
    },
    {
      "t": "08:42",
      "text": "సరదాగా అంటున్నానులే"
    },
    {
      "t": "08:44",
      "text": "షేర్"
    },
    {
      "t": "08:46",
      "text": "చెప్పండి"
    },
    {
      "t": "08:48",
      "text": "సో ఇంతకీ ఏం చదువుతున్నావు చదువుతున్నావా లేకపోతే"
    },
    {
      "t": "08:50",
      "text": "డిగ్రీ పాఠశాల"
    },
    {
      "t": "08:52",
      "text": "ఓకే"
    },
    {
      "t": "08:54",
      "text": "ఓకే"
    },
    {
      "t": "08:56",
      "text": "సరే ఒకసారి నాకు ఫేస్ చూపిస్తాను"
    },
    {
      "t": "08:58",
      "text": "వస్తావా ఇక్కడ"
    },
    {
      "t": "09:00",
      "text": "ఆ ప్రాబ్లం"
    },
    {
      "t": "09:02",
      "text": "అందులో"
    },
    {
      "t": "09:04",
      "text": "సరే"
    },
    {
      "t": "09:06",
      "text": "ఇక్కడ చూస్తాను ఇక్కడ నాకు నచ్చితే"
    },
    {
      "t": "09:08",
      "text": "ఇన్స్టాలో కనెక్ట్ అవుదాం"
    },
    {
      "t": "09:10",
      "text": "ఓకే లైన్లో ఉండండి"
    },
    {
      "t": "09:12",
      "text": "ఆ"
    },
    {
      "t": "09:14",
      "text": "ఇలాగే చేసుకుంటాను"
    },
    {
      "t": "09:16",
      "text": "ఓకే"
    },
    {
      "t": "09:18",
      "text": "ఓకే"
    },
    {
      "t": "09:20",
      "text": "షెడ్యూల్డ్ ట్రైనింగ్ ఇచ్చారు"
    },
    {
      "t": "09:22",
      "text": "ఓకే"
    },
    {
      "t": "09:24",
      "text": "అవును"
    },
    {
      "t": "09:26",
      "text": "షెడ్యూల్డ్"
    },
    {
      "t": "09:28",
      "text": "అదే"
    },
    {
      "t": "09:30",
      "text": "అదే"
    },
    {
      "t": "09:32",
      "text": "సరేనండి"
    },
    {
      "t": "09:34",
      "text": "అవును ఇన్స్టా"
    },
    {
      "t": "09:36",
      "text": "ఒకటే ఉందా లేకపోతే ఇంకేమన్నా ఉన్నాయా"
    },
    {
      "t": "09:38",
      "text": "లేదు లేదు వస్తాను"
    },
    {
      "t": "09:40",
      "text": "అవును"
    },
    {
      "t": "09:42",
      "text": "స్నాప్ కానీ ఇంకోటి ఏం లేదా"
    },
    {
      "t": "09:44",
      "text": "అంతే"
    },
    {
      "t": "09:46",
      "text": "ఆర్గానిక్స్ ప్యానెల్ ఆఫ్లైన్ ఆ వర్కే ఇవ్వడం"
    },
    {
      "t": "09:48",
      "text": "ఓకే"
    },
    {
      "t": "09:50",
      "text": "స్నాప్డ్రాగన్ బాగుంటుంది కదా"
    },
    {
      "t": "09:52",
      "text": "కాల్స్ అవి"
    },
    {
      "t": "09:54",
      "text": "అందరు ఆడుతున్నారు"
    },
    {
      "t": "09:56",
      "text": "అందుకని స్నాతన"
    },
    {
      "t": "09:58",
      "text": "తొందరగా అలసిపోతున్నాం"
    },
    {
      "t": "10:00",
      "text": "ఓకే"
    },
    {
      "t": "10:02",
      "text": "స్నాప్డ్రాగన్ ప్రైవసీ లిమిటెడ్"
    },
    {
      "t": "10:04",
      "text": "హ్యాపీగా"
    },
    {
      "t": "10:06",
      "text": "క్రికెట్"
    },
    {
      "t": "10:08",
      "text": "అప్పుడు"
    },
    {
