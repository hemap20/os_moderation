    },
    {
      "t": "00:06",
      "text": "ഹലോ എവിടുന്നാണ്"
    },
    {
      "t": "00:08",
      "text": "എൻട്രി വാന്ഡ്രോമിസ്"
    },
    {
      "t": "00:10",
      "text": "ഞാൻ മലപ്പുറം"
    },
    {
      "t": "00:12",
      "text": "എന്തേന്നു"
    },
    {
      "t": "00:14",
      "text": "ഞാൻ വർക്ക് ചെയ്യുന്നു ഏതോ"
    },
    {
      "t": "00:16",
      "text": "ഞാൻ ഹൗസ് വൈഫ് ആണ്"
    },
    {
      "t": "00:18",
      "text": "ഹസ്ബൻഡ് പുറത്താണ് എത്രയാണ് ആപ്പിള്"
    },
    {
      "t": "00:20",
      "text": "ഞാൻ കുറച്ച് എല്ലാവരും"
    },
    {
      "t": "00:22",
      "text": "ഓക്കേ"
    },
    {
      "t": "00:24",
      "text": "ഓക്കെ ഞാൻ ഹൗസ് വൈഫാണ് ഹസ്ബൻഡ് പുറത്ത്"
    },
    {
      "t": "00:26",
      "text": "താഴെ"
    },
    {
      "t": "00:28",
      "text": "ഓക്കേ എന്തൊക്കെയുണ്ട് വിശേഷം"
    },
    {
      "t": "00:30",
      "text": "സുഖമായി പോകുന്നു"
    },
    {
      "t": "00:32",
      "text": "അപ്പോൾ ഒന്ന് ഓപ്പൺ ഡോർ ഫീ നാല്പ്പര്യണ്ട് വാട്സാപ്പിൽ"
    },
    {
      "t": "00:34",
      "text": "ഓക്കെ"
    },
    {
      "t": "00:36",
      "text": "ആ"
    }
  ],
