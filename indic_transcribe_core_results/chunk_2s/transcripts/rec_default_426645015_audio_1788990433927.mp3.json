  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే అండి"
    },
    {
      "t": "00:02",
      "text": "హాయ్"
    },
    {
      "t": "00:04",
      "text": "ఎక్కడ నుంచి అండి"
    },
    {
      "t": "00:06",
      "text": "నువ్వే కెమెరా"
    },
    {
      "t": "00:08",
      "text": "ఉంటానండి"
    },
    {
      "t": "00:10",
      "text": "ఓకే"
    },
    {
      "t": "00:12",
      "text": "మోటోరా"
    },
    {
      "t": "00:14",
      "text": "స్నేహకర్తలు"
    },
    {
      "t": "00:16",
      "text": "మిరపకాయ"
    },
    {
      "t": "00:18",
      "text": "గుంటూరు మ్యామ్"
    },
    {
      "t": "00:20",
      "text": "మరి"
    },
    {
      "t": "00:22",
      "text": "తిన్నావా"
    },
    {
      "t": "00:24",
      "text": "ఆన్లైన్"
    },
    {
      "t": "00:26",
      "text": "నేను తినలేదు నువ్వు పెడితే తింటాను"
    },
    {
      "t": "00:28",
      "text": "దాపరిక"
    },
    {
      "t": "00:30",
      "text": "అది కాదు"
    },
    {
      "t": "00:32",
      "text": "రెడీ"
    },
    {
      "t": "00:34",
      "text": "అదే పెడుతుందా"
    },
    {
      "t": "00:36",
      "text": "పెద్దవారు"
    },
    {
      "t": "00:38",
      "text": "వస్తావని"
    },
    {
      "t": "00:40",
      "text": "దేవుడు తనని"
    },
    {
      "t": "00:42",
      "text": "దిగడానికి"
    },
    {
      "t": "00:44",
      "text": "పల్సర్లో రావాలి"
    },
    {
      "t": "00:46",
      "text": "వాట్సాప్ తర్వాత మాట్లాడదాంలే"
    },
    {
      "t": "00:48",
      "text": "ఫస్ట్ ఇట్లా మాట్లాడుతున్నాను"
    },
    {
      "t": "00:50",
      "text": "మాట్లాడండి"
    },
    {
      "t": "00:52",
      "text": "బాగుంటుందని"
    },
    {
      "t": "00:54",
      "text": "బాగుంది"
    },
    {
      "t": "00:56",
      "text": "ఫైల్స్ ఉంటాయి"
    },
    {
      "t": "00:58",
      "text": "ఎస్"
    },
    {
      "t": "01:00",
      "text": "కాన్సర్ ఏముంది పైనుంచి"
    },
    {
      "t": "01:02",
      "text": "చీర చీర తీయాలి"
    },
    {
      "t": "01:04",
      "text": "చీర తీయాలంటే వాట్సాప్లోనే"
    },
    {
      "t": "01:06",
      "text": "తీయాలండి జాకెట్ చీరల"
    },
    {
      "t": "01:08",
      "text": "పార్సెల్ ఉంది"
    },
    {
      "t": "01:10",
      "text": "ఇస్తారు"
    },
    {
      "t": "01:12",
      "text": "ఈ ఏడు తీగలు"
    },
    {
      "t": "01:14",
      "text": "పది"
    },
    {
      "t": "01:16",
      "text": "యాప్లో దిగాను"
    },
    {
      "t": "01:18",
      "text": "అర్కరా"
    },
    {
      "t": "01:20",
      "text": "కాదు తహసీల్దార్ని మేము"
    },
    {
      "t": "01:22",
      "text": "అవును దీనితోనే మిమ్మల్ని ఉంటాను"
    },
    {
      "t": "01:24",
      "text": "ఆ"
    },
    {
      "t": "01:26",
      "text": "సమస్యలు దానికి పోయినా బాగుండవు"
    },
    {
      "t": "01:28",
      "text": "తేనె దిబ్బలు ఉంటాయి"
    },
    {
      "t": "01:30",
      "text": "అలానే"
    },
    {
      "t": "01:32",
      "text": "దేనికి ముసలిదాన్ని"
    },
    {
      "t": "01:34",
      "text": "ఉంటాయి నీకు"
    },
    {
      "t": "01:36",
      "text": "అయిపోయింది"
    },
    {
      "t": "01:38",
      "text": "అదే"
    },
    {
      "t": "01:40",
      "text": "ముప్పై ఐదు ముప్పై ఐదున"
    },
    {
      "t": "01:42",
      "text": "రెండు ముప్పై"
    },
    {
      "t": "01:44",
      "text": "ఎవరినో కొట్టారు చెప్పమని"
    },
    {
      "t": "01:46",
      "text": "యా"
    },
    {
      "t": "01:48",
      "text": "యాభై యాభై ఇంకా యాభై రోజులు"
    },
    {
      "t": "01:50",
      "text": "నేను ఒక"
