{
  "file_id": "rec_audio_call_426565068_audio_1788982358963.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 642.254,
  "processing_time_sec": 1856.5884375572205,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "ഓക്കെ"
    },
    {
      "t": "00:04",
      "text": "ആ ആ ആ"
    },
    {
      "t": "00:06",
      "text": "ഹലോ"
    },
    {
      "t": "00:08",
      "text": "ഹലോ"
    },
    {
      "t": "00:10",
      "text": "ആ പേരെന്തായിരുന്നു"
    },
    {
      "t": "00:12",
      "text": "പറയത്തില്ല"
    },
    {
      "t": "00:14",
      "text": "ആ"
    },
    {
      "t": "00:16",
      "text": "എന്ത് ചെയ്യും"
    },
    {
      "t": "00:18",
      "text": "പറയരുതെന്ന് അവർ പറഞ്ഞു"
    },
    {
      "t": "00:20",
      "text": "ആര് പറഞ്ഞു"
    },
    {
      "t": "00:22",
      "text": "യാ പിന്നെ ഉള്ള"
    },
    {
      "t": "00:24",
      "text": "ചേച്ചി"
    },
    {
      "t": "00:26",
      "text": "അപ്പം"
    },
    {
      "t": "00:28",
      "text": "വേറെ എന്തെങ്കിലും വർക്ക് ചെയ്യണോ"
    },
    {
      "t": "00:30",
      "text": "നമ്മൾ നാട് വീട്"
    },
    {
      "t": "00:32",
      "text": "ഒരു കാര്യങ്ങൾ പേഴ്സണൽ കാര്യങ്ങൾ ഒന്നും"
    },
    {
      "t": "00:34",
      "text": "ഒന്നും പറയരുതെന്ന് പറഞ്ഞു ബാക്കി"
    },
    {
      "t": "00:36",
      "text": "ചീത്തയൊക്കെ പറയാൻ നോക്കും"
    },
    {
      "t": "00:38",
      "text": "മ്മ്"
    },
    {
      "t": "00:40",
      "text": "ആ"
    },
    {
      "t": "00:42",
      "text": "താങ്കൾക്ക് താങ്കൾ എന്തിനാണ് വന്നത്"
    },
    {
      "t": "00:44",
      "text": "ഓക്കെ"
    },
    {
      "t": "00:46",
      "text": "ഞാൻ വെറുതെ സംസാരിച്ചിരിക്കുകയാണ്"
    },
    {
      "t": "00:48",
      "text": "ആ ചോദിക്കാം"
    },
    {
      "t": "00:50",
      "text": "അടുത്തത്"
    },
    {
      "t": "00:52",
      "text": "ഓക്കെ"
    },
    {
      "t": "00:54",
      "text": "താങ്കളുടെ പേര്"
    },
    {
      "t": "00:56",
      "text": "ഈ"
    },
    {
      "t": "00:58",
      "text": "നിയാസ്"
    },
    {
      "t": "01:00",
      "text": "ആ ചേച്ചിയൊന്നും പറഞ്ഞില്ല ഇയാളുടെ അടുത്ത്"
    },
    {
      "t": "01:02",
      "text": "ഓക്കെ"
    },
    {
      "t": "01:04",
      "text": "ആ ചേച്ചി പറഞ്ഞില്ലേ"
    },
    {
      "t": "01:06",
      "text": "എന്താ പറഞ്ഞത്"
    },
    {
      "t": "01:08",
      "text": "ഇയാൾ ഇപ്പം പറഞ്ഞേക്ക് തന്നെ"
    },
    {
      "t": "01:10",
      "text": "ആ"
    },
    {
      "t": "01:12",
      "text": "അതിൻ്റെ"
    },
    {
      "t": "01:14",
      "text": "അയാൾ എന്താ അതനുസരിക്കാത്തത്"
    },
    {
      "t": "01:16",
      "text": "ആ"
    },
    {
      "t": "01:18",
      "text": "ആ"
    },
    {
      "t": "01:20",
      "text": "ആ തിലക്കപ്പന്ത"
    },
    {
      "t": "01:22",
      "text": "ഇയാളിപ്പോൾ ഗൂഗിൾ ചെയ്തപ്പോൾ നമ്മൾ ചോദിക്കും ആരാണ്"
    },
    {
      "t": "01:24",
      "text": "ആ"
    },
    {
      "t": "01:26",
      "text": "അപ്പം"
    },
    {
      "t": "01:28",
      "text": "പേര് പറയണം"
    },
    {
      "t": "01:30",
      "text": "പോവാം ഇങ്ങനെ"
    },
    {
      "t": "01:32",
      "text": "ആ ഞാൻ"
    },
    {
      "t": "01:34",
      "text": "ആസിം"
    },
    {
      "t": "01:36",
      "text": "എന്താ"
    },
    {
      "t": "01:38",
      "text": "പേര് എന്താണ് ആസിം എന്നല്ലേ പറഞ്ഞത്"
    },
    {
      "t": "01:40",
      "text": "നിയാസ്"
    },
    {
      "t": "01:42",
      "text": "ഒനിയൻ"
    },
    {
      "t": "01:44",
      "text": "സഹകരിച്ച്"
    },
    {
      "t": "01:46",
      "text": "പെട്ടെന്ന്"
    },
    {
      "t": "01:48",
      "text": "നീയ"
    },
    {
      "t": "01:50",
      "text": "നിയാസോക്കി നിയാസിയോയി"
    },
    {
      "t": "01:52",
      "text": "എയിറ്റ്"
    },
    {
      "t": "01:54",
      "text": "നോട്ട്"
    },
    {
      "t": "01:56",
      "text": "എൻ്റെ പേരെന്താ ഫ്ലോ"
    },
    {
      "t": "01:58",
      "text": "എൻ്റെ പേരാ"
    },
    {
      "t": "02:00",
      "text": "അന്തോണി ആമ"
    },
    {
      "t": "02:02",
      "text": "എന്തോന്നെയോ"
    },
    {
      "t": "02:04",
      "text": "ആൻ്റോണി"
    },
    {
      "t": "02:06",
      "text": "എം എ"
    },
    {
      "t": "02:08",
      "text": "ഇൻഡോണിയൻമാർ"
    },
    {
      "t": "02:10",
      "text": "ആ"
    },
    {
      "t": "02:12",
      "text": "ഓക്കെ"
    },
    {
      "t": "02:14",
      "text": "ഞങ്ങൾ ക്രിസ്ത്യൻസാണ്"
    },
    {
      "t": "02:16",
      "text": "അത് മനസ്സിലായി"
    },
    {
      "t": "02:18",
      "text": "ആ"
    },
    {
      "t": "02:20",
      "text": "പൂർണ്ണാഞ്ചൽ കടൽ"
    },
    {
      "t": "02:22",
      "text": "കുളച്ചത്"
    },
    {
      "t": "02:24",
      "text": "കുറച്ചെല്ലാം"
    },
    {
      "t": "02:26",
      "text": "ആ"
    },
    {
      "t": "02:28",
      "text": "അത് കേട്ടോ"
    },
    {
      "t": "02:30",
      "text": "തമിഴ്നാട്"
    },
    {
      "t": "02:32",
      "text": "ഓർഡർ"
    },
    {
      "t": "02:34",
      "text": "എനിക്ക് എനിക്ക് ശ്രീലങ്ക"
    },
    {
      "t": "02:36",
      "text": "തെരും തമിഴ് തെരും"
    },
    {
      "t": "02:38",
      "text": "ആ"
    },
    {
      "t": "02:40",
      "text": "വലിയ"
    },
    {
      "t": "02:42",
      "text": "പുള്ളിയപ്പൂ"
    },
    {
      "t": "02:44",
      "text": "ആ"
    },
    {
      "t": "02:46",
      "text": "നിനക്ക് എത്ര ഭാഷ അറിയണം"
    },
    {
      "t": "02:48",
      "text": "എനിക്കും"
    },
    {
      "t": "02:50",
      "text": "മലയാളം അറിയും പിള്ളേരെ"
    },
    {
      "t": "02:52",
      "text": "ആ എനിക്ക് സയൻസ് അറിയാം സോഷ്യൽ സ്റ്റഡീസ്"
    },
    {
      "t": "02:54",
      "text": "എക്സർസൈസ് അറിയാം ഇന്ത്യയുടെ"
    },
    {
      "t": "02:56",
      "text": "അറിയാം"
    },
    {
      "t": "02:58",
      "text": "ആ"
    },
    {
      "t": "03:00",
      "text": "ആ"
    },
    {
      "t": "03:02",
      "text": "ആ"
    },
    {
      "t": "03:04",
      "text": "എന്നാൽ അറിയാം പൊങ്ങി"
    },
    {
      "t": "03:06",
      "text": "മ്മ് മ്മ്"
    },
    {
      "t": "03:08",
      "text": "അയ്യോ ഉറങ്ങാതെ എന്ത് ചെയ്യാൻ പോകുന്നു"
    },
    {
      "t": "03:10",
      "text": "ആ"
    },
    {
      "t": "03:12",
      "text": "പറഞ്ഞോണം"
    },
    {
      "t": "03:14",
      "text": "ഓക്കേ"
    },
    {
      "t": "03:16",
      "text": "എന്നാൽ ഞാൻ പോട്ടെ"
    },
    {
      "t": "03:18",
      "text": "പ്രമാണം"
    },
    {
      "t": "03:20",
      "text": "മ്മ് പവേ"
    },
    {
      "t": "03:22",
      "text": "അതെന്തേ"
    },
    {
      "t": "03:24",
      "text": "ആ"
    },
    {
      "t": "03:26",
      "text": "അതെന്താ ഈ ഫോൺ"
    },
    {
      "t": "03:28",
      "text": "ആ"
    },
    {
      "t": "03:30",
      "text": "നാളെ അന്നം മേടിക്കാൻ"
    },
    {
      "t": "03:32",
      "text": "ഞാൻ പോകണമെങ്കിൽ ജോലിക്ക് പോകാം"
    },
    {
      "t": "03:34",
      "text": "കോയിലിൻ്റെ അണ്ടം കിട്ടത്തുള്ളൂ"
    },
    {
      "t": "03:36",
      "text": "അതെ"
    },
    {
      "t": "03:38",
      "text": "അന്നം കിട്ടിയില്ലെങ്കിൽ നമ്മൾ"
    },
    {
      "t": "03:40",
      "text": "നമ്മളെന്തു ചെയ്യും"
    },
    {
      "t": "03:42",
      "text": "പെട്ടെന്നേ ഉള്ളൂ അല്ല"
    },
    {
      "t": "03:44",
      "text": "ബാത്റൂമിൽ പോകാനുള്ള പ്രൊഡക്ഷൻ സോഴ്സ്"
    },
    {
      "t": "03:46",
      "text": "ഒന്നും കിട്ടത്തില്ല"
    },
    {
      "t": "03:48",
      "text": "അപ്പം ആ പ്രൊഡക്റ്റ്"
    },
    {
      "t": "03:50",
      "text": "ആവശ്യം ചെയ്യുന്ന ആ പാർട്സ് ഇരുന്ന്"
    },
    {
      "t": "03:52",
      "text": "വിഷമിക്കും അവരെന്ത് ചെയ്യും"
    },
    {
      "t": "03:54",
      "text": "നിയറുള്ള പാർട്സിലുള്ള കാര്യങ്ങൾ"
    },
    {
      "t": "03:56",
      "text": "മുസ്ലീങ്ങളെ അവർ കടമെടുക്കും"
    },
    {
      "t": "03:58",
      "text": "അങ്ങനെ ഡെഫിനിഷൻ"
    },
    {
      "t": "04:00",
      "text": "ഡെഫിഷ്യൻസി ഉണ്ടാവും ഡെഫിഷ്യൻസി ഉണ്ടാവും"
    },
    {
      "t": "04:02",
      "text": "ഉണ്ടായാൽ എന്തുണ്ടാവും അസുഖം ഉണ്ടാവും"
    },
    {
      "t": "04:04",
      "text": "ഇതാ"
    },
    {
      "t": "04:06",
      "text": "എന്താ സയൻസിൻ്റെ ക്ലാസ്"
    },
    {
      "t": "04:08",
      "text": "ആ"
    },
    {
      "t": "04:10",
      "text": "ഇപ്പം എങ്ങനെ ഇരിക്കുന്നു"
    },
    {
      "t": "04:12",
      "text": "എന്താ ഞാൻ സെക്സ് ക്ലാസ് എടുത്തത്"
    },
    {
      "t": "04:14",
      "text": "ഇതൊക്കെ"
    },
    {
      "t": "04:16",
      "text": "എനിക്കിഷ്ടമാണോ"
    },
    {
      "t": "04:18",
      "text": "ഉം"
    },
    {
      "t": "04:20",
      "text": "നിനക്ക്"
    },
    {
      "t": "04:22",
      "text": "എനിക്ക് എന്ത് ടൈപ്പ് സെക്സ് ആണ് ഇഷ്ടം"
    },
    {
      "t": "04:24",
      "text": "ഉം"
    },
    {
      "t": "04:26",
      "text": "ഏതൊക്കെ ടൈപ്പ് പറയും"
    },
    {
      "t": "04:28",
      "text": "മാറി"
    },
    {
      "t": "04:30",
      "text": "കുട്ടി പറയും സിംഗിള് പറയും"
    },
    {
      "t": "04:32",
      "text": "ഓക്കെ"
    },
    {
      "t": "04:34",
      "text": "വൺ"
    },
    {
      "t": "04:36",
      "text": "ബൈ വൺ പറയും"
    },
    {
      "t": "04:38",
      "text": "ആ"
    },
    {
      "t": "04:40",
      "text": "ഹലോ"
    },
    {
      "t": "04:42",
      "text": "ആ പറയൂ"
    },
    {
      "t": "04:44",
      "text": "സിംഗിൾ പറയൂ"
    },
    {
      "t": "04:46",
      "text": "ഡബിൾ വരെയും ട്രിപ്പിൾ വരെയും"
    },
    {
      "t": "04:48",
      "text": "വൺ ബൈ"
    },
    {
      "t": "04:50",
      "text": "രണ്ടുപേരും"
    },
    {
      "t": "04:52",
      "text": "എന്നിട്ടും അപ്പം ഡബിൾ മീൻ"
    },
    {
      "t": "04:54",
      "text": "ഗേറ്റ്"
    },
    {
      "t": "04:56",
      "text": "ടു മെൻ പറയും ട്രാൻസ്ജെൻഡർ"
    },
    {
      "t": "04:58",
      "text": "ഡസ് പറയും ഡസ്"
    },
    {
      "t": "05:00",
      "text": "പി എൻ പറയും"
    },
    {
      "t": "05:02",
      "text": "ആ"
    },
    {
      "t": "05:04",
      "text": "വേണ്ടി പറയും"
    },
    {
      "t": "05:06",
      "text": "ആ"
    },
    {
      "t": "05:08",
      "text": "ആ"
    },
    {
      "t": "05:10",
      "text": "ഇപ്പം നമ്മൾ രണ്ടുപേരും"
    },
    {
      "t": "05:12",
      "text": "അതിനനുസരിച്ച് പറഞ്ഞാൽ"
    },
    {
      "t": "05:14",
      "text": "ഓഹോ"
    },
    {
      "t": "05:16",
      "text": "മ്മ്"
    },
    {
      "t": "05:18",
      "text": "പറഞ്ഞു എനിക്ക്"
    },
    {
      "t": "05:20",
      "text": "എന്താണ് ബെനിഫിറ്റ്"
    },
    {
      "t": "05:22",
      "text": "ആ"
    },
    {
      "t": "05:24",
      "text": "എന്തായിരുന്നു വേണ്ടത്"
    },
    {
      "t": "05:26",
      "text": "ആ"
    },
    {
      "t": "05:28",
      "text": "പേടിക്കണ്ട"
    },
    {
      "t": "05:30",
      "text": "വേണ്ട"
    },
    {
      "t": "05:32",
      "text": "ആ"
    },
    {
      "t": "05:34",
      "text": "ആ"
    },
    {
      "t": "05:36",
      "text": "ആ"
    },
    {
      "t": "05:38",
      "text": "ഒന്നും വേണ്ട"
    },
    {
      "t": "05:40",
      "text": "എനിക്കൊന്നും വേണ്ട"
    },
    {
      "t": "05:42",
      "text": "ഞാൻ ചോദിച്ചത്"
    },
    {
      "t": "05:44",
      "text": "മ്മ്"
    },
    {
      "t": "05:46",
      "text": "ആ"
    },
    {
      "t": "05:48",
      "text": "ആ"
    },
    {
      "t": "05:50",
      "text": "എത്ര വയസ്സായി"
    },
    {
      "t": "05:52",
      "text": "അമ്പത്തെട്ട്"
    },
    {
      "t": "05:54",
      "text": "എത്രയും"
    },
    {
      "t": "05:56",
      "text": "അൻപത്തി എട്ട്"
    },
    {
      "t": "05:58",
      "text": "അൻപത്തെട്ടോ"
    },
    {
      "t": "06:00",
      "text": "മ്മ്"
    },
    {
      "t": "06:02",
      "text": "ആ"
    },
    {
      "t": "06:04",
      "text": "എന്ത്"
    },
    {
      "t": "06:06",
      "text": "മൂർച്ഛാദി"
    },
    {
      "t": "06:08",
      "text": "ആയിപ്പോയി എന്ന്"
    },
    {
      "t": "06:10",
      "text": "അത് ഈ"
    },
    {
      "t": "06:12",
      "text": "ഈശ്വരൻ കനിഞ്ഞ് ഓരോ"
    },
    {
      "t": "06:14",
      "text": "ദിവസം കൂടുന്തോറും എൻ്റെ സ്വയം വഴി"
    },
    {
      "t": "06:16",
      "text": "ഇങ്ങനെ ചെറുതായി ചെറുതായി"
    },
    {
      "t": "06:18",
      "text": "ആയിരുന്നു"
    },
    {
      "t": "06:20",
      "text": "ആ"
    },
    {
      "t": "06:22",
      "text": "ആഹ്"
    },
    {
      "t": "06:24",
      "text": "ഞാൻ"
    },
    {
      "t": "06:26",
      "text": "ഞങ്ങളുടെ നാട്ടിലെവിടെയാണ്"
    },
    {
      "t": "06:28",
      "text": "കാലിക്കറ്റ്"
    },
    {
      "t": "06:30",
      "text": "യേ"
    },
    {
      "t": "06:32",
      "text": "കൊഴുക്കോ"
    },
    {
      "t": "06:34",
      "text": "ഉള്ളതങ്ങ് പറഞ്ഞാൽ പോരെ"
    },
    {
      "t": "06:36",
      "text": "ആ നിന്നെ പൊക്കിക്കോളു"
    },
    {
      "t": "06:38",
      "text": "ഓൾ ടൈൽ കട്ടന്മാർ"
    },
    {
      "t": "06:40",
      "text": "ആര്"
    },
    {
      "t": "06:42",
      "text": "ഉം"
    },
    {
      "t": "06:44",
      "text": "ഞങ്ങൾക്ക് ഏജ് എത്രയുണ്ട്"
    },
    {
      "t": "06:46",
      "text": "ട്വന്റി സിക്സ്"
    },
    {
      "t": "06:48",
      "text": "ഇല്ല"
    },
    {
      "t": "06:50",
      "text": "ട്വന്റി സിക്സ് ആൽഗയാണ് വിശ്വസിക്കുന്നത്"
    },
    {
      "t": "06:52",
      "text": "പിന്നെ"
    },
    {
      "t": "06:54",
      "text": "ഈ ട്രെൻഡിസെ"
    },
    {
      "t": "06:56",
      "text": "ടെക്സ്റ്റിലുള്ള ആൾക്കാർ ഇത്രയും ശാന്തരായിരിക്കും"
    },
    {
      "t": "06:58",
      "text": "ശരി"
    },
    {
      "t": "07:00",
      "text": "ആ"
    },
    {
      "t": "07:02",
      "text": "അല്ല അവര് ഇനി സംസാരിക്കുവോ എന്ന്"
    },
    {
      "t": "07:04",
      "text": "എനിക്ക് ഇത്രയും കൂടുതൽ"
    },
    {
      "t": "07:06",
      "text": "ഉം"
    },
    {
      "t": "07:08",
      "text": "ആ"
    },
    {
      "t": "07:10",
      "text": "അതെ"
    },
    {
      "t": "07:12",
      "text": "മിക്കാത്തേയും"
    },
    {
      "t": "07:14",
      "text": "മ്മ്"
    },
    {
      "t": "07:16",
      "text": "എങ്ങനെയാണ് കിണിക്കുന്ന്"
    },
    {
      "t": "07:18",
      "text": "കേട്ടില്ല"
    },
    {
      "t": "07:20",
      "text": "ആ"
    },
    {
      "t": "07:22",
      "text": "നന്നായിട്ട് ക്ലാസ് എടുത്തായിരുന്നു നേരെ എപ്പോഴായിരിക്കും"
    },
    {
      "t": "07:24",
      "text": "ഓക്കെ"
    },
    {
      "t": "07:26",
      "text": "നിയ"
    },
    {
      "t": "07:28",
      "text": "ആ"
    },
    {
      "t": "07:30",
      "text": "എന്താ ജോലി"
    },
    {
      "t": "07:32",
      "text": "ആ"
    },
    {
      "t": "07:34",
      "text": "ഞാൻ ഇപ്പോൾ പുറത്ത്"
    },
    {
      "t": "07:36",
      "text": "വേറെ ഓസ്കോപ്പ"
    },
    {
      "t": "07:38",
      "text": "മൂന്ന്"
    },
    {
      "t": "07:40",
      "text": "പുറത്താണല്ലേ"
    },
    {
      "t": "07:42",
      "text": "മ്മ്"
    },
    {
      "t": "07:44",
      "text": "ഇപ്പം ആ രാത്രിയിലൊന്നും സംസാരിക്കേണ്ട"
    },
    {
      "t": "07:46",
      "text": "അതെ"
    },
    {
      "t": "07:48",
      "text": "മ്മ്"
    },
    {
      "t": "07:50",
      "text": "നൂറ്റിയെട്ട്"
    },
    {
      "t": "07:52",
      "text": "അവിടെ എന്നാ ജോബ്"
    },
    {
      "t": "07:54",
      "text": "വേറെ ഓഫ്"
    },
    {
      "t": "07:56",
      "text": "കേട്ടില്ല"
    },
    {
      "t": "07:58",
      "text": "വെയർ ഹൗസിലാണ് ഫുഡിൻ്റെ"
    },
    {
      "t": "08:00",
      "text": "വേർ"
    },
    {
      "t": "08:02",
      "text": "ഹൗസ് മിൻസ്"
    },
    {
      "t": "08:04",
      "text": "ഫാക്ടറിയാണ് ഫുഡ്"
    },
    {
      "t": "08:06",
      "text": "ചെവ്വ"
    },
    {
      "t": "08:08",
      "text": "ട്രാക്കിങ് ഏ"
    },
    {
      "t": "08:10",
      "text": "പാക്കിംഗ്"
    },
    {
      "t": "08:12",
      "text": "പരിപാടിക്കും മെഷീനറി പിന്നെ"
    },
    {
      "t": "08:14",
      "text": "ആ"
    },
    {
      "t": "08:16",
      "text": "അപ്പം"
    },
    {
      "t": "08:18",
      "text": "അവിടെ നിന്ന് ഷെഫിന് പഠിക്കണം"
    },
    {
      "t": "08:20",
      "text": "നീ അതൊന്നും അല്ല"
    },
    {
      "t": "08:22",
      "text": "മ്മ്"
    },
    {
      "t": "08:24",
      "text": "ആ"
    },
    {
      "t": "08:26",
      "text": "എന്നാൽ ഒരു മാസം തേർട്ടി ഫൈവ് കിട്ടുമോ"
    },
    {
      "t": "08:28",
      "text": "ആ വിട്ടോ"
    },
    {
      "t": "08:30",
      "text": "ഫുഡ് കഴിഞ്ഞു"
    },
    {
      "t": "08:32",
      "text": "എന്നിട്ട് നാട്ടിൽ എന്താ കഴിച്ചു കൊടുക്കാൻ പറ്റുക"
    },
    {
      "t": "08:34",
      "text": "ഓക്കെ"
    },
    {
      "t": "08:36",
      "text": "നാട്ടിലേക്ക് ഒറ്റ വണ്ടിയൊക്കെ"
    },
    {
      "t": "08:38",
      "text": "എത്താം"
    },
    {
      "t": "08:40",
      "text": "അയ്യോ"
    },
    {
      "t": "08:42",
      "text": "ഇനി ട്വന്റി"
    },
    {
      "t": "08:44",
      "text": "പറ്റുന്നതിനാണ് അത്രയും വലിയ സ്ഥലത്ത്"
    },
    {
      "t": "08:46",
      "text": "വീഡിയോയിൽ ഞാൻ"
    },
    {
      "t": "08:48",
      "text": "സ്റ്റാർട്ടിങ്ങ് അങ്ങനെയൊക്കെ ഉണ്ടാവും പിന്നെ"
    },
    {
      "t": "08:50",
      "text": "നരേറ്റീവ്"
    },
    {
      "t": "08:52",
      "text": "പാസ്പോർട്ട്"
    },
    {
      "t": "08:54",
      "text": "ഈ ചിത്രം ഇല്ലേ ഉള്ളൂ"
    },
    {
      "t": "08:56",
      "text": "ഈ കൊച്ചു ചരിത്രം"
    },
    {
      "t": "08:58",
      "text": "അയ്യോ നമ്മൾ നിങ്ങളുടെ"
    },
    {
      "t": "09:00",
      "text": "ഓക്കെ"
    },
    {
      "t": "09:02",
      "text": "ഞാൻ ഇന്ന് ഡേറ്റ് ടേബിൾ"
    },
    {
      "t": "09:04",
      "text": "ഉൾട്ടൊരു ചാനൽ"
    },
    {
      "t": "09:06",
      "text": "അപ്പോഴത്തേക്ക് കാഴ്ച"
    },
    {
      "t": "09:08",
      "text": "കഴിഞ്ഞപ്പോഴത്തേക്ക് ഉറങ്ങാൻ പറ്റില്ലല്ലോ"
    },
    {
      "t": "09:10",
      "text": "ഇച്ചിരി ഡൈജഷൻസ് മാത്രമല്ലേ"
    },
    {
      "t": "09:12",
      "text": "അപ്പോൾ"
    },
    {
      "t": "09:14",
      "text": "വായിക്കും അപ്പം ഇതിനകത്ത് വിളിക്കുകയാണെങ്കിൽ"
    },
    {
      "t": "09:16",
      "text": "ആ രോണയും"
    },
    {
      "t": "09:18",
      "text": "ഈ സംഗതികൾ"
    },
    {
      "t": "09:20",
      "text": "ആ ആ"
    },
    {
      "t": "09:22",
      "text": "അങ്ങനെയാണ് വിളിക്കുന്നത്"
    },
    {
      "t": "09:24",
      "text": "കിട്ടാൻ വേണ്ടി വന്നു കാരണം"
    },
    {
      "t": "09:26",
      "text": "എൻ്റെ ഫോണിൽ ചാറ്റ്"
    },
    {
      "t": "09:28",
      "text": "ചൂടില്ല ഒട്ടും കഴിയുന്നില്ല"
    },
    {
      "t": "09:30",
      "text": "ഉം"
    },
    {
      "t": "09:32",
      "text": "പിൻ"
    },
    {
      "t": "09:34",
      "text": "വാ വാ"
    },
    {
      "t": "09:36",
      "text": "സസ്പെൻഡ് ചെയ്യും"
    },
    {
      "t": "09:38",
      "text": "പകർച്ച പെൻറ്റിനെ ഞാൻ അടിച്ചു കളഞ്ഞു"
    },
    {
      "t": "09:40",
      "text": "ഉം ഉം"
    },
    {
      "t": "09:42",
      "text": "ആ"
    },
    {
      "t": "09:44",
      "text": "ഓക്കെ"
    },
    {
      "t": "09:46",
      "text": "എ കെ ഹണി"
    },
    {
      "t": "09:48",
      "text": "ആ അതെ"
    },
    {
      "t": "09:50",
      "text": "ശരി"
    },
    {
      "t": "09:52",
      "text": "ഞാൻ"
    },
    {
      "t": "09:54",
      "text": "ചേച്ചി ലഡാൻഡ്"
    },
    {
      "t": "09:56",
      "text": "ആൻറ്റി"
    },
    {
      "t": "09:58",
      "text": "ആ"
    },
    {
      "t": "10:00",
      "text": "ആ"
    },
    {
      "t": "10:02",
      "text": "ആ"
    },
    {
      "t": "10:04",
      "text": "ആ"
    },
    {
      "t": "10:06",
      "text": "ആ"
    },
    {
      "t": "10:08",
      "text": "ആ"
    },
    {
      "t": "10:10",
      "text": "അതിൻ്റെ എന്ത് ചെയ്യും ഇപ്പോൾ"
    },
    {
      "t": "10:12",
      "text": "ഓ അറക്കം എന്താണെങ്കിലും"
    },
    {
      "t": "10:14",
      "text": "ചേച്ചിക്ക് ഇങ്ങനെ"
    },
    {
      "t": "10:16",
      "text": "എനിയോ"
    },
    {
      "t": "10:18",
      "text": "ആ വൈകുന്നേരം"
    },
    {
      "t": "10:20",
      "text": "മെയ് മൂന്ന് മെയ്"
    },
    {
      "t": "10:22",
      "text": "അയോർജിതം"
    },
    {
      "t": "10:24",
      "text": "സെക്കൻഡ് തുടങ്ങി"
    },
    {
      "t": "10:26",
      "text": "എന്തോ ആസ്"
    },
    {
      "t": "10:28",
      "text": "നോ"
    },
    {
      "t": "10:30",
      "text": "എന്ത് ഓർ എനി"
    },
    {
      "t": "10:32",
      "text": "ഓർക്കാൻ കഴിഞ്ഞു ശരിയാണ് ബൈ"
    },
    {
      "t": "10:34",
      "text": "ഓക്കേ"
    },
    {
      "t": "10:36",
      "text": "എൻഡിങ്"
    },
    {
      "t": "10:38",
      "text": "നമുക്ക് തേടാനൊക്കണം പിന്നെ"
    },
    {
      "t": "10:40",
      "text": "ആലപ്പുഴയിൽ"
    },
    {
      "t": "10:42",
      "text": "യെസ്"
