{
  "file_id": "rec_audio_call_426664916_audio_1788995286548.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 642.611,
  "processing_time_sec": 220.62289237976074,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "ആ"
    },
    {
      "t": "00:04",
      "text": "ഹലോ"
    },
    {
      "t": "00:06",
      "text": "അയ്യോ"
    },
    {
      "t": "00:08",
      "text": "ഇത് മലപ്പുറം ഇത് എവിടുന്നാണ്"
    },
    {
      "t": "00:10",
      "text": "നോൺ വെജ് ആണല്ലോ"
    },
    {
      "t": "00:12",
      "text": "ഓക്കേ ഇയാളുടെ പേരെന്താണ്"
    },
    {
      "t": "00:14",
      "text": "ഗൂഗിൾ"
    },
    {
      "t": "00:16",
      "text": "എവിടെ പേരെന്താ"
    },
    {
      "t": "00:18",
      "text": "ഒറിയ ഒറിയ ഫാത്തി"
    },
    {
      "t": "00:20",
      "text": "ആ"
    },
    {
      "t": "00:22",
      "text": "ആ ഞാൻ"
    },
    {
      "t": "00:24",
      "text": "ഇൻസ്റ്റഡിയാണ് ഫാഷൻ ഡിസൈനിങ് ആണ്"
    },
    {
      "t": "00:26",
      "text": "സെക്കൻഡ് ഇയർ ആണ്"
    },
    {
      "t": "00:28",
      "text": "ഇപ്പം തിരൂർ വർക്ക് ചെയ്യുന്ന"
    },
    {
      "t": "00:30",
      "text": "ചെയ്യുന്നുണ്ട് ഇയാൾ എന്താ ചെയ്യുന്നത്"
    },
    {
      "t": "00:32",
      "text": "ഞാനിവിടെ ട്രിവാൻഡ്രത്തിൻ്റെ"
    },
    {
      "t": "00:34",
      "text": "ഇങ്ങനെയാണ് ഇവന്റ് മാനേജ്മെന്റ് വർക്ക് ചെയ്യുന്നത്"
    },
    {
      "t": "00:36",
      "text": "ഓക്കേ ഓക്കേ"
    },
    {
      "t": "00:38",
      "text": "ഓക്കേ സിംഗിൾ ആണോ അതോ മാരീഡ് ആണോ"
    },
    {
      "t": "00:40",
      "text": "താങ്ക് യു ആണ്"
    },
    {
      "t": "00:42",
      "text": "അവിടെ ആണ് സിംഗിൾ"
    },
    {
      "t": "00:44",
      "text": "വേണം മാര്യേജ് ഇങ്ങനെ നോക്കുന്നുണ്ട്"
    },
    {
      "t": "00:46",
      "text": "ആ"
    },
    {
      "t": "00:48",
      "text": "പിന്നെ"
    },
    {
      "t": "00:50",
      "text": "എത്രയാണ് ഈ അപ്ലയേ റേറ്റ്"
    },
    {
      "t": "00:52",
      "text": "പിന്നെ"
    },
    {
      "t": "00:54",
      "text": "കുറയ്ക്കണേ ആ എക്സ്പീരിയൻസ് ഇല്ല"
    },
    {
      "t": "00:56",
      "text": "അല്ല അപ്പോഴേ അർത്ഥം"
    },
    {
      "t": "00:58",
      "text": "ഇങ്ങനെ"
    },
    {
      "t": "01:00",
      "text": "ഞാൻ"
    },
    {
      "t": "01:02",
      "text": "ഇതപ്പം ഉറങ്ങില്ല ഉറങ്ങിയിട്ട് കാണും"
    },
    {
      "t": "01:04",
      "text": "ആണേ"
    },
    {
      "t": "01:06",
      "text": "ഉറങ്ങി എണീറ്റിറ്റൊന്ന് കയറിയതാണ്"
    },
    {
      "t": "01:08",
      "text": "ആണോ"
    },
    {
      "t": "01:10",
      "text": "ഓക്കെ"
    },
    {
      "t": "01:12",
      "text": "ആ"
    },
    {
      "t": "01:14",
      "text": "ഞാൻ ഉറങ്ങിയതാണ് പിന്നെ"
    },
    {
      "t": "01:16",
      "text": "പോസ്റ്റ് ടൈപ്പും കയറിയത്"
    },
    {
      "t": "01:18",
      "text": "ആ ആ"
    },
    {
      "t": "01:20",
      "text": "ശരി"
    },
    {
      "t": "01:22",
      "text": "പിന്നെ"
    },
    {
      "t": "01:24",
      "text": "എന്താണ് പരിപാടി"
    },
    {
      "t": "01:26",
      "text": "പിന്നെന്താ പിന്നെ"
    },
    {
      "t": "01:28",
      "text": "കുഴപ്പമൊന്നുമില്ല"
    },
    {
      "t": "01:30",
      "text": "ഇതെല്ലാം വീട്ടിലായിരിക്കും ഉണ്ട്"
    },
    {
      "t": "01:32",
      "text": "വീട്ടിൽ ഞാൻ അമ്മ അവിടെ"
    },
    {
      "t": "01:34",
      "text": "ഇവിടെ"
    },
    {
      "t": "01:36",
      "text": "ഞാനും"
    },
    {
      "t": "01:38",
      "text": "ഉമ്മച്ചിയുണ്ട് പിന്നെ വാപ്പയും"
    },
    {
      "t": "01:40",
      "text": "ബ്രദറൊക്കെ അബ്രോഡ് ആക്കി"
    },
    {
      "t": "01:42",
      "text": "ആ ഇപ്പം മച്ചിയാണ്"
    },
    {
      "t": "01:44",
      "text": "ഓക്കേ"
    },
    {
      "t": "01:46",
      "text": "ഇതിത്രയാണ്"
    },
    {
      "t": "01:48",
      "text": "ട്വൻ്റി ഫോർ"
    },
    {
      "t": "01:50",
      "text": "താങ്ക് യൂ"
    },
    {
      "t": "01:52",
      "text": "അവൻ"
    },
    {
      "t": "01:54",
      "text": "ആഹാ അതെ"
    },
    {
      "t": "01:56",
      "text": "ഇവൻ മാനേജ്മെന്റ്"
    },
    {
      "t": "01:58",
      "text": "അച്ചീവ്മെൻറ് ആണ് നാളെ വർക്കുണ്ടോ"
    },
    {
      "t": "02:00",
      "text": "നാളെ വർക്കില്ല നാളെ ഓഫാണ്"
    },
    {
      "t": "02:02",
      "text": "സാർ"
    },
    {
      "t": "02:04",
      "text": "ഓക്കേ ഓക്കേ ഇതിലെങ്ങനെ കോ"
    },
    {
      "t": "02:06",
      "text": "ഫ്രണ്ട്സൊക്കെ ഇങ്ങനെ ഒരു ആൻറ്റിമാരാണ് കൂടുതലും"
    },
    {
      "t": "02:08",
      "text": "ഇതില്"
    },
    {
      "t": "02:10",
      "text": "അങ്ങനെ കുറേയൊക്കെ വരും കുറേ ഫേക്ക് കോൾസ്"
    },
    {
      "t": "02:12",
      "text": "വരും പിന്നെ"
    },
    {
      "t": "02:14",
      "text": "അല്ലാതെ"
    },
    {
      "t": "02:16",
      "text": "ആന്റിമാരില്ലാത്ത ഒരു"
    },
    {
      "t": "02:18",
      "text": "പിള്ളേര് വരും"
    },
    {
      "t": "02:20",
      "text": "ഓക്കേ ഓക്കേ അല്ലേ ഞാൻ"
    },
    {
      "t": "02:22",
      "text": "ഇങ്ങനെ കേട്ടിട്ടുണ്ട്"
    },
    {
      "t": "02:24",
      "text": "ഒരുപാട് പേര് പറയും കുറേ കൂടുതൽ ആൻറ്റി"
    },
    {
      "t": "02:26",
      "text": "പൈസ ആണ് ആധാർ കാർഡ് വെച്ച്"
    },
    {
      "t": "02:28",
      "text": "ആൻഡീസ് ഒക്കെ ഉണ്ട് ആൻഡീസിന്"
    },
    {
      "t": "02:30",
      "text": "അവിടെ ഒന്നും അധികം സംസാരിക്കാറില്ല"
    },
    {
      "t": "02:32",
      "text": "ആ"
    },
    {
      "t": "02:34",
      "text": "എന്താ താല്പര്യം ഇല്ലാണ്ടാണോ"
    },
    {
      "t": "02:36",
      "text": "ആൻറ്റി മാരോട്"
    },
    {
      "t": "02:38",
      "text": "വലിയ താല്പര്യമില്ല"
    },
    {
      "t": "02:40",
      "text": "ആ"
    },
    {
      "t": "02:42",
      "text": "ഓക്കെ ഓക്കെ"
    },
    {
      "t": "02:44",
      "text": "അർജുനനോ കേട്ടില്ല"
    },
    {
      "t": "02:46",
      "text": "അല്ല"
    },
    {
      "t": "02:48",
      "text": "വെർജിൻ ആണോ"
    },
    {
      "t": "02:50",
      "text": "ഓ"
    },
    {
      "t": "02:52",
      "text": "ഓക്കേ അഫയറുണ്ടോ"
    },
    {
      "t": "02:54",
      "text": "അഫയർ മുന്നേ ഉണ്ടായിരുന്നു"
    },
    {
      "t": "02:56",
      "text": "അഭിപ്രായമില്ല"
    },
    {
      "t": "02:58",
      "text": "എൻ്റെ ഏറ്റവും ഉള്ളത് ചേച്ചിയുടെ"
    },
    {
      "t": "03:00",
      "text": "ഓ തെങ്ങിന് ഞാൻ പാടില്ല"
    },
    {
      "t": "03:02",
      "text": "പറയാം"
    },
    {
      "t": "03:04",
      "text": "ആ"
    },
    {
      "t": "03:06",
      "text": "യെല്ലോ"
    },
    {
      "t": "03:08",
      "text": "നിക്ക് ആസ്വദിക്കാൻ പറ്റും"
    },
    {
      "t": "03:10",
      "text": "വെറും ഡിനോ അത് മേസിൽ വരും"
    },
    {
      "t": "03:12",
      "text": "പിന്നെ"
    },
    {
      "t": "03:14",
      "text": "മ്യൂസിയം ഗ്രീനിലോ"
    },
    {
      "t": "03:16",
      "text": "അപ്പം ഓൺ ചെയ്യാൻ വിചാരിച്ചത്"
    },
    {
      "t": "03:18",
      "text": "അവന് ചെറുതായിട്ട് മറ്റേ ഡ്രഗ്സ് ഒക്കെ"
    },
    {
      "t": "03:20",
      "text": "ഓക്കെ യൂസ് ചെയ്തേനു ആ ഹാ"
    },
    {
      "t": "03:22",
      "text": "അപ്പം അത്"
    },
    {
      "t": "03:24",
      "text": "സീന ഈ വീട്ടിലോട്ട് കയറുന്നുണ്ട്"
    },
    {
      "t": "03:26",
      "text": "ഞാൻ അവർ പറഞ്ഞു"
    },
    {
      "t": "03:28",
      "text": "വേണ്ടാന്ന് വെക്കുന്നത് നല്ലതാ"
    },
    {
      "t": "03:30",
      "text": "പിന്നെ മീൻസ് ഇല്ലേ ഞങ്ങൾ പിരിഞ്ഞത്"
    },
    {
      "t": "03:32",
      "text": "അപ്പം ഇനി വേറെ കല്യാണം"
    },
    {
      "t": "03:34",
      "text": "നോക്കണം"
    },
    {
      "t": "03:36",
      "text": "ആ പിന്നെ വേറെ നോക്കാം"
    },
    {
      "t": "03:38",
      "text": "നോക്കണോ ഇനി ടൈമിംഗ് ഉണ്ട്"
    },
    {
      "t": "03:40",
      "text": "നമുക്കൊരു"
    },
    {
      "t": "03:42",
      "text": "ജോബൊക്കെ സെറ്റായി കുറച്ച്"
    },
    {
      "t": "03:44",
      "text": "ട്രെയിനിങ്ങ്സൊക്കെ കിട്ടി"
    },
    {
      "t": "03:46",
      "text": "അങ്ങനെ മതിയെന്ന് വിചാരിച്ചിട്ടുണ്ട്"
    },
    {
      "t": "03:48",
      "text": "ഓക്കേ ഓക്കേ"
    },
    {
      "t": "03:50",
      "text": "സെക്ഷ്വൽ റിലേഷൻ"
    },
    {
      "t": "03:52",
      "text": "ശരി"
    },
    {
      "t": "03:54",
      "text": "എക്സിലറേഷൻ"
    },
    {
      "t": "03:56",
      "text": "വേണമെന്ന് ആഗ്രഹിക്കുന്നുണ്ട്"
    },
    {
      "t": "03:58",
      "text": "പക്ഷേ നമുക്കൊരു പറ്റും"
    },
    {
      "t": "04:00",
      "text": "ഒത്തിരി പേഴ്സണൽ കിട്ടുവാണേ ചെയ്യു"
    },
    {
      "t": "04:02",
      "text": "അപ്പം ഇതുവരെ നടന്നിട്ടില്ല"
    },
    {
      "t": "04:04",
      "text": "ആ"
    },
    {
      "t": "04:06",
      "text": "ആ ഓൺ ആയിട്ട് നടന്നിട്ടുണ്ട് ട്യൂട്ടി"
    },
    {
      "t": "04:08",
      "text": "നിറഞ്ഞിട്ടുണ്ട് എക്സിനേറ്റർ"
    },
    {
      "t": "04:10",
      "text": "ഓക്കേ"
    },
    {
      "t": "04:12",
      "text": "ഇപ്പം നമുക്കത് മിസ്സ് ചെയ്യാം"
    },
    {
      "t": "04:14",
      "text": "സി നൊന്ത് അക്കം"
    },
    {
      "t": "04:16",
      "text": "അതെ ഞാൻ പറഞ്ഞു"
    },
    {
      "t": "04:18",
      "text": "മാര്യേജിന് മുന്നേ ഒന്ന് എക്സ്പീരിയൻസ്"
    },
    {
      "t": "04:20",
      "text": "ഡാൻസ് ചെയ്യണമെന്നുണ്ട്"
    },
    {
      "t": "04:22",
      "text": "ഓക്കേ"
    },
    {
      "t": "04:24",
      "text": "പ്രമുഖമായ"
    },
    {
      "t": "04:26",
      "text": "മൈക്കിൽ ചെയ്യാം"
    },
    {
      "t": "04:28",
      "text": "ഇയാളെ ഇവിടെ എത്രയാണ്"
    },
    {
      "t": "04:30",
      "text": "ഏൻട്രോ ഇല്ലേ ഏൻട്രോ ആണല്ലോ"
    },
    {
      "t": "04:32",
      "text": "ഞങ്ങളുടെ"
    },
    {
      "t": "04:34",
      "text": "ആ യെസ് മലപ്പുറം"
    },
    {
      "t": "04:36",
      "text": "അപ്പോൾ മഴക്കാലം"
    },
    {
      "t": "04:38",
      "text": "പുറത്തോട്ട് വരണോ"
    },
    {
      "t": "04:40",
      "text": "ആ ഇല്ല"
    },
    {
      "t": "04:42",
      "text": "മലപ്പുറത്തോട്ട് ബീച്ചിലോട്ട്"
    },
    {
      "t": "04:44",
      "text": "നമ്മുടെ കോഴിക്കോട്"
    },
    {
      "t": "04:46",
      "text": "കോഴിക്കോട്"
    },
    {
      "t": "04:48",
      "text": "നമ്മുടെ ബേസിലൊക്കെ ബേസിലോട്ട്"
    },
    {
      "t": "04:50",
      "text": "ഇവിടെ വന്നാൽ മതി ഞങ്ങൾ അവിടെ ഉണ്ടാവും"
    },
    {
      "t": "04:52",
      "text": "ഞങ്ങൾ ഫ്രണ്ട്സൊക്കെ ആയിട്ട് വരാറുണ്ട്"
    },
    {
      "t": "04:54",
      "text": "ബീച്ചിലോ"
    },
    {
      "t": "04:56",
      "text": "യാ"
    },
    {
      "t": "04:58",
      "text": "അപ്പം എന്തോരം"
    },
    {
      "t": "05:00",
      "text": "അങ്ങ് വരും വീട്ടിലേക്ക്"
    },
    {
      "t": "05:02",
      "text": "പിന്നെ"
    },
    {
      "t": "05:04",
      "text": "ജസ്റ്റ് മീറ്റ് ചെയ്യാനല്ലേ ഫ്രണ്ട്സിൻ്റെ"
    },
    {
      "t": "05:06",
      "text": "എന്തെങ്കിലും ബർത്ത് ആണോ"
    },
    {
      "t": "05:08",
      "text": "സെലിബ്രേഷനാണോ അങ്ങനെയൊക്കെയും പറയാം"
    },
    {
      "t": "05:10",
      "text": "അപ്പോസ്തേ"
    },
    {
      "t": "05:12",
      "text": "സ്റ്റേ വേണോ"
    },
    {
      "t": "05:14",
      "text": "ദേവേന്ദ്രൻ"
    },
    {
      "t": "05:16",
      "text": "അപ്പം ജസ്റ്റ് എത്ര ടൈം"
    },
    {
      "t": "05:18",
      "text": "എങ്ങോട്ട്"
    },
    {
      "t": "05:20",
      "text": "ആ"
    },
    {
      "t": "05:22",
      "text": "രാവിലെ വന്നിട്ട് വൈകീട്ട് വന്നാൽ പോരെ"
    },
    {
      "t": "05:24",
      "text": "അപ്പോൾ അങ്ങനെയാണെങ്കിലും മതി"
    },
    {
      "t": "05:26",
      "text": "ആ"
    },
    {
      "t": "05:28",
      "text": "കുറച്ച് സീനാണ് വീട്ടിൽ"
    },
    {
      "t": "05:30",
      "text": "ഒരെണ്ണം"
    },
    {
      "t": "05:32",
      "text": "അങ്ങനെയാണെങ്കിൽ അങ്ങനെ നോക്കാം"
    },
    {
      "t": "05:34",
      "text": "അവിടെ എവിടെയെങ്കിലും സ്റ്റേ ചെയ്യാം"
    },
    {
      "t": "05:36",
      "text": "നോക്കാം"
    },
    {
      "t": "05:38",
      "text": "പിന്നെ"
    },
    {
      "t": "05:40",
      "text": "വലിയ നൈറ്റ് ഫംഗ്ഷനാണെന്ന്"
    },
    {
      "t": "05:42",
      "text": "ഫ്രണ്ടിന് വീട്ടിലേക്ക് ഇറക്കുമ്പോൾ"
    },
    {
      "t": "05:44",
      "text": "ഭിത്തിയിൽ നിന്ന് വരുമ്പോൾ അങ്ങനെയൊക്കെ പറയണം"
    },
    {
      "t": "05:46",
      "text": "ഓ അത് കുഴപ്പമില്ല അങ്ങനെ"
    },
    {
      "t": "05:48",
      "text": "വേണമെങ്കിൽ രാവിലെ വന്നാൽ വൈകിട്ട് പോകാം"
    },
    {
      "t": "05:50",
      "text": "ആ"
    },
    {
      "t": "05:52",
      "text": "ഓക്കേ"
    },
    {
      "t": "05:54",
      "text": "ഇയാൾ"
    },
    {
      "t": "05:56",
      "text": "അത് ഫസ്റ്റ് ടൈം ആണോ അതോ"
    },
    {
      "t": "05:58",
      "text": "വാക്സിനേറ്റ് ചെയ്തിട്ടാണോ"
    },
    {
      "t": "06:00",
      "text": "മിക്സായിട്ട് ഞാൻ ഇതുവരെ ചെയ്തിട്ടില്ല"
    },
    {
      "t": "06:02",
      "text": "ആ"
    },
    {
      "t": "06:04",
      "text": "ആണോ പിന്നെ ആരായിട്ട് ചിരിച്ചു"
    },
    {
      "t": "06:06",
      "text": "അല്ലാതെ ഒരു ഫ്രണ്ടുമായിട്ട്"
    },
    {
      "t": "06:08",
      "text": "ചെയ്തു"
    },
    {
      "t": "06:10",
      "text": "ആ എക്സ്പീരിയൻസാണ് അയാൾക്ക്"
    },
    {
      "t": "06:12",
      "text": "എനിക്ക് ആ ഒരു"
    },
    {
      "t": "06:14",
      "text": "എക്സ്പീരിയൻസ് മാത്രമേ ഉള്ളൂ"
    },
    {
      "t": "06:16",
      "text": "ഇതാക്കി"
    },
    {
      "t": "06:18",
      "text": "ഫ്രണ്ട് എങ്ങനെയാണ് ബെസ്റ്റ് ചെയ്യുന്നത്"
    },
    {
      "t": "06:20",
      "text": "എസ് ടി ഒന്നും അല്ല"
    },
    {
      "t": "06:22",
      "text": "ഇല്ല ഫ്രണ്ട് പിന്നെ ഒരു"
    },
    {
      "t": "06:24",
      "text": "ടൈമിലങ്ങ് പറ്റിപ്പോയി"
    },
    {
      "t": "06:26",
      "text": "ഓക്കേ ഓക്കേ"
    },
    {
      "t": "06:28",
      "text": "വർക്ക് ചെയ്യാൻ അടുത്തില്ലേടാ"
    },
    {
      "t": "06:30",
      "text": "ബാക്കിയൊന്നുമില്ല എൻ്റെ മുന്നേ എൻ്റെ"
    },
    {
      "t": "06:32",
      "text": "ഒരു പോസ് ചെയ്തപ്പം അറിയാൻ നല്ല ഫീൽ"
    },
    {
      "t": "06:34",
      "text": "ആ"
    },
    {
      "t": "06:36",
      "text": "അങ്ങനെ പരിചയപ്പെട്ട"
    },
    {
      "t": "06:38",
      "text": "ആ"
    },
    {
      "t": "06:40",
      "text": "ഓക്കേ"
    },
    {
      "t": "06:42",
      "text": "എന്നിട്ട് എങ്ങനെയാണ് കറക്റ്റ് എൻജോയ് ചെയ്യുന്നത്"
    },
    {
      "t": "06:44",
      "text": "എൻജോയ് ചെയ്യും"
    },
    {
      "t": "06:46",
      "text": "ചെയ്തു കുഴപ്പമില്ല ഒരു"
    },
    {
      "t": "06:48",
      "text": "നാല് അഞ്ച് മണിക്കൂർ ചെയ്തായിരുന്നു"
    },
    {
      "t": "06:50",
      "text": "ആ"
    },
    {
      "t": "06:52",
      "text": "എത്ര നാളായി"
    },
    {
      "t": "06:54",
      "text": "മനസ്സിലായില്ല"
    },
    {
      "t": "06:56",
      "text": "ഓരോ"
    },
    {
      "t": "06:58",
      "text": "നാല് റൗണ്ട് ചെയ്തോ"
    },
    {
      "t": "07:00",
      "text": "ആ ആ"
    },
    {
      "t": "07:02",
      "text": "ആണോ"
    },
    {
      "t": "07:04",
      "text": "താനെ എൻജോയ് ചെയ്ത പോലെ ഓളെ എൻജോയ് ചെയ്തു"
    },
    {
      "t": "07:06",
      "text": "പിന്നെ"
    },
    {
      "t": "07:08",
      "text": "ചെയ്യുകയാണ്"
    },
    {
      "t": "07:10",
      "text": "ഓക്കെ"
    },
    {
      "t": "07:12",
      "text": "എന്നാലല്ലേ സുഖമുള്ളൂ"
    },
    {
      "t": "07:14",
      "text": "സർക്കാരാണ്"
    },
    {
      "t": "07:16",
      "text": "ചാടക്ക"
    },
    {
      "t": "07:18",
      "text": "ഒരു നരകവും കാണിച്ചു കൊടുത്തു"
    },
    {
      "t": "07:20",
      "text": "ശരി ശരി"
    },
    {
      "t": "07:22",
      "text": "ഓക്കെ ഓക്കെ"
    },
    {
      "t": "07:24",
      "text": "പിന്നെ"
    },
    {
      "t": "07:26",
      "text": "മാര്യേജ് മാര്യേജ് കഴിക്കുന്നില്ല"
    },
    {
      "t": "07:28",
      "text": "ആയിരുന്നു ഇച്ചിരി വൺ"
    },
    {
      "t": "07:30",
      "text": "ടു ഇയറൊക്കെ കഴിഞ്ഞിട്ട് മതി പതുക്കെ"
    },
    {
      "t": "07:32",
      "text": "ആദ്യം"
    },
    {
      "t": "07:34",
      "text": "അതെ അതെ പതുക്കെ ലോകായുക്ത"
    },
    {
      "t": "07:36",
      "text": "അതെ പതുക്കെ"
    },
    {
      "t": "07:38",
      "text": "ഹായ് മതി നിനക്ക് പെട്ടെന്ന് ലോക്ക് ആവണം"
    },
    {
      "t": "07:40",
      "text": "ആയിക്കോട്ടെ"
    },
    {
      "t": "07:42",
      "text": "ഇത് പണി"
    },
    {
      "t": "07:44",
      "text": "ആഹ്"
    },
    {
      "t": "07:46",
      "text": "അപ്പം ഞാൻ എന്നും അലട്ടും"
    },
    {
      "t": "07:48",
      "text": "ആ"
    },
    {
      "t": "07:50",
      "text": "മ്മ് മ്മ്"
    },
    {
      "t": "07:52",
      "text": "എന്നാ അയാൾ ഫ്രീ ആവുന്നത്"
    },
    {
      "t": "07:54",
      "text": "നീ ഫ്രീ ആയിട്ട്"
    },
    {
      "t": "07:56",
      "text": "ഒന്നിടയിൽ നോക്കി പറഞ്ഞാൽ ഒന്ന് ഫ്രീ ആവാം"
    },
    {
      "t": "07:58",
      "text": "ആ"
    },
    {
      "t": "08:00",
      "text": "ഓക്കേ ഓക്കേ എന്നിട്ട്"
    },
    {
      "t": "08:02",
      "text": "വന്നിട്ട് ഇയാളെ ശരിക്കും സഹിപ്പിച്ചു"
    },
    {
      "t": "08:04",
      "text": "ശരി കേട്ടില്ല"
    },
    {
      "t": "08:06",
      "text": "ആ"
    },
    {
      "t": "08:08",
      "text": "ഈ ഈ അല്ല ഇയാൾ വന്നിട്ട്"
    },
    {
      "t": "08:10",
      "text": "കറക്റ്റ് ശരിക്കും സുഖിപ്പിച്ചു തരും"
    },
    {
      "t": "08:12",
      "text": "പിന്നെ സൂപ്പിച്ച് തരാം"
    },
    {
      "t": "08:14",
      "text": "രാവിലെ തൊട്ട് വൈകിട്ട് ഒരു സമയമില്ല"
    },
    {
      "t": "08:16",
      "text": "അല്ലേ"
    },
    {
      "t": "08:18",
      "text": "യാ ഷുവർ"
    },
    {
      "t": "08:20",
      "text": "അപ്പോൾ"
    },
    {
      "t": "08:22",
      "text": "നല്ല രീതിയിൽ സൂക്ഷിച്ച് നന്നായിട്ട് എല്ലാം ഇടും"
    },
    {
      "t": "08:24",
      "text": "ഓ"
    },
    {
      "t": "08:26",
      "text": "അതെ അതെ അതെ ടൈമിംഗ്"
    },
    {
      "t": "08:28",
      "text": "അങ്ങ്"
    },
    {
      "t": "08:30",
      "text": "ആ ടൈമുണ്ടായിരുന്നു"
    },
    {
      "t": "08:32",
      "text": "ടൈം എങ്ങനെയൊക്കെ എടുക്കുക"
    },
    {
      "t": "08:34",
      "text": "കൊണ്ടാണ് നീ എന്തായാലും ക്ഷീണിച്ചേ വീട്ടിൽ പോകുള്ളൂ"
    },
    {
      "t": "08:36",
      "text": "അപ്പോൾ"
    },
    {
      "t": "08:38",
      "text": "ഷോ ടയേർഡ്"
    },
    {
      "t": "08:40",
      "text": "തേങ്ങാ തേങ്ങാ രാവും"
    },
    {
      "t": "08:42",
      "text": "ഓക്കേ"
    },
    {
      "t": "08:44",
      "text": "മ്മ്"
    },
    {
      "t": "08:46",
      "text": "ആ"
    },
    {
      "t": "08:48",
      "text": "തനിക്ക് എന്തൊക്കെയാണ് ഫാന്റസീസ്"
    },
    {
      "t": "08:50",
      "text": "എനിക്ക് ഇഷ്ടമല്ലേ എനിക്കാ"
    },
    {
      "t": "08:52",
      "text": "എനിക്കിഷ്ടമുള്ളതോ എനിക്കിഷ്ടമുള്ളതോ"
    },
    {
      "t": "08:54",
      "text": "ചെയ്യാൻ ഇഷ്ടമുള്ളത് എന്നെ ചെയ്യാൻ ഇഷ്ടമുള്ളത്"
    },
    {
      "t": "08:56",
      "text": "ആ"
    },
    {
      "t": "08:58",
      "text": "തനിക്ക് ചെയ്യാൻ ഇഷ്ടമുള്ളൂ"
    },
    {
      "t": "09:00",
      "text": "എനിക്ക് ചെയ്യാൻ ഇഷ്ടമുള്ളത്"
    },
    {
      "t": "09:02",
      "text": "അത് എനിക്ക് പുഷ് ചെയ്യാൻ പറ്റില്ല"
    },
    {
      "t": "09:04",
      "text": "എനിക്ക് എന്നാണ് ഏറ്റവും ഇഷ്ടം"
    },
    {
      "t": "09:06",
      "text": "എന്നാൽ"
    },
    {
      "t": "09:08",
      "text": "എനിക്ക്"
    },
    {
      "t": "09:10",
      "text": "മ്മ്"
    },
    {
      "t": "09:12",
      "text": "എനിക്ക് പുസ്സി"
    },
    {
      "t": "09:14",
      "text": "ക്ലിക്ക് ചെയ്യാനാണ് ഇഷ്ടം"
    },
    {
      "t": "09:16",
      "text": "ഓഫ് ഓഫ്"
    },
    {
      "t": "09:18",
      "text": "ആ ഓ"
    },
    {
      "t": "09:20",
      "text": "ലിക്കി എന്നതൊക്കെ ഇഷ്ടമാണ്"
    },
    {
      "t": "09:22",
      "text": "എനിക്ക് എന്നത് ഭയങ്കര ഇഷ്ടമാണ്"
    },
    {
      "t": "09:24",
      "text": "മ്മ്"
    },
    {
      "t": "09:26",
      "text": "ആ ആ"
    },
    {
      "t": "09:28",
      "text": "ഞാനൊക്കെ അപ്പം ഞാൻ"
    },
    {
      "t": "09:30",
      "text": "ആ"
    },
    {
      "t": "09:32",
      "text": "ഞാന്"
    },
