    {
      "t": "00:06",
      "text": "थोड़ा बहुत चल रहा है"
    },
    {
      "t": "00:08",
      "text": "हेलो"
    },
    {
      "t": "00:10",
      "text": "मतलब महिला जो पल्लवी है सर उनका"
    },
    {
      "t": "00:12",
      "text": "मटके लगेगा तो यहाँ पे"
    },
    {
      "t": "00:14",
      "text": "हाँ इतना"
    },
    {
      "t": "00:16",
      "text": "तो हो ही जाता है टेन प्लस"
    },
    {
      "t": "00:18",
      "text": "डॉक्टर दर्शक बनी इच्छा"
    },
    {
      "t": "00:20",
      "text": "हाँ हाँ"
    },
    {
      "t": "00:22",
      "text": "क्योंकि दो सौ तीन सौ रुपये भी"
    },
    {
      "t": "00:24",
      "text": "बन जाते दिन के और कोई एक आध आध"
    },
    {
      "t": "00:26",
      "text": "डाल डूल भी देते बरसात में भी"
    },
    {
      "t": "00:28",
      "text": "तीन"
    },
    {
      "t": "00:30",
      "text": "बात करने के"
    },
    {
      "t": "00:32",
      "text": "हलो"
    },
    {
      "t": "00:34",
      "text": "अच्छा जो मास्टरों मास्टरों के साथ भी चलेगा"
    },
    {
      "t": "00:36",
      "text": "हाँ जी बच्चा"
    },
    {
      "t": "00:38",
      "text": "उसपे भी कर लेती हूँ ना तभी तो"
    },
    {
      "t": "00:40",
      "text": "हो जाते थोड़ी अर्निंग"
    },
    {
      "t": "00:42",
      "text": "और हल्का फुल्का"
    },
    {
      "t": "00:44",
      "text": "ओ"
    },
    {
      "t": "00:46",
      "text": "इसमें करेंगे तो इसमें तो रात भर"
    },
    {
      "t": "00:48",
      "text": "में सौ दो सौ रुपये ही कमा पाते हैं ना"
    },
    {
      "t": "00:50",
      "text": "और बाकी"
    },
    {
      "t": "00:52",
      "text": "बात कर करके थक जाते हैं आपने"
    },
    {
      "t": "00:54",
      "text": "तो माना एक से बात करनी है मैंने"
    },
    {
      "t": "00:56",
      "text": "तब"
    }
  ],
  "full_text": "और बस हाँ ज़्यादा क्या और कम क्या थोड़ा बहुत चल रहा है हेलो मतलब महिला जो पल्लवी है सर उनका मटके लगेगा तो यहाँ पे हाँ इतना तो हो ही जाता है टेन प्लस डॉक्टर दर्शक बनी इच्छा हाँ हाँ क्योंकि दो सौ तीन सौ रुपये भी बन जाते दिन के और कोई एक आध आध डाल डूल भी देते बरसात में भी तीन बात करने के हलो अच्छा जो मास्टरों मास्टरों के साथ भी चलेगा हाँ जी बच्चा उसपे भी कर लेती हूँ ना तभी तो हो जाते थोड़ी अर्निंग और हल्का फुल्का ओ इसमें करेंगे तो इसमें तो रात भर में सौ दो सौ रुपये ही कमा पाते हैं ना और बाकी बात कर करके थक जाते हैं आपने तो माना एक से बात करनी है मैंने तब",
