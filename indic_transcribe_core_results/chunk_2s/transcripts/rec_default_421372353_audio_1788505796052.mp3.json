    {
      "t": "10:22",
      "text": "கலக்க மாட்டாங்க மேம்"
    },
    {
      "t": "10:24",
      "text": "ரொம்ப ரிஸ்க் பண்ணுவேன்"
    },
    {
      "t": "10:26",
      "text": "வயசெல்லாம் அப்படியே கிட்டும்"
