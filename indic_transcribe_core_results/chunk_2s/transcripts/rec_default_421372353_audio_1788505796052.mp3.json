  "segments": [
    {
      "t": "00:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "ம்"
    },
    {
      "t": "00:04",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:06",
      "text": "இது ஓம் சாந்தி"
    },
    {
      "t": "00:08",
      "text": "போதும் சார்"
    },
    {
      "t": "00:10",
      "text": "ஹலோ"
    },
    {
      "t": "00:12",
      "text": "கேட்குதுங்க"
    },
    {
      "t": "00:14",
      "text": "உங்கள் பேர்"
    },
    {
      "t": "00:16",
      "text": "வீடியோ ஆன் பண்ணிட்டு பேசுங்க"
    },
    {
      "t": "00:18",
      "text": "ஆன்லைனில் தாங்க இருக்கு"
    },
    {
      "t": "00:20",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:22",
      "text": "ம்"
    },
    {
      "t": "00:24",
      "text": "ம் ஹாய்"
    },
    {
      "t": "00:26",
      "text": "ஹாய்"
    },
    {
      "t": "00:28",
      "text": "சரிங்க"
    },
    {
      "t": "00:30",
      "text": "என்னங்க இந்த டிவியிலலாம் இன்டர்வியூ எடுப்பாங்க"
    },
    {
      "t": "00:32",
      "text": "அந்த மாதிரி உட்காந்துருக்கீங்க"
    },
    {
      "t": "00:34",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:36",
      "text": "நான் சொல்லுவேன் பார்த்தீங்கன்னா ஹாய் நீங்கள் பார்த்துக்கொண்டு இருப்பது"
    },
    {
      "t": "00:38",
      "text": "சன் டிவி கேள்வி நம்ம கூட யார் இருக்கார் பாருங்க"
    },
    {
      "t": "00:40",
      "text": "நம்ம நேர் இருக்காது சொல்லுங்க"
    },
    {
      "t": "00:42",
      "text": "பண்ணிக்கணும்"
    },
    {
      "t": "00:44",
      "text": "பியூஷ்"
    },
    {
      "t": "00:46",
      "text": "அப்படின்னா இல்லை ஜெய் நீங்கள் வீடு கட்ட"
    },
    {
      "t": "00:48",
      "text": "ஐயோ பைத்தியக்காரனா இருக்கும் போல இருக்கு"
    },
    {
      "t": "00:50",
      "text": "நானே என்ன"
    },
    {
      "t": "00:52",
      "text": "இல்லை இல்லை டாக்டர்"
    },
    {
      "t": "00:54",
      "text": "நானே எல்லாருமே கலாச்சாரத்தில் நிகழ்ந்தேன்"
    },
    {
      "t": "00:56",
      "text": "நீங்களே கலாய்க்கிறீங்க"
    },
    {
      "t": "00:58",
      "text": "அப்படி நம்ம தொக்ஷி உமா மாதிரி"
    },
    {
      "t": "01:00",
      "text": "சொல்லுங்கள் உங்களுக்கு என்ன பார்த்து வேணும்"
    },
    {
      "t": "01:02",
      "text": "ம்"
    },
    {
      "t": "01:04",
      "text": "இல்லை இல்லை இதுக்கு எல்லாம்"
    },
    {
      "t": "01:06",
      "text": "அப்படிலாம் சொல்லுவாங்க இல்லை"
    },
    {
      "t": "01:08",
      "text": "எப்பயும் உமா மேடம் பேசிக்கிட்டேன்"
    },
    {
      "t": "01:10",
      "text": "வாய்ஸ் அப்படி தான் இருக்கு"
    },
    {
      "t": "01:12",
      "text": "அந்த பர்சனலா"
    },
    {
      "t": "01:14",
      "text": "சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி சரி"
    },
    {
      "t": "01:16",
      "text": "அப்படியா எனக்கு கழுதை"
    },
    {
      "t": "01:18",
      "text": "நட்சத்திர வாயு ஸ்பந்தனம் கேட்டுட்டு இருக்கு"
    },
    {
      "t": "01:20",
      "text": "கத்தி தான் கேட்குதா இல்லை இல்லை"
    },
    {
      "t": "01:22",
      "text": "சொல்லுங்க சார்"
    },
    {
      "t": "01:24",
      "text": "சரிங்க ஐயா"
    },
    {
      "t": "01:26",
      "text": "எப்படி கண்டுபிடிச்சீங்க"
    },
    {
      "t": "01:28",
      "text": "கத்துனாடி"
    },
    {
      "t": "01:30",
      "text": "போட்டிருக்கான்னு பார்த்தீங்கன்னா சென்னைக்கு எப்படி கண்டுபிடிச்சீங்க"
    },
    {
      "t": "01:32",
      "text": "அது"
    },
    {
      "t": "01:34",
      "text": "ஆ"
    },
    {
      "t": "01:36",
      "text": "கண்டுபிடிப்போம் நல்லா இருக்குதா"
    },
    {
      "t": "01:38",
      "text": "இனிமேல் இந்த ஒரு சென்னை"
    },
    {
      "t": "01:40",
      "text": "யார் நீங்களும்"
    },
    {
      "t": "01:42",
      "text": "ம்"
    },
    {
      "t": "01:44",
      "text": "ஆ வேறு உபாயம் இருக்குது"
    },
    {
      "t": "01:46",
      "text": "ஓகே ஓகே அது ஏன்"
    },
    {
      "t": "01:48",
      "text": "ஓகே ஓகே அது ஏன் கேள்வி"
    },
    {
      "t": "01:50",
      "text": "நீட்டிச்சிருந்தேன் எங்களுக்கு பெங்களூர்லேருந்து"
    },
    {
      "t": "01:52",
      "text": "பேசுகிறேன் அப்படி இந்த டிவியில் நியூஸ்"
    },
    {
      "t": "01:54",
      "text": "படிப்பாங்க பார்த்தீங்களா அந்த மாதிரி இருக்குது நீங்கள் சிலது"
    },
    {
      "t": "01:56",
      "text": "சரிங்க"
    },
    {
      "t": "01:58",
      "text": "ஆமாம் ஆமாம்"
    },
    {
      "t": "02:00",
      "text": "அவையும் அப்படிதான் பேசுறதுனால"
    },
    {
      "t": "02:02",
      "text": "என்ன பண்ணுவோம்"
    },
    {
      "t": "02:04",
      "text": "ஆனால் எனக்கு தான்"
    },
    {
      "t": "02:06",
      "text": "தெரியுதா"
    },
    {
      "t": "02:08",
      "text": "எஸ் இட்ஸ் டு மச் மோர் தியரி"
    },
    {
      "t": "02:10",
      "text": "என்ன"
    },
    {
      "t": "02:12",
      "text": "ஆ அதை தான் முடிவு"
    },
    {
      "t": "02:14",
      "text": "சரி சரி"
    },
    {
      "t": "02:16",
      "text": "இன்வினியன்ட்"
    },
    {
      "t": "02:18",
      "text": "பார்க்க பார்க்க பழகிடுவோம் பார்க்க பார்க்க பழகிடுவோம்"
    },
    {
      "t": "02:20",
      "text": "செகண்ட் டைப்"
    },
    {
      "t": "02:22",
      "text": "ம்"
    },
    {
      "t": "02:24",
      "text": "ஆமாம்"
    },
    {
      "t": "02:26",
      "text": "உங்க பேரை சொல்லுங்க"
    },
    {
      "t": "02:28",
      "text": "நேம் என்ன ஏன் பேரா"
    },
    {
      "t": "02:30",
      "text": "இதோட மூணு"
    },
    {
      "t": "02:32",
      "text": "ஆ"
    },
    {
      "t": "02:34",
      "text": "சென்ட் ஃபார்"
    },
    {
      "t": "02:36",
      "text": "ஜெனிஃபர் அதான் ஷார்ட் டேர்ம் ஜெனி"
    },
    {
      "t": "02:38",
      "text": "ஏய் குஷி படத்தில் ஒரு ஜென்னி"
    },
    {
      "t": "02:40",
      "text": "ஹைஜீனிக்"
    },
    {
      "t": "02:42",
      "text": "அந்த மாதிரி"
    },
    {
      "t": "02:44",
      "text": "ஹேய் ஜெனி"
    },
    {
      "t": "02:46",
      "text": "சரி ஓகே"
    },
    {
      "t": "02:48",
      "text": "காய்ச்சிது"
    },
    {
      "t": "02:50",
      "text": "ஐயோ முருகா"
    },
    {
      "t": "02:52",
      "text": "ஐயா"
    },
    {
      "t": "02:54",
      "text": "ம்"
    },
    {
      "t": "02:56",
      "text": "கர்த்தரே இந்த பாவிகை கிட்ட இருந்து"
    },
    {
      "t": "02:58",
      "text": "விக்னேஷ்"
    },
    {
      "t": "03:00",
      "text": "ம்"
    },
    {
      "t": "03:02",
      "text": "பட் பட் எதுவும் வேணாம்"
    },
    {
      "t": "03:04",
      "text": "சைனில் தான் இருக்காங்க"
    },
    {
      "t": "03:06",
      "text": "ம்"
    },
    {
      "t": "03:08",
      "text": "ம்"
    },
    {
      "t": "03:10",
      "text": "ஓவராகவே இருக்குதுங்களா"
    },
    {
      "t": "03:12",
      "text": "ஆமா நயன்தாரா ரெண்டு"
    },
    {
      "t": "03:14",
      "text": "நயன்தாரான்னு சொல்றீங்க பின்ன ரியாக்ஷன்"
    },
    {
      "t": "03:16",
      "text": "கொடுக்காம இருக்க முடியுமா"
    },
    {
      "t": "03:18",
      "text": "ம்"
    },
    {
      "t": "03:20",
      "text": "விட்டேஜ் பேசுனேன்னு பயந்தேறணும்"
    },
    {
      "t": "03:22",
      "text": "ஓ மை காட்"
    },
    {
      "t": "03:24",
      "text": "ம்"
    },
    {
      "t": "03:26",
      "text": "ம் சொல்லுங்கள் ஜெனி"
    },
    {
      "t": "03:28",
      "text": "என்ன பண்றீங்க"
    },
    {
      "t": "03:30",
      "text": "சரிங்க"
    },
    {
      "t": "03:32",
      "text": "நான் டியூஷன்"
    },
    {
      "t": "03:34",
      "text": "ஒர்க் பண்ணிட்டு இருக்கேன் இன்னைக்கு லேசா"
    },
    {
      "t": "03:36",
      "text": "அதை அப்படியே கல்லை போட்டுக்கிறதுக்காகவும் வந்து"
    },
    {
      "t": "03:38",
      "text": "ஓகே ஓகே நான்"
    },
    {
      "t": "03:40",
      "text": "ஆக்சுவலாக டிசைனராக ஒர்க் பண்ணுறேன் ஸ்ட்ரக்ச்சுரல் டிசைன்"
    },
    {
      "t": "03:42",
      "text": "நைபர்"
    },
    {
      "t": "03:44",
      "text": "கட்டில் தான் இருக்குது எனக்கு இன்னும் மெயில் வரணும் மெயில் வந்து"
    },
    {
      "t": "03:46",
      "text": "ஒர்க் ஸ்டார்ட் ஆகும் அதுக்கு"
    },
    {
      "t": "03:48",
      "text": "தான் வெயிட்டிங்ல இருக்கேன்"
    },
    {
      "t": "03:50",
      "text": "ம்"
    },
    {
      "t": "03:52",
      "text": "வெயிட் பண்ணுங்க உடனே வந்து"
    },
    {
      "t": "03:54",
      "text": "சென்றேங்க"
    },
    {
      "t": "03:56",
      "text": "ம்"
    },
    {
      "t": "03:58",
      "text": "நீங்கள் என்ன டியூட்டர் ஆக்சுவலாக"
    },
    {
      "t": "04:00",
      "text": "ம்"
    },
    {
      "t": "04:02",
      "text": "ம்"
    },
    {
      "t": "04:04",
      "text": "வாட் இஸ் த நிம்மி காப் இன் ஹிஸ்"
    },
    {
      "t": "04:06",
      "text": "பயாலஜி"
    },
    {
      "t": "04:08",
      "text": "டென்"
    },
    {
      "t": "04:10",
      "text": "டுவெல்த் இல்லை"
    },
    {
      "t": "04:12",
      "text": "ம்"
    },
    {
      "t": "04:14",
      "text": "நைசாக சொல்லுங்கள்"
    },
    {
      "t": "04:16",
      "text": "இன்டர்சோல் டர்ன் ஆஃப் திஸ் ஒன்"
    },
    {
      "t": "04:18",
      "text": "இங்கிலீஷ்"
    },
    {
      "t": "04:20",
      "text": "சரிங்க சார்"
    },
    {
      "t": "04:22",
      "text": "பாய் சார்"
    },
    {
      "t": "04:24",
      "text": "நான் அடுத்த ஆப்ஷன் மேக்ஸ் தான் வச்சுருந்தேன்"
    },
    {
      "t": "04:26",
      "text": "சரி ஃபர்ஸ்ட் இங்கிலீஷ் சொல்லி பார்ப்போம் அப்படின்னு"
    },
    {
      "t": "04:28",
      "text": "ஆ ஓ"
    },
    {
      "t": "04:30",
      "text": "முடிஞ்ச பத்திரம் தான்"
    },
    {
      "t": "04:32",
      "text": "எனக்கு சம்மதி இல்லாத மாதிரி தான் இருக்கும்"
    },
    {
      "t": "04:34",
      "text": "அதான் உண்மைதான்"
    },
    {
      "t": "04:36",
      "text": "ஆக்சுவலி மாமி எடுத்து வராது"
    },
    {
      "t": "04:38",
      "text": "கொளுத்தலை எனக்கு இன்ட்ரெஸ்ட் இல்லை"
    },
    {
      "t": "04:40",
      "text": "நான் வந்து"
    },
    {
      "t": "04:42",
      "text": "சிம்பிள் கம்யூனிகேஷன் மாதிரி போகணும்"
    },
    {
      "t": "04:44",
      "text": "பார்க்கப்பட்டு பார்க்கறதுக்கு பலரும் சந்தோஷப்பட்டு"
    },
    {
      "t": "04:46",
      "text": "சுப்பிரமணியம் வீரவர்மன் தான் எங்கள் மாமா"
    },
    {
      "t": "04:48",
      "text": "நான் நினைக்கிறது தான்"
    },
    {
      "t": "04:50",
      "text": "நடக்காது அவங்க நினைக்கிறது மட்டும் தான் நடக்கும்"
    },
    {
      "t": "04:52",
      "text": "ஆ ஓகே தான்"
    },
    {
      "t": "04:54",
      "text": "அப்படியே ஆப்போசிட் ஜெமினியா மாதிரி ஒரு கேரக்டர்"
    },
    {
      "t": "04:56",
      "text": "நொட நொடன்னு பேசிக்கிட்டே இருப்பார்"
    },
    {
      "t": "04:58",
      "text": "சிறு சிறிய வாரி கழிச்சு"
    },
    {
      "t": "05:00",
      "text": "ஆக்சுவலாக உங்கள் வாய்ஸ் மட்டும் தனியாக கேட்கும்போது"
    },
    {
      "t": "05:02",
      "text": "ஒரு என்ன சொல்றது"
    },
    {
      "t": "05:04",
      "text": "ஒரு மெச்சூர்டு வாய்ஸ் மாதிரி இருக்கு கண்ணீர்னு"
    },
    {
      "t": "05:06",
      "text": "நீங்கள் ஆர்ஜேவே போகலாம்"
    },
    {
      "t": "05:08",
      "text": "ம்"
    },
    {
      "t": "05:10",
      "text": "ம்"
    },
    {
      "t": "05:12",
      "text": "நிறைய காம்பினேஷன் இருக்கும்ல"
    },
    {
      "t": "05:14",
      "text": "அதுக்கு பின்னாடி நாம"
    },
    {
      "t": "05:16",
      "text": "இது பண்ண முடியுமான்னு தெரியாதுல்ல"
    },
    {
      "t": "05:18",
      "text": "நம்ம அதிலேலாம் வந்து இது பண்ண முடியாது"
    },
    {
      "t": "05:20",
      "text": "அப்படிலாம் இல்லைங்க ஆக்சுவலாக உங்கள் வாய்ஸ்க்கு"
    },
    {
      "t": "05:22",
      "text": "நீங்கள் வந்து யாருக்காச்சும் இந்த மோட்டிவேட்டரா சப்போர்ட்டரா"
    },
    {
      "t": "05:24",
      "text": "போகலாம் அதில் உங்கள் வாய்ஸ் கேட்டால்"
    },
    {
      "t": "05:26",
      "text": "ஆஹா எங்களுக்கு பேசுற வாய்ஸ்"
    },
    {
      "t": "05:28",
      "text": "நிறைய நிறைய நாய்ஸ் எல்லாமே சூப்பரா இருக்கு"
    },
    {
      "t": "05:30",
      "text": "அதனால இவங்க என்ன சொன்னாலும் நான் கேட்டுருவேன்"
    },
    {
      "t": "05:32",
      "text": "பரம மண்டலத்தில் இருக்கும் பரம"
    },
    {
      "t": "05:34",
      "text": "இதாவே நான் இந்த மாதிரி அவனுக்கு தெரியும் தெரியாது"
    },
    {
      "t": "05:36",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "05:38",
      "text": "ஆடுவாங்க கலாய்க்காதீங்க"
    },
    {
      "t": "05:40",
      "text": "சீக்கிரம் லேயர்"
    },
    {
      "t": "05:42",
      "text": "ஏதாச்சும்"
    },
    {
      "t": "05:44",
      "text": "கொஞ்சம் மட்டும் நம்புற மாதிரி சொல்லுங்க"
    },
    {
      "t": "05:46",
      "text": "சரிங்களா சரிங்களா ஒன்று அங்கே"
    },
    {
      "t": "05:48",
      "text": "உங்கள் வாய்ஸ் ஆக்சுவலாக நல்லா இருக்குது"
    },
    {
      "t": "05:50",
      "text": "ம் கேக்கு கேக்கு கேட்டு கேட்டு"
    },
    {
      "t": "05:52",
      "text": "இருக்கணும் போல இருக்கு"
    },
    {
      "t": "05:54",
      "text": "உங்க வாய்ஸ் சார்ந்து"
    },
    {
      "t": "05:56",
      "text": "ஏதாச்சும் பார்க்க பார்க்க பார்க்க உங்க வாய்ஸ்"
    },
    {
      "t": "05:58",
      "text": "ஏதாவது ஒரு பாட்டு பாடுங்கள்"
    },
    {
      "t": "06:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "06:02",
      "text": "ஏன்"
    },
    {
      "t": "06:04",
      "text": "சும்மா பாடுங்க"
    },
    {
      "t": "06:06",
      "text": "உங்க வாய்ஸுக்கு என்ன"
    },
    {
      "t": "06:08",
      "text": "எந்த பட்டு சூட் ஆகும்"
    },
    {
      "t": "06:10",
      "text": "ம் ம் ம் ம்"
    },
    {
      "t": "06:12",
      "text": "ம் ம் ம்"
    },
    {
      "t": "06:14",
      "text": "இஸ் இட்"
    },
    {
      "t": "06:16",
      "text": "பாடுங்க இதை ரொம்ப பிடிச்ச பாட்டே பாடுங்க சும்மா"
    },
    {
      "t": "06:18",
      "text": "சரி"
    },
    {
      "t": "06:20",
      "text": "ம் எதுக்கு சூர்யா சொல்றது"
    },
    {
      "t": "06:22",
      "text": "அது பாலா"
    },
    {
      "t": "06:24",
      "text": "நல்லா இருக்கு அதுக்கு நான் கேட்குறேங்க நான் ஃபேன்"
    },
    {
      "t": "06:26",
      "text": "அது பாரு"
    },
    {
      "t": "06:28",
      "text": "ஃபைன் ஃபைன் நான் கேட்குறேன்"
    },
    {
      "t": "06:30",
      "text": "புரியப்படுது புரியப்படுது"
    },
    {
      "t": "06:32",
      "text": "ம்"
    },
    {
      "t": "06:34",
      "text": "ஓகே ஓகே ம்"
    },
    {
      "t": "06:36",
      "text": "இல்லை ஆக்சுவலி"
    },
    {
      "t": "06:38",
      "text": "பேக்ரவுண்ட்ல பில்டிங் ஒர்க் பண்ணிட்டு இருக்கேன்"
    },
    {
      "t": "06:40",
      "text": "அனலும் மெதுவாக பேசிட்டு இருக்கேன்"
    },
    {
      "t": "06:42",
      "text": "ஸ்டே ஹோம்"
    },
    {
      "t": "06:44",
      "text": "அதான் கொஞ்சம் சைட்"
    },
    {
      "t": "06:46",
      "text": "லைட்டாக இருக்கா"
    },
    {
      "t": "06:48",
      "text": "ஆ எங்கே இந்த பாட்டு கூட"
    },
    {
      "t": "06:50",
      "text": "பாருங்க சூப்பராக இருக்கும்"
    },
    {
      "t": "06:52",
      "text": "ம்"
    },
    {
      "t": "06:54",
      "text": "சூர்யா பாஜா"
    },
    {
      "t": "06:56",
      "text": "ஓகே போடுங்கள்"
    },
    {
      "t": "06:58",
      "text": "சரிங்க சார்"
    },
    {
      "t": "07:00",
      "text": "ம்"
    },
    {
      "t": "07:02",
      "text": "ஆ பட்"
    },
    {
      "t": "07:04",
      "text": "மாறி இருக்கு பக்கத்தில் தான் நிறைய"
    },
    {
      "t": "07:06",
      "text": "உற்பத்தி பிரச்சாரம் இல்லை"
    },
    {
      "t": "07:08",
      "text": "அக்கா போறீங்க எனக்கு கேட்குற மாதிரி பாருங்க"
    },
    {
      "t": "07:10",
      "text": "பெப்சியும்மா"
    },
    {
      "t": "07:12",
      "text": "பாடங்கள் கட்சி"
    },
    {
      "t": "07:14",
      "text": "என்ன பாப்பா"
    },
    {
      "t": "07:16",
      "text": "ஜல்லி நெய் தூக்குதுங்க"
    },
    {
      "t": "07:18",
      "text": "இல்லையா"
    },
    {
      "t": "07:20",
      "text": "தேனி தேனி"
    },
    {
      "t": "07:22",
      "text": "பாடுங்க ஜெனி"
    },
    {
      "t": "07:24",
      "text": "பட் அதுதான் பெஸ்ட்"
    },
    {
      "t": "07:26",
      "text": "விடமாட்டீங்க"
    },
    {
      "t": "07:28",
      "text": "ம்"
    },
    {
      "t": "07:30",
      "text": "சரிம்மா டேய் நீ ரொம்ப நாள் ஆச்சு"
    },
    {
      "t": "07:32",
      "text": "தனியா கழுதை கட்டுற மாதிரி"
    },
    {
      "t": "07:34",
      "text": "பேசி கத்துட்டு இருப்பாரு என்ன"
    },
    {
      "t": "07:36",
      "text": "பாட்டு சொல்லுங்க ரெண்டு பேரும் சேர்ந்து பாடலாம்"
    },
    {
      "t": "07:38",
      "text": "சரி"
    },
    {
      "t": "07:40",
      "text": "ரெண்டு பேரும் சேர்ந்துதான்"
    },
    {
      "t": "07:42",
      "text": "உண்டா அதுதான் பல்லம்மா"
    },
    {
      "t": "07:44",
      "text": "சரிங்க சார்"
    },
    {
      "t": "07:46",
      "text": "ம்"
    },
    {
      "t": "07:48",
      "text": "சரிங்க சார்"
    },
    {
      "t": "07:50",
      "text": "கருநெல்லா இது பண்ணிட்டு பாருங்க"
    },
    {
      "t": "07:52",
      "text": "ம்"
    },
    {
      "t": "07:54",
      "text": "ஆ"
    },
    {
      "t": "07:56",
      "text": "ஓகே"
    },
    {
      "t": "07:58",
      "text": "இந்தா சைடில்"
    },
    {
      "t": "08:00",
      "text": "எல்லாம் சொந்த"
    },
    {
      "t": "08:02",
      "text": "இல்லை"
    },
    {
      "t": "08:04",
      "text": "நான் போகணும்"
    },
    {
      "t": "08:06",
      "text": "ஆ"
    },
    {
      "t": "08:08",
      "text": "இறை தூதரகம்"
    },
    {
      "t": "08:10",
      "text": "வேறு எதுவும்"
    },
    {
      "t": "08:12",
      "text": "ம்"
    },
    {
      "t": "08:14",
      "text": "ஓம்"
    },
    {
      "t": "08:16",
      "text": "ம்"
    },
    {
      "t": "08:18",
      "text": "ஆ"
    },
    {
      "t": "08:20",
      "text": "ஆ"
    },
    {
      "t": "08:22",
      "text": "அச்சச்சோ டிஸ்டர்ப் பண்ணுங்க"
    },
    {
      "t": "08:24",
      "text": "ஓகே மேம்"
    },
    {
      "t": "08:26",
      "text": "கட்டன் ஜோசப்"
    },
    {
      "t": "08:28",
      "text": "முடியாது ரொம்ப"
    },
    {
      "t": "08:30",
      "text": "நான் வேற விஜய் பயனாச்சா"
    },
    {
      "t": "08:32",
      "text": "ரிஜிஃப் அண்ணா நீங்கள் என்ன பார்க்கும்போது நிறைய பேர்"
    },
    {
      "t": "08:34",
      "text": "விஜய் மரியாக்கன் சொல்லியிருக்காங்க தெரியுமா"
    },
    {
      "t": "08:36",
      "text": "சரிங்க"
    },
    {
      "t": "08:38",
      "text": "ஆஹா"
    },
    {
      "t": "08:40",
      "text": "பெரிய பெண்ணே சொல்லிட்டானே"
    },
    {
      "t": "08:42",
      "text": "வேணாம்"
    },
    {
      "t": "08:44",
      "text": "எப்படி இருக்கு"
    },
    {
      "t": "08:46",
      "text": "ஆமாம்"
    },
    {
      "t": "08:48",
      "text": "ஓகே எனக்கு"
    },
    {
      "t": "08:50",
      "text": "எனக்கே கொஞ்சம் பதினோராயிரம் எனக்கும் பதினோராயிரம்"
    },
    {
      "t": "08:52",
      "text": "பதட்டமாக தான் இருக்கு வரட்டும் என்ன சொல்றேன்னு கேட்பேன்"
    },
    {
      "t": "08:54",
      "text": "ஓ அந்த மாதிரி தான்"
    },
    {
      "t": "08:56",
      "text": "ம்"
    },
    {
      "t": "08:58",
      "text": "நல்லாதான் இருக்கு இங்கே பார்க்கறதுக்கு"
    },
    {
      "t": "09:00",
      "text": "கேட்க ஆனால் விஜய்"
    },
    {
      "t": "09:02",
      "text": "விஜய்னா விஜய் ஒருத்தர் மட்டும்தான் இருக்கு"
    },
    {
      "t": "09:04",
      "text": "முடியும் மேலும் ஜெய் கூட கம்பேர் பண்ணி"
    },
    {
      "t": "09:06",
      "text": "ஓ ஜெய் மாதிரி இருக்குண்ணா போ"
    },
    {
      "t": "09:08",
      "text": "ம்"
    },
    {
      "t": "09:10",
      "text": "ஜெய் வந்து விஜய்"
    },
    {
      "t": "09:12",
      "text": "கம்பேர் பண்ணா அப்படின்னு"
    },
    {
      "t": "09:14",
      "text": "நீங்க நீங்களாதான் இருக்கீங்க ஓகே ஓகே"
    },
    {
      "t": "09:16",
      "text": "ஓகே தேங்க் யூ தேங்க் யூ தேங்க் யூ"
    },
    {
      "t": "09:18",
      "text": "தேங்க்யூ நீங்கள் பாட்டு கண் சரி நீங்கள் எதுவும் சொல்லுங்கள்"
    },
    {
      "t": "09:20",
      "text": "ம்"
    },
    {
      "t": "09:22",
      "text": "நீங்கள் அந்த பாட்டை"
    },
    {
      "t": "09:24",
      "text": "கண்டினியூ பண்ணுங்க"
    },
    {
      "t": "09:26",
      "text": "சரிங்க"
    },
    {
      "t": "09:28",
      "text": "இல்லை இல்லை நான் இன்னொரு விஷயம்"
    },
    {
      "t": "09:30",
      "text": "சொல்லுவாங்க அதுக்கு நீங்கள் சொல்றது"
    },
    {
      "t": "09:32",
      "text": "இன்னும் நல்ல விஷயம் சொல்லு மோஸ்ட் ஆஃப் தி"
    },
    {
      "t": "09:34",
      "text": "இதில் அட்டென்ட் பண்ணாத என்ன செய்யணும்னு சொல்லுவாங்க"
    },
    {
      "t": "09:36",
      "text": "அந்த வருடம்"
    },
    {
      "t": "09:38",
      "text": "நம்ம பெரியவராக ஆகிட்டா பரவாயில்லை"
    },
    {
      "t": "09:40",
      "text": "கண்ணில்லாமல் காட்டுறேன்"
    },
    {
      "t": "09:42",
      "text": "பார்த்துருக்கீங்களா அவங்க"
    },
    {
      "t": "09:44",
      "text": "பேஸ்கெட் மாதிரி இருக்கு லைட்டாக"
