    {
      "t": "09:46",
      "text": "வாங்க"
    },
    {
      "t": "09:48",
      "text": "ஆ ஓகே ஓகே"
    },
    {
      "t": "09:50",
      "text": "இப்போ உடுத்து வாங்க"
    },
    {
      "t": "09:52",
      "text": "இது வந்துட்டு"
    },
    {
      "t": "09:54",
      "text": "உன் மனசுக்கு நல்ல உருட்டாக உருட்டு உருட்டு"
    },
    {
      "t": "09:56",
      "text": "ஓகே"
    },
    {
      "t": "09:58",
      "text": "ஹலோ"
    },
    {
      "t": "10:00",
      "text": "இந்த சாயில் சொல்லுங்க"
