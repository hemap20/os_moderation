{
  "file_id": "rec_default_423662590_audio_1788716156245.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 676.785,
  "processing_time_sec": 1924.2522149085999,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "ഹായ്"
    },
    {
      "t": "00:04",
      "text": "ഹലോ"
    },
    {
      "t": "00:06",
      "text": "സ്ഥലം എവിടെയായിരുന്നു"
    },
    {
      "t": "00:08",
      "text": "പോകേണ്ട"
    },
    {
      "t": "00:10",
      "text": "ഇവിടെയോ"
    },
    {
      "t": "00:12",
      "text": "ഞാൻ എറണാകുളം"
    },
    {
      "t": "00:14",
      "text": "എന്തായിരുന്നു"
    },
    {
      "t": "00:16",
      "text": "ഓക്കേ എന്നാൽ"
    },
    {
      "t": "00:18",
      "text": "എന്താണ്"
    },
    {
      "t": "00:20",
      "text": "അക്കൗണ്ടിൽ ഡോർ റ്റില്ല"
    },
    {
      "t": "00:22",
      "text": "പിന്നെ"
    },
    {
      "t": "00:24",
      "text": "എന്താ പരിപാടി"
    },
    {
      "t": "00:26",
      "text": "ആ"
    },
    {
      "t": "00:28",
      "text": "പ്രത്യേകിച്ച് പരിപാടിയൊന്നുമില്ല"
    },
    {
      "t": "00:30",
      "text": "പിന്നെ"
    },
    {
      "t": "00:32",
      "text": "മേല് കാണാം"
    },
    {
      "t": "00:34",
      "text": "മാരീഡ് അല്ല"
    },
    {
      "t": "00:36",
      "text": "അന്തർ മേഖല"
    },
    {
      "t": "00:38",
      "text": "വാഴയുടെ എല്ലാം"
    },
    {
      "t": "00:40",
      "text": "പൈസ ഇല്ല"
    },
    {
      "t": "00:42",
      "text": "പൈസ"
    },
    {
      "t": "00:44",
      "text": "ഇരുപത്തിനാല്"
    },
    {
      "t": "00:46",
      "text": "ശരി ശരി"
    },
    {
      "t": "00:48",
      "text": "ഇരുപത്തിനാല്"
    },
    {
      "t": "00:50",
      "text": "വയസ്സിലെന്ത് ആരാ കഴിച്ചത്"
    },
    {
      "t": "00:52",
      "text": "കഴിക്കാം"
    },
    {
      "t": "00:54",
      "text": "ആ"
    },
    {
      "t": "00:56",
      "text": "ആ"
    },
    {
      "t": "00:58",
      "text": "കഴിക്കണമെങ്കിൽ കഴിക്കാം"
    },
    {
      "t": "01:00",
      "text": "കിണർ മേദാനം ഇറങ്ങുന്നതൊന്നുമില്ലല്ലോ"
    },
    {
      "t": "01:02",
      "text": "അതുകൊണ്ട് കഴിച്ചില്ല കഴിക്കണം"
    },
    {
      "t": "01:04",
      "text": "ഇരുപത്തിനാല് വയസ്സും കാര്യങ്ങളൊക്കെ"
    },
    {
      "t": "01:06",
      "text": "വന്നുകൊണ്ട് ഏ"
    },
    {
      "t": "01:08",
      "text": "കാര്യങ്ങളൊക്കെ നടന്നു പോകേണ്ടി വരുന്നു"
    },
    {
      "t": "01:10",
      "text": "എന്ത് കാര്യങ്ങളാണ്"
    },
    {
      "t": "01:12",
      "text": "ഏത് കാര്യങ്ങളായിരിക്കും"
    },
    {
      "t": "01:14",
      "text": "ഏ"
    },
    {
      "t": "01:16",
      "text": "ഇരുപത്തിനാല് വയസ്സായില്ലേ വനിതാ"
    },
    {
      "t": "01:18",
      "text": "തയ്യലി"
    },
    {
      "t": "01:20",
      "text": "വലുതായി"
    },
    {
      "t": "01:22",
      "text": "ഒരുപാട് വലുതായില്ലല്ലോ ടൈം ഉണ്ടല്ലോ"
    },
    {
      "t": "01:24",
      "text": "ഉണ്ടല്ലോ"
    },
    {
      "t": "01:26",
      "text": "എനിക്ക് എത്ര വയസ്സു മുന്നേ ഉള്ളൂ"
    },
    {
      "t": "01:28",
      "text": "എനിക്ക് എത്ര വൈകി തോന്നുന്നു"
    },
    {
      "t": "01:30",
      "text": "തുടങ്ങിക്കോളൂ"
    },
    {
      "t": "01:32",
      "text": "ശരി"
    },
    {
      "t": "01:34",
      "text": "ഇരുപത്തിയെട്ട്"
    },
    {
      "t": "01:36",
      "text": "ഓക്കേ"
    },
    {
      "t": "01:38",
      "text": "അതെ"
    },
    {
      "t": "01:40",
      "text": "ഒന്നര മുപ്പത്"
    },
    {
      "t": "01:42",
      "text": "അധികം"
    },
    {
      "t": "01:44",
      "text": "റൈസായി"
    },
    {
      "t": "01:46",
      "text": "ഇരുപത്തിയാറ്"
    },
    {
      "t": "01:48",
      "text": "ആ ആ"
    },
    {
      "t": "01:50",
      "text": "ആ"
    },
    {
      "t": "01:52",
      "text": "എൺപത് സെൻറ് തൊട്ട് ബീസ്"
    },
    {
      "t": "01:54",
      "text": "എന്താ ചെയ്യുന്നത് ഓക്കെ ആണോ"
    },
    {
      "t": "01:56",
      "text": "എന്താണ്"
    },
    {
      "t": "01:58",
      "text": "ഒപ്പം"
    },
    {
      "t": "02:00",
      "text": "ഐസ്ക്രീം"
    },
    {
      "t": "02:02",
      "text": "ആ"
    },
    {
      "t": "02:04",
      "text": "കൊറോണ"
    },
    {
      "t": "02:06",
      "text": "നാളെയോ ഈ ആപ്പിൾ സേവനം"
    },
    {
      "t": "02:08",
      "text": "ആ"
    },
    {
      "t": "02:10",
      "text": "ഞാൻ ഒബ്ഷോറിലായിരുന്നു"
    },
    {
      "t": "02:12",
      "text": "ഇപ്പം രണ്ട് മൂന്ന് ദിവസമായിട്ട് ഇപ്പം കരയാൻ വന്നതാണ്"
    },
    {
      "t": "02:14",
      "text": "എടുക്കുക"
    },
    {
      "t": "02:16",
      "text": "എന്താന്നും കേട്ടില്ല"
    },
    {
      "t": "02:18",
      "text": "ഓക്ഷോർ"
    },
    {
      "t": "02:20",
      "text": "കടലിനകത്ത്"
    },
    {
      "t": "02:22",
      "text": "ആറ്"
    },
    {
      "t": "02:24",
      "text": "അടുത്തത്"
    },
    {
      "t": "02:26",
      "text": "ഓക്കെ"
    },
    {
      "t": "02:28",
      "text": "പിന്നെ എങ്ങനെയാണ്"
    },
    {
      "t": "02:30",
      "text": "ഒപ്പം ഉണ്ടോ ഇങ്ങനെ കിടന്നിട്ട്"
    },
    {
      "t": "02:32",
      "text": "അപ്പം എന്താക്കാം"
    },
    {
      "t": "02:34",
      "text": "അപ്പം"
    },
    {
      "t": "02:36",
      "text": "ഏഹ്"
    },
    {
      "t": "02:38",
      "text": "അത്രയും നല്ല"
    },
    {
      "t": "02:40",
      "text": "എടുത്താൽ മതി"
    },
    {
      "t": "02:42",
      "text": "അതെടുക്കാത്തത് വെട്ടിക്കിടന്നു"
    },
    {
      "t": "02:44",
      "text": "മിസ്റ്റർ"
    },
    {
      "t": "02:46",
      "text": "നല്ല നമ്മളെപ്പോലത്തെ ആൾക്കാരാണ്"
    },
    {
      "t": "02:48",
      "text": "കടക്കരയിൽ നിന്ന് ഇൻട്രസ്റ്റ് ഉണ്ട്"
    },
    {
      "t": "02:50",
      "text": "ആ"
    },
    {
      "t": "02:52",
      "text": "ആ"
    },
    {
      "t": "02:54",
      "text": "ആ"
    },
    {
      "t": "02:56",
      "text": "ആറ്"
    },
    {
      "t": "02:58",
      "text": "അതെന്താ"
    },
    {
      "t": "03:00",
      "text": "പറയുന്നതിന്"
    },
    {
      "t": "03:02",
      "text": "ഇതിപ്പോള്"
    },
    {
      "t": "03:04",
      "text": "തുടങ്ങിയിട്ട് അങ്ങ് മൂന്ന് ദിവസം ആയുള്ളൂ ഈ ആപ്പ്"
    },
    {
      "t": "03:06",
      "text": "രണ്ട്"
    },
    {
      "t": "03:08",
      "text": "പറഞ്ഞെടുത്തത്"
    },
    {
      "t": "03:10",
      "text": "എങ്ങനെ ഉണ്ടോ യൂസ് ചെയ്തിട്ട്"
    },
    {
      "t": "03:12",
      "text": "ഏഹ്"
    },
    {
      "t": "03:14",
      "text": "നിങ്ങൾ നിങ്ങളെപ്പോലത്തെ ആൾക്കാരാണ്"
    },
    {
      "t": "03:16",
      "text": "ആൾക്കാരെ കുറച്ചു തന്നു"
    },
    {
      "t": "03:18",
      "text": "ഇങ്ങനെ"
    },
    {
      "t": "03:20",
      "text": "അന്ന് പോയി നിൽക്കും"
    },
    {
      "t": "03:22",
      "text": "പഠിച്ചില്ല എൻ്റെ പേര്"
    },
    {
      "t": "03:24",
      "text": "ആ"
    },
    {
      "t": "03:26",
      "text": "ഇതെങ്ങനെ"
    },
    {
      "t": "03:28",
      "text": "അനിവാര്യത എങ്ങനെയുണ്ട്"
    },
    {
      "t": "03:30",
      "text": "ഉണ്ടാവും"
    },
    {
      "t": "03:32",
      "text": "ഫുള്ള് നിരയാണ്"
    },
    {
      "t": "03:34",
      "text": "നേരെ മുടിയൊക്കെ നരച്ച് ചെല്ലുമ്പോൾ"
    },
    {
      "t": "03:36",
      "text": "പിന്നെ"
    },
    {
      "t": "03:38",
      "text": "പിന്നെ"
    },
    {
      "t": "03:40",
      "text": "അർത്ഥശാസ്ത്രം"
    },
    {
      "t": "03:42",
      "text": "മാനിക്കുകയാണോ എല്ലാവരും ഇങ്ങനെ ആന്റിമാരിന്നൊക്കെ"
    },
    {
      "t": "03:44",
      "text": "ഇത് പറയുമ്പോൾ ഞാൻ വിചാരിക്കും"
    },
    {
      "t": "03:46",
      "text": "നാല്പത് വയസ്സൊക്കെ ഉള്ള"
    },
    {
      "t": "03:48",
      "text": "ചുരുക്കം ഒരു മുപ്പത്താറ് പത്ത്"
    },
    {
      "t": "03:50",
      "text": "കേസ് കലക്കൽ വരും പക്ഷേ ചില ആന്റിബയോട്ടിക്"
    },
    {
      "t": "03:52",
      "text": "കാണുമ്പോൾ തന്നെ"
    },
    {
      "t": "03:54",
      "text": "നല്ല പ്രായം കാണുമെന്ന് അതായത് മുടിയൊക്കെ"
    },
    {
      "t": "03:56",
      "text": "നിറച്ച് സൈഡൊക്കെ നിറച്ച് ആൾക്കാർക്ക് കിട്ടും"
    },
    {
      "t": "03:58",
      "text": "ആ"
    },
    {
      "t": "04:00",
      "text": "ആ"
    },
    {
      "t": "04:02",
      "text": "അവരൊക്കെ ഫുൾ നൂടല്ലേ"
    },
    {
      "t": "04:04",
      "text": "ഇത് ഇത്"
    },
    {
      "t": "04:06",
      "text": "സംസാരിക്കില്ല"
    },
    {
      "t": "04:08",
      "text": "അറ്റാഡിയോകളായി"
    },
    {
      "t": "04:10",
      "text": "ആ"
    },
    {
      "t": "04:12",
      "text": "ഇങ്ങനെ"
    },
    {
      "t": "04:14",
      "text": "എന്താ ഇങ്ങനെ കോഴ്സ് വരുമ്പോൾ"
    },
    {
      "t": "04:16",
      "text": "ഞാൻ ഓരോരുത്തർ പറയും"
    },
    {
      "t": "04:18",
      "text": "അ"
    },
    {
      "t": "04:20",
      "text": "ഒരു ദിവസം ഞാൻ ഒരു ദിവസം ഓഫീസിൽ പോയിട്ട്"
    },
    {
      "t": "04:22",
      "text": "ഓഫ് ആയിരുന്നു അപ്പം ഞാൻ പകലും ഇങ്ങനെ വരുന്നു"
    },
    {
      "t": "04:24",
      "text": "എന്താ ഓണാക്കിയപ്പോൾ"
    },
    {
      "t": "04:26",
      "text": "ഒരു ആൾ കണക്റ്റായി അപ്പം എൻ്റെ അടുത്ത്"
    },
    {
      "t": "04:28",
      "text": "ഓപ്പൺ ഡോക്ക് യൂണിയൻസ്"
    },
    {
      "t": "04:30",
      "text": "ഞാൻ പറഞ്ഞു ആ അങ്ങനെ ചെയ്യാം"
    },
    {
      "t": "04:32",
      "text": "അല്ല ജസ്റ്റ് ട്രൈ ചെയ്തു നോക്കാം എന്ന് പറഞ്ഞു"
    },
    {
      "t": "04:34",
      "text": "അപ്പം പിള്ളേർ"
    },
    {
      "t": "04:36",
      "text": "എന്താ ഓപ്പൺ ഡോക്ക് ചെയ്തത് ഓപ്പൺ ഡോക്ക് ചെയ്യാമല്ലോ"
    },
    {
      "t": "04:38",
      "text": "എനിക്ക് എന്താ വേണ്ടതെന്ന് വെച്ചാൽ"
    },
    {
      "t": "04:40",
      "text": "തൊട്ട് മുന്നേ എനിക്കൊരു"
    },
    {
      "t": "04:42",
      "text": "ഓള് കിട്ടിയായിരുന്നു അതിലൊരു"
    },
    {
      "t": "04:44",
      "text": "ചേച്ചി"
    },
    {
      "t": "04:46",
      "text": "ടവറിൻ്റെ താഴെ നിന്ന് കുളിക്കുക"
    },
    {
      "t": "04:48",
      "text": "എന്നിട്ട് എനിക്ക്"
    },
    {
      "t": "04:50",
      "text": "പെണ്ണുങ്ങളെ കോൾ കണക്ട് ആകുമോ"
    },
    {
      "t": "04:52",
      "text": "ഏഹ് നിങ്ങൾക്ക്"
    },
    {
      "t": "04:54",
      "text": "പെണ്ണുങ്ങൾ കണക്ട് ആകുമോ പെണ്ണുങ്ങളുടെ അല്ല"
    },
    {
      "t": "04:56",
      "text": "എന്റെയടുത്ത് ഒരു ചേട്ടൻ പറഞ്ഞതാണ്"
    },
    {
      "t": "04:58",
      "text": "ഓ"
    },
    {
      "t": "05:00",
      "text": "ആ എന്നിട്ട് ഇങ്ങനെ ഒരു ചേച്ചി തോന്നി"
    },
    {
      "t": "05:02",
      "text": "പുറത്തേക്കൊടുത്ത് ഒന്ന് പൊളിക്കുവേ ഷവറിൻ്റെ അകിട്"
    },
    {
      "t": "05:04",
      "text": "എന്നിട്ട് മേത്തൊക്കെ"
    },
    {
      "t": "05:06",
      "text": "വെള്ളം നിറഞ്ഞ് കഴിയുമ്പോൾ തോർത്ത് കുരു"
    },
    {
      "t": "05:08",
      "text": "അടിപൊളി പരിപാടിയാണ്"
    },
    {
      "t": "05:10",
      "text": "എന്നിട്ട് എന്റെ അടുത്ത് നോക്കിയാൽ അങ്ങനെ ചെയ്യാൻ പറ്റുമോ"
    },
    {
      "t": "05:12",
      "text": "ക്യാമറ ഇല്ല പിന്നീട് പറഞ്ഞു"
    },
    {
      "t": "05:14",
      "text": "ലോകത്തുള്ളവർക്കൊക്കെ ചെയ്യാം ഇതിലുള്ളവർക്ക്"
    },
    {
      "t": "05:16",
      "text": "ഇതൊക്കെ ചെയ്യും പിന്നെ എന്താ നിനക്ക് കിട്ടുക എന്ന് പറഞ്ഞിട്ട്"
    },
    {
      "t": "05:18",
      "text": "ആ"
    },
    {
      "t": "05:20",
      "text": "അങ്ങനത്തേത് കേട്ടല്ലോ"
    },
    {
      "t": "05:22",
      "text": "ഏതാണോ അതായിരിക്കും"
    },
    {
      "t": "05:24",
      "text": "ആ"
    },
    {
      "t": "05:26",
      "text": "അങ്ങനെ"
    },
    {
      "t": "05:28",
      "text": "അങ്ങനെയുള്ളവരും ഉണ്ട്"
    },
    {
      "t": "05:30",
      "text": "താല്പര്യമുള്ളതും"
    },
    {
      "t": "05:32",
      "text": "ഉണ്ട് താല്പര്യമില്ലാത്തവരുണ്ട് ഏതായാലും"
    },
    {
      "t": "05:34",
      "text": "വൈബാണെന്ന് എനിക്ക് അറിയാം"
    },
    {
      "t": "05:36",
      "text": "ആ"
    },
    {
      "t": "05:38",
      "text": "സെക്കൻഡ്"
    },
    {
      "t": "05:40",
      "text": "ആ"
    },
    {
      "t": "05:42",
      "text": "എനിക്കോ ഫോട്ടോ ഒക്കെയാണ് താല്പര്യം"
    },
    {
      "t": "05:44",
      "text": "ഏ"
    },
    {
      "t": "05:46",
      "text": "എനിക്കും ഒപ്പം ടോക്ക് ചെയ്യാൻ പറ്റും"
    },
    {
      "t": "05:48",
      "text": "താല്പര്യം"
    },
    {
      "t": "05:50",
      "text": "അതെ"
    },
    {
      "t": "05:52",
      "text": "ഞാൻ"
    },
    {
      "t": "05:54",
      "text": "ഞാനിതങ്ങനെ പിടിക്കാറില്ല ഗയ്സ്"
    },
    {
      "t": "05:56",
      "text": "പിടിയൻ"
    },
    {
      "t": "05:58",
      "text": "പിന്നെ"
    },
    {
      "t": "06:00",
      "text": "ഞാൻ ഇങ്ങനെ ഒന്ന് രണ്ട് പേരോട് ചോദിച്ചു എങ്ങനെയാണ് അത് ചെയ്യുന്നത്"
    },
    {
      "t": "06:02",
      "text": "ചെയ്യണേ ഇങ്ങനെ ഇരിക്കുന്ന"
    },
    {
      "t": "06:04",
      "text": "മറ്റേത് ചെയ്യണേ"
    },
    {
      "t": "06:06",
      "text": "ട്രയൽ നടന്നു നോക്കാം നമുക്ക് ഇങ്ങനെ"
    },
    {
      "t": "06:08",
      "text": "ഇഷ്ടമുള്ള ഒരാളുടെ കൂടെയല്ലേ നമുക്കിങ്ങനെ ഓപ്പൺ ടോക്ക്"
    },
    {
      "t": "06:10",
      "text": "ഇഷ്ടമില്ലാത്ത ആൾക്കാരെ"
    },
    {
      "t": "06:12",
      "text": "ഉപകാരപ്രദമാകുമ്പം നമുക്ക്"
    },
    {
      "t": "06:14",
      "text": "എന്തും പറയാം"
    },
    {
      "t": "06:16",
      "text": "അതാ പ്രശ്നം"
    },
    {
      "t": "06:18",
      "text": "എന്തും പറയാനുള്ളത് വരുമ്പോൾ"
    },
    {
      "t": "06:20",
      "text": "യൂസ് ബാഡ് വേവ്സ് ആൻഡ് സോ"
    },
    {
      "t": "06:22",
      "text": "ആ സെയിം സെയിം സെയിം അതാണ് അതാണ്"
    },
    {
      "t": "06:24",
      "text": "എന്റെ പ്രശ്നം ജസ്റ്റ് എന്തും പറയാം"
    },
    {
      "t": "06:26",
      "text": "ചെയ്യാം എന്നുള്ള ഒരു ക്ലോസ് വരാൻ തുടങ്ങി"
    },
    {
      "t": "06:28",
      "text": "കൊടുത്ത് എന്തും പറയും"
    },
    {
      "t": "06:30",
      "text": "ഓപ്പൺ നോക്കി ആവുമ്പോള്"
    },
    {
      "t": "06:32",
      "text": "എനിക്ക് താല്പര്യം ഉണ്ടാവില്ല പിന്നെ ഞാൻ ഒരു ക്യൂരിയോസിറ്റി"
    },
    {
      "t": "06:34",
      "text": "ഓക്കെ നമുക്ക് ട്രൈ ചെയ്ത് നോക്കാം എന്ന് പറയുമ്പോൾ"
    },
    {
      "t": "06:36",
      "text": "അത്ര നേരം എടോന്ന്"
    },
    {
      "t": "06:38",
      "text": "വിളിച്ചുകൊണ്ടിരുന്ന ആള് അടുത്ത"
    },
    {
      "t": "06:40",
      "text": "എന്താ വിളിക്കുക ഇടിയുന്നോ ഇടും"
    },
    {
      "t": "06:42",
      "text": "ഈ എടീന്ന് വിളിക്കുന്ന നായ്ക്കളെ കണ്ണെടുത്ത്"
    },
    {
      "t": "06:44",
      "text": "എടുത്തോ കണ്ടുടാ"
    },
    {
      "t": "06:46",
      "text": "എഡി എഡി എന്ന് വിളിക്കുന്നത്"
    },
    {
      "t": "06:48",
      "text": "എൻ്റെ അഭിപ്രായത്തിൽ ഒരു ചീത്തയോ ബാക്ക്ഗ്രൗണ്ട് ഉണ്ടോ എന്ന് എനിക്ക് തോന്നുന്നു"
    },
    {
      "t": "06:50",
      "text": "എനിക്ക് ഇഷ്ടപ്പെട്ടില്ല"
    },
    {
      "t": "06:52",
      "text": "ഒരു ബോയ്ക്ക് എടിയെന്ന് വിളിക്കുമ്പോൾ"
    },
    {
      "t": "06:54",
      "text": "നിനക്കെടാന്ന് വിളിക്കാല്"
    },
    {
      "t": "06:56",
      "text": "ഐഡിയ എന്ന് വിളിക്കുന്നത് എന്താ പറ്റി"
    },
    {
      "t": "06:58",
      "text": "ഇടാന്ന് വിളിക്കാറില്ലല്ലോ ഞാൻ ഇടുമെന്ന് വിളിക്കാറുള്ളൂ"
    },
    {
      "t": "07:00",
      "text": "ആ പെണ്ണുങ്ങൾ"
    },
    {
      "t": "07:02",
      "text": "നമുക്ക് ഈ എടമൊന്നും വിളിക്കാൻ പറ്റത്തില്ല"
    },
    {
      "t": "07:04",
      "text": "ഡി എ ഡി"
    },
    {
      "t": "07:06",
      "text": "എടീ ഒന്ന് പോകൂ"
    },
    {
      "t": "07:08",
      "text": "പോയി അവിടുന്ന്"
    },
    {
      "t": "07:10",
      "text": "അങ്ങനെ"
    },
    {
      "t": "07:12",
      "text": "ഞാൻ വിളിച്ചു കഴിഞ്ഞാൽ എന്നെ ക്രഞ്ച് അടഞ്ഞിട്ട് പിന്നെ അത്"
    },
    {
      "t": "07:14",
      "text": "അത് കഴിഞ്ഞിട്ടുള്ള ഫസ്റ്റത്തെ ഇത് എ ഡി ആയിരിക്കും"
    },
    {
      "t": "07:16",
      "text": "അപ്പം തന്നെ ഞാൻ പറഞ്ഞു അതെ"
    },
    {
      "t": "07:18",
      "text": "എൻ്റെ ബോഡിയിൽ"
    },
    {
      "t": "07:20",
      "text": "ബിനു ബിനുവിന്റെ പടത്തിൽ കാവ്യമാധവന്"
    },
    {
      "t": "07:22",
      "text": "എഗ്ഗ് അതാണ് കുടിക്കാത്തത്"
    },
    {
      "t": "07:24",
      "text": "ഇങ്ങനെ പൊടി അങ്ങനെ"
    },
    {
      "t": "07:26",
      "text": "അതെ ആ ഒരു ധാർഷ്ട്യത വന്ന് ഞാൻ എങ്ങനെയാണ്"
    },
    {
      "t": "07:28",
      "text": "അഡ്ജസ്റ്റ് ചെയ്ത് നിൽക്കുമ്പോഴായിരിക്കും അടുത്തത്"
    },
    {
      "t": "07:30",
      "text": "നിൻ്റെ മുലയുടെ സൈസ് എത്രയാണ് അപ്പോൾ എൻ്റെ"
    },
    {
      "t": "07:32",
      "text": "അപ്പം ഞാൻ അങ്ങനെ ഒരുപാട് കാര്യങ്ങൾ ചെയ്തു"
    },
    {
      "t": "07:34",
      "text": "ഒരു കാര്യം ചോദിക്കട്ടെ കാര്യം"
    },
    {
      "t": "07:36",
      "text": "ഈ ഒരു ആപ്പ്"
    },
    {
      "t": "07:38",
      "text": "രണ്ടിനെയും കൂടെ അല്ലേ അപ്പോൾ ആൾക്കാർ ചോദിക്കുന്നത് എന്താണ്"
    },
    {
      "t": "07:40",
      "text": "അതെ"
    },
    {
      "t": "07:42",
      "text": "പക്ഷേ അങ്ങനെയല്ല"
    },
    {
      "t": "07:44",
      "text": "നമുക്കിപ്പോൾ താനെ"
    },
    {
      "t": "07:46",
      "text": "എൻ്റെ ശരീരത്തെപ്പറ്റി പറയുമ്പോൾ"
    },
    {
      "t": "07:48",
      "text": "അതിന് എൻ്റെ കൺസെൻറ്റ് വേണം"
    },
    {
      "t": "07:50",
      "text": "അത്"
    },
    {
      "t": "07:52",
      "text": "എന്താണ് അതിനാണ് നമ്മൾ പറയുന്നത് ഓപ്പൺ ടോക്ക്"
    },
    {
      "t": "07:54",
      "text": "താല്പര്യമുണ്ടോ നോ ആണെങ്കിൽ"
    },
    {
      "t": "07:56",
      "text": "ഇന്നു എസ് ആണെങ്കിൽ എസ് സി താല്പര്യമില്ല"
    },
    {
      "t": "07:58",
      "text": "ഇല്ല എന്ന് പറഞ്ഞാൽ അവിടം കൊണ്ട് നിർത്തണം"
    },
    {
      "t": "08:00",
      "text": "അല്ലെങ്കിൽ ഇത് ചിലരുണ്ട്"
    },
    {
      "t": "08:02",
      "text": "ആ ഞാൻ ഓർക്കുന്നുണ്ട്"
    },
    {
      "t": "08:04",
      "text": "ഇപ്പോഴും ഇപ്പോഴും ഇപ്പോഴും അറിയാൻ പറ്റും"
    },
    {
      "t": "08:06",
      "text": "എനിക്ക് ഓപ്പൺ ഡ്രോപ്പ് ചെയ്യാൻ താല്പര്യം എന്ന് പറഞ്ഞു"
    },
    {
      "t": "08:08",
      "text": "ഇയാൾ അതിൽ എക്സിനോ എന്ന് പറഞ്ഞില്ല"
    },
    {
      "t": "08:10",
      "text": "ഓ"
    },
    {
      "t": "08:12",
      "text": "ഞാൻ ഒന്നും പറഞ്ഞില്ലല്ലോ"
    },
    {
      "t": "08:14",
      "text": "അത് കമ്പൽസറി ചെയ്യുന്നതും ഇല്ല താല്പര്യമുള്ള"
    },
    {
      "t": "08:16",
      "text": "ആ അതാ പറഞ്ഞത്"
    },
    {
      "t": "08:18",
      "text": "ഞാൻ ദൈവത്തെ മറ്റു കാര്യങ്ങൾ"
    },
    {
      "t": "08:20",
      "text": "കൈൻഡ് ഓഫ് കുലസ്ത്രീ അങ്ങനെയൊന്നും പറയുന്നില്ല"
    },
    {
      "t": "08:22",
      "text": "ജസ്റ്റ് ഞാൻ ഓപ്പൺ ടോക്ക് ചെയ്തിട്ടുണ്ട്"
    },
    {
      "t": "08:24",
      "text": "ചെയ്യാതിരുന്നിട്ടൊന്നുമില്ല ചെയ്തിട്ടുണ്ട്"
    },
    {
      "t": "08:26",
      "text": "പക്ഷേ"
    },
    {
      "t": "08:28",
      "text": "ഒരാൾ വന്നിട്ട് ഒരു കാര്യം പറയാം"
    },
    {
      "t": "08:30",
      "text": "ആണുങ്ങൾക്കൊന്നും"
    },
    {
      "t": "08:32",
      "text": "പറയുമ്പോൾ കുറച്ച് ആക്രാന്തം കൂടുന്നില്ല"
    },
    {
      "t": "08:34",
      "text": "നിരാടി നിരാടി"
    },
    {
      "t": "08:36",
      "text": "യെസ് അത്രയേ ഉള്ളൂ"
    },
    {
      "t": "08:38",
      "text": "അതൊരു ഗേൾ ഇപ്പം നിൽക്കുന്നുണ്ട്"
    },
    {
      "t": "08:40",
      "text": "നിനക്കൊരു ബോയ് ഫ്രണ്ട് വന്നു കഴിഞ്ഞാൽ"
    },
    {
      "t": "08:42",
      "text": "സെക്സിൽ ഏർപ്പെടുമ്പോഴത്തേക്ക്"
    },
    {
      "t": "08:44",
