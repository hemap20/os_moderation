  "segments": [
    {
      "t": "00:00",
      "text": "ஹலோ"
    },
    {
      "t": "00:02",
      "text": "ஹலோ"
    },
    {
      "t": "00:04",
      "text": "சான்ஸ்"
    },
    {
      "t": "00:06",
      "text": "ஒரு எந்த ஒரு"
    },
    {
      "t": "00:08",
      "text": "ஆன்சர் பண்ணிக்கலாம்"
    },
    {
      "t": "00:10",
      "text": "ம் நான்கு"
    },
    {
      "t": "00:12",
      "text": "காயம் பண்ணியே"
    },
    {
      "t": "00:14",
      "text": "நான் திருச்சி"
    },
    {
      "t": "00:16",
      "text": "என்ன பண்ணுறா சும்மா சிரிக்கிறா"
    },
    {
      "t": "00:18",
      "text": "நான் ஃபேஸ் பண்ணுறேன்"
    },
    {
      "t": "00:20",
      "text": "புரியல எவ்வளோ நாள் ஆச்சு"
    },
    {
      "t": "00:22",
      "text": "பிஎஸ் பென்ஷன்"
    },
    {
      "t": "00:24",
      "text": "ஆறு பத்து நாளில் யூஸ் பண்ணுற நீயே"
    },
    {
      "t": "00:26",
      "text": "நான் ஒரு ஒன் வீக்கை யூஸ் பண்றேன்"
    },
    {
      "t": "00:28",
      "text": "வாட்ஸ்அப்லலாம் பேசியிருக்கியா"
    },
    {
      "t": "00:30",
      "text": "பேசியிருக்கேன்"
    },
    {
      "t": "00:32",
      "text": "இல்லை"
    },
    {
      "t": "00:34",
      "text": "ம் நம்ம பேசலாமா"
    },
    {
      "t": "00:36",
      "text": "அப்படியா"
    },
    {
      "t": "00:38",
      "text": "சொல்லுங்கள் யார்"
    },
    {
      "t": "00:40",
      "text": "எப்படி பேசுவ"
    },
    {
      "t": "00:42",
      "text": "ஜானி பேசுவேன் என் பேர் சௌமியா"
    },
    {
      "t": "00:44",
      "text": "சரி"
    },
    {
      "t": "00:46",
      "text": "டெவன் கே டென்"
    },
    {
      "t": "00:48",
      "text": "ம் ம்"
    },
    {
      "t": "00:50",
      "text": "நீ மேரீடா சிங்கிளா"
    },
    {
      "t": "00:52",
      "text": "சிங்கிள் தான்"
    },
    {
      "t": "00:54",
      "text": "ம் ம்"
    },
    {
      "t": "00:56",
      "text": "சரி"
    },
    {
      "t": "00:58",
      "text": "நம்பர் கொடு"
    },
    {
      "t": "01:00",
      "text": "ஆ நீ அமௌண்ட் பே பண்ணுற மாதிரி இருக்கா"
    },
    {
      "t": "01:02",
      "text": "எவ்வளோ தூரம்"
    },
    {
      "t": "01:04",
      "text": "த்ரீ ஹண்ட்ரட்"
    },
    {
      "t": "01:06",
      "text": "ம் ம் வாங்கிட்டு ஏமாத்துட்டு போய்ட்டேன்"
    },
    {
      "t": "01:08",
      "text": "நைன் எம்எல்"
    },
    {
      "t": "01:10",
      "text": "மற்ற மற்ற நீ எப்போ வேணாலும் இந்த நம்பருக்கு கால் பண்ணு"
    },
    {
      "t": "01:12",
      "text": "பண்ணலாம் நான் தான் வச்சிருப்பேன்"
    },
    {
      "t": "01:14",
      "text": "சரி சரி பிளாக்"
    },
    {
      "t": "01:16",
      "text": "அதுக்கு ரெண்டு பேர் ட்ரைவிங்கில்"
    },
    {
      "t": "01:18",
      "text": "நான் ப்ளாக் பண்ண மாட்டேன்"
    }
  ],
  "full_text": "ஹலோ ஹலோ சான்ஸ் ஒரு எந்த ஒரு ஆன்சர் பண்ணிக்கலாம் ம் நான்கு காயம் பண்ணியே நான் திருச்சி என்ன பண்ணுறா சும்மா சிரிக்கிறா நான் ஃபேஸ் பண்ணுறேன் புரியல எவ்வளோ நாள் ஆச்சு பிஎஸ் பென்ஷன் ஆறு பத்து நாளில் யூஸ் பண்ணுற நீயே நான் ஒரு ஒன் வீக்கை யூஸ் பண்றேன் வாட்ஸ்அப்லலாம் பேசியிருக்கியா பேசியிருக்கேன் இல்லை ம் நம்ம பேசலாமா அப்படியா சொல்லுங்கள் யார் எப்படி பேசுவ ஜானி பேசுவேன் என் பேர் சௌமியா சரி டெவன் கே டென் ம் ம் நீ மேரீடா சிங்கிளா சிங்கிள் தான் ம் ம் சரி நம்பர் கொடு ஆ நீ அமௌண்ட் பே பண்ணுற மாதிரி இருக்கா எவ்வளோ தூரம் த்ரீ ஹண்ட்ரட் ம் ம் வாங்கிட்டு ஏமாத்துட்டு போய்ட்டேன் நைன் எம்எல் மற்ற மற்ற நீ எப்போ வேணாலும் இந்த நம்பருக்கு கால் பண்ணு பண்ணலாம் நான் தான் வச்சிருப்பேன் சரி சரி பிளாக் அதுக்கு ரெண்டு பேர் ட்ரைவிங்கில் நான் ப்ளாக் பண்ண மாட்டேன்",
