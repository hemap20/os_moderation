      "text": "ఏమన్నాడు"
    },
    {
      "t": "00:50",
      "text": "ఇదే అన్నాడు"
    },
    {
      "t": "00:52",
      "text": "ఎందుకని"
    },
    {
      "t": "00:54",
      "text": "ఏమో మరి తెలుగు"
