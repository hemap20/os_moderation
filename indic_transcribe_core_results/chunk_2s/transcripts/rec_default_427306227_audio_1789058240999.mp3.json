      "text": "నేను"
    },
    {
      "t": "01:06",
      "text": "అవునా"
    },
    {
      "t": "01:08",
      "text": "బాగున్నా"
    },
    {
      "t": "01:10",
      "text": "అవును"
    },
    {
      "t": "01:12",
      "text": "ఓకే"
    },
    {
      "t": "01:14",
      "text": "మీ పేపర్ ఫుల్ వచ్చింది"
    },
    {
      "t": "01:16",
      "text": "రెండు వందలు"
    },
    {
      "t": "01:18",
      "text": "మీ పాప"
    },
    {
      "t": "01:20",
      "text": "ఏంటి జస్ట్"
    },
    {
      "t": "01:22",
      "text": "స్టోర్ టీవీ"
    },
    {
      "t": "01:24",
      "text": "ఈ ఫోటో"
    },
    {
      "t": "01:26",
      "text": "పర్సెంట్"
    },
    {
      "t": "01:28",
      "text": "ఫైన్ పర్పస్"
    },
    {
      "t": "01:30",
      "text": "ఆ"
    },
    {
      "t": "01:32",
      "text": "టైంపాస్ అవే టైంకి ఏమన్నా"
    },
    {
      "t": "01:34",
      "text": "టెన్ పర్సెంట్"
    },
    {
      "t": "01:36",
      "text": "రెండు పర్పస్ వన్ పాయింట్"
    },
    {
      "t": "01:38",
      "text": "బికాస్ సాటిస్ఫై లేకపోతే"
    },
    {
      "t": "01:40",
      "text": "సరే"
    },
    {
      "t": "01:42",
      "text": "వన్ వన్లో వన్"
    },
    {
      "t": "01:44",
      "text": "అప్పుడు ఏం చెప్తారు"
    },
    {
      "t": "01:46",
      "text": "షిఫార్సు"
    },
    {
      "t": "01:48",
      "text": "సో సర్టిఫైడ్"
    },
    {
      "t": "01:50",
      "text": "అంతేనా"
    },
    {
      "t": "01:52",
      "text": "మ్యామ్ పిల్లలు ఎంత మ్యామ్"
    },
    {
      "t": "01:54",
      "text": "అసలు"
    },
    {
      "t": "01:56",
      "text": "సో ఏట్లేదా హస్బెండ్"
    },
    {
      "t": "01:58",
      "text": "మీ"
    },
    {
      "t": "02:00",
      "text": "హస్బెండ్"
    },
    {
      "t": "02:02",
      "text": "సాటిస్ఫై చేయట్లేదా"
    },
    {
      "t": "02:04",
      "text": "ఏంటి"
    },
    {
      "t": "02:06",
      "text": "హస్బెండ్"
    },
    {
      "t": "02:08",
      "text": "సాటిస్ఫై చేయడా అంటాను"
    },
    {
      "t": "02:10",
      "text": "దాని గురించి చాలా అనుమానం"
