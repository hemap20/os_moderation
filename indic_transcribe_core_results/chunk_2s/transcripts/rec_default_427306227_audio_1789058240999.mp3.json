      "text": "ఇద్దరు"
    },
    {
      "t": "00:36",
      "text": "లేదా హస్బెండ్ లేడా"
    },
    {
      "t": "00:38",
      "text": "మరి"
    },
    {
      "t": "00:40",
      "text": "ఓవరాల్గా"
    },
