      "t": "02:30",
      "text": "ఆ"
    },
    {
      "t": "02:32",
      "text": "ఎలా మలుచుకుని"
    },
    {
      "t": "02:34",
      "text": "వాళ్ళకి అలా ఉంటుంది"
    }
