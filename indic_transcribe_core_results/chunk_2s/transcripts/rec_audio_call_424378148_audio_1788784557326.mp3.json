{
  "file_id": "rec_audio_call_424378148_audio_1788784557326.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 122.603,
  "processing_time_sec": 10.191653966903687,
  "segments": [
    {
      "t": "00:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "ஹலோ ஹாய்"
    },
    {
      "t": "00:04",
      "text": "ம்"
    },
    {
      "t": "00:06",
      "text": "வணக்கம்"
    },
    {
      "t": "00:08",
      "text": "என்ன ஒரு சவுண்டாக இருக்குது"
    },
    {
      "t": "00:10",
      "text": "சாணம்"
    },
    {
      "t": "00:12",
      "text": "குரல் ஃபேன் ஓடுதா ஓகே ஓகே"
    },
    {
      "t": "00:14",
      "text": "எங்கேருந்து பேசுகிறீங்க அங்கே போய்"
    },
    {
      "t": "00:16",
      "text": "என் பேர் நான் பேங்களூர்"
    },
    {
      "t": "00:18",
      "text": "பெங்களூர் ஆ"
    },
    {
      "t": "00:20",
      "text": "ஆ"
    },
    {
      "t": "00:22",
      "text": "உங்கள் பேர்"
    },
    {
      "t": "00:24",
      "text": "பூஜா பூஜா"
    },
    {
      "t": "00:26",
      "text": "என்ன பண்ணுவீங்க"
    },
    {
      "t": "00:28",
      "text": "நான் சரி"
    },
    {
      "t": "00:30",
      "text": "பிஸ்மில்லா"
    },
    {
      "t": "00:32",
      "text": "கம்பளம் ஓப்பன் பண்ணு"
    },
    {
      "t": "00:34",
      "text": "ஓகேயா"
    },
    {
      "t": "00:36",
      "text": "சிங்களா கமிட்டிடா"
    },
    {
      "t": "00:38",
      "text": "ஆ சிங்கிள்"
    },
    {
      "t": "00:40",
      "text": "என்ன வயசு"
    },
    {
      "t": "00:42",
      "text": "ட்வெண்ட்டி ஃபோர்"
    },
    {
      "t": "00:44",
      "text": "ஓகே"
    },
    {
      "t": "00:46",
      "text": "உங்களுக்கு"
    },
    {
      "t": "00:48",
      "text": "எங்களை விட ஒரு ரெண்டு வயசு பெரியவங்க"
    },
    {
      "t": "00:50",
      "text": "சரி பண்ணுங்கள் ஓகே டுவெண்ட்டி சிக்ஸ்"
    },
    {
      "t": "00:52",
      "text": "நல்லா"
    },
    {
      "t": "00:54",
      "text": "சரி"
    },
    {
      "t": "00:56",
      "text": "வேர் சர்ட்டிஃபிகேட்"
    },
    {
      "t": "00:58",
      "text": "போகுது இந்த ஆற்றுப்படி போகுது"
    },
    {
      "t": "01:00",
      "text": "இன்னைக்கு தான் வந்தேன்"
    },
    {
      "t": "01:02",
      "text": "சேப்பிளு"
    },
    {
      "t": "01:04",
      "text": "பேசுகிறாங்க பிடிச்சிருக்கா யாரையாச்சும்"
    },
    {
      "t": "01:06",
      "text": "இன்னும் எதுவும் பேசவே இல்லை நீங்கள் தான் செகண்ட்"
    },
    {
      "t": "01:08",
      "text": "கால் பஸ்ஸு தான் அல்கேட் ஆகிடுச்சி"
    },
    {
      "t": "01:10",
      "text": "ஓகே"
    },
    {
      "t": "01:12",
      "text": "ம்"
    },
    {
      "t": "01:14",
      "text": "இந்த ஊன்றிய"
    },
    {
      "t": "01:16",
      "text": "ஓகே அப்படிங்களா"
    },
    {
      "t": "01:18",
      "text": "என்ன பண்ணுறீங்க வீட்டில் இருக்கீங்களா வெளியே"
    },
    {
      "t": "01:20",
      "text": "காலேஜ்"
    },
    {
      "t": "01:22",
      "text": "ப்ரைஸ் முடிஞ்சிச்சு த்ரீ தேர்ட்டிக்கு"
    },
    {
      "t": "01:24",
      "text": "சரி வந்து அப்படியே பிள்ளை பிடிச்சிச்சி"
    },
    {
      "t": "01:26",
      "text": "என்ன பண்ணுறதுன்னு யோசிச்சுட்டே இருந்தேன்"
    },
    {
      "t": "01:28",
      "text": "சரின்னு எத்தனை தேவைன்னு சொன்னீங்க"
    },
    {
      "t": "01:30",
      "text": "இன்ஸ்டால் பண்ணேன் இன்ஸ்டாகிராமில் பார்த்தேன்னா"
    },
    {
      "t": "01:32",
      "text": "சரின்ட்டா நமக்கு"
    },
    {
      "t": "01:34",
      "text": "ஏதாச்சும் கேட்டாலும் வரணும் அது என்ன தெரிஞ்சுக்கணும்"
    },
    {
      "t": "01:36",
      "text": "தூக்கம் எல்லாமே தூக்கமே வராது"
    },
    {
      "t": "01:38",
      "text": "ஓஹோ எதை பற்றி இருந்தீங்கன்னு கேட்டீங்கன்னா"
    },
    {
      "t": "01:40",
      "text": "இந்த ஆப்பை பற்றி தான்"
    },
    {
      "t": "01:42",
      "text": "ஓகே சரி இன்ஸ்டால் பண்ணியாச்சு"
    },
    {
      "t": "01:44",
      "text": "இப்போது ஞாபகம் வந்து தான் அவன் பேசுகிறான்"
    },
    {
      "t": "01:46",
      "text": "பண்ணி ஃபஸ்ட்டு ஒரு கால்"
    },
    {
      "t": "01:48",
      "text": "பேசுனேன் எப்படி போச்சு நல்லா"
    },
    {
      "t": "01:50",
      "text": "பேசுனாங்க"
    },
    {
      "t": "01:52",
      "text": "அப்புறமா சடனாக நார்மல்"
    },
    {
      "t": "01:54",
      "text": "நல்லாதான் ம் எதுவும்"
    },
    {
      "t": "01:56",
      "text": "பார்த்தீங்கன்னா அவங்கள பற்றி சொன்னாங்க"
    },
    {
      "t": "01:58",
      "text": "என்னை பற்றி கேட்டாங்க"
    },
    {
      "t": "02:00",
      "text": "ஸ்னானா நார்மலாக"
    },
    {
      "t": "02:02",
      "text": "சப்போர்ட்ஸ்"
    }
  ],
  "full_text": "சரிங்க சார் ஹலோ ஹாய் ம் வணக்கம் என்ன ஒரு சவுண்டாக இருக்குது சாணம் குரல் ஃபேன் ஓடுதா ஓகே ஓகே எங்கேருந்து பேசுகிறீங்க அங்கே போய் என் பேர் நான் பேங்களூர் பெங்களூர் ஆ ஆ உங்கள் பேர் பூஜா பூஜா என்ன பண்ணுவீங்க நான் சரி பிஸ்மில்லா கம்பளம் ஓப்பன் பண்ணு ஓகேயா சிங்களா கமிட்டிடா ஆ சிங்கிள் என்ன வயசு ட்வெண்ட்டி ஃபோர் ஓகே உங்களுக்கு எங்களை விட ஒரு ரெண்டு வயசு பெரியவங்க சரி பண்ணுங்கள் ஓகே டுவெண்ட்டி சிக்ஸ் நல்லா சரி வேர் சர்ட்டிஃபிகேட் போகுது இந்த ஆற்றுப்படி போகுது இன்னைக்கு தான் வந்தேன் சேப்பிளு பேசுகிறாங்க பிடிச்சிருக்கா யாரையாச்சும் இன்னும் எதுவும் பேசவே இல்லை நீங்கள் தான் செகண்ட் கால் பஸ்ஸு தான் அல்கேட் ஆகிடுச்சி ஓகே ம் இந்த ஊன்றிய ஓகே அப்படிங்களா என்ன பண்ணுறீங்க வீட்டில் இருக்கீங்களா வெளியே காலேஜ் ப்ரைஸ் முடிஞ்சிச்சு த்ரீ தேர்ட்டிக்கு சரி வந்து அப்படியே பிள்ளை பிடிச்சிச்சி என்ன பண்ணுறதுன்னு யோசிச்சுட்டே இருந்தேன் சரின்னு எத்தனை தேவைன்னு சொன்னீங்க இன்ஸ்டால் பண்ணேன் இன்ஸ்டாகிராமில் பார்த்தேன்னா சரின்ட்டா நமக்கு ஏதாச்சும் கேட்டாலும் வரணும் அது என்ன தெரிஞ்சுக்கணும் தூக்கம் எல்லாமே தூக்கமே வராது ஓஹோ எதை பற்றி இருந்தீங்கன்னு கேட்டீங்கன்னா இந்த ஆப்பை பற்றி தான் ஓகே சரி இன்ஸ்டால் பண்ணியாச்சு இப்போது ஞாபகம் வந்து தான் அவன் பேசுகிறான் பண்ணி ஃபஸ்ட்டு ஒரு கால் பேசுனேன் எப்படி போச்சு நல்லா பேசுனாங்க அப்புறமா சடனாக நார்மல் நல்லாதான் ம் எதுவும் பார்த்தீங்கன்னா அவங்கள பற்றி சொன்னாங்க என்னை பற்றி கேட்டாங்க ஸ்னானா நார்மலாக சப்போர்ட்ஸ்",
