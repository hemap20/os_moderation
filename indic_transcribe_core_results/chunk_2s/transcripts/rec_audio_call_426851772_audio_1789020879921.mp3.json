    {
      "t": "02:08",
      "text": "समझा"
    },
    {
      "t": "02:10",
      "text": "नॉर्मल"
    },
    {
      "t": "02:12",
      "text": "और आप मैं तो हार्ड बात कर रहा हूँ"
