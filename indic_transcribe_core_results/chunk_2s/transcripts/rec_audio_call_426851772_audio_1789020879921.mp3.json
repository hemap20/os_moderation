      "text": "हेलो"
    },
    {
      "t": "00:08",
      "text": "क्या हाल है"
    },
    {
      "t": "00:10",
      "text": "बढ़िया नहीं है"
    },
    {
      "t": "00:12",
      "text": "पाक के कारण"
    },
    {
      "t": "00:14",
      "text": "बढ़िया है कहाँ से हो"
    },
    {
      "t": "00:16",
      "text": "नहीं नहीं कुछ"
    },
    {
      "t": "00:18",
      "text": "कहाँ"
    },
    {
      "t": "00:20",
      "text": "बस"
    },
    {
      "t": "00:22",
      "text": "यू पी जॉब"
    },
    {
      "t": "00:24",
      "text": "ह्म्म"
    },
    {
      "t": "00:26",
      "text": "उत्तर प्रदेश यू पी से"
    },
    {
      "t": "00:28",
      "text": "जी"
    },
    {
      "t": "00:30",
      "text": "और क्या"
    },
    {
      "t": "00:32",
      "text": "उत्तर प्रदेश"
    },
    {
      "t": "00:34",
      "text": "प्रतिकूल उसमें कहाँ से आएगा"
    },
    {
      "t": "00:36",
      "text": "मैं सीता"
    },
    {
      "t": "00:38",
      "text": "कब"
    },
    {
      "t": "00:40",
      "text": "सोने हजरा सिंह"
    },
    {
      "t": "00:42",
      "text": "सीतापुर से"
    },
    {
      "t": "00:44",
      "text": "इतना नहीं बोलना रहेगा"
    },
    {
      "t": "00:46",
      "text": "जी"
    },
    {
      "t": "00:48",
      "text": "डायरेक्ट वो क्या है ना"
    },
    {
      "t": "00:50",
      "text": "अनमैरिड"
    },
    {
      "t": "00:52",
      "text": "छोड़ो"
    },
    {
      "t": "00:54",
      "text": "हम्म"
    },
    {
      "t": "00:56",
      "text": "करते करते"
    },
    {
      "t": "00:58",
      "text": "यही हो गए हैं थोड़े दिन दस बारह दिन"
    },
    {
      "t": "01:00",
      "text": "ठीक है"
    },
    {
      "t": "01:02",
      "text": "कितने एकदम मज़े हो रहे हैं"
    },
    {
      "t": "01:04",
      "text": "और क्या कहते हैं"
    },
    {
      "t": "01:06",
      "text": "और बढ़िया आप"
    },
    {
      "t": "01:08",
      "text": "कौन हो मैरिड और अनमैरिड"
    },
    {
      "t": "01:10",
      "text": "हाँ मैं भी बोल रही हूँ"
    },
    {
      "t": "01:12",
      "text": "क्या"
    },
    {
      "t": "01:14",
      "text": "आवाज़ तुम्हारी कैसी निकल रही है"
    },
    {
      "t": "01:16",
      "text": "पन्ना रेडी मैम"
    },
    {
      "t": "01:18",
      "text": "तुम क्यों बना रही हो"
    },
    {
      "t": "01:20",
      "text": "नहीं लड़की हो या लड़का हो यार"
    },
    {
      "t": "01:22",
      "text": "हे भगवान"
    },
    {
      "t": "01:24",
      "text": "वीडियो बार तड़कू देसी लग रही है क्या"
    },
    {
      "t": "01:26",
      "text": "क्या"
    },
    {
      "t": "01:28",
      "text": "मेरी आवाज़ लड़कों जैसी लगती है"
