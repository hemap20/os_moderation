    {
      "t": "01:32",
      "text": "भारी भारी लग रही है आपकी यार"
    },
    {
      "t": "01:34",
      "text": "हाँ मेरी आवाज़ है ही भारी"
    },
    {
      "t": "01:36",
      "text": "हम्म"
    },
    {
      "t": "01:38",
      "text": "मेरी आवाज़ भी ऐसी है भाई"
    },
    {
      "t": "01:40",
      "text": "हरी ओम के भाई"
    },
    {
      "t": "01:42",
      "text": "ठीक"
    },
    {
      "t": "01:44",
      "text": "और वो तो और"
    },
    {
      "t": "01:46",
      "text": "उसके बाद फिर"
    },
    {
      "t": "01:48",
      "text": "कैस कैसी बातें करती हो"
    },
    {
      "t": "01:50",
      "text": "ठीक है"
    },
    {
      "t": "01:52",
      "text": "जैसा भी कुछ है"
    },
    {
      "t": "01:54",
      "text": "जी"
    },
    {
      "t": "01:56",
      "text": "आप कैसे"
    },
    {
      "t": "01:58",
      "text": "अरे मत मतलब"
    },
    {
      "t": "02:00",
      "text": "नॉर्मल या हॉट बातें"
    },
    {
      "t": "02:02",
      "text": "गंदी भी करती हो कैसी करती हो यार"
    },
    {
      "t": "02:04",
      "text": "हाँ"
    },
    {
      "t": "02:06",
      "text": "मुझे नॉर्मल बातें तो"
