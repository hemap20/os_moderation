{
  "file_id": "rec_audio_call_425129217_audio_1788857364836.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 477.331,
  "processing_time_sec": 39.09773325920105,
  "segments": [
    {
      "t": "00:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "ஹலோ"
    },
    {
      "t": "00:04",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "00:06",
      "text": "ம் சாரிங்க மேம்"
    },
    {
      "t": "00:08",
      "text": "இது எங்கேருந்து பேசுகிறீங்க"
    },
    {
      "t": "00:10",
      "text": "சரிங்க ஆ கோயம்புத்தூர்"
    },
    {
      "t": "00:12",
      "text": "கோயம்புத்தூரா"
    },
    {
      "t": "00:14",
      "text": "ஆமாம் நீங்கள்"
    },
    {
      "t": "00:16",
      "text": "ஆ தோத்து பிடிங்க"
    },
    {
      "t": "00:18",
      "text": "சரி சரி சிங்கிளா மேரேடா"
    },
    {
      "t": "00:20",
      "text": "சிம்பிள் தாங்க"
    },
    {
      "t": "00:22",
      "text": "சரி சரி"
    },
    {
      "t": "00:24",
      "text": "ம் சப்ஜெக்ட் சார்"
    },
    {
      "t": "00:26",
      "text": "ம் சாப்பிட்டாச்சுங்க நீங்கள்"
    },
    {
      "t": "00:28",
      "text": "ம் சாப்பிட்டு பேர்"
    },
    {
      "t": "00:30",
      "text": "மதனுங்க"
    },
    {
      "t": "00:32",
      "text": "சரி சரி வயசு"
    },
    {
      "t": "00:34",
      "text": "இருபத்தி மூணு"
    },
    {
      "t": "00:36",
      "text": "இருபத்தி மூணா"
    },
    {
      "t": "00:38",
      "text": "ஆமாங்க"
    },
    {
      "t": "00:40",
      "text": "சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே சரி ஓகே"
    },
    {
      "t": "00:42",
      "text": "எனக்கு பர்த் சர்டிஃபிகேட்"
    },
    {
      "t": "00:44",
      "text": "ஐஸ்கிரீம் கம்மியாக இருந்தால்"
    },
    {
      "t": "00:46",
      "text": "ம் சரி சரி"
    },
    {
      "t": "00:48",
      "text": "ம்"
    },
    {
      "t": "00:50",
      "text": "சரி வாங்க"
    },
    {
      "t": "00:52",
      "text": "ஆமாம் சார்"
    },
    {
      "t": "00:54",
      "text": "சொல்லணும்"
    },
    {
      "t": "00:56",
      "text": "லாஸ்ட்"
    },
    {
      "t": "00:58",
      "text": "யார் வயசை கெட்டு வயசை கெட்டு கட் பண்ணிட்டு போயிடுறாங்க"
    },
    {
      "t": "01:00",
      "text": "போயிட்டேன்"
    },
    {
      "t": "01:02",
      "text": "ஐசக் எது கட் பண்ணிட்டு போயிடுறாங்களா"
    },
    {
      "t": "01:04",
      "text": "ஆமாம் கேட்க"
    },
    {
      "t": "01:06",
      "text": "தெரியல எதுக்கு"
    },
    {
      "t": "01:08",
      "text": "ம்ஹும் நீதான்"
    },
    {
      "t": "01:10",
      "text": "ரொம்ப சின்ன பையன்லாம் இந்த ஆப்பில் வந்தால் அவரை கண்டு"
    },
    {
      "t": "01:12",
      "text": "அப்படின்னு தானே போவாங்க"
    },
    {
      "t": "01:14",
      "text": "அதை நம்மளுக்கு"
    },
    {
      "t": "01:16",
      "text": "ஆ"
    },
    {
      "t": "01:18",
      "text": "அது என்னமோ உண்மைதாங்க"
    },
    {
      "t": "01:20",
      "text": "ம் ம்"
    },
    {
      "t": "01:22",
      "text": "சொல்லுங்க அவங்க எஸ்"
    },
    {
      "t": "01:24",
      "text": "ரைஸ் ஏற்ற இதாக தான் பேச முடியும்"
    },
    {
      "t": "01:26",
      "text": "உங்ககிட்ட பேச முடியாதுல்ல"
    },
    {
      "t": "01:28",
      "text": "ஏன் பேச முடியாது"
    },
    {
      "t": "01:30",
      "text": "பேசினா பேச தான் செய்ய போகிறோம்"
    },
    {
      "t": "01:32",
      "text": "ம்ஹும் பெருங்காயம்"
    },
    {
      "t": "01:34",
      "text": "இருக்குன்னு சொல்றீங்களா ஆமா"
    },
    {
      "t": "01:36",
      "text": "ம்"
    },
    {
      "t": "01:38",
      "text": "ம்"
    },
    {
      "t": "01:40",
      "text": "அதான் சட்டை"
    },
    {
      "t": "01:42",
      "text": "நான் யாரு டே"
    },
    {
      "t": "01:44",
      "text": "ரெண்டு குழந்தை இருக்குது எனக்கு வயசு முப்பது"
    },
    {
      "t": "01:46",
      "text": "ஓகே அது போதுமா"
    },
    {
      "t": "01:48",
      "text": "ஓகேங்க"
    },
    {
      "t": "01:50",
      "text": "ம் ம்"
    },
    {
      "t": "01:52",
      "text": "நீங்கள் என்னென்ன தாட்ஸ்"
    },
    {
      "t": "01:54",
      "text": "பண்ணுறீங்க ம்"
    },
    {
      "t": "01:56",
      "text": "நான் தனியாக இருக்கேன்னு யூஸ் பண்ணிக்கிறேன்"
    },
    {
      "t": "01:58",
      "text": "நீங்கள் எதுக்கு யூஸ் பண்ணுறீங்கன்னு கேட்டேன்"
    },
    {
      "t": "02:00",
      "text": "நான் சும்மா போர் அடிக்குதே"
    },
    {
      "t": "02:02",
      "text": "ம் காய்"
    },
    {
      "t": "02:04",
      "text": "பேசினா ஏதோ சும்மா"
    },
    {
      "t": "02:06",
      "text": "டைம் கிடைக்குமா பேசுனா"
    },
    {
      "t": "02:08",
      "text": "சரிங்க சரிங்க"
    },
    {
      "t": "02:10",
      "text": "ம்"
    },
    {
      "t": "02:12",
      "text": "ம்"
    },
    {
      "t": "02:14",
      "text": "நல்லா பேசுறாங்களா"
    },
    {
      "t": "02:16",
      "text": "ம் அதை தான் நல்லா பேசுவேன்"
    },
    {
      "t": "02:18",
      "text": "நான் போய் எனக்கு"
    },
    {
      "t": "02:20",
      "text": "பிடிக்கிறதில்ல பறிச்சின்னு இருக்கேன்"
    },
    {
      "t": "02:22",
      "text": "புரியல எனக்கு புத்தி"
    },
    {
      "t": "02:24",
      "text": "பிடிக்கிறதெல்லாம் கட் பண்ணிடுவேன் நார்மலாக பேசினா பேசுவேன்"
    },
    {
      "t": "02:26",
      "text": "எக்ஸ்ட்ரா பேஸ்னா கட் பண்ணிக்கலாம்"
    },
    {
      "t": "02:28",
      "text": "ஓ சரிங்க சரிங்க"
    },
    {
      "t": "02:30",
      "text": "உனக்கு எப்படி"
    },
    {
      "t": "02:32",
      "text": "டேக்ஸாக பேசணுமா"
    },
    {
      "t": "02:34",
      "text": "சார்"
    },
    {
      "t": "02:36",
      "text": "நான் இன்னும் நல்லா பேசினாலே போதும்"
    },
    {
      "t": "02:38",
      "text": "இன்னைக்கு"
    },
    {
      "t": "02:40",
      "text": "ம்"
    },
    {
      "t": "02:42",
      "text": "அலோவ் பண்ணிடு"
    },
    {
      "t": "02:44",
      "text": "ஐயோ அப்புறமா"
    },
    {
      "t": "02:46",
      "text": "ம்"
    },
    {
      "t": "02:48",
      "text": "சரிங்களா"
    },
    {
      "t": "02:50",
      "text": "ம்"
    },
    {
      "t": "02:52",
      "text": "சொல்லுவாங்க"
    },
    {
      "t": "02:54",
      "text": "ஃபுல்லாக பேசலாம்னு சொல்லிட்டு வந்தாங்க"
    },
    {
      "t": "02:56",
      "text": "ம்ஹும் சும்மா இருப்பாங்க"
    },
    {
      "t": "02:58",
      "text": "அப்படி ட்ரெஸ் எல்லாம் போட முடியாதா"
    },
    {
      "t": "03:00",
      "text": "என்னங்க"
    },
    {
      "t": "03:02",
      "text": "ரசம்லாம் போடாமல் வந்து பேசுறீங்க"
    },
    {
      "t": "03:04",
      "text": "சும்மா பேசுறீங்க"
    },
    {
      "t": "03:06",
      "text": "சரி"
    },
    {
      "t": "03:08",
      "text": "வேறு ஒன்றும் ஒன்றும் பிரச்சனை இல்லை"
    },
    {
      "t": "03:10",
      "text": "ம் ம்"
    },
    {
      "t": "03:12",
      "text": "ம்"
    },
    {
      "t": "03:14",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "03:16",
      "text": "பிராப்ளம் ஆயிடும்"
    },
    {
      "t": "03:18",
      "text": "ம் நல்லாதான் போயிட்டுருக்கு"
    },
    {
      "t": "03:20",
      "text": "சரிங்க சார்"
    },
    {
      "t": "03:22",
      "text": "ம் அப்புறம்"
    },
    {
      "t": "03:24",
      "text": "அப்புறம்"
    },
    {
      "t": "03:26",
      "text": "ம்"
    },
    {
      "t": "03:28",
      "text": "சரிங்க சார்"
    },
    {
      "t": "03:30",
      "text": "தரும் நோ"
    },
    {
      "t": "03:32",
      "text": "ம்"
    },
    {
      "t": "03:34",
      "text": "யார் வந்து இப்போதைக்கு உங்களுக்கு"
    },
    {
      "t": "03:36",
      "text": "அக்கா பேசலை நீங்கள் அவ்வளோங்க பேசலாம்"
    },
    {
      "t": "03:38",
      "text": "ஆமாம் நல்லா இருக்கு"
    },
    {
      "t": "03:40",
      "text": "ஓகே"
    },
    {
      "t": "03:42",
      "text": "புரியல"
    },
    {
      "t": "03:44",
      "text": "நீங்கள் நல்லா பேசுனவொடனே நல்லா இருக்கீங்க"
    },
    {
      "t": "03:46",
      "text": "நல்லா இருக்கா"
    },
    {
      "t": "03:48",
      "text": "ம் சரி சரி இப்படி"
    },
    {
      "t": "03:50",
      "text": "வரவங்க ஃபுல்லாக வீடியோ கால்"
    },
    {
      "t": "03:52",
      "text": "வரீங்களா வீடியோக்கள் வரீங்களான்னு கேட்டேன்"
    },
    {
      "t": "03:54",
      "text": "வீடே கண்ணா"
    },
    {
      "t": "03:56",
      "text": "அதான் பண்ணுங்க"
    },
    {
      "t": "03:58",
      "text": "அட்டன் பண்ணுங்களா நீங்கள்"
    },
    {
      "t": "04:00",
      "text": "நீங்கள் தான் கொடுக்கணும் நான் அட்டன் பண்ணுறேன்"
    },
    {
      "t": "04:02",
      "text": "இதில் வீடியோக்கள் வரலாம்ல"
    },
    {
      "t": "04:04",
      "text": "ஓ"
    },
    {
      "t": "04:06",
      "text": "போவாங்க ஆ அப்புறம் என்ன"
    },
    {
      "t": "04:08",
      "text": "அ"
    },
    {
      "t": "04:10",
      "text": "ம்"
    },
    {
      "t": "04:12",
      "text": "ஓ சீக்கிரம்"
    },
    {
      "t": "04:14",
      "text": "ஓகே"
    },
    {
      "t": "04:16",
      "text": "சீக்கிரத்துக்கு வந்தேன்ல சும்மா தாங்க"
    },
    {
      "t": "04:18",
      "text": "ம் ம் அம்பர்"
    },
    {
      "t": "04:20",
      "text": "சரிம்மா"
    },
    {
      "t": "04:22",
      "text": "இல்லை இல்லை அப்புறம்"
    },
    {
      "t": "04:24",
      "text": "சரி வீடியோக்கள் நீங்கிதானே வீடியோக்கள் வரீங்களா"
    },
    {
      "t": "04:26",
      "text": "கேட்கிறேன் சரி அட்டன் பண்ணுங்கிறேன்"
    },
    {
      "t": "04:28",
      "text": "நீ கூப்பிடுங்கண்ணே அட்டன் பண்ணுறேன்"
    },
    {
      "t": "04:30",
      "text": "அப்புறம் யோசிக்கிறேன்ல"
    },
    {
      "t": "04:32",
      "text": "ஓகே"
    },
    {
      "t": "04:34",
      "text": "ம்"
    },
    {
      "t": "04:36",
      "text": "சொல்லு"
    },
    {
      "t": "04:38",
      "text": "சொல்லுங்கள் சொல்லுங்கள்"
    },
    {
      "t": "04:40",
      "text": "தம்பி சொன்னா கேட்கலாம்ல"
    },
    {
      "t": "04:42",
      "text": "ம்"
    },
    {
      "t": "04:44",
      "text": "எஃப்"
    },
    {
      "t": "04:46",
      "text": "கேட்கலாங்க என்ன அனல்ட்டிஸ்"
    },
    {
      "t": "04:48",
      "text": "ஒன்றும் இல்லை"
    },
    {
      "t": "04:50",
      "text": "ம் இப்போ சொல்லு"
    },
    {
      "t": "04:52",
      "text": "ஆ"
    },
    {
      "t": "04:54",
      "text": "சொல்லுங்கள் சொல்லுங்கள் ஆ"
    },
    {
      "t": "04:56",
