  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "ഹലോ"
    },
    {
      "t": "00:04",
      "text": "എവിടുന്നാ"
    },
    {
      "t": "00:06",
      "text": "ഞാൻ ട്രിവാൻഡ്രമാണ്"
    },
    {
      "t": "00:08",
      "text": "ഇവിടെ"
    },
    {
      "t": "00:10",
      "text": "വരില്ല"
    },
    {
      "t": "00:12",
      "text": "എനിക്ക് എന്ത് ചെയ്യണം"
    },
    {
      "t": "00:14",
      "text": "ഞാൻ ഒത്തിരി"
    },
    {
      "t": "00:16",
      "text": "ഊറ്റി വർക്ക് ചെയ്യുകയും ഉണ്ടായിരുന്നു"
    },
    {
      "t": "00:18",
      "text": "ഒന്നും ചെയ്യുന്നില്ല"
    },
    {
      "t": "00:20",
      "text": "ഓക്കേ ഒരുങ്ങിയൊക്കെയാണല്ലോ"
    },
    {
      "t": "00:22",
      "text": "രാത്രി ഉറക്കമില്ലേ"
    },
    {
      "t": "00:24",
      "text": "ഞാൻ ആവിരേനെ പറ്റിയ"
    },
    {
      "t": "00:26",
      "text": "ഇത് ഞാൻ ഇന്നലെ രാവിലെ"
    },
    {
      "t": "00:28",
      "text": "സോറി ഇന്നലെ നൈറ്റ്"
    },
    {
      "t": "00:30",
      "text": "ഇനി ഏത്"
    },
    {
      "t": "00:32",
      "text": "ആ"
    },
    {
      "t": "00:34",
      "text": "ഇല്ല എന്താ പരിപാടി ഉറങ്ങാതിരുന്നു"
    },
    {
      "t": "00:36",
      "text": "എനിക്ക് രാവിലെ കുറച്ച് പൈസ"
    },
    {
      "t": "00:38",
      "text": "സെവൻ ഓട്ടോ"
    },
    {
      "t": "00:40",
      "text": "ആണോ"
    },
    {
      "t": "00:42",
      "text": "അത് നെക്സ്റ്റ് ടൈം"
    },
    {
      "t": "00:44",
      "text": "അതിലിരിക്കുകയാണ്"
    },
    {
      "t": "00:46",
      "text": "ഉണ്ട് ഓപ്പൺ ടോക്ക് ഉണ്ട് വാഷ്"
    },
    {
      "t": "00:48",
      "text": "വാട്സപ്പിലാണ് പെയ്ഡ് സർവീസാണ്"
    },
    {
      "t": "00:50",
      "text": "അതെന്താണെന്നു പറഞ്ഞു കഴിഞ്ഞാൽ"
    },
    {
      "t": "00:52",
      "text": "ഇതിൽ നിന്ന് അഞ്ച് രൂപ വെച്ച്"
    },
    {
      "t": "00:54",
      "text": "തിരിച്ച് കിട്ടുന്നുണ്ട് നമുക്ക് ഒരു മിനിറ്റിന്"
    },
    {
      "t": "00:56",
      "text": "സോ ഫ്രീ ആയിട്ട് ചെയ്യേണ്ട കാര്യം"
    },
    {
      "t": "00:58",
      "text": "നമുക്ക് ഇല്ലല്ലോ"
    },
    {
      "t": "01:00",
      "text": "ഉണ്ടല്ലോ"
    },
    {
      "t": "01:02",
      "text": "ഇവിടെ കെട്ടുന്നുണ്ടെങ്കിൽ"
    },
    {
      "t": "01:04",
      "text": "യുവർ ചോയ്സ് ഞാൻ പറഞ്ഞെന്നേ ഉള്ളൂ"
    },
    {
      "t": "01:06",
      "text": "ഇല്ല ഞാൻ ചെയ്യുന്നെങ്കിൽ ഞാൻ വാട്സപ്പിൽ"
    },
    {
      "t": "01:08",
      "text": "ചെയ്യാറുള്ളൂ എനിക്ക് സേഫ്റ്റി ഇഷ്യൂസ്"
    },
    {
      "t": "01:10",
      "text": "കാരണം എടിയാണ്"
    },
    {
      "t": "01:12",
      "text": "മ്മ്"
    },
    {
      "t": "01:14",
      "text": "ഓക്കെ"
    },
    {
      "t": "01:16",
      "text": "കേട്ടു"
    },
    {
      "t": "01:18",
      "text": "ബൈ ബൈ വേറെ നോക്കിക്കോ"
    },
    {
      "t": "01:20",
      "text": "ഉം"
    }
  ],
  "full_text": "ആ ഹലോ എവിടുന്നാ ഞാൻ ട്രിവാൻഡ്രമാണ് ഇവിടെ വരില്ല എനിക്ക് എന്ത് ചെയ്യണം ഞാൻ ഒത്തിരി ഊറ്റി വർക്ക് ചെയ്യുകയും ഉണ്ടായിരുന്നു ഒന്നും ചെയ്യുന്നില്ല ഓക്കേ ഒരുങ്ങിയൊക്കെയാണല്ലോ രാത്രി ഉറക്കമില്ലേ ഞാൻ ആവിരേനെ പറ്റിയ ഇത് ഞാൻ ഇന്നലെ രാവിലെ സോറി ഇന്നലെ നൈറ്റ് ഇനി ഏത് ആ ഇല്ല എന്താ പരിപാടി ഉറങ്ങാതിരുന്നു എനിക്ക് രാവിലെ കുറച്ച് പൈസ സെവൻ ഓട്ടോ ആണോ അത് നെക്സ്റ്റ് ടൈം അതിലിരിക്കുകയാണ് ഉണ്ട് ഓപ്പൺ ടോക്ക് ഉണ്ട് വാഷ് വാട്സപ്പിലാണ് പെയ്ഡ് സർവീസാണ് അതെന്താണെന്നു പറഞ്ഞു കഴിഞ്ഞാൽ ഇതിൽ നിന്ന് അഞ്ച് രൂപ വെച്ച് തിരിച്ച് കിട്ടുന്നുണ്ട് നമുക്ക് ഒരു മിനിറ്റിന് സോ ഫ്രീ ആയിട്ട് ചെയ്യേണ്ട കാര്യം നമുക്ക് ഇല്ലല്ലോ ഉണ്ടല്ലോ ഇവിടെ കെട്ടുന്നുണ്ടെങ്കിൽ യുവർ ചോയ്സ് ഞാൻ പറഞ്ഞെന്നേ ഉള്ളൂ ഇല്ല ഞാൻ ചെയ്യുന്നെങ്കിൽ ഞാൻ വാട്സപ്പിൽ ചെയ്യാറുള്ളൂ എനിക്ക് സേഫ്റ്റി ഇഷ്യൂസ് കാരണം എടിയാണ് മ്മ് ഓക്കെ കേട്ടു ബൈ ബൈ വേറെ നോക്കിക്കോ ഉം",
