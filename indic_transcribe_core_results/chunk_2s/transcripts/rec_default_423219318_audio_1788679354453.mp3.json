  "audio_duration_sec": 507.334,
  "processing_time_sec": 1904.2733323574066,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ"
    },
    {
      "t": "00:02",
      "text": "ഓക്കെ"
    },
    {
      "t": "00:04",
      "text": "ഉം"
    },
    {
      "t": "00:06",
      "text": "ആ"
    },
    {
      "t": "00:08",
      "text": "ഓക്കെ"
    },
    {
      "t": "00:10",
      "text": "ഇതിലോട്ട് വരെ നമുക്ക്"
    },
    {
      "t": "00:12",
      "text": "ഹലോ"
    },
    {
      "t": "00:14",
      "text": "പിന്നെ"
    },
    {
      "t": "00:16",
      "text": "ആ"
    },
    {
      "t": "00:18",
      "text": "നെക്സ്റ്റ് ഡേ സെവൻ"
    },
    {
      "t": "00:20",
      "text": "ഞാൻ കുഴപ്പമില്ല"
    },
    {
      "t": "00:22",
      "text": "അതെ"
    },
    {
      "t": "00:24",
      "text": "വർക്ക് ചെയ്യുന്നു"
    },
    {
      "t": "00:26",
      "text": "എവിടെയാണ്"
    },
    {
      "t": "00:28",
      "text": "ഹലോ ഞാൻ ദുബായിലാണ്"
    },
    {
      "t": "00:30",
      "text": "ദുബായ്"
    },
    {
      "t": "00:32",
      "text": "ആ"
    },
    {
      "t": "00:34",
      "text": "നിങ്ങൾ പഠിക്കുക"
    },
    {
      "t": "00:36",
      "text": "ആംസ്ട്രോയിങ്"
    },
    {
      "t": "00:38",
      "text": "ഹൗസ് വൈഫാ"
    },
    {
      "t": "00:40",
      "text": "കണ്ടപ്പറയലുകളോ"
    },
    {
      "t": "00:42",
      "text": "ബുദ്ധിമുട്ടുള്ള ആ പ്രശ്നം"
    },
    {
      "t": "00:44",
      "text": "ആ"
    },
    {
      "t": "00:46",
      "text": "ഇയേഴ്സ് വല്ല സെക്കൻഡ് ഇയറോ ഫസ്റ്റ്"
    },
    {
      "t": "00:48",
      "text": "ഫസ്റ്റ് ഇയറും"
    },
    {
      "t": "00:50",
      "text": "ഇനി അത് നൂറ് രൂപയായിട്ട് കിട്ടും"
    },
    {
      "t": "00:52",
      "text": "ആ"
    },
    {
      "t": "00:54",
      "text": "കുട്ടിയുണ്ട്"
    },
    {
      "t": "00:56",
      "text": "നോ വേ"
    },
    {
      "t": "00:58",
      "text": "ആ"
    },
    {
      "t": "01:00",
      "text": "ശരിക്കും"
    },
    {
      "t": "01:02",
      "text": "എത്ര വയസ്സിൽ"
    },
    {
      "t": "01:04",
      "text": "ഒത്തിരി"
    },
    {
      "t": "01:06",
      "text": "ചെയ്യുന്നുണ്ട് ഒരു വയസ്സാണെന്ന് തോന്നുന്നു"
    },
    {
      "t": "01:08",
      "text": "ബട്ട് കം"
    },
    {
      "t": "01:10",
      "text": "എന്താ പറയൂലല്ലോ"
    },
    {
      "t": "01:12",
      "text": "ആയിരത്തി അഞ്ഞൂറ് മുന്നൂറ്"
    },
    {
      "t": "01:14",
      "text": "വിട്ടാരെ വേമ്പിടിച്ച് കെട്ടിച്ചു"
    },
    {
      "t": "01:16",
      "text": "ശരിയാണ്"
    },
    {
      "t": "01:18",
      "text": "ഏ"
    },
    {
      "t": "01:20",
      "text": "ഞാനായിട്ട് കണ്ടുപിടിച്ചു"
    },
    {
      "t": "01:22",
      "text": "നീയായിട്ട്"
    },
    {
      "t": "01:24",
      "text": "ലവ് മാരേജാ"
    },
    {
      "t": "01:26",
      "text": "ആ"
    },
    {
      "t": "01:28",
      "text": "ഓ പനീർ"
    },
    {
      "t": "01:30",
      "text": "എത്ര വയസ്സായി"
    },
    {
      "t": "01:32",
      "text": "ട്വന്റി ഫൈവ്"
    },
    {
      "t": "01:34",
      "text": "ഇഫ് ഐ അതും പറയും"
    },
    {
      "t": "01:36",
      "text": "യു ലുക്ക് ലൈക്ക് ട്വന്റി"
    },
    {
      "t": "01:38",
      "text": "ട്വന്റി ട്വന്റി ത്രീ"
    },
    {
      "t": "01:40",
      "text": "ശരി ശരി"
    },
    {
      "t": "01:42",
      "text": "ഓക്കേ"
    },
    {
      "t": "01:44",
      "text": "നിങ്ങളെ"
    },
    {
      "t": "01:46",
      "text": "എന്തായാലും"
    },
    {
      "t": "01:48",
      "text": "ഞെട്ടലായി"
    },
    {
      "t": "01:50",
      "text": "വീട്ടിൽ"
    },
    {
      "t": "01:52",
      "text": "ഒരുപാട് പേര് നിൽക്കാറുണ്ട്"
    },
    {
      "t": "01:54",
      "text": "ചിലവ് എന്താണ് കുറ്റം ചിലവ്"
    },
    {
      "t": "01:56",
      "text": "ആ"
    },
    {
      "t": "01:58",
      "text": "ഞാൻ പിന്നെ ഉറങ്ങി എണീച്ചിട്ട്"
    },
    {
      "t": "02:00",
      "text": "വീഡിയോ ഇതെല്ലാം"
    },
    {
      "t": "02:02",
      "text": "ബാക്കി ഇപ്പം എനിക്ക് തോന്നുന്നു രണ്ട്"
    },
    {
      "t": "02:04",
      "text": "എന്താ ചെയ്യേണ്ടത് എക്സ്പ്രഷൻ"
    },
    {
      "t": "02:06",
      "text": "ഓ അത് ശരിയല്ലേ"
    },
    {
      "t": "02:08",
      "text": "നീ ഇത് പറഞ്ഞപ്പോൾ എക്സ്പ്രഷൻ കാണാൻ പറ്റും"
    },
    {
      "t": "02:10",
      "text": "ഇല്ലല്ലോ അത്"
    },
    {
      "t": "02:12",
      "text": "ചിലര് നെറ്റ് ചന്തം ഇട്ട് കണ്ണ്"
    },
    {
      "t": "02:14",
      "text": "ഇംഗ്ലീഷ്"
    },
    {
      "t": "02:16",
      "text": "സത്യം ആവേശം"
    },
    {
      "t": "02:18",
      "text": "ഏതോ സ്കൂളിൽ പഠിക്കുന്ന"
    },
    {
      "t": "02:20",
      "text": "കോളേജിൽ പഠിക്കുന്ന കുട്ടികളാണ്"
    },
    {
      "t": "02:22",
      "text": "ആ"
    },
    {
      "t": "02:24",
      "text": "പിന്നെ"
    },
    {
      "t": "02:26",
      "text": "പിന്നെ പിന്നെ എണീറ്റ് കറക്റ്റ്"
    },
    {
      "t": "02:28",
      "text": "ബട്ടൺ ഒക്കെ തുറക്കാൻ വേണ്ടി ആയിട്ടാണ്"
    },
    {
      "t": "02:30",
      "text": "എപ്പിസോഡിങ്ങിന് ക്യാമറ ഓൺ ആക്കിയത് എനിക്കാണ്"
    },
    {
      "t": "02:32",
      "text": "ഭയങ്കര എഴുത്തിന്"
    },
    {
      "t": "02:34",
      "text": "തടസ്സം എടുത്തൊരു പരിപാടിയാണ്"
    },
    {
      "t": "02:36",
      "text": "ആ ആ"
    },
    {
      "t": "02:38",
      "text": "ലെറ്റ് ബിഗിൻ"
    },
    {
      "t": "02:40",
      "text": "ഓൺ ദിസ് ലൈറ്റ്"
    },
    {
      "t": "02:42",
      "text": "ഉദാഹരണം"
    },
    {
      "t": "02:44",
      "text": "ഉണ്ടോ"
    },
    {
      "t": "02:46",
      "text": "ഇതിൻ്റെ മുഖം കാണുന്നില്ല"
    },
    {
      "t": "02:48",
      "text": "കൊള്ളാം"
    },
    {
      "t": "02:50",
      "text": "അഞ്ചാം മുഖത്തോട്"
    },
    {
      "t": "02:52",
      "text": "പോയിട്ട് വ്യക്തമല്ലേ ക്യാമറ കറക്റ്റ്"
    },
    {
      "t": "02:54",
      "text": "ആ"
    },
    {
      "t": "02:56",
      "text": "ഇപ്പോളോ"
    },
    {
      "t": "02:58",
      "text": "എടുത്തു കാണിക്കാം"
    },
    {
      "t": "03:00",
      "text": "എനിക്ക്"
    },
    {
      "t": "03:02",
      "text": "അതോ കുറഞ്ഞു നിൽക്കുകയാണ്"
    },
    {
      "t": "03:04",
      "text": "അതിൻ്റെ ക്ഷീണം എനിക്കുണ്ട് പിന്നെ ക്യാമറ"
    },
    {
      "t": "03:06",
      "text": "അപ്പം വലിയ സൺഡേ ഇല്ല അപ്പം നല്ല"
    },
    {
      "t": "03:08",
      "text": "ഞാൻ"
    },
    {
      "t": "03:10",
      "text": "ഇല്ല ഞാൻ ഉറങ്ങിയത് ആറ് മണിക്കാണ്"
    },
    {
      "t": "03:12",
      "text": "ആ"
    },
    {
      "t": "03:14",
      "text": "ആറ് ആറരക്ക് മൂവി"
    },
    {
      "t": "03:16",
      "text": "എനിക്ക് പോയി വന്ന്"
    },
    {
      "t": "03:18",
      "text": "പിന്നെ ഫോണും നോക്കി കിടന്നു"
    },
    {
      "t": "03:20",
      "text": "ഓറങ്ങുമ്പോഴത്തേക്കും കട്ടയും"
    },
    {
      "t": "03:22",
      "text": "പിന്നെ"
    },
    {
      "t": "03:24",
      "text": "ഞങ്ങൾ ഇറങ്ങിപ്പോയി"
    },
    {
      "t": "03:26",
      "text": "ഉം ഉം ഉം"
    },
    {
      "t": "03:28",
      "text": "പണിപ്പെടുത്തി തരുവാണല്ലോ"
    },
    {
      "t": "03:30",
      "text": "ആ പിടിപ്പിക്കാറ്"
    },
    {
      "t": "03:32",
      "text": "സ്നാപ്പ്"
    },
    {
      "t": "03:34",
      "text": "ആപ്പ് എടുത്തിട്ട്"
    },
    {
      "t": "03:36",
      "text": "ചെറുപ്പക്കാരനായിരുന്നു"
    },
    {
      "t": "03:38",
      "text": "ആപ്പ് എടുത്തിട്ട് ആക്ച്വലി ഞാൻ"
    },
    {
      "t": "03:40",
      "text": "ടു വീക്സ് ടു വീക്സ്"
    },
    {
      "t": "03:42",
      "text": "ഇതല്ല കഴിഞ്ഞ മാസം"
    },
    {
      "t": "03:44",
      "text": "നാട്ടിലൊന്നിന്"
    },
    {
      "t": "03:46",
      "text": "പണ്ടോ ഉണ്ടാക്കി"
    },
    {
      "t": "03:48",
      "text": "യൂസ് ചെയ്ത് വെക്കിയിരുന്നു പിന്നെ"
    },
    {
      "t": "03:50",
      "text": "നല്ല ചിലവാണെന്ന് കണ്ടപ്പോൾ ഞാൻ ഡിലീറ്റായി"
    },
    {
      "t": "03:52",
      "text": "പിന്നെ"
    },
    {
      "t": "03:54",
      "text": "ഇന്ന് രാവിലെ ഒന്ന് ഡൗൺലോഡ് ആക്കുക"
    },
    {
      "t": "03:56",
      "text": "ബാക്കിയൊക്കെ ബോറടിച്ച്"
    },
    {
      "t": "03:58",
      "text": "ആ ആ"
    },
    {
      "t": "04:00",
      "text": "ഇതെങ്ങനെ ഉണ്ട് യൂസ് ചെയ്തിട്ട്"
    },
    {
      "t": "04:02",
      "text": "ചിലവ് കൂടുതലാണ്"
    },
    {
      "t": "04:04",
      "text": "ഏയ് കൺപ്ലീറ്റ് കൂടുതലല്ലേ"
    },
    {
      "t": "04:06",
      "text": "ഇടയ്ക്ക് നമ്മൾ നല്ല ആൾക്കാരെ കിട്ടി"
    },
    {
      "t": "04:08",
      "text": "ഇങ്ങനെ സംസാരിക്കുമ്പോഴായിരിക്കും നമ്മൾ മിനിറ്റ്സ്"
    },
    {
      "t": "04:10",
      "text": "ചെയ്യുക അപ്പം പെട്ടെന്ന്"
    },
    {
      "t": "04:12",
      "text": "അടുത്തറിയുകയും"
    },
    {
      "t": "04:14",
      "text": "ആയിക്കോട്ടെ"
    },
    {
      "t": "04:16",
      "text": "ഇതെങ്ങനെ റീചാർജ് ചെയ്യാം"
    },
    {
      "t": "04:18",
      "text": "നല്ല എസ്പെഷ്യലി വീഡിയോ കോളിന് നല്ല"
    },
    {
      "t": "04:20",
      "text": "പൈസ കിട്ടും പോയിൻസ്"
    },
    {
      "t": "04:22",
      "text": "നല്ല രീതിയിലാണ്"
    },
    {
      "t": "04:24",
      "text": "മൂന്നാമത്തെതുണ്ട്"
    },
    {
      "t": "04:26",
      "text": "വേഗം ഡിലീറ്റ് ആക്കി"
    },
    {
      "t": "04:28",
      "text": "ഓക്കേ"
    },
    {
      "t": "04:30",
      "text": "പിന്നെ"
    },
    {
      "t": "04:32",
      "text": "ഓക്കെ"
    },
    {
      "t": "04:34",
      "text": "ഉം കൊണ്ടുപോകാൻ പറ്റും"
    },
    {
      "t": "04:36",
      "text": "എണീറ്റ്"
    },
    {
      "t": "04:38",
      "text": "കറക്റ്റ്"
    },
    {
      "t": "04:40",
      "text": "സെവൻ"
    },
    {
      "t": "04:42",
      "text": "ലെവൻ ട്വൻറ്റി സെവൻ"
    },
    {
      "t": "04:44",
      "text": "പതിനൊന്ന് ഇരുപത്തിയേഴ്"
    },
    {
      "t": "04:46",
      "text": "ആ"
    },
    {
      "t": "04:48",
      "text": "പതിനൊന്നാം മണി മുതൽ"
    },
    {
      "t": "04:50",
      "text": "പതിനൊന്നരയാവാൻ പോകുന്നു"
    },
    {
      "t": "04:52",
      "text": "കറക്റ്റ് അഭിനന്ദനം"
    },
    {
      "t": "04:54",
      "text": "എറവാം പൂ"
    },
    {
      "t": "04:56",
      "text": "അല്ല എൻ്റെ പാ"
    },
    {
      "t": "04:58",
      "text": "അവിടെ പുറത്ത് പോകണം എന്ന് പറഞ്ഞു"
    },
    {
      "t": "05:00",
      "text": "ആ ശരി"
    },
    {
      "t": "05:02",
      "text": "എൻ്റെ മൂച്ചി പുറത്ത് പോകണം എന്ന് പറഞ്ഞു"
    },
    {
      "t": "05:04",
      "text": "ഉപ്പ വരും കൊണ്ടുപോകാനായിട്ട് ഉപ്പ വരും"
    },
    {
      "t": "05:06",
      "text": "വരുമെന്ന് പറഞ്ഞു"
    },
    {
      "t": "05:08",
      "text": "ആള് ദുബായില്"
    },
    {
      "t": "05:10",
      "text": "ആ ഓക്കെ ഓക്കെ ഓക്കെ"
    },
    {
      "t": "05:12",
      "text": "ഓക്കേ അങ്ങനെ"
    },
    {
      "t": "05:14",
      "text": "ഇപ്പം ജോലി ചെയ്യുന്നിടത്തുനിന്ന് കുപ്പ വരും"
    },
    {
      "t": "05:16",
      "text": "കൊണ്ടുവരണം"
    },
    {
      "t": "05:18",
      "text": "പത്ത് മണിയാവുമ്പോൾ വരുമെന്നാണ് ഇതുവരെ"
    },
    {
      "t": "05:20",
      "text": "പിന്നെ ചെന്ന് അതോ അങ്ങനെ"
    },
    {
      "t": "05:22",
      "text": "ആയി"
    },
    {
      "t": "05:24",
      "text": "ഞാൻ റെഡിയായിട്ടൊന്നും ഇട്ടതല്ല"
    },
    {
      "t": "05:26",
      "text": "നാളെ ദുബായിൽ നിന്ന് വരണ്ടേ"
    },
    {
      "t": "05:28",
      "text": "ഉഫ് അങ്ങനെ"
    },
    {
      "t": "05:30",
      "text": "ദുബായ് എന്നു പറഞ്ഞാൽ"
    },
    {
      "t": "05:32",
      "text": "ഹായ് ആ"
    },
    {
      "t": "05:34",
      "text": "അവര് ദുബായിലാണ് അവര് പോയി"
    },
    {
      "t": "05:36",
      "text": "പുറത്ത് പോകണം എന്ന് പറഞ്ഞു"
    },
    {
      "t": "05:38",
      "text": "അവര് അവിടുന്ന് നീ"
    },
    {
      "t": "05:40",
      "text": "നീ ഇവിടുന്ന് പോകുന്നത് നല്ലതല്ലേ ഓ"
    },
    {
      "t": "05:42",
      "text": "ഏയ് ഞാനിവിടെ നിൽക്കൂ ഞാൻ"
    },
    {
      "t": "05:44",
      "text": "ഞാൻ ഇവിടുന്ന് നാളെ ആയി തൊട്ടോളാം പുറത്തോട്ട്"
    },
    {
      "t": "05:46",
      "text": "ഒന്നും അവിടെ ഇറങ്ങത്തില്ല"
    },
    {
      "t": "05:48",
      "text": "ഓക്കെ ഓക്കെ ഓക്കെ"
    },
    {
      "t": "05:50",
      "text": "എന്നിട്ട് ബേബിനെ ഉറക്കിയിട്ട്"
    },
    {
      "t": "05:52",
      "text": "കുറച്ച് യുവർ ടൈം സ്പെൻഡ് ചെയ്യാം അല്ലേ"
    },
    {
      "t": "05:54",
      "text": "കുറച്ച്"
    },
    {
      "t": "05:56",
      "text": "ദൈവം ചെയ്ത ഇങ്ങനെ ആരെങ്കിലും വെച്ചോ"
    },
    {
      "t": "05:58",
      "text": "കിട്ടുന്നതേയുള്ളൂ"
    },
    {
      "t": "06:00",
      "text": "അങ്ങനെ"
    },
    {
      "t": "06:02",
      "text": "അങ്ങനെ ചെയ്തു"
    },
    {
      "t": "06:04",
      "text": "ആ"
    },
    {
      "t": "06:06",
      "text": "ആ"
    },
    {
      "t": "06:08",
      "text": "പിന്നെ ഇത് കുറേ യൂസ്ഫുൾ ആയിട്ടുള്ള ഒരു സൈഡിൽ നിന്ന് കുറേ"
    },
    {
      "t": "06:10",
      "text": "സ്നാപ്പ്"
    },
    {
      "t": "06:12",
      "text": "ഞാൻ എടുത്തിട്ടിട്ട് വൺ ഇയർ ആണ്"
    },
    {
      "t": "06:14",
      "text": "എൺപത് പോയിന്റ് ഏഴ്"
    },
    {
      "t": "06:16",
      "text": "അങ്ങനെ അത് എടുത്തിട്ട്"
    },
    {
      "t": "06:18",
      "text": "ഇപ്പോൾ ടു വീക്സ് ആയിട്ടാണ് എടുക്കുക അല്ലേ"
    },
    {
      "t": "06:20",
      "text": "ശരിയാണ് ഡെലിവറി"
    },
    {
      "t": "06:22",
      "text": "ഒരു ടൈം എടുക്കും"
    },
    {
      "t": "06:24",
      "text": "രണ്ട് മൂന്ന് കോഴ്സ് എടുത്തു പിന്നെ"
    },
    {
      "t": "06:26",
      "text": "ഞാൻ ഏകദേശം നിന്നെ മറന്നേ പോയി"
    },
    {
      "t": "06:28",
      "text": "പിന്നെ ഞാൻ ഇങ്ങനെ ഫോൺ എടുത്ത് നോക്കിയിട്ട്"
    },
    {
      "t": "06:30",
      "text": "ഹൈഡിൽ ഞാൻ നോക്കി വെക്കും"
    },
    {
      "t": "06:32",
      "text": "ഇല്ല ഇല്ല"
    },
    {
      "t": "06:34",
      "text": "അങ്ങനെ"
    },
    {
      "t": "06:36",
      "text": "എങ്ങനെയുണ്ട് യൂസ് ചെയ്തിട്ട്"
    },
    {
      "t": "06:38",
      "text": "ഇല്ല അതെല്ലാം"
    },
    {
      "t": "06:40",
      "text": "ആൾക്കാരും ഉണ്ട്"
    },
    {
      "t": "06:42",
      "text": "അതാണ്"
    },
    {
      "t": "06:44",
      "text": "ചീത്ത വിളിക്കുന്ന ആൾക്കാരുണ്ട് ചീത്ത വിളിക്കുന്ന ആൾക്കാരുണ്ട്"
    },
    {
      "t": "06:46",
      "text": "കളിയാക്കുന്ന ആൾക്കാരുണ്ട് കളിയാക്കുന്ന ആൾക്കാരുണ്ട്"
    },
    {
      "t": "06:48",
      "text": "ആൾക്കാരുണ്ട് കളി ആക്കാത്ത ആൾക്കാരുണ്ട്"
    },
    {
      "t": "06:50",
      "text": "പിന്നെ പഞ്ചാര അടിക്കാൻ വരുന്നവര്"
    },
    {
      "t": "06:52",
      "text": "എന്നിട്ട് പിന്നെ മറ്റേതിൽ വരുന്ന ആൾക്കാരുടെ"
    },
    {
      "t": "06:54",
      "text": "എല്ലാ തരം ആൾക്കാരും ഓപ്പൺ ടോക്സ്"
    },
    {
      "t": "06:56",
      "text": "സാറിൻ്റെ ഇവൻസ് പോയി കെല്ലാനൊക്കെ"
    },
    {
      "t": "06:58",
      "text": "അയ്യേ ആദരാഞ്ജലി"
    },
    {
      "t": "07:00",
      "text": "കൂടുതൽ തന്നെ ഇല്ല എന്ന് പറഞ്ഞാൽ മറ്റേ"
    },
    {
      "t": "07:02",
      "text": "നോൺ ആൻഡ് വെജിറ്റേറിയൻ കട്ട് ചെയ്തിട്ടുണ്ട്"
    },
    {
      "t": "07:04",
      "text": "അതുകൊണ്ടല്ലേ"
    },
    {
      "t": "07:06",
      "text": "ഇല്ലാന്ന് പറഞ്ഞാൽ"
    },
    {
      "t": "07:08",
      "text": "അപ്പോഴൊരു ചീട്ട് വിളിക്കാൻ വെച്ചിട്ട് പോവുക"
    },
    {
      "t": "07:10",
      "text": "അത് തന്നെ പരിപാടി ബെസ്റ്റ്"
    },
    {
      "t": "07:12",
      "text": "ഉം ഉം ഉം ഉം"
    },
    {
      "t": "07:14",
      "text": "എല്ലാം ഉണ്ട് ഇതിനകത്ത് എല്ലാം ഉണ്ട്"
    },
    {
      "t": "07:16",
      "text": "അതാണ് ഒന്നും ഇല്ല"
    },
    {
      "t": "07:18",
      "text": "ഞാനായിട്ട് എന്താ ചെയ്തത്"
    },
    {
      "t": "07:20",
      "text": "അതേപോലെ ഒരു"
    },
    {
      "t": "07:22",
      "text": "ഇല്ല അത് വോയിസ് കോളിലായിരുന്നു"
    },
    {
      "t": "07:24",
      "text": "എടുത്ത പാഠം"
    },
    {
      "t": "07:26",
      "text": "പിന്നെ ഫുള്ള് അല്ല വോയിസ്"
    },
    {
      "t": "07:28",
      "text": "കോളല്ല വീട്ടിൽ കോള് പക്ഷേ"
    },
    {
      "t": "07:30",
      "text": "സൗണ്ട് മാത്രമേ ഉള്ളു"
    },
    {
      "t": "07:32",
      "text": "ഫുള്ള് എടുത്തപ്പോൾ തന്നെ തുടങ്ങിയത്"
    },
    {
      "t": "07:34",
      "text": "എന്താ ചെയ്യുക അതാണ്"
    },
    {
      "t": "07:36",
      "text": "പക്ഷേ നീ വല്ലതും ഏയ് എട്ടാ"
    },
    {
      "t": "07:38",
      "text": "എന്നാണോ ശരിയായ"
    },
    {
      "t": "07:40",
      "text": "പേജ് എന്ത് പറ്റി"
    },
    {
      "t": "07:42",
      "text": "ഇങ്ങനെ എല്ലാം ഇങ്ങനെ അത്"
    },
    {
      "t": "07:44",
      "text": "രാത്രിയായിരുന്നു ലേറ്റ് നൈറ്റ് ആയിരുന്നു"
    },
    {
      "t": "07:46",
      "text": "പ്രോപ്പർ"
    },
    {
      "t": "07:48",
      "text": "റിംഗ് എന്ത് സെക്സ് ടോക്കൺ"
    },
    {
      "t": "07:50",
      "text": "അത്രയും കഴിഞ്ഞ് അത് പോയി"
    },
    {
      "t": "07:52",
      "text": "അതെ ഞാൻ പറഞ്ഞുതരാം"
    },
    {
      "t": "07:54",
      "text": "സംഭവം കൂടുതൽ വരുന്ന ബാങ്കിൽ"
    },
    {
      "t": "07:56",
      "text": "ജോലി പഠിക്കുന്ന കുട്ടികളുണ്ടല്ലോ"
    },
    {
      "t": "07:58",
      "text": "നഴ്സിംഗ് നഴ്സിംഗ് അതെ"
    },
    {
      "t": "08:00",
      "text": "മെഡിസിൻ പിടിക്കണം അവർക്ക്"
    },
    {
      "t": "08:02",
      "text": "ഫ്രണ്ട്സ് കൂടുതൽ വേണം അതിന് വേണ്ടിയിട്ട്"
    },
    {
      "t": "08:04",
      "text": "ഇവര് ഓപ്പൺ ഡോർ ബോർഡ് ആണ്"
    },
    {
      "t": "08:06",
      "text": "ഓക്സിജൻ ചേഞ്ച് ചെയ്യും"
    },
    {
      "t": "08:08",
      "text": "കൂടുതൽ അമ്മച്ചിമാർ അറിയും"
    },
    {
      "t": "08:10",
      "text": "എൻ്റെ പൊന്നോൻ"
    },
    {
      "t": "08:12",
      "text": "ഞാനിങ്ങനെ വിളിക്കും കട്ടാക്കും വിളിക്കും"
    },
    {
      "t": "08:14",
      "text": "വിളിക്കും കട്ടാക്കും വിളിക്കും കട്ടാക്കും"
    },
    {
      "t": "08:16",
      "text": "ആ"
    },
    {
      "t": "08:18",
      "text": "ആ എനിക്കുള്ള കോള്"
    },
    {
      "t": "08:20",
      "text": "ഓക്കെ ഓക്കെ ഓക്കെ"
    },
    {
      "t": "08:22",
      "text": "അപ്പം നമ്മളിനി കാണില്ല"
    },
    {
      "t": "08:24",
      "text": "ശരി ബാക്കി"
    },
    {
      "t": "08:26",
      "text": "ഓക്കേ"
    }
  ],
