  "processing_time_sec": 15.2673978805542,
  "segments": [
    {
      "t": "00:00",
      "text": "సరే"
    },
    {
      "t": "00:02",
      "text": "రైట్"
    },
    {
      "t": "00:04",
      "text": "హలో"
    },
    {
      "t": "00:06",
      "text": "ఆశయం"
    },
    {
      "t": "00:08",
      "text": "అది"
    },
    {
      "t": "00:10",
      "text": "హైదరాబాద్ మీరు"
    },
    {
      "t": "00:12",
      "text": "హైదరాబాద్"
    },
    {
      "t": "00:14",
      "text": "ఏమో ఇద్రావది"
    },
    {
      "t": "00:16",
      "text": "ఏం చేస్తుంటారు"
    },
    {
      "t": "00:18",
      "text": "ముస్లిమా"
    },
    {
      "t": "00:20",
      "text": "కాదు హిందీ పెట్టాను అనుకున్న లాంగ్వేజ్"
    },
    {
      "t": "00:22",
      "text": "ఇట్స్ మచ్ వేర్"
    },
    {
      "t": "00:24",
      "text": "ఇందులో లాంగ్వేజెస్ ఉంటాయి హిందీ"
    },
    {
      "t": "00:26",
      "text": "తమిళని హిందీ పెట్టాము అనుకో"
    },
    {
      "t": "00:28",
      "text": "కాసేపు ఓకే"
    },
    {
      "t": "00:30",
      "text": "మనకు ముఖ్య ధరణి కార్డు"
    },
    {
      "t": "00:32",
      "text": "ఓకే"
    },
    {
      "t": "00:34",
      "text": "హిందీ అమ్మాయిలు అయ్యి ఉన్నారు అందుకనే నేను మర్చిపోయాను"
    },
    {
      "t": "00:36",
      "text": "ఆహా"
    },
    {
      "t": "00:38",
      "text": "అది"
    },
    {
      "t": "00:40",
      "text": "ఓకే"
    },
    {
      "t": "00:42",
      "text": "ఎన్ఎఫ్ ఎక్కడున్నారు"
    },
    {
      "t": "00:44",
      "text": "హైదరాబాద్లో రూమ్లో"
    },
    {
      "t": "00:46",
      "text": "లెక్కన"
    },
    {
      "t": "00:48",
      "text": "అంతే ఇంకా రొమ్ము"
    },
    {
      "t": "00:50",
      "text": "అందులో"
    },
    {
      "t": "00:52",
      "text": "అక్కడ ఏం చెప్పాడా చెప్పాడు"
    },
    {
      "t": "00:54",
      "text": "ఏమంటారు ఓపెన్ ఉంది చెప్పండి"
    },
    {
      "t": "00:56",
      "text": "అప్పుడు టెంప్టింగ్గా ఉంది"
    },
    {
      "t": "00:58",
      "text": "అదే"
    },
    {
      "t": "01:00",
      "text": "బాగుంటుంది"
    },
    {
      "t": "01:02",
      "text": "బాగుంది అని చెప్తారు"
    },
    {
      "t": "01:04",
      "text": "సరే నేను టెంప్టింగ్లో ఉందని చెప్తున్నాను"
    },
    {
      "t": "01:06",
      "text": "ఆహా"
    },
    {
      "t": "01:08",
      "text": "చాలా బాగుంది"
    },
    {
      "t": "01:10",
      "text": "చాలా మందికి"
    },
    {
      "t": "01:12",
      "text": "కూడా"
    },
    {
      "t": "01:14",
      "text": "అదేంటి తీయించుకోవచ్చు"
    },
    {
      "t": "01:16",
      "text": "అని కూడా అనుకుంటాం"
    },
    {
      "t": "01:18",
      "text": "వద్దు చాలా అందంగా ఉంది"
    },
    {
      "t": "01:20",
      "text": "అదే అమ్మ"
    },
    {
      "t": "01:22",
      "text": "చేయించుకోని కూడా"
    },
    {
      "t": "01:24",
      "text": "ఇంకా నీ బాగా"
    },
    {
      "t": "01:26",
      "text": "క్యాప్టెన్ ఉన్నాడా దొరికేసాడా"
    },
    {
      "t": "01:28",
      "text": "మోషన్ ఉండేవాళ్ళు"
    },
    {
      "t": "01:30",
      "text": "పర్వాలేదు"
    },
    {
      "t": "01:32",
      "text": "కొరికేసాడా"
    },
    {
      "t": "01:34",
      "text": "ఏంటి"
    },
    {
      "t": "01:36",
      "text": "ఆ"
    },
    {
      "t": "01:38",
      "text": "సరిపడే"
    },
    {
      "t": "01:40",
      "text": "ఇది"
    },
    {
      "t": "01:42",
      "text": "ఎస్ బ్రో"
    },
    {
      "t": "01:44",
      "text": "నథింగ్ పేరు"
    },
    {
      "t": "01:46",
      "text": "ఐ థింక్ ల్యాప్టాప్ ఆన్ చేసి పెట్టుకున్నాను"
    },
    {
      "t": "01:48",
      "text": "కొన్నిసార్లు మాట్లాడుతున్నాను"
    },
    {
      "t": "01:50",
      "text": "మీ పేరు అంటున్నా"
    },
    {
      "t": "01:52",
      "text": "అదే విక్రమ్ వికీ"
    },
    {
      "t": "01:54",
      "text": "ఓకే ఎక్కడ"
    },
    {
      "t": "01:56",
      "text": "ప్రాపర్ ఎక్కడ ప్రాపర్ నెల్లూరు"
    },
    {
      "t": "01:58",
      "text": "ప్రజెంట్ హైదరాబాద్"
    },
    {
      "t": "02:00",
      "text": "ఎక్కడ"
    },
    {
      "t": "02:02",
      "text": "ఎక్కడ ఉంటారు హైదరాబాద్లో గచ్చిబౌలి"
    },
    {
      "t": "02:04",
      "text": "ఆహా"
    },
    {
      "t": "02:06",
      "text": "అవును"
    },
    {
      "t": "02:08",
      "text": "నాది ఉప్పల్"
    },
    {
      "t": "02:10",
      "text": "ఇంకా"
    },
    {
      "t": "02:12",
      "text": "ఓకే"
    },
    {
      "t": "02:14",
      "text": "లేదు ఆఫర్స్ ఇవ్వాలా"
    },
    {
      "t": "02:16",
      "text": "అదిగో ల్యాప్టాప్ ఆన్ చేసి పెట్టుకున్నాను"
    },
    {
      "t": "02:18",
      "text": "కనిపించలేదు"
    },
    {
      "t": "02:20",
      "text": "వర్క్ ఫ్రమ్ హోమ్ వర్క్"
    },
    {
      "t": "02:22",
      "text": "అవును ఓకే"
    },
    {
      "t": "02:24",
      "text": "వన్"
    },
    {
      "t": "02:26",
      "text": "నెల్లూరులో కూడా చేసుకోవచ్చు కదా మీరు ఇక్కడికి వచ్చి"
    },
    {
      "t": "02:28",
      "text": "ఏ డేట్ ఏ డేట్ ఆఫీస్కి వెళ్ళాలి"
    },
    {
      "t": "02:30",
      "text": "లాగిన్స్"
    },
    {
      "t": "02:32",
      "text": "అర్థం కాదు"
    },
    {
      "t": "02:34",
      "text": "త్రీ డేస్ లాగిన్ అవ్వాలి ఆఫీస్కి వెళ్ళి"
    },
    {
      "t": "02:36",
      "text": "చేయాలి"
    },
    {
      "t": "02:38",
      "text": "ఇది"
    },
    {
      "t": "02:40",
      "text": "ఏ ఏ కంపెనీ మీద"
    },
    {
      "t": "02:42",
      "text": "అండి"
    },
    {
      "t": "02:44",
      "text": "ఆ"
    },
    {
      "t": "02:46",
      "text": "ఎస్"
    },
    {
      "t": "02:48",
      "text": "చెప్పు"
    },
    {
      "t": "02:50",
      "text": "బాగున్నాయి"
    },
    {
      "t": "02:52",
      "text": "ఓకే"
    },
    {
      "t": "02:54",
      "text": "ఇంకా"
    },
    {
      "t": "02:56",
      "text": "ఇంకేంటి మరి"
    },
    {
      "t": "02:58",
      "text": "ఏముంది ఎప్పటి నుంచి వాడుతున్నారు"
    },
    {
      "t": "03:00",
      "text": "వన్ మంత్ అయితే"
    },
    {
      "t": "03:02",
      "text": "సరే"
    },
    {
      "t": "03:04",
      "text": "ఏ బార్ పసుపు వచ్చింది"
    },
    {
      "t": "03:06",
      "text": "ఏది పడితే అది"
    },
    {
      "t": "03:08",
      "text": "ఓకే"
    },
    {
      "t": "03:10",
      "text": "టైంపాస్కి ఏదో పడితే"
    },
    {
      "t": "03:12",
      "text": "ఓకే ఓకే"
    },
    {
      "t": "03:14",
      "text": "అన్ని ల్యాంగ్వేజ్"
    },
    {
      "t": "03:16",
      "text": "ఎక్స్ప్లోర్ చేస్తాను బేసిక్గా"
    },
    {
      "t": "03:18",
      "text": "వీళ్ళు ఐపీఎస్లో ఎవరెవరు ఉన్నారో చూసి"
    },
    {
      "t": "03:20",
      "text": "అందరూ హ్యాపీగా తాగుతున్నారు"
    },
    {
      "t": "03:22",
      "text": "తమిళ్ వచ్చా"
    },
    {
      "t": "03:24",
      "text": "మరి తమిళనాడులో ఉన్నారు"
    },
    {
      "t": "03:26",
      "text": "తగలబడవచ్చు"
    },
    {
      "t": "03:28",
      "text": "లైటింగ్"
    },
    {
      "t": "03:30",
      "text": "లైట్గా అడగలేదు"
    },
    {
      "t": "03:32",
      "text": "లైట్లు వెల్డింగ్ అన్ని అన్ని షేర్స్ పెట్టి"
    },
    {
      "t": "03:34",
      "text": "అది సరేనండి"
    },
    {
      "t": "03:36",
      "text": "చెప్పు"
    },
    {
      "t": "03:38",
      "text": "రైట్ ఇంత బాగుంది"
    },
    {
      "t": "03:40",
      "text": "అవును"
    },
    {
      "t": "03:42",
      "text": "ఏంది"
    },
    {
      "t": "03:44",
      "text": "నువ్వేంటి ఎంత బాగున్నావు అంటున్నారు"
    },
    {
      "t": "03:46",
      "text": "గోల్స్కి"
    },
    {
      "t": "03:48",
      "text": "అండ్ హెల్ప్"
    },
    {
      "t": "03:50",
      "text": "సూపర్"
    },
    {
      "t": "03:52",
      "text": "సార్"
    },
    {
      "t": "03:54",
      "text": "వన్ హండ్రెడ్"
    },
    {
      "t": "03:56",
      "text": "ఓకే"
    },
    {
      "t": "03:58",
      "text": "ఒకసారి ఇలా చెయ్యి"
    },
    {
      "t": "04:00",
      "text": "చూపించవచ్చు కదా"
    },
    {
      "t": "04:02",
      "text": "రూపే"
    },
    {
      "t": "04:04",
      "text": "చూస్తాను"
    },
    {
      "t": "04:06",
      "text": "చూపియను"
