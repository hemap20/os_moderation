  "processing_time_sec": 30.48309302330017,
  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "హలో"
    },
    {
      "t": "00:04",
      "text": "అవును"
    },
    {
      "t": "00:06",
      "text": "చాలా హాయి అండి"
    },
    {
      "t": "00:08",
      "text": "హలో"
    },
    {
      "t": "00:10",
      "text": "హలో"
    },
    {
      "t": "00:12",
      "text": "ఓకే"
    },
    {
      "t": "00:14",
      "text": "గుడ్ మార్నింగ్ ఇక్కడి నుంచి"
    },
    {
      "t": "00:16",
      "text": "ఓకే"
    },
    {
      "t": "00:18",
      "text": "గుడ్ మార్నింగ్ అండి మీరే కన్నా"
    },
    {
      "t": "00:20",
      "text": "ఆ"
    },
    {
      "t": "00:22",
      "text": "ఎక్కడ నుంచి మీరు అంటారు"
    },
    {
      "t": "00:24",
      "text": "హైదరాబాద్ నువ్వెక్కడ"
    },
    {
      "t": "00:26",
      "text": "కరెక్ట్"
    },
    {
      "t": "00:28",
      "text": "ధర్మనగర మార్గం"
    },
    {
      "t": "00:30",
      "text": "అవునా మీకోసం కరీంనగర్ రమ్మంటావా"
    },
    {
      "t": "00:32",
      "text": "అయిపోయింది"
    },
    {
      "t": "00:34",
      "text": "అంతేనా"
    },
    {
      "t": "00:36",
      "text": "సరే"
    },
    {
      "t": "00:38",
      "text": "నేను అనుకున్నా నువ్వే"
    },
    {
      "t": "00:40",
      "text": "ఏంటంటే గెలవాలి కదా"
    },
    {
      "t": "00:42",
      "text": "ఏం పని చేస్తారు"
    },
    {
      "t": "00:44",
      "text": "ఓకే"
    },
    {
      "t": "00:46",
      "text": "ఏం చూడురా భాయ్ ఫోటోలు తీసుకురా"
    },
    {
      "t": "00:48",
      "text": "ఉంటాం"
    },
    {
      "t": "00:50",
      "text": "ఆహా"
    },
    {
      "t": "00:52",
      "text": "రాహుల్"
    },
    {
      "t": "00:54",
      "text": "ఆ"
    },
    {
      "t": "00:56",
      "text": "ఓకే"
    },
    {
      "t": "00:58",
      "text": "ఏమంటావు రమ్మంటావు వద్దంటావు కరీంనగర్"
    },
    {
      "t": "01:00",
      "text": "వద్దులే"
    },
    {
      "t": "01:02",
      "text": "ఏ"
    },
    {
      "t": "01:04",
      "text": "ఎస్"
    },
    {
      "t": "01:06",
      "text": "ఎందుకు"
    },
    {
      "t": "01:08",
      "text": "ఆ"
    },
    {
      "t": "01:10",
      "text": "ఎందుకు"
    },
    {
      "t": "01:12",
      "text": "మీ ఆయిల్ని చేంజ్ చేసుకోవచ్చు"
    },
    {
      "t": "01:14",
      "text": "ఆహా"
    },
    {
      "t": "01:16",
      "text": "ఆ"
    },
    {
      "t": "01:18",
      "text": "చెప్పు బుజ్జి"
    },
    {
      "t": "01:20",
      "text": "ఎందుకు వచ్చినావు దీనికంటే చెప్తాను"
    },
    {
      "t": "01:22",
      "text": "నేనైతే ఒక గర్ల్ ఫ్రెండ్ వెతుక్కుంటున్నాను అబ్బాయి"
    },
    {
      "t": "01:24",
      "text": "అవునా"
    },
    {
      "t": "01:26",
      "text": "గురుత్వ రంగం"
    },
    {
      "t": "01:28",
      "text": "ఉంటాడు"
    },
    {
      "t": "01:30",
      "text": "ఎవరన్నా దొరుకుతారా"
    },
    {
      "t": "01:32",
      "text": "తొందరగా ట్రై చేయండి నేను అయితే ఉండను"
    },
    {
      "t": "01:34",
      "text": "దుఃఖమే"
    },
    {
      "t": "01:36",
      "text": "ఎవరు లేరు ఇట్లా"
    },
    {
      "t": "01:38",
      "text": "అండ్ తినేప్పటి నుంచి వాడతాను"
    },
    {
      "t": "01:40",
      "text": "దాంట్లో"
    },
    {
      "t": "01:42",
      "text": "ఇంకా అప్పుడు ఎప్పుడో"
    },
    {
      "t": "01:44",
      "text": "నేను లోన కింద"
    },
    {
      "t": "01:46",
      "text": "వాడిన"
    },
    {
      "t": "01:48",
      "text": "మళ్ళీ గీయాలని వేసినారు"
    },
    {
      "t": "01:50",
      "text": "అంతేనా"
    },
    {
      "t": "01:52",
      "text": "ఉంటే ఏమవుతుందిరా"
    },
    {
      "t": "01:54",
      "text": "తక్కువ అవ్వాలని"
    },
    {
      "t": "01:56",
      "text": "ఏం తప్పులేదు కానీ"
    },
    {
      "t": "01:58",
      "text": "కానీ వద్దులేండి నాకు ఇంట్రెస్ట్ లేదు"
    },
    {
      "t": "02:00",
      "text": "సార్ సార్"
    },
    {
      "t": "02:02",
      "text": "ఏమంటే ఇంట్రెస్ట్ ఉంది"
    },
    {
      "t": "02:04",
      "text": "మూడు"
    },
    {
      "t": "02:06",
      "text": "దేని మీద ఇంట్రెస్ట్"
    },
    {
      "t": "02:08",
      "text": "జస్ట్ నాదన్నా చెప్పు"
    },
    {
      "t": "02:10",
      "text": "ఏ"
    },
    {
      "t": "02:12",
      "text": "మాట్లాడుడు గంతే యాప్లో"
    },
    {
      "t": "02:14",
      "text": "నేను కూడా"
    },
    {
      "t": "02:16",
      "text": "నాతో మాట్లాడొచ్చు కదా నువ్వు దట్"
    },
    {
      "t": "02:18",
      "text": "ఇంకా అంతకంటే ఎక్కువ ఏం చెప్తాం"
    },
    {
      "t": "02:20",
      "text": "ఆహా ఆహా"
    },
    {
      "t": "02:22",
      "text": "సో హైదరాబాద్ వచ్చేది ఉందా నేను కరీంనగర్"
    },
    {
      "t": "02:24",
      "text": "వచ్చేది ఉందా అండి నేనంటే వస్తాను కానీ నువ్వు వస్తాను"
    },
    {
      "t": "02:26",
      "text": "స్టోర్ అవ్వట్లేదు"
    },
    {
      "t": "02:28",
      "text": "మాకు ఎక్కడ వీళ్ళు"
    },
    {
      "t": "02:30",
      "text": "కృష్ణానగర్లో ఎక్సైజ్"
    },
    {
      "t": "02:32",
      "text": "ఈ"
    },
    {
      "t": "02:34",
      "text": "నాకు ఆడ లేకుంటే"
    },
    {
      "t": "02:36",
      "text": "నీకోసం వస్తా అంటున్నా దానికి"
    },
    {
      "t": "02:38",
      "text": "అంతేనా"
    },
    {
      "t": "02:40",
      "text": "అవును"
    },
    {
      "t": "02:42",
      "text": "ఓకే"
    },
    {
      "t": "02:44",
      "text": "నువ్వు మ్యారేజ్ అయ్యావు"
    },
    {
      "t": "02:46",
      "text": "ఏం లేదు ఇద్దరు పిల్లలు"
    },
    {
      "t": "02:48",
      "text": "అవునండి"
    },
    {
      "t": "02:50",
      "text": "అందాము"
    },
    {
      "t": "02:52",
      "text": "పాత క్లాస్"
    },
    {
      "t": "02:54",
      "text": "ఆహా"
    },
    {
      "t": "02:56",
      "text": "ఓకే"
    },
    {
      "t": "02:58",
      "text": "ఓకే"
    },
    {
      "t": "03:00",
      "text": "మా"
    },
    {
      "t": "03:02",
      "text": "ఇంకా ఇద్దరులే మా వాళ్ళు కూడా"
    },
    {
      "t": "03:04",
      "text": "ఇంకా"
    },
    {
      "t": "03:06",
      "text": "పెద్ద"
    },
    {
      "t": "03:08",
      "text": "లైన్"
    },
    {
      "t": "03:10",
      "text": "వెళ్ళి లైన్ ఏమిటి"
    },
    {
      "t": "03:12",
      "text": "ఉంటాను"
    },
    {
      "t": "03:14",
      "text": "పెరిగినాక కూడా ఇక నువ్వు"
    },
    {
      "t": "03:16",
      "text": "వీళ్ళు మాట్లాడుతున్నావు అంటే"
    },
    {
      "t": "03:18",
      "text": "ఎట్లా రాబోయి మళ్ళీ ఇంకా అన్యాయం"
    },
    {
      "t": "03:20",
      "text": "ఇంట్లో నేను ఉండాలి"
    },
    {
      "t": "03:22",
      "text": "ఆ"
    },
    {
      "t": "03:24",
      "text": "ఆ ఆ"
    },
    {
      "t": "03:26",
      "text": "పిల్లల పెళ్ళికనే అన్యాయాన్ని"
    },
    {
      "t": "03:28",
      "text": "బలంగా ఉండొచ్చు"
    },
    {
      "t": "03:30",
      "text": "ఏం మిగలరా బాబు"
    },
    {
      "t": "03:32",
      "text": "ఓహో"
    },
    {
      "t": "03:34",
      "text": "ఓ యావో మాటలు"
    },
    {
      "t": "03:36",
      "text": "అంతేనా"
    },
    {
      "t": "03:38",
      "text": "మరి"
    },
    {
      "t": "03:40",
      "text": "ఇంకేముందిరా భాయ్ చెప్పు"
    },
    {
      "t": "03:42",
      "text": "బర్త్డే బర్త్డే టూ థౌసండ్"
    },
    {
      "t": "03:44",
      "text": "పనికిరాని వాడు ఉంటాడుగా"
    },
    {
      "t": "03:46",
      "text": "ఎవరు"
    },
    {
      "t": "03:48",
      "text": "పని పాట లేనోడు"
    },
    {
      "t": "03:50",
      "text": "ఎప్పుడూ ఒకడు మోడనేటోడు ఉంటాడు కదా అంటాను"
    },
    {
      "t": "03:52",
      "text": "వాడు ఉంటాడు"
    },
    {
      "t": "03:54",
      "text": "వాడు ఎడుగుతూ ఉంటాడు వాడు ఉంటాడు అని"
    },
    {
      "t": "03:56",
      "text": "సూపర్"
    },
    {
      "t": "03:58",
      "text": "ఆ"
    },
    {
      "t": "04:00",
      "text": "ఓకే"
    },
    {
      "t": "04:02",
      "text": "ఆ"
    },
    {
      "t": "04:04",
      "text": "ఓకే"
    },
    {
      "t": "04:06",
      "text": "వాని పని ఉండడం వాడు ఉంటాడు ఉన్నారు"
    },
    {
      "t": "04:08",
      "text": "ఆ"
    },
    {
      "t": "04:10",
      "text": "నాతో పోలిస్తే"
    },
    {
      "t": "04:12",
      "text": "పర్లా"
    },
    {
      "t": "04:14",
      "text": "ఆ"
    },
    {
      "t": "04:16",
      "text": "అవ్వలేదు చూసుకోవాలి"
    },
    {
      "t": "04:18",
      "text": "అంటే"
    },
    {
      "t": "04:20",
      "text": "చూసుకోవాలంటే నీకు ఆకలి అయితే"
    },
    {
      "t": "04:22",
      "text": "లేదు నాకు సరిపోతుంది ఓకే"
    },
    {
      "t": "04:24",
      "text": "ఏ అంటే అది"
    },
    {
      "t": "04:26",
      "text": "ఆ"
    },
    {
      "t": "04:28",
      "text": "ఈ"
    },
    {
      "t": "04:30",
      "text": "ఏది కూడా"
    },
    {
      "t": "04:32",
      "text": "నాకు ఆకలవుతుంది నాకు"
    },
    {
      "t": "04:34",
      "text": "ఆహా"
    },
    {
      "t": "04:36",
      "text": "ఆ"
    },
    {
      "t": "04:38",
      "text": "ఏం చేద్దాం రాగలైతలే"
    },
    {
      "t": "04:40",
      "text": "అయితానులేండి"
    },
    {
      "t": "04:42",
      "text": "బాగా"
    },
    {
      "t": "04:44",
      "text": "మరియు"
    },
    {
      "t": "04:46",
      "text": "మామూలుగా లేదు ఆకలి"
    },
    {
      "t": "04:48",
      "text": "అదే"
    },
    {
      "t": "04:50",
      "text": "స్టేములాగా ఇది"
    },
    {
      "t": "04:52",
      "text": "అమ్మ"
    },
    {
      "t": "04:54",
      "text": "సరే"
    },
    {
      "t": "04:56",
      "text": "వాడు చేయనప్పుడు ఏం చేస్తావు చెప్పు"
    },
    {
      "t": "04:58",
      "text": "ఆ"
    },
    {
      "t": "05:00",
      "text": "ఓకే"
    },
    {
      "t": "05:02",
      "text": "ఓకే"
    },
    {
      "t": "05:04",
      "text": "ఓకే"
    },
    {
      "t": "05:06",
      "text": "ఓ ఇందులోనే వడవట్టింది"
    },
    {
      "t": "05:08",
      "text": "ఆ"
    },
    {
      "t": "05:10",
      "text": "ప్లస్"
    },
    {
      "t": "05:12",
      "text": "ఓకే"
    },
    {
      "t": "05:14",
      "text": "ఏం"
    },
    {
      "t": "05:16",
      "text": "ఏమో అన్నారు అర్థం కాదు"
    },
    {
      "t": "05:18",
      "text": "ఆ"
    },
    {
      "t": "05:20",
      "text": "ఏమో అన్నం అర్థం కాలేదు"
    },
    {
      "t": "05:22",
      "text": "ఫైన్ ఇట్"
    },
    {
      "t": "05:24",
      "text": "ఏంటి నువ్వు అన్నావు అర్థం కాలేదు"
    },
    {
      "t": "05:26",
      "text": "ఎన్ని రోజులు చూడాలి"
    },
    {
      "t": "05:28",
      "text": "వాడుతున్నాం యాప్ వర్ణం"
    },
    {
      "t": "05:30",
      "text": "నేను వన్ మంత్ అవుతాను"
    },
    {
      "t": "05:32",
      "text": "వర్మ"
    },
    {
      "t": "05:34",
      "text": "ఫుల్ సీనియర్ ఇంకేం"
    },
    {
      "t": "05:36",
      "text": "ఆ"
    },
    {
      "t": "05:38",
      "text": "కానీ ఎప్పుడో ఒకసారి"
    },
    {
      "t": "05:40",
      "text": "పాడతాను ఈ మధ్యలో"
    },
    {
      "t": "05:42",
      "text": "ఫోర్ డేస్ అవుతుంది రెగ్యులర్గా వాడతాము"
    },
    {
      "t": "05:44",
      "text": "ఓకే"
    },
    {
      "t": "05:46",
      "text": "ఈ"
    },
    {
      "t": "05:48",
      "text": "ఓకే"
    },
    {
      "t": "05:50",
      "text": "ఓకే"
    },
    {
      "t": "05:52",
      "text": "మీరు బాగా పెద్దోళ్ళు"
    },
    {
      "t": "05:54",
      "text": "గైస్"
    },
    {
      "t": "05:56",
      "text": "ఓకే"
    },
    {
      "t": "05:58",
      "text": "నీ వాయిస్ బాగా పెద్దోళ్ళలాగా"
    },
    {
      "t": "06:00",
      "text": "ఉంది"
    },
    {
      "t": "06:02",
      "text": "రెండు వేలు రాబోతుంది నీకు ఎంత"
    },
    {
      "t": "06:04",
      "text": "ఆ"
    },
    {
      "t": "06:06",
      "text": "ఆహా"
    },
    {
      "t": "06:08",
      "text": "ఓకే"
    },
    {
      "t": "06:10",
      "text": "నీకేం కావాలి"
    },
    {
      "t": "06:12",
      "text": "నాకు కూడా అంతే ఉంటుంది"
    },
    {
      "t": "06:14",
      "text": "ఉంటాయి అని అంటాం"
    },
    {
      "t": "06:16",
      "text": "చూసుకో"
    },
    {
      "t": "06:18",
      "text": "ఏడుకున్న కనెక్షన్"
    },
    {
      "t": "06:20",
      "text": "మన ఇద్దరికి కలిసింది"
    },
    {
      "t": "06:22",
      "text": "హా హా హా"
    },
    {
      "t": "06:24",
      "text": "ఆ"
    },
    {
      "t": "06:26",
      "text": "అన్నీ కుదురు"
    },
    {
      "t": "06:28",
      "text": "తల్లియా"
    },
    {
      "t": "06:30",
      "text": "ఎవడు మారంగా"
    },
    {
      "t": "06:32",
      "text": "అయితే కుదిరింది చిన్నగా"
    },
    {
      "t": "06:34",
      "text": "నేను పెద్దగా అన్నట్టుగా నీకు ఇద్దరు పిల్లలు"
    },
    {
      "t": "06:36",
      "text": "ఇద్దరు పిల్లలు"
    },
    {
      "t": "06:38",
      "text": "ఐదు గంటల ఐదు గంటల అది"
    },
    {
      "t": "06:40",
      "text": "ఆ"
    },
    {
      "t": "06:42",
      "text": "ఓకే"
    },
    {
      "t": "06:44",
      "text": "ఎట్లా"
    },
    {
      "t": "06:46",
      "text": "ఓకే"
    },
    {
      "t": "06:48",
      "text": "ఏ వన్ టూ ఒకటి"
    },
    {
      "t": "06:50",
      "text": "అన్నీ కుదురుతున్నాయి అంటావు కదా"
    },
    {
      "t": "06:52",
      "text": "నేను ఏమనుకుంటున్నాను"
    },
    {
      "t": "06:54",
      "text": "కానీ నువ్వేమనుకుంటున్నావో తెలియదు కదా"
    },
    {
      "t": "06:56",
      "text": "ఎస్"
    },
    {
      "t": "06:58",
      "text": "అర్థం ఇంటర్వ్యూ దగ్గర ప్రాబ్లం"
    },
    {
      "t": "07:00",
      "text": "వీలు"
    },
    {
      "t": "07:02",
      "text": "ఏంట్రా తెలిస్తే ప్రాబ్లం"
    },
    {
      "t": "07:04",
      "text": "ప్రాబ్లం అయితే"
    },
    {
      "t": "07:06",
      "text": "ఇంటర్వెల్"
    },
    {
      "t": "07:08",
      "text": "అదే ప్రాబ్లం అవుతుంది అంటాను"
    },
    {
      "t": "07:10",
      "text": "చెప్తావా మీ ఆయనకు"
    },
    {
      "t": "07:12",
      "text": "కానీ నీతో కలుస్తున్నావు కానీ నువ్వు పోతున్నావు"
    },
    {
      "t": "07:14",
      "text": "అవును"
    },
    {
      "t": "07:16",
      "text": "సినిమాకి వెళ్ళాం కదా"
    },
    {
      "t": "07:18",
      "text": "చూడడానికి ఉంటుంది అదేదో రకంగా పైకి"
    },
    {
      "t": "07:20",
      "text": "మనమే"
    },
    {
      "t": "07:22",
      "text": "ఎప్పుడు కావాలి"
    },
    {
      "t": "07:24",
      "text": "ఒక సీలింగ్"
    },
    {
      "t": "07:26",
      "text": "అంతేనా"
    },
    {
      "t": "07:28",
      "text": "ఏమి మనసులో"
    },
    {
      "t": "07:30",
      "text": "ఉండేది అన్నీ అయి తీరా పోయి నీ మనసులో లేకపోతే"
    },
    {
      "t": "07:32",
      "text": "అది కూడా"
    },
    {
      "t": "07:34",
      "text": "కరెక్ట్"
    },
    {
      "t": "07:36",
      "text": "అవును"
    },
    {
      "t": "07:38",
      "text": "ఓకే"
    },
    {
      "t": "07:40",
      "text": "అదేవిధంగా"
    },
    {
      "t": "07:42",
      "text": "ఓకే"
    },
    {
      "t": "07:44",
      "text": "థ్యాంక్ యూ"
    },
    {
      "t": "07:46",
      "text": "వర్షం పడుతుంది"
    },
    {
      "t": "07:48",
      "text": "ఇట్లా అంటుంటే"
    },
    {
      "t": "07:50",
      "text": "నేను చూడాలని ఉన్నాను నాకు ఏం చేయాలి"
    },
    {
      "t": "07:52",
      "text": "ఈ నెంబర్ ఇస్తే వాట్సాప్లో ఫోన్ చేస్తాను"
    },
    {
      "t": "07:54",
      "text": "అమ్మాయి"
    },
    {
      "t": "07:56",
      "text": "నాకు నెంబర్ అది నోటికి లేదు నాది"
    },
    {
      "t": "07:58",
      "text": "ఇది"
    },
    {
      "t": "08:00",
      "text": "నా హండ్రెడ్కి లేవు నాకు"
    },
    {
      "t": "08:02",
      "text": "ఓ"
    },
    {
      "t": "08:04",
      "text": "అది రాసుకోమ్మా రాసుకో"
    },
    {
      "t": "08:06",
      "text": "కంపోజ్ అయినా"
    },
    {
      "t": "08:08",
      "text": "లాభం వద్దులెండి"
    },
    {
      "t": "08:10",
      "text": "ఓకే"
    },
    {
      "t": "08:12",
      "text": "ఎందుకు ఆపొద్దు అట్లాంటి"
    },
    {
      "t": "08:14",
      "text": "టౌన్"
    },
    {
      "t": "08:16",
      "text": "ప్రియా"
    },
    {
      "t": "08:18",
      "text": "ఏం చేస్తలేడు అంటావు ఆకలి ఫుల్ అవుతుందా"
    },
    {
      "t": "08:20",
      "text": "దాంతో"
    },
    {
      "t": "08:22",
      "text": "అనే రైతాంగం"
    },
    {
      "t": "08:24",
      "text": "మరి నాకెలా"
    },
    {
      "t": "08:26",
      "text": "అబ్బాయికి ఆ బొబ్బ చెప్పు నువ్వే మరి"
    },
    {
      "t": "08:28",
      "text": "ఓకే"
    },
    {
      "t": "08:30",
      "text": "ఇప్పుడు నెంబర్"
    },
    {
      "t": "08:32",
      "text": "లేదా నెంబర్ అన్నా రాసుకోండి"
    },
    {
      "t": "08:34",
      "text": "వద్దులేండి"
    },
    {
      "t": "08:36",
      "text": "నా బాధ నేను ఎట్లా పోగొడతాను"
    },
    {
      "t": "08:38",
      "text": "ఓకే"
    },
    {
      "t": "08:40",
      "text": "ఓకే"
    }
