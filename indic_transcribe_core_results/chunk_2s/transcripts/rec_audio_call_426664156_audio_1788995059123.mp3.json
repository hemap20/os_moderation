{
  "file_id": "rec_audio_call_426664156_audio_1788995059123.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 554.622,
  "processing_time_sec": 38.30355429649353,
  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "షెడ్యూల్డ్ ట్రైనింగ్ ఇన్ దిస్ కంట్రీ"
    },
    {
      "t": "00:04",
      "text": "హలో"
    },
    {
      "t": "00:06",
      "text": "సరే"
    },
    {
      "t": "00:08",
      "text": "హలో"
    },
    {
      "t": "00:10",
      "text": "హలో"
    },
    {
      "t": "00:12",
      "text": "హాయ్ అండి"
    },
    {
      "t": "00:14",
      "text": "హాయ్ గుడ్ మార్నింగ్"
    },
    {
      "t": "00:16",
      "text": "అదే హిస్టరీ"
    },
    {
      "t": "00:18",
      "text": "గుడ్ మార్నింగ్ నరేడా"
    },
    {
      "t": "00:20",
      "text": "అదే"
    },
    {
      "t": "00:22",
      "text": "సింగలం"
    },
    {
      "t": "00:24",
      "text": "రివైజ్డ్"
    },
    {
      "t": "00:26",
      "text": "చెప్పేయట్లేదు"
    },
    {
      "t": "00:28",
      "text": "నేను సింగిల్ ఉమెన్ని"
    },
    {
      "t": "00:30",
      "text": "ఆ"
    },
    {
      "t": "00:32",
      "text": "ఓకే ఓకే నైస్ నైస్ ఏం చేస్తుంటారు"
    },
    {
      "t": "00:34",
      "text": "సార్"
    },
    {
      "t": "00:36",
      "text": "మేకోవాలి"
    },
    {
      "t": "00:38",
      "text": "రేఖా పాఠం"
    },
    {
      "t": "00:40",
      "text": "టెస్ట్"
    },
    {
      "t": "00:42",
      "text": "ఓకే ఓకే ఇక్కడ"
    },
    {
      "t": "00:44",
      "text": "హైదరాబాద్"
    },
    {
      "t": "00:46",
      "text": "చాలు"
    },
    {
      "t": "00:48",
      "text": "ఇంకా ఇంకా"
    },
    {
      "t": "00:50",
      "text": "నేను కర్నూలు నుంచి అండి గవర్నమెంట్"
    },
    {
      "t": "00:52",
      "text": "కంప్లైంట్"
    },
    {
      "t": "00:54",
      "text": "ఓకే రండి రండి"
    },
    {
      "t": "00:56",
      "text": "కర్నూలు"
    },
    {
      "t": "00:58",
      "text": "ఓకే"
    },
    {
      "t": "01:00",
      "text": "ఏంటి ఈ టైంలో"
    },
    {
      "t": "01:02",
      "text": "వర్క్ ఉందా"
    },
    {
      "t": "01:04",
      "text": "వర్క్ ఏ అంటే కొంచెం ఇంట్లో"
    },
    {
      "t": "01:06",
      "text": "పళ్ళు ఉన్నాయి స్టక్ అయినాయి"
    },
    {
      "t": "01:08",
      "text": "అందరూ నిద్ర వచ్చేస్తుంది"
    },
    {
      "t": "01:10",
      "text": "ఓకే"
    },
    {
      "t": "01:12",
      "text": "ఒక వర్క్ చేసుకుంటూ మాట్లాడుతున్నారా"
    },
    {
      "t": "01:14",
      "text": "ప్లీజ్"
    },
    {
      "t": "01:16",
      "text": "మీరు లేచారు"
    },
    {
      "t": "01:18",
      "text": "ఇంత పదును"
    },
    {
      "t": "01:20",
      "text": "ఏం లేదు నచ్చుతుంది"
    },
    {
      "t": "01:22",
      "text": "చెప్పాలో అర్థం కావట్లేదు సరే"
    },
    {
      "t": "01:24",
      "text": "ఏం లేదు లోన్లీనెస్"
    },
    {
      "t": "01:26",
      "text": "ఎక్కువ ఉంటే వచ్చే"
    },
    {
      "t": "01:28",
      "text": "ఓకే"
    },
    {
      "t": "01:30",
      "text": "గర్ల్ ఫ్రెండ్ లేదా"
    },
    {
      "t": "01:32",
      "text": "నమస్తే అండి"
    },
    {
      "t": "01:34",
      "text": "నా మహానికి అది ఒకటి తక్కువ నా ఏజ్"
    },
    {
      "t": "01:36",
      "text": "ఏంటి"
    },
    {
      "t": "01:38",
      "text": "థర్టీ ఇయర్స్ అయితే గర్ల్ ఫ్రెండ్స్ ఉన్నారు"
    },
    {
      "t": "01:40",
      "text": "అక్కడ"
    },
    {
      "t": "01:42",
      "text": "ఏదో ట్వంటీస్లో ఉంటే ఉంటారు"
    },
    {
      "t": "01:44",
      "text": "కానీ టెన్ డేస్ గ్యాప్ వచ్చేసింది కదా ఈ టైం"
    },
    {
      "t": "01:46",
      "text": "మూడు గర్ల్ ఫ్రెండ్ ఎవరు ఉంటారు"
    },
    {
      "t": "01:48",
      "text": "ఎందుకు ఉండాలండి"
    },
    {
      "t": "01:50",
      "text": "నాకు తెలుసు తెలుసా"
    },
    {
      "t": "01:52",
      "text": "ట్వంటీస్లో"
    },
    {
      "t": "01:54",
      "text": "అంటే"
    },
    {
      "t": "01:56",
      "text": "జీ యావ సార్"
    },
    {
      "t": "01:58",
      "text": "మా ఆయన కనెక్ట్ అవ్వకుండా"
    },
    {
      "t": "02:00",
      "text": "మీరు అన్నట్టు"
    },
    {
      "t": "02:02",
      "text": "చాలా"
    },
    {
      "t": "02:04",
      "text": "వినిపించట్లేదండి"
    },
    {
      "t": "02:06",
      "text": "మీరు అన్నట్టు"
    },
    {
      "t": "02:08",
      "text": "ఓ గ్యాప్ వచ్చింది కదా"
    },
    {
      "t": "02:10",
      "text": "అవును"
    },
    {
      "t": "02:12",
      "text": "మీకు ఉంటుంది కదా మీరు పర్సనల్"
    },
    {
      "t": "02:14",
      "text": "ఫ్రెండ్స్ జాబ్స్లో కానీ"
    },
    {
      "t": "02:16",
      "text": "ఇక్కడ వేసినాను"
    },
    {
      "t": "02:18",
      "text": "అవును"
    },
    {
      "t": "02:20",
      "text": "అక్కడ ఫ్రెండ్సు"
    },
    {
      "t": "02:22",
      "text": "అందరూ పెళ్ళైన అమ్మాయిలే ఉన్నారు వాళ్ళతో"
    },
    {
      "t": "02:24",
      "text": "ఫ్రెండ్షిప్ ఏం చేస్తాం పాపం"
    },
    {
      "t": "02:26",
      "text": "అయ్యే రామ పెళ్ళైన అమ్మాయిలతోనే బాగుంటుంది"
    },
    {
      "t": "02:28",
      "text": "బాగుంటుంది అని చెప్పి"
    },
    {
      "t": "02:30",
      "text": "ఓకే"
    },
    {
      "t": "02:32",
      "text": "ఏమో"
    },
    {
      "t": "02:34",
      "text": "ఇలా"
    },
    {
      "t": "02:36",
      "text": "మళ్ళీ అది"
    },
    {
      "t": "02:38",
      "text": "అంటే ఫ్రెండ్షిప్ పైన బాండింగ్"
    },
    {
      "t": "02:40",
      "text": "ఎక్కువ ఉంటుంది"
    },
    {
      "t": "02:42",
      "text": "అదే మళ్ళీ మార్నింగ్ ఎక్కువ అవుతూ అలా"
    },
    {
      "t": "02:44",
      "text": "మళ్ళా ఎందుకులే అని"
    },
    {
      "t": "02:46",
      "text": "అచ్చా అచ్చా అదే"
    },
    {
      "t": "02:48",
      "text": "మార్నింగ్ ఎక్కువైతే అసలే నీకు పెళ్ళి కాదు"
    },
    {
      "t": "02:50",
      "text": "నేను గవర్నమెంట్ జాబు"
    },
    {
      "t": "02:52",
      "text": "సో సో అని"
    },
    {
      "t": "02:54",
      "text": "అవే చేస్తున్నాను"
    },
    {
      "t": "02:56",
      "text": "అవును"
    },
    {
      "t": "02:58",
      "text": "అవునా"
    },
    {
      "t": "03:00",
      "text": "అయ్య బాబోయ్ పెళ్ళి కానమ్మా"
    },
    {
      "t": "03:02",
      "text": "అలాగే"
    },
    {
      "t": "03:04",
      "text": "ఫ్రెండ్షిప్ చేస్తే లవ్"
    },
    {
      "t": "03:06",
      "text": "వరకు వెళ్తారు"
    },
    {
      "t": "03:08",
      "text": "హలో"
    },
    {
      "t": "03:10",
      "text": "పెళ్ళైన అమ్మాయిలు అంత తొందరగా రాలేరు"
    },
    {
      "t": "03:12",
      "text": "అవును"
    },
    {
      "t": "03:14",
      "text": "అవును"
    },
    {
      "t": "03:16",
      "text": "ఓకే"
    },
    {
      "t": "03:18",
      "text": "హలో"
    },
    {
      "t": "03:20",
      "text": "అవునవునవును"
    },
    {
      "t": "03:22",
      "text": "మరి అంతా"
    },
    {
      "t": "03:24",
      "text": "అట్లే నేను"
    },
    {
      "t": "03:26",
      "text": "మీరు రెడీయా"
    },
    {
      "t": "03:28",
      "text": "అవును రెడ్డిలో అమ్మాయిలు"
    },
    {
      "t": "03:30",
      "text": "ఇరవై రూపాయలు"
    },
    {
      "t": "03:32",
      "text": "అమ్మాయిలు"
    },
    {
      "t": "03:34",
      "text": "ఎక్కడ నాకు లేదా తగ్గిపోయిందా"
    },
    {
      "t": "03:36",
      "text": "నమస్కారం"
    },
    {
      "t": "03:38",
      "text": "అవును"
    },
    {
      "t": "03:40",
      "text": "ఆ"
    },
    {
      "t": "03:42",
      "text": "ఏం జరుగుతుంది"
    },
    {
      "t": "03:44",
      "text": "ఓకే"
    },
    {
      "t": "03:46",
      "text": "అది పంచాయతీరాజ్ డిపార్ట్మెంటు"
    },
    {
      "t": "03:48",
      "text": "డిస్ట్రిక్ట్ ఎగ్జిక్యూటివ్ ఆఫీసర్"
    },
    {
      "t": "03:50",
      "text": "ఓకే"
    },
    {
      "t": "03:52",
      "text": "థర్టీ ఇయర్స్ నుంచి ఉన్నాయి కదా"
    },
    {
      "t": "03:54",
      "text": "ఫీలింగ్స్ ఫీలింగ్స్ కూడా కంట్రోల్ చేసుకోవచ్చు"
    },
    {
      "t": "03:56",
      "text": "లోకి వెళ్తున్నా"
    },
    {
      "t": "03:58",
      "text": "ఓకే బయట"
    },
    {
      "t": "04:00",
      "text": "ట్రై చేస్తున్నాను"
    },
    {
      "t": "04:02",
      "text": "బయలుదేరినాయి ఇంకా వర్క్ యూనివర్సిటీ"
    },
    {
      "t": "04:04",
      "text": "పిలవచ్చును"
    },
    {
      "t": "04:06",
      "text": "గ్రేట్"
    },
    {
      "t": "04:08",
      "text": "సార్ మీకు వచ్చి ఆమె స్టిల్ వర్క్"
    },
    {
      "t": "04:10",
      "text": "ఈజీగా ఉంటుందని ఎలా అనుకుంటున్నావు"
    },
    {
      "t": "04:12",
      "text": "నేను"
    },
    {
      "t": "04:14",
      "text": "వచ్చినంత మాత్రాన వచ్చాము స్టిల్"
    },
    {
      "t": "04:16",
      "text": "వర్జన్ అని ఉండాలని గ్యారెంటీ లేదు కదా"
    },
    {
      "t": "04:18",
      "text": "ఆ"
    },
    {
      "t": "04:20",
      "text": "ఆ"
    },
    {
      "t": "04:22",
      "text": "ఎస్"
    },
    {
      "t": "04:24",
      "text": "ఆ బికెట్"
    },
    {
      "t": "04:26",
      "text": "నాకు పెళ్ళంటేనే"
    },
    {
      "t": "04:28",
      "text": "పెద్ద కంపెనీ అని కూడా లేరు"
    },
    {
      "t": "04:30",
      "text": "ఓకే"
    },
    {
      "t": "04:32",
      "text": "ఓకే"
    },
    {
      "t": "04:34",
      "text": "ప్లేస్"
    },
    {
      "t": "04:36",
      "text": "లేదంటే మరీ ఇంటర్మీడియట్ చదువుతున్నాం"
    },
    {
      "t": "04:38",
      "text": "మరి పెళ్ళి చేసుకోవాలా మరి"
    },
    {
      "t": "04:40",
      "text": "టైప్ ఎక్కువ అయిపోద్ది"
    },
    {
      "t": "04:42",
      "text": "అది కాదు ఇంటర్నెట్ అంటే"
    },
    {
      "t": "04:44",
      "text": "అమ్మాయికి సేవంతిలు ఉంటాయి అన్నమాట"
    },
    {
      "t": "04:46",
      "text": "ఎంత ఎట్లీస్ట్ అన్నా"
    },
    {
      "t": "04:48",
      "text": "అమ్మాయి ఎంత లేట్ ఎక్క స్కూల్ పోయినా"
    },
    {
      "t": "04:50",
      "text": "సెవెంటీన్ ఇయర్స్ కంటే ఎక్కువ ఉండవు"
    },
    {
      "t": "04:52",
      "text": "ఉంటానా అవును అవును"
    },
    {
      "t": "04:54",
      "text": "సెవెంటీన్ ప్లస్ నీకంటే ఫిఫ్టీన్"
    },
    {
      "t": "04:56",
      "text": "ఫిఫ్టీ పర్సెంట్ డిఫరెన్స్"
    },
    {
      "t": "04:58",
      "text": "అవును"
    },
    {
      "t": "05:00",
      "text": "అంత జాబ్ ఇప్పుడు ఎవరు చేసుకుంటారు అబ్బాయి"
    },
    {
      "t": "05:02",
      "text": "అవునవును తెలుసు"
    },
    {
      "t": "05:04",
      "text": "తెలుసు జస్ట్ ఫైవ్ ఇయర్స్"
    },
    {
      "t": "05:06",
      "text": "గ్యాప్ కూడా తీసుకుంటలేదు వీళ్ళు సామాను"
    },
    {
      "t": "05:08",
      "text": "వన్ టూ సో ఈక్వల్ ఏజ్"
    },
    {
      "t": "05:10",
      "text": "అంతే సేవియర్"
    },
    {
      "t": "05:12",
      "text": "సరే"
    },
    {
      "t": "05:14",
      "text": "అంటే ఇక్కడ ఎట్లా ఉంటుందంటే"
    },
    {
      "t": "05:16",
      "text": "సేమ్ ఏజెంట్కో"
    },
    {
      "t": "05:18",
      "text": "ఆ"
    },
    {
      "t": "05:20",
      "text": "అండర్స్టాండింగ్ లెవెల్స్ సేమ్ ఉంటాయి"
    },
    {
      "t": "05:22",
      "text": "అక్షర"
    },
    {
      "t": "05:24",
      "text": "అదే"
    },
    {
      "t": "05:26",
      "text": "ఇది"
    },
    {
      "t": "05:28",
      "text": "ఆ అమ్మాయి కొంచెం మనకంటే ఫైవ్ ఇయర్స్"
    },
    {
      "t": "05:30",
      "text": "ఎక్కువగానే ఉంటారు ఆలోచనలు"
    },
    {
      "t": "05:32",
      "text": "ఏమున్నా మనం అనుకుంటాం కానీ"
    },
    {
      "t": "05:34",
      "text": "అది ఫైవ్ ఇయర్స్ కంటే"
    },
    {
      "t": "05:36",
      "text": "ఎక్కువసేపు హెల్ప్ చేయాలి మైండ్ సెట్ కూడా"
    },
    {
      "t": "05:38",
      "text": "ఆశయం ఉండదు సో"
    },
    {
      "t": "05:40",
      "text": "చేంజ్ అవుతుంది ఒకటి మధ్యలో దశాబ్దం"
    },
    {
      "t": "05:42",
      "text": "అన్నట్టు ఉంటాయి"
    },
    {
      "t": "05:44",
      "text": "ఏం సార్"
    },
    {
      "t": "05:46",
      "text": "నాకు ఉండే సౌండ్స్ మేబీ"
    },
    {
      "t": "05:48",
      "text": "ఎయిట్ ఇయర్స్ గ్యాప్"
    },
    {
      "t": "05:50",
      "text": "అంటే మీకు మ్యారీడా"
    },
    {
      "t": "05:52",
      "text": "మ్యారేజ్ అనేది బెటర్"
    },
    {
      "t": "05:54",
      "text": "చిన్ని మొబైల్"
    },
    {
      "t": "05:56",
      "text": "అంటే డైవర్స్ అయిందా"
    },
    {
      "t": "05:58",
      "text": "ఆ"
    },
    {
      "t": "06:00",
      "text": "ఓకే ఓకే సారీ"
    },
    {
      "t": "06:02",
      "text": "ఎందుకు సారీ"
    },
    {
      "t": "06:04",
      "text": "నేను చాలా హ్యాపీగా ఉన్నాను ఇప్పుడు"
    },
    {
      "t": "06:06",
      "text": "మీరు అలాంటి"
    },
    {
      "t": "06:08",
      "text": "అక్కడ నాకు టెంప్ట్ అవుతూ ఉంది"
    },
    {
      "t": "06:10",
      "text": "చూపిస్తాను"
    },
    {
      "t": "06:12",
      "text": "మమ్మీ వాయిస్ మీతో మాట్లాడతాను"
    },
    {
      "t": "06:14",
      "text": "ఒకటే ఓపెన్గా"
    },
    {
      "t": "06:16",
      "text": "నాకు ముందు ఫీలింగ్స్ ఎక్కువ ఉన్నాయా"
    },
    {
      "t": "06:18",
      "text": "మీ వాయిస్ ఎక్కువ ఉంటే ఇంకా అటెంప్ట్ అవుతుంది"
    },
    {
      "t": "06:20",
      "text": "ఓకే"
    },
    {
      "t": "06:22",
      "text": "ఓకే"
    },
    {
      "t": "06:24",
      "text": "ఓకే"
    },
    {
      "t": "06:26",
      "text": "అంతే"
    },
    {
      "t": "06:28",
      "text": "చెప్పండి ఇంకా"
    },
    {
      "t": "06:30",
      "text": "చెప్పాలి"
    },
    {
      "t": "06:32",
      "text": "ఓకే"
    },
    {
      "t": "06:34",
      "text": "అందుకే నా ఫుల్"
    },
    {
      "t": "06:36",
      "text": "రిలీజ్ కంట్రోల్ చేసుకున్న గ్యాప్ తీసుకున్నంత"
    },
    {
      "t": "06:38",
      "text": "నా గర్ల్ ఫ్రెండ్ గర్ల్ ఫ్రెండ్ ఎవరూ లేరు"
    },
    {
      "t": "06:40",
      "text": "ఆహా"
    },
    {
      "t": "06:42",
      "text": "ఓకే"
    },
    {
      "t": "06:44",
      "text": "నీకు ఎవరు లైన్ వేసి ఉండేరా"
    },
    {
      "t": "06:46",
      "text": "నార్త్"
    },
    {
      "t": "06:48",
      "text": "లేదు"
    },
    {
      "t": "06:50",
      "text": "ఎందుకంటే మన వెనకాల చాలా"
    },
    {
      "t": "06:52",
      "text": "అలా స్టోరీస్ జరుగుతూ ఉంటాయి కదా అవన్నీ మన వల్ల"
    },
    {
      "t": "06:54",
      "text": "అందుకోసం"
    },
    {
      "t": "06:56",
      "text": "ఏం చేస్తున్నారు"
    },
    {
      "t": "06:58",
      "text": "ఏమి లేదండి"
    },
    {
      "t": "07:00",
      "text": "అందుకని"
    },
    {
      "t": "07:02",
      "text": "అంటే లేచి వర్క్ చేసుకుంటున్నారా"
    },
    {
      "t": "07:04",
      "text": "చిల్లాన్పేట"
    },
    {
      "t": "07:06",
      "text": "సిల్వర్ పెడ్ వర్క్ అయిపోయింది కొంచెం"
    },
    {
      "t": "07:08",
      "text": "ఓకే ఓకే"
    },
    {
      "t": "07:10",
      "text": "ఈ టైంలో వర్క్ ఏంటండి అవునురా"
    },
    {
      "t": "07:12",
      "text": "మేము పాపం మీరు వర్క్ చేసుకునే వాళ్ళం కదా"
    },
    {
      "t": "07:14",
      "text": "ఇది"
    },
    {
      "t": "07:16",
      "text": "నాకంటే టెన్ ఓ క్లాక్ ఆఫీసు"
    },
    {
      "t": "07:18",
      "text": "ఓకే"
    },
    {
      "t": "07:20",
      "text": "నాకు యాక్చువల్లీ స్లీపింగ్"
    },
    {
      "t": "07:22",
      "text": "కడుపు నిద్ర రాదు"
    },
    {
      "t": "07:24",
      "text": "ఆహా"
    },
    {
      "t": "07:26",
      "text": "రెండవది"
    },
    {
      "t": "07:28",
      "text": "మీరు నా ఇంటికి వెళ్ళిన సమయం"
    },
    {
      "t": "07:30",
      "text": "చాలా దూరంగా ఉన్నారు కదా మరి సెక్స్ ఎవరితో చేయలేదు"
    },
    {
      "t": "07:32",
      "text": "లేదా"
    },
    {
      "t": "07:34",
      "text": "జస్ట్ సిక్స్ మంత్స్ అంట"
    },
    {
      "t": "07:36",
      "text": "ఓకే ఈ సిక్స్ మంత్స్"
    },
    {
      "t": "07:38",
      "text": "మంచి నోస్ ఎక్సా"
    },
    {
      "t": "07:40",
      "text": "అమ్మ"
    },
    {
      "t": "07:42",
      "text": "పర్లేదు అంటే నేను అయితే"
    },
    {
      "t": "07:44",
      "text": "ఓపెన్గా చెప్పేసిన నాకు వినాలని"
    },
    {
      "t": "07:46",
      "text": "ఉంది ఏమిటో చెప్పండి"
    },
    {
      "t": "07:48",
      "text": "ఇది"
    },
    {
      "t": "07:50",
      "text": "చేసేలా"
    },
    {
      "t": "07:52",
      "text": "లేదండి"
    },
    {
      "t": "07:54",
      "text": "పర్లేదు చెప్పు అబ్బా"
    },
    {
      "t": "07:56",
      "text": "చాలా ఇంట్రెస్ట్గా ఉంది"
    },
    {
      "t": "07:58",
      "text": "ఏమనుకోండి"
    },
    {
      "t": "08:00",
      "text": "లైవ్లో సిక్స్ పాయింట్"
    },
    {
      "t": "08:02",
      "text": "నాకు హ్యాపీనిచ్చేవి చాలా"
    },
    {
      "t": "08:04",
      "text": "చాలా ఉన్నాయి కానీ"
    },
    {
      "t": "08:06",
      "text": "ప్రజెంట్ అయితే ఆలోచనలు లేవు"
    },
    {
      "t": "08:08",
      "text": "ఓకే"
    },
    {
      "t": "08:10",
      "text": "కొంచెం ఏమన్నా అలాంటి ఆలోచనలు"
    },
    {
      "t": "08:12",
      "text": "అంటే నాలాంటి"
    },
    {
      "t": "08:14",
      "text": "ఏమంటారు నెల అంతా తినడానికి అవకాశం"
    },
    {
      "t": "08:16",
      "text": "మీ వర్క్ చేస్తాను నీకోసం వస్తాను"
    },
    {
      "t": "08:18",
      "text": "తీసుకోండి"
    },
    {
      "t": "08:20",
      "text": "వర్జిన్గా ఉంటుందాం కదా ఉండవచ్చుగా"
    },
    {
      "t": "08:22",
      "text": "ఓకే"
    },
    {
      "t": "08:24",
      "text": "అంతేనెల"
    },
    {
      "t": "08:26",
      "text": "స్టిల్ వర్జిన్ వదలగానే ఉండదు"
    },
    {
      "t": "08:28",
      "text": "ముందు ఎందుకు వచ్చేసుకుంటాను"
    },
    {
      "t": "08:30",
      "text": "నేను ఉండలేను అందుకోసమే"
    },
    {
      "t": "08:32",
      "text": "అడుగుతున్నాను"
    },
    {
      "t": "08:34",
      "text": "ఫోర్"
    },
    {
      "t": "08:36",
      "text": "హలో"
    },
    {
      "t": "08:38",
      "text": "మాలాంటి వాడికి ఒక అవకాశం ఇవ్వచ్చు కదా"
    },
    {
      "t": "08:40",
      "text": "ఓకే"
    },
    {
      "t": "08:42",
      "text": "నేను ఆ టైపు కాదు కదండీ"
    },
    {
      "t": "08:44",
      "text": "ఏది"
    },
    {
      "t": "08:46",
      "text": "ఆడుకుంటున్నాం సారీ"
    },
    {
      "t": "08:48",
      "text": "ఇంకా"
    },
    {
      "t": "08:50",
      "text": "ఏజ్ ఎంత"
    },
    {
      "t": "08:52",
      "text": "నాది కరెక్ట్"
    },
    {
      "t": "08:54",
      "text": "ఇది"
    },
    {
      "t": "08:56",
      "text": "థర్టీ టూ"
    },
    {
      "t": "08:58",
      "text": "ఓకే ఓకే అయితే మీరు కూడా త"
    },
    {
      "t": "09:00",
      "text": "తీసుకెళ్ళినాను"
    },
    {
      "t": "09:02",
      "text": "బాగున్నాను అనిపించింది"
    },
    {
      "t": "09:04",
      "text": "ఓకే"
    },
    {
      "t": "09:06",
      "text": "నెంబర్ ఇస్తాను నోట్ చేసుకోండి మీకు ఎప్పుడన్నా"
    },
    {
      "t": "09:08",
      "text": "వీలున్నప్పుడు ఒకసారి అట్లా మెసేజ్ చేయండి"
    },
    {
      "t": "09:10",
      "text": "ఇంతకీ మీ పేరు"
    },
    {
      "t": "09:12",
      "text": "కానీ వద్దులే నువ్వు"
    },
    {
      "t": "09:14",
      "text": "ఓకే"
