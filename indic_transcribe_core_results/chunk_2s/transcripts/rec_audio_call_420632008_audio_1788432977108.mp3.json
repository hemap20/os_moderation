  "segments": [
    {
      "t": "00:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "ஹலோ ஹலோ"
    },
    {
      "t": "00:04",
      "text": "கேட்குதா ஹாய்"
    },
    {
      "t": "00:06",
      "text": "ஹாய்"
    },
    {
      "t": "00:08",
      "text": "ஓகே"
    },
    {
      "t": "00:10",
      "text": "கிருஷ்ணா டெலிவரி"
    },
    {
      "t": "00:12",
      "text": "சென்னை"
    },
    {
      "t": "00:14",
      "text": "சரி சார்"
    },
    {
      "t": "00:16",
      "text": "என்ன பண்ணுறீங்க"
    },
    {
      "t": "00:18",
      "text": "ஆ ஓகே"
    },
    {
      "t": "00:20",
      "text": "பண்ணுறேன் நீங்கள்"
    },
    {
      "t": "00:22",
      "text": "சரி ஹஸ்பண்ட்"
    },
    {
      "t": "00:24",
      "text": "இல்லையே ஹஸ்பண்ட் இல்லையே"
    },
    {
      "t": "00:26",
      "text": "ஓகேவா"
    },
    {
      "t": "00:28",
      "text": "வேறு எதுவும் திங்கல"
    },
    {
      "t": "00:30",
      "text": "சிங்கிள் தான்"
    },
    {
      "t": "00:32",
      "text": "சரி சரி"
    },
    {
      "t": "00:34",
      "text": "அப்புறம் சாப்பிட்டீங்க"
    },
    {
      "t": "00:36",
      "text": "ம் சாப்பிட்டு"
    },
    {
      "t": "00:38",
      "text": "நீங்க சாப்பிடுங்களா ம்"
    },
    {
      "t": "00:40",
      "text": "சப்போஸ் சப்போஸ்"
    },
    {
      "t": "00:42",
      "text": "உங்கள் பேர்"
    },
    {
      "t": "00:44",
      "text": "என் பேர் ராம்"
    },
    {
      "t": "00:46",
      "text": "ஆ"
    },
    {
      "t": "00:48",
      "text": "என்ன ராம் பண்ணுறீங்க"
    },
    {
      "t": "00:50",
      "text": "என்ன ராம் பண்ணுறீங்க சும்மா தான் ராம் இருக்குது"
    },
    {
      "t": "00:52",
      "text": "ஆமாம்"
    },
    {
      "t": "00:54",
      "text": "ஏன் அப்படி சிரிக்கிறீங்க"
    },
    {
      "t": "00:56",
      "text": "ஏதோ காமெடியாக சொல்லிட்டானா"
    },
    {
      "t": "00:58",
      "text": "இல்லை இல்லை ஆஹா"
    },
    {
      "t": "01:00",
      "text": "அப்புறம்"
    },
    {
      "t": "01:02",
      "text": "என்ன ஒர்க் பண்றீங்க ஒர்க்"
    },
    {
      "t": "01:04",
      "text": "பண்றீங்களா இல்லை வீட்டில் சும்மா தான் இருக்கீங்களா"
    },
    {
      "t": "01:06",
      "text": "சும்மா தான் இருக்கேன் வீட்டில்"
    },
    {
      "t": "01:08",
      "text": "தோத்துக்கு என்ன பண்றீங்க"
    },
    {
      "t": "01:10",
      "text": "சோ"
    },
    {
      "t": "01:12",
      "text": "தோத்துக்கு அதுக்காக வேலைக்கு போகலன்னா தோத்துக்கு எதுவும் பண்ண முடியாது"
    },
    {
      "t": "01:14",
      "text": "புரியுதுங்களா அப்புறம்"
    },
    {
      "t": "01:16",
      "text": "யார் சோறு போடுவா ஆள் இருக்காங்களா சோறு போடு"
    },
    {
      "t": "01:18",
      "text": "சோறு"
    },
    {
      "t": "01:20",
      "text": "ஓரளவுக்கு சோர்ஸ் இருக்குது அதனால்"
    },
    {
      "t": "01:22",
      "text": "ஒன்றும் ப்ராப்ளம் இல்லை"
    },
    {
      "t": "01:24",
      "text": "பரவாயில்லைங்க குட் இல்லை"
    },
    {
      "t": "01:26",
      "text": "அப்போ எந்த கம்பெனி"
    },
    {
      "t": "01:28",
      "text": "பண்டமே இல்லையா எந்த இஎம்ஐ கட்டணும்"
    },
    {
      "t": "01:30",
      "text": "எந்த தேதியும் இல்லை சீரியஸாக ரொம்ப"
    },
    {
      "t": "01:32",
      "text": "ஹாப்பியா இருக்கீங்களா அப்பா"
    },
    {
      "t": "01:34",
      "text": "எந்த தமிழ்"
    },
    {
      "t": "01:36",
      "text": "மட்டும் நம்ம உருவாக்கிறது இல்லை அதனால தான் ஹாப்பி"
    },
    {
      "t": "01:38",
      "text": "ஹாப்பியாக இருக்கிறேன் மேபி"
    },
    {
      "t": "01:40",
      "text": "உங்கள்கிட்ட எல்லாமே இருக்கும் அதனால அது கம்மி"
    },
    {
      "t": "01:42",
      "text": "உங்களுக்கு தேவையில்லை ரைட்"
    },
    {
      "t": "01:44",
      "text": "எஸ்"
    },
    {
      "t": "01:46",
      "text": "யா அப்போ ஃபேமிலி கொஞ்சம் பெத்த"
    },
    {
      "t": "01:48",
      "text": "ஃபேமிலியாக இருப்பாங்க"
    },
    {
      "t": "01:50",
      "text": "பெஸ்ட்டு ஃபேமிலினால் என்ன அவங்க ஒய்ஃபு"
    },
    {
      "t": "01:52",
      "text": "பையன் ரெண்டு வயசில்"
    },
    {
      "t": "01:54",
      "text": "ம்"
    },
    {
      "t": "01:56",
      "text": "அவங்க மட்டும் தான் அவங்க வேலையை அப்படியே அப்படியே போயிட்டுருக்கு"
    },
    {
      "t": "01:58",
      "text": "இந்த ப்ராப்ளம் அந்த ப்ராப்ளம்"
    },
    {
      "t": "02:00",
      "text": "ஆனந்த்"
    },
    {
      "t": "02:02",
      "text": "ஏங்க மேம்"
    },
    {
      "t": "02:04",
      "text": "இருந்து எப்படிங்க வேலைக்கு போகாமல்"
    },
    {
      "t": "02:06",
      "text": "ஆ ரன் பண்ணுறீங்க"
    },
    {
      "t": "02:08",
      "text": "அது நடக்குது ஏன்"
    },
    {
      "t": "02:10",
      "text": "ரன் பண்ண முடியாதா நான் பேமிலியா"
    },
    {
      "t": "02:12",
      "text": "ஒன்று பிஸ்னஸ் பண்ண"
    },
    {
      "t": "02:14",
      "text": "பண்ணனும் இல்லைன்னா ஏதாவது"
    },
    {
      "t": "02:16",
      "text": "வந்து இன்கம் சோர்ஸ் வரதுக்கு ஏதாவது"
    },
    {
      "t": "02:18",
      "text": "இருக்கணும் ஏதாவது இன்கம் வருதா"
    },
    {
      "t": "02:20",
      "text": "வர வைக்கணும் இதுக்கப்புறம்"
    },
    {
      "t": "02:22",
      "text": "அப்புறந்தான்"
    },
    {
      "t": "02:24",
      "text": "ஆ பெரிய லெவலில்"
    },
    {
      "t": "02:26",
      "text": "எனக்கு தெரிஞ்சு இந்த வேர்ல்டுலேயே ரொம்ப ஹாப்பியாக"
    },
    {
      "t": "02:28",
      "text": "பெஸ்ட்டு மேன் தான் ராம் தான்"
    },
    {
      "t": "02:30",
      "text": "ஐயையோ என்னடா இது"
    },
    {
      "t": "02:32",
      "text": "போட்டுக்கிட்டு இருக்காங்க நீ எவ்வளோ"
    },
    {
      "t": "02:34",
      "text": "ஜாலியாக இருக்கீங்க வேலைக்கு போகாமல்"
    },
    {
      "t": "02:36",
      "text": "சரி"
    },
    {
      "t": "02:38",
      "text": "அப்புறம் உங்களுக்கு எப்படி"
    },
    {
      "t": "02:40",
      "text": "யூடியூப் வீடியோ"
    },
    {
      "t": "02:42",
      "text": "நார்மலாக போயிட்டுருக்கு"
    },
    {
      "t": "02:44",
      "text": "ரொம்ப சொல்லிக்கிற அளவுக்குலாம் இல்லை"
    },
    {
      "t": "02:46",
      "text": "ம்"
    },
    {
      "t": "02:48",
      "text": "பேர்"
    },
    {
      "t": "02:50",
      "text": "ஸ்வேதா மை நேம் இஸ் ஸ்வேதா நான்"
    },
    {
      "t": "02:52",
      "text": "சென்னை தான்"
    },
    {
      "t": "02:54",
      "text": "ம்ஹும்"
    },
    {
      "t": "02:56",
      "text": "சரிங்க சார்"
    },
    {
      "t": "02:58",
      "text": "என்ன பண்ணுறீங்க"
    },
    {
      "t": "03:00",
      "text": "நான்"
    },
    {
      "t": "03:02",
      "text": "ஆ ஒர்க் பண்ணுறேன் நான் அக்கௌண்டன்ட்டாக இருக்கேன்"
    },
    {
