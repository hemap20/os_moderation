    },
    {
      "t": "04:56",
      "text": "ஓஹோ"
    },
    {
      "t": "04:58",
      "text": "ஓகேங்களா"
    },
    {
      "t": "05:00",
      "text": "வடபழனி"
    },
    {
      "t": "05:02",
      "text": "அவ்வளோ தான் அட்ரெஸ்லாம் வேணுமா என்ன"
    },
    {
      "t": "05:04",
      "text": "ட்ரெஸ்லாம் வேணாம்"
    },
    {
      "t": "05:06",
      "text": "வடை பழனி"
    },
    {
      "t": "05:08",
      "text": "குத்தாத வீடே இல்லை அதனால எந்த"
    },
    {
      "t": "05:10",
      "text": "கெட்ட காரணங்கள்"
    },
    {
      "t": "05:12",
      "text": "ஆ மேபி எனக்கு"
    },
    {
      "t": "05:14",
      "text": "எனக்கு நேட்டிவ் பிடிச்சிங்க நைன்"
    },
    {
      "t": "05:16",
      "text": "இங்கே வந்து ஃபோர் இயர்ஸ் ஆகுது"
    },
    {
      "t": "05:18",
      "text": "ஓகே"
    },
    {
      "t": "05:20",
      "text": "ம்"
    },
    {
      "t": "05:22",
      "text": "ம்"
    },
    {
      "t": "05:24",
      "text": "ஆ"
    },
    {
      "t": "05:26",
      "text": "நான் மாற்றிட்டேன் உங்களுக்கு"
    },
    {
      "t": "05:28",
      "text": "நான் வாய்ப்பு தரலை என்ன பிடிக்கும்"
    },
    {
      "t": "05:30",
      "text": "இப்போது"
    },
    {
      "t": "05:32",
      "text": "என்ன ஆகிப்போச்சே ஆகிப்போச்சே"
    },
    {
      "t": "05:34",
      "text": "எனக்கு என்ன பிடிக்கும் எனக்கு நிறையா"
    },
    {
      "t": "05:36",
      "text": "நிறைய டிராவல் பண்ணுறது"
    },
    {
      "t": "05:38",
      "text": "ரொம்ப பிடிக்கும் ராம் நிறைய ட்ராவல்ஸ்"
    },
    {
      "t": "05:40",
      "text": "ரொம்ப பிடிக்கும்"
    },
    {
      "t": "05:42",
      "text": "ஃபுட் எக்ஸ்பிரஸ்"
    },
    {
      "t": "05:44",
      "text": "சப்போர்ட் பண்ண ரொம்ப பிடிக்கும்"
    },
    {
      "t": "05:46",
      "text": "போலாமான்னு கேட்டேன் ட்ராவல்"
    },
    {
      "t": "05:48",
      "text": "சாப்பிடுங்க"
    },
    {
      "t": "05:50",
      "text": "நான் இன்னும் உங்கள் கூட வரணும்"
    },
    {
      "t": "05:52",
      "text": "ஆ ஆ ஆ ஆ ஆ ஆ ஆ"
    },
    {
      "t": "05:54",
      "text": "கேட்குறது என் உரிமைங்க வரதும்"
    },
    {
      "t": "05:56",
      "text": "வரது உங்களோட உயரிய இன்ட்ரெஸ்ட்டுங்க"
    },
    {
      "t": "05:58",
      "text": "ஆ ஆ ஆ கண்டிப்பாக"
    },
    {
      "t": "06:00",
      "text": "கண்டிப்பாக அவங்க கூட வர மாட்டேங்கிறாங்க"
    },
    {
      "t": "06:02",
      "text": "யாருன்னு எனக்கு தெரியாது"
    },
    {
      "t": "06:04",
      "text": "சரி சரி"
    },
    {
      "t": "06:06",
      "text": "ம்"
    },
    {
      "t": "06:08",
      "text": "சரிங்க சார்"
    },
    {
      "t": "06:10",
      "text": "சரிங்க வேறு"
    },
    {
      "t": "06:12",
      "text": "சொல்லுங்க மேம்"
    },
    {
      "t": "06:14",
      "text": "இல்லை அப்படி இப்போ சாமி நல்லா இருக்காங்களா"
    },
    {
      "t": "06:16",
      "text": "வயிறு நல்லா போயிட்டுருக்கா"
    },
    {
      "t": "06:18",
      "text": "ம்"
    },
    {
      "t": "06:20",
      "text": "ஒய்ஃப் எடுக்கிறப்ப எதுக்கு இந்த ஆப்க்கு வந்தீங்க"
    },
    {
      "t": "06:22",
      "text": "யா"
    },
    {
      "t": "06:24",
      "text": "கேட்குறேன்"
    },
    {
      "t": "06:26",
      "text": "வயசு இருந்தாலும் இல்லைனாலும்"
    },
    {
      "t": "06:28",
      "text": "மற்றவங்களுக்கு நல்லா இருக்கும் அந்த ஆப்பு"
    },
    {
      "t": "06:30",
      "text": "ஆ"
    },
    {
      "t": "06:32",
      "text": "மேபி நிறைய"
    },
    {
      "t": "06:34",
      "text": "இல்லையா இதில் வந்து"
    },
    {
      "t": "06:36",
      "text": "கல்யாணம் ஆகாதவங்க தான் வராங்க நீங்கள் தான்"
    },
    {
      "t": "06:38",
      "text": "ஃபர்ஸ்ட் கால் எனக்கு கல்யாணம் ஆனவங்க"
    },
    {
      "t": "06:40",
      "text": "அதனால நான் கேட்குறேன் நான் இன்னைக்கு தான் ஓபன் பண்ணேன்"
    },
    {
      "t": "06:42",
      "text": "ஒரு நாலு கால் டீ"
    },
    {
      "t": "06:44",
      "text": "கேட்டிருக்கேன் நாலுமே சிங்கிள் பர்சனாக தான்"
    },
    {
      "t": "06:46",
      "text": "ஓகேவா நீங்கள் தான் மேரிடு"
    },
    {
      "t": "06:48",
      "text": "நான் எப்போ அடுத்தது வரைக்கும் அதே"
    },
    {
      "t": "06:50",
      "text": "அதே தான் அந்த பசங்களும் நோக்கத்துக்கு வந்திருக்காங்க"
    },
    {
      "t": "06:52",
      "text": "அதனால அந்த இன்வென்டா திருப்பி வந்து"
    },
    {
      "t": "06:54",
      "text": "அதனால என்ன என்ன"
    },
    {
      "t": "06:56",
      "text": "என்ன நோக்கம்"
    },
    {
      "t": "06:58",
      "text": "டேட் பண்ணலான்ட்டு டேட்"
    },
    {
      "t": "07:00",
      "text": "பண்ணி லவ் பண்ணி"
    },
    {
      "t": "07:02",
      "text": "அந்த மாதிரி"
    },
    {
      "t": "07:04",
      "text": "சரி"
    },
    {
      "t": "07:06",
      "text": "ம்"
    },
    {
      "t": "07:08",
      "text": "டிஃப்ரெண்ட்டாக தெரியுது எனக்கு"
    },
    {
      "t": "07:10",
      "text": "வந்தது அட்ராக்ட் பண்ணி"
    },
    {
      "t": "07:12",
      "text": "கங்கிராஜுலேஷன்"
    },
    {
      "t": "07:14",
      "text": "சரி"
    },
    {
      "t": "07:16",
      "text": "தொந்தரவாக க்ளோஸ் பண்ணால் சொல்லாதீங்க"
    },
    {
      "t": "07:18",
      "text": "வந்த நாளுமே மரணம் மொக்க எல்லாம் லஸ்ட்டு"
    },
    {
      "t": "07:20",
      "text": "மட்டும்தான் எதுவுமே லவ்வுக்கு தேவை"
    },
    {
      "t": "07:22",
      "text": "இராதுக்கு சொல்லிடா"
    },
    {
      "t": "07:24",
      "text": "ஒன்லி"
    },
    {
      "t": "07:26",
      "text": "ம் லஸ்ட்டுக்கு மட்டும்"
    },
    {
      "t": "07:28",
      "text": "மட்டும்தான் அதுங்களுக்குலாம் தேவை"
    },
    {
      "t": "07:30",
      "text": "அவ்வளோதான் ஒன்லி செக்ஸ் மீல் அவ்வளோதான்"
    },
    {
      "t": "07:32",
      "text": "சரி சார்"
    },
    {
      "t": "07:34",
      "text": "ம் அதில் வந்து"
    },
    {
      "t": "07:36",
      "text": "சரி நீங்கள் எதுக்காக வந்தீங்க மேப்"
    },
    {
      "t": "07:38",
      "text": "எனக்கு ஏன்னா ஒரு நல்ல கேர்ள் ஃப்ரெண்டு கிடைக்கும்"
    },
    {
      "t": "07:40",
      "text": "இப்போங்க ட்ராவல் பைக் ட்ராவல் போகலாம்"
    },
    {
      "t": "07:42",
      "text": "இல்லைங்கன்னா ஒரு ஹில் ஸ்டேஷன் கூப்பிட்டு போகலாம்"
    },
    {
      "t": "07:44",
      "text": "நான் பப்புக்கு கூப்பிட்டு போகிறேன்"
    },
    {
      "t": "07:46",
      "text": "ஓ அந்த மாதிரி"
    },
    {
      "t": "07:48",
      "text": "ஆஃபர் வச்சுருக்குப்பா"
    },
    {
      "t": "07:50",
      "text": "எஃப்ஐஆர் ஆனாலும் சரி இல்லை"
    },
    {
      "t": "07:52",
      "text": "லைஃப் பார்ட்னரை கண்டினியூ பண்ணாலும் சரி அதை அவங்க"
    },
    {
      "t": "07:54",
      "text": "விருப்பம் அது எல்லாம் கிடைக்கும்"
    },
    {
      "t": "07:56",
      "text": "பாருங்க பார்க்கறேன் மற்றபடி வேறு ஒன்றும் இல்லை"
    },
    {
      "t": "07:58",
      "text": "ஓகே ஓகே ஓகே ஆல் தி பெஸ்ட்"
    },
    {
      "t": "08:00",
      "text": "கிடப்பாங்க பட் ஆனால் ஒயிட் இருக்கிறப்போ"
    },
    {
      "t": "08:02",
      "text": "பண்ணுறது தப்பு இல்லையா"
    },
    {
      "t": "08:04",
      "text": "அப்படி"
    },
    {
      "t": "08:06",
      "text": "தெரியல"
    },
    {
      "t": "08:08",
      "text": "ஆமாம் மேம் நான் பேசுகிறேன் நீங்கள் தப்பாக எடுத்துக்காதீங்க"
    },
    {
      "t": "08:10",
      "text": "ஏன்னா நான் அலோவ் பண்ண மாட்டேன்"
    },
    {
      "t": "08:12",
      "text": "அப்படி இருந்தால் அதனால் கேட்குறேன்"
    },
    {
      "t": "08:14",
      "text": "சரி சார்"
    },
    {
      "t": "08:16",
      "text": "சரிங்க சார்"
    },
    {
      "t": "08:18",
      "text": "உங்களுக்கு என்ன இன்ட்ரெஸ்ட் இருக்கா"
    },
    {
      "t": "08:20",
      "text": "சரிங்க சார்"
    },
    {
      "t": "08:22",
      "text": "எனக்கு இன்ட்ரெஸ்ட் இருக்கு அதுக்கு தான் இந்த ஆப் கொஞ்சம்"
    },
    {
      "t": "08:24",
      "text": "பட் அதை மேரிட் பர்சன் கூட"
    },
    {
      "t": "08:26",
      "text": "டிராவல் பண்ணவோ ஒரு ஏசி ட்ரிப் மைண்ட் அண்ட்"
    },
    {
      "t": "08:28",
      "text": "பண்ணவும் எனக்கு இன்ட்ரெஸ்ட் இல்லை"
    },
    {
      "t": "08:30",
      "text": "சரி ஓகே சரி உடம்ப பார்த்துக்கோங்க"
    },
    {
      "t": "08:32",
      "text": "பீச்சில் எப்போயாவது மறுபடியும்"
    },
    {
      "t": "08:34",
      "text": "பேசுற சந்தர்ப்பம்"
    },
    {
      "t": "08:36",
      "text": "யா யா யா பாய் பாய்"
    },
    {
      "t": "08:38",
      "text": "ம்"
    },
    {
      "t": "08:40",
      "text": "ம்"
    }
  ],
