{
  "file_id": "rec_audio_call_427307087_audio_1789058314132.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 716.987,
  "processing_time_sec": 44.062093019485474,
  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "హాయ్ లక్ష్మి"
    },
    {
      "t": "00:04",
      "text": "హలో"
    },
    {
      "t": "00:06",
      "text": "లక్ష్మి"
    },
    {
      "t": "00:08",
      "text": "లక్ష్మి"
    },
    {
      "t": "00:10",
      "text": "అవునండి"
    },
    {
      "t": "00:12",
      "text": "మీరు"
    },
    {
      "t": "00:14",
      "text": "నా పేరు దీపిక"
    },
    {
      "t": "00:16",
      "text": "ఓకే నేరేడా"
    },
    {
      "t": "00:18",
      "text": "ఆ"
    },
    {
      "t": "00:20",
      "text": "ఊ అంటారు"
    },
    {
      "t": "00:22",
      "text": "అప్పుడు ఊహ అంటారు ఏంటండి ఒక"
    },
    {
      "t": "00:24",
      "text": "చెప్పండి"
    },
    {
      "t": "00:26",
      "text": "పాటు"
    },
    {
      "t": "00:28",
      "text": "అయ్యిందా"
    },
    {
      "t": "00:30",
      "text": "కాలేజ్ దాన్ మెరైన్"
    },
    {
      "t": "00:32",
      "text": "రాలేదండి"
    },
    {
      "t": "00:34",
      "text": "మరి అవి ఏంటంటే"
    },
    {
      "t": "00:36",
      "text": "అంటారు మళ్ళీ లేదంటారు"
    },
    {
      "t": "00:38",
      "text": "అన్న"
    },
    {
      "t": "00:40",
      "text": "అట్లా"
    },
    {
      "t": "00:42",
      "text": "అన్నారు మళ్ళా మొహం అన్నారు"
    },
    {
      "t": "00:44",
      "text": "ఎక్కడుందండి మూడిని"
    },
    {
      "t": "00:46",
      "text": "నీ తాత బాబోయ్ నేను అలాగే"
    },
    {
      "t": "00:48",
      "text": "లేదు నాన్న"
    },
    {
      "t": "00:50",
      "text": "సరేలే అక్కడ నుండి"
    },
    {
      "t": "00:52",
      "text": "ప్రైజం"
    },
    {
      "t": "00:54",
      "text": "మాది బట్ హైదరాబాద్లో ఉంటా"
    },
    {
      "t": "00:56",
      "text": "అవునా"
    },
    {
      "t": "00:58",
      "text": "ఎక్కడి నుంచో చెప్"
    },
    {
      "t": "01:00",
      "text": "వచ్చు కదా"
    },
    {
      "t": "01:02",
      "text": "చెప్పాలండి"
    },
    {
      "t": "01:04",
      "text": "అడిగింది రెడ్డిసా"
    },
    {
      "t": "01:06",
      "text": "ఆ"
    },
    {
      "t": "01:08",
      "text": "ఏం లేదు"
    },
    {
      "t": "01:10",
      "text": "కడప మ్యారీడా సింగిలా"
    },
    {
      "t": "01:12",
      "text": "సింగరే"
    },
    {
      "t": "01:14",
      "text": "సరే"
    },
    {
      "t": "01:16",
      "text": "గెలిచేంతగా"
    },
    {
      "t": "01:18",
      "text": "సింగల్ సింగల్"
    },
    {
      "t": "01:20",
      "text": "సింగల్ అయిపోయినాక అదో"
    },
    {
      "t": "01:22",
      "text": "చేసేది ఏంటి అని అన్న రెడీ అయిపోయాడు కదా"
    },
    {
      "t": "01:24",
      "text": "వైఫులు"
    },
    {
      "t": "01:26",
      "text": "పక్కన పెట్టుకొని చేయాలంటే ఎవరు చేయరు కదా"
    },
    {
      "t": "01:28",
      "text": "అంతేలే"
    },
    {
      "t": "01:30",
      "text": "అన్ని"
    },
    {
      "t": "01:32",
      "text": "అంటే అంతే"
    },
    {
      "t": "01:34",
      "text": "అదే"
    },
    {
      "t": "01:36",
      "text": "అరే తీయకండి"
    },
    {
      "t": "01:38",
      "text": "చెప్పు ఇంకేంటి విషయం"
    },
    {
      "t": "01:40",
      "text": "విషయాలు ఎలా ఉన్నాయో ఏం చేస్తున్నావు"
    },
    {
      "t": "01:42",
      "text": "హౌ ఈజ్ యువర్ లైఫ్"
    },
    {
      "t": "01:44",
      "text": "ఫైవ్"
    },
    {
      "t": "01:46",
      "text": "ఓకే"
    },
    {
      "t": "01:48",
      "text": "మామూలుగా"
    },
    {
      "t": "01:50",
      "text": "ఏమైనా"
    },
    {
      "t": "01:52",
      "text": "పొడిచావా గర్ల్ ఫ్రెండ్స్తో"
    },
    {
      "t": "01:54",
      "text": "ఏం కొరతలేదు ఏం చేయలేదు"
    },
    {
      "t": "01:56",
      "text": "లేదండి మేము ఎరకేయించుకుంటాం"
    },
    {
      "t": "01:58",
      "text": "పోలేదు"
    },
    {
      "t": "02:00",
      "text": "ఊరిని నీ ఎందు"
    },
    {
      "t": "02:02",
      "text": "అంతేకాని"
    },
    {
      "t": "02:04",
      "text": "అంటే"
    },
    {
      "t": "02:06",
      "text": "కుదరల తేడా"
    },
    {
      "t": "02:08",
      "text": "ఆ"
    },
    {
      "t": "02:10",
      "text": "కొడిచేదానికి కానీ ఛాన్స్ ఇవ్వాలి"
    },
    {
      "t": "02:12",
      "text": "దొరకాలి కదా ఎవరికైనా ఏది మెసేజ్"
    },
    {
      "t": "02:14",
      "text": "డాన్స్ చేయాలి కదా"
    },
    {
      "t": "02:16",
      "text": "ఓకే అండి"
    },
    {
      "t": "02:18",
      "text": "ఓకే"
    },
    {
      "t": "02:20",
      "text": "ఇంగ్లీష్"
    },
    {
      "t": "02:22",
      "text": "ఓకే"
    },
    {
      "t": "02:24",
      "text": "ట్రై చేయాల్సింది"
    },
    {
      "t": "02:26",
      "text": "ట్రై చేసినా ఎవడు స్నానం చేద్దాం"
    },
    {
      "t": "02:28",
      "text": "వెల్కమ్ టు ది యూటర్న్ అండర్స్టాండ్"
    },
    {
      "t": "02:30",
      "text": "అదే"
    },
    {
      "t": "02:32",
      "text": "అంటే ఈ మనిషి అనుకుంటాం కానీ వాళ్ళ దగ్గర"
    },
    {
      "t": "02:34",
      "text": "ఒకటి ఏం మాట్లాడాలి"
    },
    {
      "t": "02:36",
      "text": "ఆ"
    },
    {
      "t": "02:38",
      "text": "ఓకే"
    },
    {
      "t": "02:40",
      "text": "ఓకే"
    },
    {
      "t": "02:42",
      "text": "నేను అదే ట్రై చేస్తున్నా కానీ అడగకూడదు"
    },
    {
      "t": "02:44",
      "text": "వర్క్ అవుతుంది"
    },
    {
      "t": "02:46",
      "text": "ఇది"
    },
    {
      "t": "02:48",
      "text": "కనీసం యాప్లో మీరు నా శాంపిల్స్"
    },
    {
      "t": "02:50",
      "text": "మంచి స్థాయిలో ఉన్నాను కాబట్టి ఈ యాప్లో కూడా కొట్టవచ్చు"
    },
    {
      "t": "02:52",
      "text": "ఓకే"
    },
    {
      "t": "02:54",
      "text": "ఓకే"
    },
    {
      "t": "02:56",
      "text": "హలో"
    },
    {
      "t": "02:58",
      "text": "ఈ"
    },
    {
      "t": "03:00",
      "text": "చెప్పు"
    },
    {
      "t": "03:02",
      "text": "నేను అప్పుడూనే అటాచ్డ్"
    },
    {
      "t": "03:04",
      "text": "మేము దిక్కుతున్నాము"
    },
    {
      "t": "03:06",
      "text": "అదే"
    },
    {
      "t": "03:08",
      "text": "యా ఫలానా అదృష్టం అండి"
    },
    {
      "t": "03:10",
      "text": "థ్యాంక్స్ సార్"
    },
    {
      "t": "03:12",
      "text": "ఆ"
    },
    {
      "t": "03:14",
      "text": "ఓకే"
    },
    {
      "t": "03:16",
      "text": "ఓకే"
    },
    {
      "t": "03:18",
      "text": "హలో"
    },
    {
      "t": "03:20",
      "text": "హలో"
    },
    {
      "t": "03:22",
      "text": "ఇది"
    },
    {
      "t": "03:24",
      "text": "చెప్పండి"
    },
    {
      "t": "03:26",
      "text": "టాలెంట్"
    },
    {
      "t": "03:28",
      "text": "నారాయణ తేజ"
    },
    {
      "t": "03:30",
      "text": "ఏమి చేయలేదండి"
    },
    {
      "t": "03:32",
      "text": "అందుకే"
    },
    {
      "t": "03:34",
      "text": "నిజమేనండి"
    },
    {
      "t": "03:36",
      "text": "మీరేమన్నా చేశారా"
    },
    {
      "t": "03:38",
      "text": "ఓకే"
    },
    {
      "t": "03:40",
      "text": "ఈ"
    },
    {
      "t": "03:42",
      "text": "మీకేమన్నా అలా అనుభవం ఉందా"
    },
    {
      "t": "03:44",
      "text": "అదే అందులో"
    },
    {
      "t": "03:46",
      "text": "ఇక్కడ"
    },
    {
      "t": "03:48",
      "text": "అబ్బో"
    },
    {
      "t": "03:50",
      "text": "లవ్లీ"
    },
    {
      "t": "03:52",
      "text": "నాకు"
    },
    {
      "t": "03:54",
      "text": "మన బాల్యం లేదు"
    },
    {
      "t": "03:56",
      "text": "ఆ"
    },
    {
      "t": "03:58",
      "text": "ఒకటి ఉంది"
    },
    {
      "t": "04:00",
      "text": "ఎందుకంటే ఒక అబ్బాయిని లవ్ చేసి"
    },
    {
      "t": "04:02",
      "text": "సరే"
    },
    {
      "t": "04:04",
      "text": "ఒకటి చేసినా రెండు చేసినా అంతే"
    },
    {
      "t": "04:06",
      "text": "నువ్వే ఉండగలవు"
    },
    {
      "t": "04:08",
      "text": "ఈ"
    },
    {
      "t": "04:10",
      "text": "మామూలు"
    },
    {
      "t": "04:12",
      "text": "ఆ"
    },
    {
      "t": "04:14",
      "text": "మాకే అనుభవం లేదు"
    },
    {
      "t": "04:16",
      "text": "మళ్ళీ"
    },
    {
      "t": "04:18",
      "text": "దేశానిదేశాని"
    },
    {
      "t": "04:20",
      "text": "ఉమ్"
    },
    {
      "t": "04:22",
      "text": "నన్ను లైక్"
    },
    {
      "t": "04:24",
      "text": "చేసేవాడిని"
    },
    {
      "t": "04:26",
      "text": "ఆ"
    },
    {
      "t": "04:28",
      "text": "లవ్ చేసావా ఏమన్నా"
    },
    {
      "t": "04:30",
      "text": "ఓకే"
    },
    {
      "t": "04:32",
      "text": "ఓకే"
    },
    {
      "t": "04:34",
      "text": "చేసే మోస"
    },
    {
      "t": "04:36",
      "text": "వన్"
    },
    {
      "t": "04:38",
      "text": "అబ్బో"
    },
    {
      "t": "04:40",
      "text": "అంటే మొత్తానికి"
    },
    {
      "t": "04:42",
      "text": "అయితే అతను అవసరం తీర్చుకుని వదిలేశారు అంతే"
    },
    {
      "t": "04:44",
      "text": "వాట్"
    },
    {
      "t": "04:46",
      "text": "భయం కాదు ఆ ఎదురు"
    },
    {
      "t": "04:48",
      "text": "చాలా గొడవలు అయినాయి"
    },
    {
      "t": "04:50",
      "text": "చాలా ప్రేమించేవాడు కానీ గొడవలు"
    },
    {
      "t": "04:52",
      "text": "ఇప్పుడు"
    },
    {
      "t": "04:54",
      "text": "అంటే మీకు నరేజ్ అయింది"
    },
    {
      "t": "04:56",
      "text": "నెంబర్ అంతే కదా"
    },
    {
      "t": "04:58",
      "text": "మ్యారేజ్ దాకా పోయి వెనక్కి వచ్చినాడు"
    },
    {
      "t": "05:00",
      "text": "ఓకే"
    },
    {
      "t": "05:02",
      "text": "ఓకేనా"
    },
    {
      "t": "05:04",
      "text": "అదే కదా"
    },
    {
      "t": "05:06",
      "text": "ఏంటి నాకు అర్థం అవుతుంది"
    },
    {
      "t": "05:08",
      "text": "మరి ఇందాక"
    },
    {
      "t": "05:10",
      "text": "మ్యారేజ్ దాకా వెళ్ళండి"
    },
    {
      "t": "05:12",
      "text": "ఆ"
    },
    {
      "t": "05:14",
      "text": "కానీ కొంచెం నాకైతే"
    },
    {
      "t": "05:16",
      "text": "అయితే మొత్తానికి అయితే మ్యారేజ్ అయింది అనుకుంటున్నాను"
    },
    {
      "t": "05:18",
      "text": "ఎవరికి"
    },
    {
      "t": "05:20",
      "text": "మీకు"
    },
    {
      "t": "05:22",
      "text": "ఇచ్చాను అయిపోయిందా"
    },
    {
      "t": "05:24",
      "text": "చెప్తాను ఎందుకు దాంట్లో పెద్ద ఈ టైం"
    },
    {
      "t": "05:26",
      "text": "టైంలో ఎలా మాట్లాడుతున్నావు కళ"
    },
    {
      "t": "05:28",
      "text": "అదేలే"
    },
    {
      "t": "05:30",
      "text": "ఇంకా"
    },
    {
      "t": "05:32",
      "text": "అలానే కాదు"
    },
    {
      "t": "05:34",
      "text": "ఏదో"
    },
    {
      "t": "05:36",
      "text": "గొడవలు ఉన్నాయి కదా దానివల్ల ఏమన్నా విడిపోయారా"
    },
    {
      "t": "05:38",
