      "text": "ಎಲ್ಲಿಂದ"
    },
    {
      "t": "00:12",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:14",
      "text": "ಬ್ಯಾಂಗ್ಳೂರ್ ಅಲ್ವಾ ಬಿ ಜೆ ಪಿನ"
    },
    {
      "t": "00:16",
      "text": "ಬ್ಯಾಂಗ್ಳೂರ್"
    },
    {
      "t": "00:18",
      "text": "ಈ"
    },
    {
      "t": "00:20",
      "text": "ಮಾಡ್ಕೊಳ್ಳಿ ನಾನು"
    },
    {
      "t": "00:22",
      "text": "ಕಂಪೈನ್ಸ್ ಇಟ್ಕೊಳ್ತೀನಿ ಬೇಬಿ"
    },
    {
      "t": "00:24",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:26",
      "text": "ಇಂಟ್ರೆಸ್ಟ್ ಇದೆಯಾ"
    },
    {
      "t": "00:28",
      "text": "ಹ್ಞೂ ಇದಾಗ್ತದೆ"
    },
    {
      "t": "00:30",
      "text": "ವಿಡಿಯೋ ಕಾಲ್ ಮಾಡಿ"
    },
    {
      "t": "00:32",
      "text": "ಮಾಡ್ತೀರಾ ವಾಟ್ಸಾಪಲ್ಲಿ"
    },
    {
      "t": "00:34",
      "text": "ಫಸ್ಟ್ ಇವಾಗ ತೋರ್ಸು ಸ್ವಲ್ಪ"
    },
    {
      "t": "00:36",
      "text": "ಇತ್ತಲ್ಲಿ ಏನು"
    },
    {
      "t": "00:38",
      "text": "ಅರ್ನ್ ಆಗಲ್ಲ ರೀ ಎಲ್ಲ ಮೋಸ ಮಾಡೋರೆ"
    },
    {
      "t": "00:40",
      "text": "ನಂಬರ್ ಕೊಡಿ ನಾನು ಇನ್ನು"
    },
    {
      "t": "00:42",
      "text": "ಮೋಸಗಾರ್ತಿ ಅಲ್ಲ ತ್ರೀ ಹಂಡ್ರೆಡ್ ರುಪೀಸ್"
    },
    {
      "t": "00:44",
      "text": "ಮೀಡಿಯಾವಾಗಿ ಮೀಡಿಯಾ ಮಾಡಿ"
    },
    {
      "t": "00:46",
      "text": "ಅದೇ"
    },
    {
      "t": "00:48",
      "text": "ಹೇಳ್ತಿದ್ದೀನಲ್ಲ ನನಗೂ ಹುಷಾರಿಲ್ಲ ನನಗೆ"
    },
    {
      "t": "00:50",
      "text": "ನಿಮಗೂ ಅಮೌಂಟ್ ಬೇಕು ನೋಡಿ ನಾ"
    },
    {
      "t": "00:52",
      "text": "ನೀವು ನನ್ನ ಮೇಲೆ ನಂಬಿಕೆ ಬಂತು ಅಂದರೆ ನಂಬರ್ ಕೊಡಿ"
    },
    {
      "t": "00:54",
      "text": "ನಾನೇನು ಮುನ್ನೂರು ರೂಪಾಯಿಗೋಸ್ಕರ"
    },
    {
      "t": "00:56",
      "text": "ಲಾಕ್ ಮಾಡಲ್ಲ ಮಾಡಿದ"
    },
    {
      "t": "00:58",
      "text": "ಹ್ಯೂಮನ್ ಕಾಸ್ಟ್ ಕೊಡ್ಲಾ"
    },
    {
      "t": "01:00",
      "text": "ಹ್ಞೂ ಮಾಡಿರೋ ಆಮೇಲೆ ಕಾಸು ಕೊಡಲಾ"
    },
    {
      "t": "01:02",
      "text": "ಹಿಂಗೆ ಹೇಳಿ ನಾನು ಹಿಂಗೆ"
    },
    {
      "t": "01:04",
      "text": "ನಂಬಿ ಒಂದಿಬ್ಬರೇ ಮಾಡ್ಬಿಟ್ಟು"
    },
    {
      "t": "01:06",
      "text": "ಲಾಸ್ಟಿಗೆ ಅವ್ರ ಮನೆಗೆ ದುಡ್ಡೇ ಹಾಕಿಲ್ಲ ನನಗೆ ಬ್ಲಾಕ್ ಮಾಡಿ"
    },
    {
      "t": "01:08",
      "text": "ಮಾಡಿದ್ದಾರೆ"
    },
    {
      "t": "01:10",
      "text": "ನಾವೇನು ನಂಬಲ್ಲ ನನ್ನ ಹತ್ರ ತುಂಬ ಕಡೆ"
    },
    {
      "t": "01:12",
      "text": "ನಿಮ್ಮಿಷ್ಟ ಯಾರು ದುಡ್ಡನ್ನು"
    },
    {
      "t": "01:14",
      "text": "ಭಾಗದಲ್ಲೇ ಮಾಡಲ್ಲ ನಿಮಗೆ ಗೊತ್ತು ಒಬ್ಬೊಬ್ಬರು"
    },
    {
      "t": "01:16",
      "text": "ಒಬ್ಬರು ದುಡ್ಡು ಹಾಕ್ಸೊಂಡು ಬ್ಲಾಕ್ ಮಾಡ್ಕೊಂಡೆ ಹೋಗ್ತಾರೆ"
    },
    {
      "t": "01:18",
      "text": "ನಾನು ಹೇಳ್ತಿದ್ದೀನಿ ನಾನು ಜೆನ್ಯೂನ್ ಆಗಿರ್ತೀನಿ ಅಂತ"
    },
    {
      "t": "01:20",
      "text": "ನೀವೇ"
    },
    {
      "t": "01:22",
      "text": "ನೀವು ಮಾಡ್ತೀರಾ ಅಂದರೆ ನಂಬರ್ ಕೊಡಿ ಸುಮ್ಮನೆ"
    },
    {
      "t": "01:24",
      "text": "ಇಲ್ಲ ಕಟ್ ಮಾಡಿ"
    },
    {
      "t": "01:26",
      "text": "ಗಾಡಿ"
