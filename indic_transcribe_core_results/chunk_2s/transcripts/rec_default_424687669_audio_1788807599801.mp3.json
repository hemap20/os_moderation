  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:02",
      "text": "ಆಯ್ತು ಆಯ್ತು"
    },
    {
      "t": "00:04",
      "text": "ಯಾರು ಬೆಂಗಳೂರು"
    },
    {
      "t": "00:06",
      "text": "ಬೆಂಗಳೂರು ಆಯ್ತು"
    },
    {
      "t": "00:08",
      "text": "ಆಯಿತಾ ಊಟ ಹ್ಞೂ ಆಯಿತು"
    },
    {
      "t": "00:10",
      "text": "ಎಲ್ಲಿ ಬೆಂಗಳೂರಲ್ಲಿ ವಿಜಯನಗರದಲ್ಲಿ"
    },
    {
      "t": "00:12",
      "text": "ಜಯನಗರ್ ನೀವು ಹ್ಞೂ ಜಯನಗರ್"
    },
    {
      "t": "00:14",
      "text": "ಸೆಕೆಂಡ್ ಪೇಜ್ ವಾಟ್ಸಪ್"
    },
    {
      "t": "00:16",
      "text": "ಕಾಲ್ ಬರ್ತರಾ"
    },
    {
      "t": "00:18",
      "text": "ಏನು ಮಾಡ್ಕೊಂಡಿರೋದು"
    },
    {
      "t": "00:20",
      "text": "ಕ್ರೆಡಿಟ್ ಕಾರ್ಡ್ ಜಾಬ್"
    },
    {
      "t": "00:22",
      "text": "ಹ್ಞೂ ಓಕೆ ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "00:24",
      "text": "ನಂಬರ್ ಎರಡು"
    },
    {
      "t": "00:26",
      "text": "ಹೇಳಿ ನಿಮ್ಮದು"
    },
    {
      "t": "00:28",
      "text": "ಏಟ್ ಫೋರ್ ಹ್ಞೂ"
    },
    {
      "t": "00:30",
      "text": "ತ್ರೀ ಒನ್ ತ್ರೀ ಓಕೆ"
    },
    {
      "t": "00:32",
      "text": "ಸೆವೆನ್ ನೈನ್"
    },
    {
      "t": "00:34",
      "text": "ತ್ರೀ ನೈನ್ ಫೈವ್"
    },
    {
      "t": "00:36",
      "text": "ಎಷ್ಟು ಪೇ ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "00:38",
      "text": "ಏನು ರೇಟ್ ಸರ್ ನಿಮ್ಮದು"
    },
    {
      "t": "00:40",
      "text": "ಹೇಳಿ ನೀವು ಎಷ್ಟು ಮಾಡ್ತೀರಾ ಪೇ"
    },
    {
      "t": "00:42",
      "text": "ಮಾಡಿದ್ರೆ ವೀಡಿಯೋ ಕಾಲ್ ಶೋ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "00:44",
      "text": "ಅಲ್ಲ ನಿಮ್ದು ಏನು ರೇಟ್ಸ್ ಇದೆ ಹೇಳಿದ್ರೆ"
    },
    {
      "t": "00:46",
      "text": "ಪೇ ಮಾಡು ಥೌಸಂಡ್ ಫುಲ್"
    },
    {
      "t": "00:48",
      "text": "ಓಪನ್ ವೀಡಿಯೋ ಕಾಲ್ ವಿತ್ ಫೇಸ್ ಅಂಡ್ ಫಿಂಗರಿಂಗ್"
    },
    {
      "t": "00:50",
      "text": "ಹ್ಞೂ ರಿಯಲ್"
    },
    {
      "t": "00:52",
      "text": "ಇದು ಪೇ ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "00:54",
      "text": "ಅದನ್ನೇ ರಿಯಲ್ಮಿ ಮಾಡೋದು ಒನ್ ನೈಟ್ ಫೈವ್ ತೌಸಂಡ್"
    },
    {
      "t": "00:56",
      "text": "ಒನ್ ನೈಟ್ ಫೈವ್ ತೌಸಂಡ್"
    },
    {
      "t": "00:58",
      "text": "ಅದನ್ನು ಎಲ್ಲಿ ರೂಮ"
    },
    {
      "t": "01:00",
      "text": "ಹಾಂ ರೂಮೇ ವಿಜಯ್"
    },
    {
      "t": "01:02",
      "text": "ವಿಜಯನಗರ ವಿಜಯನಗರ"
    },
    {
      "t": "01:04",
      "text": "ಹ್ಞೂ ಓಕೆ"
    },
    {
      "t": "01:06",
      "text": "ಅದಕ್ಕೆ ಆನ್ ಮಾಡಿ ಓಕೆ ಬಂತಾ"
    },
    {
      "t": "01:08",
      "text": "ಹಾಯ್ ಅಂತ"
    },
    {
      "t": "01:10",
      "text": "ಮಾಡ್ತೇನೆ"
    },
    {
      "t": "01:12",
      "text": "ಹೌದು"
    },
    {
      "t": "01:14",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:16",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:18",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:20",
      "text": "ಹ್ಞೂ ಬಂತು"
    },
    {
      "t": "01:22",
      "text": "ಮಾಡೋದಾದ್ರಲ್ಲಿ"
    },
    {
      "t": "01:24",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:26",
      "text": "ಹೌದು"
    },
    {
      "t": "01:28",
      "text": "ಜಾಸ್ತಿ ಆಯ್ತಲ್ಲ ನಿಂದು ಯಾಕೋ"
    },
    {
      "t": "01:30",
      "text": "ಇನ್ವೆಶ್ಟ್ ಮಾಡ್ತೀರಾ ಫುಲ್ ನೋಡ್ಕೋ"
    },
    {
      "t": "01:32",
      "text": "ತುಂಬ ಜಾಸ್ತಿ"
    },
    {
      "t": "01:34",
      "text": "ಆಯಿತು ಬೇರೆಯವರೆಲ್ಲ ಕಡಿಮೆ ತಗೊಂತಾರಲ್ಲ"
    },
    {
      "t": "01:36",
      "text": "ಎಷ್ಟು ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "01:38",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:40",
      "text": "ಫೈವ್ ಹಂಡ್ರೆಡ್ ಅಲ್ವಾ"
    },
    {
      "t": "01:42",
      "text": "ಫೈವ್"
    },
    {
      "t": "01:44",
      "text": "ಎರಡಲ್ವಾ ಓಕೆ ಫೈವ್ ಹಂಡ್ರೆಡ್"
    },
    {
      "t": "01:46",
      "text": "ಮಾಡ್ತೀರಾ ಅಂದರೆ ಮಾಡಿ ಸ್ಟಾರ್ಟ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "01:48",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:50",
      "text": "ಈಗ"
    },
    {
      "t": "01:52",
      "text": "ಓಕೆ ಆಯಿತು ಏರ್ ಮೀಟರ್ ಅಂದರೆ ಯಾವ"
    },
    {
      "t": "01:54",
      "text": "ನಾವೇ ಫ್ರೀ ಇರ್ತೀರಿ ನಮಗೆ ವರ್ಕು ನಾ ವರ್ಕಿಂಗ್ ಅವಾಗ"
    },
    {
      "t": "01:56",
      "text": "ನೀವು ಯಾವಾಗ ಫ್ರೀ ಇರ್ತೀರಾ ಹೇಳಿ"
    },
    {
      "t": "01:58",
      "text": "ನಂಗೆ ಕಾಲ್ ಮಾಡಿ ನಾ ಸಿಗ್ತೀನಿ"
    },
    {
      "t": "02:00",
      "text": "ಅಲ್ಲ ನೀವು ಕೂಡ ಜಾಬ್ ಅಲ್ಲ ಎಂಪ್ಲಾಯ್ ಅಲ್ಲ"
    },
    {
      "t": "02:02",
      "text": "ಅಲ್ಲ ನಿಮ್ದು ನೀವು ಯಾವಾಗ ಫ್ರೀ ಇರ್ತೀರಾ"
    },
    {
      "t": "02:04",
      "text": "ಬೇಕಲ್ವಾ ನಮಗೆ"
    },
    {
      "t": "02:06",
      "text": "ಓಕೆ ಅಲ್ಲ ಅಂದರೆ ಆಲ್ಮೋಸ್ಟ್ ಎವ್ರಿ"
    },
    {
      "t": "02:08",
      "text": "ನೀವು ಯಾವಾಗ ಫ್ರೀ ಇರ್ತೀರ ಅಂದರೆ ನೀವು"
    },
    {
      "t": "02:10",
      "text": "ನನಗೆ ಹೇಳಿದ್ರೆ ನಾನು ಲೀವ್ ಹಾಕ್ತೀನಿ"
    },
    {
      "t": "02:12",
      "text": "ಅದಕ್ಕೆ"
    },
    {
      "t": "02:14",
      "text": "ನೀವು ಲೀವೇ ಆಗ್ತೀರಾ"
    },
    {
      "t": "02:16",
      "text": "ಪ್ರಾಯೋಜಕ"
    },
    {
      "t": "02:18",
      "text": "ಅಲ್ಲಿ ಕೊಡ್ತಾರಾ ನಿಮಗೆ"
    },
    {
      "t": "02:20",
      "text": "ಲೀವ್ ಹಾಕಿದ್ರೆ ಲೀವ್"
    },
    {
      "t": "02:22",
      "text": "ಕೊಡಲ್ವಾ"
    },
    {
      "t": "02:24",
      "text": "ನಿಮ್ಮ ಕಂಪ್ನಿ ಎತ್ತಂಬ ಲಿಬರಲ್ಸ್ ಯಾವ ಕ್ರೆಡಿಟ್"
    },
    {
      "t": "02:26",
      "text": "ಕರ್ಕೊಂಡು ಬನ್ನಿ ಅಂದ್ರು"
    },
    {
      "t": "02:28",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "02:30",
      "text": "ಈಗ ಇರೋದು ಎಲ್ಲಿ"
    },
    {
      "t": "02:32",
      "text": "ವಿಜಯನಗರ ಅದೇ ವಿಜಯನಗರ ಪ್ರಾಂಶು"
    },
    {
      "t": "02:34",
      "text": "ಮಾಡೋದು ಅಂದ್ರೆ ಮನೆ"
    },
    {
      "t": "02:36",
      "text": "ಮನೆ ನಾರು ಮಾಪಿ"
    },
    {
      "t": "02:38",
      "text": "ಪಿ ಜಿ ಅಂತ ಕೇಳಿದೆ ಮನೆ ಮನೆ ನಾನು ಒಬ್ಬ"
    },
    {
      "t": "02:40",
      "text": "ಒಬ್ಬಳೇ ಇರೋದಿದೆ ನಮ್ಮದು ಪ್ರಾಪರ್ ಬೀದರ್"
    },
    {
      "t": "02:42",
      "text": "ಓಕೆ ಒಬ್ಬಳೇ ಮನೆ ಮಾಡ್ಕೊಂಡು"
    },
    {
      "t": "02:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:46",
      "text": "ಹಾಂ ಓಕೆ ಓಕೆ ಹ್ಞೂ"
    },
    {
      "t": "02:48",
      "text": "ಸರಿ ಮತ್ತೆ ಆ ಸಮಾಚಾರ"
    },
    {
      "t": "02:50",
      "text": "ಸರ್ ಕಳಿಸ್ತಿದೆಯಾ ಸ್ಕ್ಯಾನರು"
    },
    {
      "t": "02:52",
      "text": "ಮಾಡ್ಲಾ ವಾಟ್ಸಾಪಲ್ಲಿ"
    },
    {
      "t": "02:54",
      "text": "ಹಾಂ ಕರ್ಸಿ ಹ್ಞೂ"
    },
    {
      "t": "02:56",
      "text": "ಹ್ಞೂ"
