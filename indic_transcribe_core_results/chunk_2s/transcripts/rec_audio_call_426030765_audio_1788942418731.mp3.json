  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "హలో"
    },
    {
      "t": "00:04",
      "text": "మంచి"
    },
    {
      "t": "00:06",
      "text": "వాటిని"
    },
    {
      "t": "00:08",
      "text": "హైదరాబాద్"
    },
    {
      "t": "00:10",
      "text": "అదే అదే"
    },
    {
      "t": "00:12",
      "text": "ఏమండీ ఇంట్రెస్ట్ ఉందా నీకు"
    },
    {
      "t": "00:14",
      "text": "ఆ"
    },
    {
      "t": "00:16",
      "text": "వీడియో కాల్ ఇంట్రెస్ట్ ఉందా"
    },
    {
      "t": "00:18",
      "text": "ఉంది"
    },
    {
      "t": "00:20",
      "text": "నార్మల్ షో త్రీ హండ్రెడ్ రొమాంటిక్"
    },
    {
      "t": "00:22",
      "text": "పంటికి బూతులతోని ఫైవ్ హండ్రెడ్ ఓకే అండి"
    },
    {
      "t": "00:24",
      "text": "ఒకటే నెంబర్ ఇస్తాను టైంపాస్కి మాత్రం తీసుకో"
    },
    {
      "t": "00:26",
      "text": "కుక్కు"
    },
    {
      "t": "00:28",
      "text": "హలో ఫస్ట్ చూపించిన తర్వాత"
    },
    {
      "t": "00:30",
      "text": "పేమెంట్ చేస్తాను మామూలుగా అయితే నేను చేయను"
    },
    {
      "t": "00:32",
      "text": "మొత్తం న్యూడ్ అవుతుంది కాల్లోనే"
    },
    {
      "t": "00:34",
      "text": "న్యూడ్ కాగానే క్యామ్ ఆఫ్ చేస్తాను"
    },
    {
      "t": "00:36",
      "text": "పేమెంట్ అయ్యగానే బ్లాక్లో పెట్టేస్తారు అలా"
    },
    {
      "t": "00:38",
      "text": "మస్తు ఆల్రెడీ వాళ్ళు చేశారు కదా"
    },
    {
      "t": "00:40",
      "text": "బట్టలు విప్పేస్తాను"
    },
    {
      "t": "00:42",
      "text": "నువ్వు"
    },
    {
      "t": "00:44",
      "text": "మొత్తం యూజువల్గా చూపించిన తర్వాత"
    },
    {
      "t": "00:46",
      "text": "నేను డబ్బు కొడతాను"
    },
    {
      "t": "00:48",
      "text": "లాస్ట్ నలుగురు నలుగురు బ్లాక్గా పెట్టేసారు"
    },
    {
      "t": "00:50",
      "text": "తున్నా నేను"
    },
    {
      "t": "00:52",
      "text": "వీడియో కాల్ చేయి బట్టలు ఇప్పేసి"
    },
    {
      "t": "00:54",
      "text": "కొత్త ఇప్పేసి చూపించు"
    },
    {
      "t": "00:56",
      "text": "క్యామ్ ఆఫ్ చేస్తా లైన్లో ఉండగా పంపుతాను"
    },
    {
      "t": "00:58",
      "text": "పిక్చర్ కంటిన్యూ చేద్దాం"
    },
    {
      "t": "01:00",
      "text": "సరే"
    },
    {
      "t": "01:02",
      "text": "నైన్ ఎయిట్ ఫోర్ ఎయిట్"
    },
    {
      "t": "01:04",
      "text": "ఒక్క నిమిషం"
    },
    {
      "t": "01:06",
      "text": "ఓకే"
    },
