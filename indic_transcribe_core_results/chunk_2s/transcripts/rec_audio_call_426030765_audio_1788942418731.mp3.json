    },
    {
      "t": "01:14",
      "text": "ఆల్రెడీ"
    },
    {
      "t": "01:16",
      "text": "తైవాన్"
    },
    {
      "t": "01:18",
      "text": "వన్ ఫోర్ సిక్స్"
    },
    {
      "t": "01:20",
      "text": "వాట్సాప్"
    },
    {
      "t": "01:22",
      "text": "ఫోర్ ఫైవ్"
    },
    {
      "t": "01:24",
      "text": "ఓహో"
    },
    {
      "t": "01:26",
      "text": "ఓకే"
    },
    {
