    {
      "t": "00:30",
      "text": "നാട്ടിലെവിടെയാ അല്ല"
    },
    {
      "t": "00:32",
      "text": "പുറത്തുവിടും"
    },
    {
      "t": "00:34",
      "text": "മാറ്റൽ തന്നെ"
    },
    {
      "t": "00:36",
      "text": "ആ അടി തന്നെ"
    },
    {
      "t": "00:38",
      "text": "കറണ്ടം ഉണ്ടല്ലേ അവിടെ"
    },
    {
      "t": "00:40",
      "text": "ആ പിന്നെ"
    },
    {
      "t": "00:42",
      "text": "ചർച്ച ചെയ്യാം അപ്പോൾ ഇന്ന്"
