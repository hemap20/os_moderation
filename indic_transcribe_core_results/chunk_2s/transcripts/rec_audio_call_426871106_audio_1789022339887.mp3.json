{
  "file_id": "rec_audio_call_426871106_audio_1789022339887.mp3",
  "language": "kannada",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 288.005,
  "processing_time_sec": 104.05919361114502,
  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ ಹಲೋ"
    },
    {
      "t": "00:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:06",
      "text": "ಹಲೋ ಹೇಳ್ರಿ"
    },
    {
      "t": "00:08",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:10",
      "text": "ಹೇಳ್ರಿ"
    },
    {
      "t": "00:12",
      "text": "ಏನ್ರೀ ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "00:14",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:16",
      "text": "ಕೂತ್ಕಂಡಿದ್ದರೆ"
    },
    {
      "t": "00:18",
      "text": "ಕುತ್ಕೊಂಡು ಏನು ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "00:20",
      "text": "ಏನು ಮಾಡೋಣ"
    },
    {
      "t": "00:22",
      "text": "ಸೊ ಖುಬಾ ಅಂದೆವ್ ರೀ"
    },
    {
      "t": "00:24",
      "text": "ಎಲ್ಲಿ ನೀವು ಯಾವ ಊರು ನಿಮ್ಮದು"
    },
    {
      "t": "00:26",
      "text": "ಯಾ"
    },
    {
      "t": "00:28",
      "text": "ಹಾಂ ಹೋಗ್ಲಿ"
    },
    {
      "t": "00:30",
      "text": "ಹುಬ್ಬಳ್ಳಿನಾ"
    },
    {
      "t": "00:32",
      "text": "ನೆನ್ನೆ ಮಾತಾಡಿದ್ರ ನನ್ನ ಹತ್ರ ನೀವು"
    },
    {
      "t": "00:34",
      "text": "ಆಂ"
    },
    {
      "t": "00:36",
      "text": "ದಾಹ"
    },
    {
      "t": "00:38",
      "text": "ಇಲ್ಲವಾ"
    },
    {
      "t": "00:40",
      "text": "ಏನು ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ"
    },
    {
      "t": "00:42",
      "text": "ಹೌಸ್ ವೈಫಾ"
    },
    {
      "t": "00:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:46",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:48",
      "text": "ಏನು"
    },
    {
      "t": "00:50",
      "text": "ಅಯ್ಯೋ"
    },
    {
      "t": "00:52",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:54",
      "text": "ಸ್ಟೈಲಿ ಏನೋ ಮಾಡಿ"
    },
    {
      "t": "00:56",
      "text": "ನೀವೇನು ಮಾಡ್ಕೊಂಡು"
    },
    {
      "t": "00:58",
      "text": "ಸರಿ ಅಂದೆ ನಾನು ಕೆಲಸ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "01:00",
      "text": "ಮಾಡ್ಕೊಂಡಿದ್ದೀನಿ ಏನು"
    },
    {
      "t": "01:02",
      "text": "ಅಲ್ಪಾವಧಿ"
    },
    {
      "t": "01:04",
      "text": "ಯಾವುದೋ ಒಂದು ಕೆಲಸ ಏನು ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "01:06",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:08",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:10",
      "text": "ದೆನ್"
    },
    {
      "t": "01:12",
      "text": "ಏನು ಏನು ಮಾಡಬೇಕು ನೀವು ಹೇಳಿ"
    },
    {
      "t": "01:14",
      "text": "ಬೇಕು ಏನು ಮಾಡ್ತೀರಾ ಆ್ಯಪಲ್ಲಿ ನೀವು"
    },
    {
      "t": "01:16",
      "text": "ಟೈಮ್ ಪಾಸ್ ಆಗಿ ಯೂಸ್ ಮಾಡ್ಬೇಕು"
    },
    {
      "t": "01:18",
      "text": "ಮುಖ ತೆನಪು"
    },
    {
      "t": "01:20",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:22",
      "text": "ಶ್"
    },
    {
      "t": "01:24",
      "text": "ಸರಿ ಸರಿ ಕಂಡು ಟೈಮ್ ಪಾಸ್ ಮಾಡಿ"
    },
    {
      "t": "01:26",
      "text": "ಚಾಕ್ರಿ"
    },
    {
      "t": "01:28",
      "text": "ಸುಣ್ಣಕಾಳು"
    },
    {
      "t": "01:30",
      "text": "ಹೇಳ್ಬಾ ಹೇಳ್ಬಾರ್ದು ರೀ"
    },
    {
      "t": "01:32",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:34",
      "text": "ನಾನೇನು ಹೇಳಿರ್ಲಿಲ್ಲ"
    },
    {
      "t": "01:36",
      "text": "ಮಾಡಬಾರ್ದು ಅಂತ ಅವ್ರವ್ರ ಇಷ್ಟ"
    },
    {
      "t": "01:38",
      "text": "ಎತ್ತ ಕರ್ಕೊಂಡು ಹೋಗಿ"
    },
    {
      "t": "01:40",
      "text": "ನಾನು ಬಂದು"
    },
    {
      "t": "01:42",
      "text": "ಒಂದು ಒಂದು ಒಂದು ವರ್ಷ ಆಯಿತು"
    },
    {
      "t": "01:44",
      "text": "ವಾಹ್"
    },
    {
      "t": "01:46",
      "text": "ಎಷ್ಟು ಖರ್ಚು ಮಾಡಿದ್ದೀರ"
    },
    {
      "t": "01:48",
      "text": "ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "01:50",
      "text": "ಅಪ್ಪ ದೇವ್ರೆ"
    },
    {
      "t": "01:52",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:54",
      "text": "ಒಂದು ಲಕ್ಷ ಹ್ಞೂ"
    },
    {
      "t": "01:56",
      "text": "ಕಾರಣ ಆಗುತ್ತೆ"
    },
    {
      "t": "01:58",
      "text": "ತಲೆಯ ಲಯನ್"
    },
    {
      "t": "02:00",
      "text": "ಏನಿಲ್ಲ ಸುಮ್ಮನೆ ಒಂದು ಲಕ್ಷ ಖರ್ಚು ಮಾಡೋಣ ಅಂತ ಬೈಕ್ ಒಂದೇ"
    },
    {
      "t": "02:02",
      "text": "ಅಲ್ಲ ಅಲ್ಲ"
    },
    {
      "t": "02:04",
      "text": "ಲಕ್ಷ ಅದೇ ಅಪ್ಪ ಮಗು"
    },
    {
      "t": "02:06",
      "text": "ಕೊಟ್ಟಿದ್ದೆಷ್ಟು ಖುಷಿ ಪಡೋರು ಒಂದು ಲಕ್ಷ"
    },
    {
      "t": "02:08",
      "text": "ಅದು ಕರೆಕ್ಟ್ ಅಲ್ವಾ"
    },
    {
      "t": "02:10",
      "text": "ಇವಾಗ ಕ್ರಿಯೇಟ್ ಆಗಿ ಇನ್ಸ್ಟಾ ಅನ್ಇನ್ಸ್ಟಾ"
    },
    {
      "t": "02:12",
      "text": "ಸರ್ವ್ ಮಾಡ್ತೀನಿ ಆ್ಯಪ್ನ"
    },
    {
      "t": "02:14",
      "text": "ಅದೇ ದುಡ್ಡಿದ್ರೆ ಅಪ್ಪ ಅಮ್ಮ"
    },
    {
      "t": "02:16",
      "text": "ಅಕ್ಕ ತಂಗಿ ಅಣ್ಣ ತಮ್ಮ ಏನು"
    },
    {
      "t": "02:18",
      "text": "ಅದು ಕೊಡಿಸ್ಬೋದು"
    },
    {
      "t": "02:20",
      "text": "ಅಲ್ವಾ ಇರಿ ಫಸ್ಟ್ ತೆಗಿತೀನಿ ಆ್ಯಪ್ನ ಇವಾಗ"
    },
    {
      "t": "02:22",
      "text": "ಇಷ್ಟ"
    },
    {
      "t": "02:24",
      "text": "ಅದು ನನ್ನದು ನನ್ನ ಲೆಕ್ಕಕ್ಕೆ"
    },
    {
      "t": "02:26",
      "text": "ನಾನು ಹೇಳಿದೆ ಕರೆಕ್ಟ್ ಕರೆಕ್ಟ್"
    },
    {
      "t": "02:28",
      "text": "ನನ್ನ ಕಡೆ ಏನಾದರೂ"
    },
    {
      "t": "02:30",
      "text": "ಆದರೂ ಇದ್ದಿದ್ದರೆ ಅಷ್ಟು"
    },
    {
      "t": "02:32",
      "text": "ಇಷ್ಟೊತ್ತಿಗೆ ನನ್ನ ಮಗ್ಳಿಗೆ ಬಂಗಾರ"
    },
    {
      "t": "02:34",
      "text": "ಮಾಡ್ಸಾಕ್ತಿದ್ದೆ ಅದಕ್ಕೆ"
    },
    {
      "t": "02:36",
      "text": "ಅಯ್ಯಯ್ಯೋ"
    },
    {
      "t": "02:38",
      "text": "ನನ್ನ ನೆಕ್ಸ್ಟ್ ಏನಾದರೂ ಚೇಂಜ್"
    },
    {
      "t": "02:40",
      "text": "ಕಳಿಸ್ತಿದ್ದೇನೆ ನಿಮಗ್ ಸಾಕು"
    },
    {
      "t": "02:42",
      "text": "ಹ್ಞೂ ಯಾಕೆ"
    },
    {
      "t": "02:44",
      "text": "ಪ್ರೆಸೆಂಟ್ ಇಲ್ವಾ"
    },
    {
      "t": "02:46",
      "text": "ಪ್ರೆಸೆಂಟ್ ಅಂದರೆ"
    },
    {
      "t": "02:48",
      "text": "ಸಿಂಗಲ್ ಪೇರೆಂಟು"
    },
    {
      "t": "02:50",
      "text": "ಸಿಂಗಲ್ ಪೇರೆಂಟಾ"
    },
    {
      "t": "02:52",
      "text": "ಹ್ಞೂ ಸಿಂಗಲ್ ಪೇರೆಂಟ್"
    },
    {
      "t": "02:54",
      "text": "ಟೈಗರ್ ಎಗ್ಸ್ಗೆ ಹೆಂಗ್ರಿ ಕೊಡಿಸ್ತೀರಾ"
    },
    {
      "t": "02:56",
      "text": "ಕೊಡಿಸ್ತೀನಿ ಅವ್ನಿಗೆ"
    },
    {
      "t": "02:58",
      "text": "ಕೇಳೋದಾಚೆ ನಾನು ಕೊಡೋದಾಚೆ"
    },
    {
      "t": "03:00",
      "text": "ನಿಮ್ಮಂಥವ್ರಿಗೆ"
    },
    {
      "t": "03:02",
      "text": "ಇರೋದರಿಂದನೇ ರೀ ಪ್ರಪಂಚ ಇವತ್ತು ಉಳಿದಿರೋದು"
    },
    {
      "t": "03:04",
      "text": "ಯಾಕ್ರಿ"
    },
    {
      "t": "03:06",
      "text": "ಏನೋ ಸುಮ್ಮನೆ ಹಂಗೆ"
    },
    {
      "t": "03:08",
      "text": "ಯಾಕೆ ಹೇಳಿರಿ"
    },
    {
      "t": "03:10",
      "text": "ಸುಮ್ಮನೆ ಹಂಗೆ"
    },
    {
      "t": "03:12",
      "text": "ನನ್ನ ಮಕ್ಕಳಿಗಾಯ್ತು ನನ್ನ ಮಕ್ಕಳು"
    },
    {
      "t": "03:14",
      "text": "ಮಗ ಎಕ್ಸ್ ಗಾಡಿಯನ್ನು ಕೊಡಿಸ್ತಿದ್ನಪ್ಪ"
    },
    {
      "t": "03:16",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:18",
      "text": "ಇಲ್ಲಾಂದ್ರೆ ಒಂದು ಝೆಝಾಕೋಗಿ ಸಕ್ಕತ್ತಾಗಿ"
    },
    {
      "t": "03:20",
      "text": "ಪಾರ್ಟಿ ಮಾಡ್ತಿದ್ದರು ದುಡ್ಡು ಇಟ್ಟಿದ್ದು"
    },
    {
      "t": "03:22",
      "text": "ಎಲ್ಲಿಗೆ ಹೋಗಿದ್ರ"
    },
    {
      "t": "03:24",
      "text": "ರೆಸಾರ್ಟ್ಗೋಗಿ ಪಾರ್ಟಿ ಮಾಡ್ತಿದ್ದೆವು ಅಂದೆ"
    },
    {
      "t": "03:26",
      "text": "ಏನು ಮಾಡ್ತೀರಾ ರೆಸಾರ್ಟ್ಗೆ ಹೋಗ್ಬೇಡಿ ಹೆಂಗ್ ಪಾರ್ಟಿ ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "03:28",
      "text": "ಪಾರ್ಟಿ ಅಂದರೆ ಮಾಮೂಲಿ"
    },
    {
      "t": "03:30",
      "text": "ಮೊದ್ಲು ಪಾರ್ಟಿ ಉಣ್ಣೋದು ತಿನ್ನೋದು"
    },
    {
      "t": "03:32",
      "text": "ಹಾಂ ನೀವು ಮಾಡ್ತೀರಿ ಕುಡಿಯೋದು"
    },
    {
      "t": "03:34",
      "text": "ಇಲ್ಲಪ್ಪ ಅದು ಹ್ಯಾಬಿಟ್ ಇಲ್ಲ"
    },
    {
      "t": "03:36",
      "text": "ಯಾ ಕ್ಯಾಪಿಟಲಾ"
    },
    {
      "t": "03:38",
      "text": "ಮಾಡ್ಕೊಳ್ಳಿ"
    },
    {
      "t": "03:40",
      "text": "ಸೋಸನ್ನ ಬೇಡ"
    },
    {
      "t": "03:42",
      "text": "ಏನು ಯಾರು ಹಿಂಗೆ ಅಂತೀರಾ"
    },
    {
      "t": "03:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:46",
      "text": "ಒಂದು ಲಕ್ಷ ಅಂದರೆ ಏನು ಹೇಳಿ"
    },
    {
      "t": "03:48",
      "text": "ಯಾ ಸರ್ ಹಾಗಾದ್ರೆ"
    },
    {
      "t": "03:50",
      "text": "ನನ್ನ ಹತ್ರ ಕೋಟೆ"
    },
    {
      "t": "03:52",
      "text": "ಕೋಟ್ಯಾನುಗಟ್ಲೆ ದುಡ್ಡಿದೆ ಏನು ಮಾಡೋಣ"
    },
    {
      "t": "03:54",
      "text": "ಪಡೆಯೊಂದೇ ಇಲ್ಲ ಕೇಳೊಂದ"
    },
    {
      "t": "03:56",
      "text": "ಇದರ ಸರ"
    },
    {
      "t": "03:58",
      "text": "ಸಾಕಾ ಸಾಕು"
    },
    {
      "t": "04:00",
      "text": "ಏನು ಮಾಡ್ತೀರಾ ಇದೇ ಆಫರ್ ಹಿಡ್ಕೊಂಡು"
    },
    {
      "t": "04:02",
      "text": "ನಾನು ನೆಕ್ಸ್ಟ್ಗೆ ಏನಾದರೂ ಕೊಡ್ತಿನಿತ್ತಿ"
    },
    {
      "t": "04:04",
      "text": "ಏ"
    },
    {
      "t": "04:06",
      "text": "ನೀವೇನ್ರಿ ಕೊಡ್ಸಿರೋ ಅವರೇ ಕೊಡ್ಸ್ತಾರೆ ಇವಾಗ"
    },
    {
      "t": "04:08",
      "text": "ಕೊಡಸು"
    },
    {
      "t": "04:10",
      "text": "ಉಳಿಸ್ತಾರೆ ಆದರೆ ನಮ್ಮ"
    },
    {
      "t": "04:12",
      "text": "ನಮ್ದೊಂಥರ ಹಠ ನಾವು"
    },
    {
      "t": "04:14",
      "text": "ಕೊಡಿಸ್ಬೇಕು ಅವ್ರ ಕಡೆಯಿಂದ ನನಗೇನು ಬೇಡ"
    },
    {
      "t": "04:16",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:18",
      "text": "ನಮ್ಗೆ ಆ ಥರ ಡ್ರೀಮು ಇಲ್ಲ"
    },
    {
      "t": "04:20",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:22",
      "text": "ಹಂಗೆ ಕರೆಕ್ಟ್ ಕಣ್ರಿ ಫಾಸ್ಟ್"
    },
    {
      "t": "04:24",
      "text": "ಫಿಫ್ಟಿ ಆ್ಯಪ್ನ ಅನ್ಇನ್ಸ್ಟಾಲ್ ಮಾಡಿಬಿಟ್ಟು ಅದನ್ನು"
    },
    {
      "t": "04:26",
      "text": "ಹುಡ್ಗಿಗೆ ಹೋಗ್ಬಿಟ್ಟು ಚೆನ್ನಾಗಿ ನಾನು ಕೊಡಿಸ್ತೀನಿ"
    },
    {
      "t": "04:28",
      "text": "ಹೌದು"
    },
    {
      "t": "04:30",
      "text": "ಹುಡ್ಗಿ ಪಾಯಸ ಅದು ಜಾಸ್ತಿನಾ ಟೈಮ್"
    },
    {
      "t": "04:32",
      "text": "ಟೈಮ್ ಅಂತ"
    },
    {
      "t": "04:34",
      "text": "ದುಡ್ಡು ದುಡ್ಡು"
    },
    {
      "t": "04:36",
      "text": "ಗಿಫ್ಟ್ ಅಲ್ಲ"
    },
    {
      "t": "04:38",
      "text": "ಅಂಥವ್ರು ಇದ್ದಾರೆ ಸುಮಾರು ಜನ"
