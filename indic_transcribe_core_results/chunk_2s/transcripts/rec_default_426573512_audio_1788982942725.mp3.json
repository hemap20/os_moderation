  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:02",
      "text": "മ്മ്"
    },
    {
      "t": "00:04",
      "text": "എവിടുന്നാ"
    },
    {
      "t": "00:06",
      "text": "കണ്ണൂർ ജില്ല"
    },
    {
      "t": "00:08",
      "text": "കണ്ണൂർ ഫേസ് കാണുന്നില്ലല്ലോ"
    },
    {
      "t": "00:10",
      "text": "ആ"
    },
    {
      "t": "00:12",
      "text": "ഞാനാണോ"
    },
    {
      "t": "00:14",
      "text": "ഞാൻ പാലക്കാട് നിന്ന്"
    },
    {
      "t": "00:16",
      "text": "എന്താണ്"
    },
    {
      "t": "00:18",
      "text": "ഞാനിപ്പോൾ ആക്ച്വലി ബോംബെയിലാണ് എല്ലാ"
    },
    {
      "t": "00:20",
      "text": "ഡെന്റിൽ എഞ്ചിനീയറായി വർക്ക് ചെയ്യും"
    },
    {
      "t": "00:22",
      "text": "സ്ഥലം"
    },
    {
      "t": "00:24",
      "text": "ഞാൻ"
    },
    {
      "t": "00:26",
      "text": "ഇപ്പോൾ ആക്ച്വലി ബോംബെയിലാണ്"
    },
    {
      "t": "00:28",
      "text": "എൽ എൻ ടിയിൽ എഞ്ചിനീയർ ആയിട്ട് വർക്ക് ചെയ്യുന്നു"
    },
    {
      "t": "00:30",
      "text": "എൽ എൻ ടി കമ്പനി"
    },
    {
      "t": "00:32",
      "text": "താനോ"
    },
    {
      "t": "00:34",
      "text": "പിന്നെ ആവശ്യമായിട്ടാണ്"
    },
    {
      "t": "00:36",
      "text": "ഹാ ഹൗസ് വൈഫ്"
    },
    {
      "t": "00:38",
      "text": "ഹൗസ് വൈഫ് ആണോ"
    },
    {
      "t": "00:40",
      "text": "എത്രയും വയസ്സ്"
    },
    {
      "t": "00:42",
      "text": "ചണ്ഡീഗഢ്"
    },
    {
      "t": "00:44",
      "text": "ട്വൻറ്റി ത്രീ ഓക്കെ"
    },
    {
      "t": "00:46",
      "text": "കുത്തകക്കുണ്ടോ"
    },
    {
      "t": "00:48",
      "text": "ഒരണ്ടോ"
    },
    {
      "t": "00:50",
      "text": "സസ്പെൻഡും ചെയ്തു"
    },
    {
      "t": "00:52",
      "text": "ഏ"
    },
    {
      "t": "00:54",
      "text": "എബ്രോഡാണ്"
    },
    {
      "t": "00:56",
      "text": "പട്ടണമാണ്"
    },
    {
      "t": "00:58",
      "text": "എല്ലാ കാര്യങ്ങളും ചെയ്യാനാണ്"
    },
    {
      "t": "01:00",
      "text": "ഏ ഞാൻ മാരീഡ് ആയിരുന്നു"
    },
    {
      "t": "01:02",
      "text": "അല്ല ഞാനിപ്പോൾ ട്വന്റി എയ്റ്റ് ആണ്"
    },
    {
      "t": "01:04",
      "text": "കന്നുകാലി"
    },
    {
      "t": "01:06",
      "text": "എന്താണ്"
    },
    {
      "t": "01:08",
      "text": "കാണുന്നില്ല"
    },
    {
      "t": "01:10",
      "text": "ആ ഞാനത് ഓപ്പൺ ചെയ്തു"
    },
    {
      "t": "01:12",
      "text": "ആയിട്ടുണ്ടെന്ന് പറഞ്ഞാൽ ഫേസ് കാണിക്കാൻ പറഞ്ഞിട്ടുണ്ട്"
    },
    {
      "t": "01:14",
      "text": "അപ്പോൾ"
    },
    {
      "t": "01:16",
      "text": "ഓപ്പൺ ചാറ്റ് ഉണ്ടെങ്കിൽ പിന്നെ ഫേസ് കാണിക്കാവുന്നതാണ്"
    },
    {
      "t": "01:18",
      "text": "പറഞ്ഞിട്ടുണ്ട്"
    },
    {
      "t": "01:20",
      "text": "മ്മ്"
    },
    {
      "t": "01:22",
      "text": "ഓപ്പൺ ചാർട്ട് തലേദിവസം"
    },
    {
      "t": "01:24",
      "text": "താല്പര്യമുണ്ടോ"
    },
    {
      "t": "01:26",
      "text": "ഇല്ലേ"
    },
    {
      "t": "01:28",
      "text": "നോർമൽ ചെറിയ"
    },
    {
      "t": "01:30",
      "text": "തെറ്റ് മാത്രമേ ഉള്ളൂ"
    },
    {
      "t": "01:32",
      "text": "ഓക്കെ"
    },
    {
      "t": "01:34",
      "text": "ട്രൈ ചെയ്തിട്ട്"
    },
    {
      "t": "01:36",
      "text": "പ്ലീസ്"
    },
    {
      "t": "01:38",
      "text": "ആ"
    },
    {
      "t": "01:40",
      "text": "അല്ല അപ്പോൾ ആൾ പുറത്തൊക്കെ"
    },
    {
      "t": "01:42",
      "text": "വിശ്വനാഥ് ജിയാത്രയും"
    }
  ],
  "full_text": "ഹലോ മ്മ് എവിടുന്നാ കണ്ണൂർ ജില്ല കണ്ണൂർ ഫേസ് കാണുന്നില്ലല്ലോ ആ ഞാനാണോ ഞാൻ പാലക്കാട് നിന്ന് എന്താണ് ഞാനിപ്പോൾ ആക്ച്വലി ബോംബെയിലാണ് എല്ലാ ഡെന്റിൽ എഞ്ചിനീയറായി വർക്ക് ചെയ്യും സ്ഥലം ഞാൻ ഇപ്പോൾ ആക്ച്വലി ബോംബെയിലാണ് എൽ എൻ ടിയിൽ എഞ്ചിനീയർ ആയിട്ട് വർക്ക് ചെയ്യുന്നു എൽ എൻ ടി കമ്പനി താനോ പിന്നെ ആവശ്യമായിട്ടാണ് ഹാ ഹൗസ് വൈഫ് ഹൗസ് വൈഫ് ആണോ എത്രയും വയസ്സ് ചണ്ഡീഗഢ് ട്വൻറ്റി ത്രീ ഓക്കെ കുത്തകക്കുണ്ടോ ഒരണ്ടോ സസ്പെൻഡും ചെയ്തു ഏ എബ്രോഡാണ് പട്ടണമാണ് എല്ലാ കാര്യങ്ങളും ചെയ്യാനാണ് ഏ ഞാൻ മാരീഡ് ആയിരുന്നു അല്ല ഞാനിപ്പോൾ ട്വന്റി എയ്റ്റ് ആണ് കന്നുകാലി എന്താണ് കാണുന്നില്ല ആ ഞാനത് ഓപ്പൺ ചെയ്തു ആയിട്ടുണ്ടെന്ന് പറഞ്ഞാൽ ഫേസ് കാണിക്കാൻ പറഞ്ഞിട്ടുണ്ട് അപ്പോൾ ഓപ്പൺ ചാറ്റ് ഉണ്ടെങ്കിൽ പിന്നെ ഫേസ് കാണിക്കാവുന്നതാണ് പറഞ്ഞിട്ടുണ്ട് മ്മ് ഓപ്പൺ ചാർട്ട് തലേദിവസം താല്പര്യമുണ്ടോ ഇല്ലേ നോർമൽ ചെറിയ തെറ്റ് മാത്രമേ ഉള്ളൂ ഓക്കെ ട്രൈ ചെയ്തിട്ട് പ്ലീസ് ആ അല്ല അപ്പോൾ ആൾ പുറത്തൊക്കെ വിശ്വനാഥ് ജിയാത്രയും",
