{
  "file_id": "rec_default_426303789_audio_1788965281521.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 466.936,
  "processing_time_sec": 29.25788187980652,
  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "ఓకే"
    },
    {
      "t": "00:04",
      "text": "ఓకే"
    },
    {
      "t": "00:06",
      "text": "హలో హాయ్"
    },
    {
      "t": "00:08",
      "text": "మరి"
    },
    {
      "t": "00:10",
      "text": "మొత్తం వచ్చింది"
    },
    {
      "t": "00:12",
      "text": "బాగున్నారా"
    },
    {
      "t": "00:14",
      "text": "బాగున్నావా మీరు"
    },
    {
      "t": "00:16",
      "text": "వస్తున్నాను"
    },
    {
      "t": "00:18",
      "text": "అర్థం కావట్లేదు"
    },
    {
      "t": "00:20",
      "text": "బాగానే ఉన్నారు"
    },
    {
      "t": "00:22",
      "text": "మీరు"
    },
    {
      "t": "00:24",
      "text": "మొత్తం నుంచి"
    },
    {
      "t": "00:26",
      "text": "ఏం కదండి మేడం"
    },
    {
      "t": "00:28",
      "text": "మాట్లాడొచ్చా"
    },
    {
      "t": "00:30",
      "text": "మాట్లాడొచ్చా"
    },
    {
      "t": "00:32",
      "text": "మాట్లాడొచ్చా పక్కనే ఉండి అన్నారా"
    },
    {
      "t": "00:34",
      "text": "ఎవ్వరూ లేరండి ఇక్కడ"
    },
    {
      "t": "00:36",
      "text": "లైట్ ఉంది కదా పురుగులు వస్తున్నాయి"
    },
    {
      "t": "00:38",
      "text": "కళ్ళ మీదకి"
    },
    {
      "t": "00:40",
      "text": "ఇటు సైడు"
    },
    {
      "t": "00:42",
      "text": "ఉన్నారు హాస్టల్కి వెళ్తుంటారు"
    },
    {
      "t": "00:44",
      "text": "ఆస్ట్రో"
    },
    {
      "t": "00:46",
      "text": "ఎంతమంది"
    },
    {
      "t": "00:48",
      "text": "నలుగురా"
    },
    {
      "t": "00:50",
      "text": "త్రీ"
    },
    {
      "t": "00:52",
      "text": "ఏమనుకోవడం కాదు"
    },
    {
      "t": "00:54",
      "text": "వాడిని ఏమనుకోరా"
    },
    {
      "t": "00:56",
      "text": "ఓకే సార్"
    },
    {
      "t": "00:58",
      "text": "ఇదే"
    },
    {
      "t": "01:00",
      "text": "ఇలాంటి పార్టిసిపెట్స్ పెట్టుకుంటే వినిపించదు"
    },
    {
      "t": "01:02",
      "text": "సరే"
    },
    {
      "t": "01:04",
      "text": "ఆహా"
    },
    {
      "t": "01:06",
      "text": "మాట్లాడటం పోవాలి ఏమి అనుకోరా"
    },
    {
      "t": "01:08",
      "text": "ఏమనుకుంటాం తెలిసాక"
    },
    {
      "t": "01:10",
      "text": "కావాలనుకోవచ్చు ఇదే అని తెలుసా"
    },
    {
      "t": "01:12",
      "text": "తెలీదు కదా"
    },
    {
      "t": "01:14",
      "text": "సూపర్"
    },
    {
      "t": "01:16",
      "text": "కోసము చూస్తూ పోతే ఇంకా ఆయన"
    },
    {
      "t": "01:18",
      "text": "పెట్టే"
    },
    {
      "t": "01:20",
      "text": "ఇంకా"
    },
    {
      "t": "01:22",
      "text": "చెప్పాలి"
    },
    {
      "t": "01:24",
      "text": "అదే"
    },
    {
      "t": "01:26",
      "text": "సరే"
    },
    {
      "t": "01:28",
      "text": "పండుగను చూసిన తర్వాత"
    },
    {
      "t": "01:30",
      "text": "ముందు రోజు"
    },
    {
      "t": "01:32",
      "text": "యూనోజా"
    },
    {
      "t": "01:34",
      "text": "ఓకే ఓకే"
    },
    {
      "t": "01:36",
      "text": "కాదు ఫెసిలిటీ మరి"
    },
    {
      "t": "01:38",
      "text": "మరి"
    },
    {
      "t": "01:40",
      "text": "ఏదో నార్మల్ చేసాము"
    },
    {
      "t": "01:42",
      "text": "చేద్దామని చూచాను"
    },
    {
      "t": "01:44",
      "text": "దాన్ని బాగా దూరం చేప"
    },
    {
      "t": "01:46",
      "text": "ఏంటి"
    },
    {
      "t": "01:48",
      "text": "బాగా జోలుంది ఆ ఆప్తుకు"
    },
    {
      "t": "01:50",
      "text": "ఆ అందుకే కదా పరిస్థితి"
    },
    {
      "t": "01:52",
      "text": "స్టార్ రేటింగ్ ఉంది ప్లే స్టార్లో"
    },
    {
      "t": "01:54",
      "text": "ఆ"
    },
    {
      "t": "01:56",
      "text": "ఓకే సార్"
    },
    {
      "t": "01:58",
      "text": "ఇంకా"
    },
    {
      "t": "02:00",
      "text": "అవును"
    },
    {
      "t": "02:02",
      "text": "వాట్సాప్ చేస్తున్నారా"
    },
    {
      "t": "02:04",
      "text": "వాట్సాప్ ప్లీజ్"
    },
    {
      "t": "02:06",
      "text": "అర్థం కావడం"
    },
    {
      "t": "02:08",
      "text": "వాట్సాప్ ఫేస్బుక్"
    },
    {
      "t": "02:10",
      "text": "వాట్సాప్"
    },
    {
      "t": "02:12",
      "text": "పర్సనల్ అయితే కాంటాక్ట్ అవ్వండి"
    },
    {
      "t": "02:14",
      "text": "మా"
    },
    {
      "t": "02:16",
      "text": "ఇంట్లో మాట్లాడి దీంట్లో వెళ్ళిపోతాం అంతే"
    },
    {
      "t": "02:18",
      "text": "వెరీ గుడ్"
    },
    {
      "t": "02:20",
      "text": "గుడ్ కలర్"
    },
    {
      "t": "02:22",
      "text": "అయితే"
    },
    {
      "t": "02:24",
      "text": "అవన్నీ పెట్టుకొని"
    },
    {
      "t": "02:26",
      "text": "చదువుతున్నావా"
    },
    {
      "t": "02:28",
      "text": "ఏం చదువుతున్నాం"
    },
    {
      "t": "02:30",
      "text": "అర్థం కాదు"
    },
    {
      "t": "02:32",
      "text": "ఏం చేస్తున్నావు"
    },
    {
      "t": "02:34",
      "text": "అంటే ఖాళీ జాబ్ సర్చింగ్లో ఉన్నాను"
    },
    {
      "t": "02:36",
      "text": "డిగ్రీ అవుతుంది అంతే"
    },
    {
      "t": "02:38",
      "text": "ప్రాపర్"
    },
    {
      "t": "02:40",
      "text": "ఎక్కడ"
    },
    {
      "t": "02:42",
      "text": "ఓకే"
    },
    {
      "t": "02:44",
      "text": "ఆహా మీది నెల్లూరు నంది నెల్లూరు"
    },
    {
      "t": "02:46",
      "text": "అవునా ఎక్కడ"
    },
    {
      "t": "02:48",
      "text": "ఏదో అట్లా అన్నా"
    },
    {
      "t": "02:50",
      "text": "ఆమె ఎల్లూరు అంట"
    },
    {
      "t": "02:52",
      "text": "ఓకే ఓకే"
    },
    {
      "t": "02:54",
      "text": "చెప్పండి"
    },
    {
      "t": "02:56",
      "text": "చెప్పాలి"
    },
    {
      "t": "02:58",
      "text": "ఆంటీ లెక్క యూజ్ చేస్తున్నారు యాభై"
    },
    {
      "t": "03:00",
      "text": "ఆ"
    },
    {
      "t": "03:02",
      "text": "డబ్బులు అబ్బా"
    },
    {
      "t": "03:04",
      "text": "డబ్బులు ఏముంది అలా"
    },
    {
      "t": "03:06",
      "text": "ఉన్నామనుకో"
    },
    {
      "t": "03:08",
      "text": "ట్వంటీ వన్ అవర్ అయినా చూస్తారు"
    },
    {
      "t": "03:10",
      "text": "ఒక్కొక్కరు చెప్తున్న ఒక హాఫ్ అన్ అవర్ ఏం చూస్తారు"
    },
    {
      "t": "03:12",
      "text": "టూ హండ్రెడ్ దాకా వస్తుంది కదా"
    },
    {
      "t": "03:14",
      "text": "వాళ్ళు ప్రవేశపెట్టారు"
    },
    {
      "t": "03:16",
      "text": "మాట్లాడుకుంటున్నారు అంతే"
    },
    {
      "t": "03:18",
      "text": "ఆయన ఈ రోజు చూసినప్పుడు"
    },
    {
      "t": "03:20",
      "text": "నెంబర్ ఇస్తారు"
    },
    {
      "t": "03:22",
      "text": "చూపిస్తాను నెంబర్ ఇస్తాను"
    },
    {
      "t": "03:24",
      "text": "అవును మనకు దీంట్లో వచ్చేది చాలా"
    },
    {
      "t": "03:26",
      "text": "ఆ"
    },
    {
      "t": "03:28",
      "text": "ఓకే"
    },
    {
      "t": "03:30",
      "text": "ఓకే"
    },
    {
      "t": "03:32",
      "text": "ఆ"
    },
    {
      "t": "03:34",
      "text": "అదేవిధంగా"
    },
    {
      "t": "03:36",
      "text": "ఓకే"
    },
    {
      "t": "03:38",
      "text": "అది దీంట్లో దీంట్లోదే చాలా"
    },
    {
      "t": "03:40",
      "text": "నాలుగు అంతే ఇంకా"
    },
    {
      "t": "03:42",
      "text": "అక్కడ అవన్నీ పెట్టుకుంటే ఇంకా"
    },
    {
      "t": "03:44",
      "text": "కాయినట్టే"
    },
    {
      "t": "03:46",
      "text": "ఆ"
    },
    {
      "t": "03:48",
      "text": "బాగున్నా"
    },
    {
      "t": "03:50",
      "text": "దీంట్లోది దీంట్లో చాలు"
    },
    {
      "t": "03:52",
      "text": "ఎందుకు అంత పర్సనల్గా వచ్చేది"
    },
    {
      "t": "03:54",
      "text": "చార్జెస్ కోసం మాత్రం"
    },
    {
      "t": "03:56",
      "text": "మాట్లాడుకుంటున్నా అంతే జాబ్ గురించి"
    },
    {
      "t": "03:58",
      "text": "గురించి చార్జెస్ గురించి కొంచెం"
    },
    {
      "t": "04:00",
      "text": "ఇన్కమ్ గురించే ప్రాబ్లం"
    },
    {
      "t": "04:02",
      "text": "సో ఏదో మాట్లాడుకుంటున్నాను అంటే"
    },
    {
      "t": "04:04",
      "text": "మాట్లాడుకుంటూ అంతే పర్సనల్గా ఇచ్చి"
    },
    {
      "t": "04:06",
      "text": "చెప్పి చూపించి అవన్నీ"
    },
    {
      "t": "04:08",
      "text": "బాగోదు చూడ్డానికి"
    },
    {
      "t": "04:10",
      "text": "నాకైనా అసలు"
    },
    {
      "t": "04:12",
      "text": "అబ్బా అనిపించింది"
    },
    {
      "t": "04:14",
      "text": "నిన్న అయితే ఒకడు ఏమన్నాడంటే ఐదు"
    },
    {
      "t": "04:16",
      "text": "ఐదు నిమిషాలే కదా ఏమవుతుంది"
    },
    {
      "t": "04:18",
      "text": "ఈ సొమ్మేమో నరికిపోతుందంట"
    },
    {
      "t": "04:20",
      "text": "అందరికీ"
    },
    {
      "t": "04:22",
      "text": "ఒకేలాగా అనిపించదు"
    },
    {
      "t": "04:24",
      "text": "కొందరు ఏంటంటే విడిచేస్తారు"
    },
    {
      "t": "04:26",
      "text": "అంతే ఒళ్ళునైనా మనసునైనా దేన్నైనా"
    },
    {
      "t": "04:28",
      "text": "నాకు అదే గిల్టీ ఫీలింగ్ ఉంటుంది ఏదైనా"
    },
    {
      "t": "04:30",
      "text": "అండ్"
    },
    {
      "t": "04:32",
      "text": "సో అది అంత"
    },
    {
      "t": "04:34",
      "text": "తేలిక కాదు"
    },
    {
      "t": "04:36",
      "text": "అవును"
    },
    {
      "t": "04:38",
      "text": "అలా అన్నమాట"
    },
    {
      "t": "04:40",
      "text": "ఉన్నారా"
    },
    {
      "t": "04:42",
      "text": "వాళ్ళు హాస్టల్లో"
    },
    {
      "t": "04:44",
      "text": "ఇదిగో ఇంక బయటకు వచ్చాను"
    },
    {
      "t": "04:46",
      "text": "మాట్లాడుతుంటూ ఇక్కడ"
    },
    {
      "t": "04:48",
      "text": "బయట ఉన్న బాల్కనీలో"
    },
    {
      "t": "04:50",
      "text": "ఇది"
    },
    {
      "t": "04:52",
      "text": "ఎంత హాస్పిటల్ ఇది"
    },
    {
      "t": "04:54",
      "text": "సెవెన్"
    },
    {
      "t": "04:56",
      "text": "ఎక్కడ"
    },
    {
      "t": "04:58",
      "text": "గుట్ట"
    },
    {
      "t": "05:00",
      "text": "ఆటో ఎక్కువే"
    },
    {
      "t": "05:02",
      "text": "ఆ"
    },
    {
      "t": "05:04",
      "text": "జిన్ సమూహం"
    },
    {
      "t": "05:06",
      "text": "సో అవి మనకు చేస్తాయా"
    },
    {
      "t": "05:08",
      "text": "ఇడ్లీ"
    },
    {
      "t": "05:10",
      "text": "సెవెన్ వచ్చేస్తాయా"
    },
    {
      "t": "05:12",
      "text": "అర్థం కాదు"
    },
    {
      "t": "05:14",
      "text": "మంత్లీ సెవెన్ వస్తాయా"
    },
    {
      "t": "05:16",
      "text": "మంత్లీ అబ్బే నేను అప్పుడప్పుడు"
