  "segments": [
    {
      "t": "00:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "ஹலோ ஹலோ"
    },
    {
      "t": "00:04",
      "text": "ஹாய் ஹாய்"
    },
    {
      "t": "00:06",
      "text": "என்னென்ன கால் பண்ணுறீங்க"
    },
    {
      "t": "00:08",
      "text": "நான் போடுறேன்"
    },
    {
      "t": "00:10",
      "text": "ஆம்பூர் ம்"
    },
    {
      "t": "00:12",
      "text": "ஓகே ஓகே நான் கோயம்புத்தூர்"
    },
    {
      "t": "00:14",
      "text": "ஓகேங்க சொன்னாங்க"
    },
    {
      "t": "00:16",
      "text": "என்ன பண்ணுறீங்க"
    },
    {
      "t": "00:18",
      "text": "அவருக்கு போய்விட்டுருக்கேன்"
    },
    {
      "t": "00:20",
      "text": "இருக்கேன் இப்போது சும்மா தான் ரூமில் இருக்கேன்"
    },
    {
      "t": "00:22",
      "text": "லீவ் அன்னைக்கு"
    },
    {
      "t": "00:24",
      "text": "ம் லீவ்"
    },
    {
      "t": "00:26",
      "text": "சரி ஓகே ஓகே நானும் ஒரு ப்ரைவேட் கம்பெனி தான்"
    },
    {
      "t": "00:28",
      "text": "டெம்பிள் ஒர்க் பண்ணிட்டுருக்குறேன்"
    },
    {
      "t": "00:30",
      "text": "நானும் லீவு"
    },
    {
      "t": "00:32",
      "text": "எக்ஸ்ப்ளோர் ஃபோன்"
    },
    {
      "t": "00:34",
      "text": "ம் அப்புறம் சொல்லுங்கள் லன்ச் முடிஞ்சு"
    },
    {
      "t": "00:36",
      "text": "அச்சா அருஞ்சித் ஐயா"
    },
    {
      "t": "00:38",
      "text": "முடிஞ்சுட்டு தான் பார்த்துருக்கேன்"
    },
    {
      "t": "00:40",
      "text": "ஓகே ஓகே என்ன சாப்பிட்டீங்க"
    },
    {
      "t": "00:42",
      "text": "சாதம் தான் சாதம்"
    },
    {
      "t": "00:44",
      "text": "தயிர்"
    },
    {
      "t": "00:46",
      "text": "பயிர்"
    },
    {
      "t": "00:48",
      "text": "ஓகே மேடம்"
    },
    {
      "t": "00:50",
      "text": "சொந்தக்காரர் லைஃப்லாம் எப்படி போகுது"
    },
    {
      "t": "00:52",
      "text": "ஏதோ பொழுது அப்படி"
    },
    {
      "t": "00:54",
      "text": "உங்களுக்கு ஆ போ"
    },
    {
      "t": "00:56",
      "text": "போதும்"
    },
    {
      "t": "00:58",
      "text": "சரி சரி சரி சரி"
    },
    {
      "t": "01:00",
      "text": "அப்புறம் சொல்லுங்கள்"
    },
    {
      "t": "01:02",
      "text": "வேறு வேறு"
    },
    {
      "t": "01:04",
      "text": "வேறு என்ன சொல்கிறது"
    },
    {
      "t": "01:06",
      "text": "வேறு என்ன சொல்கிற இந்த ஆப் எத்தனை நாளைக்கு"
    },
    {
      "t": "01:08",
      "text": "யூஸ் பண்ணிட்டுருக்கீங்க"
    },
    {
      "t": "01:10",
      "text": "இந்த பீப்பிளும் ஜஸ்ட் ஒரு ஒன் வீக் ஆகுது"
    },
    {
      "t": "01:12",
      "text": "வாங்கிட்டு வந்து"
    },
    {
      "t": "01:14",
      "text": "எப்படி பேசுகிறாங்க"
    },
    {
      "t": "01:16",
      "text": "ஒவ்வொருத்தரும் ஜாலியாக பேசுகிறாங்க"
    },
    {
      "t": "01:18",
      "text": "ஒவ்வொருத்தராக சக்சியாக பேசுகிறாங்க"
    },
    {
      "t": "01:20",
      "text": "ம்"
    },
    {
      "t": "01:22",
      "text": "வேறு எப்படி பேசுகிறாங்களோ அப்படி பேசிவிட்டு போயிடலாம்"
    },
    {
      "t": "01:24",
      "text": "சரி"
    },
    {
      "t": "01:26",
      "text": "இப்போ அவங்களுக்கு"
    },
    {
      "t": "01:28",
      "text": "ஜாலியாக பேசுறது பிடிச்சிருக்கா இல்லை செக்ஸியாக பேசுறது பிடிச்சிருக்கா"
    },
    {
      "t": "01:30",
      "text": "சுற்றுலா"
    },
    {
      "t": "01:32",
      "text": "இவ ரெண்டுமே தான்"
    },
    {
      "t": "01:34",
      "text": "ஏதோ ஒன்று தான் சொல்லுவாங்க ரெண்டு மணி நேரம்"
    },
    {
      "t": "01:36",
      "text": "ஜாலியாக பேச வேண்டியது தான்"
    },
    {
      "t": "01:38",
      "text": "சரி சரி சரி சரி சரி சரி"
    },
    {
      "t": "01:40",
      "text": "சிக்ஸ் ஏ பர்சன்டேஜ் தான்"
    },
    {
      "t": "01:42",
      "text": "ஓகே ஓகே ஓகே"
    },
    {
      "t": "01:44",
      "text": "அங்கே"
    },
    {
      "t": "01:46",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "01:48",
      "text": "தொண்ணூறா ஐம்பது ரூபாய் இல்லை"
    },
    {
      "t": "01:50",
      "text": "ம் சொந்த ஊரே ஐம்பது ரூபா"
    },
    {
      "t": "01:52",
      "text": "ஓகே"
    },
    {
      "t": "01:54",
      "text": "வீட்டில் வீட்டில் மட்டும்"
    },
    {
      "t": "01:56",
      "text": "மீட்டர்"
    },
    {
      "t": "01:58",
      "text": "ஓகே"
    },
    {
      "t": "02:00",
      "text": "அப்புறம் கேர்ள் ஃப்ரெண்ட்ஸ் எல்லாம் இருக்கிறாங்களா"
    },
    {
      "t": "02:02",
      "text": "கேர்ள் ஃப்ரெண்டாக இருந்தால் எடுக்கிந்தேன்"
    },
    {
      "t": "02:04",
      "text": "அது ஏங்க எல்லாரும்"
    },
    {
      "t": "02:06",
      "text": "இதே டைலாக் போடு எங்கள் கேர்ள் ஃப்ரெண்ட் இருந்தால் ஏங்க"
    },
    {
      "t": "02:08",
      "text": "ஏன் நாங்கள் இந்த ஆப்ட்டுக்கு வரோம் அப்படின்னு"
    },
    {
      "t": "02:10",
      "text": "ம் உண்மையான விஷயம் தானே"
    },
    {
      "t": "02:12",
      "text": "கேர்ள் ஃப்ரெண்டான அவங்ககிட்ட பேசிட்டு இருக்கிறதுக்கு டைம்"
    },
    {
      "t": "02:14",
      "text": "சரியாக போய்ட்டாங்களா ஆமாம்"
    },
    {
      "t": "02:16",
      "text": "ஆ"
    },
    {
      "t": "02:18",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "02:20",
      "text": "அப்புறம்"
    },
    {
      "t": "02:22",
      "text": "வேறு என்ன சொல்கிறது"
    },
    {
      "t": "02:24",
      "text": "வேறு என்ன சொல்கிறது"
    },
    {
      "t": "02:26",
      "text": "சொல்கிறது வேறு என்ன கேட்குறதுன்னு தெரியலையே"
    },
    {
      "t": "02:28",
      "text": "ம் ம்"
    },
    {
      "t": "02:30",
      "text": "சிக்னலை சொல்கிறாங்க"
    },
    {
      "t": "02:32",
      "text": "புரியல ஏதாச்சும்"
    },
    {
      "t": "02:34",
      "text": "கேளுங்கள் ஹலோ சொல்லுங்கள்"
    },
    {
      "t": "02:36",
      "text": "அடுத்தது"
    },
    {
      "t": "02:38",
      "text": "ஓகே"
    },
    {
      "t": "02:40",
      "text": "சரி"
    },
    {
      "t": "02:42",
      "text": "நீங்க தான் ஸ்கேன் பண்ணணும்"
    },
    {
      "t": "02:44",
      "text": "நான் பதில் சொல்கிறேன் நீங்கள் எப்படி"
    },
    {
      "t": "02:46",
      "text": "எப்படி பேசுவீங்க"
    },
    {
      "t": "02:48",
      "text": "இன்னும் ஜாலியாக தான் பேசுகிறேன் ஆனால் சரி"
    },
    {
      "t": "02:50",
      "text": "சேப்பிச்ச மாட்டேன் நார்மல்"
    },
    {
      "t": "02:52",
      "text": "ஓகே ஜாலியாக பேசுனா போதும்"
    },
    {
      "t": "02:54",
      "text": "ஆ"
    }
