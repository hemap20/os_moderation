    {
      "t": "00:06",
      "text": "ஆ சொல்லுங்க"
    },
    {
      "t": "00:08",
      "text": "சொல்லுங்கள் எங்கேருந்து பேசுகிறீங்க"
    },
    {
      "t": "00:10",
      "text": "இல்லையே"
    },
    {
      "t": "00:12",
      "text": "சென்னைங்க நியூவில்"
    },
    {
      "t": "00:14",
      "text": "ஆ போயம்போது"
    },
    {
      "t": "00:16",
      "text": "ம் என்ன பண்ணுறீங்க"
    },
    {
      "t": "00:18",
      "text": "ஆ உட்காந்துட்டேன் இங்கே என்ன பண்ணுறது"
    },
    {
      "t": "00:20",
      "text": "ம் லைக்"
    },
    {
      "t": "00:22",
      "text": "லிசன்ஸ் வந்து"
    },
    {
