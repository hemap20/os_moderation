      "text": "ம்"
    },
    {
      "t": "00:26",
      "text": "எப்படி போகுது லைஃப் லாங்"
    },
    {
      "t": "00:28",
      "text": "ம் நல்லா போதும் மேடம்"
    },
    {
      "t": "00:30",
      "text": "வாட்ஸ்அப்பில் பேசலாமா"
    },
    {
      "t": "00:32",
      "text": "இன்ட்ரஸ்டடா"
    },
    {
      "t": "00:34",
      "text": "ஹலோ"
    },
    {
      "t": "00:36",
