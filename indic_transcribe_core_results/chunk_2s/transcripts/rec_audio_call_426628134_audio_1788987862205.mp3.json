  "segments": [
    {
      "t": "00:00",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": "ಹಾಯ್"
    },
    {
      "t": "00:06",
      "text": "ಕೇಳಿದ್ದ"
    },
    {
      "t": "00:08",
      "text": "ಲೋಕಲಿಂಗು"
    },
    {
      "t": "00:10",
      "text": "ತುಮಕೂರು"
    },
    {
      "t": "00:12",
      "text": "ನಿಮ್ಮ ಹೆಸ್ರು"
    },
    {
      "t": "00:14",
      "text": "ನೈಸ್"
    },
    {
      "t": "00:16",
      "text": "ಸ್ನೇಹ ನಿಮೇಜು"
    },
    {
      "t": "00:18",
      "text": "ಚಿಂತೆ ತ್ರೀ"
    },
    {
      "t": "00:20",
      "text": "ಟ್ವೆಂಟಿ ತ್ರೀ ಏನು ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "00:22",
      "text": "ಬರಿಕೊಂಡದ್ದು"
    },
    {
      "t": "00:24",
      "text": "ನಾನು ಇಷ್ಟೇ"
    },
    {
      "t": "00:26",
      "text": "ಮಲ್ಕೊಂಡಿದ್ದೆ"
    },
    {
      "t": "00:28",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:30",
      "text": "ಊಟ ಆಯಿತಾ"
    },
    {
      "t": "00:32",
      "text": "ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "00:34",
      "text": "ಆಯಿತು"
    },
    {
      "t": "00:36",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:38",
      "text": "ಏನಿಲ್ಲ ಯಾಕೆ ನಿದ್ದೆ ಬಂದಿಲ್ಲ"
    },
    {
      "t": "00:40",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "00:42",
      "text": "ಏಕೆ"
    },
    {
      "t": "00:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:46",
      "text": "ಕಂದ"
    },
    {
      "t": "00:48",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:50",
      "text": "ಗೊತ್ತಿಲ್ಲ ಸುಮ್ಮನೆ"
    },
    {
      "t": "00:52",
      "text": "ವಾಯ್ಸ್"
    },
    {
      "t": "00:54",
      "text": "ಕೇಳಿಸ್ತಿಲ್ಲ"
    },
    {
      "t": "00:56",
      "text": "ಗೊತ್ತಿಲ್ಲ ಸುಮ್ಮನೆ ಬಂದಿಲ್ಲ"
    },
    {
      "t": "00:58",
      "text": "ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "01:00",
      "text": "ಏನಾದರೂ ರೊಮ್ಯಾಂಟಿಕ್"
    },
    {
      "t": "01:02",
      "text": "ಅಕ್ಕನ ಮತ್ತೊಂದು ಮಗ"
    },
    {
      "t": "01:04",
      "text": "ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "01:06",
      "text": "ಡ್ರೆಸ್ ಹಾಕೊಂಡಿದ್ದೇನೆ ನಿಮಗೆ"
    },
    {
      "t": "01:08",
      "text": "ಪ್ರಾಕ್ಟೀಸ್"
    },
    {
      "t": "01:10",
      "text": "ಕೆಳಗಡೆ"
    },
    {
      "t": "01:12",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:14",
      "text": "ಹ್ಞೂ ಓಕೆ"
    },
    {
      "t": "01:16",
      "text": "ಮತ್ತು"
    },
    {
      "t": "01:18",
      "text": "ಎಷ್ಟು ಗಬ್ಬಿ ಸೈಜು"
    },
    {
      "t": "01:20",
      "text": "ತರ್ಟಿ ಟು"
    },
    {
      "t": "01:22",
      "text": "ನಾನು ಬರ್ತೀನಿ ಸೀರೆ"
    },
    {
      "t": "01:24",
      "text": "ಕಟ್ಕೊಂತೀಯ"
    },
    {
      "t": "01:26",
      "text": "ಯಾವ"
    },
    {
      "t": "01:28",
      "text": "ಕಲರ್ ಸೀರೆ ಬಿದ್ದಿದೆ"
    },
    {
      "t": "01:30",
      "text": "ಸೀರೆ ಹಾಕೋದಕ್ಕೆ"
    },
    {
      "t": "01:32",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:34",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "01:36",
      "text": "ಏನು ಸೌಂಡ್ ಇದು"
    },
    {
      "t": "01:38",
      "text": "ಸೌಂಡು"
    },
    {
      "t": "01:40",
      "text": "ಯಾರೋ ಕಿರ್ಚಿದ"
    },
    {
      "t": "01:42",
      "text": "ದೊರೆಯಿಂದ"
    },
    {
      "t": "01:44",
      "text": "ಪೇಸುವೆ"
    },
    {
      "t": "01:46",
      "text": "ಕ್ಷೇತ್ರ ಸ್ಥಳವಂಗೆ"
    },
    {
      "t": "01:48",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:50",
      "text": "ನನಗೇನು"
    },
    {
      "t": "01:52",
      "text": "ಪುಟ್ಟಿಲುಪ್ಪು"
    },
    {
      "t": "01:54",
      "text": "ಆಸೆ ಇರಬೇಕು"
    },
    {
      "t": "01:56",
      "text": "ಕಟ್ಕೊಂತೀಯ"
    },
    {
      "t": "01:58",
      "text": "ಇರೋ ಕಾಲು ಮುಗದ್ಬಿಟ್ಟು"
    },
    {
      "t": "02:00",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:02",
      "text": "ಸೀರೆ ಎಷ್ಟು"
    },
    {
      "t": "02:04",
      "text": "ಓ ಬೇಬಿ"
    },
    {
      "t": "02:06",
      "text": "ಸರಿ ಆಯಿತು"
    },
    {
      "t": "02:08",
      "text": "ಯಾವುದೋ ಒಂದು ರೀತಿಯ"
    },
    {
      "t": "02:10",
      "text": "ಕಟ್ಕೊಂತೀಯ"
    },
    {
      "t": "02:12",
      "text": "ಸರಿ"
    },
    {
      "t": "02:14",
      "text": "ಆಯ್ತು"
    },
    {
      "t": "02:16",
      "text": "ಸೂಪರ್ ಬೇಬಿ ಡೋರ್ ಓಪನ್ ಮಾಡಿ ಬಂದೆ"
    },
    {
      "t": "02:18",
      "text": "ಮತ್ತು"
    },
    {
      "t": "02:20",
      "text": "ಏನು ಸರ್"
    },
    {
      "t": "02:22",
      "text": "ಸಕ್ಕತ್ತಾಗಿ ಕಾಣಿಸ್ತಿದ್ಯಾ ಬೇಬಿ"
    },
    {
      "t": "02:24",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:26",
      "text": "ಹಂಗೆ ನೀನು ಎತ್ಕೊಂಡು ಹೋಗಿ"
    },
    {
      "t": "02:28",
      "text": "ಬೆಡ್ ಮೇಲೆ ಕೂರಿಸಿ"
    },
    {
      "t": "02:30",
      "text": "ರೂಮ್ ಟಾಪ್"
    },
    {
      "t": "02:32",
      "text": "ತೊಡಕ್ತೀನಿ"
    },
    {
      "t": "02:34",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:36",
      "text": "ಗಿರಿ ಬೆಡ್ ಮೇಲೆ ಮಲಗಿಸಿ"
    },
    {
      "t": "02:38",
      "text": "ಖುಷಿ"
    },
    {
      "t": "02:40",
      "text": "ನೀನು ಒಟ್ಟು ಎತ್ತರ ಎಲ್ಲ ಹಾಕಿಸಿ"
    },
    {
      "t": "02:42",
      "text": "ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "02:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:46",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:48",
      "text": "ಮಾಡು"
    },
    {
      "t": "02:50",
      "text": "ಹಾಗೆ ಒಂಚೂರು ನಿಲ್ಲಿಸಿರೋ"
    },
    {
      "t": "02:52",
      "text": "ಜೆರಾಕ್ಸ್ ಬಿಟ್ಟು"
    },
    {
      "t": "02:54",
      "text": "ನೀನು ಒಕ್ಕಲತ್ರಲ್ಲ"
    },
    {
      "t": "02:56",
      "text": "ಲಗೇಜ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "02:58",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:00",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:02",
      "text": "ಓಹ್"
    },
    {
      "t": "03:04",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:06",
      "text": "ಸಕ್ಕತ್ತಾಗಿ ಕಾಣಿಸ್ತದೆ"
    },
    {
      "t": "03:08",
      "text": "ಅದೇ ರೀತಿ"
    },
    {
      "t": "03:10",
      "text": "ಏನು ಮಾಡೋದು ಇಷ್ಟ"
    },
    {
      "t": "03:12",
      "text": "ತಣ್ಣಗೆ ಹಾಂ"
    },
    {
      "t": "03:14",
      "text": "ಏನು ಮಾಡೋದು ಇಷ್ಟ ನನಗೆ"
    },
    {
      "t": "03:16",
      "text": "ಧನಗಾ"
    },
    {
      "t": "03:18",
      "text": "ಎಲ್ಲ"
    },
    {
      "t": "03:20",
      "text": "ನಾನು ಬೇಬಿ"
    },
    {
      "t": "03:22",
      "text": "ಹೌದು"
    },
    {
      "t": "03:24",
      "text": "ಹೌದು"
    },
    {
      "t": "03:26",
      "text": "ಇನ್ನು ಇನ್ನು ಇನ್ನು ಕ್ಲತ್ರ"
    },
    {
      "t": "03:28",
      "text": "ಕಾಲು ಚೇನ್ ತುಪ್ಪ ಹಾಕಿ ಫುಲ್ ಟೇಸ್ಟ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "03:30",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:32",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:34",
      "text": "ಎಸ್ ಬಿ ಬಿ"
    },
    {
      "t": "03:36",
      "text": "ಹೌದಾ"
    },
    {
      "t": "03:38",
      "text": "ಹಂಗೆ ತಪ್ಪು"
    },
    {
      "t": "03:40",
      "text": "ಕಣ್ಣು ನಿನ್ನ"
    },
    {
      "t": "03:42",
      "text": "ಇನ್ನೇನಾಗ್ತದೆ"
    },
    {
      "t": "03:44",
      "text": "ತಪ್ಪಿಕೊಂಡು"
    },
    {
      "t": "03:46",
      "text": "ನಿನ್ಗೆ ಗೊತ್ತಾದ್ರೆ ನಾನು"
    },
    {
      "t": "03:48",
      "text": "ಟಾಕೀಸ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "03:50",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:52",
      "text": "ಓಟು"
    },
    {
      "t": "03:54",
      "text": "ಪಿಕೇಸ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "03:56",
      "text": "ಇಸ್ಕೊಡು"
    },
    {
      "t": "03:58",
      "text": "ಕೊಡ್ತಾ ಇದ್ದೀನಿ ಹಂಗೆ ನೀನು ಮುಕ್ತ"
    },
    {
      "t": "04:00",
      "text": "ಕೋನ ತಿರುಗ್ಸಿ"
    },
    {
      "t": "04:02",
      "text": "ಇನ್ನೊಂದು ಗಿಫ್ಟ್ಸ್ ನಾನು"
    },
    {
      "t": "04:04",
      "text": "ಟೇಸ್ಟ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "04:06",
      "text": "ಕಿಸ್ ಕೊಡುತ್ತೆ"
    },
    {
      "t": "04:08",
      "text": "ಸೊಂಟ"
    },
    {
      "t": "04:10",
      "text": "ತಪ್ಪೇ ಬಿ"
    },
    {
      "t": "04:12",
      "text": "ಹಾಂ"
    },
    {
      "t": "04:14",
      "text": "ಮತ್ತು"
    },
    {
      "t": "04:16",
      "text": "ನೀರು ಕೊಡು"
    },
    {
      "t": "04:18",
      "text": "ಹೌದು"
    },
    {
      "t": "04:20",
      "text": "ಆಮೇಲೆ"
    },
    {
      "t": "04:22",
      "text": "ಬೇಬಿ ಸ್ನ್ಯಾಪ್ಚೆಟ್ ಯೂಸ್ ಮಾಡ್ತಿದ್ದೀಯಾ"
    },
    {
      "t": "04:24",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "04:26",
      "text": "ನಿನ್ನ ನೋಡ್ತೀನಿ"
    },
    {
      "t": "04:28",
      "text": "ಕಲ್ತಿದ್ದೇವೆ ಬಿ"
    },
    {
      "t": "04:30",
      "text": "ನಾನೇನು ಹೆಸರು ಹಾಕ್ತಿರ್ಲಿಲ್ಲ"
    },
    {
      "t": "04:32",
      "text": "ಸರಿ ಬಾಯ್"
    },
    {
      "t": "04:34",
      "text": "ಬೇಬಿ ಕಿಸ್"
    },
    {
      "t": "04:36",
      "text": "ಕೊಡು"
    },
    {
      "t": "04:38",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:40",
      "text": "ಹೌದು"
    },
    {
      "t": "04:42",
      "text": "ಸಕ್ಕತ್ತಾಗಿದೆ"
    },
    {
      "t": "04:44",
      "text": "ಬ್ರಿಟಿಷ್ ಡು"
    },
    {
      "t": "04:46",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:48",
      "text": "ಅದಕ್ಕೆ ನೆನ್ಪಲ್ಲಿರೋ ನಮಿತೆ"
    },
    {
      "t": "04:50",
      "text": "ಟೆಕ್ ಡೋ"
    },
    {
      "t": "04:52",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:54",
      "text": "ಇನ್ನೇನು ಕ್ಲಿವೇಜ್ ಹತ್ರ ಎಲ್ಲ ಕಿಸ್ ಮಾಡ್ತೀವಿ"
    },
    {
      "t": "04:56",
      "text": "ನಿಮ್ಮ ಬ್ಲೌಸ್ ಮೇಲೆ"
    },
    {
      "t": "04:58",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "05:00",
      "text": "ಸಕ್ಕತ್ತಾಗಿದೆ ಬೇಬಿ"
    },
    {
      "t": "05:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "05:04",
      "text": "ಚೆಸ್"
    },
    {
      "t": "05:06",
      "text": "ಕ್ಲಿಕ್ ಮಾಡ್ತಾ ಇದ್ದೀನಿ"
    },
    {
      "t": "05:08",
      "text": "ದಿವ್ಯ ಜಾತ್ರೆ ಅಲ್ಲ"
    },
    {
      "t": "05:10",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "05:12",
      "text": "ಈ ಬ್ಲೌಸ್ನ ಮೆತ್ತಗೆ"
    },
    {
      "t": "05:14",
      "text": "ಬಿಚ್ತೀನಿ ಒಂದೊಂದೇ ಹುಕ್ಸ್ ಬಿಚ್ತೀನಿ"
    },
    {
      "t": "05:16",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "05:18",
      "text": "ವಿಚ್"
    },
    {
      "t": "05:20",
      "text": "ಬ್ಲೌಸ್ನ ಬಿಸಾಕಿ"
    },
    {
      "t": "05:22",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "05:24",
      "text": "ಕೈ ಎತ್ತಿ ನಿನ್ನ ಅಂಡರ್ ಆರ್ಮ್ಸ್ನೆಲ್ಲ ಕಿಸ್ ಮಾಡು"
    },
    {
      "t": "05:26",
      "text": "ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "05:28",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "05:30",
      "text": "ಸಕ್ಕತ್ತಾಗಿದೆ ಬೇಬಿ"
    },
    {
      "t": "05:32",
      "text": "ಏನು"
    },
    {
      "t": "05:34",
      "text": "ಹಾಂ"
    },
    {
      "t": "05:36",
      "text": "ಏನು ಅಂಡರ್ ಆನ್ಸರ್"
    },
    {
      "t": "05:38",
      "text": "ಆ ಥರ ಎಲ್ಲ ಕ್ಲಿಸ್ ಮಾಡ್ತಿದ್ದೀನಿ ಅಂದೆ"
    },
    {
      "t": "05:40",
