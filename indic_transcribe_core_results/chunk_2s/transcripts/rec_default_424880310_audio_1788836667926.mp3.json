      "text": "हेलो"
    },
    {
      "t": "00:06",
      "text": "ओके ओके"
    },
    {
      "t": "00:08",
      "text": "कहाँ से"
    },
    {
      "t": "00:10",
      "text": "चलो"
    },
    {
      "t": "00:12",
      "text": "क्या बोले"
    },
    {
      "t": "00:14",
      "text": "ओके"
    },
    {
      "t": "00:16",
      "text": "गुजरात"
    },
    {
      "t": "00:18",
      "text": "हाँ"
    },
    {
      "t": "00:20",
      "text": "क्या करते हो"
    },
    {
      "t": "00:22",
      "text": "रेस्टोरेंट"
    },
    {
      "t": "00:24",
      "text": "मस्ती में बाहर बाहर से आँख से"
    },
    {
      "t": "00:26",
      "text": "अब मैरिड"
    },
    {
      "t": "00:28",
      "text": "न"
    },
    {
      "t": "00:30",
      "text": "नौ"
    },
    {
      "t": "00:32",
      "text": "इस ऐप पर कब से आएँ"
    },
    {
      "t": "00:34",
      "text": "आपकी तरह भी"
    },
    {
      "t": "00:36",
      "text": "हाँ"
    },
    {
      "t": "00:38",
      "text": "मैं मैरिड नहीं हूँ"
    },
    {
      "t": "00:40",
      "text": "अनमैरिड हो"
    },
    {
      "t": "00:42",
      "text": "हाँ"
    },
    {
      "t": "00:44",
      "text": "मेरिडोर"
    },
    {
      "t": "00:46",
      "text": "नौ"
    },
    {
      "t": "00:48",
      "text": "हेलो"
    },
    {
      "t": "00:50",
      "text": "ग्रामीणों ने"
    },
    {
      "t": "00:52",
      "text": "क्यों"
    },
    {
      "t": "00:54",
      "text": "जी"
    },
    {
      "t": "00:56",
      "text": "और"
    },
    {
      "t": "00:58",
      "text": "हाँ"
    },
    {
      "t": "01:00",
      "text": "रहते नहीं हैं"
    },
    {
      "t": "01:02",
      "text": "अनमेरिड वाली की बड़ी ने"
    },
    {
      "t": "01:04",
      "text": "रहती है"
    },
    {
      "t": "01:06",
      "text": "कल"
    },
    {
      "t": "01:08",
      "text": "क्या पता"
    },
    {
      "t": "01:10",
      "text": "आप"
    },
    {
      "t": "01:12",
      "text": "लोग हमसे ज़्यादा जानते होंगे"
    },
    {
      "t": "01:14",
      "text": "खूब सजना"
    },
    {
      "t": "01:16",
      "text": "है ना"
    },
    {
      "t": "01:18",
      "text": "सुपरहिट हाँ सुपर"
    },
    {
      "t": "01:20",
      "text": "अरे कहेंगे"
    },
    {
      "t": "01:22",
      "text": "लोपस"
    },
    {
      "t": "01:24",
      "text": "क्या बोले"
    },
    {
      "t": "01:26",
      "text": "होली के दिन"
    },
    {
      "t": "01:28",
      "text": "सर"
    },
    {
      "t": "01:30",
      "text": "ओपन"
    },
    {
      "t": "01:32",
      "text": "दूरदर्शन को लेकर प्रकाश"
    },
    {
      "t": "01:34",
      "text": "सॉरी आपन सुनो"
    },
    {
      "t": "01:36",
      "text": "आज शाम तक सत्रह हज़ार"
    },
    {
      "t": "01:38",
      "text": "तीन हज़ार रुपये करने की मांग की जा रही है"
    },
    {
      "t": "01:40",
      "text": "प्रिंसिपल ने"
    },
    {
      "t": "01:42",
      "text": "करेगा"
    },
    {
      "t": "01:44",
      "text": "हाँ"
    },
    {
      "t": "01:46",
      "text": "छत्तीसगढ़"
    },
    {
      "t": "01:48",
      "text": "अपने आप को मैं कलेक्टर ऑफिस को"
    },
    {
      "t": "01:50",
      "text": "आप लोग देख के बड़े"
    },
    {
      "t": "01:52",
      "text": "देख के जज कर लेते हो कि मैं मैच"
    },
    {
      "t": "01:54",
      "text": "मैनेडू मैनेडू"
    },
    {
      "t": "01:56",
      "text": "थाना क्षेत्र में"
    },
    {
      "t": "01:58",
      "text": "पतझड़ रहता है"
    },
    {
      "t": "02:00",
      "text": "पंचायत सहायक संघ"
    },
    {
      "t": "02:02",
      "text": "हमला भी नहीं पकड़े सिर्फ"
    },
    {
      "t": "02:04",
      "text": "सरकारी नौकरी करने की मांग कर रही है"
    },
    {
      "t": "02:06",
      "text": "अच्छा मैं अगर मैरिड बोलूँगी तो क्या आप"
    },
    {
      "t": "02:08",
      "text": "आप मेरे से बातें नहीं करोगे"
    },
    {
      "t": "02:10",
      "text": "मुझे तो बाप"
    },
    {
      "t": "02:12",
      "text": "में ज़्यादा इंटरेस्टेड है"
    },
    {
      "t": "02:14",
      "text": "तो फिर भाभी"
    },
    {
      "t": "02:16",
      "text": "की मर्ज़ी लेने के लिए ना"
    },
    {
      "t": "02:18",
      "text": "और"
    },
    {
      "t": "02:20",
      "text": "कि भाभी ने"
    },
    {
      "t": "02:22",
      "text": "क्या हुआ नहीं हुआ अभी"
    },
    {
      "t": "02:24",
      "text": "के साथ"
    },
    {
      "t": "02:26",
      "text": "हाँ"
    },
    {
      "t": "02:28",
      "text": "कैसा करता है कितना"
    },
    {
      "t": "02:30",
      "text": "हाँ"
    },
    {
      "t": "02:32",
      "text": "क्यों आप ही"
    },
    {
      "t": "02:34",
      "text": "गर्लफ्रेंड नहीं है क्या"
    },
    {
      "t": "02:36",
      "text": "मैं"
    },
    {
      "t": "02:38",
      "text": "नहीं"
    },
    {
      "t": "02:40",
      "text": "क्यू इज़ एच भी तो सब ठीक है"
    },
    {
      "t": "02:42",
      "text": "इयरफिन रहती है कॉलेज टाइम से"
    },
    {
      "t": "02:44",
      "text": "जी"
    },
    {
      "t": "02:46",
      "text": "कॉलेज में नहीं हूँ मैं बिज़नेस"
    },
    {
      "t": "02:48",
      "text": "तो आप"
    },
    {
      "t": "02:50",
      "text": "देखो बिज़नेस करते हो तो आप तो"
    },
    {
      "t": "02:52",
      "text": "जाहिल तो अब तो पढ़ाई तो नहीं किए होंगे"
    },
    {
      "t": "02:54",
      "text": "प्रायः तो किए होंगे ना"
    },
    {
      "t": "02:56",
      "text": "मैरिड नहीं हूँ यार"
    },
    {
      "t": "02:58",
      "text": "जा"
    },
    {
      "t": "03:00",
      "text": "मूव्स तो दिखा दो आप"
    },
    {
      "t": "03:02",
      "text": "ये जो आखिरी क्लास है इसमें"
    },
    {
      "t": "03:04",
      "text": "क्या ऊपर"
    },
    {
      "t": "03:06",
      "text": "धन्यवाद"
    },
    {
      "t": "03:08",
      "text": "मैं बुरी ना सॉरी"
    },
    {
      "t": "03:10",
      "text": "ओपन सो नहीं करती हूँ मैं"
    },
    {
      "t": "03:12",
      "text": "एयर टू"
    },
    {
      "t": "03:14",
      "text": "विकास"
    },
    {
      "t": "03:16",
      "text": "ब्रांड के साथ दिखा सकती हूँ ओपन सोलो"
    },
    {
      "t": "03:18",
      "text": "प्रसिद्ध प्रकाश पथक राज्यसभा"
    },
    {
      "t": "03:20",
      "text": "लिखो"
    },
    {
      "t": "03:22",
      "text": "सत"
    },
    {
      "t": "03:24",
      "text": "अच्छा"
    },
    {
      "t": "03:26",
      "text": "ठीक है ठीक है"
    },
    {
      "t": "03:28",
      "text": "आज का हमारे साथी"
    },
    {
      "t": "03:30",
      "text": "हाँ"
    },
    {
      "t": "03:32",
      "text": "चौदह चौदह"
    },
    {
      "t": "03:34",
      "text": "डिज़ाइन बना कर रखिएगा अपना"
    },
    {
      "t": "03:36",
      "text": "जी"
    },
    {
      "t": "03:38",
      "text": "एक"
    },
    {
      "t": "03:40",
      "text": "क्या"
    },
    {
      "t": "03:42",
      "text": "गुजरात बद्री विद्यालय अंतर्गत"
    },
    {
      "t": "03:44",
      "text": "क्या बोले"
    },
    {
      "t": "03:46",
      "text": "दरअसल ये तीन ठो"
    },
    {
      "t": "03:48",
      "text": "हाँ"
    },
    {
      "t": "03:50",
      "text": "हाँ जी"
    },
    {
      "t": "03:52",
      "text": "अंदर कैसे लेते हैं"
    },
    {
      "t": "03:54",
      "text": "जी"
    },
    {
      "t": "03:56",
      "text": "कैसे लेती हूँ क्या"
    },
    {
      "t": "03:58",
      "text": "प्रदर्शन के दौरान"
    },
    {
      "t": "04:00",
      "text": "हाँ"
    },
    {
      "t": "04:02",
      "text": "हाँ"
    },
    {
      "t": "04:04",
      "text": "हाँ जैसे आप बोल रहे हो"
    },
    {
      "t": "04:06",
      "text": "प्रस आ"
    },
    {
      "t": "04:08",
      "text": "हाँ"
    },
    {
      "t": "04:10",
      "text": "दस दस में पाँच सौ रुपये"
    },
    {
      "t": "04:12",
      "text": "सात नवंबर से अठहत्तर"
    },
    {
      "t": "04:14",
      "text": "आत्महत्या"
    },
    {
      "t": "04:16",
      "text": "आजकल प्रयास की बात करते हैं"
    },
    {
      "t": "04:18",
      "text": "अच्छा"
    },
    {
      "t": "04:20",
      "text": "हाँ"
    },
    {
      "t": "04:22",
      "text": "हाँ"
    },
    {
      "t": "04:24",
      "text": "बिहार बिहार के बाद"
    },
    {
      "t": "04:26",
      "text": "कुछ परहेज किया होगा"
    },
    {
      "t": "04:28",
      "text": "ग्राहक के बारे में क्या कहता है"
    },
    {
      "t": "04:30",
      "text": "आप भी दरवाज़े रखती है सरकार"
    },
    {
      "t": "04:32",
      "text": "जो कि जब भी"
    },
    {
      "t": "04:34",
      "text": "हाँ"
    },
    {
      "t": "04:36",
      "text": "हाँ"
    },
    {
      "t": "04:38",
      "text": "हाँ"
    },
    {
      "t": "04:40",
      "text": "विराट चक्र के"
    },
    {
      "t": "04:42",
      "text": "हाँ"
    },
    {
      "t": "04:44",
      "text": "वन वन वन"
    },
    {
      "t": "04:46",
      "text": "मेरा खराब हो गया पता है"
    },
    {
      "t": "04:48",
      "text": "यहाँ"
    },
    {
      "t": "04:50",
      "text": "हाँ"
    },
    {
      "t": "04:52",
      "text": "तो क्या करना चाहिए"
    },
    {
      "t": "04:54",
      "text": "मोबाइल फोन ले कर"
    },
    {
      "t": "04:56",
      "text": "क्या"
    },
    {
      "t": "04:58",
      "text": "तब कौन लेगा इसको"
    },
    {
      "t": "05:00",
      "text": "समुदाय"
    },
    {
      "t": "05:02",
      "text": "क्या लूँगी"
    },
    {
      "t": "05:04",
      "text": "इसको दो"
    },
    {
      "t": "05:06",
      "text": "नहीं"
    },
    {
      "t": "05:08",
      "text": "हाँ"
    },
    {
      "t": "05:10",
      "text": "क्वाड नंबर आठ"
    },
    {
      "t": "05:12",
      "text": "हाँ"
    },
    {
      "t": "05:14",
      "text": "हाँ"
    },
    {
      "t": "05:16",
      "text": "मैं जा रहा हूँ"
    },
    {
      "t": "05:18",
      "text": "हाँ"
    },
    {
      "t": "05:20",
      "text": "ठीक है"
    },
    {
      "t": "05:22",
      "text": "वो बनता है"
    },
    {
      "t": "05:24",
      "text": "जी सर मैंने नुकसान से ऊपर पहुँच गया है"
    },
    {
      "t": "05:26",
      "text": "आसमान से लाकर गुज़ारेंगे"
    },
    {
      "t": "05:28",
      "text": "अत्यंत"
    },
    {
      "t": "05:30",
      "text": "ठीक है"
    },
    {
      "t": "05:32",
      "text": "हाँ"
    },
    {
      "t": "05:34",
      "text": "उत्तर प्रदेश के पुराने वासी"
    },
    {
      "t": "05:36",
      "text": "राम सुंदर अच्छे संविधान के साथ"
    },
    {
      "t": "05:38",
      "text": "प्रचार प्रसार हमारे"
    },
    {
      "t": "05:40",
      "text": "प्रशासन की"
    },
    {
      "t": "05:42",
      "text": "मन मन मन में बनाएंगे"
    },
    {
      "t": "05:44",
      "text": "हम्म"
    },
    {
      "t": "05:46",
      "text": "हाँ"
    },
    {
      "t": "05:48",
      "text": "उधर देखते हैं"
    },
    {
      "t": "05:50",
      "text": "प्रधानमंत्री"
    },
    {
      "t": "05:52",
      "text": "नेपाल छोड़कर कहाँ कहाँ"
    },
    {
      "t": "05:54",
      "text": "पाँच"
    },
    {
      "t": "05:56",
      "text": "एक घंटा का काम आप देखो"
    },
    {
      "t": "05:58",
      "text": "और उसके रिलीज को देखना है"
    },
    {
      "t": "06:00",
      "text": "अच्छा"
    },
    {
      "t": "06:02",
      "text": "हाँ"
    },
    {
      "t": "06:04",
      "text": "इट मीन्स"
    },
    {
      "t": "06:06",
      "text": "ये है आपकी"
    },
    {
      "t": "06:08",
      "text": "निरंतर हम जोधपुर पर भी भारत"
    },
    {
      "t": "06:10",
      "text": "ये तीन इंच की है"
    },
    {
      "t": "06:12",
      "text": "बड़े नेताओं के लिए"
    },
    {
      "t": "06:14",
      "text": "पूरा"
    },
    {
      "t": "06:16",
      "text": "हाँ"
    },
    {
      "t": "06:18",
      "text": "तीन"
    },
    {
      "t": "06:20",
      "text": "तीन इंच"
    },
    {
      "t": "06:22",
      "text": "की है ये तो बच्ची"
    },
    {
      "t": "06:24",
      "text": "की होती है आप तो और हो"
    },
    {
      "t": "06:26",
      "text": "इसमें"
    },
    {
      "t": "06:28",
      "text": "के आरोपी युवाओं के द्वारा किया गया"
    },
    {
      "t": "06:30",
      "text": "ठीक है यार"
    },
    {
      "t": "06:32",
      "text": "हाँ"
    },
    {
      "t": "06:34",
      "text": "हाँ"
    },
    {
      "t": "06:36",
      "text": "राजकमल जी बोलो क्या होता है"
    },
    {
      "t": "06:38",
      "text": "नहीं करने वालों को रोका पूरा कर दिया"
    },
    {
      "t": "06:40",
      "text": "सबसे ज़्यादा आँखों को दर्द किया है"
    },
