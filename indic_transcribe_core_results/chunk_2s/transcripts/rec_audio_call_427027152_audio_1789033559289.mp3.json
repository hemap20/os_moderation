{
  "file_id": "rec_audio_call_427027152_audio_1789033559289.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 743.954,
  "processing_time_sec": 1948.8007264137268,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "ഹലോ"
    },
    {
      "t": "00:04",
      "text": "ഹലോ ഹലോ ആ"
    },
    {
      "t": "00:06",
      "text": "ഹലോ"
    },
    {
      "t": "00:08",
      "text": "ലൗ കേൾക്കാമോ"
    },
    {
      "t": "00:10",
      "text": "കേക്ക് മണ്ടലം"
    },
    {
      "t": "00:12",
      "text": "രണ്ട് സ്ഥലം"
    },
    {
      "t": "00:14",
      "text": "കളി"
    },
    {
      "t": "00:16",
      "text": "ഹലോ"
    },
    {
      "t": "00:18",
      "text": "എറണാകുളം"
    },
    {
      "t": "00:20",
      "text": "എന്തു ചെയ്യുന്നു"
    },
    {
      "t": "00:22",
      "text": "ആ"
    },
    {
      "t": "00:24",
      "text": "ഹൗസ് വൈഫാണ്"
    },
    {
      "t": "00:26",
      "text": "കൊല്ലത്തെവിടെയാ"
    },
    {
      "t": "00:28",
      "text": "ആ"
    },
    {
      "t": "00:30",
      "text": "ഡീറ്റെയിൽസ് പറയാൻ"
    },
    {
      "t": "00:32",
      "text": "താല്പര്യമില്ല ആ ഓക്കെ"
    },
    {
      "t": "00:34",
      "text": "ഇനി"
    },
    {
      "t": "00:36",
      "text": "ജോലി ഉണ്ടോ"
    },
    {
      "t": "00:38",
      "text": "ആ"
    },
    {
      "t": "00:40",
      "text": "ഇല്ല ഇല്ല ഹൗസ് വൈഫ് ആണോ"
    },
    {
      "t": "00:42",
      "text": "ആ"
    },
    {
      "t": "00:44",
      "text": "അതെ"
    },
    {
      "t": "00:46",
      "text": "എന്താ"
    },
    {
      "t": "00:48",
      "text": "എത്ര വയസ്സുണ്ട്"
    },
    {
      "t": "00:50",
      "text": "എനിക്ക് ട്വന്റി ഫൈവ്"
    },
    {
      "t": "00:52",
      "text": "മ്മ്"
    },
    {
      "t": "00:54",
      "text": "എത്ര ഉണ്ടേ ചേച്ചി"
    },
    {
      "t": "00:56",
      "text": "എയ്റ്റ്"
    },
    {
      "t": "00:58",
      "text": "മ്മ്"
    },
    {
      "t": "01:00",
      "text": "ഇതിൽ കുറേ ആയോ"
    },
    {
      "t": "01:02",
      "text": "ആറ്"
    },
    {
      "t": "01:04",
      "text": "മൂന്നാല് മാസമാകുന്നു"
    },
    {
      "t": "01:06",
      "text": "ആരൊക്കെയുണ്ട് അപ്പോൾ"
    },
    {
      "t": "01:08",
      "text": "എന്ത്"
    },
    {
      "t": "01:10",
      "text": "വീട്ടിൽ ആരൊക്കെയുണ്ട്"
    },
    {
      "t": "01:12",
      "text": "വീട്ടിൽ ഇപ്പം ഞാൻ ധരിച്ചേ ഉള്ളൂ"
    },
    {
      "t": "01:14",
      "text": "ഹലോ"
    },
    {
      "t": "01:16",
      "text": "ആ"
    },
    {
      "t": "01:18",
      "text": "മാരീഡ് ആണെന്നല്ലേ പറഞ്ഞത്"
    },
    {
      "t": "01:20",
      "text": "അതെ അതെ"
    },
    {
      "t": "01:22",
      "text": "പ്രശ്നമുണ്ടോ"
    },
    {
      "t": "01:24",
      "text": "ഹസ്ബൻഡ് പുറത്താണ് അബുദാബിയിൽ"
    },
    {
      "t": "01:26",
      "text": "അല്ല"
    },
    {
      "t": "01:28",
      "text": "മ്മ്"
    },
    {
      "t": "01:30",
      "text": "ഇളന്തു പിടിച്ചതാ"
    },
    {
      "t": "01:32",
      "text": "ആ"
    },
    {
      "t": "01:34",
      "text": "ലേസ് ആണോ"
    },
    {
      "t": "01:36",
      "text": "ആ"
    },
    {
      "t": "01:38",
      "text": "എല്ലാം"
    },
    {
      "t": "01:40",
      "text": "ജോലിക്കൊന്നും ട്രൈ ചെയ്തില്ലേ"
    },
    {
      "t": "01:42",
      "text": "ഇല്ല ഇല്ല"
    },
    {
      "t": "01:44",
      "text": "മ്മ്"
    },
    {
      "t": "01:46",
      "text": "എത്രയാണ് കല്യാണം കഴിഞ്ഞത്"
    },
    {
      "t": "01:48",
      "text": "ആൻഡ് അബൗ"
    },
    {
      "t": "01:50",
      "text": "വൺ ഇയർ ആവുന്നതേ ഉള്ളൂ"
    },
    {
      "t": "01:52",
      "text": "ഞാൻ ടു ഇയർ ആയി കല്യാണം കഴിഞ്ഞു"
    },
    {
      "t": "01:54",
      "text": "അതായത്"
    },
    {
      "t": "01:56",
      "text": "ഇല്ല"
    },
    {
      "t": "01:58",
      "text": "കുട്ടികളൊന്നും ഇല്ലേ"
    },
    {
      "t": "02:00",
      "text": "ആയിട്ടില്ല"
    },
    {
      "t": "02:02",
      "text": "വൈഫ് വൈഫ്"
    },
    {
      "t": "02:04",
      "text": "എഞ്ചിനീയർ അജോയ് ലീ ഉണ്ട്"
    },
    {
      "t": "02:06",
      "text": "വൈഫ്"
    },
    {
      "t": "02:08",
      "text": "ആ"
    },
    {
      "t": "02:10",
      "text": "ഓക്കേ"
    },
    {
      "t": "02:12",
      "text": "ആ"
    },
    {
      "t": "02:14",
      "text": "പിന്നെന്താ"
    },
    {
      "t": "02:16",
      "text": "വേറെ പ്രത്യേകിച്ച്"
    },
    {
      "t": "02:18",
      "text": "എന്താ പറയാൻ വന്നത് വൈഫ്"
    },
    {
      "t": "02:20",
      "text": "വൈഫിന് മാത്രം"
    },
    {
      "t": "02:22",
      "text": "അത്ര ജോലിയുള്ളൂ എന്ന് എനിക്കുണ്ട്"
    },
    {
      "t": "02:24",
      "text": "എന്താണ്"
    },
    {
      "t": "02:26",
      "text": "ബിസിനസ്സാണ് എനിക്കൊരു തുണിക്കട"
    },
    {
      "t": "02:28",
      "text": "കടയാണ് പിന്നെ"
    },
    {
      "t": "02:30",
      "text": "ലേഡീസിന്റെ ബോട്ടിൽ"
    },
    {
      "t": "02:32",
      "text": "തിരികെ വന്നിട്ട്"
    },
    {
      "t": "02:34",
      "text": "എവിടെയാണ് എറണാകുളം തന്നെ"
    },
    {
      "t": "02:36",
      "text": "ആ"
    },
    {
      "t": "02:38",
      "text": "ഓക്കെ ഓക്കെ പേരെന്താ"
    },
    {
      "t": "02:40",
      "text": "ചൈത്രം എന്ന് പറയും"
    },
    {
      "t": "02:42",
      "text": "ആ ഓക്കെ"
    },
    {
      "t": "02:44",
      "text": "ഒന്നാമത് വന്നിട്ടുണ്ടോ"
    },
    {
      "t": "02:46",
      "text": "ആ"
    },
    {
      "t": "02:48",
      "text": "ഇടയ്ക്കൊക്കെ വരാറുണ്ട് ആണോ എവിടെ"
    },
    {
      "t": "02:50",
      "text": "ആ"
    },
    {
      "t": "02:52",
      "text": "എറണാകുളത്തൊക്കെ വരാറുണ്ട്"
    },
    {
      "t": "02:54",
      "text": "സ്ഥിരം പറയാൻ താല്പര്യമില്ലേ"
    },
    {
      "t": "02:56",
      "text": "ഏ"
    },
    {
      "t": "02:58",
      "text": "ഇല്ല ഇല്ല"
    },
    {
      "t": "03:00",
      "text": "ഏയ് ഞാനാ ഡേയ്ഞ്ചറാ"
    },
    {
      "t": "03:02",
      "text": "ഒന്നുമല്ലെന്നേ ഞാൻ ഇത്രയും"
    },
    {
      "t": "03:04",
      "text": "വിവരങ്ങളൊക്കെ വേണ്ടേ കൊല്ലത്ത് എങ്ങനെയാണ് വരുന്നത്"
    },
    {
      "t": "03:06",
      "text": "പ്രോ പ്രോപ്പർ"
    },
    {
      "t": "03:08",
      "text": "എറണാകുളം തന്നെയാണോ ഷോപ്പ് ഉള്ളത്"
    },
    {
      "t": "03:10",
      "text": "ആ പാലാരിവട്ടം"
    },
    {
      "t": "03:12",
      "text": "ആഹ് കിൻസ്ട്രേറ്റ്"
    },
    {
      "t": "03:14",
      "text": "വീട്ടിലുണ്ടോ ഞാനാ"
    },
    {
      "t": "03:16",
      "text": "ആ ലയർ"
    },
    {
      "t": "03:18",
      "text": "ഷോപ്പിന്റെ ഷോപ്പിന്റെ ഒന്നുമില്ല എനിക്ക്"
    },
    {
      "t": "03:20",
      "text": "നിൽക്കണ്ട ഞാൻ മറ്റേ സ്പോർട്സിലായിട്ടുള്ള ഒരു"
    },
    {
      "t": "03:22",
      "text": "ചാനലൊക്കെ ചെയ്യുന്ന എനിക്ക് അത്യാവശ്യം"
    },
    {
      "t": "03:24",
      "text": "ഒരു ടെൻ കെ എബൗ ഫോളോവേഴ്സ് ഒക്കെ ഉള്ളൂ"
    },
    {
      "t": "03:26",
      "text": "ആ"
    },
    {
      "t": "03:28",
      "text": "അതിന് ചെറിയ മാർക്ക്"
    },
    {
      "t": "03:30",
      "text": "കളറൊക്കെ ചെയ്യാറുണ്ടോ പിന്നെ"
    },
    {
      "t": "03:32",
      "text": "ഫേസ്ബുക്കിൽ നിന്ന് യൂട്യൂബിൽ നിന്ന് മോണിറ്റൈസ് ആയതാ കാശ്"
    },
    {
      "t": "03:34",
      "text": "കിട്ടാറുണ്ട്"
    },
    {
      "t": "03:36",
      "text": "ഫേസ്ബുക്കിൽ നിന്നും"
    },
    {
      "t": "03:38",
      "text": "ഫേസ്ബുക്കിൽ നിന്ന് യൂട്യൂബിൽ നിന്ന്"
    },
    {
      "t": "03:40",
      "text": "കാശ് കിട്ടാറുണ്ട്"
    },
    {
      "t": "03:42",
      "text": "മോണിറ്റൈസ് ആയ ഒരു ചാനലൊക്കെ ഉണ്ട്"
    },
    {
      "t": "03:44",
      "text": "ആ"
    },
    {
      "t": "03:46",
      "text": "ഓ അപ്പോൾ ഫേസ്ബുക്കിൽ നമുക്ക് ഇത്ര ഫോളോവേഴ്സ്"
    },
    {
      "t": "03:48",
      "text": "വ്യൂസ് ഒക്കെ ആയെങ്കിലല്ലേ നമുക്ക് പൈസ കിട്ടുള്ളൂ"
    },
    {
      "t": "03:50",
      "text": "അത്രേയുള്ളൂ അത് ഫൈവ് കെ കഴിയണം പിന്നെ ഒരു"
    },
    {
      "t": "03:52",
      "text": "തേർട്ടി മില്യൺ എല്ലാം കൂടെ അടിക്കണം എനിക്കൊരു"
    },
    {
      "t": "03:54",
      "text": "എയിറ്റ് പോയിന്റ് ഫൈവ് ഉണ്ട്"
    },
    {
      "t": "03:56",
      "text": "അല്ല നമുക്കൊരു ഫൈവ് കെ"
    },
    {
      "t": "03:58",
      "text": "ഫൈവ് കെ ഫോർ ഫോർ"
    },
    {
      "t": "04:00",
      "text": "ഫോളോവേഴ്സ് ഉണ്ടെങ്കിൽ പേയ്മെൻറ്റ് കിട്ടുക"
    },
    {
      "t": "04:02",
      "text": "അങ്ങനെയൊന്നുമില്ല അതിന് കുറച്ച് കാര്യങ്ങളുണ്ട്"
    },
    {
      "t": "04:04",
      "text": "അതായത് ഇത്ര ദിവസത്തിനുള്ളിൽ അങ്ങനെയൊക്കെ അതിൽ"
    },
    {
      "t": "04:06",
      "text": "കുറെ ഇത് വരുമേ സ്റ്റോറി എത്ര ഇടണം"
    },
    {
      "t": "04:08",
      "text": "അങ്ങനെയൊക്കെ കുറേ കാര്യങ്ങൾ കഴിഞ്ഞിട്ട് അത് മോഡേൺ ആയിട്ട്"
    },
    {
      "t": "04:10",
      "text": "ജനുവൻ നമ്മൾ"
    },
    {
      "t": "04:12",
      "text": "അവിടെ തന്നെ ഓൺ കണ്ടന്റ് ആയിരിക്കണം"
    },
    {
      "t": "04:14",
      "text": "അങ്ങനെ കുറെ കാര്യങ്ങളുണ്ട് ചുമ്മാ"
    },
    {
      "t": "04:16",
      "text": "അതും കേട്ടില്ല"
    },
    {
      "t": "04:18",
      "text": "ഓ എനിക്കൊരു ടെൻ കെയിൽ കൂടുതലുണ്ട്"
    },
    {
      "t": "04:20",
      "text": "കൊളോസെൻറ്റാ"
    },
    {
      "t": "04:22",
      "text": "ആ ഫേസ്ബുക്കിൽ എന്താ ഇടുന്നത്"
    },
    {
      "t": "04:24",
      "text": "പൈനാത്ത്"
    },
    {
      "t": "04:26",
      "text": "പ്രത്യേകിച്ചൊന്നുമില്ല എൻ്റെ ഫോട്ടോസ്"
    },
    {
      "t": "04:28",
      "text": "വീഡിയോസ് മോണിറ്റൈസ് ആയോ"
    },
    {
      "t": "04:30",
      "text": "കണ്ടന്റ് മോണിറ്റൈസേഷൻ ആയോ"
    },
    {
      "t": "04:32",
      "text": "എനിക്ക് സംഭവങ്ങളൊന്നും"
    },
    {
      "t": "04:34",
      "text": "ഒന്നും അറിഞ്ഞുകൂടാ"
    },
    {
      "t": "04:36",
      "text": "ആ പ്രൊഫഷണൽ ഡാഷ്"
    },
    {
      "t": "04:38",
      "text": "ചൂടൊക്കെ എടുക്കേണ്ടി വരും"
    },
    {
      "t": "04:40",
      "text": "അതൊക്കെ എടുത്തിട്ടുണ്ട് അതല്ല അതിൽ"
    },
    {
      "t": "04:42",
      "text": "ഇപ്പം ഇത്"
    },
    {
      "t": "04:44",
      "text": "കാണത്തുള്ളൂ അത് കണ്ടന്റ് മോണിറ്റൈസേഷൻ ആണോ"
    },
    {
      "t": "04:46",
      "text": "ഇടുന്നതിനെല്ലാം കാശ് കിട്ടും"
    },
    {
      "t": "04:48",
      "text": "ഓ എനിക്ക്"
    },
    {
      "t": "04:50",
      "text": "അതൊക്കെ ചെയ്യുന്നത് എങ്ങനെയാണെന്നുള്ള ഒരു ഇത് അറിയത്തില്ല"
    },
    {
      "t": "04:52",
      "text": "ആ ചുമ്മാ അല്ലാണ്ട് ഡാഷ് ബോർഡ് ഒക്കെ"
    },
    {
      "t": "04:54",
      "text": "അത്യാവശ്യം ബ്ലൗസ് ഒക്കെ ഉള്ള"
    },
    {
      "t": "04:56",
      "text": "ഡീറ്റെയിൽ ഒന്നും ആദ്യം തന്നെ ബ്ലോക്ക് ചെയ്തു"
    },
    {
      "t": "04:58",
      "text": "ഡീറ്റെയിൽസ് ഒന്നും പറയാൻ താല്പര്യമില്ലല്ലോ"
    },
    {
      "t": "05:00",
      "text": "അല്ലല്ല"
    },
    {
      "t": "05:02",
      "text": "ഫേസ്ബുക്കിൽ മാത്രമേ ഉള്ളൂ ഇൻസ്റ്റയിലെങ്കിൽ"
    },
    {
      "t": "05:04",
      "text": "ഇങ്ങനെ ഫോളോവേഴ്സൊക്കെ ആയി ഇങ്ങനെ"
    },
    {
      "t": "05:06",
      "text": "ഇൻസ്റ്റ പൈസ ഒന്നും കിട്ടത്തില്ല"
    },
    {
      "t": "05:08",
      "text": "ഫേസ്ബുക്കിൽ കിട്ടും"
    },
    {
      "t": "05:10",
      "text": "ആ ഇൻസ്റ്റ കിട്ടത്തില്ലെന്ന് അറിയാം"
    },
    {
      "t": "05:12",
      "text": "സ്റ്റേപ്പിൻ്റെ കൊളാബ് കാര്യങ്ങളൊക്കെ കിട്ടിയെങ്കിലല്ലേ"
    },
    {
      "t": "05:14",
      "text": "അതേ ഉള്ളൂ പിന്നെ നമുക്ക് എങ്ങനെ"
    },
    {
      "t": "05:16",
      "text": "മെസ്സേജ് ഒക്കെ കൂടുതൽ പ്രമോഷൻ ഒക്കെ വിളിക്കും"
    },
    {
      "t": "05:18",
      "text": "ഇൻസ്റ്റഗ്രാം വഴിയാണ്"
    },
    {
      "t": "05:20",
      "text": "അതാണോ"
    },
    {
      "t": "05:22",
      "text": "അതുകൊണ്ടാണ് എനിക്ക് യൂട്യൂബ്"
    },
    {
      "t": "05:24",
      "text": "യൂട്യൂബിനേക്കാളും കൂടുതൽ കിട്ടുന്നത് ഫേസ്ബുക്കിലാണ്"
    },
    {
      "t": "05:26",
      "text": "കേട്ടോ"
    },
    {
      "t": "05:28",
      "text": "ആ ഇൻസ്റ്റ"
    },
    {
      "t": "05:30",
      "text": "കൊളാബൊക്കെ ചെയ്തിട്ടുണ്ടോ"
    },
    {
      "t": "05:32",
      "text": "കൊളാമൊക്കെ എപ്പോഴും നമ്മൾ ഇങ്ങോട്ട്"
    },
    {
      "t": "05:34",
      "text": "ഓ അപ്പം"
    },
    {
      "t": "05:36",
      "text": "ഇതൊക്കെ ചെയ്യുമ്പോൾ പേയ്മെൻറ്റ് കിട്ടാറുണ്ടോ"
    },
    {
      "t": "05:38",
      "text": "ആ നമ്മളിപ്പോ ഒരാളെ എത്ര അതായത്"
    },
    {
      "t": "05:40",
      "text": "വിളിക്കുകയാണെങ്കിൽ എന്താ വെച്ചത്"
    },
    {
      "t": "05:42",
      "text": "ആ ഓക്കേ ഓക്കേ"
    },
    {
      "t": "05:44",
      "text": "മാക്സിമം"
    },
    {
      "t": "05:46",
      "text": "നമ്മളെ ഇപ്പോൾ ഒരാൾ വിളിച്ചെന്ന് വെച്ചു അപ്പം ഈ"
    },
    {
      "t": "05:48",
      "text": "ലൈവ് ഇടാൻ വിളിക്കുവാണേ പെർ ഡേ എൻ്റെ കാശ്"
    },
    {
      "t": "05:50",
      "text": "ആറായിരം രൂപയാണ്"
    },
    {
      "t": "05:52",
      "text": "അപ്പം അവർ ചോദിക്കും കുറച്ച് ഷോട്ട്സ് കൊടുക്കാൻ"
    },
    {
      "t": "05:54",
      "text": "ചാർജ് ഷോട്ട്സ് എടുത്തിട്ട്"
    },
    {
      "t": "05:56",
      "text": "അതിന് നമ്മളൊന്നും മേടിക്കാറൊന്നുമില്ല"
    },
    {
      "t": "05:58",
      "text": "ലൈവ് ഇടുന്നേനെ യൂട്യൂബ് ലൈവ് ഇടുന്നേനെ"
    },
    {
      "t": "06:00",
      "text": "ഇടുന്നതിന്"
    },
    {
      "t": "06:02",
      "text": "പിന്നെ ലൈവ് എന്ന് വെച്ചാൽ അന്നേരം"
    },
    {
      "t": "06:04",
      "text": "തന്നെ ഇടണം ഇവൻ യൂട്യൂബ് ലൈവ്"
    },
    {
      "t": "06:06",
      "text": "ലൈവില്ലേ ഓൺ ഗോയിങ് അല്ലേ ലൈവ്"
    },
    {
      "t": "06:08",
      "text": "ആ മനസ്സിലായി"
    },
    {
      "t": "06:10",
      "text": "ആ"
    },
    {
      "t": "06:12",
      "text": "അല്ലാണ്ട് ഇപ്പം ഒരു എന്തെങ്കിലും"
    },
    {
      "t": "06:14",
      "text": "അപ്പം എന്തിൻ്റേലും ഒരു"
    },
    {
      "t": "06:16",
      "text": "നമ്മൾ വീഡിയോസ് ചെയ്യാനാണെങ്കിൽ"
    },
    {
      "t": "06:18",
      "text": "ഷോപ്പിന്റെ പ്രമോഷൻ ഒക്കെ ചെയ്യാറുണ്ട്"
    },
    {
      "t": "06:20",
      "text": "അതായത് ചെറിയ ഷോട്ട് പോലെ അങ്ങനെ"
    },
    {
      "t": "06:22",
      "text": "ചെയ്യാറുണ്ട് അതിനൊക്കെ നമുക്ക്"
    },
    {
      "t": "06:24",
      "text": "അറിയാവുന്ന ഒരാളാണ് ചെറിയ പൈസക്ക് കീഴിലെങ്കിൽ"
    },
    {
      "t": "06:26",
      "text": "അഞ്ച് രൂപ പതിനഞ്ച് രൂപയൊക്കെ മേടിച്ചിട്ടുണ്ട്"
    },
    {
      "t": "06:28",
      "text": "പതിനഞ്ച്"
    },
    {
      "t": "06:30",
      "text": "പതിനഞ്ച് പന്ത്രണ്ടൊക്കെ മിനിമം കിട്ടും"
    },
    {
      "t": "06:32",
      "text": "നമ്മളറിയാവുന്നവരുടെ"
    },
    {
      "t": "06:34",
      "text": "അങ്ങനെയൊന്നും മേടിക്കാറില്ല മൂന്ന് നാല് രൂപയൊക്കെ മേടിക്കും"
    },
    {
      "t": "06:36",
      "text": "ചെയ്താൽ മതി"
    },
    {
      "t": "06:38",
      "text": "ആ ഹാ"
    },
    {
      "t": "06:40",
      "text": "ആ"
    },
    {
      "t": "06:42",
      "text": "ആ"
    },
    {
      "t": "06:44",
      "text": "ഇല്ല ഞാനങ്ങനെ എൻ്റെ ഇൻസ്റ്റ ഇതാക്കി"
    },
    {
      "t": "06:46",
      "text": "കാക്കാൻ നോക്കുന്നുണ്ട് പക്ഷേ"
    },
    {
      "t": "06:48",
      "text": "കണ്ടിന്യൂസ് എന്തെങ്കിലും ഇട്ടെങ്കിൽ അല്ലേ ഇൻസ്റ്റയിൽ ഒരു"
    },
    {
      "t": "06:50",
      "text": "ആ കണ്ടിന്യൂസ് ഇടണം കണ്ടിന്യൂസ് ഇടണം"
    },
    {
      "t": "06:52",
      "text": "ഒരു കാര്യമില്ല ആ അതെ"
    },
    {
      "t": "06:54",
      "text": "അതാണ് ഭയങ്കര ഒരു ആശ്രയിച്ചു"
    },
    {
      "t": "06:56",
      "text": "ആകെ രണ്ട് ഫോൺ കൊണ്ടാണ് കിടക്കുന്നത് ഇപ്പോഴത്തെ"
    },
    {
      "t": "06:58",
      "text": "കിട്ടുന്ന ടൈമല്ലേ എഡിറ്റ് ചെയ്ത് ഇട്ടുകൊണ്ടിരിക്കുന്നത്"
    },
    {
      "t": "07:00",
      "text": "ഈ ഒരു ടൈമിൽ എനിക്ക് അതുകൊണ്ട് ഗുണമുണ്ട്"
    },
    {
      "t": "07:02",
      "text": "പൈസ കിട്ടുന്നതുകൊണ്ടേ നമുക്ക്"
    },
    {
      "t": "07:04",
      "text": "ഇടാൻ തോന്നും അപ്പോൾ രണ്ട് രണ്ടാ ഒരാഴ്ച"
    },
    {
      "t": "07:06",
      "text": "ഏഴ് ദിവസത്തിനുള്ളിൽ അമ്പത് കേക്ക് അടിക്കും"
    },
    {
      "t": "07:08",
      "text": "എക്സ്ട്രാ ഇൻസെന്റീവ് വിലക്ക് അമ്പത് ഡോളർ ഒക്കെ"
    },
    {
      "t": "07:10",
      "text": "കിട്ടും ഒറ്റയടിക്ക് അയ്യായിരം രൂപ കിട്ടും"
    },
    {
      "t": "07:12",
      "text": "അമ്പത് ഡോളർ ഓ അങ്ങനെയൊക്കെ ഉണ്ടല്ലേ"
    },
    {
      "t": "07:14",
      "text": "ഫേസ്ബുക്ക് കേട്ടോ"
    },
    {
      "t": "07:16",
      "text": "ഫേസ്ബുക്കിൽ അപ്പോൾ എന്തൊക്കെയാണ് ഇടുന്നത് ഫേസ്ബുക്കിൽ"
    },
    {
      "t": "07:18",
      "text": "ഈ കണ്ടന്റ് ഒക്കെ തന്നെയാണ്"
    },
    {
      "t": "07:20",
      "text": "എങ്ങനെ"
    },
    {
      "t": "07:22",
      "text": "ഇതുതന്നെയാണ് ഇവിടെ ഇടുന്നത് സ്പോർട്സ് ക്രിക്കറ്റ് റിലേറ്റഡ് ആയി"
    },
    {
      "t": "07:24",
      "text": "ഞാൻ വുമൺസിൻ്റെ ക്രിക്കറ്റ് ചെയ്തിട്ടുണ്ട് അപ്പോൾ അതിൽ"
    },
    {
      "t": "07:26",
      "text": "എന്റെ അറിയിലൊക്കെ ഇടും ഓഹോ"
    },
    {
      "t": "07:28",
      "text": "ഓ അതൊക്കെ കണ്ടിന്യൂസ് എടുത്ത് വെച്ച്"
    },
    {
      "t": "07:30",
      "text": "വെച്ചേക്കുന്നുണ്ട് ഇടാൻ ഒരു കണ്ടന്റ് ഉണ്ട്"
    },
    {
      "t": "07:32",
      "text": "പക്ഷേ എനിക്കങ്ങനെ"
    },
    {
      "t": "07:34",
      "text": "ഇടണമെന്നുള്ള ഒരിതൊക്കെ ഉണ്ട് പക്ഷേ എനിക്ക് ഇടാനുള്ള"
    },
    {
      "t": "07:36",
      "text": "കിട്ടുന്നില്ല ഓട്ടോ ഇട്ടാലോ കാശ് കിട്ടുന്നില്ല"
    },
    {
      "t": "07:38",
      "text": "ഇത്തരം വിഷയങ്ങൾ"
    },
    {
      "t": "07:40",
      "text": "അതെ"
    },
    {
      "t": "07:42",
      "text": "ക്ലിയർ ആവുന്നില്ല എന്താ ഹലോ"
    },
    {
      "t": "07:44",
      "text": "ഫോട്ടോസിനൊക്കെ കാശ് കിട്ടും"
    },
    {
      "t": "07:46",
      "text": "ഫോട്ടോസിനെ എഴുതുന്നതിനെല്ലാം"
    },
    {
      "t": "07:48",
      "text": "ഫോട്ടോ ഇട്ടാലും എഴുതുന്നതിനും എല്ലാം കറക്റ്റ്"
    },
    {
      "t": "07:50",
      "text": "കാശ് കിട്ടും"
    },
    {
      "t": "07:52",
      "text": "ആ അതൊക്കെ എനിക്കറിയാം പക്ഷേ"
    },
    {
      "t": "07:54",
      "text": "ഇതൊക്കെ കണ്ടിന്യൂസ് ഇതാക്കണ്ടേ"
    },
    {
      "t": "07:56",
      "text": "ആ ആ"
    },
    {
      "t": "07:58",
      "text": "എനിക്കത് അതിൽ ഇൻസ്റ്റൻറ്റ്"
    },
    {
      "t": "08:00",
      "text": "ഇതിലാണ് ഞാൻ കണ്ടിന്യൂസ് ഇപ്പോൾ എൻ്റെ ഫോട്ടോസും വീഡിയോസും"
    },
    {
      "t": "08:02",
      "text": "ഡോസൊക്കെ ഇടാറുണ്ട്"
    },
    {
      "t": "08:04",
      "text": "അങ്ങനെ ഫോളോവേഴ്സ് എ"
    },
    {
      "t": "08:06",
      "text": "പ്രൈവറ്റ് അക്കൗണ്ട് ആയിരുന്നു ഇത്രയും നാൾ ഇപ്പോൾ ഒരു"
    },
    {
      "t": "08:08",
      "text": "മൂന്നാല് മാസമായിട്ടേ ഉള്ളൂ"
    },
    {
      "t": "08:10",
      "text": "പബ്ലിക് അക്കൗണ്ട് ആക്കിയിട്ട്"
    },
    {
      "t": "08:12",
      "text": "ആ അതിൽ കൂടുതൽ ഫോളോവേഴ്സ്"
    },
    {
      "t": "08:14",
      "text": "യൂസ് ഒക്കെ കിട്ടും എന്നുള്ളത്"
    },
    {
      "t": "08:16",
      "text": "എന്നതിൻ്റെ അനുസരിച്ച് നല്ലതായിട്ട് കിട്ടുന്നുണ്ട്"
    },
    {
      "t": "08:18",
      "text": "ആ"
    },
    {
      "t": "08:20",
