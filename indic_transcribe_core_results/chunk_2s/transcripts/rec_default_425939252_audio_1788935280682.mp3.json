{
  "file_id": "rec_default_425939252_audio_1788935280682.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 380.472,
  "processing_time_sec": 214.45945262908936,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "ആ"
    },
    {
      "t": "00:04",
      "text": "ഇതൊക്കെ"
    },
    {
      "t": "00:06",
      "text": "ഓ"
    },
    {
      "t": "00:08",
      "text": "എവിടെയാ സലൂൺ"
    },
    {
      "t": "00:10",
      "text": "ഞാൻ എറണാകുളം"
    },
    {
      "t": "00:12",
      "text": "ചെയ്യണോ"
    },
    {
      "t": "00:14",
      "text": "നിനക്ക് കാർ ഷോപ്പ്"
    },
    {
      "t": "00:16",
      "text": "റൂമിൽ വർക്ക് ചെയ്യുക"
    },
    {
      "t": "00:18",
      "text": "ഇന്ന് വലിയ വർക്കില്ലേ"
    },
    {
      "t": "00:20",
      "text": "എനിക്ക് തോന്നുന്നു"
    },
    {
      "t": "00:22",
      "text": "അഞ്ചു വരെ ഉള്ളായിരുന്നു നമ്മൾ പോകുന്നു പത്തു മണി ആ"
    },
    {
      "t": "00:24",
      "text": "മൂന്ന്"
    },
    {
      "t": "00:26",
      "text": "ആ"
    },
    {
      "t": "00:28",
      "text": "പിന്നെ എവിടെ നിന്നാണ് വിളിക്കുന്നത്"
    },
    {
      "t": "00:30",
      "text": "ഞാൻ ഗുരുവായൂർ"
    },
    {
      "t": "00:32",
      "text": "ഒരു ആന"
    },
    {
      "t": "00:34",
      "text": "എന്ത് ചെയ്യുന്നു"
    },
    {
      "t": "00:36",
      "text": "നാല് ഒരു തിരുമേനിയാണ്"
    },
    {
      "t": "00:38",
      "text": "പിന്നെ"
    },
    {
      "t": "00:40",
      "text": "അമ്പലത്തിലെ തിരുമേനിയാണോ"
    },
    {
      "t": "00:42",
      "text": "ആ"
    },
    {
      "t": "00:44",
      "text": "ബാക്കാണല്ലേ"
    },
    {
      "t": "00:46",
      "text": "ജോൽസിനാ"
    },
    {
      "t": "00:48",
      "text": "മനസ്സിലായില്ലേ"
    },
    {
      "t": "00:50",
      "text": "ഒന്നുമില്ല ഒരു തരികിട പണി"
    },
    {
      "t": "00:52",
      "text": "ഇല്ല"
    },
    {
      "t": "00:54",
      "text": "എന്താ പേര് ശരിക്കും"
    },
    {
      "t": "00:56",
      "text": "എൻ്റെ പേര് ശരണ്യ"
    },
    {
      "t": "00:58",
      "text": "ആ"
    },
    {
      "t": "01:00",
      "text": "ശരിക്ക് സ്ഥലം എവിടെയാണ്"
    },
    {
      "t": "01:02",
      "text": "പത്തനംതിട്ട"
    },
    {
      "t": "01:04",
      "text": "ആ"
    },
    {
      "t": "01:06",
      "text": "ഞാൻ എറണാകുളത്ത് വർക്ക് ചെയ്യുന്ന ആളാണ് ഞാൻ എറണാകുളത്ത് വർക്ക് ചെയ്യുന്ന ആളാണ്"
    },
    {
      "t": "01:08",
      "text": "താമസം എവിടെയാണ്"
    },
    {
      "t": "01:10",
      "text": "ഇവിടെ എറണാകുളത്താണ്"
    },
    {
      "t": "01:12",
      "text": "ഹോസ്റ്റൽ"
    },
    {
      "t": "01:14",
      "text": "ഈ എവിടെയോ താഴോട്ട് പോയോ ഓസ്ട്രേലിയയിലോ"
    },
    {
      "t": "01:16",
      "text": "ഇതൊരു അല്ലല്ല ഇത് അപ്പാർട്ട്മെൻറ്റാണ്"
    },
    {
      "t": "01:18",
      "text": "ആ"
    },
    {
      "t": "01:20",
      "text": "ഏത് അമ്പലത്തില് ശാന്തിയാ"
    },
    {
      "t": "01:22",
      "text": "എൺപത്"
    },
    {
      "t": "01:24",
      "text": "ഇതൊന്നും ഇല്ല ഇപ്പോൾ പത്ത് വയസ്സ് കുറെ ആയില്ല ഇപ്പോൾ"
    },
    {
      "t": "01:26",
      "text": "ഒന്നും സ്ഥിരമൊന്നും പനിയൊന്നുമില്ല"
    },
    {
      "t": "01:28",
      "text": "വല്ലപ്പോഴും പോകും"
    },
    {
      "t": "01:30",
      "text": "അതിന് പരിപാടി കിട്ടിയ അത്രയേ ഉള്ളൂ"
    },
    {
      "t": "01:32",
      "text": "ആണോ ആ"
    },
    {
      "t": "01:34",
      "text": "ജോത്സ്യക്കറിയാവോ"
    },
    {
      "t": "01:36",
      "text": "ഇല്ല ഇല്ല ഇല്ല ഇല്ല"
    },
    {
      "t": "01:38",
      "text": "ജ്യോത്സ്യൻ തരുന്ന"
    },
    {
      "t": "01:40",
      "text": "കരിങ്കടപ്പണിയാണോ"
    },
    {
      "t": "01:42",
      "text": "പരിപാടി ഉണ്ട് അതിൽ ധാരാളം"
    },
    {
      "t": "01:44",
      "text": "ആ"
    },
    {
      "t": "01:46",
      "text": "ആണോ കുഞ്ഞല്ലോ ഒരു പറയണേ"
    },
    {
      "t": "01:48",
      "text": "എല്ലാവരും ഒരുമിച്ച് കൂടുക"
    },
    {
      "t": "01:50",
      "text": "ഒരു കാര്യം ചോദിച്ചോട്ടെ"
    },
    {
      "t": "01:52",
      "text": "ഏഹ്"
    },
    {
      "t": "01:54",
      "text": "ഈ കുഴിനു പാത്രം"
    },
    {
      "t": "01:56",
      "text": "കൂട് പാത്രമെന്ന് പറഞ്ഞാൽ"
    },
    {
      "t": "01:58",
      "text": "അതൊക്കെ അതൊക്കെ കള്ളമാണ് സത്യമാണ്"
    },
    {
      "t": "02:00",
      "text": "എനിക്കറിയില്ല"
    },
    {
      "t": "02:02",
      "text": "അങ്ങനെ അറിയാത്ത അറിയില്ല എന്നാണ് പറയുന്നത്"
    },
    {
      "t": "02:04",
      "text": "ചെറിയ കോള് പാത്രം മറ്റേ പാത്രം"
    },
    {
      "t": "02:06",
      "text": "എനിക്ക് എനിക്ക് ആ ഒരു"
    },
    {
      "t": "02:08",
      "text": "എനിക്ക് ആ ഒരു"
    },
    {
      "t": "02:10",
      "text": "പാത്രത്തിനെ പറ്റി അറിയുള്ളൂ"
    },
    {
      "t": "02:12",
      "text": "അതല്ല ഞാൻ ചോദിച്ചത്"
    },
    {
      "t": "02:14",
      "text": "അർണയം എൻ്റെ ചേട്ടനെ"
    },
    {
      "t": "02:16",
      "text": "എനിക്കൊരു ചേട്ടനുണ്ട് എൻ്റെ മൂത്ത ആൾ"
    },
    {
      "t": "02:18",
      "text": "ആ"
    },
    {
      "t": "02:20",
      "text": "അയാൾ കല്യാണം കഴിച്ചിട്ട്"
    },
    {
      "t": "02:22",
      "text": "അത്ര നല്ല സ്വരത്തിലൊന്നും അല്ല"
    },
    {
      "t": "02:24",
      "text": "കൂട് മാത്രമല്ല കൂടോത്രം"
    },
    {
      "t": "02:26",
      "text": "ഫ്രം നൗ"
    },
    {
      "t": "02:28",
      "text": "ആ അത് തന്നെ അത് തന്നെ"
    },
    {
      "t": "02:30",
      "text": "ഓടും"
    },
    {
      "t": "02:32",
      "text": "അങ്ങനെ ആ പെണ്ണിൻ്റെ"
    },
    {
      "t": "02:34",
      "text": "എൻ്റെ വീട്ടുകാരുണ്ടല്ലോ"
    },
    {
      "t": "02:36",
      "text": "എനിക്ക് എൻ്റെ അമ്മയ്ക്ക്"
    },
    {
      "t": "02:38",
      "text": "ചിലർക്ക് അനുഭവം"
    },
    {
      "t": "02:40",
      "text": "അനുഭവം ഉണ്ടെന്ന് പറയുന്നു നമുക്ക് എന്താവും"
    },
    {
      "t": "02:42",
      "text": "ചെയ്യുന്നുണ്ടാവാം"
    },
    {
      "t": "02:44",
      "text": "എൻ്റെ ചേട്ടൻ്റെ ജീവിതം ആകെ പോയി നശിച്ചു"
    },
    {
      "t": "02:46",
      "text": "ചിരിച്ചുപോയെന്നേ"
    },
    {
      "t": "02:48",
      "text": "ഏക ഭാഗം"
    },
    {
      "t": "02:50",
      "text": "ഭഗവാനെ വിളിക്കുക ഭഗവാനോട് പ്രാർത്ഥിക്കുക"
    },
    {
      "t": "02:52",
      "text": "ചെയ്യാം അതൊക്കെ തെറ്റേ ചെയ്യാവുള്ളൂ ആയിരുന്നു"
    },
    {
      "t": "02:54",
      "text": "പക്ഷേ അതിനകത്ത് വേറൊരു ഇതെന്ന് വെച്ചാൽ അണ്ണൻ"
    },
    {
      "t": "02:56",
      "text": "തന്നെ ജോലി അങ്ങ് ഇവിടെ ഹൈദരാബാദിലാണ്"
    },
    {
      "t": "02:58",
      "text": "മ്മ്"
    },
    {
      "t": "03:00",
      "text": "അണ്ണൻ അവിടെ ഒരു ഒരു പെണ്ണ്"
    },
    {
      "t": "03:02",
      "text": "ആ പെണ്ണിന് ഒരു കൊച്ചുണ്ടാവും"
    },
    {
      "t": "03:04",
      "text": "ഇവിടെ"
    },
    {
      "t": "03:06",
      "text": "അതെ"
    },
    {
      "t": "03:08",
      "text": "ഇവിടുത്തെ ഇവിടുത്തെ ഭാര്യ"
    },
    {
      "t": "03:10",
      "text": "നമ്മുടെ വീടാപ്പിണ്ണ് എൻ്റെ നാത്തൂന്ന് പറയുന്നത് ഹിഡിം"
    },
    {
      "t": "03:12",
      "text": "തമ്പി ആഭനന്റെ വീട്ടിലാണ്"
    },
    {
      "t": "03:14",
      "text": "ആ അവിടെ പോയപ്പോൾ അവിടെ സെറ്റ് ആയി"
    },
    {
      "t": "03:16",
      "text": "ആ പിന്നെ"
    },
    {
      "t": "03:18",
      "text": "വേണ്ട ചേട്ടനും വേണ്ട"
    },
    {
      "t": "03:20",
      "text": "പിന്നെ ലീഗലി ഇങ്ങനെ നിൽക്കുന്നെന്നേ ഉള്ളൂ"
    },
    {
      "t": "03:22",
      "text": "അങ്ങനെ"
    },
    {
      "t": "03:24",
      "text": "അപ്പോൾ അതിനെന്ത് ചെയ്യും"
    },
    {
      "t": "03:26",
      "text": "എന്ത്"
    },
    {
      "t": "03:28",
      "text": "ചെയ്യാനായിട്ട് ഭഗവാനോട് പറയുക നല്ലോണം"
    },
    {
      "t": "03:30",
      "text": "പ്രാർത്ഥിക്കുക നാമം ജപിക്കുക ധാരാളം ദിവസം"
    },
    {
      "t": "03:32",
      "text": "ഇതൊക്കെ ചെയ്യുക"
    },
    {
      "t": "03:34",
      "text": "ചേട്ടനോടും പറയാം"
    },
    {
      "t": "03:36",
      "text": "അവരോടും പറയും അതൊക്കെ തന്നെയാണ് പ്രധാനം"
    },
    {
      "t": "03:38",
      "text": "അന്ന"
    },
    {
      "t": "03:40",
      "text": "ഞാൻ ആ പെണ്ണിനെ വേണ്ട"
    },
    {
      "t": "03:42",
      "text": "വേണ്ടെങ്കിൽ വേണ്ട അത് ഒഴിവായി കിട്ടാൻ പ്രാർത്ഥിക്കും"
    },
    {
      "t": "03:44",
      "text": "കിട്ടിയത് നേരെയാവാൻ പ്രാർത്ഥിക്കും"
    },
    {
      "t": "03:46",
      "text": "ആ"
    },
    {
      "t": "03:48",
      "text": "അല്ല അല്ല തിരുമേനി"
    },
    {
      "t": "03:50",
      "text": "ഒഴിഞ്ഞു പോകാമെന്ന് പറഞ്ഞാൽ"
    },
    {
      "t": "03:52",
      "text": "എന്നിട്ട് ആ പെണ്ണ് ഒഴിഞ്ഞു പോകുന്നില്ല ആ പെണ്ണിന് പൈസ വേണം"
    },
    {
      "t": "03:54",
      "text": "അപ്പം എന്നെ ചോദിക്കുന്നത് വലിയ"
    },
    {
      "t": "03:56",
      "text": "വലിയ എമൗണ്ട്"
    },
    {
      "t": "03:58",
      "text": "അത് പറഞ്ഞിട്ട് നമുക്ക് നേരെയാക്കാൻ പറ്റില്ല"
    },
    {
      "t": "04:00",
      "text": "അതൊക്കെ നമ്മൾ നന്നായിട്ട് നല്ലതായിരിക്കും അത്"
    },
    {
      "t": "04:02",
      "text": "തീരാൻ പ്രാർത്ഥിക്കുക അതെന്താച്ചാ"
    },
    {
      "t": "04:04",
      "text": "അങ്ങോട്ടും ഇങ്ങോട്ടും സഹകരിച്ച് അവസാനിപ്പിക്കുക"
    },
    {
      "t": "04:06",
      "text": "ഞാൻ ഹിന്ദുവാണേ"
    },
    {
      "t": "04:08",
      "text": "ഞാൻ ഹിന്ദുവാണ് ഏറ്റവും നല്ല ദൈവമായി"
    },
    {
      "t": "04:10",
      "text": "ഏതാ ഹിന്ദുവില്"
    },
    {
      "t": "04:12",
      "text": "അങ്ങനെയൊന്നുമില്ല എല്ലാ ദൈവവും നല്ലതാണ്"
    },
    {
      "t": "04:14",
      "text": "അങ്ങനെയൊന്നും ഞാൻ പറയില്ല ഒരു ദൈവം നല്ലത്"
    },
    {
      "t": "04:16",
