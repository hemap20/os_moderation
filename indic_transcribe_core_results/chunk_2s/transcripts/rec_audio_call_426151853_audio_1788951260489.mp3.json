{
  "file_id": "rec_audio_call_426151853_audio_1788951260489.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 816.171,
  "processing_time_sec": 55.77442932128906,
  "segments": [
    {
      "t": "00:00",
      "text": "హలో"
    },
    {
      "t": "00:02",
      "text": "వావ్"
    },
    {
      "t": "00:04",
      "text": "హలో"
    },
    {
      "t": "00:06",
      "text": "హలో హాయ్ ఎక్కడి నుంచి"
    },
    {
      "t": "00:08",
      "text": "అదే"
    },
    {
      "t": "00:10",
      "text": "విజయవాడ నుంచి"
    },
    {
      "t": "00:12",
      "text": "అదే"
    },
    {
      "t": "00:14",
      "text": "విజయవాడ విజయవాడ"
    },
    {
      "t": "00:16",
      "text": "హిందుస్థాన్లో"
    },
    {
      "t": "00:18",
      "text": "ఓకే"
    },
    {
      "t": "00:20",
      "text": "అవును"
    },
    {
      "t": "00:22",
      "text": "ఏం చేస్తలేదు"
    },
    {
      "t": "00:24",
      "text": "వాష్కిరణం"
    },
    {
      "t": "00:26",
      "text": "అంటే వేరేకి తాడేది చదువుతాను"
    },
    {
      "t": "00:28",
      "text": "నేను వీడియోస్"
    },
    {
      "t": "00:30",
      "text": "మోడల్ చూస్తున్నారు"
    },
    {
      "t": "00:32",
      "text": "గచ్చ రత్నాలు"
    },
    {
      "t": "00:34",
      "text": "నీ వాయిస్ నాకు వినిపించడం లేదు"
    },
    {
      "t": "00:36",
      "text": "ఇంకొకటి ఇప్పుడు"
    },
    {
      "t": "00:38",
      "text": "ఆ"
    },
    {
      "t": "00:40",
      "text": "వాసనకి"
    },
    {
      "t": "00:42",
      "text": "ఇప్పుడు ఎట్లా తల్లి"
    },
    {
      "t": "00:44",
      "text": "నీ వయసు నాకు వినిపించలేదు టెన్"
    },
    {
      "t": "00:46",
      "text": "నండ్రి"
    },
    {
      "t": "00:48",
      "text": "ఇప్పుడు"
    },
    {
      "t": "00:50",
      "text": "అనిపిస్తుందా"
    },
    {
      "t": "00:52",
      "text": "ఇప్పుడు వినిపిస్తుంది సూపర్ వినిపిస్తుంది"
    },
    {
      "t": "00:54",
      "text": "ఏం చేస్తామంటే బిడ్డకి"
    },
    {
      "t": "00:56",
      "text": "చదువుతున్నావా"
    },
    {
      "t": "00:58",
      "text": "బీటెక్ చదువుతున్నాను కాసేపు"
    },
    {
      "t": "01:00",
      "text": "సాంప్రదాయక వృత్తంలో మాట్లాడదామని వచ్చి"
    },
    {
      "t": "01:02",
      "text": "అచ్చన"
    },
    {
      "t": "01:04",
      "text": "అండ్ లివింగ్ టు అండ్ సమ్"
    },
    {
      "t": "01:06",
      "text": "అందరూ ఉంటారు కదా వర్క్ ఫ్రెండ్స్ ఉంటారు కదా"
    },
    {
      "t": "01:08",
      "text": "లేరు హాస్టల్లో"
    },
    {
      "t": "01:10",
      "text": "ఉన్నాను కదా వాళ్ళు ఇప్పుడు వస్తారు"
    },
    {
      "t": "01:12",
      "text": "ఆ"
    },
    {
      "t": "01:14",
      "text": "ఒక్కదాన్నే ఉన్నాను కదా హాష్"
    },
    {
      "t": "01:16",
      "text": "అందుకని అనవసరంగా"
    },
    {
      "t": "01:18",
      "text": "స్థిరంగా ఉన్నాను కాలేజీకి వెళ్ళిపోయిన పోయాను"
    },
    {
      "t": "01:20",
      "text": "అనిపించింది నిద్ర"
    },
    {
      "t": "01:22",
      "text": "పట్టదు అటు ఇటు తిరిగాను"
    },
    {
      "t": "01:24",
      "text": "నిద్ర పట్టలేదు ఏవేవో"
    },
    {
      "t": "01:26",
      "text": "ఆలోచనలు సార్"
    },
    {
      "t": "01:28",
      "text": "అట్లే ఇన్స్టాగ్రామ్ చూసి"
    },
    {
      "t": "01:30",
      "text": "చూద్దాంలే అనుకోని చూస్తుంటే"
    },
    {
      "t": "01:32",
      "text": "తప్పు వచ్చింది వెంటనే ఇంకా"
    },
    {
      "t": "01:34",
      "text": "మాట్లాడాను ఆఫ్టర్నూన్ నుంచి"
    },
    {
      "t": "01:36",
      "text": "గేట్ లోనే కాల్స్"
    },
    {
      "t": "01:38",
      "text": "అందరికి"
    },
    {
      "t": "01:40",
      "text": "ఆన్లైన్ వాళ్ళ అక్బర్ కుర్రోళ్ళు వాళ్ళు"
    },
    {
      "t": "01:42",
      "text": "తొందరగా వెళ్ళినందుకు"
    },
    {
      "t": "01:44",
      "text": "అదే"
    },
    {
      "t": "01:46",
      "text": "అదే కొత్తగా"
    },
    {
      "t": "01:48",
      "text": "ఏం"
    },
    {
      "t": "01:50",
      "text": "వాళ్ళకేం బాగా వెళ్ళాలి"
    },
    {
      "t": "01:52",
      "text": "ఉంటారు కదా"
    },
    {
      "t": "01:54",
      "text": "కావాలనిపిస్తుంది కదా"
    },
    {
      "t": "01:56",
      "text": "అదే ఈక్వల్ కుర్రగా"
    },
    {
      "t": "01:58",
      "text": "అదే కొంచెం పెద్దవాళ్ళు ఉన్నారు కనుక ఈక్వల్ టు"
    },
    {
      "t": "02:00",
      "text": "చాలా ఫ్రీగా మాట్లాడొచ్చు వీళ్ళు ఏంటో నాకు"
    },
    {
      "t": "02:02",
      "text": "ఏజ్ ఎక్కువైపోయినట్టుగా"
    },
    {
      "t": "02:04",
      "text": "అనే అనే ఫీలింగ్ వచ్చేస్తుంది"
    },
    {
      "t": "02:06",
      "text": "ఇంకా కట్టేస్తున్నాను"
    },
    {
      "t": "02:08",
      "text": "అండ్"
    },
    {
      "t": "02:10",
      "text": "ఏం అడుగుతున్నావు భాష"
    },
    {
      "t": "02:12",
      "text": "చదువుకో ఎందుకు వచ్చి యాప్లో అంటున్నారు"
    },
    {
      "t": "02:14",
      "text": "అంతే కదా మరి నిజంగానే ఎందుకు వచ్చింది"
    },
    {
      "t": "02:16",
      "text": "వచ్చే చదువుకున్న ఫ్రెండ్ లేడా"
    },
    {
      "t": "02:18",
      "text": "బాయ్ ఫ్రెండ్ ఒకప్పుడు"
    },
    {
      "t": "02:20",
      "text": "పిల్లవాడు పిల్లాడు"
    },
    {
      "t": "02:22",
      "text": "అప్పుడప్పుడే దెబ్బ అయిపోయిందా"
    },
    {
      "t": "02:24",
      "text": "అవును"
    },
    {
      "t": "02:26",
      "text": "అంటే నా నా"
    },
    {
      "t": "02:28",
      "text": "సూపర్ జూనియర్ నేను ఫస్ట్ ఇయర్లో తన"
    },
    {
      "t": "02:30",
      "text": "ఫోర్ జీరో ఇంకా"
    },
    {
      "t": "02:32",
      "text": "ప్రపోజ్ చేశాడు"
    },
    {
      "t": "02:34",
      "text": "నేనేమో చాలా రోజులు"
    },
    {
      "t": "02:36",
      "text": "ఎస్ అని చెప్పలా ఎస్ అని చెప్పాను"
    },
    {
      "t": "02:38",
      "text": "ఆ తర్వాత ఇంకా బాగా"
    },
    {
      "t": "02:40",
      "text": "బాగా ఎంజాయ్ చేసావులే"
    },
    {
      "t": "02:42",
      "text": "నాడు ఒక పెద్ద సైకో గడుపు"
    },
    {
      "t": "02:44",
      "text": "అప్పుడు ఎలా ఉంటాడో వాడికి తెలియదు జాబ్ వచ్చాక"
    },
    {
      "t": "02:46",
      "text": "మరీ ఎక్కువైపోయింది వాడు సైకోతను"
    },
    {
      "t": "02:48",
      "text": "పాస్ అవుతాడు కంపల్సరీ"
    },
    {
      "t": "02:50",
      "text": "బస్సులోనే వచ్చింది బెంగళూరులో ఉంటుంది"
    },
    {
      "t": "02:52",
      "text": "ఉంటాడు అప్పుడు"
    },
    {
      "t": "02:54",
      "text": "ఇంక కొట్టేస్తున్నాడు కొట్టేసి"
    },
    {
      "t": "02:56",
      "text": "చేయడానికి కూడా వచ్చేస్తున్నాడన్న భయమేసి"
    },
    {
      "t": "02:58",
      "text": "ఇంకా నేను వాళ్ళ మమ్మీకి చెప్పాను"
    },
    {
      "t": "03:00",
      "text": "చెప్పాను ఎలా ఎలా నాకు వద్దు"
    },
    {
      "t": "03:02",
      "text": "మా డాడీ ఒప్పుకోరు మీ క్యాస్ట్ వేరు"
    },
    {
      "t": "03:04",
      "text": "మా కాస్ట్ పేరు"
    },
    {
      "t": "03:06",
      "text": "చెప్తే అవునా"
    },
    {
      "t": "03:08",
      "text": "అలా ఏమి ఉండదులమ్మా"
    },
    {
      "t": "03:10",
      "text": "క్యాష్ టీమ్ ఉంది బాగుంటాను"
    },
    {
      "t": "03:12",
      "text": "నువ్వు ఉండమ్మా బాగుంటావు అంటున్నా"
    },
    {
      "t": "03:14",
      "text": "వద్దండి బాగా కొడతారా"
    },
    {
      "t": "03:16",
      "text": "నన్ను అని చెప్పాను అంతే"
    },
    {
      "t": "03:18",
      "text": "మరొక నువ్వు ఆయన"
    },
    {
      "t": "03:20",
      "text": "పెన్ డ్రైవ్స్ అంతా చేస్తావు"
    },
    {
      "t": "03:22",
      "text": "రేపు ఇంకొకరిని చేసుకుని"
    },
    {
      "t": "03:24",
      "text": "ఉండగలుగుతావా"
    },
    {
      "t": "03:26",
      "text": "ఉండగలుగుతాను ఎందుకంటే"
    },
    {
      "t": "03:28",
      "text": "ఎందుకంటే వాడు చేసింది సెక్స్ వాడే"
    },
    {
      "t": "03:30",
      "text": "హ్యాపీగా ఫీల్ అయ్యాడు నేనేమి హ్యాపీగా ఫీల్ అయ్యాను"
    },
    {
      "t": "03:32",
      "text": "పే ఫెయిల్ అవ్వలేదు"
    },
    {
      "t": "03:34",
      "text": "ఓకే"
    },
    {
      "t": "03:36",
      "text": "వద్దు"
    },
    {
      "t": "03:38",
      "text": "కొరికేయడాలు గిచ్చేయడాలు"
    },
    {
      "t": "03:40",
      "text": "ఇవన్నీ సైకో"
    },
    {
      "t": "03:42",
      "text": "ఎక్కువగా గడిచేసాయి"
    },
    {
      "t": "03:44",
      "text": "వాడడానికి ఏంది చూడండి"
    },
    {
      "t": "03:46",
      "text": "వస్తున్నాను అసలు నేను చూడకుండానే చూసేసాను అండి"
    },
    {
      "t": "03:48",
      "text": "అంటాడు ఎందుకు వెళ్ళావు నేను"
    },
    {
      "t": "03:50",
      "text": "నేను హాస్టల్లో ఉంటాను బయటికి వెళ్ళిన తర్వాత"
    },
    {
      "t": "03:52",
      "text": "తెచ్చుకోవాలి కదా నాకు"
    },
    {
      "t": "03:54",
      "text": "సోప్స్ అన్న తెచ్చు"
    },
    {
      "t": "03:56",
      "text": "ఎవరు తెస్తారు నాకు"
    },
    {
      "t": "03:58",
      "text": "ఎందుకు వస్తాడు బయటకు అంటాడా"
    },
    {
      "t": "04:00",
      "text": "సార్లు చూస్తాడు ఇన్స్టాగ్రామ్ అవన్నీ"
    },
    {
      "t": "04:02",
      "text": "చెక్ ఇన్ చేయడంలో నాకు చాలా కోపం"
    },
    {
      "t": "04:04",
      "text": "వస్తుంది అందుకని"
    },
    {
      "t": "04:06",
      "text": "ఇచ్చలేదు మరి తర్వాత"
    },
    {
      "t": "04:08",
      "text": "ఇంకెవరితోనూ రిలేషన్ పెట్టుకోలేదు"
    },
    {
      "t": "04:10",
      "text": "అస్సలు పెట్టుకోలేదు"
    },
    {
      "t": "04:12",
      "text": "నెక్స్ట్ ఏంటి మరి"
    },
    {
      "t": "04:14",
      "text": "నెక్స్ట్"
    },
    {
      "t": "04:16",
      "text": "మంచిగా జాబ్ సంపాదించి ఒకటి"
    },
    {
      "t": "04:18",
      "text": "టూ ఇయర్స్ చేసేసి ఇక తర్వాత"
    },
    {
      "t": "04:20",
      "text": "మా అమ్మ నాన్న చెప్పేవాడిని పెళ్ళి చేసుకొని"
    },
    {
      "t": "04:22",
      "text": "ఉన్నాడమ్మా"
    },
    {
      "t": "04:24",
      "text": "మనం ఇప్పుడు ఎక్స్ ఎక్స్ ఎంజే చేసాం"
    },
    {
      "t": "04:26",
      "text": "సరే కదా ఇప్పుడు నీకు ఏం కోరికలు రావట్లేదు"
    },
    {
      "t": "04:28",
      "text": "మళ్ళీ చేసుకోవాలి"
    },
    {
      "t": "04:30",
      "text": "వస్తాను అందుకే గ్యాప్లో వచ్చి"
    },
    {
      "t": "04:32",
      "text": "వచ్చింది"
    },
    {
      "t": "04:34",
      "text": "ఆ ఆప్లో కూడా"
    },
    {
      "t": "04:36",
      "text": "వాడు నా కెరీర్"
    },
    {
      "t": "04:38",
      "text": "లేకపోతే నాకు అప్పుడప్పుడు సెక్స్"
    },
    {
      "t": "04:40",
      "text": "చేయాలి అట్లా అంతకుముందు ఏం లేదు"
    },
    {
      "t": "04:42",
      "text": "సక్సెస్ చేయాలని ఇంట్రెస్ట్ అవుతున్న మాటలు"
    },
    {
      "t": "04:44",
      "text": "పడితే బాగుంటుందని ఇంకొస్తున్నాను"
    },
    {
      "t": "04:46",
      "text": "అవును"
    },
    {
      "t": "04:48",
      "text": "మాములుగా అందరికి"
    },
    {
      "t": "04:50",
      "text": "రిలేషన్ ఉన్నవాళ్ళు ఎవరికైనా వస్తుంది కదా"
    },
    {
      "t": "04:52",
      "text": "వస్తువులు"
    },
    {
      "t": "04:54",
      "text": "ఏం చేస్తాం అదే"
    },
    {
      "t": "04:56",
      "text": "హార్మోన్స్ ప్రాబ్లమ్"
    },
    {
      "t": "04:58",
      "text": "మరొక ప్రశ్న ఏంటి"
    },
    {
      "t": "05:00",
      "text": "ఎంత"
    },
    {
      "t": "05:02",
      "text": "ఏం చేస్తున్నాను దుండం పెట్టి"
    },
    {
      "t": "05:04",
      "text": "పెట్టుకుని పడుకుంటా లేకపోతే"
    },
    {
      "t": "05:06",
      "text": "ఫింగరింగ్ చేసుకుంటాను"
    },
    {
      "t": "05:08",
      "text": "మరి ఎవరినైనా పెట్టు"
    },
    {
      "t": "05:10",
      "text": "గుర్తుకు వద్దు సార్"
    },
    {
      "t": "05:12",
      "text": "ఎందుకు అమ్మ ఇప్పటికే పడ్డాడు"
    },
    {
      "t": "05:14",
      "text": "నష్టాలు చాలు అస్సలు"
    },
    {
      "t": "05:16",
      "text": "అక్కడ పెట్టుకోండి బాబోయ్"
    },
    {
      "t": "05:18",
      "text": "ఏముంది మాలాంటి వాళ్ళు అంకుల్ని పెట్టుకుంటే ఏ గొడవ ఉండదు"
    },
    {
      "t": "05:20",
      "text": "కదా ఎప్పుడోసారి వచ్చారు మీరు అంకుల్"
    },
    {
      "t": "05:22",
      "text": "లేదా"
    },
    {
      "t": "05:24",
      "text": "థర్టీ ఫైవ్ ఐ"
    },
    {
      "t": "05:26",
      "text": "ఏరియా"
    },
    {
      "t": "05:28",
      "text": "అచ్చా అచ్చా"
    },
    {
      "t": "05:30",
      "text": "అంతా"
    },
    {
      "t": "05:32",
      "text": "వద్దు"
    },
    {
      "t": "05:34",
      "text": "థర్టీ ఫైవ్ కెన్ యూ వాయిస్"
    },
    {
      "t": "05:36",
      "text": "మసాలా లేదబ్బా అంకుల్లా లేదు"
    },
    {
      "t": "05:38",
      "text": "మనిషిని కూడా అలా ఉండాలి"
    },
    {
      "t": "05:40",
      "text": "అవునా"
    },
    {
      "t": "05:42",
      "text": "సరే"
    },
    {
      "t": "05:44",
      "text": "అస్సలు లేదు"
    },
    {
      "t": "05:46",
      "text": "వాయిస్ ఎలా ఉందంటే"
    },
    {
      "t": "05:48",
      "text": "ఇప్పుడు మీ వాయిస్ ఎలా"
    },
    {
      "t": "05:50",
      "text": "ఎలా ఉందంటే ట్వంటీ సిక్స్"
    },
    {
      "t": "05:52",
      "text": "టూ ట్వంటీ సెవెనా"
    },
    {
      "t": "05:54",
      "text": "అలాగే"
    },
    {
      "t": "05:56",
      "text": "అస్సలు అలా లేదు ఇప్పుడు ట్వంటీ సిక్స్"
    },
    {
      "t": "05:58",
      "text": "నెక్స్ట్ అంటే ఎయిర్టెల్తో పెట్టుకున్నాను అనుకో మళ్ళీ రన్ చేస్తాను"
    },
    {
      "t": "06:00",
      "text": "చేయాలనిపిస్తుంది ఇదైతే షార్ట్ అండ్ టెంపరీగా"
    },
    {
      "t": "06:02",
      "text": "కదా"
    },
    {
      "t": "06:04",
      "text": "కానీ తను నన్నే మొదలు"
    },
    {
      "t": "06:06",
      "text": "లేదు"
    },
    {
      "t": "06:08",
      "text": "వదల్లేదు నేను"
    },
    {
      "t": "06:10",
      "text": "వదిలేసాను ఫోన్ చేస్తున్నాడు"
    },
    {
      "t": "06:12",
      "text": "బ్లాక్ లిస్ట్లో పెట్టేశారు"
    },
    {
      "t": "06:14",
      "text": "వెరీ నైస్"
    },
    {
      "t": "06:16",
      "text": "రాలేదు నేను మళ్ళీ కమిట్ అవ్వను"
    },
    {
      "t": "06:18",
      "text": "ఇంకా వాడుతూ చచ్చిన కమిట్మెంట్"
    },
    {
      "t": "06:20",
      "text": "రఘునాథ్"
    },
    {
      "t": "06:22",
      "text": "ఎంత కమిట్ అయినా మాలాంటి వాళ్ళతో కమిట్ అయినా ఏదో"
    },
    {
      "t": "06:24",
      "text": "స్వీటర్"
    },
    {
      "t": "06:26",
      "text": "షార్ట్ లాగా వదిలేసుకోవాలి అంతే ఎందుకంటే"
    },
    {
      "t": "06:28",
      "text": "కాంగ్రెస్"
    },
    {
      "t": "06:30",
      "text": "ఆ"
    },
    {
      "t": "06:32",
      "text": "మీకు మ్యారేజ్ అయిపోతుంది"
    },
    {
      "t": "06:34",
      "text": "అయిపోయిందా అయిపోయింది"
    },
    {
      "t": "06:36",
      "text": "మరి"
    },
    {
      "t": "06:38",
      "text": "మీ వైఫ్ ఉన్నారా"
    },
    {
      "t": "06:40",
      "text": "ఉమెన్ బయట ఉన్నాం"
    },
    {
      "t": "06:42",
      "text": "ఓకే పిల్లలు"
    },
    {
      "t": "06:44",
      "text": "ఒక బాబు"
    },
    {
      "t": "06:46",
      "text": "ఓకే"
    },
    {
      "t": "06:48",
      "text": "ఏం చేస్తుంటారు మీరు"
    },
    {
      "t": "06:50",
      "text": "డ్రాప్ చేస్తాను ప్రపంచం"
    },
    {
      "t": "06:52",
      "text": "ఓకే"
    },
    {
      "t": "06:54",
      "text": "మీ దగ్గర"
    },
    {
      "t": "06:56",
      "text": "విజయవాడ అనంతబాబు"
    },
    {
      "t": "06:58",
      "text": "అది అమలాపురం అండి ప్రాపర్"
    },
    {
      "t": "07:00",
      "text": "అమలాపురం దగ్గర ఎక్కడ"
    },
    {
      "t": "07:02",
      "text": "ఉన్న పర్వాలేదు తెలుస్తున్నారు"
    },
    {
      "t": "07:04",
      "text": "అవును కొలత"
    },
    {
      "t": "07:06",
      "text": "కొత్తపల్లి అండి"
    },
    {
      "t": "07:08",
      "text": "పక్కన"
    },
    {
      "t": "07:10",
      "text": "ఓకే"
    },
    {
      "t": "07:12",
      "text": "అదే"
    },
    {
      "t": "07:14",
      "text": "స్టడీస్ పర్సన్ జాబ్"
    },
    {
      "t": "07:16",
      "text": "ఎస్"
    },
    {
      "t": "07:18",
      "text": "స్టడీ కూడా ఉంది"
    },
    {
      "t": "07:20",
      "text": "దేవుడు వచ్చి కొవ్వెక్కిన పని"
    },
    {
      "t": "07:22",
      "text": "సరే సార్"
    },
    {
      "t": "07:24",
      "text": "చేయాలి ఏజ్లో చేయాల్సిన ఏజ్లో"
    },
    {
      "t": "07:26",
      "text": "సార్"
    },
    {
      "t": "07:28",
      "text": "ఇంత చేయకపోతే ఇప్పుడు అప్పుడు ఇప్పుడు చేయకపోతే అప్పుడు"
    },
    {
      "t": "07:30",
      "text": "చేస్తాం ఇది తప్పే"
    },
    {
      "t": "07:32",
      "text": "అదే కదా ఆ తర్వాత మనం"
    },
    {
      "t": "07:34",
      "text": "చేయలేదు"
    },
    {
      "t": "07:36",
      "text": "ఎంజాయ్ చేస్తాడు వాడు పెళ్ళి చేసుకుంటాడు"
    },
    {
      "t": "07:38",
      "text": "అంతే నువ్వు పెళ్ళి చేసుకుంటావు"
    },
    {
      "t": "07:40",
      "text": "ఎవరినో పెళ్లి చేసుకున్నాడు కూడా ఇంతకుముందు చెప్పారు"
    },
    {
      "t": "07:42",
      "text": "ఉండొచ్చు కదా ఈ రోజుల్లో ఎఫ్ఐఆర్ లేనిదే ఎవరున్నారు"
    },
    {
      "t": "07:44",
      "text": "అందరికి ఉంది"
    },
    {
      "t": "07:46",
      "text": "అందుకని చంగ మా కాలేజ్లో అందరూ"
    },
    {
      "t": "07:48",
      "text": "కొండే అసలు"
    },
    {
      "t": "07:50",
      "text": "ఇంకా మందికి కదా మళ్ళీ"
    },
    {
      "t": "07:52",
      "text": "మళ్ళీ ఇంకో విషయం చెప్తాం హెచ్ఓడి"
    },
    {
      "t": "07:54",
      "text": "మా సార్స్ కూడా ఎఫ్ఐఆర్ ఉంది"
    },
    {
      "t": "07:56",
      "text": "ఆ"
    },
    {
      "t": "07:58",
      "text": "హెచ్ఓడి ఉంటాడు కదా"
    },
    {
      "t": "08:00",
      "text": "మా మ్యాడమ్స్తో కూడా ఎఫర్ట్ పెట్టాను"
    },
    {
      "t": "08:02",
      "text": "పెట్టుకుంటాడు హెచ్ వన్ బాగుంటాడు"
    },
    {
      "t": "08:04",
      "text": "ఇందులో ఒక మన తెలుగులో ఒక"
    },
    {
      "t": "08:06",
      "text": "అప్లై అయిపోయింది"
    },
    {
      "t": "08:08",
      "text": "ఆ"
    },
    {
      "t": "08:10",
      "text": "ఇంకా"
    },
    {
      "t": "08:12",
      "text": "ఇంకా మరి"
    },
    {
      "t": "08:14",
      "text": "ఎంత అన్నా"
    },
    {
      "t": "08:16",
      "text": "నిత్య"
    },
    {
      "t": "08:18",
      "text": "సృజిని"
    },
    {
      "t": "08:20",
      "text": "కూర్చోండి"
    },
    {
      "t": "08:22",
      "text": "ఆ"
    },
    {
      "t": "08:24",
      "text": "ఇంకా"
    },
    {
      "t": "08:26",
      "text": "చెప్పండి మీరు హైదరాబాద్"
    },
    {
      "t": "08:28",
      "text": "వస్తుంటావు మరి"
    },
    {
      "t": "08:30",
      "text": "చాలా సార్లు మా రిలేషన్స్"
    },
    {
      "t": "08:32",
      "text": "అన్నారు అక్కడ"
    },
    {
      "t": "08:34",
      "text": "ఎక్కడ హైటెక్ హైటెక్ సిటీ"
    },
    {
      "t": "08:36",
      "text": "ఇట్ ఈజ్ ద"
    },
    {
      "t": "08:38",
      "text": "కూకట్పల్లిలో కూడా ఉన్నారు"
    },
    {
      "t": "08:40",
      "text": "ఆ"
    },
    {
      "t": "08:42",
      "text": "వస్తూ ఉంటాం"
    },
    {
      "t": "08:44",
      "text": "ఓకే"
    },
    {
      "t": "08:46",
      "text": "అంటే"
    },
    {
      "t": "08:48",
      "text": "చెప్పారు"
    },
    {
      "t": "08:50",
      "text": "అప్"
    },
    {
      "t": "08:52",
      "text": "ఇది ప్రాపర్ హెటాక్ అదేనా"
    },
    {
      "t": "08:54",
      "text": "కార్ విజయవాడ"
    },
    {
      "t": "08:56",
      "text": "వీళ్ళు"
    },
    {
      "t": "08:58",
      "text": "శివాలయాలు ఉన్నాయి"
    },
    {
      "t": "09:00",
      "text": "ఎక్కడైనా వెళ్ళి"
    },
    {
      "t": "09:02",
      "text": "ఓకే సార్"
    },
    {
      "t": "09:04",
      "text": "అంటే నేను అమలాపురం"
    },
    {
      "t": "09:06",
      "text": "ఏడు రెండు బస్టు"
    },
    {
      "t": "09:08",
      "text": "ఉంటాయి కొత్త పోస్ట్"
    },
    {
      "t": "09:10",
      "text": "అంటారు పాదపృష్ఠాలలో"
    },
    {
      "t": "09:12",
      "text": "రాఘవాంక గారు ముప్పై తొమ్మిది స్టాండర్డ్స్"
    },
    {
      "t": "09:14",
      "text": "ఆ"
    },
    {
      "t": "09:16",
      "text": "మా ఫ్రెండ్ది ఏలూరే అది"
    },
    {
      "t": "09:18",
      "text": "అదేంటి ఆర్ఆర్ పేట అంట"
    },
    {
      "t": "09:20",
      "text": "తనని ఒకసారి తన ఇంటికి తీసుకెళ్ళి"
    },
    {
      "t": "09:22",
      "text": "అందుకనే ఎల్లో రెక్టార్ అంటున్నాను"
    },
    {
      "t": "09:24",
      "text": "అదే అక్కడ ఎయిర్పోర్ట్"
    },
    {
      "t": "09:26",
      "text": "అదే"
    },
    {
      "t": "09:28",
      "text": "అదే చూశాను ఏలూరు కొంచెం"
    },
    {
      "t": "09:30",
      "text": "అంతా పాటు వెళ్ళి చూశాను"
    },
    {
      "t": "09:32",
      "text": "అండ్"
    },
    {
      "t": "09:34",
      "text": "ఇంకా"
    },
    {
      "t": "09:36",
      "text": "ఓకే"
    },
    {
      "t": "09:38",
      "text": "చెప్పాను మీరే"
    },
    {
      "t": "09:40",
      "text": "అవును గుడ్ నైట్"
    },
    {
      "t": "09:42",
      "text": "ఓకే"
    },
    {
      "t": "09:44",
      "text": "ఓకే"
    },
    {
      "t": "09:46",
      "text": "ఫ్యామిలీ మీతోనే ఉంటుందా ఎవరెవరు ఉంటారా"
    },
    {
      "t": "09:48",
      "text": "ఫ్యామిలీ నాతోనే ఉంటాడు"
    },
    {
      "t": "09:50",
      "text": "ఓకే"
    },
    {
      "t": "09:52",
      "text": "ఓకే"
    },
    {
      "t": "09:54",
      "text": "యూజ్ చేస్తారు అయితే"
    },
    {
      "t": "09:56",
      "text": "అంతే చేస్తాం"
    },
    {
      "t": "09:58",
      "text": "ఆ"
    },
    {
      "t": "10:00",
      "text": "ఎలా ఉందండి మీరు"
    },
    {
      "t": "10:02",
      "text": "వైరస్ లైఫ్ బాగుందా"
    },
    {
      "t": "10:04",
      "text": "అంత బాగుంది"
    },
    {
      "t": "10:06",
      "text": "నేను వైఫై ఏం చేస్తాను"
    },
    {
      "t": "10:08",
      "text": "ఓకే"
    },
    {
      "t": "10:10",
      "text": "ఓకే"
    },
    {
      "t": "10:12",
      "text": "రెంట్ రెంట్ హౌస్"
    },
    {
      "t": "10:14",
      "text": "సేనా అక్కడ"
    },
    {
      "t": "10:16",
      "text": "రెంటెడ్"
    },
    {
      "t": "10:18",
      "text": "అరౌండ్"
    },
    {
      "t": "10:20",
      "text": "చూసుకొనేసుకోండి అని చెప్పారు"
    },
    {
      "t": "10:22",
      "text": "చూద్దాం"
    },
    {
      "t": "10:24",
      "text": "మీరు ఎక్కడో"
    },
    {
      "t": "10:26",
      "text": "ఉంటారు ఎల్బీ నగర్"
    },
    {
      "t": "10:28",
      "text": "ఓకే"
    },
    {
      "t": "10:30",
      "text": "ఓకే"
    },
    {
      "t": "10:32",
      "text": "ఆ"
    },
    {
      "t": "10:34",
      "text": "ఇంకేంటంటే"
    },
    {
      "t": "10:36",
      "text": "చెప్పాలని లేదు"
    },
    {
      "t": "10:38",
      "text": "మీరే చెప్పాలి మరి ఇంకా"
    },
    {
      "t": "10:40",
      "text": "ఓకే"
    },
    {
      "t": "10:42",
      "text": "ఓకే"
    },
    {
      "t": "10:44",
      "text": "ఎంజాయ్ చేస్తున్నాడు అయితే"
    },
    {
      "t": "10:46",
      "text": "ఎంజాయ్ చేయలేదండి"
    },
    {
      "t": "10:48",
      "text": "అంతా అండి"
    },
    {
      "t": "10:50",
      "text": "అంత ఏం లేదు"
    },
    {
      "t": "10:52",
      "text": "బాయ్"
    },
    {
      "t": "10:54",
      "text": "బ్యాడ్ డేస్"
    },
    {
      "t": "10:56",
      "text": "భారతదేశం"
    },
    {
      "t": "10:58",
      "text": "ఇప్పుడు వచ్చే ఒక"
    },
    {
      "t": "11:00",
      "text": "ట్వంటీ డేస్ నుంచి గుడ్ డేస్"
    },
    {
      "t": "11:02",
      "text": "ఏ"
    },
    {
      "t": "11:04",
      "text": "అంటే నేను కాలేజీకి వచ్చిన"
    },
    {
      "t": "11:06",
      "text": "ఫస్ట్ మంత్ నుంచి వాడు నాకు"
    },
    {
      "t": "11:08",
      "text": "నా లైఫ్లోకి వచ్చాడు"
    },
    {
      "t": "11:10",
      "text": "తర్వాత ఇప్పుడే కొంచెం రిలీఫ్"
    },
    {
      "t": "11:12",
      "text": "అయ్యింది ప్రశాంతంగా ఉంది"
    },
    {
      "t": "11:14",
      "text": "ఆహా"
    },
    {
      "t": "11:16",
      "text": "ఓకే"
    },
    {
      "t": "11:18",
      "text": "ఈ"
    },
    {
      "t": "11:20",
      "text": "బాగానే ఉంది అయితే"
    },
    {
      "t": "11:22",
      "text": "అవును"
    },
    {
      "t": "11:24",
      "text": "అందరూ ఒకలాగా ఉండరులెండి మెంటల్గా"
    },
    {
      "t": "11:26",
      "text": "బట్టి ఉంటారు ఇప్పుడు మీరు ఉన్న"
    },
    {
      "t": "11:28",
      "text": "ఎలా ఉన్నారు అలా ఉంటారు"
    },
    {
      "t": "11:30",
      "text": "అదే కొంచెం మెంటల్గా ఉందా"
    },
    {
      "t": "11:32",
      "text": "ఉన్నవాళ్ళు అదిగో వాడిలాగా ఉంటాయి"
    },
    {
      "t": "11:34",
      "text": "ఆ"
    },
    {
      "t": "11:36",
      "text": "ఎప్పుడు ఎలా ఉంటారో ఎవరికి తెలియదు"
    },
    {
      "t": "11:38",
      "text": "అంతే కదా"
    },
    {
      "t": "11:40",
      "text": "ఆ"
    },
    {
      "t": "11:42",
      "text": "ఓకే"
    },
    {
      "t": "11:44",
      "text": "అదే"
    },
    {
      "t": "11:46",
      "text": "మా వాడు అంతకుముందే నన్ను"
    },
    {
      "t": "11:48",
      "text": "ఎవరు కాదమ్మా ఎందుకు ఇలా అవుతారు"
    },
    {
      "t": "11:50",
      "text": "చాలా మంది చూడడం బాగుంటుంది"
    },
    {
      "t": "11:52",
      "text": "ఆడికి ఇంకొకళ్ళు ఎవరైనా కలిసారా"
    },
    {
      "t": "11:54",
      "text": "ఉంటాం"
    },
    {
      "t": "11:56",
      "text": "సరే సరే"
    },
    {
      "t": "11:58",
      "text": "కలిస్తే అప్పుడు దాన్ని ఫ్రీ"
    },
    {
      "t": "12:00",
      "text": "ఫ్రీగా వదలాలి కదా ఇంకా బాగా టైం"
    },
    {
      "t": "12:02",
      "text": "బయట చేసేసాడు"
    },
    {
      "t": "12:04",
      "text": "ఊహించుకోవడానికే టైప్ చేసేయండి"
    },
    {
      "t": "12:06",
      "text": "ఓ"
    },
    {
      "t": "12:08",
      "text": "వదులుచుకోవడానికి టైట్ చేశాడు కదా"
    },
    {
      "t": "12:10",
      "text": "ఆటోమేటిక్గానే వదిలిపెడతారు"
    },
    {
      "t": "12:12",
      "text": "అవును మంచిదే కదా"
    },
    {
      "t": "12:14",
      "text": "మరి ఇప్పుడు ఎందుకండి కాల్ చేస్తున్నాం ఫ్రెండ్స్"
    },
    {
      "t": "12:16",
      "text": "చేస్తాడు నాకు చేస్తాడు"
    },
    {
      "t": "12:18",
      "text": "ఇంకేమంటారు కదా"
    },
    {
      "t": "12:20",
      "text": "సిక్స్"
    },
    {
      "t": "12:22",
      "text": "బాగా నచ్చాడు ఆయన"
    },
    {
      "t": "12:24",
      "text": "ఓకే"
    },
    {
      "t": "12:26",
      "text": "ఇంకా"
    },
    {
      "t": "12:28",
      "text": "ఇంకా"
    },
    {
      "t": "12:30",
      "text": "చెప్పాలి కదా మరి"
    },
    {
      "t": "12:32",
      "text": "సూపర్"
    },
    {
      "t": "12:34",
      "text": "అవును"
    },
    {
      "t": "12:36",
      "text": "ఓకే"
    },
    {
      "t": "12:38",
      "text": "ఓకే"
    },
    {
      "t": "12:40",
      "text": "చెప్పాలి"
    },
    {
      "t": "12:42",
      "text": "చెప్పాలి మీరు ఏంటి"
    },
    {
      "t": "12:44",
      "text": "చెప్పండి"
    },
    {
      "t": "12:46",
      "text": "అదే"
    },
    {
      "t": "12:48",
      "text": "క్యాంపస్కి వచ్చినాం అయితే"
