    },
    {
      "t": "13:24",
      "text": "మేక్ సేఫ్ సెక్యూరిటీ"
    },
    {
      "t": "13:26",
      "text": "ట్యుటోరియల్ నేమ్ అండి"
    },
    {
      "t": "13:28",
      "text": "నీకు కూడా సేఫ్ కదా"
    },
    {
      "t": "13:30",
      "text": "సరే అండి"
    },
    {
      "t": "13:32",
      "text": "అదే అనుకుంటున్నా మంచిది"
    },
    {
      "t": "13:34",
      "text": "అవును"
    },
