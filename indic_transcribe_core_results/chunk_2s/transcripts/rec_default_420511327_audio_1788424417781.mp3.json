    },
    {
      "t": "00:06",
      "text": "ಆ ನನ್ನ"
    },
    {
      "t": "00:08",
      "text": "ತುಂಬಿಕೊಂಡು ನಿಮ್ದು"
    },
    {
      "t": "00:10",
      "text": "ಮತ್ತು"
    },
    {
      "t": "00:12",
      "text": "ಇಲ್ಲಿ"
    },
    {
      "t": "00:14",
      "text": "ತುಮ್ಕೂರು"
    },
    {
      "t": "00:16",
      "text": "ಹ್ಞೂ ಹ್ಞೂ ಹುಡುಗಿ"
    },
    {
      "t": "00:18",
      "text": "ಏನು ಮಾಡ್ತೀನಿ ಹೇಳುದಾ"
    },
    {
      "t": "00:20",
      "text": "ಟೋಟಲ್"
    },
    {
      "t": "00:22",
      "text": "ಏನು ಮಾಡ್ಕೊಂಡಿರೋದು"
    },
    {
      "t": "00:24",
      "text": "ನಾನು ಹೌಸ್ ವೈಫ್ ನೀವು"
    },
    {
      "t": "00:26",
      "text": "ಮದುವೆ ಆಗಿದೆಯಾ"
    },
    {
      "t": "00:28",
      "text": "ಎಸ್ ಮ್ಯಾರೇಡ್"
    },
    {
      "t": "00:30",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:32",
      "text": "ಏನು ಹಂಗ್ ನೋಡ್ತಿದ್ರಾ ನನಗೆ"
    },
    {
      "t": "00:34",
      "text": "ಇನ್ನು ದೆವ್ವ ಥರ ಕಾಣಿಸ್ತಿದಿನಾ"
    },
    {
      "t": "00:36",
      "text": "ಮದುವೆ ಆಗಿದೆಯಾ ಅಂತ ಹೇಳಿದ್ರಲ್ಲ ಅದು"
    },
    {
      "t": "00:38",
      "text": "ಹೌದು"
    },
    {
      "t": "00:40",
      "text": "ಹೌದಾ ಹ್ಞೂ"
    },
    {
      "t": "00:42",
      "text": "ಮದುವೆ ಆಗಿದೆ"
    },
    {
      "t": "00:44",
      "text": "ಮತ್ತೆ ಊಟ ಮಾಡಿದ್ರಾ"
    },
    {
      "t": "00:46",
      "text": "ಹ್ಞೂ ಹಾಗಿದ್ರೆ"
    },
    {
      "t": "00:48",
      "text": "ಹ್ಞೂ ಆಯ್ತು ಆಯ್ತು ಆಯ್ತು"
    },
    {
      "t": "00:50",
      "text": "ಮತ್ತು"
    },
    {
      "t": "00:52",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:54",
      "text": "ಏನೇನು ಸಮಾಚಾರ"
    },
    {
      "t": "00:56",
      "text": "ಹೇಳಿ ಕೇಳೋಣ ನಿಮ್ಮ ಮ್ಯಾರೇಜ್"
    },
    {
      "t": "00:58",
      "text": "ಏ ಇಲ್ಲ"
    },
    {
      "t": "01:00",
      "text": "ನನ್ಗೆ ಆ ಇಬ್ಬರು ಮಕ್ಕಳು"
    },
    {
      "t": "01:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "01:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:06",
      "text": "ಹ್ಞೂ ಓಕೆ"
    },
    {
      "t": "01:08",
      "text": "ಏನು ಮಾಡ್ತಾರೆ ಅವರು"
    },
    {
      "t": "01:10",
      "text": "ಮಗಳು ಸೆಕೆಂಡ್ ಸ್ಟ್ಯಾಂಡರ್ಡ್ ಮಗಳು"
    },
    {
      "t": "01:12",
      "text": "ಆಗ ಯು ಕೆ ಜಿ"
    },
    {
      "t": "01:14",
      "text": "ಬಸ್ಸು ಮಜಾ"
    },
    {
      "t": "01:16",
      "text": "ಪುಷ್ಪಗೈನ"
    },
    {
      "t": "01:18",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:20",
      "text": "ಸೆಕೆಂಡ್ ಸ್ಟ್ಯಾಂಡರ್ಡು ಯು ಕೆ ಜಿ ಎನ್"
    },
    {
      "t": "01:22",
      "text": "ಸಪೋಸ್ ಒಂದು ಐದು ಕೆಜಿ ಮಕ್ಕಳು"
    },
    {
      "t": "01:24",
      "text": "ಬಂದಿದೆ"
    },
    {
      "t": "01:26",
      "text": "ಎಷ್ಟೋ ಸರಿ ಗಾಡಿ ನಿಲ್ಲು"
    },
    {
      "t": "01:28",
      "text": "ಮ್ಯಾರೇಜ್ ಮ್ಯಾರೇಜ್ ಎಯ್ಟ್ ಇಯರ್ಸ್"
    },
    {
      "t": "01:30",
      "text": "ಆಯ್ತು ಮದುವೆ ಆಗಿ ಇವಾಗ ಎಷ್ಟು ವರ್ಷ ಆಯ್ತು"
    },
    {
      "t": "01:32",
      "text": "ಸರ್"
    },
    {
      "t": "01:34",
      "text": "ಯಾರಿಗೆ ನನ್ಗೆ"
    },
    {
      "t": "01:36",
      "text": "ಹಾಂ ಟ್ವೆಂಟಿ ಸಿಕ್ಸ್"
    },
    {
      "t": "01:38",
      "text": "ಅಷ್ಟೇ ನನ್ನ ಕಿನ್ನ ಸಣ್ಣವರಾ"
    },
    {
      "t": "01:40",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:42",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:44",
      "text": "ನಮಗೆ"
    },
    {
      "t": "01:46",
      "text": "ಇಪ್ಪತ್ತ"
    },
    {
      "t": "01:48",
      "text": "ಸ್ವಲ್ಪ ಸಮುದ್ರ"
    },
    {
      "t": "01:50",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:52",
      "text": "ಓಕೆ ಓಕೆ ಮತ್ತೆ"
    },
    {
      "t": "01:54",
      "text": "ಸಂತೋಷ ಇಟ್ಟು ಮುದ್ದೆ ಮಾಡ್ಕೊಂಡು ಬಿಟ್ಟಿದ್ದೀನಿ ಹಾಂ"
    },
    {
      "t": "01:56",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:58",
      "text": "ಹದಿನೇಳು"
    },
    {
      "t": "02:00",
      "text": "ಹೌದು"
    },
    {
      "t": "02:02",
      "text": "ದಾಖಲಿಸಬೇಕು"
    },
    {
      "t": "02:04",
      "text": "ಹೌದು"
    },
    {
      "t": "02:06",
      "text": "ಹೌದು"
    },
    {
      "t": "02:08",
      "text": "ಹ್ಞೂ ಹೇಳಿ"
    },
    {
      "t": "02:10",
      "text": "ಫಿಕ್ಸ್ ಮಾಡ್ಕೊಳ್ತೀವಿ"
    },
    {
      "t": "02:12",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:14",
      "text": "ಟೋಟಲ್"
    },
    {
      "t": "02:16",
      "text": "ಹಾಂ ಇನ್ನೇನು ಪ್ರಶ್ನೆ"
    },
    {
      "t": "02:18",
      "text": "ಸಮಾಚಾರ"
    },
    {
      "t": "02:20",
      "text": "ಹೇಳಬೇಕಲ್ಲ ನೀವೇ"
    },
    {
      "t": "02:22",
      "text": "ನೆಟ್ವರ್ಕ್ ಇರೋದು"
    },
    {
      "t": "02:24",
      "text": "ಓಯ್ತು ಮೈ ಡಾಕ್ಟರ್"
    },
    {
      "t": "02:26",
      "text": "ಹ್ಞೂ ಹೌದಾ"
    },
    {
      "t": "02:28",
      "text": "ಹೌದಾ"
    },
    {
      "t": "02:30",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:32",
      "text": "ಮತ್ತೆ ಎಷ್ಟು ದಿನ ಆಯಿತಾ ಪಿಕ್ ಮಾಡ್ಕೊಂಡು"
    },
    {
      "t": "02:34",
      "text": "ಓಕೆ"
    },
    {
      "t": "02:36",
      "text": "ಹೌದಾ"
    },
    {
      "t": "02:38",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:40",
      "text": "ಓಕೆ ಓಕೆ ಮತ್ತೆ"
    },
    {
      "t": "02:42",
      "text": "ಹೌದಾ ಅಪ್ಪು ಸರ್ ಬಿಟ್ಟಿದ್ದೀರಾ"
    },
    {
      "t": "02:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:46",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:48",
      "text": "ಏನ್ರೀ ನಿಮ್ಮೂರಲ್ಲಿ ಏನು ನಿಮ್ಮದು ಕಾಲೇಜ್ ಇತ್ತು ರೀ"
    },
    {
      "t": "02:50",
      "text": "ಅಡಿಕೆಟ್ ಅವ್ರಿಗೆ ತಗೊಂಡ್ರೆ ಅವ್ರಿಗೆ ಪ್ರಾಬ್ಲಮ್ ಜಾಸ್ತಿ"
    },
    {
      "t": "02:52",
      "text": "ಇರ"
    },
    {
      "t": "02:54",
      "text": "ಹೌದು"
    },
    {
      "t": "02:56",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:58",
      "text": "ನೆಟ್ವರ್ಕ್ ಬರ್ತಿದ್ವಲ್ಲ"
    },
    {
      "t": "03:00",
      "text": "ಹಾಂ ತುಂಬ ಕಟ್ಸ್ಕೊಡ್ಬೇಕು"
