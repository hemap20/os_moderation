    {
      "t": "03:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:04",
      "text": "ಓಕೆ"
    },
    {
      "t": "03:06",
      "text": "ಒಂದು ತಂಬು ಹಾಕ್ಬೇಕಿತ್ತು ಅಲ್ಲಿ"
    },
    {
      "t": "03:08",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:10",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:12",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:14",
      "text": "ಮಾಡ್ಕೋಬೇಕು ನೀವು ಹೇಳಿದ್ರೆ ಅಂತ"
    },
    {
      "t": "03:16",
      "text": "ಹ್ಞೂ ಹ್ಞೂ ಹ್ಞೂ ಮೊದಲೇ ಹೇಳಿದರೆ"
    },
    {
      "t": "03:18",
      "text": "ನಾಲ್ಕು ಕೊಟ್ಟಿದ್ದೆ ನಾನು"
    },
    {
      "t": "03:20",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:22",
      "text": "ಹಾಂ ಮೊದಲೇ ಹೇಳಿದ್ರೆ"
    },
    {
      "t": "03:24",
      "text": "ನಾನೇ ಕಂಪ್ ಹಾಕ್ತೀನಿ ಅಂದೆ"
    },
    {
      "t": "03:26",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:28",
      "text": "ಓಹ್ ಹೌದಾ ಏ"
    },
    {
      "t": "03:30",
      "text": "ಏನು ಕೆಲಸ ಮಾಡ್ತಾ ಇದ್ದೀರಾ ನೀವು ಹಾಕೊಂಡು ಕೊಡೋಣ"
    },
    {
      "t": "03:32",
      "text": "ಯಾಕೆ"
    },
    {
      "t": "03:34",
      "text": "ಹೇಳಕ್ಕೆ ಮ್ಯಾಮ್ ಆಯಿತು"
    },
    {
      "t": "03:36",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:38",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:40",
      "text": "ಏನೇನು ಸಮಾಚಾರಗಳು"
    },
    {
      "t": "03:42",
      "text": "ಓಕೆ"
    },
    {
      "t": "03:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:46",
      "text": "ಹೇಳಿ ಕೇಳೋಣ ನಿಮ್ದೇನು ಪ್ರೇಮ"
    },
    {
      "t": "03:48",
      "text": "ಸ್ಟಾರ್ಟರ್ ಕೊಟ್ಟಿದ್ದೀರಾ ಏನು ಕಾಣಿಸ್ತಿಲ್ಲ"
    },
    {
      "t": "03:50",
      "text": "ಅಷ್ಟೇ ನಮ್ಗೆ ಆಯುಷ್ಯ"
    },
    {
      "t": "03:52",
      "text": "ಎಸ್ಪೆಷಲಿ"
    },
    {
      "t": "03:54",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:56",
      "text": "ಅಯ್ಯೋ ನೆಟ್ವರ್ಕ್ ಬರ್ತಿಲ್ಲ ಕಣ್ರೀ"
    },
    {
      "t": "03:58",
      "text": "ರೀ ಎರಡೆರಡು ಪಾಯಿಂಟ್ ಆಗಿಬಿಟ್ಟೈತೆ"
    },
    {
      "t": "04:00",
      "text": "ಇದ್ರಲ್ಲಿ ರೆಡ್ ಬಂದ್ಬಿಟ್ಟೈತೆ"
    },
    {
      "t": "04:02",
      "text": "ಏನು ಮಾಡೋಣ"
    },
    {
      "t": "04:04",
      "text": "ಕಟ್ ಮಾಡಿ ಮತ್ತೆ ಮಾಡಿ ಅಷ್ಟೆ"
    },
    {
      "t": "04:06",
      "text": "ಕಟ್ ಮಾಡಿ ಮಾಡಿದರೆ ಆಗಲ್ಲ ಅದೊಂದು"
    },
    {
      "t": "04:08",
      "text": "ಇಲ್ಲಿ ಯಾರು ಕೈ ಕೊಟ್ರು ಅದು ಸಿಗಲ್ಲ"
    },
    {
      "t": "04:10",
      "text": "ಅಲ್ಲ"
    },
    {
      "t": "04:12",
      "text": "ಬಟ್"
    },
    {
      "t": "04:14",
      "text": "ಬೇರೆಯವರು ಸಿಗ್ತಾರೆ"
    },
    {
      "t": "04:16",
      "text": "ಏ ಅಂತ ಗೊತ್ತಿಲ್ಲ ಇನ್ನು ಇನ್ನು ಅರ್ಥ ಇಲ್ಲ ಎಕ್ಸಸೈಸ್"
    },
    {
      "t": "04:18",
      "text": "ಎರಡು ದಿವಸ ಆಯ್ತು ಇವಾಗ ಮಾತಾಡೋಣ"
    },
    {
      "t": "04:20",
      "text": "ಬೇರೆಯವರ ಜೊತೆ ಅವರ ಜೊತೆ ಮಾತಾಡಬೇಕಾದ್ರೆ"
    },
    {
      "t": "04:22",
      "text": "ಫೋನ್ ಮಾಡಿದ್ರೆ ಅದು ತಾಗಲ್ಲ ಬೇಗ ತಾಗ್ಬಿಡುತ್ತೆ"
    },
    {
      "t": "04:24",
      "text": "ಹೌದಾ"
    },
    {
      "t": "04:26",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:28",
      "text": "ಏನು"
    },
    {
      "t": "04:30",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "04:32",
      "text": "ನೀವೇನು ದಿನ ಆಯಿತು"
    },
    {
      "t": "04:34",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:36",
      "text": "ಓ ನಾನು"
    },
    {
      "t": "04:38",
      "text": "ಬಂದು ಫೋರ್ ಡೇಸ್ ಆಯಿತು"
    },
    {
      "t": "04:40",
      "text": "ಎಷ್ಟು ಜನ ಅಭಿಮಾನಿಗಳು"
    },
    {
      "t": "04:42",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "04:44",
      "text": "ಒಬ್ಬರು"
    },
    {
      "t": "04:46",
      "text": "ಇಲ್ಲ ಕಣ್ರೀ"
    },
    {
      "t": "04:48",
      "text": "ಮಾತಾಡಬೇ ಎರಡು ಕಾಲು"
    },
    {
      "t": "04:50",
      "text": "ಅಷ್ಟೇ ನಾನು ಜಸ್ಟ್ ಧೈರ್ಯವಾಗಿ ಕಾಲ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "04:52",
      "text": "ಇಲ್ಲ ಏನು ಪ್ರಯೋಜನ ಇಲ್ಲ ನನಗೆ"
    },
    {
      "t": "04:54",
      "text": "ನಾ ಕಿವಿಗೆ ಏನಾದರೂ ಇಟ್ಕೊಂಡಿದ್ದೀನಾ"
    },
    {
      "t": "04:56",
      "text": "ನಾಲ್ಕು ದಿವಸ ಆಯ್ತು"
    },
    {
      "t": "04:58",
      "text": "ಬಂದು ಅಂತಿದ್ದಾರೆ ಒಳ್ಳೆ ಕಾಲ ಅಂತಿದ್ದಾರೆ ಏನು ತಗೊಂಡು"
    },
    {
      "t": "05:00",
      "text": "ಆಕ್ಟ್"
    },
    {
      "t": "05:02",
      "text": "ಆ್ಯಕ್ಚುಲಿ ನಾಲ್ಕು ದಿನದ ಹಿಂದೆ ಈ"
