  "segments": [
    {
      "t": "00:00",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:02",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:04",
      "text": "ಹಲೋ"
    },
    {
      "t": "00:06",
      "text": "ಬೆಂಗ್ಳೂರಿಂದ"
    },
    {
      "t": "00:08",
      "text": "ನೀವು"
    },
    {
      "t": "00:10",
      "text": "ನಾನು ಬೆಂಗಳೂರು ಯಾವ ಏರಿಯಾ"
    },
    {
      "t": "00:12",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:14",
      "text": "ಸಂಗಾತಿ ಕಟ್ಟೆ"
    },
    {
      "t": "00:16",
      "text": "ಹೌದಾ ಆನ್ ಇಟ್"
    },
    {
      "t": "00:18",
      "text": "ಸಾಕಾಗಲ್ಲ ಅಷ್ಟೇ"
    },
    {
      "t": "00:20",
      "text": "ಇರ್ತೈತೆ"
    },
    {
      "t": "00:22",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:24",
      "text": "ಶಿಕ್ಷಣ"
    },
    {
      "t": "00:26",
      "text": "ಸಂಪರ್ಕ ಕೇಂದ್ರ"
    },
    {
      "t": "00:28",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:30",
      "text": "ಮದುವೆ ಆಗಿಲ್ವಾ"
    },
    {
      "t": "00:32",
      "text": "ಹಾಕಿದೆ"
    },
    {
      "t": "00:34",
      "text": "ಕಮ್ಮಿ"
    },
    {
      "t": "00:36",
      "text": "ಮದುವೆಯಾಗಿ ಸ್ವಲ್ಪ ಕಾಣೋದೇ ಇಲ್ಲ ಅಂದರೆ"
    },
    {
      "t": "00:38",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:40",
      "text": "ಕರೆಂಟ್ ಮಾಡ್ಕೊಂತೀವಿ"
    },
    {
      "t": "00:42",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:44",
      "text": "ಇದು ಬಂದೆ ಏನು ಮಾಡೋದು"
    },
    {
      "t": "00:46",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:48",
      "text": "ಇದನ್ನೇ ಏನು ಮಾಡೋದು ಅಂದರೆ"
    },
    {
      "t": "00:50",
      "text": "ಡ್ರೈವಿಂಗ್"
    },
    {
      "t": "00:52",
      "text": "ಹೌದಾ"
    },
    {
      "t": "00:54",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:56",
      "text": "ಲಾಂಗ್ ಟ್ರಿಪ್ ಹೋಗ್ತಾರೆ ಅಥವಾ ಏನಾದ್ರೂ"
    },
    {
      "t": "00:58",
      "text": "ಮತ್ತು"
    },
    {
      "t": "01:00",
      "text": "ಪ್ಲಾಂಕ್ ಹೋಗ್ತಾರೆ ಏನಾಯಿತು"
    },
    {
      "t": "01:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:04",
      "text": "ಹೌದು"
    },
    {
      "t": "01:06",
      "text": "ಮತ್ತೆ ಮತ್ತೆ"
    },
    {
      "t": "01:08",
      "text": "ಓಕೆ"
    },
    {
      "t": "01:10",
      "text": "ಮಕ್ಕಳಾಗಿಲ್ವಾ ಅಂತ"
    },
    {
      "t": "01:12",
      "text": "ಬನ್ನಿ ಇಲ್ಲ"
    },
    {
      "t": "01:14",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:16",
      "text": "ಮತ್ತು ಪಾಕಿಸ್ತಾನದ"
    },
    {
      "t": "01:18",
      "text": "ಇಷ್ಟು ನೂರ"
    },
    {
      "t": "01:20",
      "text": "ಅಲ್ಲಾ"
    },
    {
      "t": "01:22",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:24",
      "text": "ಮೋಸದ ನಂತರ ಆಗ್ತಿದೆ ಅನಿಸುತ್ತೆ"
    },
    {
      "t": "01:26",
      "text": "ಶೇರ್ ಮಾಡಿದ ನಂತರ"
    },
    {
      "t": "01:28",
      "text": "ಹಾಗಾದರೆ ನೋಡಿ ನೋಡಿಬಿಡಿ"
    },
    {
      "t": "01:30",
      "text": "ಈ ಮೌಢ್ಯದ"
    },
    {
      "t": "01:32",
      "text": "ಬೇಕಾಗಲ್ಲ ಸೆಟ್ ಮಾಡ್ಕೊಳ್ಳಿ"
    },
    {
      "t": "01:34",
      "text": "ಕೊಡ್ತೇನೆ"
    },
    {
      "t": "01:36",
      "text": "ಮಾಡ್ಲಾ"
    },
    {
      "t": "01:38",
      "text": "ದಿನ"
    },
    {
      "t": "01:40",
      "text": "ಬಂದು ಶೇರ್ ಮಾಡಿಕೊಳ್ಳಲಾಗಿದೆ"
    },
    {
      "t": "01:42",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:44",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:46",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:48",
      "text": "ದಂಡ ಏನು ಮಾಡಲ್ವಾ"
    },
    {
      "t": "01:50",
      "text": "ಅದ್ರ ಪಕ್ಕ ಏನಾದ್ರೂ ಇಟ್ಟು"
    },
    {
      "t": "01:52",
      "text": "ಇಷ್ಟಿಲ್ಲ ನಾರ್ಮಲ್ ಟಾಪ್ ಅಷ್ಟೆ"
    },
    {
      "t": "01:54",
      "text": "ಪ್ಲೀಸ್"
    },
    {
      "t": "01:56",
      "text": "ಸೇರಿಸಿದೆ"
    },
    {
      "t": "01:58",
      "text": "ನನ್ನ ಫ್ರೆಂಡ್ಸ್ ಏನಂತ ಏನಂತ ಹೇಳ್ದೆ"
    },
    {
      "t": "02:00",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:02",
      "text": "ನನ್ನ ಫೇವ್ರೇಟು"
    },
    {
      "t": "02:04",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:06",
      "text": "ಕೆಳಗಡೆ ಪಾರ್ಟ್"
    },
    {
      "t": "02:08",
      "text": "ಮಾಡೋದು ಡಾಲ್ ಕೊಡೋದು"
    },
    {
      "t": "02:10",
      "text": "ಚಿಟ್ಟೆ ಇರಬೇಕಲ್ಲ"
    },
    {
      "t": "02:12",
      "text": "ನನಗೆ ಒಳ್ಳೆಯ ಇಷ್ಟ ಆಯಿತಾ"
    },
    {
      "t": "02:14",
      "text": "ಬರಲ್ವಾ ಕಂಡೆಮ್ ಮಾಡಿದ ಮಾತು"
    },
    {
      "t": "02:16",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:18",
      "text": "ಮಾಡ್ಕೊಡೋಣ"
    },
    {
      "t": "02:20",
      "text": "ಹೌದು"
    },
    {
      "t": "02:22",
      "text": "ಯಾಕೆ"
    },
    {
      "t": "02:24",
      "text": "ಅವರಿಗೆ ಇಷ್ಟೇ"
    },
    {
      "t": "02:26",
      "text": "ಹೇಳಿದ್ರು ಅವ್ರು ತಂದೆ ತಾಯಿ"
    },
    {
      "t": "02:28",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:30",
      "text": "ಮತ್ತೇನು ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "02:32",
      "text": "ನನಗಿಷ್ಟ ಇಲ್ಲ"
    },
    {
      "t": "02:34",
      "text": "ಮತ್ತೇನು ಮಾಡಬೇಕು"
    },
    {
      "t": "02:36",
      "text": "ಅಲ್ವಾ ಸೆಕ್ಸ್ ನಂಬರ್ ಒನ್"
    },
    {
      "t": "02:38",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:40",
      "text": "ಆಯ್ತು"
    },
    {
      "t": "02:42",
      "text": "ನನಗೆ ಇಷ್ಟ ಇಲ್ಲ"
    },
    {
      "t": "02:44",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:46",
      "text": "ಭಾಳ ಇಷ್ಟ ಆಗೋ ಥರ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "02:48",
      "text": "ಇದು ಬಾಬು ಕಣ"
    },
    {
      "t": "02:50",
      "text": "ನಾನು ಇಷ್ಟ ಆಗೋ ಥರ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "02:52",
      "text": "ಅದೇ"
    },
    {
      "t": "02:54",
      "text": "ಅಲ್ಲೇ ಬಾಯಿ ಹಾಕೊಂಡು ಅಲ್ಲೇ ನಾನು"
    },
    {
      "t": "02:56",
      "text": "ಅಗದಿ ಹಾಕಿ ರಸಾಯನ"
    },
    {
      "t": "02:58",
      "text": "ಎಲ್ಲ ಬರೋ ಪದಾರ್ಥ ಎಲ್ಲ ಕುಡಿಬೇಕು"
    },
    {
      "t": "03:00",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:02",
      "text": "ತುಂಬ ಚೆನ್ನಾಗಿದೆ ಅದು"
    },
    {
      "t": "03:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:06",
      "text": "ಹೌದಪ್ಪ"
    },
    {
      "t": "03:08",
      "text": "ಗಂಡ ಮಾಡಿಲ್ವಾ ಇನ್ನೂವರೆಗೆ ನಿಮಗೆ"
    },
    {
      "t": "03:10",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:12",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:14",
      "text": "ಮೊಬೈಲ್ ಇದೆ ಮತ್ತು ಸರ್ಚ್ ಮಾಡಿಲ್ಲವಾ"
    },
    {
      "t": "03:16",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:18",
      "text": "ಸುಮ್ಮನೆ ಹೇಳ್ತಿದ್ದೆ"
    },
    {
      "t": "03:20",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:22",
      "text": "ನನ್ನ ಹೆಸರು"
    },
    {
      "t": "03:24",
      "text": "ಅಪ್ಪಾ ಅಚ್ಚಾ"
    },
    {
      "t": "03:26",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "03:28",
      "text": "ಇಂಥವು ಮುಂಚೆ ಯಾರ ಜೊತೆಗಾರು ಅಚ್ಚರಿತಾ ಇಲ್ಲ"
    },
    {
      "t": "03:30",
      "text": "ಲವರ್"
    },
    {
      "t": "03:32",
      "text": "ಅಪ್ಪಾ"
    },
    {
      "t": "03:34",
      "text": "ಫ್ರೆಶ್ ಏನೇ ಆಗುತ್ತೆ"
    },
    {
      "t": "03:36",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:38",
      "text": "ಕಾರ್ಸೋಮಾಲೆ ಕಾರ್ಸೋಮಿ ಅಂತ"
    },
    {
      "t": "03:40",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "03:42",
      "text": "ಎಚ್ಚರಿಸಿದ"
    },
    {
      "t": "03:44",
      "text": "ಮಜಾ ಬಂತು ಸರ್"
    },
    {
      "t": "03:46",
      "text": "ಹೌದು"
    },
    {
      "t": "03:48",
      "text": "ಸ್ವಲ್ಪ ಟಾಪ್ ಎತ್ತರ"
    },
    {
      "t": "03:50",
      "text": "ಏನೇ ಇಲ್ಲ"
    },
    {
      "t": "03:52",
      "text": "ತಾಕತ್ತನ್ನು ನೋಡ್ತಿದ್ದೇವೆ"
    },
    {
      "t": "03:54",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "03:56",
      "text": "ಸಾಕು ಓಕೆ ಓಕೆ"
    },
    {
      "t": "03:58",
      "text": "ಕಾಣಿಸ್ತದೆ"
    },
    {
      "t": "04:00",
      "text": "ಕಾರ್ಡ್ಸ್ ಶೇರ್ ಮಾಡಿಕೊಡ್ತಿದ್ದಾರೆ"
    },
    {
      "t": "04:02",
      "text": "ಹೌದಾ"
    },
    {
      "t": "04:04",
      "text": "ಪಕ್ಕ"
    },
    {
      "t": "04:06",
      "text": "ಸೊಪ್ಪು ಹಾಕಿಸೋದೇ ಬ್ರೋ"
    },
    {
      "t": "04:08",
      "text": "ಸಂಪತ್ತಿಸುತ್ತದೆ"
    },
    {
      "t": "04:10",
      "text": "ಓಕೆ"
    },
    {
      "t": "04:12",
      "text": "ಆಕಾಶದ ಪಾಕು"
    },
    {
      "t": "04:14",
      "text": "ನಮ್ದು ಹೊರತು ಯಾರು"
    },
    {
      "t": "04:16",
      "text": "ನಮಸ್ತೆ ಸರ್"
    },
    {
      "t": "04:18",
      "text": "ಹಾಂ"
    },
    {
      "t": "04:20",
      "text": "ಹೌದು"
    },
    {
      "t": "04:22",
      "text": "ಆಕ್ಯುಪ್ಯಾಂಕ್ಸ್ ಇದೆ"
    },
    {
      "t": "04:24",
      "text": "ಮತ್ತು"
    },
    {
      "t": "04:26",
      "text": "ಪ್ಲೀಸ್ ಮೇಡಮ್ ಓಕೆ ಕಾಣಿಸುತ್ತೆ ಪ್ಲೀಸ್"
    },
    {
      "t": "04:28",
      "text": "ಮತ್ತೊಂದು ಕೇವಲ ಅಗ್ರಶ್ರೇತಾಂಶ"
    },
    {
      "t": "04:30",
      "text": "ಅಭಿಲಾಷ್"
    },
    {
      "t": "04:32",
      "text": "ಮಾಡ್ತೀನಿ ಪ್ಲೀಸ್ ಕರೆಕ್ಟ್"
    },
    {
      "t": "04:34",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:36",
      "text": "ಹಾಂ"
    },
    {
      "t": "04:38",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:40",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:42",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:46",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:48",
      "text": "ಎಸ್"
