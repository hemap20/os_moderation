  "segments": [
    {
      "t": "00:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "ஹலோ"
    },
    {
      "t": "00:04",
      "text": "வணக்கம்"
    },
    {
      "t": "00:06",
      "text": "ஏன்னா உங்க ஒரு கண்ணு தான் தெரியுது ஒரு கண்ணு"
    },
    {
      "t": "00:08",
      "text": "தெரியல"
    },
    {
      "t": "00:10",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "00:12",
      "text": "எந்த ஊரில்"
    },
    {
      "t": "00:14",
      "text": "நம்பர்"
    },
    {
      "t": "00:16",
      "text": "பெங்களூர்"
    },
    {
      "t": "00:18",
      "text": "பண்ணுவிங்க"
    },
    {
      "t": "00:20",
      "text": "நான் பிஸ்னஸ் பண்ணுறேன் நீங்கள்"
    },
    {
      "t": "00:22",
      "text": "என்ன ஆசை"
    },
    {
      "t": "00:24",
      "text": "ஓகே மேரிடா"
    },
    {
      "t": "00:26",
      "text": "ஆமாம் அதான் ஹவுஸ்ஃபுல்"
    },
    {
      "t": "00:28",
      "text": "ஆ"
    },
    {
      "t": "00:30",
      "text": "அது என்ன பெப்பர் சால்ட்"
    },
    {
      "t": "00:32",
      "text": "புரியல"
    },
    {
      "t": "00:34",
      "text": "பெப்பர் அண்ட் சால்ட்டாக இருக்குது"
    },
    {
      "t": "00:36",
      "text": "டேஸ்ட் பண்ணி பார்க்குறீங்களா"
    },
    {
      "t": "00:38",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:40",
      "text": "ஓகே"
    },
    {
      "t": "00:42",
      "text": "பிஸ்னஸ் பண்றீங்க நான் ரியல் எஸ்டேட்"
    },
    {
      "t": "00:44",
      "text": "கண்டிப்பாக"
    },
    {
      "t": "00:46",
      "text": "ஓகே"
    },
    {
      "t": "00:48",
      "text": "உங்கள் ஏஜ்"
    },
    {
      "t": "00:50",
      "text": "பேரே ஒன்றும் சொல்லலை என் பேர் ஆனந்த்"
    },
    {
      "t": "00:52",
      "text": "எங்களோட பேர் சோமு"
    },
    {
      "t": "00:54",
      "text": "சூர்யா ஏஜ் டுவெண்ட்டி எயிட்"
    },
    {
      "t": "00:56",
      "text": "டொண்ட்டியா"
    },
    {
      "t": "00:58",
      "text": "எட்டு"
    },
    {
      "t": "01:00",
      "text": "எயிட் ஹாஃப்"
    },
    {
      "t": "01:02",
      "text": "சாப்பிட்டாச்சா"
    },
    {
      "t": "01:04",
      "text": "ஆயிடுச்சு நீங்கள்"
    },
    {
      "t": "01:06",
      "text": "நானும் சரி"
    },
    {
      "t": "01:08",
      "text": "எனிவிட்டி"
    },
    {
      "t": "01:10",
      "text": "இருக்கீங்களா இல்லை சம்வேர்"
    },
    {
      "t": "01:12",
      "text": "வெள்ளில கலமு"
    },
    {
      "t": "01:14",
      "text": "சரிங்க சார்"
    },
    {
      "t": "01:16",
      "text": "ஓகே பிசினஸ்ல அப்படி போயிட்டு இருக்கு"
    },
    {
      "t": "01:18",
      "text": "சூப்பரா போதுங்க"
    },
    {
      "t": "01:20",
      "text": "உங்களுக்கு எப்படி போகுது ஃபேமிலி"
    },
    {
      "t": "01:22",
      "text": "ஃபேமிலி லைஃப் எல்லாம்"
    },
    {
      "t": "01:24",
      "text": "ஒரு மாதிரி"
    },
    {
      "t": "01:26",
      "text": "அழுவா போகிற"
    },
    {
      "t": "01:28",
      "text": "ம்"
    },
    {
      "t": "01:30",
      "text": "இது மேரேஜ்"
    },
    {
      "t": "01:32",
      "text": "நான் மேரிடு"
    },
    {
      "t": "01:34",
      "text": "எட்டு"
    },
    {
      "t": "01:36",
      "text": "இதான் பேர் வேணாலும் யூஸ் பண்ணுறீங்க"
    },
    {
      "t": "01:38",
      "text": "மூணாவது நாள் நீக்க"
    },
    {
      "t": "01:40",
      "text": "இப்போதைக்கு"
    },
    {
      "t": "01:42",
      "text": "ஃபோர் தாட்டி"
    },
    {
      "t": "01:44",
      "text": "உணவு தர"
    },
    {
      "t": "01:46",
      "text": "அஸ்ஸலாமு அலைக்கிம் சார்"
    },
    {
      "t": "01:48",
      "text": "நிறைய பேர் இருப்பாங்களே பேசுகிறதுக்கு"
    },
    {
      "t": "01:50",
      "text": "நம்பர்"
    },
    {
      "t": "01:52",
      "text": "நம்மளுக்கு இன்ட்ரெஸ்ட் வேணும்ல"
    },
    {
      "t": "01:54",
      "text": "அப்புறம் ஏன் இந்த"
    },
    {
      "t": "01:56",
      "text": "டேஸ்ட் பண்ணணும்"
    },
    {
      "t": "01:58",
      "text": "அதாவது"
    },
    {
      "t": "02:00",
      "text": "செக்ஷுவலுக்காக யூஸ் பண்றது இல்லை இது"
    },
    {
      "t": "02:02",
      "text": "ஆ"
    },
    {
      "t": "02:04",
      "text": "ஆ வேற கொஞ்சம்"
    },
    {
      "t": "02:06",
      "text": "நீட்டாக இருக்கணுங்கிற அந்த மாதிரி"
    },
    {
      "t": "02:08",
      "text": "ஓகேங்களா"
    },
    {
      "t": "02:10",
      "text": "நீட்டா உங்களை மாதிரி பேசு"
    },
    {
      "t": "02:12",
      "text": "பேசணும் பேசுனால் நல்லாயிருக்கும்"
    },
    {
      "t": "02:14",
      "text": "நானே ஒரு வேஸ்ட்டு"
    },
    {
      "t": "02:16",
      "text": "நல்லா தான் இருக்கீங்க இஷ்டம்"
    },
    {
      "t": "02:18",
      "text": "ஆ"
    },
    {
      "t": "02:20",
      "text": "ம்"
    },
    {
      "t": "02:22",
      "text": "போ"
    }
  ],
  "full_text": "சரிங்க சார் ஹலோ வணக்கம் ஏன்னா உங்க ஒரு கண்ணு தான் தெரியுது ஒரு கண்ணு தெரியல சொல்லுங்கள் எந்த ஊரில் நம்பர் பெங்களூர் பண்ணுவிங்க நான் பிஸ்னஸ் பண்ணுறேன் நீங்கள் என்ன ஆசை ஓகே மேரிடா ஆமாம் அதான் ஹவுஸ்ஃபுல் ஆ அது என்ன பெப்பர் சால்ட் புரியல பெப்பர் அண்ட் சால்ட்டாக இருக்குது டேஸ்ட் பண்ணி பார்க்குறீங்களா சரிங்க சார் ஓகே பிஸ்னஸ் பண்றீங்க நான் ரியல் எஸ்டேட் கண்டிப்பாக ஓகே உங்கள் ஏஜ் பேரே ஒன்றும் சொல்லலை என் பேர் ஆனந்த் எங்களோட பேர் சோமு சூர்யா ஏஜ் டுவெண்ட்டி எயிட் டொண்ட்டியா எட்டு எயிட் ஹாஃப் சாப்பிட்டாச்சா ஆயிடுச்சு நீங்கள் நானும் சரி எனிவிட்டி இருக்கீங்களா இல்லை சம்வேர் வெள்ளில கலமு சரிங்க சார் ஓகே பிசினஸ்ல அப்படி போயிட்டு இருக்கு சூப்பரா போதுங்க உங்களுக்கு எப்படி போகுது ஃபேமிலி ஃபேமிலி லைஃப் எல்லாம் ஒரு மாதிரி அழுவா போகிற ம் இது மேரேஜ் நான் மேரிடு எட்டு இதான் பேர் வேணாலும் யூஸ் பண்ணுறீங்க மூணாவது நாள் நீக்க இப்போதைக்கு ஃபோர் தாட்டி உணவு தர அஸ்ஸலாமு அலைக்கிம் சார் நிறைய பேர் இருப்பாங்களே பேசுகிறதுக்கு நம்பர் நம்மளுக்கு இன்ட்ரெஸ்ட் வேணும்ல அப்புறம் ஏன் இந்த டேஸ்ட் பண்ணணும் அதாவது செக்ஷுவலுக்காக யூஸ் பண்றது இல்லை இது ஆ ஆ வேற கொஞ்சம் நீட்டாக இருக்கணுங்கிற அந்த மாதிரி ஓகேங்களா நீட்டா உங்களை மாதிரி பேசு பேசணும் பேசுனால் நல்லாயிருக்கும் நானே ஒரு வேஸ்ட்டு நல்லா தான் இருக்கீங்க இஷ்டம் ஆ ம் போ",
