  "segments": [
    {
      "t": "00:00",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:02",
      "text": "ಹೌದು"
    },
    {
      "t": "00:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:06",
      "text": "ಹಾಯ್"
    },
    {
      "t": "00:08",
      "text": "ಹಾಯ್ ಹಾಯ್"
    },
    {
      "t": "00:10",
      "text": "ಎಲ್ಲಿಂದ ಉಡುಪಿ"
    },
    {
      "t": "00:12",
      "text": "ನೀವು"
    },
    {
      "t": "00:14",
      "text": "ಬೆಂಗ್ಳೂರು"
    },
    {
      "t": "00:16",
      "text": "ಬ್ಯಾಂಗ್ಳೂರು ಏನು ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ"
    },
    {
      "t": "00:18",
      "text": "ಕಂಪ್ನಿ ನೀವು"
    },
    {
      "t": "00:20",
      "text": "ನಾನು ಬ್ಯೂಟಿಷಿಯನ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "00:22",
      "text": "ಕುಂಡಿದ್ದೀನಿ ಹೇಳ್ತೀರಾ"
    },
    {
      "t": "00:24",
      "text": "ಮ್ಯಾರಿಟಾ"
    },
    {
      "t": "00:26",
      "text": "ಯೂಸ್ ಮಾಡೋಣ"
    },
    {
      "t": "00:28",
      "text": "ಹಸ್ಬೆಂಡ್ ರನ್ನಿಂಗ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "00:30",
      "text": "ಕೊಡ್ತಾರೆ"
    },
    {
      "t": "00:32",
      "text": "ಓಕೆ ಓಕೆ ಓಕೆ"
    },
    {
      "t": "00:34",
      "text": "ಇಲ್ಲ ರೀ"
    },
    {
      "t": "00:36",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:38",
      "text": "ಮನೆಗೆ ಹತ್ತಿದ್ದೀನಿ"
    },
    {
      "t": "00:40",
      "text": "ಇಪ್ಪತ್ತೈದು ದಿನ ಒಂದು ತಿಂಗ್ಳಿಗೆ ಒಂದು ಸಲ ಬರ್ತಾಯಿದ್ರೆ"
    },
    {
      "t": "00:42",
      "text": "ಎಲ್ಲಿಂದ ಆಗಬೇಕು"
    },
    {
      "t": "00:44",
      "text": "ಹಾಂ ಹಾಂ"
    },
    {
      "t": "00:46",
      "text": "ಹಾಗೆ ಹಾಗೆ"
    },
    {
      "t": "00:48",
      "text": "ಕಾಳಿಗಾಗಲ್ಲಲ್ಲ"
    },
    {
      "t": "00:50",
      "text": "ಮತ್ತು"
    },
    {
      "t": "00:52",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "00:54",
      "text": "ಹೋಟೆಲ್"
    },
    {
      "t": "00:56",
      "text": "ಏನು ತೋರಿಸ್ತೀರಾ ನಾರ್ಮಲ್ ಕಾಲ್ ಮಾಡಿ"
    },
    {
      "t": "00:58",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:00",
      "text": "ಯಾರದು ಮಾತಾಡ್ತಿರೋದು"
    },
    {
      "t": "01:02",
      "text": "ಅದು ತಂಗಿ"
    },
    {
      "t": "01:04",
      "text": "ಹೊನಲ"
    },
    {
      "t": "01:06",
      "text": "ಎಷ್ಟು"
    },
    {
      "t": "01:08",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:10",
      "text": "ಫೋನಲ್ಲ ಮತ್ತು"
    },
    {
      "t": "01:12",
      "text": "ಹಾಂ ಇಲ್ಲ ಅವಳು ಕೂಡ"
    },
    {
      "t": "01:14",
      "text": "ಅವಳು ಅವಳು ಕೂಡ ಆ್ಯಪಲ್ಲೇ ಯೂಸ್ ಮಾಡ್ತಾಳೆ"
    },
    {
      "t": "01:16",
      "text": "ಹಾಂ ಹಾಂ"
    },
    {
      "t": "01:18",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:20",
      "text": "ಅವ್ಳು ಬೇರೆ ಆ್ಯಪ್ ಯೂಸ್ ಮಾಡ್ತಾಳೆ ನಾನು ಬೇರೆ ಆ್ಯಪ್ ಯೂಸ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "01:22",
      "text": "ಬೇರೆ ಯಾಪಿ ಯೂಸ್ ಮಾಡ್ತೀನಿ ಹಾಗೆ"
    },
    {
      "t": "01:24",
      "text": "ಹಾಂ ಹಾಂ"
    },
    {
      "t": "01:26",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "01:28",
      "text": "ಹೇಳಬೇಕು"
    },
    {
      "t": "01:30",
      "text": "ಓಹ್ ಎರಡು ಸೆಮ್ ಆಯಿತು"
    },
    {
      "t": "01:32",
      "text": "ಯೂಸ್ ಮಾಡಿ ಸ್ಟಾರ್ಟ್ ಮಾಡಿ"
    },
    {
      "t": "01:34",
      "text": "ಸೆವೆನ್ ಏಯ್ಟ್ ಮಂತ್ ಆಯಿತು"
    },
    {
      "t": "01:36",
      "text": "ಸ್ವಾಮಿ ನೀಟ್ ಒಂದು"
    },
    {
      "t": "01:38",
      "text": "ಸಹಿತ"
    },
    {
      "t": "01:40",
      "text": "ವಾವ್ ಹೇಗಿದೆ ಅಪ್ಪ"
    },
    {
      "t": "01:42",
      "text": "ನಾನು ಒಂದು ತಿಂಗಳಾಯ್ತು ರೀ"
    },
    {
      "t": "01:44",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ಕಾಲೇಜಿಂದಲೇ ಬಂದಿದ್ದಾ"
    },
    {
      "t": "01:46",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:48",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:50",
      "text": "ನೈಸ್"
    },
    {
      "t": "01:52",
      "text": "ಹಾಂ ಹೇಗಿದೆ"
    },
    {
      "t": "01:54",
      "text": "ಓಕೆ"
    },
    {
      "t": "01:56",
      "text": "ಪರವಾಗಿಲ್ಲ"
    },
    {
      "t": "01:58",
      "text": "ಹಾಗೆ"
    },
    {
      "t": "02:00",
      "text": "ಒಂಥರ ವೆರೈಟಿ ವೆರೈಟಿ ಎಲ್ಲ ಕೊಡ್ತಾರೆ"
    },
    {
      "t": "02:02",
      "text": "ಮೀ ಯಾವ ಥರ ಇಷ್ಟ"
    },
    {
      "t": "02:04",
      "text": "ಆಯಿತು"
    },
    {
      "t": "02:06",
      "text": "ನಾ ಎಲ್ಲ ಥರ ಕೂಡ ಮಾತಾಡ್ತೀನಿ"
    },
    {
      "t": "02:08",
      "text": "ಎಲ್ಲ ಕೂಡ ಹೇಗೆ ಮಾತಾಡೋದು"
    },
    {
      "t": "02:10",
      "text": "ಹಾಗೆ ಮಾತಾಡಿ"
    },
    {
      "t": "02:12",
      "text": "ಓಕೆ"
    },
    {
      "t": "02:14",
      "text": "ಟೈಮ್ ಪಾಸ್"
    },
    {
      "t": "02:16",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "02:18",
      "text": "ನೆಟ್ವರ್ಕ್ ಇಲ್ಲ ಅನ್ಸುತ್ತೆ ರೀ"
    },
    {
      "t": "02:20",
      "text": "ಕಾಣ್ತಿದೇನೋ ನಾನು"
    },
    {
      "t": "02:22",
      "text": "ಹಾಂ ನಿಮ್ಮದು"
    },
    {
      "t": "02:24",
      "text": "ಹೌದಾ"
    },
    {
      "t": "02:26",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:28",
      "text": "ಹಾಂ ಹಾಂ"
    },
    {
      "t": "02:30",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "02:32",
      "text": "ಟು ಏಟ್ ಫೋರ್"
    },
    {
      "t": "02:34",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:36",
      "text": "ಹಾಂ ಇವಾಗ ಮಾಡೋಲ್ಲ ನಾನು ನಾಳೆ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "02:38",
      "text": "ಆಂ"
    },
    {
      "t": "02:40",
      "text": "ಮತ್ತೆ ಮತ್ತೆ ಹೇಳ್ಬೇಕು"
    },
    {
      "t": "02:42",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:44",
      "text": "ಹುಲಿ"
    },
    {
      "t": "02:46",
      "text": "ಶಾಂತಿ"
    },
    {
      "t": "02:48",
      "text": "ಹೇಳ್ಬೇಕಪ್ಪ"
    },
    {
      "t": "02:50",
      "text": "ಮನೇಲಿ ಯಾರೂ ಇಲ್ವಾ"
    },
    {
      "t": "02:52",
      "text": "ಓಕೆ"
    },
    {
      "t": "02:54",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:56",
      "text": "ಹಾಗೆ"
    },
    {
      "t": "02:58",
      "text": "ಅಂದರೆ ರೂಮ್ ಮಾಡ್ಕೊಂಡಿದ್ದೀರಾ"
    },
    {
      "t": "03:00",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:02",
      "text": "ಹಾಂ ನೋಡಿ"
    },
    {
      "t": "03:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:06",
      "text": "ಸ್ವಲ್ಪ"
    },
    {
      "t": "03:08",
      "text": "ಕಾಲ್ ಮಾಡ್ತಾರೆ ಮತ್ತೆ ಹೇಳಿ"
    },
    {
      "t": "03:10",
      "text": "ಏಟು ಮೆಸ್ಸು"
    },
    {
      "t": "03:12",
      "text": "ನೇಹಾನ್"
    },
    {
      "t": "03:14",
      "text": "ನಿಮ್ಮದು"
    },
    {
      "t": "03:16",
      "text": "ಕಾಲ್ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "03:18",
      "text": "ವಿನಯ್"
    },
    {
      "t": "03:20",
      "text": "ಹಾಂ ನನ್ನ"
    },
    {
      "t": "03:22",
      "text": "ನೆಟ್ವರ್ಕ್ ಪ್ರಾಬ್ಲಮ್ ಏನು"
    },
    {
      "t": "03:24",
      "text": "ಹಾಂ ಸರಿ ತ್ಯಾಂಕ್ ಯು"
    },
    {
      "t": "03:26",
      "text": "ಫುಲ್ ಫಾನ್ ಅನ್ಸುತ್ತೆ ಏನಪ್ಪಾ"
    },
    {
      "t": "03:28",
      "text": "ಹ್ಞೂ ನಿಮ್ದು ಸ್ಟ್ರಕ್ ಆಗಿದೆ"
    },
    {
      "t": "03:30",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:32",
      "text": "ಆ"
    },
    {
      "t": "03:34",
      "text": "ಮತ್ತೆ ನೀವು ತುಂಬ ವೆರೈಟಿ"
    },
    {
      "t": "03:36",
      "text": "ವೆರೈಟಿ ವೆರೈಟಿ ನೋಡಿರ್ಬೋದು ಅಂತ ಅಲ್ವಾ"
    },
    {
      "t": "03:38",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:40",
      "text": "ದಿವ್ಯ ಉದ್ದೇಶದ ಬಗ್ಗೆ"
    },
    {
      "t": "03:42",
      "text": "ಬಂದಿದೆ ಅಪ್ಪಿಗೆ"
    },
    {
      "t": "03:44",
      "text": "ಎಲ್ಲ ಥರ ನೀವು"
    },
    {
      "t": "03:46",
      "text": "ನಾನು"
    },
    {
      "t": "03:48",
      "text": "ನೂರಲ್ಲಿ ತೊಂಬತ್ತು ಪರ್ಸೆಂಟು"
    },
    {
      "t": "03:50",
      "text": "ಅರ್ನಿಂಗ್ ಅಂತಾನೂ ಬಂದಿದ್ದು ಟನ್"
    },
    {
      "t": "03:52",
      "text": "ಟೆನ್ ಪರ್ಸೆಂಟ್ ಟೈಮ್ ಪಾಸ್ ಮಾಡ್ಬೋದು ಮಾತಾಡ್ಬೋದು"
    },
    {
      "t": "03:54",
      "text": "ಹೋತು ಫ್ರೆಂಡ್ಶಿಪ್ ಸಿಗ್ತಾರ ನೋಡುವ ಅಂತ ಬಂದೆ"
    },
    {
      "t": "03:56",
      "text": "ಆಯಿತು ಹಾಂ"
    },
    {
      "t": "03:58",
      "text": "ಹೌದು"
    },
    {
      "t": "04:00",
      "text": "ನೀವು"
    },
    {
      "t": "04:02",
      "text": "ನಿಮಗೆ ಸಿಕ್ಕಿದರಾ"
    },
    {
      "t": "04:04",
      "text": "ಹಾಂ ಸೆಕ್ಯೂರ್"
    },
    {
      "t": "04:06",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:08",
      "text": "ಹಾಂ"
    },
    {
      "t": "04:10",
      "text": "ಹೋಗಿ ಎಲ್ಲ ಕೂಡ ಆಗಿದೆ"
    },
    {
      "t": "04:12",
      "text": "ಅಂತ ಹಾಗಾದರೆ ಅಲ್ವಾ"
    },
    {
      "t": "04:14",
      "text": "ಹಾಂ ತುಂಬ ದೊಡ್ಡ"
    },
    {
      "t": "04:16",
      "text": "ಹೋಗ್ತೀರಾ"
    },
    {
      "t": "04:18",
      "text": "ಬೆಂಗ್ಳೂರ"
    },
    {
      "t": "04:20",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:22",
      "text": "ಟೋಟಲ್"
    },
    {
      "t": "04:24",
      "text": "ಇಲ್ಲ ರೀ ಒಂದು ತಿಂಗಳಾಯ್ತು ಅಂತ ಹೇಳಿ"
    },
    {
      "t": "04:26",
      "text": "ಹೇಳೋದಲ್ವಾ ನನಗೆ ಸಿಕ್ಕವರಲ್ಲಿ ಮೂರು ಜನ"
    },
    {
      "t": "04:28",
      "text": "ಇಬ್ಬರು ಮೈಸೂರಿನವರು"
    },
    {
      "t": "04:30",
      "text": "ಬೆಂಗ್ಳೂರಿನವರು ಸೊ ಅವ್ರಿಗೆ ಇಲ್ಲಿ ಬರಲಿಕ್ಕಾಗಲ್ಲ"
    },
    {
      "t": "04:32",
      "text": "ನನಗೆ ಅಲ್ಲಿ ಹೋಗಲಿಕ್ಕಾಗಲ್ಲ"
    },
    {
      "t": "04:34",
      "text": "ಹೀಗೆ ಮಾತಾಡೋದು ಮಾತ್ರ ನಾವು"
    },
    {
      "t": "04:36",
      "text": "ಸಿಕ್ತೀರಾ"
    },
    {
      "t": "04:38",
      "text": "ಅವ್ರು ಇಲ್ಲಿ ಬರಬೇಕಲ್ಲ ರೀ"
    },
    {
      "t": "04:40",
      "text": "ಬರೋದಿಲ್ಲಲ್ಲ ಅವರು"
    },
    {
      "t": "04:42",
      "text": "ಬಂದ್ರೆ ಸಿಗ್ತೀರಾ"
    },
    {
      "t": "04:44",
      "text": "ಬಂದರೆ ಸಿಗ್ಬೋದು"
    },
    {
      "t": "04:46",
      "text": "ಬಟ್ ಅವರು ಬರೋಕೆ ಬರೋಕೆ"
    },
    {
      "t": "04:48",
      "text": "ಬರಲ್ಲ ಅಂತ ಹೇಳಿದರು ಹಾಗೆ"
    },
    {
      "t": "04:50",
      "text": "ಮಾತಾಡ್ತೀವಿ"
    },
    {
      "t": "04:52",
      "text": "ಎಸ್ನೇಪಲ್ಲಿ"
    },
    {
      "t": "04:54",
      "text": "ನಂಬರ್ ಕೊಟ್ಟಿದ್ದೀನಿ ಐ ಡಿ"
    },
    {
      "t": "04:56",
      "text": "ಕೊಟ್ಟಿದ್ದಾರೆ ಹಾಗೆ ಅದರಲ್ಲಿ ಮೆಸೇಜು ಕಾಲು ಮಾಡಿ"
    },
    {
      "t": "04:58",
      "text": "ಕೂಡಿ ಮಾತಾಡ್ತಾ ಇರ್ತೇವೆ ಹಾಗೆ"
    },
    {
      "t": "05:00",
      "text": "ಏನಾದರೂ"
    },
    {
      "t": "05:02",
      "text": "ಬೇಕು ಅಂತ ಹೇಳಿದರೆ ಅದರಲ್ಲೇ ಇದು ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "05:04",
      "text": "ನನಗೆಲ್ಲ ಬೇಕು ಅಂತ ಅನ್ಸಿದ್ದು"
    },
