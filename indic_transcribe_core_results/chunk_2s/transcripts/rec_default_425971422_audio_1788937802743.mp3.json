    {
      "t": "02:36",
      "text": "തൃശ്ശൂരിന്"
    },
    {
      "t": "02:38",
      "text": "തൃശ്ശൂർ"
    },
    {
      "t": "02:40",
      "text": "എന്ത് ചെയ്യാം"
    },
    {
      "t": "02:42",
      "text": "എന്താ എന്തിൻ്റെ ഷോപ്പാണ്"
    },
    {
      "t": "02:44",
      "text": "ബുള്ളറ്റിൻ്റെ സ്പെയർ പാർട്സ്"
    },
    {
      "t": "02:46",
      "text": "ബൈക്കിൻ്റെ സ്പെയർ പാർട്സുകൾ അപ്പോൾ"
    },
    {
      "t": "02:48",
      "text": "കുറേയൊക്കെ ആയിട്ട്"
    },
    {
      "t": "02:50",
      "text": "ഹോൾസെയിലിൻ്റെ"
