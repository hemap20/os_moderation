{
  "file_id": "rec_default_427308167_audio_1789058388570.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 356.754,
  "processing_time_sec": 28.262860536575317,
  "segments": [
    {
      "t": "00:00",
      "text": "லவ்"
    },
    {
      "t": "00:02",
      "text": "ஹலோ"
    },
    {
      "t": "00:04",
      "text": "ஹாய்"
    },
    {
      "t": "00:06",
      "text": "எங்கேயிருந்து பேசுகிறீங்க"
    },
    {
      "t": "00:08",
      "text": "நான் சேலம் நீங்கள்"
    },
    {
      "t": "00:10",
      "text": "ஆஸ்திரேலியாவில்"
    },
    {
      "t": "00:12",
      "text": "உங்கள் பேர் என்ன"
    },
    {
      "t": "00:14",
      "text": "என்ன பண்ணுறீங்க"
    },
    {
      "t": "00:16",
      "text": "ஆ வாரணுகா"
    },
    {
      "t": "00:18",
      "text": "ஓகே"
    },
    {
      "t": "00:20",
      "text": "உங்கள் பேர்"
    },
    {
      "t": "00:22",
      "text": "என் பேர் பிரியா என்ன பண்ணுறீங்க"
    },
    {
      "t": "00:24",
      "text": "கரோன்"
    },
    {
      "t": "00:26",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:28",
      "text": "ஹலோ"
    },
    {
      "t": "00:30",
      "text": "ஓ"
    },
    {
      "t": "00:32",
      "text": "கட் ஆயிடுச்சு சரி"
    },
    {
      "t": "00:34",
      "text": "அப்"
    },
    {
      "t": "00:36",
      "text": "உங்களுக்கு நெட்ஒர்க் இஷ்யூ வரும்"
    },
    {
      "t": "00:38",
      "text": "ஓகே"
    },
    {
      "t": "00:40",
      "text": "ஓகே சொல்லுங்கள் வருவோம்"
    },
    {
      "t": "00:42",
      "text": "ரொம்ப அழகா இருக்கீங்க"
    },
    {
      "t": "00:44",
      "text": "ஒன்று"
    },
    {
      "t": "00:46",
      "text": "தேங்க் யூ"
    },
    {
      "t": "00:48",
      "text": "என்ன"
    },
    {
      "t": "00:50",
      "text": "எங்கேன்னு சொல்லிட்டு நீங்களே செஞ்சுட்டீங்க"
    },
    {
      "t": "00:52",
      "text": "சும்மா விளையாட்டுக்கு சொன்னிங்களா"
    },
    {
      "t": "00:54",
      "text": "இல்லை இல்லை நல்லா தான் இருக்கீங்க"
    },
    {
      "t": "00:56",
      "text": "ம்"
    },
    {
      "t": "00:58",
      "text": "ஓகே ஓகே மேரேஜ் டு கலாநிதி"
    },
    {
      "t": "01:00",
      "text": "ஐயா நோ வருவோம்"
    },
    {
      "t": "01:02",
      "text": "ஏன்"
    },
    {
      "t": "01:04",
      "text": "எனக்கு டுவெண்ட்டி ஃபைவ் தான்"
    },
    {
      "t": "01:06",
      "text": "பதினஞ்சு நாளைக்கு மேரேஜ் ஆகலை"
    },
    {
      "t": "01:08",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "01:10",
      "text": "லேப் எப்படி இருக்கு"
    },
    {
      "t": "01:12",
      "text": "இப்போ தான் இன்ஸ்டால் பண்ணேன்"
    },
    {
      "t": "01:14",
      "text": "இப்போ தான் இன்ஸ்டால் பண்ணிங்களா"
    },
    {
      "t": "01:16",
      "text": "அதான் நல்லா பேசுகிறீங்க"
    },
    {
      "t": "01:18",
      "text": "நல்லா என்ன"
    },
    {
      "t": "01:20",
      "text": "நல்ல பையனா பேசுறீங்க"
    },
    {
      "t": "01:22",
      "text": "அது சொன்னேன் ஓகே"
    },
    {
      "t": "01:24",
      "text": "ஓகே பக்கத்தில் யாரும் இருக்காங்களோ"
    },
    {
      "t": "01:26",
      "text": "என்ன புரியல"
    },
    {
      "t": "01:28",
      "text": "இல்லை வருண் தானே ம்"
    },
    {
      "t": "01:30",
      "text": "இல்லை வேற யாரையோ படிச்சிடுச்சிட்டே இருக்கீங்க இல்லையா அதான்"
    },
    {
      "t": "01:32",
      "text": "பக்கத்தில் எதுவும் இருக்காங்களான்னு கேட்டேன்"
    },
    {
      "t": "01:34",
      "text": "யாரும் இல்லை ஒரு"
    },
    {
      "t": "01:36",
      "text": "போய் எங்கள் ஃப்ரெண்டில் யாரோ இருக்கிறாங்க"
    },
    {
      "t": "01:38",
      "text": "அப்புறம் தான் யாரும் இல்லை ஒரு"
    },
    {
      "t": "01:40",
      "text": "வேணா வேணா காட்டுவா"
    },
    {
      "t": "01:42",
      "text": "என் பேரோட தான் தெரியும்"
    },
    {
      "t": "01:44",
      "text": "ஓகேவா"
    },
    {
      "t": "01:46",
      "text": "இது எங்கே வரும்னு அது கூட தெரிய மாட்டேங்குதுல்ல"
    },
    {
      "t": "01:48",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "01:50",
      "text": "பாருங்க"
    },
    {
      "t": "01:52",
      "text": "ஆ வயது"
    },
    {
      "t": "01:54",
      "text": "பார்க்கறதுக்கு"
    },
    {
      "t": "01:56",
      "text": "ஏஜ் ஆன மாதிரி தான் எடுக்குறீங்க"
    },
    {
      "t": "01:58",
      "text": "ஏஜ் அந்த மாதிரி எதுக்குன்னா டுவெண்ட்டி ஃபைவ்"
    },
    {
      "t": "02:00",
      "text": "சரி ஆயிடுச்சுன்னா என்ன பண்ணுறது"
    },
    {
      "t": "02:02",
      "text": "ஓகே"
    },
    {
      "t": "02:04",
      "text": "கல்யாணம் ஆகலை"
    },
    {
      "t": "02:06",
      "text": "அதனால் எல்லாம் ஒன்றும் பண்ண முடியாது இல்லை ஏஜ்"
    },
    {
      "t": "02:08",
      "text": "ஆயிடுச்சுன்னா ம்"
    },
    {
      "t": "02:10",
      "text": "எனக்கு கொடுத்தா நல்லது தானே"
    },
    {
      "t": "02:12",
      "text": "உங்கள் வயசு என்ன"
    },
    {
      "t": "02:14",
      "text": "எனக்கு இருபத்தி நாலு"
    },
    {
      "t": "02:16",
      "text": "உங்களோடய"
    },
    {
      "t": "02:18",
      "text": "ஒரு வருஷம் பெருசுதான் இருந்தாலும்"
    },
    {
      "t": "02:20",
      "text": "இருந்தாலும் ஏஜ் ஆன மாதிரி இருக்குன்னு நீங்களே சொல்லிட்டீங்க"
    },
    {
      "t": "02:22",
      "text": "ஆமாம்"
    },
    {
      "t": "02:24",
      "text": "ம் தருவிடுங்க"
    },
    {
      "t": "02:26",
      "text": "அதெல்லாம் ஒன்றும் பிரச்சனை இல்லை ஏஜ் அதான் என்னை"
    },
    {
      "t": "02:28",
      "text": "பண்ண முடியும் நம்ம ஜீன் அப்படி"
    },
    {
      "t": "02:30",
      "text": "ம்"
    },
    {
      "t": "02:32",
      "text": "ம்"
    },
    {
      "t": "02:34",
      "text": "சார் உள்ளே இருக்கீங்க"
    },
    {
      "t": "02:36",
      "text": "ஓகேங்களா வருவோம் ஆமாங்க"
    },
    {
      "t": "02:38",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "02:40",
      "text": "ஏன் இந்த நேரத்தில் காரைக்குடி"
    },
    {
      "t": "02:42",
      "text": "மீட்டுக்கு போகலையா"
    },
    {
      "t": "02:44",
      "text": "இல்லை"
    },
    {
      "t": "02:46",
      "text": "ஆஃபீஸ்லேருந்து இப்போ தான் வந்தேன் சரி"
    },
    {
      "t": "02:48",
      "text": "அப்படியே கார்லேயே படுத்துட்டேன்"
    },
    {
      "t": "02:50",
      "text": "ஓகே"
    },
    {
      "t": "02:52",
      "text": "சாப்பிட்டிங்களா ஆ"
    },
    {
      "t": "02:54",
      "text": "சாப்பிட்டேங்க நீங்கள்"
    },
    {
      "t": "02:56",
      "text": "சாப்பிட்டா வரும்"
    },
    {
      "t": "02:58",
      "text": "சரிங்க சார்"
    },
    {
      "t": "03:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "03:02",
      "text": "சரிங்க சார்"
    },
    {
      "t": "03:04",
      "text": "இந்த ஆப்பை பற்றி தெரிஞ்சுக்கணுமா என்ன"
    },
    {
      "t": "03:06",
      "text": "ஆ சொல்லுங்கள் சொல்லுங்கள்"
    },
    {
      "t": "03:08",
      "text": "ம்"
    },
    {
      "t": "03:10",
      "text": "இதில் வீடியோக்கள்லாம் மோஸ்ட்"
    },
    {
      "t": "03:12",
      "text": "ஆக்சுவலி வந்து எயிட்டின் ப்ளஸ் வரும்"
    },
    {
      "t": "03:14",
      "text": "ஓகே"
    },
    {
      "t": "03:16",
      "text": "ஆனால் வந்து இதில் அதிகமாக பேசமாட்டாங்க"
    },
    {
      "t": "03:18",
      "text": "வாட்ஸ்அப் நம்பர் அந்த மாதிரி கொடுங்க"
    },
    {
      "t": "03:20",
      "text": "கொடுத்து அமௌண்ட் பே பண்ண சொல்லி"
    },
    {
      "t": "03:22",
      "text": "அது ஒரு சிலர்"
    },
    {
      "t": "03:24",
      "text": "பேசுவாங்களாமா ஒரு சிலர் வந்து"
    },
    {
      "t": "03:26",
      "text": "சீட் பண்ணிட்டு போயிடுவாங்க பிளாக் பண்ணிடுவாங்க"
    },
    {
      "t": "03:28",
      "text": "அப்படிலாம் சொன்னாங்க"
    },
    {
      "t": "03:30",
      "text": "ஆஹா இப்போ நீங்கள் வாட்ஸ்அப் நம்பர்"
    },
    {
      "t": "03:32",
      "text": "கொடுத்து போ வர வா அப்படினா"
    },
    {
      "t": "03:34",
      "text": "சொன்னாங்கன்னா இது பண்ணாதீங்க"
    },
    {
      "t": "03:36",
      "text": "இதுலேயே பேசுவாங்கள்ல"
    },
    {
      "t": "03:38",
      "text": "ஆமாம் அவங்க கூட பேசு"
    },
    {
      "t": "03:40",
      "text": "சீக்கிரம் இல்லை அதான் சேஃப்"
    },
    {
      "t": "03:42",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "03:44",
      "text": "பரவாயில்லை நீ பேசினா மட்டும் போதும் அப்படின்னு சொல்லிட்டு"
    },
    {
      "t": "03:46",
      "text": "சொன்னீங்கன்னால் இதிலே பேசுவாங்க"
    },
    {
      "t": "03:48",
      "text": "ம் ம் அந்த மாதிரி யூஸ்"
    },
    {
      "t": "03:50",
      "text": "பண்ணிக்கோங்க வாட்ஸ்அப்லாம்"
    },
    {
      "t": "03:52",
      "text": "இது பண்ணி நிறைய பேர் சொல்லியிருக்காங்க சீட் பண்ணி"
    },
    {
      "t": "03:54",
      "text": "பண்ணிட்டு போயிடுறாங்க"
    },
    {
      "t": "03:56",
      "text": "கேஸ் வரதில்லை பிளாக் பண்ணிடுறாங்க"
    },
    {
      "t": "03:58",
      "text": "அப்படி சொல்லு ஓகே ஓகே"
    },
    {
      "t": "04:00",
      "text": "ம் இது வீட்டில்"
    },
    {
      "t": "04:02",
      "text": "வீடியோ காலில் ஒரு சில"
    },
    {
      "t": "04:04",
      "text": "வந்து என்ன மாதிரியும் பேசுவாங்க ஃப்ரெண்ட்ஸ்"
    },
    {
      "t": "04:06",
      "text": "ஃப்ரெண்ட்லியாக மட்டும் பேசுவாங்க"
    },
    {
      "t": "04:08",
      "text": "ஆடியோ காலிலயும் சம்டைம்ஸ்"
    },
    {
      "t": "04:10",
      "text": "வந்து நம்பர் கொடுத்து"
    },
    {
      "t": "04:12",
      "text": "வாட்ஸ்அப் அந்த மாதிரி ரெண்டுலேயுமே"
    },
    {
      "t": "04:14",
      "text": "அப்புறம் மாமா"
    },
    {
      "t": "04:16",
      "text": "மோஸ்ட்லி"
    },
    {
      "t": "04:18",
      "text": "அந்த மாதிரி இது பண்ணுற மாதிரி"
    },
    {
      "t": "04:20",
      "text": "இருந்தால் வீடியோக்கள் வந்துக்கங்க இல்லை"
    },
    {
      "t": "04:22",
      "text": "பேசினா மட்டும் போதும்னா நீங்கள் ஆடியோ"
    },
    {
      "t": "04:24",
      "text": "ஆடியோக்கள்லேயே போகலாம் ஆடியோக்களில் ரொம்ப நேரம் டைம்"
    },
    {
      "t": "04:26",
      "text": "கிடைக்கும் ஆனால் வீடியோவில்"
    },
    {
      "t": "04:28",
      "text": "வந்து காயின்ஸ் அதிகமாக போகும் ஸோ அதனால்"
    },
    {
      "t": "04:30",
      "text": "சீக்கிரமாக முடிஞ்சிடும்"
    },
    {
      "t": "04:32",
      "text": "அந்த மாதிரி இருக்கும்"
    },
    {
      "t": "04:34",
      "text": "ஓ போ நீயா"
    },
    {
      "t": "04:36",
      "text": "ஆடியோ காலில் நீங்கள் அட்டன் பண்ணலாம்"
    },
    {
      "t": "04:38",
      "text": "போகலாமா"
    },
    {
      "t": "04:40",
      "text": "ஆடியோ காலில் நான் ஆன்லைன்"
    },
    {
      "t": "04:42",
      "text": "ஃபோனில் இருந்தேன்னா எனக்கு ஆடியோ கால் கனெக்ட் ஆகும்"
    },
    {
      "t": "04:44",
      "text": "இல்லைன்னா வீடு"
    },
    {
      "t": "04:46",
      "text": "கரெக்டாக கிரெடிட் பண்ணுறதுனா எப்படி பண்ணுறது"
    },
    {
      "t": "04:48",
      "text": "உங்களை கனெக்ட் பண்ண முடியாது"
    },
    {
      "t": "04:50",
      "text": "ஒன்ஸ் நான் வீடியோ கால் வந்துட்டேன்னா வீடியோ"
    },
    {
      "t": "04:52",
      "text": "மட்டும் தான் பேசிக்கணும்"
    },
    {
      "t": "04:54",
      "text": "ஆடியோ கால் வந்து சேஞ்ச் ஆகாது"
    },
    {
      "t": "04:56",
      "text": "அதை திருப்பி கட் பண்ணிவிட்டு வந்து"
    },
    {
      "t": "04:58",
      "text": "கட் பண்ணி"
    },
    {
      "t": "05:00",
      "text": "பண்ணிட்டீங்கன்னா நான் எப்போ ஆடியோ கால் வரணும்"
    },
    {
      "t": "05:02",
      "text": "அப்போ தான் வரும்"
    },
    {
      "t": "05:04",
      "text": "ஓ அப்படிங்களா வெளியில் ஆப்பில் போயிட்டு வரணும்"
    },
    {
      "t": "05:06",
      "text": "ஆ ஒன்ஸ்"
    },
    {
      "t": "05:08",
      "text": "அதுவும் வந்து இதில் வந்து ஒருத்தங்க"
    },
    {
      "t": "05:10",
      "text": "உங்ககிட்ட பேசுனீங்கன்னா உங்களுக்கு திருப்பி ரீகனெக்ட்"
    },
    {
      "t": "05:12",
      "text": "அதுக்காக ரொம்ப கஷ்டம்"
    },
    {
      "t": "05:14",
      "text": "வேணும்னா ஃபேவரெட்டில் போட்டு"
    },
    {
      "t": "05:16",
      "text": "வச்சுக்கோங்க எப்போவாது ஒரு நாள் கண்டிப்பாக கணக்கு"
    },
    {
      "t": "05:18",
      "text": "டாப்"
    },
    {
      "t": "05:20",
      "text": "ம்"
    },
    {
      "t": "05:22",
      "text": "மோஸ்ட்லி வாட்ஸ்அப்"
    },
    {
      "t": "05:24",
      "text": "வாட்ஸ்அப்பில் போடுறத மட்டும் அவாய்ட் பண்ணிக்கோங்க இதில்"
    },
    {
      "t": "05:26",
      "text": "பேசிக்கோங்க அது சேஃப்"
    },
    {
      "t": "05:28",
      "text": "ஓகே"
    },
    {
      "t": "05:30",
      "text": "ஓகே ஓகே அதில்"
    },
    {
      "t": "05:32",
      "text": "இதில் வந்து ரெக்கார்ட் ஸ்கிரீன்ஷாட் எதுவுமே"
    },
    {
      "t": "05:34",
      "text": "எடுக்க முடியாது ஆமாம்"
    },
    {
      "t": "05:36",
      "text": "ம் அதனால் இது கொஞ்சம்"
    },
    {
      "t": "05:38",
      "text": "கொஞ்சம் சேஃப் பட்டு வாட்ஸ்அப்"
    },
    {
      "t": "05:40",
      "text": "உங்களுக்கு கொஞ்சம்"
    },
    {
      "t": "05:42",
      "text": "டிஸ்கம்ஃபர்ட்"
    },
    {
      "t": "05:44",
      "text": "ஓகே ஓகே நீங்கள் என்ன பண்ணுறீங்க வீட்டில் தான்"
    },
    {
      "t": "05:46",
      "text": "நல்லா இருக்கீங்களா நல்லா படிக்கிறீங்களா"
    },
    {
      "t": "05:48",
      "text": "படிச்சுக்கிட்டு இருக்க கோர்ஸ் படிச்சுக்கிட்டு இருக்கேன்"
    },
    {
      "t": "05:50",
      "text": "ஓகே ஓகே வாய்ஸ் நல்லா"
    },
