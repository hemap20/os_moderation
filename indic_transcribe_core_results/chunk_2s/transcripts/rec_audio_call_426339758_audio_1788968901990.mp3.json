{
  "file_id": "rec_audio_call_426339758_audio_1788968901990.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 317.323,
  "processing_time_sec": 18.886969566345215,
  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "హలో"
    },
    {
      "t": "00:04",
      "text": "హలో"
    },
    {
      "t": "00:06",
      "text": "హలో"
    },
    {
      "t": "00:08",
      "text": "హాయ్ అండి ఇక్కడ నుంచి"
    },
    {
      "t": "00:10",
      "text": "హలో"
    },
    {
      "t": "00:12",
      "text": "హలో"
    },
    {
      "t": "00:14",
      "text": "హలో"
    },
    {
      "t": "00:16",
      "text": "హలో"
    },
    {
      "t": "00:18",
      "text": "సరే సరే"
    },
    {
      "t": "00:20",
      "text": "హైదరాబాద్"
    },
    {
      "t": "00:22",
      "text": "ఏం చేస్తుంటారు"
    },
    {
      "t": "00:24",
      "text": "అలాగే"
    },
    {
      "t": "00:26",
      "text": "హౌస్ వైఫ్"
    },
    {
      "t": "00:28",
      "text": "మ్యారీడా"
    },
    {
      "t": "00:30",
      "text": "ఏం చేస్తారు మీ హస్బెండ్"
    },
    {
      "t": "00:32",
      "text": "ఏం చేస్తుంటాడు"
    },
    {
      "t": "00:34",
      "text": "డ్రైవరు"
    },
    {
      "t": "00:36",
      "text": "ఎవరు నేనా"
    },
    {
      "t": "00:38",
      "text": "ఆల్బెవురు"
    },
    {
      "t": "00:40",
      "text": "హలో అండి"
    },
    {
      "t": "00:42",
      "text": "బట్"
    },
    {
      "t": "00:44",
      "text": "మీ ఏజెంట్ ఆంటీ"
    },
    {
      "t": "00:46",
      "text": "ట్వంటీ సెవెన్ నీ ఏజ్ ఎంత"
    },
    {
      "t": "00:48",
      "text": "ట్వంటీ సిక్స్"
    },
    {
      "t": "00:50",
      "text": "ఏం చేస్తావు"
    },
    {
      "t": "00:52",
      "text": "వంద"
    },
    {
      "t": "00:54",
      "text": "అది"
    },
    {
      "t": "00:56",
      "text": "బిజినెస్ ఉందండి"
    },
    {
      "t": "00:58",
      "text": "ఓకే"
    },
    {
      "t": "01:00",
      "text": "అవునా"
    },
    {
      "t": "01:02",
      "text": "అంటే లారీ డ్రైవింగ్ చేశాడా ఓన్ లారీ"
    },
    {
      "t": "01:04",
      "text": "జమ్యానస్"
    },
    {
      "t": "01:06",
      "text": "ఫేవరెట్"
    },
    {
      "t": "01:08",
      "text": "ఎక్కడ ఉంటారు మీరు"
    },
    {
      "t": "01:10",
      "text": "విజయవాడ"
    },
    {
      "t": "01:12",
      "text": "విజయవాడ"
    },
    {
      "t": "01:14",
      "text": "మాస్టర్ చదువు"
    },
    {
      "t": "01:16",
      "text": "చెప్పండి ఎంత అవుతుందో"
    },
    {
      "t": "01:18",
      "text": "అచ్చా"
    },
    {
      "t": "01:20",
      "text": "ఎవరైనా ఉన్నారా తెలిసినవాళ్ళు"
    },
    {
      "t": "01:22",
      "text": "ఉన్నారు"
    },
    {
      "t": "01:24",
      "text": "ఆ"
    },
    {
      "t": "01:26",
      "text": "మీరు ఒక్కరే వస్తారా మీ ఆయనతో వస్తారా"
    },
    {
      "t": "01:28",
      "text": "నేనే వస్తా"
    },
    {
      "t": "01:30",
      "text": "అప్పుడు"
    },
    {
      "t": "01:32",
      "text": "పిల్లలు ఉన్నారా మీకు"
    },
    {
      "t": "01:34",
      "text": "ఉన్నారు ఇద్దరు అమ్మాయిలు"
    },
    {
      "t": "01:36",
      "text": "ఎప్పుడైంది మీకు మ్యారేజ్"
    },
    {
      "t": "01:38",
      "text": "ఫైవ్"
    },
    {
      "t": "01:40",
      "text": "ప్లస్ అవుతుంది"
    },
    {
      "t": "01:42",
      "text": "ఇయర్స్"
    },
    {
      "t": "01:44",
      "text": "కలవడానికి వీలవుతుందా మిమ్మల్ని"
    },
    {
      "t": "01:46",
      "text": "కలుద్దాం వచ్చి"
    },
    {
      "t": "01:48",
      "text": "ఓకే"
    },
    {
      "t": "01:50",
      "text": "ఎలా ఉంటారు మీరు చూడ్డానికి"
    },
    {
      "t": "01:52",
      "text": "ఓకే"
    },
    {
      "t": "01:54",
      "text": "బాగానే ఉంటుంది"
    },
    {
      "t": "01:56",
      "text": "వైట్గా ఉంటారు"
    },
    {
      "t": "01:58",
      "text": "కదా"
    },
    {
      "t": "02:00",
      "text": "పక్కా ఉంటారు"
    },
    {
      "t": "02:02",
      "text": "లవ్గా ఉంటారు"
    },
    {
      "t": "02:04",
      "text": "మేడం"
    },
    {
      "t": "02:06",
      "text": "ఎప్పుడైనా"
    },
    {
      "t": "02:08",
      "text": "సార్"
    },
    {
      "t": "02:10",
      "text": "ఆ"
    },
    {
      "t": "02:12",
      "text": "వాట్సాప్"
    },
    {
      "t": "02:14",
      "text": "సార్"
    },
    {
      "t": "02:16",
      "text": "చూపిస్తారా"
    },
    {
      "t": "02:18",
      "text": "చేస్తావా"
    },
    {
      "t": "02:20",
      "text": "ఆ చెస్"
    },
    {
      "t": "02:22",
      "text": "చూపిస్తున్న"
    },
    {
      "t": "02:24",
      "text": "ఓకే"
    },
    {
      "t": "02:26",
      "text": "ఊహిస్తాను"
    },
    {
      "t": "02:28",
      "text": "సరే అంటున్నా"
    },
    {
      "t": "02:30",
      "text": "చూపిస్తావా"
    },
    {
      "t": "02:32",
      "text": "తక్కువ చేసి ఫోన్పే చెయ్యి మాట్లాడదాం"
    },
    {
      "t": "02:34",
      "text": "వీడియో కాల్"
    },
    {
      "t": "02:36",
      "text": "అర్థం కాలేదు"
    },
    {
      "t": "02:38",
      "text": "వీడియో కాల్"
    },
    {
      "t": "02:40",
      "text": "ఫోన్పే చేసి వీడియో కాల్ చేయి"
    },
    {
      "t": "02:42",
      "text": "సార్"
    },
    {
      "t": "02:44",
      "text": "ఫస్టే వెయ్యాలా పేమెంటు"
    },
    {
      "t": "02:46",
      "text": "ఆ"
    },
    {
      "t": "02:48",
      "text": "ఫస్ట్ అంటే"
    },
    {
      "t": "02:50",
      "text": "ఉండే రాజేంద్ర చౌహాన్"
    },
    {
      "t": "02:52",
      "text": "ఓకే"
    },
    {
      "t": "02:54",
      "text": "చూపించిన తర్వాత ఎవరైనా ఇస్తారా"
    },
    {
      "t": "02:56",
      "text": "రమ్మందే చేస్తారు"
    },
    {
      "t": "02:58",
      "text": "ఓకే"
    },
    {
      "t": "03:00",
      "text": "సరే పైన పైన ఐపో వోల్టోహాచ్"
    },
    {
      "t": "03:02",
      "text": "ఎక్కువగా"
    },
    {
      "t": "03:04",
      "text": "పోతుంటే పేమెంట్ చేస్తారు సగం పేమెంట్"
    },
    {
      "t": "03:06",
      "text": "ఎంత ఫస్ట్ అలా ఉన్నారు"
    },
    {
      "t": "03:08",
      "text": "ఫస్ట్ చేశాక సగం చేశాక"
    },
    {
      "t": "03:10",
      "text": "మొదలు పెడతా"
    },
    {
      "t": "03:12",
      "text": "ఎంత"
    },
    {
      "t": "03:14",
      "text": "ఫోర్ హండ్రెడ్"
    },
    {
      "t": "03:16",
      "text": "ఓరా"
    },
    {
      "t": "03:18",
      "text": "ఆ"
    },
    {
      "t": "03:20",
      "text": "నేను టూ హండ్రెడ్ ఇస్తా"
    },
    {
      "t": "03:22",
      "text": "నీకు ఓకే అనుకుంటే వీడియో కాల్"
    },
    {
      "t": "03:24",
      "text": "చేసి పైన టాప్ ఓపెన్ చేయ ఫస్ట్"
    },
    {
      "t": "03:26",
      "text": "ఓకే"
    },
    {
      "t": "03:28",
      "text": "ఫస్ట్ చూపి చేశాక చూపిస్తాను"
    },
    {
      "t": "03:30",
      "text": "సార్"
    },
    {
      "t": "03:32",
      "text": "లేదు నీ ఇష్టం నాకు"
    },
    {
      "t": "03:34",
      "text": "అట్లా చాలా మంది"
    },
    {
      "t": "03:36",
      "text": "చేయకుండా ఎవరు చూపియరు ఫస్ట్"
    },
    {
      "t": "03:38",
      "text": "చాలా మంది చెప్పారు అట్లా"
    },
    {
      "t": "03:40",
      "text": "ఓకే"
    },
    {
      "t": "03:42",
      "text": "చేయకుండా ఎవరు చూపిర్రు"
    },
    {
      "t": "03:44",
      "text": "మీకు ఓకే అంటే చెప్పండి"
    },
    {
      "t": "03:46",
      "text": "టాప్లో చూపించండి పైన చూపించండి తర్వాత"
    },
    {
      "t": "03:48",
      "text": "కిందికి అమౌంట్ వేస్తాను ఏదైనా"
    },
    {
      "t": "03:50",
      "text": "సరే అటు ఏ జాగ"
    },
    {
      "t": "03:52",
      "text": "చూపిస్తారు"
    },
    {
      "t": "03:54",
      "text": "లోపల బ్రా వేసుకున్నారా"
    },
    {
      "t": "03:56",
      "text": "ఆ"
    },
    {
      "t": "03:58",
      "text": "ఓకే"
    },
    {
      "t": "04:00",
      "text": "నైటీయా లేకపోతే సారీయా"
    },
    {
      "t": "04:02",
      "text": "సార్"
    },
    {
      "t": "04:04",
      "text": "సరే"
    },
    {
      "t": "04:06",
      "text": "జాకిల్ చేయండి బ్రా ఉంటది కదా"
    },
    {
      "t": "04:08",
      "text": "అప్పుడే ఇస్తాను"
    },
    {
      "t": "04:10",
      "text": "అలా ఉండదండి చేశాక నీకు"
    },
    {
      "t": "04:12",
      "text": "ఇంకేం కావాలంటే అది ఇప్పిస్తాను"
    },
    {
      "t": "04:14",
      "text": "యా ఇట్లా నేను చూపించమని అడుగుతున్నాను"
    },
    {
      "t": "04:16",
      "text": "తాగట్లేదు కదా జాకెట్ తీయండి మెల్లిగా"
    },
    {
      "t": "04:18",
      "text": "ఆ"
    },
    {
      "t": "04:20",
      "text": "అన్నీ తీస్తాను మొత్తం"
    },
    {
      "t": "04:22",
      "text": "మీకు అర్థమవుతుందా"
    },
    {
      "t": "04:24",
      "text": "జాకెట్ తీయండి బ్రౌన్ అని అంటారు"
    },
    {
      "t": "04:26",
      "text": "అట్లనే"
    },
    {
      "t": "04:28",
      "text": "ఆ"
    },
    {
      "t": "04:30",
      "text": "ఓకేనా"
    },
    {
      "t": "04:32",
      "text": "అప్పుడు నాకు నమ్మకం వస్తోంది కదా మీరు కూడా ఓపెన్ చేస్తే"
    },
    {
      "t": "04:34",
      "text": "సరే అండి"
    },
    {
      "t": "04:36",
      "text": "పే చేయకుండా ఏది చూపించను"
    },
    {
      "t": "04:38",
      "text": "వేస్ట్ అన్నారు"
    },
    {
      "t": "04:40",
      "text": "సరే"
    },
    {
      "t": "04:42",
      "text": "నలుగురు చేశారు మోసం"
    },
    {
      "t": "04:44",
      "text": "ఈ మేజిస్ట్రేట్"
    },
    {
      "t": "04:46",
      "text": "అంటున్నా నేను"
    },
    {
      "t": "04:48",
      "text": "చేస్తా చేస్తా అంటే"
    },
    {
      "t": "04:50",
      "text": "చెప్పండి నెంబర్ తీసుకుంటాను"
    },
    {
      "t": "04:52",
      "text": "ఫస్ట్ చేసాకే"
    },
    {
      "t": "04:54",
      "text": "అవును"
    },
    {
      "t": "04:56",
      "text": "నేనేమంటున్నా"
    },
    {
      "t": "04:58",
      "text": "పైన జాగి త్రీ అండి"
    },
    {
      "t": "05:00",
      "text": "లోపల బ్రా ఉంటుంది కదా"
    },
    {
      "t": "05:02",
      "text": "ఓకే"
    },
    {
      "t": "05:04",
      "text": "అన్నీ"
    },
    {
      "t": "05:06",
      "text": "ఒకేసారి చూపిస్తూ ఉంటుంది"
    },
    {
      "t": "05:08",
      "text": "యా మీ ఇష్టం"
    },
    {
      "t": "05:10",
      "text": "వన్ డే మీ నమ్మకంలో ఎక్కువ తగ్గుతుంది"
    },
    {
      "t": "05:12",
      "text": "ఓకే"
    },
    {
      "t": "05:14",
      "text": "సరే"
    },
    {
      "t": "05:16",
      "text": "ఫోర్"
