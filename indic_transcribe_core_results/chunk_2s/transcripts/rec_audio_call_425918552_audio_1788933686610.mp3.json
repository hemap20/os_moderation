  "segments": [
    {
      "t": "00:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "ஹலோ"
    },
    {
      "t": "00:04",
      "text": "ஓகே"
    },
    {
      "t": "00:06",
      "text": "ம்"
    },
    {
      "t": "00:08",
      "text": "ஹலோ"
    },
    {
      "t": "00:10",
      "text": "ஹலோ ஹலோ கேட்குறீங்களா"
    },
    {
      "t": "00:12",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "00:14",
      "text": "ஆ கேட்குதுங்க நீங்கள்"
    },
    {
      "t": "00:16",
      "text": "ஸோ என்னங்க"
    },
    {
      "t": "00:18",
      "text": "ஆ கேட்குது கேட்குது"
    },
    {
      "t": "00:20",
      "text": "சில"
    },
    {
      "t": "00:22",
      "text": "இது நேற்று தான் இந்த ஆப் இது பண்ணிணேன்"
    },
    {
      "t": "00:24",
      "text": "ஓகே"
    },
    {
      "t": "00:26",
      "text": "ரெண்டு மூணு கால் இந்த மாதிரி அனுப்பிச்சா நான்"
    },
    {
      "t": "00:28",
      "text": "யாரும் பேசலை ஒருத்தங்க பேசணும்னா அப்புறம்"
    },
    {
      "t": "00:30",
      "text": "ரெண்டு செகண்ட் ஏதோ பேசுகிற மாதிரி சவுண்டு கேட்டுச்சு அப்புறம்"
    },
    {
      "t": "00:32",
      "text": "கட் ஆகிடுது"
    },
    {
      "t": "00:34",
      "text": "நான் ரெஸ்பான்ஸ் பண்ணுறேன்"
    },
    {
      "t": "00:36",
      "text": "நீங்கள் தான் ஃபர்ஸ்ட் டைமாக அது பேசுகிறீங்க"
    },
    {
      "t": "00:38",
      "text": "ஓகே"
    },
    {
      "t": "00:40",
      "text": "சரிங்க"
    },
    {
      "t": "00:42",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "00:44",
      "text": "எங்கேருந்து பேசுகிறீங்க"
    },
    {
      "t": "00:46",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:48",
      "text": "ஹலோ எங்களுக்கு"
    },
    {
      "t": "00:50",
      "text": "என்ன மேம்"
    },
    {
      "t": "00:52",
      "text": "ஃபர்ஸ்ட் டைம் பேசுறீங்க"
    },
    {
      "t": "00:54",
      "text": "ஓகே"
    },
    {
      "t": "00:56",
      "text": "எங்கிருந்து பேசுகிறீங்க"
    },
    {
      "t": "00:58",
      "text": "ஈரோடுங்க"
    },
    {
      "t": "01:00",
      "text": "ஈரோடா உண்மையை சொல்லுங்கள்"
    },
    {
      "t": "01:02",
      "text": "ஆமாங்க ஈரோடு தாங்க"
    },
    {
      "t": "01:04",
      "text": "ஜென்யூன்"
    },
    {
      "t": "01:06",
      "text": "ஞானப்பிரசன்னா நம்பலாமா உங்களை"
    },
    {
      "t": "01:08",
      "text": "ஏங்க இப்படி கேட்குறீங்க நான் இப்போ தான் இந்த ஆப்"
    },
    {
      "t": "01:10",
      "text": "பேத்தி எப்படி என்னன்னு தெரியல கேட்கலாம் ஜென்யூன்"
    },
    {
      "t": "01:12",
      "text": "என்னாச்சு ஏன்னா எனக்கு"
    },
    {
      "t": "01:14",
      "text": "ஈரோட்டில் ஒரு ஆள் தேவைப்படுது அதான்"
    },
    {
      "t": "01:16",
      "text": "ஃப்ரெண்ட் பண்ணிக்கலாமே அப்படின்ட்டு தான்"
    },
    {
      "t": "01:18",
      "text": "புரியல ஃப்ரெண்டு பண்ணிக்கிறேன்"
    },
    {
      "t": "01:20",
      "text": "இந்த ஆப்பை வச்சுட்டு எப்படி யூஸ் பண்ணுறது"
    },
    {
      "t": "01:22",
      "text": "எனக்கு தெரியலைங்க அவங்க ஃபர்ஸ்ட் அது கேட்க டவுட்டு"
    },
    {
      "t": "01:24",
      "text": "கிளியர்"
    },
    {
      "t": "01:26",
      "text": "சரி தான் இதே மாதிரி கால் பண்ணிகிட்டே இருங்க"
    },
    {
      "t": "01:28",
      "text": "சேர்ந்துங்களான்னா ஒவ்வொருத்தராக ஒவ்வொருத்தராக உங்கள் காலை"
    },
    {
      "t": "01:30",
      "text": "மட்டன் பண்ணி பேசுவாங்க எல்லாம் பொண்ணுங்க தான் பேசுவாங்க"
    },
    {
      "t": "01:32",
      "text": "சரி சரிங்க"
    },
    {
      "t": "01:34",
      "text": "எப்படி வேணாலும் பேசலாம்"
    },
    {
      "t": "01:36",
      "text": "நீங்கள் விருப்பப்பட்டால் நீங்கள்"
    },
    {
      "t": "01:38",
      "text": "பேசலாம் ஆக்சுவலி நீங்கள் கேட்ட"
    },
    {
      "t": "01:40",
      "text": "அவங்க விருப்பப்பட்டால் பேசலாம்"
    },
    {
      "t": "01:42",
      "text": "என்ன வேணாலும் பேசலாம்"
    },
    {
      "t": "01:44",
      "text": "இருக்கலாம் சிக்ஸியா"
    },
    {
      "t": "01:46",
      "text": "ஃபீலிங்ஸை ஷேர் பண்ணுறது"
    },
    {
      "t": "01:48",
      "text": "பர்ஸ்னல் ஷேர் பண்ணுறது ஃப்ரெண்ட்லியாக"
    },
    {
      "t": "01:50",
      "text": "ஜாலியா"
    },
    {
      "t": "01:52",
      "text": "ஓஹோ"
    },
    {
      "t": "01:54",
      "text": "ம் ம் ம்"
    },
    {
      "t": "01:56",
      "text": "என்னங்க"
    },
    {
      "t": "01:58",
      "text": "எல்லாமே ஷேர் பண்ணி"
    },
    {
      "t": "02:00",
      "text": "அப்புறமா வீடியோ"
    },
    {
      "t": "02:02",
      "text": "வீடியோ காட்டுறேன் வாட்ஸ்அப் கால் பண்ணுறீங்களா"
    },
    {
      "t": "02:04",
      "text": "அப்படின்னு கேட்பாங்க நம்பிடாதீங்க"
    },
    {
      "t": "02:06",
      "text": "காட்டுறவன் சொல்லுவாங்க உடம்ப"
    },
    {
      "t": "02:08",
      "text": "அப்புறம் கட் பண்ணிவிடுவாங்க காசை போட்டு"
    },
    {
      "t": "02:10",
      "text": "பண்ணிக்கிடுவாங்க ஏமாந்துறாதீங்க"
    },
    {
      "t": "02:12",
      "text": "ஜெனியூனாக இருந்தால்"
    },
    {
      "t": "02:14",
      "text": "ஓகே உங்களுக்கு விருப்பப்பட்டு நீங்கள் பார்க்கலாம்"
    },
    {
      "t": "02:16",
      "text": "பார்க்கணுன்னு ஆசையாக இருந்தால் ஓகே"
    },
    {
      "t": "02:18",
      "text": "எனக்கு தெரிஞ்சு வேஸ்ட்டுன்னு நினைக்கிறேன்"
    },
    {
      "t": "02:20",
      "text": "ம்"
    },
    {
      "t": "02:22",
      "text": "ஹலோ இருக்கே"
    },
    {
      "t": "02:24",
      "text": "ம் ஆ"
