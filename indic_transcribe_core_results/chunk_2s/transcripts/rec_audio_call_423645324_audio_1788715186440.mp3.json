      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:04",
      "text": "ஹலோ"
    },
    {
      "t": "00:06",
      "text": "ஹலோ ஆ"
    },
    {
      "t": "00:08",
      "text": "ஹலோ"
    },
    {
      "t": "00:10",
      "text": "இருக்குது"
    },
    {
      "t": "00:12",
      "text": "எங்கேருந்து பேசுகிறீங்க"
    },
    {
      "t": "00:14",
      "text": "எங்கே இருக்கீங்க வீட்டில் இருக்கீங்க"
    },
    {
      "t": "00:16",
      "text": "விளையாடுகின்றோம்"
    },
    {
      "t": "00:18",
      "text": "வீட்டில் தான் இருக்கேன்"
    },
    {
      "t": "00:20",
      "text": "நீங்கள்"
    },
    {
      "t": "00:22",
      "text": "தாபியோக்கு"
    },
    {
      "t": "00:24",
      "text": "அப்படியா"
    },
    {
      "t": "00:26",
      "text": "புரியல"
    },
    {
      "t": "00:28",
      "text": "நீங்கள் எங்கே இருக்கீங்க"
    },
    {
      "t": "00:30",
      "text": "செலகோணத்தில்"
    },
    {
      "t": "00:32",
      "text": "ஆ"
    },
    {
      "t": "00:34",
      "text": "எங்கே"
    },
    {
      "t": "00:36",
      "text": "சரிங்க"
    },
    {
      "t": "00:38",
      "text": "இல்லை எங்கள் ஏரியா என்னது"
    },
    {
      "t": "00:40",
      "text": "ம்"
    },
    {
      "t": "00:42",
      "text": "சொல்லுங்க எனக்கு எதுவும் கிளியரா கிளியரா"
    },
    {
      "t": "00:44",
      "text": "நீங்கள்"
    },
    {
      "t": "00:46",
      "text": "பேசுறது தான் கேட்கல கிளியரா ஹெட்ஃபோன்"
    },
    {
      "t": "00:48",
      "text": "வந்து கழட்டினீங்கன்னா நல்லா கேட்கும்"
    },
    {
      "t": "00:50",
      "text": "ம்"
    },
    {
      "t": "00:52",
      "text": "ஆ"
    },
    {
      "t": "00:54",
      "text": "ஹலோ ம்"
    },
    {
      "t": "00:56",
      "text": "சொல்லுங்கள் எங்கேருந்து பேசுகிறீங்க"
    },
    {
      "t": "00:58",
      "text": "ஹலோ கேட்குதே"
    },
    {
      "t": "01:00",
      "text": "சொல்லுங்க எங்கே இருந்து பேசுறீங்க"
    },
    {
      "t": "01:02",
      "text": "நான் கொஞ்சம்"
    },
    {
      "t": "01:04",
      "text": "சொன்னீங்க"
    },
    {
      "t": "01:06",
      "text": "சரிங்க"
    },
    {
      "t": "01:08",
      "text": "உங்கள் நேம் என்ன"
    },
    {
      "t": "01:10",
      "text": "வினோத்"
    },
    {
      "t": "01:12",
      "text": "ஆல்ரெடி நம்ம பேசுனோம்ல"
    },
    {
      "t": "01:14",
      "text": "ம் ஆல்ரெடி"
    },
    {
      "t": "01:16",
      "text": "பேசியிருக்கோம்ல நம்ம இல்லையா"
    },
    {
      "t": "01:18",
      "text": "ஆ"
    },
    {
      "t": "01:20",
      "text": "அவரோட நேம் பவித்ரா"
    },
    {
      "t": "01:22",
      "text": "அதான் அட்லீஸ்ட் நம்மள ஒரு டைம்"
    },
    {
      "t": "01:24",
      "text": "ஆ"
    },
    {
      "t": "01:26",
      "text": "சரிங்க சார்"
    },
    {
      "t": "01:28",
      "text": "ஐடி கூட சொன்னீங்களே நீங்கள்"
    },
    {
      "t": "01:30",
      "text": "ம்"
    },
    {
      "t": "01:32",
      "text": "ம் அதான் ஐடி கூட ஒரு டைம் சொன்னீங்கள்ல"
    },
    {
      "t": "01:34",
      "text": "லைன்ஸ் தான் எழுதினேக்கி"
    },
    {
      "t": "01:36",
      "text": "என்ன பண்ணுறீங்க"
    },
    {
      "t": "01:38",
      "text": "சரிங்க சார்"
    },
    {
      "t": "01:40",
      "text": "ஆ சும்மா தான் இருக்கேன்"
    },
    {
      "t": "01:42",
      "text": "நீங்கள்"
    },
    {
      "t": "01:44",
      "text": "பார்க்குறீங்களா என்ன"
    },
    {
      "t": "01:46",
      "text": "சரிங்க சார்"
    },
    {
      "t": "01:48",
      "text": "என்னது"
    },
    {
      "t": "01:50",
      "text": "அது"
    },
    {
      "t": "01:52",
      "text": "ஹலோ கீதா"
    },
    {
      "t": "01:54",
      "text": "கேட்குது சொல்லுங்கள் சொல்லுங்கள்"
    },
    {
      "t": "01:56",
      "text": "ம்"
    },
    {
      "t": "01:58",
      "text": "சாப்பிட்டிங்களா"
    },
    {
      "t": "02:00",
      "text": "என்ன பேசுறீங்கன்னா"
    },
    {
      "t": "02:02",
      "text": "எங்கே இருக்கீங்கன்னு ஒழுங்காக பேசுங்க சாப்பிட்டீங்களா"
    },
    {
      "t": "02:04",
      "text": "இப்போ வந்து நான் வந்து உனக்கு என்ன பேசலாம்"
    },
    {
      "t": "02:06",
      "text": "ஆ"
    },
    {
      "t": "02:08",
      "text": "செக்ஸியாக பேசலாமா"
    },
    {
      "t": "02:10",
      "text": "ம்"
    },
    {
      "t": "02:12",
      "text": "சரி சரிங்க"
    },
    {
      "t": "02:14",
      "text": "சிக்ஸியா பேசலாமா"
    },
    {
      "t": "02:16",
      "text": "ஆ"
    },
    {
      "t": "02:18",
      "text": "நான் காலேஜ் முடிச்சிருக்கேன்"
    },
    {
      "t": "02:20",
      "text": "சரிங்க சார்"
    },
    {
      "t": "02:22",
      "text": "சரி இப்போ வந்தால் வண்டி ஓவர் பண்ணலாம்"
    },
    {
      "t": "02:24",
      "text": "அவங்க கூட என்ஜாய் பண்ணலாமா"
    },
