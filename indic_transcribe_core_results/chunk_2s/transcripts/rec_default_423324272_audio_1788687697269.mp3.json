  "segments": [
    {
      "t": "00:00",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:06",
      "text": "ಹಾಯ್"
    },
    {
      "t": "00:08",
      "text": "ಎಲ್ಲಿಂದ"
    },
    {
      "t": "00:10",
      "text": "ಮೈಸೂರು"
    },
    {
      "t": "00:12",
      "text": "ಅದೇ ನಿನ್ನೆ ಅಷ್ಟೇ ಆಯಿತು"
    },
    {
      "t": "00:14",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:16",
      "text": "ಯಾವಾಗಿಂದ ಯೂಸ್"
    },
    {
      "t": "00:18",
      "text": "ಮಾಡ್ತಿದ್ದೀರಾ"
    },
    {
      "t": "00:20",
      "text": "ನೀವು ಈಗ ಅದು ಹಾಕ್ತೀರಾ"
    },
    {
      "t": "00:22",
      "text": "ಈಗ"
    },
    {
      "t": "00:24",
      "text": "ಏನು ಪರ್ಪಸ್ ಕ್ಯೂ"
    },
    {
      "t": "00:26",
      "text": "ಸ್ಮಾರ್ಟ್ ಟಿವಿ"
    },
    {
      "t": "00:28",
      "text": "ಸುಮ್ಮನೆ"
    },
    {
      "t": "00:30",
      "text": "ಗರ್ಲ್ ಫ್ರೆಂಡ್ ಇದ್ದಾರಾ"
    },
    {
      "t": "00:32",
      "text": "ಯಾರು ಇಲ್ಲ"
    },
    {
      "t": "00:34",
      "text": "ಊಟ ಮಾಡ್ತೀವಿ"
    },
    {
      "t": "00:36",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:38",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:40",
      "text": "ನಿಮ್ಮದು"
    },
    {
      "t": "00:42",
      "text": "ಆಯ್ತು ತಗೋ"
    },
    {
      "t": "00:44",
      "text": "ಸಿಂಗಲ್"
    },
    {
      "t": "00:46",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:48",
      "text": "ಓಕೆ ಓಕೆ"
    },
    {
      "t": "00:50",
      "text": "ಬೇರೆ ಯಾರ ಜೊತೆನೂ ಮಾತಾಡೇ ಇಲ್ಲ"
    },
    {
      "t": "00:52",
      "text": "ಒಣಗುವ ಹಾಗಲ್ಲಿ"
    },
    {
      "t": "00:54",
      "text": "ಇಲ್ಲ ಇದೇ ಪ್ರೆಸ್ ಮಾಡಿದ್ದೀಗ"
    },
    {
      "t": "00:56",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:58",
      "text": "ಓಕೆ"
    },
    {
      "t": "01:00",
      "text": "ಏನು ಪರ್"
    },
    {
      "t": "01:02",
      "text": "ಫಸ್ಟ್ ಕೇಳಿ ನೀವು ಯೂಸ್ ಮಾಡ್ತಿರೋದು"
    },
    {
      "t": "01:04",
      "text": "ಸುಮ್ಮನೆ ಫೇಸ್ಬುಕ್ಕಲ್ಲಿ"
    },
    {
      "t": "01:06",
      "text": "ಬರ್ತಿತ್ತಲ್ಲ ಅಂದ್ಬಿಟ್ಟು ಮಾಡ್ದೆ ಯಾವ ಥರ ಏನಂತ ನೋಡೋಣ"
    },
    {
      "t": "01:08",
      "text": "ಓಕೆ"
    },
    {
      "t": "01:10",
      "text": "ಈ ಹ್ಯಾಪಿಲಿ ಫಿಸಿಕಲ್ ರಿಲೇಶನ್ಶಿಪ್"
    },
    {
      "t": "01:12",
      "text": "ಇರ್ತಾರೆ ಫ್ರೆಂಡ್ಸ್ ಇರ್ತಾರೆ"
    },
    {
      "t": "01:14",
      "text": "ಸೊ ಮೀಟು ಮಾಡ್ತಾರಾ"
    },
    {
      "t": "01:16",
      "text": "ಹಾಂ ಹಾಂ ಹಾಂ"
    },
    {
      "t": "01:18",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:20",
      "text": "ಫ್ರೆಂಡ್ ಐತೆ ರೀ"
    },
    {
      "t": "01:22",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:24",
      "text": "ಫ್ರೆಂಡು"
    },
    {
      "t": "01:26",
      "text": "ಯಾ ಐ ಆಮ್ ಗುಡ್ ಫ್ರೆಂಡ್"
    },
    {
      "t": "01:28",
      "text": "ಎಂಟು"
    },
    {
      "t": "01:30",
      "text": "ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "01:32",
      "text": "ಊಟ"
    },
    {
      "t": "01:34",
      "text": "ಆಯಿತು ಯಾಕೆ ಇನ್ನು ಲೇಟಾಗಿ ಮಾಡಿ"
    },
    {
      "t": "01:36",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:38",
      "text": "ಹಾಂ ಲೇಟ್ ಆಯಿತು ಇವತ್ತು"
    },
    {
      "t": "01:40",
      "text": "ಓಕೆ ಪೇಂಟ್ ಪೇಂಟ್ ಇತ್ತು"
    },
    {
      "t": "01:42",
      "text": "ಸ್ಪೆಷಲ್ ಆಗಿ"
    },
    {
      "t": "01:44",
      "text": "ಏನೇನು ಬರೀ ರೈತ"
    },
    {
      "t": "01:46",
      "text": "ಮೈಸೂರು ಮೊಸರು"
    },
    {
      "t": "01:48",
      "text": "ಬಿರಿಯಾನಿ ತಿನ್ನೋಕ್ಕಾ ನಾ ಸಂಡೇ"
    },
    {
      "t": "01:50",
      "text": "ಇವತ್ತು ಅಯ್ಯೋ ಮನೆಲಿ"
    },
    {
      "t": "01:52",
      "text": "ಯಾರೂ ಇಲ್ಲ"
    },
    {
      "t": "01:54",
      "text": "ಇನ್ನೊಂದು ಈ ಥರ"
    },
    {
      "t": "01:56",
      "text": "ಮೂರು"
    },
    {
      "t": "01:58",
      "text": "ಹಿಂಗೆ ಊರು ಊರು"
    },
    {
      "t": "02:00",
      "text": "ಓಕೆ"
    },
    {
      "t": "02:02",
      "text": "ನಿಮಗೆ ಅವಕಾಶ ಸಿಗುತ್ತೆ"
    },
    {
      "t": "02:04",
      "text": "ಬೆಂಗ್ಳೂರ್"
    },
    {
      "t": "02:06",
      "text": "ವರ್ಕ"
    },
    {
      "t": "02:08",
      "text": "ಬರ್ಕೊ ಹೇಗೂ ಸಿಗಲ್ಲ"
    },
    {
      "t": "02:10",
      "text": "ಎಲ್ಲರೂ ವರ್ಕ್ ಮಾಡ್ತೀನಿ"
    },
    {
      "t": "02:12",
      "text": "ಹ್ಞೂ ಹ್ಞೂ ಮದುವೆ ಆಗಿಲ್ಲ"
    },
    {
      "t": "02:14",
      "text": "ಇನ್ನೂ ಇಲ್ಲ"
    },
    {
      "t": "02:16",
      "text": "ಆಯ್ತರಾ"
    },
    {
      "t": "02:18",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:20",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:22",
      "text": "ಆಂ"
    },
    {
      "t": "02:24",
      "text": "ಈಗಲೇ ಬೇಡಪ್ಪ ಮಟ್ರೇ"
    },
    {
      "t": "02:26",
      "text": "ಎಲ್ಲಾ ಓಕೆ ಈಗ ಚೆನ್ನಾಗಿ"
    },
    {
      "t": "02:28",
      "text": "ಹಾಗೆ ಮಾತಾಡ್ತೀರಾ ಆಮೇಲೆ ಆಮೇಲೆ ಚೇಂಜ್"
    },
    {
      "t": "02:30",
      "text": "ಆಗ್ಬಿಡ್ತೀರಾ ಟೈಮ್ ಕೂಡ ಕೊಡಲ್ಲ ಅನ್ಸುತ್ತೆ"
    },
    {
      "t": "02:32",
      "text": "ಓಕೆ"
    },
    {
      "t": "02:34",
      "text": "ಆ ಥರ ಏನಿಲ್ಲ"
    },
    {
      "t": "02:36",
      "text": "ಹಂಗಂತ ಎಲ್ಲರೂ ಹೇಳ್ತಾರೆ"
    },
    {
      "t": "02:38",
      "text": "ಫಿಲ್ ಹಂಗೆ ಮಾಡೋದು"
    },
    {
      "t": "02:40",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:42",
      "text": "ಚೆನ್ನಾಗಿದೆ"
    },
    {
      "t": "02:44",
      "text": "ಏನು ವೈದ್ಯ"
    },
    {
      "t": "02:46",
      "text": "ಸಹಿತ ಬಿಝಿ ಆಯ್ತಾರೆ"
    },
    {
      "t": "02:48",
      "text": "ಹಾಂ ಹಾಂ"
    },
    {
      "t": "02:50",
      "text": "ಸೊ ಒಂದು"
    },
    {
      "t": "02:52",
      "text": "ನಮಗೂ ಅಂತ ಟೈಮ್ ಕೊಡೋರಾಗಿರ್ತಾರೆ"
    },
    {
      "t": "02:54",
      "text": "ಬಟ್ ಒಳ್ಳೆ ಫ್ರೆಂಡ್ ಆಗಿರಬೇಕು"
    },
    {
      "t": "02:56",
      "text": "ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "02:58",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:00",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "03:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:04",
      "text": "ಊಟ ಮಾಡಿ ಪಾಪ ನೀವು ಟೈಮ್ ಆಯಿತು"
    },
    {
      "t": "03:06",
      "text": "ಓ ಊಟ ಮಾಡ್ಬಿಟ್ಟು ತಾನೇ ಕಾಲ್ ಮಾಡ್ಬೇಕು"
    },
    {
      "t": "03:08",
      "text": "ಇದು"
    },
    {
      "t": "03:10",
      "text": "ಸುಮ್ಮ ಆಡಿದೆ ನೋಡೋಣ"
    },
    {
      "t": "03:12",
      "text": "ಊಟ ಮಾಡ್ತಿದ್ದೆ ನಾನು"
    },
    {
      "t": "03:14",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:16",
      "text": "ಬಟ್"
    },
    {
      "t": "03:18",
      "text": "ವೆನ್ಯೂ ಪ್ರಮಾಣ"
    },
    {
      "t": "03:20",
      "text": "ಆಯಿತು ನಂದು ಊಟ ಮಾಡಿ ಆಯಿತು"
    },
    {
      "t": "03:22",
      "text": "ಸೊ"
    },
    {
      "t": "03:24",
      "text": "ಚೆನ್ನಾಗಿ ಬಿರಿಯಾನಿ"
    },
    {
      "t": "03:26",
      "text": "ನನಗೆ ಕಬಾಬ್ ತಿನ್ನೋಕೆ ಬಿಟ್ಕೊಂಡು ಮೊಸರು"
    },
    {
      "t": "03:28",
      "text": "ತಿಂತೀರ ಅಲ್ಲ ನೀವು"
    },
    {
      "t": "03:30",
      "text": "ಅಯ್ಯೋ ನೆನ್ನೆ ಮೈಸೂರು ಬಂದಿದೆ ಮೈಸೂರು"
    },
    {
      "t": "03:32",
      "text": "ಹೆಸ್ರಲ್ಲಿ ತಿನ್ಕ ಬಂದೆ ಅದಕ್ಕೆ"
    },
    {
      "t": "03:34",
      "text": "ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "03:36",
      "text": "ಒಳ್ಳೆಯ ಬಿರಿಯಾನಿ"
    },
    {
      "t": "03:38",
      "text": "ಕಬಾಬ್ ಎಲ್ಲದಕ್ಕೆ ಇವತ್ತು ತಿನ್ನಬೇಕು"
    },
    {
      "t": "03:40",
      "text": "ಚಿಂತೆ ಇಲ್ಲ ನೀವು ಏನು"
    },
    {
      "t": "03:42",
      "text": "ವರ್ಕ್ ಮಾಡಿದ್ದು"
    },
    {
      "t": "03:44",
      "text": "ಟೈಲರಿಂಗು"
    },
    {
      "t": "03:46",
      "text": "ಹಾಂ ಹಾಂ"
    },
    {
      "t": "03:48",
      "text": "ಸ್ಟಿಚಿಂಗ್"
    },
    {
      "t": "03:50",
      "text": "ಓಕೆ ಫಾಲ್ ಕಟ್ಟಾಕಿ"
    },
    {
      "t": "03:52",
      "text": "ಆಹ್"
    },
    {
      "t": "03:54",
      "text": "ಹೌದು"
