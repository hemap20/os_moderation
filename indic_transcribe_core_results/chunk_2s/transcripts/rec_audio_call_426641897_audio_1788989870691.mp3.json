  "segments": [
    {
      "t": "00:00",
      "text": "టాప్"
    },
    {
      "t": "00:02",
      "text": "ఎక్కడ నుంచి అండి"
    },
    {
      "t": "00:04",
      "text": "హై కలర్ వచ్చింది"
    },
    {
      "t": "00:06",
      "text": "నాది హైదరాబాద్ ఎల్బీ నగర్లో రూమ్"
    },
    {
      "t": "00:08",
      "text": "తీసుకొని ఉంటున్నాను నువ్వు ఎక్కడ ఉంటావు"
    },
    {
      "t": "00:10",
      "text": "నేను వాయించబడు"
    },
    {
      "t": "00:12",
      "text": "ఏం చేస్తుంటావు"
    },
    {
      "t": "00:14",
      "text": "సాఫ్ట్వేర్ ఎంప్లాయ్ అండి మీరు"
    },
    {
      "t": "00:16",
      "text": "నేను సింగిల్ జాబ్స్"
    },
    {
      "t": "00:18",
      "text": "వీడియో కాల్ మాట్లాడతాను"
    },
    {
      "t": "00:20",
      "text": "చిన్న"
    },
    {
      "t": "00:22",
      "text": "వాట్సాప్లో"
    },
    {
      "t": "00:24",
      "text": "నువ్వు నెంబర్ ఇస్తే ఫస్ట్ వీడియో కాల్"
    },
    {
      "t": "00:26",
      "text": "చేస్తా ఎలా ఉన్నానో చూడు"
    },
    {
      "t": "00:28",
      "text": "ఇఫ్ నేను నీకు నచ్చితే"
    },
    {
      "t": "00:30",
      "text": "త్రీ హండ్రెడ్ వేస్తే స్టార్ట్ చేస్తా ఫస్ట్"
    },
    {
      "t": "00:32",
      "text": "చూడు నీకు నచ్చాలి కదా"
    },
    {
      "t": "00:34",
      "text": "ఓకే నెంబర్"
    },
    {
      "t": "00:36",
      "text": "చెప్తావా"
    },
    {
      "t": "00:38",
      "text": "ఇతర"
    },
    {
      "t": "00:40",
      "text": "డబల్ సెవెన్"
    },
    {
      "t": "00:42",
      "text": "ఎయిట్ జీరో"
    },
    {
      "t": "00:44",
      "text": "డబల్ సెవెన్ ఎయిట్ జీరో"
    },
    {
      "t": "00:46",
      "text": "టూ సిక్స్ ఫోర్"
    },
    {
      "t": "00:48",
      "text": "ఓకే"
    },
    {
      "t": "00:50",
      "text": "హలో"
    },
    {
      "t": "00:52",
      "text": "యా"
    },
    {
      "t": "00:54",
      "text": "చెప్పండి టూ సిక్స్ ఫోర్ టూ సిక్స్"
    },
    {
      "t": "00:56",
      "text": "ఫోర్"
    },
    {
      "t": "00:58",
      "text": "వన్ ఫోర్ త్రీ"
    },
    {
      "t": "01:00",
      "text": "ఓకే"
    },
    {
      "t": "01:02",
      "text": "ఆ"
    },
    {
      "t": "01:04",
      "text": "దీనికి వాట్సాప్ లేదంటుంది"
    },
    {
      "t": "01:06",
      "text": "ఓకే"
    },
    {
      "t": "01:08",
      "text": "డబల్ సెవెన్"
    },
    {
      "t": "01:10",
      "text": "వన్ మినిట్ వన్ మినిట్ వన్ మినిట్ వన్ మినిట్"
    },
    {
      "t": "01:12",
      "text": "తీసేయండి"
    },
    {
      "t": "01:14",
      "text": "ఇప్పుడు చెప్పు"
    },
    {
      "t": "01:16",
      "text": "ఇంకా"
    },
    {
      "t": "01:18",
      "text": "అరే స్లో రా బాబు"
    },
    {
      "t": "01:20",
      "text": "కోప్పడకు నాకు ఇది ఇన్వైట్ అని పడింది"
    },
    {
      "t": "01:22",
      "text": "అందుకే ఇప్పుడు చెప్పవా"
    },
    {
      "t": "01:24",
      "text": "సారీ ఏమనుకుంటున్నాను డబల్ సెవెన్ ఎయిట్ జా"
    },
    {
      "t": "01:26",
      "text": "డబల్"
    },
    {
      "t": "01:28",
      "text": "ఆ జీరో"
    },
    {
      "t": "01:30",
      "text": "అబ్బా"
    },
    {
      "t": "01:32",
      "text": "సెవెన్ టూ సిక్స్"
    },
    {
      "t": "01:34",
      "text": "ఎయిట్ జీరో"
    },
    {
      "t": "01:36",
      "text": "బాబు డబల్"
    },
    {
      "t": "01:38",
      "text": "సెవెన్ ఎయిట్ జీరో"
    },
    {
      "t": "01:40",
      "text": "ఆర్"
    },
    {
      "t": "01:42",
      "text": "టూ సిక్స్ ఫోర్ వన్ ఫోర్ త్రీ"
    },
    {
      "t": "01:44",
      "text": "ఓకే"
    },
    {
