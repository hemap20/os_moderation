    {
      "t": "05:38",
      "text": "నెంబర్ నేను అట్లా"
    },
    {
      "t": "05:40",
      "text": "అట్లా ఉండరు"
    },
    {
      "t": "05:42",
      "text": "ఫ్యామిలీ ఉంది"
    },
    {
      "t": "05:44",
