    {
      "t": "09:40",
      "text": "ఆ"
    },
    {
      "t": "09:42",
      "text": "చెప్పు"
    },
    {
      "t": "09:44",
      "text": "లేకపోతే నా నెంబర్ తీసుకో"
    },
    {
      "t": "09:46",
      "text": "చెప్తున్నాను"
