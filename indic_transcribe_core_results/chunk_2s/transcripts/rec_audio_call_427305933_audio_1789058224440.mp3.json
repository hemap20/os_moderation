    {
      "t": "10:52",
      "text": "నీదే చెప్పు"
    },
    {
      "t": "10:54",
      "text": "డబల్ నైన్ ఫోర్ నైన్"
    },
    {
      "t": "10:56",
      "text": "నైన్ ఫైవ్ ఫోర్ ఫైవ్ డబల్ నైన్ ఫోర్"
    },
    {
      "t": "10:58",
      "text": "డబల్ నైన్ ఫోర్ నైన్"
    },
    {
      "t": "11:00",
      "text": "ఫైవ్ ఫోర్ ఫైవ్ డబల్"
    },
    {
