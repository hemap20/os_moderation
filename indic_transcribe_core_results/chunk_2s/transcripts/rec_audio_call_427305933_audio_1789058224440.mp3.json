    {
      "t": "09:22",
      "text": "అదే"
    },
    {
      "t": "09:24",
      "text": "అది త్రీ టూ నైన్ ఉంటుంది"
    },
    {
      "t": "09:26",
      "text": "త్రీ టూ వన్"
    },
    {
      "t": "09:28",
      "text": "త్రీ టూ నైన్"
    },
    {
      "t": "09:30",
      "text": "అయినా"
    },
    {
      "t": "09:32",
      "text": "ఓకే"
    },
    {
      "t": "09:34",
      "text": "ఓకే"
    },
    {
      "t": "09:36",
      "text": "ఓకే"
