  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "నెక్స్ట్"
    },
    {
      "t": "00:04",
      "text": "ఆ"
    },
    {
      "t": "00:06",
      "text": "హలో"
    },
    {
      "t": "00:08",
      "text": "ఎలా అండి ఇక్కడ నుంచి"
    },
    {
      "t": "00:10",
      "text": "హైదరాబాద్లో"
    },
    {
      "t": "00:12",
      "text": "అమ్మేమే హరి"
    },
    {
      "t": "00:14",
      "text": "హైదరాబాద్ ఎక్కడ హైదరాబాద్"
    },
    {
      "t": "00:16",
      "text": "జె"
    },
    {
      "t": "00:18",
      "text": "పేజ్ పేజీ"
    },
    {
      "t": "00:20",
      "text": "బోరబండ"
    },
    {
      "t": "00:22",
      "text": "ఏం చేస్తున్నావు"
    },
    {
      "t": "00:24",
      "text": "నమస్కారం"
    },
    {
      "t": "00:26",
      "text": "ప్రెసెంట్ అయితే ఖాళీ అండి"
    },
    {
      "t": "00:28",
      "text": "మీరేం చేస్తుంటారు"
    },
    {
      "t": "00:30",
      "text": "జాబ్ చేస్తున్నాను మ్యారీడా"
    },
    {
      "t": "00:32",
      "text": "అదే"
    },
    {
      "t": "00:34",
      "text": "అవునండి మీరు సింగిల్"
    },
    {
      "t": "00:36",
      "text": "నేమ్స్ ఇందులో"
    },
    {
      "t": "00:38",
      "text": "ఇంకా హాట్ ఎఫెక్ట్ ఇక్కడ రావాలనుకుంటాను"
    },
    {
      "t": "00:40",
      "text": "మ్యారేజ్"
    },
    {
      "t": "00:42",
      "text": "ఎంజాయ్ అయిన వాళ్ళు కూడా వస్తున్నారు"
    },
    {
      "t": "00:44",
      "text": "అవుననుకుంటున్నాను"
    },
    {
      "t": "00:46",
      "text": "తీసుకుంటే"
    },
    {
      "t": "00:48",
      "text": "మీ పేరు"
    },
    {
      "t": "00:50",
      "text": "సిద్ధు"
    },
    {
      "t": "00:52",
      "text": "మీటర్ కలర్"
    },
    {
      "t": "00:54",
      "text": "ఇ"
    },
    {
      "t": "00:56",
      "text": "పక్కన సౌండ్ వస్తుంది తలలో"
    },
    {
      "t": "00:58",
      "text": "ఏం కాదు"
    },
    {
      "t": "01:00",
      "text": "ఫ్యాన్ తప్ప ఏం రావట్లేదండి"
    },
    {
      "t": "01:02",
      "text": "అదే బాగా"
    },
    {
      "t": "01:04",
      "text": "డిస్టెన్స్"
    },
    {
      "t": "01:06",
      "text": "ఆహా"
    },
    {
      "t": "01:08",
      "text": "తిన్న"
    },
    {
      "t": "01:10",
      "text": "హా"
    },
    {
      "t": "01:12",
      "text": "అల్లికార్న్ వాల్"
    },
    {
      "t": "01:14",
      "text": "అంకుల్ ఏంటి హీరో స్పెషల్"
    },
    {
      "t": "01:16",
      "text": "షెఫ్"
    },
    {
      "t": "01:18",
      "text": "ఇవి మంచి"
    },
    {
      "t": "01:20",
      "text": "చికెన్ చేసాను"
    },
    {
      "t": "01:22",
      "text": "ఆ"
    },
    {
      "t": "01:24",
      "text": "ఇంత నీ ఏజ్"
    },
    {
      "t": "01:26",
      "text": "ట్వంటీ ఫైవ్"
    },
    {
      "t": "01:28",
      "text": "ఈ"
    },
    {
      "t": "01:30",
      "text": "మైటింగ్"
    },
    {
      "t": "01:32",
      "text": "ఉం ఉం ఉం"
    },
    {
      "t": "01:34",
      "text": "ఇంకా"
    },
    {
      "t": "01:36",
      "text": "ఎత్తడం తరువాత"
    },
    {
      "t": "01:38",
      "text": "ఓపెన్ ఆంధ్రాను జాబ్ హై"
    },
    {
      "t": "01:40",
      "text": "హైదరాబాద్లో రూమ్లో ఉంటాను"
    },
    {
      "t": "01:42",
      "text": "ఆ"
    },
    {
      "t": "01:44",
      "text": "ఇంకా ఏ పని చేస్తున్నారు అండి"
    },
    {
      "t": "01:46",
      "text": "అయ్యా"
    },
    {
      "t": "01:48",
      "text": "నేను మార్నింగ్ డౌన్లోడ్ చేశాను"
    },
    {
      "t": "01:50",
      "text": "ఇంకా"
    },
    {
      "t": "01:52",
      "text": "ఇంకా లంచ్ చేసి కూర్చొని ఓపెన్ చేసాము"
    },
    {
      "t": "01:54",
      "text": "మిగతా సమయంలో"
    },
    {
      "t": "01:56",
      "text": "ఓకే"
    },
    {
      "t": "01:58",
      "text": "ఒకలా"
    },
    {
      "t": "02:00",
      "text": "మనం"
    },
    {
      "t": "02:02",
      "text": "మా చిన్న బాబు పదకొండు"
    },
    {
      "t": "02:04",
      "text": "చూడండి"
    },
    {
      "t": "02:06",
      "text": "థ్యాంక్ యూ"
    },
    {
      "t": "02:08",
      "text": "ఓకే"
    },
    {
      "t": "02:10",
      "text": "కాదు స్నాప్స్"
    },
    {
      "t": "02:12",
      "text": "స్క్రాప్లో ఉన్నారా"
    },
    {
      "t": "02:14",
      "text": "లేదండి నేనేమి యూస్ చేయను"
