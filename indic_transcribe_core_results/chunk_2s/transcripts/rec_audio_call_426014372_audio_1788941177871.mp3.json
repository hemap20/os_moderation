    {
      "t": "02:58",
      "text": "అవును"
    },
    {
      "t": "03:00",
      "text": "ఏం లేదు"
    },
    {
      "t": "03:02",
      "text": "మొత్తం లైట్గా అలా ఫీలింగ్స్ వస్తున్నాయి"
    },
    {
      "t": "03:04",
      "text": "సరే"
    },
    {
      "t": "03:06",
      "text": "అవును"
    },
    {
      "t": "03:08",
      "text": "ఓకే"
    },
    {
      "t": "03:10",
      "text": "తాతయ్య స్కూల్ వాళ్ళు"
