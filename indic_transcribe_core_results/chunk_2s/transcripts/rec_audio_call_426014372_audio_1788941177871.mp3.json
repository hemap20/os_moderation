    {
      "t": "02:16",
      "text": "సరే"
    },
    {
      "t": "02:18",
      "text": "ఓకే నాకు"
    },
    {
      "t": "02:20",
      "text": "వెళ్తున్నాను బెడ్ మీద దొర్లుతున్నాను"
    },
    {
      "t": "02:22",
      "text": "అవును"
    },
    {
      "t": "02:24",
      "text": "ఓకే"
    },
    {
      "t": "02:26",
      "text": "ఓకే"
    },
    {
      "t": "02:28",
      "text": "ఏం డ్రెస్ వేసుకున్నావు"
    },
    {
      "t": "02:30",
      "text": "ఓకే"
    },
    {
      "t": "02:32",
      "text": "ఏం"
    },
    {
      "t": "02:34",
      "text": "డ్రెస్ అంటే డ్రెస్సే వేసుకుంటాము"
    },
    {
      "t": "02:36",
      "text": "టాప్"
    },
    {
      "t": "02:38",
      "text": "లైక్ దిస్"
    },
    {
      "t": "02:40",
      "text": "పెంగమా"
    },
    {
      "t": "02:42",
      "text": "మాట్లాడవచ్చా"
    },
    {
      "t": "02:44",
      "text": "అబ్బాయిలే నాకు ఇంట్రెస్ట్ లేదు"
