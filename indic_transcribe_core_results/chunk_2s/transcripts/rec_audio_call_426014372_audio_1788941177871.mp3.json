      "text": "నేనే"
    },
    {
      "t": "03:52",
      "text": "ఎస్ సార్"
    },
    {
      "t": "03:54",
      "text": "అంటే మీ హస్బెండ్కి పక్కా"
    },
    {
      "t": "03:56",
      "text": "తీసుకుంటారు"
    },
    {
      "t": "03:58",
      "text": "పెట్టుకుంటే ఎప్పుడైనా"
    },
    {
      "t": "04:00",
      "text": "ఓకే"
    },
    {
      "t": "04:02",
      "text": "ఏం చేస్తారు తప్పకుండా"
    },
    {
      "t": "04:04",
      "text": "ఏం చేస్తారు"
