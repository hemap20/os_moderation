    {
      "t": "03:28",
      "text": "అవును"
    },
    {
      "t": "03:30",
      "text": "ఇంకా"
    },
    {
      "t": "03:32",
      "text": "పెద్దగానే ఉంటాయా"
    },
    {
      "t": "03:34",
      "text": "థర్టీ"
