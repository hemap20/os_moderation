    {
      "t": "03:36",
      "text": "ఓకే"
    },
    {
      "t": "03:38",
      "text": "ఇంకా"
    },
    {
      "t": "03:40",
      "text": "ప్రెస్ చేస్తారా మీ హస్బెండ్"
