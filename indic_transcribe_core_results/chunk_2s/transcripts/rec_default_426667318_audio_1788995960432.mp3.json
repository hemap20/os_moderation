    },
    {
      "t": "00:06",
      "text": "എൻ്റെ പേര് കിരൺ ബാംഗ്ലൂരിൽ നിന്ന് പേഴ്സണലി"
    },
    {
      "t": "00:08",
      "text": "ശരി ഓ"
    },
    {
      "t": "00:10",
      "text": "ഹെബ്ബെ രാജ്ജലി നാഥുർക്കു"
    },
    {
      "t": "00:12",
      "text": "ഓക്കേ"
    },
    {
      "t": "00:14",
      "text": "സിംഹം ആര് ഇടാ"
    },
    {
      "t": "00:16",
      "text": "ചെങ്കല"
    },
    {
      "t": "00:18",
      "text": "അവിടെ ആയിരിക്കും ഫ്ലാറ്റ് ബീറ്റ്"
    },
    {
      "t": "00:20",
      "text": "ഓക്കെ ഞാനായിട്ട്"
    },
    {
      "t": "00:22",
      "text": "ഫ്രില്ല് വർക്ക് പണിയെടുക്കുക ഞാൻ ആക്ച്വലി കയറാൻ"
    },
    {
      "t": "00:24",
      "text": "ഹലോ ബാംഗ്ലൂർ തന്നെയാണ് വർക്ക് വന്നിരിക്കുന്നത്"
    },
    {
      "t": "00:26",
      "text": "ആ"
    },
    {
      "t": "00:28",
      "text": "ഓക്കെ കേരളത്തിലുള്ള"
    },
    {
      "t": "00:30",
      "text": "ഗേൾഫ്രണ്ട് ഇല്ല"
    },
    {
      "t": "00:32",
      "text": "ഏതാ ട്രൈ പഠിക്കുക"
    },
    {
      "t": "00:34",
      "text": "പിന്നെ ഒന്ന് ട്രൈ പെൻ"
    },
    {
      "t": "00:36",
      "text": "കേട്ടിട്ടില്ല"
    },
    {
      "t": "00:38",
      "text": "അപ്പോൾ കർശിയ"
    },
    {
      "t": "00:40",
      "text": "ഉന്നത്താൻ ട്രൈ പണിയിട്ടിരിക്കുന്നു"
    },
    {
      "t": "00:42",
      "text": "എപ്പോൾ"
    },
    {
      "t": "00:44",
