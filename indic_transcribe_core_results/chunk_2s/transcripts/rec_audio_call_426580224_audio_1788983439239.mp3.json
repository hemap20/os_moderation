  "segments": [
    {
      "t": "00:00",
      "text": "ம்"
    },
    {
      "t": "00:02",
      "text": "ஹலோ ஹலோ"
    },
    {
      "t": "00:04",
      "text": "ஹாய்"
    },
    {
      "t": "00:06",
      "text": "விட்டு போயிடுச்சுங்க"
    },
    {
      "t": "00:08",
      "text": "நான் கோயம்புத்தூர்லேயே"
    },
    {
      "t": "00:10",
      "text": "நான் ஹீரோ"
    },
    {
      "t": "00:12",
      "text": "அப்புறம்"
    },
    {
      "t": "00:14",
      "text": "சட்டை சா நுணுக்கம்"
    },
    {
      "t": "00:16",
      "text": "காப்பாற்றி வைக்கிறேன்"
    },
    {
      "t": "00:18",
      "text": "சிங்கிளாக நிறையா"
    },
    {
      "t": "00:20",
      "text": "ஆ"
    },
    {
      "t": "00:22",
      "text": "சிங்கிள் எனக்கு ஏஜ் முப்பது"
    },
    {
      "t": "00:24",
      "text": "போகிறப்ப"
    },
    {
      "t": "00:26",
      "text": "நானும் செஞ்சது"
    },
    {
      "t": "00:28",
      "text": "எனக்கு ஏஜ் வந்து டுவெண்ட்டி எயிட்"
    },
    {
      "t": "00:30",
      "text": "சரி"
    },
    {
      "t": "00:32",
      "text": "உங்களுக்கு"
    },
    {
      "t": "00:34",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:36",
      "text": "ஓகே பிரிக்கர்ஸ் தான்"
    },
    {
      "t": "00:38",
      "text": "படத்தில்"
    },
    {
      "t": "00:40",
      "text": "உங்களுக்கு எப்படி தெரிஞ்சுனா புரியும்"
    },
    {
      "t": "00:42",
      "text": "குடிக்கும்போது"
    },
    {
      "t": "00:44",
      "text": "இப்படி பேசினா பிடிக்கும்"
    },
    {
      "t": "00:46",
      "text": "ஸ்ட்ரைக்ஸ்"
    },
    {
      "t": "00:48",
      "text": "பண்ணிக்கோங்க"
    },
    {
      "t": "00:50",
      "text": "ம்"
    },
    {
      "t": "00:52",
      "text": "பேசலாம்"
    },
    {
      "t": "00:54",
      "text": "செக்ஸ் பண்ணியிருக்கீங்க"
    },
    {
      "t": "00:56",
      "text": "லால்கேட்டன்"
    },
    {
      "t": "00:58",
      "text": "பண்ணியிருக்கேன் நீங்கள் பண்ணியிருக்கீங்களா"
    },
    {
      "t": "01:00",
      "text": "என் நோவல்"
    },
    {
      "t": "01:02",
      "text": "விளக்க"
    },
    {
      "t": "01:04",
      "text": "ம்"
    },
    {
      "t": "01:06",
      "text": "உங்களுக்கு பேர் நம்பர்னால் பிடிக்கும்"
    },
    {
      "t": "01:08",
      "text": "திங்க் யூ"
    },
    {
      "t": "01:10",
      "text": "புரியல"
    },
    {
      "t": "01:12",
      "text": "எனக்கு எப்படி எல்லாம் பண்ணலாம் பிடிக்கும்"
    },
    {
      "t": "01:14",
      "text": "விஜயதாஸ்"
    },
    {
      "t": "01:16",
      "text": "என்ன மாதிரி"
    },
    {
      "t": "01:18",
      "text": "சரி"
    }
  ],
  "full_text": "ம் ஹலோ ஹலோ ஹாய் விட்டு போயிடுச்சுங்க நான் கோயம்புத்தூர்லேயே நான் ஹீரோ அப்புறம் சட்டை சா நுணுக்கம் காப்பாற்றி வைக்கிறேன் சிங்கிளாக நிறையா ஆ சிங்கிள் எனக்கு ஏஜ் முப்பது போகிறப்ப நானும் செஞ்சது எனக்கு ஏஜ் வந்து டுவெண்ட்டி எயிட் சரி உங்களுக்கு சரிங்க சார் ஓகே பிரிக்கர்ஸ் தான் படத்தில் உங்களுக்கு எப்படி தெரிஞ்சுனா புரியும் குடிக்கும்போது இப்படி பேசினா பிடிக்கும் ஸ்ட்ரைக்ஸ் பண்ணிக்கோங்க ம் பேசலாம் செக்ஸ் பண்ணியிருக்கீங்க லால்கேட்டன் பண்ணியிருக்கேன் நீங்கள் பண்ணியிருக்கீங்களா என் நோவல் விளக்க ம் உங்களுக்கு பேர் நம்பர்னால் பிடிக்கும் திங்க் யூ புரியல எனக்கு எப்படி எல்லாம் பண்ணலாம் பிடிக்கும் விஜயதாஸ் என்ன மாதிரி சரி",
