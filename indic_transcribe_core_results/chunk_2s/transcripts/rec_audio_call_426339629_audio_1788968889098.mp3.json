  "segments": [
    {
      "t": "00:00",
      "text": "പിന്നെ ലോകം"
    },
    {
      "t": "00:02",
      "text": "എവിടെ ചെല്ലും"
    },
    {
      "t": "00:04",
      "text": "സലം ക്രിക്കറ്റ്"
    },
    {
      "t": "00:06",
      "text": "എന്താ ചെയ്യുന്നത് ഞാൻ"
    },
    {
      "t": "00:08",
      "text": "വർക്ക് ചെയ്യുക"
    },
    {
      "t": "00:10",
      "text": "താനും"
    },
    {
      "t": "00:12",
      "text": "നല്ലൊരു വർക്കാണ്"
    },
    {
      "t": "00:14",
      "text": "എന്താ വർക്ക് എന്താ ഞാൻ അക്കൗണ്ട്സ് കാര്യങ്ങളൊക്കെ"
    },
    {
      "t": "00:16",
      "text": "ആ"
    },
    {
      "t": "00:18",
      "text": "ഓക്കെ നിങ്ങൾക്ക് ഓപ്പൺ ടോക്ക് സർവീസ് എടുക്കാൻ താല്പര്യം ഉണ്ടോ"
    },
    {
      "t": "00:20",
      "text": "വിൻഡോ ഓപ്പൺ"
    },
    {
      "t": "00:22",
      "text": "ഓപ്പൺടോക് സർവീസെടുക്കാൻ താല്പര്യമുണ്ടോ"
    },
    {
      "t": "00:24",
      "text": "സർവീസിന് താല്പര്യം ഉണ്ടോ എന്നാ"
    },
    {
      "t": "00:26",
      "text": "ആ"
    },
    {
      "t": "00:28",
      "text": "എന്തിലാത് വാട്സാപ്പിലോ"
    },
    {
      "t": "00:30",
      "text": "ടെലഗ്രാം"
    },
    {
      "t": "00:32",
      "text": "ഇത്രയും റേറ്റ്"
    },
    {
      "t": "00:34",
      "text": "എന്തോ അതിനായി മൂന്ന്"
    },
    {
      "t": "00:36",
      "text": "അതുകൊണ്ട് എത്രയായിരിക്കും"
    },
    {
      "t": "00:38",
      "text": "നാൽപ്പത് മിനിറ്റ് ആ"
    },
    {
      "t": "00:40",
      "text": "എത്ര"
    },
    {
      "t": "00:42",
      "text": "മിനിറ്റിന് ഇരുന്നൂറ്റി അമ്പത് ആകും"
    },
    {
      "t": "00:44",
      "text": "പി ഡി എഫ് കോൾ"
    },
    {
      "t": "00:46",
      "text": "പാടാണ് പാടാണ്"
    },
    {
      "t": "00:48",
      "text": "ഓക്കേ നീ പറയൂ"
    },
    {
      "t": "00:50",
      "text": "ഇല്ല"
    },
    {
      "t": "00:52",
      "text": "മുസ്ലിം വീട്ടിൽ നിന്ന് പോയില്ലേ"
    }
  ],
  "full_text": "പിന്നെ ലോകം എവിടെ ചെല്ലും സലം ക്രിക്കറ്റ് എന്താ ചെയ്യുന്നത് ഞാൻ വർക്ക് ചെയ്യുക താനും നല്ലൊരു വർക്കാണ് എന്താ വർക്ക് എന്താ ഞാൻ അക്കൗണ്ട്സ് കാര്യങ്ങളൊക്കെ ആ ഓക്കെ നിങ്ങൾക്ക് ഓപ്പൺ ടോക്ക് സർവീസ് എടുക്കാൻ താല്പര്യം ഉണ്ടോ വിൻഡോ ഓപ്പൺ ഓപ്പൺടോക് സർവീസെടുക്കാൻ താല്പര്യമുണ്ടോ സർവീസിന് താല്പര്യം ഉണ്ടോ എന്നാ ആ എന്തിലാത് വാട്സാപ്പിലോ ടെലഗ്രാം ഇത്രയും റേറ്റ് എന്തോ അതിനായി മൂന്ന് അതുകൊണ്ട് എത്രയായിരിക്കും നാൽപ്പത് മിനിറ്റ് ആ എത്ര മിനിറ്റിന് ഇരുന്നൂറ്റി അമ്പത് ആകും പി ഡി എഫ് കോൾ പാടാണ് പാടാണ് ഓക്കേ നീ പറയൂ ഇല്ല മുസ്ലിം വീട്ടിൽ നിന്ന് പോയില്ലേ",
