    },
    {
      "t": "00:10",
      "text": "ಮಗದೊಂದ"
    },
    {
      "t": "00:12",
      "text": "ನೆಕ್ಸ್ಟು"
    },
    {
      "t": "00:14",
      "text": "ರಾಜ್ಯದ ಜಾತ್ರೆ ಮೆಸ್ಸು"
    },
    {
      "t": "00:16",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:18",
      "text": "ಏನು ವರ್ಕ್ ಮಾಡ್ತೀರಾ ಇದು"
    },
    {
      "t": "00:20",
      "text": "ನಾನು ವಿಜಯ್ ಅವರೇ"
    },
    {
      "t": "00:22",
      "text": "ಹೌದು"
    },
    {
      "t": "00:24",
      "text": "ನಾನು"
    },
    {
      "t": "00:26",
      "text": "ಆಸ್ಪತ್ರೆ ವರ್ಕ್ ಮಾಡ್ತಿದ್ದೀನಿ"
    },
    {
      "t": "00:28",
      "text": "ಪಾಸ್ಪೋರ್ಟ್"
    },
    {
      "t": "00:30",
      "text": "ರೋಬಿನ್ ಕೆಲಸ"
    },
    {
      "t": "00:32",
      "text": "ಮನಸ್ಸು"
    },
    {
      "t": "00:34",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:36",
      "text": "ಓಕೆ ಎಷ್ಟು ಜನ ಐತಿ ಆಫೀಸಿಗೆ ಬಂದು"
    },
    {
      "t": "00:38",
      "text": "ಆಫ್ಲೈನ್"
    },
    {
      "t": "00:40",
      "text": "ಹನ್ನೆರಡು ಗಂಟೆ ಆಯ್ತಲ್ವಾ ನಿನ್ನೆ ಬರುತ್ತೆ"
    },
    {
      "t": "00:42",
      "text": "ಅಂದ್ರೆ ಅದನ್ನೇನೇ ನೆಟ್"
    },
    {
      "t": "00:44",
      "text": "ಹಾಂ ಮುಂದೆ"
    },
    {
      "t": "00:46",
      "text": "ಹಂಗೆ ಮಾತಾಡಿದರೆ ಅಲ್ಲಿ"
    },
    {
      "t": "00:48",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:50",
      "text": "ನಾನು ಜಾಸ್ತಿ ಯೂಸ್ ಮಾಡಿಲ್ಲ"
    },
    {
      "t": "00:52",
      "text": "ಒಂದು ಟು ತ್ರೀ ಕೌಸ್ ಅಷ್ಟೆ"
    },
    {
      "t": "00:54",
      "text": "ಚಾಟ್ ಆ್ಯಂಡ್ ಮಸಾಲ"
    },
    {
      "t": "00:56",
      "text": "ಬಹುಮತ ಪೈಸಾ ರೈತರು ಮನೆಯಲ್ಲಿ"
    },
    {
      "t": "00:58",
      "text": "ಯಾರದೋ ನಂಬರ್ ಕೊಡ್ಬಿಡು"
    },
    {
      "t": "01:00",
      "text": "ಓಕೆ ಥ್ಯಾಂಕ್ ಯು"
    },
    {
      "t": "01:02",
      "text": "ಓಕೆ"
    },
    {
      "t": "01:04",
      "text": "ಇಲ್ಲ ನಂಬರ್ ಕೊಟ್ಟರೆ ಇದರೊಳಗೆ ಯಾರೂ ಅನ್ಲೈನ್"
    },
    {
      "t": "01:06",
      "text": "ಇರ್ತಾರೆ ಸುಮ್ಮನೆ ಫೋನ್ ಮಾಡ್ತಿರ್ತಾರೆ ಮೆಸೇಜ್"
    },
    {
      "t": "01:08",
      "text": "ಏನು ಮಾಡ್ತಾರೆ ವಾಟ್ಸಾಪಲ್ಲಿ ಹಿಂಗೆ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "01:10",
      "text": "ಈ ಸೂರ್ಯಕಾಂತಿ ಮಂದಿರ ಹೋಗಿ"
    },
    {
      "t": "01:12",
      "text": "ಎಲ್ಲ ಆಗುತ್ತೆ ವೀಡಿಯೋ"
    },
    {
      "t": "01:14",
      "text": "ಕ್ಯಾನ್ಸಲ್ ಮಾಡ್ತೀವಿ ಅಂತಂದ್ರೆ ಅದಕ್ಕೆ ಹೋಗ್ಬೇಡಿ"
    },
    {
      "t": "01:16",
      "text": "ಹಾಂ ಹಾಂ"
    },
    {
      "t": "01:18",
      "text": "ಹ್ಞೂ ಥ್ಯಾಂಕ್ಸ್ ಮಲ್ರಿ"
    },
    {
      "t": "01:20",
      "text": "ಹುಷಾರಾಗಿರಿ"
    },
    {
      "t": "01:22",
      "text": "ಲವರಸಿಗೆ ಹಾಕ್ಕೊಂಡು"
    },
    {
      "t": "01:24",
      "text": "ಮ್ಯಾರೀಡಾ ಅನ್ಮ್ಯಾರೀಡಾ"
    },
    {
      "t": "01:26",
      "text": "ಅಂಬರ್ಡ್"
    },
    {
      "t": "01:28",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:30",
      "text": "ನಡೆಸ್ತಾರೆ ಸುಮ್ಮನೆ ಕಷ್ಟ ಆಗ್ಬಿಡುತ್ತೆ"
    },
    {
      "t": "01:32",
      "text": "ಆಮೇಲೆ ಇನ್ನೊಂದು ಏನಂದರೆ ಇದ್ರಲ್ಲಿ ಮಾತ್ರ ಇಲ್ಲ"
    },
    {
      "t": "01:34",
      "text": "ಬರೀ ಕೆಟ್ಟದಾಗೆ ಮಾತಾಡೋದು"
    },
    {
      "t": "01:36",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:38",
      "text": "ಸೆಕ್ಸ್ ಬಗ್ಗೆ ಮಾತಾಡ್ತೀರಾ"
    },
    {
      "t": "01:40",
      "text": "ಇಂಥ ಟೈಮ್"
    },
    {
      "t": "01:42",
      "text": "ಮಾತಾಡ್ತಾರೆ ನಿಮ್ಗೆ ಹೆಂಗೆಲ್ಲ ಇಷ್ಟ ಆಯ್ತು"
    },
    {
      "t": "01:44",
      "text": "ಕಾರಣ"
    },
    {
      "t": "01:46",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:48",
      "text": "ಹಲೋ"
    },
    {
      "t": "01:50",
      "text": "ಹಾಂ ಹೇಳಿ"
    },
    {
      "t": "01:52",
      "text": "ನೀವು ಹಂಗೆಲ್ಲ ಮಾತಾಡಕ್ಕೆ ಇಷ್ಟ ಆಗುತ್ತಾ ನಮಗೆ"
    },
    {
      "t": "01:54",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "01:56",
      "text": "ನಮಿತಾ ನನಗೆ"
    },
    {
      "t": "01:58",
      "text": "ಇದರಲ್ಲಿ ಹಂಗೇ ಕೇಳ್ತಾರೆ"
    },
    {
      "t": "02:00",
      "text": "ಹಾಂ ಹಾಂ"
    },
    {
      "t": "02:02",
      "text": "ಹುಷಾರು ನೋಡಿ"
