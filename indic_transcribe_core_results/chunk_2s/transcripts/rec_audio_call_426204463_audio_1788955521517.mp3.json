    {
      "t": "00:40",
      "text": "प्यार पढ़ाएगा"
    },
    {
      "t": "00:42",
      "text": "कर रहे हैं तो हाउस वाइफ के भी बनेंगे तुम बताओ"
    },
    {
      "t": "00:44",
      "text": "हाँ"
    },
    {
      "t": "00:46",
      "text": "ठीक है"
    },
    {
      "t": "00:48",
      "text": "क्या कह रहा हूँ जब पढ़ाई करेंगे तो आप"
    },
    {
      "t": "00:50",
      "text": "रेफ्यू बनेंगे हम"
