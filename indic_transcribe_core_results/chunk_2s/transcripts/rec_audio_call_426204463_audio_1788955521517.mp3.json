    },
    {
      "t": "00:22",
      "text": "बिजनेस से थोड़ा छोटा मोटा आपका"
    },
    {
      "t": "00:24",
      "text": "हाँ"
    },
    {
      "t": "00:26",
      "text": "मैं तो पढ़ाई करती हूँ यार"
    },
    {
      "t": "00:28",
      "text": "पढ़ाई करते हो या"
    },
    {
      "t": "00:30",
      "text": "हाउसवाइफ हो"
    },
    {
      "t": "00:32",
      "text": "पढ़ाई करती हूँ"
    },
    {
      "t": "00:34",
      "text": "शादी नहीं हुई मेरी जैसा मुझे हाउसवाइफ"
