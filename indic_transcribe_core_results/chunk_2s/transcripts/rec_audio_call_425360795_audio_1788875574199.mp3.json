{
  "file_id": "rec_audio_call_425360795_audio_1788875574199.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 150.054,
  "processing_time_sec": 1014.2069790363312,
  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:02",
      "text": "ഹലോ ഹലോ"
    },
    {
      "t": "00:04",
      "text": "ആ കേൾക്കുന്നുണ്ടോ"
    },
    {
      "t": "00:06",
      "text": "കേൾക്കുന്നല്ലോ ഈ ആരാ"
    },
    {
      "t": "00:08",
      "text": "എൻ്റെ പേര് അജ്മൽ എന്നാണ്"
    },
    {
      "t": "00:10",
      "text": "മലപ്പുറത്തു നിന്നാണ് ഞങ്ങൾ"
    },
    {
      "t": "00:12",
      "text": "ആ എന്നോട് പേര്"
    },
    {
      "t": "00:14",
      "text": "ഹേയ് അശ്വതി എൻ്റെ സ്ഥലം കൊല്ലത്താണ്"
    },
    {
      "t": "00:16",
      "text": "ആ ഞാൻ കൊല്ലത്തു നിന്നാണ് സംസാരിക്കുന്നത്"
    },
    {
      "t": "00:18",
      "text": "ആ എത്ര വയസ്സുണ്ട്"
    },
    {
      "t": "00:20",
      "text": "എനിക്ക് മുപ്പത്തിയാറ്"
    },
    {
      "t": "00:22",
      "text": "ആ"
    },
    {
      "t": "00:24",
      "text": "മാരീഡ് ആണ് അപ്പം"
    },
    {
      "t": "00:26",
      "text": "ആ ഇപ്പം നേരെ ഇടാം"
    },
    {
      "t": "00:28",
      "text": "ഹസ്ബൻഡിൻ്റെ എം എ"
    },
    {
      "t": "00:30",
      "text": "ഹസ്ബൻഡ് ഡ്രൈവറാ"
    },
    {
      "t": "00:32",
      "text": "ഓക്കേ"
    },
    {
      "t": "00:34",
      "text": "ആപ്പ് എടുത്തിട്ട് പറയുമോ"
    },
    {
      "t": "00:36",
      "text": "ഇല്ല"
    },
    {
      "t": "00:38",
      "text": "ഇന്ന് ഇന്നലെ എടുത്തിട്ടിട്ടുണ്ടായിരുന്നു"
    },
    {
      "t": "00:40",
      "text": "ഇന്ന് അവർ വിളിച്ചെല്ലാം ഓക്കെ ആക്കിയിട്ട്"
    },
    {
      "t": "00:42",
      "text": "സംഭവം എന്താണെന്നൊന്നും എനിക്കറിയില്ല"
    },
    {
      "t": "00:44",
      "text": "സംഭവം എന്താ ഇതിനകത്ത് സംസാരിക്കുന്നത്"
    },
    {
      "t": "00:46",
      "text": "ഇതൊക്കെ മെന്താ കിട്ടുക"
    },
    {
      "t": "00:48",
      "text": "പേയ്മെന്റ് കിട്ടും നിങ്ങൾക്ക്"
    },
    {
      "t": "00:50",
      "text": "ഒരു മിനിറ്റിന്"
    },
    {
      "t": "00:52",
      "text": "എങ്ങനെ നമുക്ക് പേയ്മെന്റ് നമ്മളെ അക്കൗണ്ടിൽ വരും"
    },
    {
      "t": "00:54",
      "text": "ഇതിനകത്ത് കോമൺ ആയിട്ടുള്ള ഒരുപാട് കാര്യങ്ങൾ ഉണ്ട്"
    },
    {
      "t": "00:56",
      "text": "പോകാനായിട്ടായിരിക്കും നിങ്ങൾക്ക് കയറുന്നത് നിങ്ങൾക്ക് അറിയില്ല"
    },
    {
      "t": "00:58",
      "text": "പദ്ധതി ഓ"
    },
    {
      "t": "01:00",
      "text": "അങ്ങനെ"
    },
    {
      "t": "01:02",
      "text": "പിന്നെ"
    },
    {
      "t": "01:04",
      "text": "ചായ കുടിക്കാൻ ആപ്പ് എടുത്താലോ"
    },
    {
      "t": "01:06",
      "text": "മ്മ്"
    },
    {
      "t": "01:08",
      "text": "വീട്ടിലാരൊക്കെയോ വേറെ ആരൊക്കെയോ ഉള്ളവരൊക്കെയോ ഉള്ളവരൊക്കെയോ"
    },
    {
      "t": "01:10",
      "text": "അടുത്ത കാര്യം"
    },
    {
      "t": "01:12",
      "text": "ഇല്ലില്ല ഇത് ഓണാക്കിയാലല്ലേ"
    },
    {
      "t": "01:14",
      "text": "ഓഡിയോ കോൾ ഓണായിരിക്കും"
    },
    {
      "t": "01:16",
      "text": "മൈക്കിലല്ലേ കോള് വരത്തുള്ളൂ"
    },
    {
      "t": "01:18",
      "text": "പിന്നെ ഉള്ളതിൻ്റെ"
    },
    {
      "t": "01:20",
      "text": "ഹസ്ബൻഡ് വിടില്ല ഹസ്ബൻഡിന് ഞാനൊരു ഷഗഡാണ്"
    },
    {
      "t": "01:22",
      "text": "മിണ്ടും ഇപ്പം രണ്ട് ദിവസം കഴിഞ്ഞു"
    },
    {
      "t": "01:24",
      "text": "സൗണ്ട് മിണ്ടും ഷഗ്ഗ് ഡാ ഷഗ്ഗ് ഡാ"
    },
    {
      "t": "01:26",
      "text": "പുളിമുട്ടിൽ എത്തില്ല"
    },
    {
      "t": "01:28",
      "text": "ഓക്കേ ഇതിനകത്ത്"
    },
    {
      "t": "01:30",
      "text": "ഓപ്പൺ ടോക്ക് കാരണം എന്തോ ഉണ്ട്"
    },
    {
      "t": "01:32",
      "text": "ഏഹ്"
    },
    {
      "t": "01:34",
      "text": "അദ്ദേഹത്തിനകത്തുള്ള ഒരുപാട് ആൾക്കാരൊക്കെ ഓപ്പൺ ഉണ്ട്"
    },
    {
      "t": "01:36",
      "text": "ഓക്കെ ചോദിച്ചിട്ട് വന്നു തരിക"
    },
    {
      "t": "01:38",
      "text": "അനുജ"
    },
    {
      "t": "01:40",
      "text": "എന്നുവെച്ചാൽ നമ്മൾ ഓപ്പൺ ആയിട്ട്"
    },
    {
      "t": "01:42",
      "text": "എല്ലാം സംസാരിക്കാൻ പറ്റണം"
    },
    {
      "t": "01:44",
      "text": "അത് മോശമായിട്ട് പറഞ്ഞാൽ"
    },
    {
      "t": "01:46",
      "text": "പിന്നെ അതിനകത്ത് നമ്മളെ വിളിച്ച് അവരുടെ"
    },
    {
      "t": "01:48",
      "text": "അവരോട് പറഞ്ഞാൽ മതിയെന്നാണ് പറഞ്ഞത്"
    },
    {
      "t": "01:50",
      "text": "അങ്ങനെയല്ല"
    },
    {
      "t": "01:52",
      "text": "ആ അതെനിക്കറിയില്ല"
    },
    {
      "t": "01:54",
      "text": "ആ അങ്ങനെ"
    },
    {
      "t": "01:56",
      "text": "മോസ്റ്റ് ഓഫ് ദ ആൾക്കാരും അങ്ങനെ വരിക"
    },
    {
      "t": "01:58",
      "text": "അപ്പൻ ടോക്ക് ചോദിച്ചിട്ടാണ് വരിക"
    },
    {
      "t": "02:00",
      "text": "ഓ"
    },
    {
      "t": "02:02",
      "text": "അപ്പോൾ ഇയാൾക്ക് താല്പര്യമില്ലാന്ന് ഉണ്ടെങ്കിൽ"
    },
    {
      "t": "02:04",
      "text": "താല്പര്യമില്ല എന്ന് പറയാം"
    },
    {
      "t": "02:06",
      "text": "ഞാൻ കട്ട് ആക്കി വിടും നേരത്തെ"
    },
    {
      "t": "02:08",
      "text": "ഒരു ചെറുക്കനാണോ എന്ന് എനിക്കറിയില്ല കാരണം"
    },
    {
      "t": "02:10",
      "text": "ചോദിച്ചിട്ട് ഏത്"
    },
    {
      "t": "02:12",
      "text": "എത്ര നീളം വണ്ണമുണ്ടോ"
    },
    {
      "t": "02:14",
      "text": "ഇതിനെക്കാൾ ഒന്ന്"
    },
    {
      "t": "02:16",
      "text": "കാണിച്ചു തരുമോ എന്നൊക്കെ ചോദിച്ചു അപ്പം ഞാൻ ബ്ലോഗ് അത്"
    },
    {
      "t": "02:18",
      "text": "കട്ടാക്കി ഇങ്ങോട്ട് ബ്ലോക്ക് ഇങ്ങനെ എല്ലാം കട്ട് ചെയ്ത്"
    },
    {
      "t": "02:20",
      "text": "അപ്ഡേറ്റ് ചെയ്തിട്ട്"
    },
    {
      "t": "02:22",
      "text": "അതോറിന് ഇതിനകത്ത് അങ്ങനത്തെ കുറച്ച് പ്രശ്നങ്ങൾ"
    },
    {
      "t": "02:24",
      "text": "ഉണ്ട് ശ്രദ്ധിച്ച് ചോദിച്ച് കേട്ടോ"
    },
    {
      "t": "02:26",
      "text": "മ്മ്"
    },
    {
      "t": "02:28",
      "text": "ഫുഡ് കഴിച്ചോ"
    }
  ],
