    {
      "t": "01:40",
      "text": "సైవా అబద్ధం"
    },
    {
      "t": "01:42",
      "text": "ట్వంటీ"
    },
    {
      "t": "01:44",
      "text": "ఫైవ్ సిక్స్"
    },
    {
      "t": "01:46",
      "text": "ఇంకా అదే మరి ఫార్టీ"
    },
    {
      "t": "01:48",
      "text": "నాకు ఎన్ని ఇయర్స్ ఉంటాయి చెప్పండి"
    },
    {
      "t": "01:50",
      "text": "గెసిమ్"
    },
    {
      "t": "01:52",
      "text": "ఆ"
    },
    {
      "t": "01:54",
      "text": "ఓ ట్వంటీ ఎక్స్"
    },
    {
      "t": "01:56",
      "text": "బిజీగా ఉన్న బట్టలు అన్నీ ఎంతనే మిగిలినాయి"
    },
    {
      "t": "01:58",
      "text": "ట్వంటీ ఇయర్స్"
    },
    {
      "t": "02:00",
      "text": "సరే"
    },
    {
      "t": "02:02",
      "text": "సిబ్లింగ్స్ ఎంతమంది మీరు"
    },
    {
      "t": "02:04",
      "text": "సరే సరే"
    },
    {
      "t": "02:06",
      "text": "మీరు మీరు ఇంకా"
    },
    {
      "t": "02:08",
      "text": "సిస్టర్"
    },
    {
      "t": "02:10",
      "text": "ఓకే"
    },
    {
      "t": "02:12",
      "text": "అవునా"
    },
    {
      "t": "02:14",
      "text": "అవును"
    },
    {
      "t": "02:16",
      "text": "అందుబాటులోకి రండి"
    },
    {
      "t": "02:18",
      "text": "ఎప్పటి నుంచి యూజ్ చేస్తున్నారు యాప్"
    },
    {
      "t": "02:20",
      "text": "నిన్న నైట్"
    },
