      "text": "హలో"
    },
    {
      "t": "00:02",
      "text": "టైప్"
    },
    {
      "t": "00:04",
      "text": "హాయ్ ఎక్కడ నుంచి"
    },
    {
      "t": "00:06",
      "text": "హైదరాబాద్ మీరు"
    },
    {
      "t": "00:08",
      "text": "వరంగల్ ఏం చేస్తుంటారు"
    },
    {
      "t": "00:10",
      "text": "జాబ్ చేస్తుంటాను"
    },
    {
      "t": "00:12",
      "text": "మీరు ఏం చేస్తుంటారు"
    },
    {
      "t": "00:14",
      "text": "నేను డిగ్రీ ఫైనల్ ఇయర్"
    },
    {
      "t": "00:16",
      "text": "బాయ్"
    },
    {
      "t": "00:18",
      "text": "తిన్న రంగు"
    },
    {
      "t": "00:20",
      "text": "మరి అవును మీరు"
    },
    {
      "t": "00:22",
      "text": "తిన్నా ఏం"
    },
    {
      "t": "00:24",
      "text": "పేరు మీ పేరు"
    },
    {
      "t": "00:26",
      "text": "ఓకే"
    },
    {
      "t": "00:28",
      "text": "నా పేరు రోహిత్"
    },
    {
      "t": "00:30",
      "text": "నా పేరు ఆద్యశ్రీ"
    },
    {
      "t": "00:32",
      "text": "ఓ"
    },
    {
      "t": "00:34",
      "text": "నైస్ నేమ్ మీరు గడబడట్లేదు"
    },
    {
      "t": "00:36",
      "text": "మీ ఫేస్"
    },
    {
      "t": "00:38",
      "text": "కనిపించడం లేదు ఏదైనా"
    },
    {
      "t": "00:40",
      "text": "ఇదైతే"
    },
    {
      "t": "00:42",
      "text": "ఓకే"
    },
    {
      "t": "00:44",
      "text": "ఫినిషింగ్ తొందరగా"
    },
    {
      "t": "00:46",
      "text": "ఓకే"
    },
    {
      "t": "00:48",
      "text": "హలో"
    },
    {
      "t": "00:50",
      "text": "చెప్పండి"
    },
    {
      "t": "00:52",
      "text": "చెప్పండి"
    },
    {
      "t": "00:54",
      "text": "ఏం చేస్తావు"
    },
    {
      "t": "00:56",
      "text": "డిగ్రీ ఫైన్ లేయర్"
    },
    {
      "t": "00:58",
      "text": "అదే"
    },
    {
      "t": "01:00",
      "text": "ఎందుకు"
    },
    {
      "t": "01:02",
      "text": "అట్లా లేనా"
    },
    {
      "t": "01:04",
      "text": "చంపు చంపుతూ పోయింది మరి"
    },
    {
      "t": "01:06",
      "text": "ఎట్లన్నా"
    },
    {
      "t": "01:08",
      "text": "ఓకే"
    },
    {
      "t": "01:10",
      "text": "అంటే"
    },
    {
      "t": "01:12",
      "text": "ఫస్ట్ ఇయర్"
    },
    {
      "t": "01:14",
      "text": "వాహనము"
    },
    {
      "t": "01:16",
      "text": "అవునా"
    },
    {
      "t": "01:18",
      "text": "లే డిగ్రీ సైన్స్"
    },
    {
      "t": "01:20",
      "text": "నేను నేను ఎలా ఉన్నాను"
    },
    {
      "t": "01:22",
      "text": "మిరుడ"
    },
    {
      "t": "01:24",
      "text": "కాలేజ్ లాగానే ఉన్నారు మీకు"
    },
    {
      "t": "01:26",
      "text": "ఎన్ని ఇయర్స్ ఉంటాయి"
    },
    {
      "t": "01:28",
      "text": "ఎన్ని ఇయర్స్ ఉంటాయి"
    },
    {
      "t": "01:30",
      "text": "అయ్యో"
    },
    {
      "t": "01:32",
      "text": "అచ్చా"
    },
    {
      "t": "01:34",
      "text": "ఎన్ని ఇయర్స్ ఉంటాయి చెప్పండి"
    },
    {
      "t": "01:36",
      "text": "ఫార్టీ ఫైవ్"
    },
    {
      "t": "01:38",
      "text": "పేపర్లో సర్వింగ్ స్మార్ట్ టేస్ట్"
