{
  "file_id": "rec_audio_call_424886004_audio_1788837418505.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 334.101,
  "processing_time_sec": 23.315879583358765,
  "segments": [
    {
      "t": "00:00",
      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "ఆ"
    },
    {
      "t": "00:04",
      "text": "ఆ పెద్దమ్మ"
    },
    {
      "t": "00:06",
      "text": "హలో"
    },
    {
      "t": "00:08",
      "text": "పొలం దగ్గర వేరు"
    },
    {
      "t": "00:10",
      "text": "హలో"
    },
    {
      "t": "00:12",
      "text": "హలో"
    },
    {
      "t": "00:14",
      "text": "అసలు ఆ ఫలం దగ్గరికి నువ్వు"
    },
    {
      "t": "00:16",
      "text": "కూడా మారింది"
    },
    {
      "t": "00:18",
      "text": "రానులే మా మమ్మీ వాళ్ళు లేరు"
    },
    {
      "t": "00:20",
      "text": "ఒక్కదాన్నే ఉన్నాయి"
    },
    {
      "t": "00:22",
      "text": "ఇంట్లో ఎప్పుడు"
    },
    {
      "t": "00:24",
      "text": "ఓకే అండి"
    },
    {
      "t": "00:26",
      "text": "ఆ"
    },
    {
      "t": "00:28",
      "text": "సిస్టర్ ఉంది"
    },
    {
      "t": "00:30",
      "text": "అచ్చా మీ సిస్టర్ని ఎక్కడ కొన్నావు"
    },
    {
      "t": "00:32",
      "text": "భీమవరం నేను వచ్చేస్తాను"
    },
    {
      "t": "00:34",
      "text": "ఏందుకు"
    },
    {
      "t": "00:36",
      "text": "కలిసి అలా మాట్లాడుకుందాం"
    },
    {
      "t": "00:38",
      "text": "కొంచెం కాఫీ తాగుకుంటాం"
    },
    {
      "t": "00:40",
      "text": "స్కెల్టన్"
    },
    {
      "t": "00:42",
      "text": "లేదు ఇంకా విచారణ"
    },
    {
      "t": "00:44",
      "text": "ఆ"
    },
    {
      "t": "00:46",
      "text": "గర్ల్ ఫ్రెండ్స్ మ్యారేజ్"
    },
    {
      "t": "00:48",
      "text": "ఏడా సింగిల్"
    },
    {
      "t": "00:50",
      "text": "నేను సింగిల్ నువ్వు మ్యారీడా"
    },
    {
      "t": "00:52",
      "text": "లేదు"
    },
    {
      "t": "00:54",
      "text": "మరి ఓన్లీ అంకుల్స్"
    },
    {
      "t": "00:56",
      "text": "చూడడం మాట్లాడేలా ఉన్నావు కదా నువ్వు"
    },
    {
      "t": "00:58",
      "text": "ఈ"
    },
    {
      "t": "01:00",
      "text": "ఏం మాట్లాడుతుంది"
    },
    {
      "t": "01:02",
      "text": "తెలుగు ప్లేన్ ఏదో బాగా"
    },
    {
      "t": "01:04",
      "text": "బాధ ఎలా వచ్చింది అబ్బా దీంట్లోకి మా వాళ్ళు"
    },
    {
      "t": "01:06",
      "text": "ప్లేయర్ అనేది వచ్చినంత"
    },
    {
      "t": "01:08",
      "text": "ఏమైంది మీ వాళ్ళకి ఏమైంది"
    },
    {
      "t": "01:10",
      "text": "మా వాళ్ళకి ఏం కాలేదు"
    },
    {
      "t": "01:12",
      "text": "మా మమ్మీ వాళ్ళు పొలం దగ్గరికి వెళ్ళారని"
    },
    {
      "t": "01:14",
      "text": "ఏదో ఇలా అరిచాను నేను బాధలు ఉన్నాను"
    },
    {
      "t": "01:16",
      "text": "ఏం బాధలు ఉన్నావు నువ్వు"
    },
    {
      "t": "01:18",
      "text": "ఈ యొక్క మీలాంటి ఒక అబ్బాయిని"
    },
    {
      "t": "01:20",
      "text": "నమ్మి అట్లా అయిపోయింది లైఫ్ మొత్తం"
    },
    {
      "t": "01:22",
      "text": "అచ్చా"
    },
    {
      "t": "01:24",
      "text": "నువ్వు హాస్పిటల్లో పని చేస్తావా"
    },
    {
      "t": "01:26",
      "text": "ఈ"
    },
    {
      "t": "01:28",
      "text": "అదే"
    },
    {
      "t": "01:30",
      "text": "వాజ్పేయిలోని తవాను"
    },
    {
      "t": "01:32",
      "text": "ఎందుకు"
    },
    {
      "t": "01:34",
      "text": "జస్ట్ అడుగుతున్నాను"
    },
    {
      "t": "01:36",
      "text": "లేదా"
    },
    {
      "t": "01:38",
      "text": "యాడ్ కాలేదు"
    },
    {
      "t": "01:40",
      "text": "సరే అండి"
    },
    {
      "t": "01:42",
      "text": "అవును"
    },
    {
      "t": "01:44",
      "text": "వాట్సాప్లో"
    },
    {
      "t": "01:46",
      "text": "వాడు కూడా వదిలేస్తే బాధపడాల్సిన అవసరం"
    },
    {
      "t": "01:48",
      "text": "అదే అండి"
    },
    {
      "t": "01:50",
      "text": "ఇంట్లో దాకా వచ్చినాక కూడా"
    },
    {
      "t": "01:52",
      "text": "వదిలేస్తే బాధపడకుంటే ఏం చేసుకుంటారు"
    },
    {
      "t": "01:54",
      "text": "యూఎస్ఏ కదా"
    },
    {
      "t": "01:56",
      "text": "అక్కడనే హైదరాబాద్లో ఉండేది"
    },
    {
      "t": "01:58",
      "text": "అట్లా అయిపోయిన వాళ్ళే ఉండేవారు"
    },
    {
      "t": "02:00",
      "text": "చేసిన"
    },
    {
      "t": "02:02",
      "text": "వాజ్పేయిలోనే ఉండేది"
    },
    {
      "t": "02:04",
      "text": "అప్పుడు"
    },
    {
      "t": "02:06",
      "text": "ఆ"
    },
    {
      "t": "02:08",
      "text": "ఎవరు"
    },
    {
      "t": "02:10",
      "text": "నువ్వు"
    },
    {
      "t": "02:12",
      "text": "ఏ నేను చెప్పింది నువ్వు ఇప్పుడు కనెక్ట్ అయ్యి"
    },
    {
      "t": "02:14",
      "text": "ప్లస్"
    },
    {
      "t": "02:16",
      "text": "నువ్వు అవునా కాదా చెప్పు కదా నేను చెప్తాను"
    },
    {
      "t": "02:18",
      "text": "నువ్వు"
    },
    {
      "t": "02:20",
      "text": "చెప్పు నేను ఎప్పుడైనా చెప్పానా నీకు"
    },
    {
      "t": "02:22",
      "text": "చెప్పినావు కాబట్టి మాట్లాడుకున్నాను"
    },
    {
      "t": "02:24",
      "text": "గుర్తొచ్చి"
    },
    {
      "t": "02:26",
      "text": "ఆ"
    },
    {
      "t": "02:28",
      "text": "ఉన్నావా లేదా"
    },
    {
      "t": "02:30",
      "text": "అదన్నమాట"
    },
    {
      "t": "02:32",
      "text": "వాజ్పేయిలో చూడండి"
    },
    {
      "t": "02:34",
      "text": "కదా నువ్వు"
    },
    {
      "t": "02:36",
      "text": "బాచ్పల్లి అని బాచ్పల్లి కావాలి"
    },
    {
      "t": "02:38",
      "text": "ఇంకా వేరే ఇంకా వేరే ఉన్నాయి"
    },
    {
      "t": "02:40",
      "text": "హాస్పిటల్లో వర్క్ చేసినా కూడా"
    },
    {
      "t": "02:42",
      "text": "అరవింద్ అలా"
    },
    {
      "t": "02:44",
      "text": "సరే"
    },
    {
      "t": "02:46",
      "text": "రెవెన్యూ అలా చేయలేదు వేరే దాంట్లో"
    },
    {
      "t": "02:48",
      "text": "ఓకే సార్"
    },
    {
      "t": "02:50",
      "text": "అరవింద్ అని చెప్పినావు మరి నాకు"
    },
    {
      "t": "02:52",
      "text": "ఏమి ఏమన్నా పట్టుకొని ఏమన్నా"
    },
    {
      "t": "02:54",
      "text": "నీకేం గుర్తున్న"
    },
    {
      "t": "02:56",
      "text": "సరే"
    },
    {
      "t": "02:58",
      "text": "నీ నిన్ను వదిలేసుకున్నాడైతే"
    },
    {
      "t": "03:00",
      "text": "ఇక్కడనే కదా వేసింది"
    },
    {
      "t": "03:02",
      "text": "ఇక్కడ ఐటీఐలో"
    },
    {
      "t": "03:04",
      "text": "జాబ్ చేస్తుంటాడు కదా"
    },
    {
      "t": "03:06",
      "text": "నడవంగానే"
    },
    {
      "t": "03:08",
      "text": "ఐటీఐలో ఏదో జాబ్లో చేస్తాడు కదా అంటే"
    },
    {
      "t": "03:10",
      "text": "సున్నా"
    },
    {
      "t": "03:12",
      "text": "ఓకే"
    },
    {
      "t": "03:14",
      "text": "ఏమో అప్పుడు మాట్లాడవలసింది"
    },
    {
      "t": "03:16",
      "text": "ఓకే"
    },
    {
      "t": "03:18",
      "text": "అరే నీకు ఎంతగానం ఇన్ని గుర్తు"
    },
    {
      "t": "03:20",
      "text": "చేస్తే నువ్వు కనీసం గుర్తుపెట్టుకోలేవేం తప్ప"
    },
    {
      "t": "03:22",
      "text": "నాకు అర్థం కాదు"
    },
    {
      "t": "03:24",
      "text": "నాకున్న టెన్షన్కి ఏమి"
    },
    {
      "t": "03:26",
      "text": "గుర్తు తెప్పించాను టెన్షన్ని"
    },
    {
      "t": "03:28",
      "text": "మాటలు వస్తున్నాయి మళ్ళీ టెన్షన్ ఏందమ్మా"
    },
    {
      "t": "03:30",
      "text": "అని మాకు అసలు అర్థం కాదు"
    },
    {
      "t": "03:32",
      "text": "ఉంటుంది అట్లా"
    },
    {
      "t": "03:34",
      "text": "ఓకే"
    },
    {
      "t": "03:36",
      "text": "ఏవండీ అమ్మ"
    },
    {
      "t": "03:38",
      "text": "చెప్పానా చెప్పిన ఆల్రెడీ మంచి"
    },
    {
      "t": "03:40",
      "text": "ఎంజాయ్ చేయబడుతుందా అని చెప్పేసి"
    },
    {
      "t": "03:42",
      "text": "ఓకే"
    },
    {
      "t": "03:44",
      "text": "ఏం"
    },
    {
      "t": "03:46",
      "text": "అలాగ రైట్ లేదండి"
    },
    {
      "t": "03:48",
      "text": "కావట్లేదు ట్రై చేస్తున్నాను"
    },
    {
      "t": "03:50",
      "text": "దామర్ నేను సెక్స్ చేస్తాను"
    },
    {
      "t": "03:52",
      "text": "తనకు ఉన్న మైండ్ సెట్ అంతా మారిపోతుంది"
    },
    {
      "t": "03:54",
      "text": "చేస్తాం"
    },
    {
      "t": "03:56",
      "text": "అబ్బో ఇట్లా రమ్మంటారులే"
    },
    {
      "t": "03:58",
      "text": "అట్లా వస్తారు"
    },
    {
      "t": "04:00",
      "text": "త్రీ ఇంటూ"
    },
    {
      "t": "04:02",
      "text": "నేను అన్నది జస్ట్ సెక్సువల్ ఎంజాయ్మెంట్"
    },
    {
      "t": "04:04",
      "text": "అడ్వాంటేజ్ ఇస్తూ ఉంటాను నీకు అంతే"
    },
    {
      "t": "04:06",
      "text": "నవ్వులవిడా వేస్తా అని చెప్పాను నేను"
    },
    {
      "t": "04:08",
      "text": "నో"
    },
    {
      "t": "04:10",
      "text": "బాధపడుతున్నాం బాధపడకుండా నేను మార్చుకుంటున్నాను"
    },
    {
      "t": "04:12",
      "text": "చేస్తాం అంతే నువ్వు ఎంజాయ్ చేసి ఇక ఆడడానికి"
    },
    {
      "t": "04:14",
      "text": "అని చెప్పి"
    },
    {
      "t": "04:16",
      "text": "నమస్తే"
    },
    {
      "t": "04:18",
      "text": "యూఎస్ అని నేను చెప్పను"
    },
    {
      "t": "04:20",
      "text": "నేను చేసే అంత ఖాళీయే లేని పరిస్థితి"
    },
    {
      "t": "04:22",
      "text": "షెఫ్"
    },
    {
      "t": "04:24",
      "text": "ఎందుకు ఆల్మోస్ట్ కమిట్ అయ్యాడు"
    },
    {
      "t": "04:26",
      "text": "లెక్క మిటర్"
    },
    {
      "t": "04:28",
      "text": "కాదు కానీ"
    },
    {
      "t": "04:30",
      "text": "అరే"
    },
    {
      "t": "04:32",
      "text": "లైక్ నాకు ఇంట్రెస్ట్ రాదు"
    },
    {
      "t": "04:34",
      "text": "లవ్ ప్యాడ్"
    },
    {
      "t": "04:36",
      "text": "నీకు నేను కమిట్మెంట్స్ ఇవ్వలేను"
    },
    {
      "t": "04:38",
      "text": "ఇచ్చి ఇబ్బంది పెట్టాలి అని"
    },
    {
      "t": "04:40",
      "text": "స్ట్రెయిట్ అవే సక్సెస్"
    },
    {
      "t": "04:42",
      "text": "సో మాస్ ఎంజాయ్ చేయొచ్చు"
    },
    {
      "t": "04:44",
      "text": "ఓకే"
    },
    {
      "t": "04:46",
      "text": "షేప్ ఫార్వర్డ్"
    },
    {
      "t": "04:48",
      "text": "ఏంటి"
    },
    {
      "t": "04:50",
