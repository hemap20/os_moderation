    {
      "t": "04:54",
      "text": "సరే"
    },
    {
      "t": "04:56",
      "text": "ఇంకా"
    },
    {
      "t": "04:58",
      "text": "చెప్పమని వార్తలు"
    },
    {
      "t": "05:00",
      "text": "నేనా"
