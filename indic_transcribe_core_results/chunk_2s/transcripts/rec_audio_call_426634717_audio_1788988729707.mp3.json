  "segments": [
    {
      "t": "00:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "ஹலோ"
    },
    {
      "t": "00:04",
      "text": "ஹலோ"
    },
    {
      "t": "00:06",
      "text": "கேட்குதா"
    },
    {
      "t": "00:08",
      "text": "வெயிட் பண்ணுங்கள் ம்"
    },
    {
      "t": "00:10",
      "text": "சீக்கிரமே"
    },
    {
      "t": "00:12",
      "text": "பச்சையாகவோ அப்புடின்னா"
    },
    {
      "t": "00:14",
      "text": "பேசலாமா"
    },
    {
      "t": "00:16",
      "text": "ஓகே"
    },
    {
      "t": "00:18",
      "text": "கொஞ்சம் நம்பர் சொல்கிறியா"
    },
    {
      "t": "00:20",
      "text": "கரெக்டாக வாங்கிக்கோங்க"
    },
    {
      "t": "00:22",
      "text": "ஏன் இதில் காயின் இல்லை"
    },
    {
      "t": "00:24",
      "text": "அப்படியே"
    },
    {
      "t": "00:26",
      "text": "நானோ"
    },
    {
      "t": "00:28",
      "text": "நூலக விதி"
    },
    {
      "t": "00:30",
      "text": "ஆமாம்"
    },
    {
      "t": "00:32",
      "text": "செம்ம மோட்ல தான் இருக்குங்க"
    },
    {
      "t": "00:34",
      "text": "ம்"
    },
    {
      "t": "00:36",
      "text": "சமூகம் உபகாரம்"
    },
    {
      "t": "00:38",
      "text": "அதான் நம்ப சொல்லலாம்"
    },
    {
      "t": "00:40",
      "text": "மேம் என்ன சொல்லுங்கள் அண்ணா"
    },
    {
      "t": "00:42",
      "text": "இயர்"
    },
    {
      "t": "00:44",
      "text": "ம் கை நாச்சும் மழை வருவேன்"
    },
    {
      "t": "00:46",
      "text": "பேஸ்ட் போடுவேன் அவ்வளோ தான்"
    },
    {
      "t": "00:48",
      "text": "சரி உங்களுக்கு கூட விரல் போட்டால்"
    },
    {
      "t": "00:50",
      "text": "கஞ்சி உழுவுமா"
    },
    {
      "t": "00:52",
      "text": "கஞ்சியானது"
    },
    {
      "t": "00:54",
      "text": "போராடுவோம்"
    },
    {
      "t": "00:56",
      "text": "இல்லை இல்லை"
    },
    {
      "t": "00:58",
      "text": "சரி"
    },
    {
      "t": "01:00",
      "text": "வரவேண்டியது வரவேண்டியது"
    },
    {
      "t": "01:02",
      "text": "ம்"
    },
    {
      "t": "01:04",
      "text": "உங்களுக்கு விட்டா உள்ளே விடும்போது எப்படி"
    },
    {
      "t": "01:06",
      "text": "டியூருக்கு ஃபீலு"
    },
    {
      "t": "01:08",
      "text": "சரிப்பா இது பேபி வரும்"
    },
    {
      "t": "01:10",
      "text": "வாயில் ஓட்ட"
    },
    {
      "t": "01:12",
      "text": "அதோட"
    },
    {
      "t": "01:14",
      "text": "சரிங்க மேம்"
    },
    {
      "t": "01:16",
      "text": "ம் ம்"
    },
    {
      "t": "01:18",
      "text": "ம்"
    },
    {
      "t": "01:20",
      "text": "ப்ளீஸ் நம்பர் சொல்லுங்க"
    },
    {
      "t": "01:22",
      "text": "பில்டிங் போகிறது"
    },
    {
      "t": "01:24",
      "text": "ம் ம்"
    },
    {
      "t": "01:26",
      "text": "இஸ் குட் ரீப்ளேஸ் கைண்ட்"
    },
    {
      "t": "01:28",
      "text": "முப்பத்தைந்து"
    },
    {
      "t": "01:30",
      "text": "என்ன நம்ம சொல்லணும்"
    },
    {
      "t": "01:32",
      "text": "ஆமாம்"
    },
    {
      "t": "01:34",
      "text": "எந்த"
    },
    {
      "t": "01:36",
      "text": "ருத்னி"
    },
    {
      "t": "01:38",
      "text": "ஆமாம் மேடம் ம்"
    },
    {
      "t": "01:40",
      "text": "சிறுவனோ மேலே"
    },
    {
      "t": "01:42",
      "text": "பக்கத்தில் தான் எந்த இதுவும் இல்லைங்க"
    },
    {
      "t": "01:44",
      "text": "என்ன"
    },
    {
      "t": "01:46",
      "text": "ஆ போலோ"
    },
    {
      "t": "01:48",
      "text": "ம் ம் வெல் வெரி வெல்"
    },
    {
      "t": "01:50",
      "text": "சரிங்களா"
    },
    {
      "t": "01:52",
      "text": "ஏன் நீ போனவர் வரமாட்டியா"
    },
    {
      "t": "01:54",
      "text": "அவ்வளோ தூரம் வர முடியாது நான் வேலூர்"
    },
    {
      "t": "01:56",
      "text": "இல்லை இங்கே"
    }
  ],
  "full_text": "சரிங்க சார் ஹலோ ஹலோ கேட்குதா வெயிட் பண்ணுங்கள் ம் சீக்கிரமே பச்சையாகவோ அப்புடின்னா பேசலாமா ஓகே கொஞ்சம் நம்பர் சொல்கிறியா கரெக்டாக வாங்கிக்கோங்க ஏன் இதில் காயின் இல்லை அப்படியே நானோ நூலக விதி ஆமாம் செம்ம மோட்ல தான் இருக்குங்க ம் சமூகம் உபகாரம் அதான் நம்ப சொல்லலாம் மேம் என்ன சொல்லுங்கள் அண்ணா இயர் ம் கை நாச்சும் மழை வருவேன் பேஸ்ட் போடுவேன் அவ்வளோ தான் சரி உங்களுக்கு கூட விரல் போட்டால் கஞ்சி உழுவுமா கஞ்சியானது போராடுவோம் இல்லை இல்லை சரி வரவேண்டியது வரவேண்டியது ம் உங்களுக்கு விட்டா உள்ளே விடும்போது எப்படி டியூருக்கு ஃபீலு சரிப்பா இது பேபி வரும் வாயில் ஓட்ட அதோட சரிங்க மேம் ம் ம் ம் ப்ளீஸ் நம்பர் சொல்லுங்க பில்டிங் போகிறது ம் ம் இஸ் குட் ரீப்ளேஸ் கைண்ட் முப்பத்தைந்து என்ன நம்ம சொல்லணும் ஆமாம் எந்த ருத்னி ஆமாம் மேடம் ம் சிறுவனோ மேலே பக்கத்தில் தான் எந்த இதுவும் இல்லைங்க என்ன ஆ போலோ ம் ம் வெல் வெரி வெல் சரிங்களா ஏன் நீ போனவர் வரமாட்டியா அவ்வளோ தூரம் வர முடியாது நான் வேலூர் இல்லை இங்கே",
