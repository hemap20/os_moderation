  "segments": [
    {
      "t": "00:00",
      "text": "ಹೌದು"
    },
    {
      "t": "00:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:04",
      "text": "ಹಲೋ ಎಲ್ಲಿಂದ"
    },
    {
      "t": "00:06",
      "text": "ನಿಮ್ಮದು ಯಾರು"
    },
    {
      "t": "00:08",
      "text": "ಬೆಂಗಳೂರು ಅಥವಾ"
    },
    {
      "t": "00:10",
      "text": "ನಮ್ಮದು ಮೈಸೂರು"
    },
    {
      "t": "00:12",
      "text": "ನಿಮ್ಮ ಹೆಸರು ಶಿವರಾಜ್"
    },
    {
      "t": "00:14",
      "text": "ಸಿಂಗಲ್ ಅಮ್ಯಾರಿಟಾ"
    },
    {
      "t": "00:16",
      "text": "ಯಾವ್ದು"
    },
    {
      "t": "00:18",
      "text": "ಈ ಥರ ಕಲಿಸ್ತೀನಿ"
    },
    {
      "t": "00:20",
      "text": "ಸಿಂಗಲ್"
    },
    {
      "t": "00:22",
      "text": "ಮಿಸ್ ಮಾಡ್ಕೋ"
    },
    {
      "t": "00:24",
      "text": "ಇಲ್ಲ ಸರ್"
    },
    {
      "t": "00:26",
      "text": "ವ್ಯಾಲಿಡ್ ಆಗಿಬಿಟ್ಟಿದೆ ಇಷ್ಟೊತ್ತಲ್ಲಿ ಎಲ್ಲ ವಾಟರ್ ಟ್ಯಾಂಕರ್ ಎಲ್ಲ"
    },
    {
      "t": "00:28",
      "text": "ಎಲ್ಲ ಬಿಡ್ತಾರಾ ಏನು ಸರ್"
    },
    {
      "t": "00:30",
      "text": "ನಿಮಗೆ"
    },
    {
      "t": "00:32",
      "text": "ನಮಗೆ"
    },
    {
      "t": "00:34",
      "text": "ಟ್ವೆಂಟಿ ಸೆವೆನ್ ನಿಮಗೆ"
    },
    {
      "t": "00:36",
      "text": "ಗೀತಾ ಮೂರರಸ ಚಿಕ್ಕವಳಿದ್ದೆ"
    },
    {
      "t": "00:38",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:40",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:42",
      "text": "ಟ್ವೆಂಟಿ ಫೈವ್ ನನಗೆ"
    },
    {
      "t": "00:44",
      "text": "ಮತ್ತೆ"
    },
    {
      "t": "00:46",
      "text": "ಬೇಕು ಅಂತ"
    },
    {
      "t": "00:48",
      "text": "ಮೀನ್ ಮೀನ್ಸ್ ಆವಾಗ್ಲೇ ಎಲ್ರಿಗೂ ಗೊತ್ತಾಗುತ್ತೆ"
    },
    {
      "t": "00:50",
      "text": "ಅಪ್ಪ"
    },
    {
      "t": "00:52",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:54",
      "text": "ಕೊತ್ತಂಬರಿ ಟ್ವೆಂಟಿ ಫೈವ್ ಟ್ವೆಂಟಿ"
    },
    {
      "t": "00:56",
      "text": "ಸಿಗೋಣ ನೀವು"
    },
    {
      "t": "00:58",
      "text": "ಟ್ವೆಂಟಿ ತ್ರೀನಾ"
    },
    {
      "t": "01:00",
      "text": "ಟ್ವೆಂಟಿ ಫೋರು"
    },
    {
      "t": "01:02",
      "text": "ಇಲ್ಲಿ ಕಂಪ್ಲೀಟ್ ಆಗಿಲ್ಲ"
    },
    {
      "t": "01:04",
      "text": "ಹ್ಞೂ ವಿನಂತಿ ಕೇಳ್ಬೋದು"
    },
    {
      "t": "01:06",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:08",
      "text": "ಏನಿದು ಕ್ಯಾಪು"
    },
    {
      "t": "01:10",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:12",
      "text": "ಸೀತಾಯಿ ಹಬ್ಬ"
    },
    {
      "t": "01:14",
      "text": "ಮ್ಯಾಕೋ ಗೌ"
    },
    {
      "t": "01:16",
      "text": "ಔಟ್ರು ಅನಿಸುತ್ತೆ"
    },
    {
      "t": "01:18",
      "text": "ಖಂಡಿತ ಹೌದು ಅದೇ"
    },
    {
      "t": "01:20",
      "text": "ಏನು ಕತ್ತಿರೆ"
    },
    {
      "t": "01:22",
      "text": "ಕೊಡ್ರ"
    },
    {
      "t": "01:24",
      "text": "ಅದು ಹೆಂಗ್ ಗೊತ್ತಾಯ್ತು"
    },
    {
      "t": "01:26",
      "text": "ನಮ್ಮ ಗೌಡ್ರು"
    },
    {
      "t": "01:28",
      "text": "ಕೊಟ್ಟರು ನಾನು ಈಸಿಲಿ ಕ್ಯಾಚ್ ಮಾಡ್ಬೋದು"
    },
    {
      "t": "01:30",
      "text": "ಹೌದು"
    },
    {
      "t": "01:32",
      "text": "ಅದು ಹೇಗೆ ನನಗದು"
    },
    {
      "t": "01:34",
      "text": "ನನ್ಗೆ ಗೊತ್ತಾಗೋಗುತ್ತೆ"
    },
    {
      "t": "01:36",
      "text": "ವಿತಿನ್ ಟೂ ಮಿನಿಟ್ಸಲ್ಲೇ ಗೊತ್ತಾಗುತ್ತೆ"
    },
    {
      "t": "01:38",
      "text": "ಇಲ್ಲ ಇಲ್ಲ ತಾನು"
    },
    {
      "t": "01:40",
      "text": "ಓಕೆ"
    },
    {
      "t": "01:42",
      "text": "ಹಾಯ್ ಕರೆಕ್ಟ್ ಕೇಳ್ರಿ ಓಕೆ"
    },
    {
      "t": "01:44",
      "text": "ಇರ್ತಾನೆ"
    },
    {
      "t": "01:46",
      "text": "ಇಲ್ಲ ಎಸ್ಸಿ"
    },
    {
      "t": "01:48",
      "text": "ಚಾನ್ಸ್ ಇಲ್ಲ"
    },
    {
      "t": "01:50",
      "text": "ಚಾನ್ಸೇ ಇಲ್ಲ ನಾವು ಗೌರ್ಮೆಂಟ್"
    },
    {
      "t": "01:52",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:54",
      "text": "ಅದಕ್ಕೇ ಹೇಳ್ತಿರೋದು ನಾನು ಇರ್ತೀನಿ ಅಂತ"
    },
    {
      "t": "01:56",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:58",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:00",
      "text": "ಹೌದು ಗ್ಯಾಪು"
    },
    {
      "t": "02:02",
      "text": "ಎಂ ಪಿ ಜೆ"
    },
    {
      "t": "02:04",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:06",
      "text": "ಹೇಳಿದ್ರಲ್ಲ ಟೈಮ್ ವೇಸ್ಟ್ಗೆ ಅಂತ ಹೇಳಿ"
    },
    {
      "t": "02:08",
      "text": "ಅರ್ನಿಂಗ್ ಮಾಡಿ ಟೈಮ್ ಪಾಸ್ ಮಾಡ್ಬೇಕಲ್ಲ"
    },
    {
      "t": "02:10",
      "text": "ಬರಬಹುದು"
    },
    {
      "t": "02:12",
      "text": "ಬೆಂಗಳೂರಿಗೆ"
    },
    {
      "t": "02:14",
      "text": "ಬೆಂಗಳೂರಿನಲ್ಲಿ"
    },
    {
      "t": "02:16",
      "text": "ಮೈಸೂರು ಬಂದರೆ ಸಿಗುತ್ತೆ"
    },
    {
      "t": "02:18",
      "text": "ಇರ್ತೀರಾ ಬರ್ತಾನೆ ಇರ್ತೀನಿ ತುಂಬ"
    },
    {
      "t": "02:20",
      "text": "ಹಾಂ ಸರ್ ಎಲ್ಲಿರೋದು"
    },
    {
      "t": "02:22",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:24",
      "text": "ಎಲ್ಲಿ ನಿಂತಿರಾ"
    },
    {
      "t": "02:26",
      "text": "ಅಮ್ಮನ ನೋಡೋಕೆ ಬರ್ತೀನಿ"
    },
    {
      "t": "02:28",
      "text": "ನಿಮ್ಮದು ಬೇಸರ ಆಯ್ತಾ"
    },
    {
      "t": "02:30",
      "text": "ಇಲ್ಲ ತಮ್ಮ"
    },
    {
      "t": "02:32",
      "text": "ಆಂಧ್ರ ಮೈಸೂರು ಚಾಮುಂಡಿ"
    },
    {
      "t": "02:34",
      "text": "ಸರಿ"
    },
    {
      "t": "02:36",
      "text": "ಒಂಬತ್ತಕ್ಕೆ"
    },
    {
      "t": "02:38",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:40",
      "text": "ಸಿಕ್ಕರೆ ಅಂದ್ರೆ ಒಂದು"
    },
    {
      "t": "02:42",
      "text": "ಅಲ್ಲ"
    },
    {
      "t": "02:44",
      "text": "ಆ ಥರ ಎಲ್ಲ ಫ್ರೀಯಾಗಿ"
    },
    {
      "t": "02:46",
      "text": "ಎಲ್ಲ ಬಿಡಲ್ಲ ಬಿಡಿ"
    },
    {
      "t": "02:48",
      "text": "ಮತ್ತೆ ಇವಾಗೇನು ಮನೇಲಿ ಇದ್ರ ಅಥವಾ"
    },
    {
      "t": "02:50",
      "text": "ರೋಡಲ್ಲಿ ಇದ್ದೀರಾ"
    },
    {
      "t": "02:52",
      "text": "ಫ್ರೀಯಾಗಿ ಮಾತಾಡಕ್ಕೆ"
    },
    {
      "t": "02:54",
      "text": "ಹಾಂ ನೈನ್ಟೀನ್ ಇಪ್ಪತ್ತೇಳು ಅಡಿಗಿನೇ"
    },
    {
      "t": "02:56",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:58",
      "text": "ಸಿಂಗಲ್ಲಾ"
    },
    {
      "t": "03:00",
      "text": "ಇಲ್ಲ ಡಬಲ್"
    },
    {
      "t": "03:02",
      "text": "ತಿಳ್ಕೊಳ್ಳಿ"
    },
    {
      "t": "03:04",
      "text": "ಆಯ್ತು"
    },
    {
      "t": "03:06",
      "text": "ಬಿಟ್ಟು ಕರೆಕ್ಟಾಗಿ ಮಾತಾಡಿ"
    },
    {
      "t": "03:08",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:10",
      "text": "ಗೌಡ್ ರೋಡ್"
    },
    {
      "t": "03:12",
      "text": "ಹುಡುಗಿ ರಗಡಾಗಿ ಇರೋದು ಬಿಟ್ಟು"
    },
    {
      "t": "03:14",
      "text": "ಕ್ಲೀನ್ಲೆ ಮಾಡ್ಕೊಂಡಿದ್ಯಾ"
    },
    {
      "t": "03:16",
      "text": "ನಿಮ್ಗೆ ಯಾರು ಹೇಳಿದ್ದು ಗೌತಮ್"
    },
    {
      "t": "03:18",
      "text": "ಏಯ್ ನೀವೇ"
    },
    {
      "t": "03:20",
      "text": "ಕರೆಕ್ಟ್ ಹೇಳು ನಿಜ ಹೇಳು ನಿಜ"
    },
    {
      "t": "03:22",
      "text": "ಸೈಡು ಬಿ ಆನೆಸ್ಟ್"
    },
    {
      "t": "03:24",
      "text": "ಎಸ್"
    },
    {
      "t": "03:26",
      "text": "ಬಿ ಆನೆಸ್ಟ್ ಲೋಟ ತನಕ"
    },
    {
      "t": "03:28",
      "text": "ಲೈಫ್"
    },
    {
      "t": "03:30",
      "text": "ಆಂ"
    },
    {
      "t": "03:32",
      "text": "ಐ ನೀನು ಎಸ್ ಸಿ ಥರ ಕಾಣಿಸ್ತೀಯ"
    },
    {
      "t": "03:34",
      "text": "ಯಾ ಏಯ್"
    },
    {
      "t": "03:36",
      "text": "ತೊಗೊಂಡಿದ್ದು ಬಿಡು ಈಗ"
    },
    {
      "t": "03:38",
      "text": "ಎತ್ತರ ಕಲಿಸ್ರಿ"
    },
    {
      "t": "03:40",
      "text": "ಗೊತ್ತಾಗುತ್ತೆ ಗುರು"
    },
    {
      "t": "03:42",
      "text": "ಹೌದಾ ಹೆಂಗ್ ಗೊತ್ತಾಗುತ್ತೆ"
    },
    {
      "t": "03:44",
      "text": "ಕರೆಕ್ಟ್ ಕೇಳಿ ನಿಮ್ಮ"
    },
    {
      "t": "03:46",
      "text": "ನೀನು ನಾಳೆಗೆ ನೀನು ನಾಳೆಗೆ ಉಳ್ಕೊಂಡು ಅಂದ್ಬಿಡು"
    },
    {
      "t": "03:48",
      "text": "ಕಮ್ಮಿ"
    },
    {
      "t": "03:50",
      "text": "ಆಲೆ ಮುಟ್ಕೊಂಡು ಹೇಳ್ತಿರೋದು"
    },
    {
      "t": "03:52",
      "text": "ಸರಿ"
    },
    {
      "t": "03:54",
      "text": "ಎಸ್ ಸಿ ಕರೆಕ್ಟಾಗಿ ಸಿ"
    },
    {
      "t": "03:56",
      "text": "ಸೀರಿಯಸ್ ಸೀರಿಯಸ್ ಆಗಿ ಓಕೆ ಬೇಸ್"
    },
    {
      "t": "03:58",
      "text": "ಹೌದು ಇಸಲಿ"
    },
    {
      "t": "04:00",
      "text": "ಏನು ಏನು ಏನು ಏನು"
    },
    {
      "t": "04:02",
      "text": "ನೀನು ತಪ್ಪಿ ತೀರಿಸಿದರೆ"
    },
    {
      "t": "04:04",
      "text": "ಬಿಟ್ಟು ಕರೆಕ್ಟಾಗಿ ಮಾತಾಡು"
    },
    {
      "t": "04:06",
      "text": "ಕಬ್ಬಿಣದ ಸ್ಟೀಲ್"
    },
    {
      "t": "04:08",
      "text": "ಮಾಡ್ತಾ ಇದ್ದೀನಿ ಅದನ್ನೇ ಹೇಳಿದ್ನಲ್ಲ"
    },
    {
      "t": "04:10",
      "text": "ಪರ್ಸ್ನಲ್ ಕರೆಕ್ಟಾಗಿ"
    },
    {
      "t": "04:12",
      "text": "ಹೌದಾ"
    },
    {
      "t": "04:14",
      "text": "ಪರ್ಸ್ನಲಿ ಕನೆಕ್ಟ್ ಆಗ್ಬೋದಾ ಅಂದೆ"
    },
    {
      "t": "04:16",
      "text": "ಅಂದರೆ"
    },
    {
      "t": "04:18",
      "text": "ಇಷ್ಟೇ"
    },
    {
      "t": "04:20",
      "text": "ವಾಟ್ಸಪ್ ನಂಬರ್"
    },
    {
      "t": "04:22",
      "text": "ಈ ನಂಬರ್ಗೆ ಕೊಡೋಣ ನೀವು ಮೊದಲೇ"
    },
    {
      "t": "04:24",
      "text": "ಇನ್ಸ್ಟಾ ಇಟ್ಕೊಂಡು ನೀವೇನು ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "04:26",
      "text": "ಹಾಂ"
    },
    {
      "t": "04:28",
      "text": "ಇನ್ಸ್ಟಾ ಇಟ್ಕೊಂಡು ಏನು ಮಾಡ್ತೀರಾ"
    },
    {
      "t": "04:30",
      "text": "ಸೇಸ್"
    },
    {
      "t": "04:32",
      "text": "ನಾರ್ಮಲ್ ಆಗಿ ಸೀರಿಯಸ್ಸಾಗಿ ಬರ್ಲಿಲ್ಲ"
    },
    {
      "t": "04:34",
      "text": "ಏನು"
    },
    {
      "t": "04:36",
      "text": "ಸೇಫ್ ಅಲ್ಲಿ ಇನ್ಸ್ಟಾ ಯೂಸ್ ಮಾಡೋಲ್ಲ"
    },
    {
      "t": "04:38",
      "text": "ಅಯ್ಯೋ"
    },
    {
      "t": "04:40",
      "text": "ತಾಯಿ ದೇವರನ್ನು ತಲುಪಿಸಿ"
    },
    {
      "t": "04:42",
      "text": "ತಲೆ ಮೇಲೆ ಹೊಡಿತೇನೆ ದೇವರು"
    },
    {
      "t": "04:44",
      "text": "ಸೀರೆ ಸೇಗಿರುತ್ತೆ"
    },
    {
      "t": "04:46",
      "text": "ಹೋಗ್ಬಿಟ್ಟು ಅವಾಗ ಕಾಫಿ ಟೀ ಮಾಡಿದ್ದೆ"
    },
    {
      "t": "04:48",
      "text": "ಇಂತ ಇಂತ ಇಂತ"
    },
    {
      "t": "04:50",
      "text": "ಮಾನವ ಸುಳ್ಳು ಹೇಳ್ಬೇಡ"
    },
    {
      "t": "04:52",
      "text": "ಸೀರೆ ಸರಿಯಾಗಿರುತ್ತೆ"
    },
    {
      "t": "04:54",
      "text": "ನಿಜ ಹೇಳ್ಬೇಕು"
    },
    {
      "t": "04:56",
      "text": "ನೋಡುತ್ತೇನೆ"
    },
    {
      "t": "04:58",
