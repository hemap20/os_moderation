{
  "file_id": "rec_audio_call_425348262_audio_1788874390379.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 391.718,
  "processing_time_sec": 1739.1676712036133,
  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:02",
      "text": "ഹലോ"
    },
    {
      "t": "00:04",
      "text": "അടുത്തത്"
    },
    {
      "t": "00:06",
      "text": "ഹലോ ഹലോ"
    },
    {
      "t": "00:08",
      "text": "ഹലോ"
    },
    {
      "t": "00:10",
      "text": "സിദ്ധാന്തം"
    },
    {
      "t": "00:12",
      "text": "ആലപ്പുഴയോടും"
    },
    {
      "t": "00:14",
      "text": "ആ"
    },
    {
      "t": "00:16",
      "text": "സോ"
    },
    {
      "t": "00:18",
      "text": "എനിക്ക് കൺസ്ട്രക്ഷൻ്റെ വർക്ക്"
    },
    {
      "t": "00:20",
      "text": "എനിക്ക് മുപ്പത്തിയഞ്ച് വയസ്സുണ്ട്"
    },
    {
      "t": "00:22",
      "text": "നിങ്ങളെന്തു ചെയ്യുന്നത്"
    },
    {
      "t": "00:24",
      "text": "ഞാൻ പഠിക്കുകയാണ്"
    },
    {
      "t": "00:26",
      "text": "എന്റെ നാല് കൊല്ലമാണ് ഞാനിപ്പോള്"
    },
    {
      "t": "00:28",
      "text": "അപ്പോൾ കോയമ്പത്തൂര്"
    },
    {
      "t": "00:30",
      "text": "എത്ര"
    },
    {
      "t": "00:32",
      "text": "എനിക്ക്"
    },
    {
      "t": "00:34",
      "text": "കൊടുത്തിട്ടുണ്ട് ഏഹ് ദാദാ"
    },
    {
      "t": "00:36",
      "text": "മുപ്പത്തിയഞ്ച് ലക്ഷം"
    },
    {
      "t": "00:38",
      "text": "എത്രയാണ് യാത്ര"
    },
    {
      "t": "00:40",
      "text": "മാരീഡ് ആണ് മാരീഡ്"
    },
    {
      "t": "00:42",
      "text": "എന്ത്"
    },
    {
      "t": "00:44",
      "text": "അയ്യോ അയ്യോ എന്ന് പറഞ്ഞു"
    },
    {
      "t": "00:46",
      "text": "മാരിഡ് ആണെന്ന് പറഞ്ഞു"
    },
    {
      "t": "00:48",
      "text": "മാര്യേഡ് ഒക്കെ നീന്തിയിട്ടില്ലേ"
    },
    {
      "t": "00:50",
      "text": "ഇല്ലില്ല"
    },
    {
      "t": "00:52",
      "text": "പിന്നെ അങ്ങനെ"
    },
    {
      "t": "00:54",
      "text": "ഒന്നുമില്ല എൻ്റെ അടുത്ത് ഈ നിങ്ങളെ കൂട്ടുള്ള ഏജ് ഉള്ള"
    },
    {
      "t": "00:56",
      "text": "പിള്ളേർ വരുമ്പോഴേ നമ്മൾ കല്യാണം കഴിച്ചതാണോ എന്ന് ചോദിച്ചാൽ"
    },
    {
      "t": "00:58",
      "text": "ചോദിക്കുമ്പം ഞാൻ പറയും കല്യാണം കഴിച്ചാൽ"
    },
    {
      "t": "01:00",
      "text": "എനിക്ക് രണ്ട് മക്കളുണ്ട് പിന്നെ"
    },
    {
      "t": "01:02",
      "text": "എന്തായി ആപ്പിളിന് യൂസ്"
    },
    {
      "t": "01:04",
      "text": "ഓ അങ്ങനെയൊന്നും ഞാൻ ചോദിക്കില്ല"
    },
    {
      "t": "01:06",
      "text": "എസ് പി ഒന്ന് നമ്മൾ സംസാരിക്കാമോ"
    },
    {
      "t": "01:08",
      "text": "പട്ടികക്കേരി മംഗളം ആയിരുന്നു"
    },
    {
      "t": "01:10",
      "text": "കേട്ടില്ല"
    },
    {
      "t": "01:12",
      "text": "ഇന്ന്"
    },
    {
      "t": "01:14",
      "text": "പിന്നെ"
    },
    {
      "t": "01:16",
      "text": "എത്ര ദിവസം കഴിഞ്ഞിട്ട്"
    },
    {
      "t": "01:18",
      "text": "ഞാൻ ഒരു വർഷം രണ്ട് മാസമായി"
    },
    {
      "t": "01:20",
      "text": "എങ്ങനെയുണ്ട്"
    },
    {
      "t": "01:22",
      "text": "കുഴപ്പമില്ലടോ"
    },
    {
      "t": "01:24",
      "text": "എന്നും യൂസ് ചെയ്യാറുണ്ട്"
    },
    {
      "t": "01:26",
      "text": "ഉണ്ടോ എന്ന് യൂസ് ചെയ്യാറുണ്ട്"
    },
    {
      "t": "01:28",
      "text": "രണ്ട് മണിക്കൂറും മൂന്ന് മണിക്കൂറും ഒക്കെ"
    },
    {
      "t": "01:30",
      "text": "രീതികൾ ചെയ്യാറുണ്ട്"
    },
    {
      "t": "01:32",
      "text": "ആ"
    },
    {
      "t": "01:34",
      "text": "ഒരു വൈബ് അല്ലേ"
    },
    {
      "t": "01:36",
      "text": "ഐഫ് വീട്ടിലാണ് ഞാൻ വർക്ക് ചെയ്യുന്നത്"
    },
    {
      "t": "01:38",
      "text": "വർക്ക് സൈറ്റിൽ പോകുമ്പോൾ"
    },
    {
      "t": "01:40",
      "text": "നിനക്ക് കോൾ ചെയ്യും നിങ്ങളുടെ കൂട്ടുള്ള ഏജുള്ളവർ"
    },
    {
      "t": "01:42",
      "text": "വരും നല്ല ഏജ് കൂടിയ പത്ത് നാല്പത് വയസ്സ് വരെ"
    },
    {
      "t": "01:44",
      "text": "മുപ്പത് നാല്പത്തിയെട്ട് നാല്പത്തി"
    },
    {
      "t": "01:46",
      "text": "മുപ്പത്തി ഒൻപത് വയസ്സ് വരെയുള്ള ലേഡീസ് വന്നിട്ട്"
    },
    {
      "t": "01:48",
      "text": "മ്മ്"
    },
    {
      "t": "01:50",
      "text": "അല്ല"
    },
    {
      "t": "01:52",
      "text": "എല്ലാവരും പല പല രീതിയിൽ"
    },
    {
      "t": "01:54",
      "text": "ആണ്"
    },
    {
      "t": "01:56",
      "text": "എല്ലാം എയിറ്റ് കോടിയതും എയിറ്റ്"
    },
    {
      "t": "01:58",
      "text": "ഈ പറഞ്ഞതൊന്നും ഒന്നുമില്ല"
    },
    {
      "t": "02:00",
      "text": "ഇന്ന രാത്രി"
    },
    {
      "t": "02:02",
      "text": "കുറേ ക്ലിയറിങ്"
    },
    {
      "t": "02:04",
      "text": "ചെറിയ പിള്ളേർ"
    },
    {
      "t": "02:06",
      "text": "ആ"
    },
    {
      "t": "02:08",
      "text": "അവർ ഓൾറെഡി നമ്മളോട് ഡയറക്റ്റ് ചോദിക്കുന്നുണ്ട്"
    },
    {
      "t": "02:10",
      "text": "എന്ന് പറയുന്ന വീഡിയോ കോള്"
    },
    {
      "t": "02:12",
      "text": "ഏഴു മൂന്ന്"
    },
    {
      "t": "02:14",
      "text": "അവർക്ക് സാമ്പത്തികം"
    },
    {
      "t": "02:16",
      "text": "മ്മ്"
    },
    {
      "t": "02:18",
      "text": "മറ്റൊരു സാമ്പത്തികം"
    },
    {
      "t": "02:20",
      "text": "വേണമെന്നു പറഞ്ഞാൽ തരാം"
    },
    {
      "t": "02:22",
      "text": "ഉം ഉം ഉം"
    },
    {
      "t": "02:24",
      "text": "ഇല്ല മാം"
    },
    {
      "t": "02:26",
      "text": "എടേ ഒരു ലേഡി വാ"
    },
    {
      "t": "02:28",
      "text": "പിന്നെ എന്നോടൊരു ബാംഗ്ലൂരുള്ളതാണ് ഞാൻ"
    },
    {
      "t": "02:30",
      "text": "അതുപോലെ നാഗൂർ"
    },
    {
      "t": "02:32",
      "text": "ലൂസായി വന്നിട്ടുണ്ട് എൻ്റെ ഫ്രണ്ടിൻ്റെ വീട്ടിൽ"
    },
    {
      "t": "02:34",
      "text": "പറ്റി വന്നതാണ് എന്നൊക്കെ പറഞ്ഞ് ഞാൻ"
    },
    {
      "t": "02:36",
      "text": "ആയിട്ട് സംസാരിക്കണമെന്ന് ഞാൻ കുറേ നേരം സംസാരിച്ചു"
    },
    {
      "t": "02:38",
      "text": "എന്നിട്ട് എന്നോട് പറഞ്ഞു"
    },
    {
      "t": "02:40",
      "text": "ഇപ്പോൾ വരാവോ എന്ന് ചോദിച്ചു ഞാൻ പറഞ്ഞു വരാൻ എൻ്റെ ഈ വണ്ടി"
    },
    {
      "t": "02:42",
      "text": "വണ്ടിക്കൂലിക്ക് പോലും കാശില്ല"
    },
    {
      "t": "02:44",
      "text": "എന്താ പറയുക ഇരുന്ന കാറ് അല്ലേ"
    },
    {
      "t": "02:46",
      "text": "അപ്പുറത്തുള്ള പെട്രോൾ അടിക്കണം"
    },
    {
      "t": "02:48",
      "text": "എനിക്ക് ഞാൻ പെട്രോൾ അടിക്കാൻ കാശ് തരാം പക്ഷേ രണ്ടു ദിവസം"
    },
    {
      "t": "02:50",
      "text": "നീ എൻ്റെ കൂടെ നിൽക്കണം"
    },
    {
      "t": "02:52",
      "text": "ഏയ് ആവശ്യത്തിന്"
    },
    {
      "t": "02:54",
      "text": "ഒരു ആവശ്യക്കാര്"
    },
    {
      "t": "02:56",
      "text": "ചിലർ പറയുന്നത്"
    },
    {
      "t": "02:58",
      "text": "പൈസ വേണം"
    },
    {
      "t": "03:00",
      "text": "നമ്പർ"
    },
    {
      "t": "03:02",
      "text": "ഇനി കാശ് കൊടുത്തിട്ട് ഒരു ലേഡി എടുത്ത് പോകേണ്ട കാര്യം"
    },
    {
      "t": "03:04",
      "text": "അതെ"
    },
    {
      "t": "03:06",
      "text": "ഏ"
    },
    {
      "t": "03:08",
      "text": "അതാണ്"
    },
    {
      "t": "03:10",
      "text": "ഞാൻ കല്യാണം കഴി കല്യാണം കഴിച്ച്"
    },
    {
      "t": "03:12",
      "text": "കഴിക്കാൻ ഏഷ്യാനെറ്റ് ലേഡി എടുത്തും പോയിട്ടില്ല"
    },
    {
      "t": "03:14",
      "text": "അവിടെ"
    },
    {
      "t": "03:16",
      "text": "ഒന്നേ പോയിന്റ് ആയിരിക്കും"
    },
    {
      "t": "03:18",
      "text": "പിന്നെ ഇല്ല ഏജ് ഉള്ള ലേഡീസ്"
    },
    {
      "t": "03:20",
      "text": "ആ ആ"
    },
    {
      "t": "03:22",
      "text": "മുപ്പത്തിയഞ്ച്"
    },
    {
      "t": "03:24",
      "text": "വയസ്സുള്ള ലേഡിയായിപ്പോയി ഇരുപത്തിരണ്ടര വയസ്സുള്ള"
    },
    {
      "t": "03:26",
      "text": "ആണ്"
    },
    {
      "t": "03:28",
      "text": "മ്മ്"
    },
    {
      "t": "03:30",
      "text": "രണ്ട് വയസ്സിലുണ്ടായിരുന്നോ"
    },
    {
      "t": "03:32",
      "text": "ആ"
    },
    {
      "t": "03:34",
      "text": "അപ്പം"
    },
    {
      "t": "03:36",
      "text": "സെയിം ആയിരിക്കും"
    },
    {
      "t": "03:38",
      "text": "ആ അത് വൈബാണ്"
    },
    {
      "t": "03:40",
      "text": "ഭയങ്കര അടിപൊളി ഭയങ്കര"
    },
    {
      "t": "03:42",
      "text": "ഓക്കേ"
    },
    {
      "t": "03:44",
      "text": "പുരുഷന്മാർക്ക് പൊതുവേ ഏജ് കൂടിയ"
    },
    {
      "t": "03:46",
      "text": "ഫ്രണ്ട്ഷിപ്പ്"
    },
    {
      "t": "03:48",
      "text": "കൂടാനും ഇഷ്ടം"
    },
    {
      "t": "03:50",
      "text": "മ്മ്"
    },
    {
      "t": "03:52",
      "text": "ആയിരുന്നു ആയിരുന്നു"
    },
    {
      "t": "03:54",
      "text": "പറഞ്ഞാൽ മനസ്സിലായില്ലേ"
    },
    {
      "t": "03:56",
      "text": "യെസ് എൻജോയ് ചെയ്യാൻ പറ്റും"
    },
    {
      "t": "03:58",
      "text": "എന്താണ് ഫുഡ്"
    },
    {
      "t": "04:00",
      "text": "ഏ"
    },
    {
      "t": "04:02",
      "text": "ഉണ്ടാക്കാന് ഇഷ്ടമാണ്"
    },
    {
      "t": "04:04",
      "text": "കേട്ടില്ല ഫുഡ് കഴിക്കാൻ സമയമായി"
    },
    {
      "t": "04:06",
      "text": "വൈകിട്ട് നാല് മണി ആയപ്പം"
    },
    {
      "t": "04:08",
      "text": "ചായ കുടിച്ചു കടി കഴിച്ചു"
    },
    {
      "t": "04:10",
      "text": "ആ"
    },
    {
      "t": "04:12",
      "text": "ഈ പെണ്ണും പിള്ളേരുടെ അടുത്തു ചെല്ലുമ്പോൾ"
    },
    {
      "t": "04:14",
      "text": "ആണോ"
    },
    {
      "t": "04:16",
      "text": "ഓക്കെ കാത്തിരിക്കാം ഓണമൊക്കെ എങ്ങനെയാണ്"
    },
    {
      "t": "04:18",
      "text": "ഉണ്ടായിരുന്നു കുഴപ്പമില്ല അടിപൊളിയാണ്"
    },
    {
      "t": "04:20",
      "text": "കഥ പറയാം"
    },
    {
      "t": "04:22",
      "text": "ഓണോ ശരി"
    },
    {
      "t": "04:24",
      "text": "എത്ര നാളായി ആപ്പ് എടുത്തിട്ട്"
    },
    {
      "t": "04:26",
      "text": "ഞാനിപ്പോൾ ടു വീക്സ് രണ്ടാഴ്ച"
