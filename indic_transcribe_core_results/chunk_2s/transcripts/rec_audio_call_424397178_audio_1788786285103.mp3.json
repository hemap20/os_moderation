      "text": "ಎಲ್ಲಿಂದ ಬ್ಯಾಂಗ್ಳೂರಿಂದ"
    },
    {
      "t": "00:12",
      "text": "ಏನು ಮಾಡ್ತೀರ ದಿ ಏನು ಮಾಡ್ತೀರ"
    },
    {
      "t": "00:14",
      "text": "ಇರೋದು"
    },
    {
      "t": "00:16",
      "text": "ನಾವು ಒಂದು ಪ್ಯಾರಾಟ್ರೋಮ್ ವ್ಯತ್ಯಾಸ ಮಾಡ್ತೀವಿ ನೀವು"
    },
    {
      "t": "00:18",
      "text": "ನಾನು ಹೌಸೆಫ್ ಹೌ"
    },
    {
      "t": "00:20",
      "text": "ಹೌಸ್ ವೈಫ್"
    },
    {
      "t": "00:22",
      "text": "ಯಾವ ಥರ ಮಾಡ್ತಾರೆ ಕಂಟ್ರೋಲ್ ಶೇರ್"
    },
    {
      "t": "00:24",
      "text": "ಇವಾಗ ಮಾತಾಡ್ತಿದ್ದಾಗ"
    },
    {
      "t": "00:26",
      "text": "ನೀವು ಹೇಳಿ"
    },
    {
      "t": "00:28",
      "text": "ಹ್ಞೂ ನೇಮ್ ಹೇಳಿ"
    },
    {
      "t": "00:30",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:32",
      "text": "ನಿಮ್ಗೆ ಯಾವ ಥರ ಮಾತಾಡಕ್ಕೆ ಇಂಟ್ರೆಸ್ಟ್ ಇದೆ ಅಂದರೆ"
    },
    {
      "t": "00:34",
      "text": "ಸೆಕ್ಸು ಅಂದ್ಬಿಟ್ಟು ಬೇರೆ ಏನಾದರೂ ಮ"
    },
    {
      "t": "00:36",
      "text": "ಮಾತಾಡಿ ಮಾತಾಡ್ತೀನಿ"
    },
