{
  "file_id": "rec_audio_call_425384170_audio_1788877922101.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 492.625,
  "processing_time_sec": 1877.534874200821,
  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:02",
      "text": "ഹലോ എവിടുന്നാ"
    },
    {
      "t": "00:04",
      "text": "എണ്ണൂറ് യാതെ വിടുന്നോ"
    },
    {
      "t": "00:06",
      "text": "ഞാനും മംഗലാപുരം"
    },
    {
      "t": "00:08",
      "text": "എന്ത് ചെയ്യുന്നു"
    },
    {
      "t": "00:10",
      "text": "ഞാൻ ബാംഗ്ലൂർ"
    },
    {
      "t": "00:12",
      "text": "കണ്ണൂരിലാണ്"
    },
    {
      "t": "00:14",
      "text": "ഫാർമ കമ്പനിയിലാണ്"
    },
    {
      "t": "00:16",
      "text": "അത്"
    },
    {
      "t": "00:18",
      "text": "നിങ്ങളോ"
    },
    {
      "t": "00:20",
      "text": "നേഴ്സായിട്ട് ജോലി ചെയ്യണം കണ്ണൂർ"
    },
    {
      "t": "00:22",
      "text": "അവരവിടെ വർക്ക് ചെയ്യുന്നത് വീട് കോഴിക്കോട്"
    },
    {
      "t": "00:24",
      "text": "ഓക്കെ ഓക്കെ"
    },
    {
      "t": "00:26",
      "text": "ഓക്കെ ഓക്കെ ആ ഹാ ഹാ"
    },
    {
      "t": "00:28",
      "text": "എങ്ങനെ കമ്പനിയിലൊക്കെ"
    },
    {
      "t": "00:30",
      "text": "ഹോസ്പിറ്റലിലൊക്കെ പോകലുണ്ടോ"
    },
    {
      "t": "00:32",
      "text": "നമ്മളില്ല നമ്മൾ മെഡിസിൻ മാനിഫെസ്റ്റ് ചെയ്യും"
    },
    {
      "t": "00:34",
      "text": "ഫാക്ടറിങ് ചെയ്യാം"
    },
    {
      "t": "00:36",
      "text": "അതെ ഓക്കെ"
    },
    {
      "t": "00:38",
      "text": "സപ്ലൈ"
    },
    {
      "t": "00:40",
      "text": "ജസ്റ്റ് മിസ്സ്"
    },
    {
      "t": "00:42",
      "text": "ഓക്കെ"
    },
    {
      "t": "00:44",
      "text": "ആ"
    },
    {
      "t": "00:46",
      "text": "എങ്ങനെയുണ്ട് ആപ്പ് വഴി"
    },
    {
      "t": "00:48",
      "text": "അപ്പം"
    },
    {
      "t": "00:50",
      "text": "എത്ര ഒരു രണ്ട് ദിവസമായി"
    },
    {
      "t": "00:52",
      "text": "യൂസ് ചെയ്തിട്ട്"
    },
    {
      "t": "00:54",
      "text": "അതൊക്കെ പോട്ടെ ഇളക്കി"
    },
    {
      "t": "00:56",
      "text": "പേരെന്താ എൻ്റെ പേര് ലത്തീഫ്"
    },
    {
      "t": "00:58",
      "text": "നിങ്ങളെന്താ"
    },
    {
      "t": "01:00",
      "text": "ഇയാളുടെ പേരെന്താ ലത്തീഫ്"
    },
    {
      "t": "01:02",
      "text": "എത്ര എത്ര"
    },
    {
      "t": "01:04",
      "text": "എനിക്ക് ഇരുപത്തിയൊന്ന്"
    },
    {
      "t": "01:06",
      "text": "പത്ത് എട്ടായി നിങ്ങൾക്ക്"
    },
    {
      "t": "01:08",
      "text": "എനിക്ക് ട്വന്റി ത്രീ"
    },
    {
      "t": "01:10",
      "text": "ആ മാരീഡ് ആണോ"
    },
    {
      "t": "01:12",
      "text": "അല്ലല്ല സിംഗിളാ"
    },
    {
      "t": "01:14",
      "text": "എങ്കിലോ"
    },
    {
      "t": "01:16",
      "text": "പിന്നെ എന്താ ചെയ്യുക"
    },
    {
      "t": "01:18",
      "text": "അല്ല ആപ്പ് ഉപയോഗിച്ചിട്ട്"
    },
    {
      "t": "01:20",
      "text": "അതിന്റെ എക്സ്പീരിയൻസ് എന്ന് പറഞ്ഞില്ല"
    },
    {
      "t": "01:22",
      "text": "എങ്ങനെ ഉണ്ടായത് കോൾ വസ്തുത കോൾ എങ്ങനെ"
    },
    {
      "t": "01:24",
      "text": "ആയിരുന്നു എല്ലാത്തിനും"
    },
    {
      "t": "01:26",
      "text": "പ്രശ്നമുണ്ടായിരുന്നു സംസാരിച്ചത്"
    },
    {
      "t": "01:28",
      "text": "എന്തെങ്കിലുമൊക്കെ ഒരു സ്റ്റോറി ഉണ്ടാവില്ലേ"
    },
    {
      "t": "01:30",
      "text": "ഒന്നും പറഞ്ഞില്ല അങ്ങനെ"
    },
    {
      "t": "01:32",
      "text": "ഒന്നുമില്ല ഓരോരാൾ ഭയങ്കര"
    },
    {
      "t": "01:34",
      "text": "ഭയങ്കര ക്ലോസ് ആയി സംസാരിക്കും"
    },
    {
      "t": "01:36",
      "text": "പിന്നെ കുറേ ആൾക്കാർ കല്യാണം കഴിക്കും"
    },
    {
      "t": "01:38",
      "text": "കല്യാണം കഴിഞ്ഞാൽ അവർ അവരൊരു ഫീലിംഗ് പറയും"
    },
    {
      "t": "01:40",
      "text": "സീലിംഗ് വെച്ചാൽ സെറ്റ്"
    },
    {
      "t": "01:42",
      "text": "സാ അങ്ങനെ"
    },
    {
      "t": "01:44",
      "text": "അങ്ങനെയല്ല ഒരു അവരുടെ ലൈഫിൻ്റെ"
    },
    {
      "t": "01:46",
      "text": "സ്റ്റോറി ഒക്കെ പറഞ്ഞിട്ടുണ്ടോ"
    },
    {
      "t": "01:48",
      "text": "ഇയാളുടെ ഭാഷ സൂപ്പറായിട്ടുണ്ട് കേട്ടോ"
    },
    {
      "t": "01:50",
      "text": "കേട്ടോ ആണോ"
    },
    {
      "t": "01:52",
      "text": "എനിക്കിഷ്ടമായി"
    },
    {
      "t": "01:54",
      "text": "ആ ഹാ ഹാ ലൈൻ ഉണ്ടോ"
    },
    {
      "t": "01:56",
      "text": "ഏയ് ഇല്ലില്ല"
    },
    {
      "t": "01:58",
      "text": "ആ ആ ഇതൊരു"
    },
    {
      "t": "02:00",
      "text": "ഇതുവരെ"
    },
    {
      "t": "02:02",
      "text": "ഉണ്ടായിട്ടില്ല നമുക്ക് സെറ്റ് ആവില്ല"
    },
    {
      "t": "02:04",
      "text": "നന്ദി"
    },
    {
      "t": "02:06",
      "text": "എന്ത് ഇത് വെച്ചിട്ട് എനിക്ക്"
    },
    {
      "t": "02:08",
      "text": "ലൈൻ സെറ്റ് ആവാതെ ഇരിക്കുന്നതാണ്"
    },
    {
      "t": "02:10",
      "text": "ഉം ഉം ഉം ഉം"
    },
    {
      "t": "02:12",
      "text": "അങ്ങനെയാണ്"
    },
    {
      "t": "02:14",
      "text": "എനിക്ക് മുമ്പുണ്ടായിരുന്നു"
    },
    {
      "t": "02:16",
      "text": "ഇപ്പം ഇല്ല"
    },
    {
      "t": "02:18",
      "text": "മുമ്പുണ്ടായിരുന്നു"
    },
    {
      "t": "02:20",
      "text": "മുമ്പൊരു നാല് വർഷം ലവ് ഉണ്ടായിരുന്നു"
    },
    {
      "t": "02:22",
      "text": "പിന്നെ"
    },
    {
      "t": "02:24",
      "text": "എപ്പോഴേതും അവളെ തേച്ചിട്ട് പോയി"
    },
    {
      "t": "02:26",
      "text": "ആ അതാണ് ഞാൻ പറഞ്ഞത്"
    },
    {
      "t": "02:28",
      "text": "അത് സെറ്റായിട്ട് കാര്യമില്ല അപ്പോൾ ഇയാൾക്ക് സെറ്റായി"
    },
    {
      "t": "02:30",
      "text": "ആയിട്ട് കാണില്ല"
    },
    {
      "t": "02:32",
      "text": "അങ്ങനെ"
    },
    {
      "t": "02:34",
      "text": "മൊത്തം എല്ലാം കറങ്ങിയിരുന്നു"
    },
    {
      "t": "02:36",
      "text": "ഊട്ടി"
    },
    {
      "t": "02:38",
      "text": "കുറേ ദൂരെ ദൂരം"
    },
    {
      "t": "02:40",
      "text": "പിങ്ക് അതല്ലേ"
    },
    {
      "t": "02:42",
      "text": "ടെൻഷൻ അടിക്കാൻ പറ്റില്ല വിഷമിക്കേണ്ട"
    },
    {
      "t": "02:44",
      "text": "അപ്പം ഞാൻ അപ്പം തീരുമാനിച്ചു"
    },
    {
      "t": "02:46",
      "text": "പ്രണയം വേണ്ട"
    },
    {
      "t": "02:48",
      "text": "അത് ആദ്യം"
    },
    {
      "t": "02:50",
      "text": "എനിക്ക് പ്രണയം പോലെ ഉണ്ടായിരുന്നില്ല"
    },
    {
      "t": "02:52",
      "text": "ജസ്റ്റ് ഒരു ബെസ്റ്റ് ഫ്രണ്ട് പോലെ"
    },
    {
      "t": "02:54",
      "text": "ഉണ്ടായിരുന്നു"
    },
    {
      "t": "02:56",
      "text": "ഇങ്ങനെയല്ലേ ബെസ്റ്റ് ഫ്രണ്ടിനെ"
    },
    {
      "t": "02:58",
      "text": "ഒരു കാമുകി ആകുമ്പോൾ അവർ"
    },
    {
      "t": "03:00",
      "text": "വേറെ നമ്മൾ മാറില്ലായിരിക്കും"
    },
    {
      "t": "03:02",
      "text": "പക്ഷേ ആള് മാറും"
    },
    {
      "t": "03:04",
      "text": "ശ്രദ്ധിച്ചിട്ടുണ്ടോ"
    },
    {
      "t": "03:06",
      "text": "അത് നമ്മൾ"
    },
    {
      "t": "03:08",
      "text": "എന്ന് പറഞ്ഞാൽ നമ്മുടെ ബെസ്റ്റ് ഫ്രണ്ട് വരുന്നുണ്ട്"
    },
    {
      "t": "03:10",
      "text": "ഒരു ദിവസം ഇങ്ങനെ"
    },
    {
      "t": "03:12",
      "text": "പോയിരുന്നു പറഞ്ഞു യൂ ടീ പോയിരുന്നു"
    },
    {
      "t": "03:14",
      "text": "ആ ആ ഒരു ദിവസം സ്റ്റേ ചെയ്തു"
    },
    {
      "t": "03:16",
      "text": "ചെയ്യേണ്ടി വന്നു"
    },
    {
      "t": "03:18",
      "text": "ആ സ്റ്റേ എടുക്കും"
    },
    {
      "t": "03:20",
      "text": "കൂടെ ലവ് ആയത്"
    },
    {
      "t": "03:22",
      "text": "അത്"
    },
    {
      "t": "03:24",
      "text": "പ്രണയമാണോ"
    },
    {
      "t": "03:26",
      "text": "അങ്ങനെ ആയത്"
    },
    {
      "t": "03:28",
      "text": "ഓ"
    },
    {
      "t": "03:30",
      "text": "പിന്നെ പ്രണയത്തിന് ഉയർത്തും"
    },
    {
      "t": "03:32",
      "text": "ആ"
    },
    {
      "t": "03:34",
      "text": "പിന്നെ ആള് വേറെ കല്യാണം കഴിച്ചു"
    },
    {
      "t": "03:36",
      "text": "പിന്നെ ആറ് കൊല്ലം കല്യാണം കഴിച്ചിട്ട്"
    },
    {
      "t": "03:38",
      "text": "വേറെ എവിടെ പോയി"
    },
    {
      "t": "03:40",
      "text": "ത്തിട്ടില്ല"
    },
    {
      "t": "03:42",
      "text": "ആ അപ്പാഷ് മട്ടണ്"
    },
    {
      "t": "03:44",
      "text": "ഉണ്ടായിരുന്നു സംസാരിച്ചുകൊണ്ടായിരുന്നു"
    },
    {
      "t": "03:46",
      "text": "കല്യാണത്തിൻ്റെ സമയത്ത് പിന്നെ കല്യാണത്തിൻ്റെ സമയത്ത്"
    },
    {
      "t": "03:48",
      "text": "കല്യാണം കഴിഞ്ഞിട്ട് ഒരു വർഷം കഴിഞ്ഞതിൻ്റെ ശേഷം മാസം"
    },
    {
      "t": "03:50",
      "text": "സജെസ്റ്റ് ചെയ്യാം"
    },
    {
      "t": "03:52",
      "text": "പിന്നെ ഇപ്പോഴും ജസ്റ്റ് ഒരു"
    },
    {
      "t": "03:54",
      "text": "ഫ്രണ്ട്സ് അത്രയേ ഉള്ളൂ"
    },
    {
      "t": "03:56",
      "text": "മീറ്റ്"
    },
    {
      "t": "03:58",
      "text": "അങ്ങനെയൊക്കെ വിളിച്ചാൽ പോവുമോ"
    },
    {
      "t": "04:00",
      "text": "വെളിച്ചവും"
    },
    {
      "t": "04:02",
      "text": "ഇൻഡെപ്ത്"
    },
    {
      "t": "04:04",
      "text": "എത്രത്തില് വേണ്ടാന്നാണ്"
    },
    {
      "t": "04:06",
      "text": "ഇപ്പം ഞാനത് അത് വിട്ടു"
    },
    {
      "t": "04:08",
      "text": "അവരത് വിട്ടു അത് തീർന്നു"
    },
    {
      "t": "04:10",
      "text": "ആ"
    },
    {
      "t": "04:12",
      "text": "ആ"
    },
    {
      "t": "04:14",
      "text": "പിന്നെ"
    },
    {
      "t": "04:16",
      "text": "നിങ്ങൾക്ക് അങ്ങനെ ഒരു എക്സ്പീരിയൻസ് ഉണ്ടായിട്ടില്ലല്ലേ"
    },
    {
      "t": "04:18",
      "text": "എനിക്ക്"
    },
    {
      "t": "04:20",
      "text": "എക്സ്പീരിയൻസ് ഉണ്ടായപ്പോഴാണ് വെച്ചാൽ"
    },
    {
      "t": "04:22",
      "text": "എൻ്റെ ഫ്രണ്ടുകൾക്ക് ഇതൊക്കെ കണ്ടുകൊടുക്കാൻ"
    },
    {
      "t": "04:24",
      "text": "പ്രണയിക്കാൻ തോന്നിയിട്ടില്ല പേടി"
    },
    {
      "t": "04:26",
      "text": "ആ"
    },
    {
      "t": "04:28",
      "text": "ആ"
    },
    {
      "t": "04:30",
      "text": "സെറ്റാവില്ല എന്തുകൊണ്ട്"
    },
    {
      "t": "04:32",
      "text": "ആ"
    },
    {
      "t": "04:34",
      "text": "പിന്നെ വേറെ എക്സ്പീരിയൻസ് ഒന്നും ഇല്ല"
    },
    {
      "t": "04:36",
      "text": "ഉണ്ടായിട്ടില്ലല്ലോ"
    },
    {
      "t": "04:38",
      "text": "ഓഹോ കവി ചോദിക്കും"
    },
    {
      "t": "04:40",
      "text": "അന്ന് ഊട്ടിയിൽ പോയത് പോലെ അങ്ങനെ"
    },
    {
      "t": "04:42",
      "text": "എന്തെങ്കിലും എക്സ്പീരിയൻസ് ആ"
    },
    {
      "t": "04:44",
      "text": "അതെ"
    },
    {
      "t": "04:46",
      "text": "യുദ്ധം വരെ അങ്ങനെ ഉണ്ടായിട്ടില്ല"
    },
    {
      "t": "04:48",
      "text": "അങ്ങനെ ഒരു ഫീലിംഗ് ഉണ്ടായിട്ടില്ല"
    },
    {
      "t": "04:50",
      "text": "അല്ല"
    },
    {
      "t": "04:52",
      "text": "ഫീലിങ്സോ"
    },
    {
      "t": "04:54",
      "text": "മ്മ്"
    },
    {
      "t": "04:56",
      "text": "നിങ്ങൾ ആൺകുട്ടികൾക്ക് ഉണ്ടാവണം"
    },
    {
      "t": "04:58",
      "text": "അതുപോലെ ഒരു പ്രായം എത്തുമ്പോൾ ഒരു"
    },
    {
      "t": "05:00",
      "text": "ഫീലിംഗ്സ് ഇവർക്ക് വരും"
    },
    {
      "t": "05:02",
      "text": "എന്തൊക്കെയുള്ള വെറും തെറ്റിദ്ധാരണയാണ്"
    },
    {
      "t": "05:04",
      "text": "അത് ശരിയാണ് അത് നമ്മളെ പോലെ"
    },
    {
      "t": "05:06",
      "text": "നിങ്ങളുടെ മൈൻഡ് സെറ്റപ്പ് ഉണ്ടാവില്ല വേറെ ആയിരിക്കും"
    },
    {
      "t": "05:08",
      "text": "ആ കാരണം എന്താ വെച്ചാല്"
    },
    {
      "t": "05:10",
      "text": "നമുക്ക് ഒന്നാമത്തെ സെക്സ്"
    },
    {
      "t": "05:12",
      "text": "ഇതിനെ പെട്ടെന്ന് നന്നായിട്ട് അറിയാവുന്നതാണ്"
    },
    {
      "t": "05:14",
      "text": "നന്നായിട്ട് കൗൺസിലിംഗ് കോച്ചിംഗ് ഇതൊക്കെ കിട്ടിയിട്ടുണ്ട്"
    },
    {
      "t": "05:16",
      "text": "പിന്നെ ഒന്നാമത്തെ ഇതിനെ"
    },
    {
      "t": "05:18",
      "text": "പറ്റാ ആലോചിച്ച് ആലോചിച്ച് വീഴും"
    },
    {
      "t": "05:20",
      "text": "ഒക്കെ കണ്ട് ഉൾക്കൊണ്ടൊക്കെ കണ്ട്"
    },
    {
      "t": "05:22",
      "text": "ബോയ് ഫ്രണ്ട് ഒക്കെ ഉള്ളവർക്കൊക്കെയാണ്"
    },
    {
      "t": "05:24",
      "text": "ഓക്കെ ഇതൊന്ന് ട്രൈ ചെയ്ത് നോക്കാം"
    },
    {
      "t": "05:26",
      "text": "എന്ന് വിചാരിച്ചിട്ടാണ് പറഞ്ഞത്"
    },
    {
      "t": "05:28",
      "text": "ഞാൻ എനിക്ക് ഭാഗ്യവശാൽ"
    },
    {
      "t": "05:30",
      "text": "ഇങ്ങനത്തെ സംഭവം ഒന്നും ഉണ്ടായിട്ടില്ല"
    },
    {
      "t": "05:32",
      "text": "അപ്പോൾ ഞാനിപ്പോഴും"
    },
    {
      "t": "05:34",
      "text": "അങ്ങനെ കഥകളൊന്നും ഇല്ലാതായിക്കൊണ്ടിരിക്കുന്നു"
    },
    {
      "t": "05:36",
      "text": "ഓരോരുത്തരുടെ സ്റ്റോറി കേട്ട് ഇരിക്കും"
    },
    {
      "t": "05:38",
      "text": "എന്നാലും ഒറ്റ"
    },
    {
      "t": "05:40",
      "text": "ഒരു ഫീലിംഗ് ഉണ്ടാവില്ലേ ചിലപ്പോൾ"
    },
    {
      "t": "05:42",
      "text": "സദ്യ"
    },
    {
      "t": "05:44",
      "text": "ഇതായിട്ട് നമ്മൾ പറയാറുണ്ട്"
    },
    {
      "t": "05:46",
      "text": "ഓരോ ദിവസം ഇപ്പം എനിക്ക് വേണം അങ്ങനെ"
    },
    {
      "t": "05:48",
      "text": "അതെ ഞാൻ അപ്പോൾ ഞാൻ ഒരു കാര്യം പറയാം"
    },
    {
      "t": "05:50",
      "text": "ഇയാള് വെജിറ്റേറിയൻ ആണ്"
    },
    {
      "t": "05:52",
      "text": "ആണോ അവൻ വെച്ചാണോ"
    },
    {
      "t": "05:54",
      "text": "നോൺ"
    },
    {
      "t": "05:56",
      "text": "മീറ്റ് ആണോ വെജിറ്റേറിയൻ ആണോ"
    },
    {
      "t": "05:58",
      "text": "ഞാൻ മനോജാണ്"
    },
    {
      "t": "06:00",
      "text": "ആ വെജിറ്റേറിയൻ"
    },
    {
      "t": "06:02",
      "text": "പ്രതിഷ്ഠ"
    },
    {
      "t": "06:04",
      "text": "ആ അത് ഇഷ്ടമാണ്"
    },
    {
      "t": "06:06",
      "text": "ആ ടർച്ച് കേൾക്കും ആട് ആട്"
    },
    {
      "t": "06:08",
      "text": "എന്തായിക്കും"
    },
    {
      "t": "06:10",
      "text": "പാമ്പ് കൈക്കോ മലപ്പാമ്പ്"
    },
    {
      "t": "06:12",
      "text": "ഇല്ല ഇല്ല"
    },
    {
      "t": "06:14",
      "text": "ആ അപ്പോൾ ഈ മല"
    },
    {
      "t": "06:16",
      "text": "മലമ്പാമ്പ് കേക്ക് മലമ്പാമ്പ്"
    },
    {
      "t": "06:18",
      "text": "ഇയാൾക്ക് ഫുഡ് ഇയാൾക്ക് ഉണ്ടാക്കി തരാമെന്ന് അറിയില്ല"
    },
    {
      "t": "06:20",
      "text": "ഇയാള് അത് അറപ്പാക്കൂല ഇയാള്"
    },
    {
      "t": "06:22",
      "text": "ആക്കും ആ പക്ഷേ"
    },
    {
      "t": "06:24",
      "text": "കേക്ക് ടേസ്റ്റ് അറിയുന്നവർക്കല്ലേ വീണ്ടും"
    },
    {
      "t": "06:26",
      "text": "വീണ്ടും നിൽക്കാൻ തോന്നുകയുള്ളൂ"
    },
    {
      "t": "06:28",
      "text": "ശരിയാണ് അതേപോലത്തെ കാര്യം"
    },
    {
      "t": "06:30",
      "text": "സെക്സ് ചെയ്ത് വീണ്ടും"
    },
    {
      "t": "06:32",
      "text": "വീണ്ടും വീണ്ടും ചെയ്താൽ"
    },
    {
      "t": "06:34",
      "text": "ചെയ്യാൻ പറ്റും നമ്മൾ അങ്ങനത്തെ ചെയ്തിട്ടുണ്ട്"
    },
    {
      "t": "06:36",
      "text": "നമ്മൾ അതിനെ പറ്റിയിട്ടുള്ള ഇതും ഇല്ല"
    },
    {
      "t": "06:38",
      "text": "അമ്മായിത്തെ ഫീലിങ്സിന് നമ്മൾ പോകുന്നില്ലേ"
    },
    {
      "t": "06:40",
      "text": "ഇല്ല നമ്മൾ ഈ ഓപ്പൺ ടോപ്പ് ഒക്കെ ചെയ്യും"
    },
    {
      "t": "06:42",
      "text": "ചെയ്യുമ്പോഴാണ് നമുക്ക് അങ്ങനത്തെ ഫീലിങ്സ് വരിക"
    },
    {
      "t": "06:44",
      "text": "അത് ആലോചിക്കുമ്പോൾ"
    },
    {
      "t": "06:46",
      "text": "അത് ചെയ്യുമ്പോൾ അല്ലേ"
    },
    {
      "t": "06:48",
      "text": "നിങ്ങളൊക്കെ"
    },
    {
      "t": "06:50",
      "text": "ഒരു അങ്ങനെ ഫീലിങ്സ് വരുന്നുണ്ട്"
    },
    {
      "t": "06:52",
      "text": "എന്ത് നിങ്ങൾക്കൊന്നും ഇല്ല"
    },
    {
      "t": "06:54",
      "text": "അങ്ങനെ"
    },
    {
      "t": "06:56",
      "text": "ഇല്ല എന്നല്ല ഞാനും മനുഷ്യ ജീവിതം"
    },
    {
      "t": "06:58",
      "text": "തന്നെയാണ് പക്ഷെ കല്യാണം"
    },
    {
      "t": "07:00",
      "text": "ഒക്കെ കഴിച്ചാലേ അമ്മക്കാരുണ്ടാവൂ നമുക്കൊരു ആൽബം"
    },
    {
      "t": "07:02",
      "text": "ബോധമില്ലാതെ ഇടൂ അപ്പം എങ്ങനെയാണ് ഫീൽ ചെയ്യുന്നത്"
    },
    {
      "t": "07:04",
      "text": "എന്നാലും ഒരു മസ്റ്റ് എ വിഷൻ അങ്ങനെ ഒരു ഫീൽ"
    },
    {
      "t": "07:06",
      "text": "ഓക്കെ"
    },
    {
      "t": "07:08",
      "text": "എനിക്ക് ഫീലിങ്സ് ഉണ്ട്"
    },
    {
      "t": "07:10",
      "text": "ആ ഇനി അടുത്ത ക്വസ്റ്റ്യൻ ആ ഇനി അടുത്ത"
    },
    {
      "t": "07:12",
      "text": "ഫസ്റ്റ് അല്ല ഞാൻ ചോദിച്ചത് മസ്റ്റ്"
    },
    {
      "t": "07:14",
      "text": "ഒറ്റ പേഷ്യൻ്റിൻ്റെ ഫീലിംഗ് ഉണ്ടോ"
    },
    {
      "t": "07:16",
      "text": "ബേസ്റ്റ് റിതു"
    },
    {
      "t": "07:18",
      "text": "മാസ്റ്റർ വിഷൻ"
    },
    {
      "t": "07:20",
      "text": "എന്ത് കൈകൊണ്ട്"
    },
    {
      "t": "07:22",
      "text": "ചെയ്യുന്നതൊക്കെ"
    },
    {
      "t": "07:24",
      "text": "കോൺസ്റ്റിപ്പേഷനോ"
    },
    {
      "t": "07:26",
      "text": "ഏയ് ഇല്ലില്ല ഞാൻ ചെയ്യുന്നില്ല"
    },
    {
      "t": "07:28",
      "text": "അയ്യോ"
    },
    {
      "t": "07:30",
      "text": "അതിൻ്റെ അകത്ത്"
    },
    {
      "t": "07:32",
      "text": "മ്മ്"
    },
    {
      "t": "07:34",
      "text": "അപ്പോഴേക്കും"
    },
    {
      "t": "07:36",
      "text": "എല്ലാവരും അങ്ങനെ ചെയ്യും നമ്മൾ ഇപ്പോൾ നഴ്സിംഗ്"
    },
    {
      "t": "07:38",
      "text": "പഠിക്കണം ഞാൻ ഗൈനക്കിൻ്റെത് എന്നുള്ളത്"
    },
    {
      "t": "07:40",
      "text": "ഇപ്പോൾ ബോയ്സിന്ന് വെച്ചാൽ"
    },
    {
      "t": "07:42",
      "text": "ചെയ്യണതെന്ന് വെച്ചാൽ അവർക്കത് ചെയ്തില്ലെങ്കിൽ"
    },
    {
      "t": "07:44",
      "text": "ഓട്ടോമാറ്റിക്കലി അത് പോകും"
    },
    {
      "t": "07:46",
      "text": "ആ കുറെ കാലം അപ്പം"
    },
    {
      "t": "07:48",
      "text": "ചെയ്യാതിരുന്നുകഴിഞ്ഞാൽ കാരണം ബോയ്സിനെ വെച്ചാൽ"
    },
    {
      "t": "07:50",
      "text": "ആഴ്ചയിൽ ഒരിക്കൽ ഡെയിലി ചെയ്യേണ്ടത് തന്നെയാണ്"
    },
    {
      "t": "07:52",
      "text": "ആഴ്ചയിലൊക്കെ ഒരിക്കൽ ചെയ്യുന്നത് കുഴപ്പമില്ല"
    },
    {
      "t": "07:54",
      "text": "നല്ലതാണ് പക്ഷേ ഗേൾസിന് വെച്ചാണ് ചെയ്യേണ്ടത്"
    },
    {
      "t": "07:56",
      "text": "ചെയ്യുന്നത് നല്ലതല്ല"
    },
    {
      "t": "07:58",
      "text": "സ്വയം"
    },
    {
      "t": "08:00",
      "text": "സ്വയം ചെയ്യുന്നത് നല്ലതല്ല"
    },
    {
      "t": "08:02",
      "text": "എന്നെങ്കിലും ഒരു പ്രാവശ്യം"
    },
    {
      "t": "08:04",
      "text": "ഓക്കെ"
    },
    {
      "t": "08:06",
      "text": "എന്നെങ്കിലും ഒരു പ്രാവശ്യം ചെയ്യാറില്ല"
    },
    {
      "t": "08:08",
      "text": "പറഞ്ഞ് പറഞ്ഞ് ചെയ്യിപ്പിക്കാനുള്ള"
    },
    {
      "t": "08:10",
      "text": "നല്ല ഭംഗിയാണല്ലോ"
    },
    {
      "t": "08:12",
      "text": "ഓക്കെ"
    }
  ],
  "full_text": "ഹലോ ഹലോ എവിടുന്നാ എണ്ണൂറ് യാതെ വിടുന്നോ ഞാനും മംഗലാപുരം എന്ത് ചെയ്യുന്നു ഞാൻ ബാംഗ്ലൂർ കണ്ണൂരിലാണ് ഫാർമ കമ്പനിയിലാണ് അത് നിങ്ങളോ നേഴ്സായിട്ട് ജോലി ചെയ്യണം കണ്ണൂർ അവരവിടെ വർക്ക് ചെയ്യുന്നത് വീട് കോഴിക്കോട് ഓക്കെ ഓക്കെ ഓക്കെ ഓക്കെ ആ ഹാ ഹാ എങ്ങനെ കമ്പനിയിലൊക്കെ ഹോസ്പിറ്റലിലൊക്കെ പോകലുണ്ടോ നമ്മളില്ല നമ്മൾ മെഡിസിൻ മാനിഫെസ്റ്റ് ചെയ്യും ഫാക്ടറിങ് ചെയ്യാം അതെ ഓക്കെ സപ്ലൈ ജസ്റ്റ് മിസ്സ് ഓക്കെ ആ എങ്ങനെയുണ്ട് ആപ്പ് വഴി അപ്പം എത്ര ഒരു രണ്ട് ദിവസമായി യൂസ് ചെയ്തിട്ട് അതൊക്കെ പോട്ടെ ഇളക്കി പേരെന്താ എൻ്റെ പേര് ലത്തീഫ് നിങ്ങളെന്താ ഇയാളുടെ പേരെന്താ ലത്തീഫ് എത്ര എത്ര എനിക്ക് ഇരുപത്തിയൊന്ന് പത്ത് എട്ടായി നിങ്ങൾക്ക് എനിക്ക് ട്വന്റി ത്രീ ആ മാരീഡ് ആണോ അല്ലല്ല സിംഗിളാ എങ്കിലോ പിന്നെ എന്താ ചെയ്യുക അല്ല ആപ്പ് ഉപയോഗിച്ചിട്ട് അതിന്റെ എക്സ്പീരിയൻസ് എന്ന് പറഞ്ഞില്ല എങ്ങനെ ഉണ്ടായത് കോൾ വസ്തുത കോൾ എങ്ങനെ ആയിരുന്നു എല്ലാത്തിനും പ്രശ്നമുണ്ടായിരുന്നു സംസാരിച്ചത് എന്തെങ്കിലുമൊക്കെ ഒരു സ്റ്റോറി ഉണ്ടാവില്ലേ ഒന്നും പറഞ്ഞില്ല അങ്ങനെ ഒന്നുമില്ല ഓരോരാൾ ഭയങ്കര ഭയങ്കര ക്ലോസ് ആയി സംസാരിക്കും പിന്നെ കുറേ ആൾക്കാർ കല്യാണം കഴിക്കും കല്യാണം കഴിഞ്ഞാൽ അവർ അവരൊരു ഫീലിംഗ് പറയും സീലിംഗ് വെച്ചാൽ സെറ്റ് സാ അങ്ങനെ അങ്ങനെയല്ല ഒരു അവരുടെ ലൈഫിൻ്റെ സ്റ്റോറി ഒക്കെ പറഞ്ഞിട്ടുണ്ടോ ഇയാളുടെ ഭാഷ സൂപ്പറായിട്ടുണ്ട് കേട്ടോ കേട്ടോ ആണോ എനിക്കിഷ്ടമായി ആ ഹാ ഹാ ലൈൻ ഉണ്ടോ ഏയ് ഇല്ലില്ല ആ ആ ഇതൊരു ഇതുവരെ ഉണ്ടായിട്ടില്ല നമുക്ക് സെറ്റ് ആവില്ല നന്ദി എന്ത് ഇത് വെച്ചിട്ട് എനിക്ക് ലൈൻ സെറ്റ് ആവാതെ ഇരിക്കുന്നതാണ് ഉം ഉം ഉം ഉം അങ്ങനെയാണ് എനിക്ക് മുമ്പുണ്ടായിരുന്നു ഇപ്പം ഇല്ല മുമ്പുണ്ടായിരുന്നു മുമ്പൊരു നാല് വർഷം ലവ് ഉണ്ടായിരുന്നു പിന്നെ എപ്പോഴേതും അവളെ തേച്ചിട്ട് പോയി ആ അതാണ് ഞാൻ പറഞ്ഞത് അത് സെറ്റായിട്ട് കാര്യമില്ല അപ്പോൾ ഇയാൾക്ക് സെറ്റായി ആയിട്ട് കാണില്ല അങ്ങനെ മൊത്തം എല്ലാം കറങ്ങിയിരുന്നു ഊട്ടി കുറേ ദൂരെ ദൂരം പിങ്ക് അതല്ലേ ടെൻഷൻ അടിക്കാൻ പറ്റില്ല വിഷമിക്കേണ്ട അപ്പം ഞാൻ അപ്പം തീരുമാനിച്ചു പ്രണയം വേണ്ട അത് ആദ്യം എനിക്ക് പ്രണയം പോലെ ഉണ്ടായിരുന്നില്ല ജസ്റ്റ് ഒരു ബെസ്റ്റ് ഫ്രണ്ട് പോലെ ഉണ്ടായിരുന്നു ഇങ്ങനെയല്ലേ ബെസ്റ്റ് ഫ്രണ്ടിനെ ഒരു കാമുകി ആകുമ്പോൾ അവർ വേറെ നമ്മൾ മാറില്ലായിരിക്കും പക്ഷേ ആള് മാറും ശ്രദ്ധിച്ചിട്ടുണ്ടോ അത് നമ്മൾ എന്ന് പറഞ്ഞാൽ നമ്മുടെ ബെസ്റ്റ് ഫ്രണ്ട് വരുന്നുണ്ട് ഒരു ദിവസം ഇങ്ങനെ പോയിരുന്നു പറഞ്ഞു യൂ ടീ പോയിരുന്നു ആ ആ ഒരു ദിവസം സ്റ്റേ ചെയ്തു ചെയ്യേണ്ടി വന്നു ആ സ്റ്റേ എടുക്കും കൂടെ ലവ് ആയത് അത് പ്രണയമാണോ അങ്ങനെ ആയത് ഓ പിന്നെ പ്രണയത്തിന് ഉയർത്തും ആ പിന്നെ ആള് വേറെ കല്യാണം കഴിച്ചു പിന്നെ ആറ് കൊല്ലം കല്യാണം കഴിച്ചിട്ട് വേറെ എവിടെ പോയി ത്തിട്ടില്ല ആ അപ്പാഷ് മട്ടണ് ഉണ്ടായിരുന്നു സംസാരിച്ചുകൊണ്ടായിരുന്നു കല്യാണത്തിൻ്റെ സമയത്ത് പിന്നെ കല്യാണത്തിൻ്റെ സമയത്ത് കല്യാണം കഴിഞ്ഞിട്ട് ഒരു വർഷം കഴിഞ്ഞതിൻ്റെ ശേഷം മാസം സജെസ്റ്റ് ചെയ്യാം പിന്നെ ഇപ്പോഴും ജസ്റ്റ് ഒരു ഫ്രണ്ട്സ് അത്രയേ ഉള്ളൂ മീറ്റ് അങ്ങനെയൊക്കെ വിളിച്ചാൽ പോവുമോ വെളിച്ചവും ഇൻഡെപ്ത് എത്രത്തില് വേണ്ടാന്നാണ് ഇപ്പം ഞാനത് അത് വിട്ടു അവരത് വിട്ടു അത് തീർന്നു ആ ആ പിന്നെ നിങ്ങൾക്ക് അങ്ങനെ ഒരു എക്സ്പീരിയൻസ് ഉണ്ടായിട്ടില്ലല്ലേ എനിക്ക് എക്സ്പീരിയൻസ് ഉണ്ടായപ്പോഴാണ് വെച്ചാൽ എൻ്റെ ഫ്രണ്ടുകൾക്ക് ഇതൊക്കെ കണ്ടുകൊടുക്കാൻ പ്രണയിക്കാൻ തോന്നിയിട്ടില്ല പേടി ആ ആ സെറ്റാവില്ല എന്തുകൊണ്ട് ആ പിന്നെ വേറെ എക്സ്പീരിയൻസ് ഒന്നും ഇല്ല ഉണ്ടായിട്ടില്ലല്ലോ ഓഹോ കവി ചോദിക്കും അന്ന് ഊട്ടിയിൽ പോയത് പോലെ അങ്ങനെ എന്തെങ്കിലും എക്സ്പീരിയൻസ് ആ അതെ യുദ്ധം വരെ അങ്ങനെ ഉണ്ടായിട്ടില്ല അങ്ങനെ ഒരു ഫീലിംഗ് ഉണ്ടായിട്ടില്ല അല്ല ഫീലിങ്സോ മ്മ് നിങ്ങൾ ആൺകുട്ടികൾക്ക് ഉണ്ടാവണം അതുപോലെ ഒരു പ്രായം എത്തുമ്പോൾ ഒരു ഫീലിംഗ്സ് ഇവർക്ക് വരും എന്തൊക്കെയുള്ള വെറും തെറ്റിദ്ധാരണയാണ് അത് ശരിയാണ് അത് നമ്മളെ പോലെ നിങ്ങളുടെ മൈൻഡ് സെറ്റപ്പ് ഉണ്ടാവില്ല വേറെ ആയിരിക്കും ആ കാരണം എന്താ വെച്ചാല് നമുക്ക് ഒന്നാമത്തെ സെക്സ് ഇതിനെ പെട്ടെന്ന് നന്നായിട്ട് അറിയാവുന്നതാണ് നന്നായിട്ട് കൗൺസിലിംഗ് കോച്ചിംഗ് ഇതൊക്കെ കിട്ടിയിട്ടുണ്ട് പിന്നെ ഒന്നാമത്തെ ഇതിനെ പറ്റാ ആലോചിച്ച് ആലോചിച്ച് വീഴും ഒക്കെ കണ്ട് ഉൾക്കൊണ്ടൊക്കെ കണ്ട് ബോയ് ഫ്രണ്ട് ഒക്കെ ഉള്ളവർക്കൊക്കെയാണ് ഓക്കെ ഇതൊന്ന് ട്രൈ ചെയ്ത് നോക്കാം എന്ന് വിചാരിച്ചിട്ടാണ് പറഞ്ഞത് ഞാൻ എനിക്ക് ഭാഗ്യവശാൽ ഇങ്ങനത്തെ സംഭവം ഒന്നും ഉണ്ടായിട്ടില്ല അപ്പോൾ ഞാനിപ്പോഴും അങ്ങനെ കഥകളൊന്നും ഇല്ലാതായിക്കൊണ്ടിരിക്കുന്നു ഓരോരുത്തരുടെ സ്റ്റോറി കേട്ട് ഇരിക്കും എന്നാലും ഒറ്റ ഒരു ഫീലിംഗ് ഉണ്ടാവില്ലേ ചിലപ്പോൾ സദ്യ ഇതായിട്ട് നമ്മൾ പറയാറുണ്ട് ഓരോ ദിവസം ഇപ്പം എനിക്ക് വേണം അങ്ങനെ അതെ ഞാൻ അപ്പോൾ ഞാൻ ഒരു കാര്യം പറയാം ഇയാള് വെജിറ്