{
  "file_id": "rec_default_427035680_audio_1789034118532.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 180.8760625,
  "processing_time_sec": 757.9585156440735,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "അപ്പോള്"
    },
    {
      "t": "00:04",
      "text": "ഹലോ"
    },
    {
      "t": "00:06",
      "text": "എടാ മാം"
    },
    {
      "t": "00:08",
      "text": "എവിടെയാ സ്ഥലം"
    },
    {
      "t": "00:10",
      "text": "എന്താണ്"
    },
    {
      "t": "00:12",
      "text": "ഏയ് ഇതെവിടെയാണ്"
    },
    {
      "t": "00:14",
      "text": "ഞാൻ രണ്ടുപേരും"
    },
    {
      "t": "00:16",
      "text": "ഞാൻ കൊല്ലാൻ പറ്റുകയും ഇല്ല"
    },
    {
      "t": "00:18",
      "text": "ഓ സൈഫാണ്"
    },
    {
      "t": "00:20",
      "text": "എത്ര ദിവസം ഉണ്ട്"
    },
    {
      "t": "00:22",
      "text": "ട്വന്റി സെവൻ"
    },
    {
      "t": "00:24",
      "text": "അപ്പം അസുഖം എന്താണ്"
    },
    {
      "t": "00:26",
      "text": "എന്താടോ കേട്ടില്ല"
    },
    {
      "t": "00:28",
      "text": "ഹസ്ബൻഡ് എന്താ ചെയ്യുന്നത്"
    },
    {
      "t": "00:30",
      "text": "ചേട്ടൻ നാട്ടിലില്ല"
    },
    {
      "t": "00:32",
      "text": "പട്ടികയുള്ള"
    },
    {
      "t": "00:34",
      "text": "അച്ഛനും വേണ്ട"
    },
    {
      "t": "00:36",
      "text": "പിന്നെ ഞാൻ"
    },
    {
      "t": "00:38",
      "text": "കനം വെളിയിലായിരുന്നു ലീബിന് വന്നത്"
    },
    {
      "t": "00:40",
      "text": "ഓക്കെ എവിടെ"
    },
    {
      "t": "00:42",
      "text": "കുവൈറ്റ്"
    },
    {
      "t": "00:44",
      "text": "എന്താ ചെയ്യുന്നത്"
    },
    {
      "t": "00:46",
      "text": "അക്കൗണ്ട്സ് വർക്ക് ചെയ്യുവായിരുന്നു"
    },
    {
      "t": "00:48",
      "text": "ആപ്പിൽ കുറേ"
    },
    {
      "t": "00:50",
      "text": "ഒരു"
    },
    {
      "t": "00:52",
      "text": "ഹലോ മോനോനോളമസ് ഐക്കൺ"
    },
    {
      "t": "00:54",
      "text": "കാണും കറക്റ്റ് അതിലൂടെ ഇടയ്ക്ക്"
    },
    {
      "t": "00:56",
      "text": "എങ്ങനെയുണ്ട്"
    },
    {
      "t": "00:58",
      "text": "കുഴപ്പമൊന്നുമില്ല"
    },
    {
      "t": "01:00",
      "text": "ഇടയ്ക്കിറങ്ങും"
    },
    {
      "t": "01:02",
      "text": "ഉം ഉള്ളതിൻ്റെ അടിയിലാണ് നല്ലത്"
    },
    {
      "t": "01:04",
      "text": "കൊള്ളാം"
    },
    {
      "t": "01:06",
      "text": "അടിപൊളിയാണല്ലോ എന്ന് പറഞ്ഞാൽ"
    },
    {
      "t": "01:08",
      "text": "അതിനെന്തു അപ്ലൈ ചെയ്തിട്ടുണ്ടായിരുന്നു"
    },
    {
      "t": "01:10",
      "text": "അല്ല അതല്ലേ പറഞ്ഞാൽ അടിപൊളിയാണ്"
    },
    {
      "t": "01:12",
      "text": "ആ മഹാ"
    },
    {
      "t": "01:14",
      "text": "മ്മ് മ്മ്"
    },
    {
      "t": "01:16",
      "text": "ഇയാൾ എന്താ ചെയ്യുന്നത്"
    },
    {
      "t": "01:18",
      "text": "അതുപോലെ"
    },
    {
      "t": "01:20",
      "text": "റുട്ടീൻ"
    },
    {
      "t": "01:22",
      "text": "ഇല്ലേ ഓഫ് ആണോ"
    },
    {
      "t": "01:24",
      "text": "എന്റെ ഷോപ്പ് ആണ് ഞാൻ ഒറ്റയ്ക്കുള്ളൂ"
    },
    {
      "t": "01:26",
      "text": "ആ ഓക്കെ"
    },
    {
      "t": "01:28",
      "text": "ഓക്കെ എന്തുണ്ട് ഷോപ്പാ"
    },
    {
      "t": "01:30",
      "text": "അർച്ചന ഉണ്ട്"
    },
    {
      "t": "01:32",
      "text": "ഫസ്റ്റ് വൺ ഓക്കെ എന്നാൽ പോകണ്ടായിരുന്നു"
    },
    {
      "t": "01:34",
      "text": "ഇല്ല ഞാൻ പോയിട്ടുണ്ട്"
    },
    {
      "t": "01:36",
      "text": "ലൈൻ നമ്പർ"
    },
    {
      "t": "01:38",
      "text": "മ്മ്"
    },
    {
      "t": "01:40",
      "text": "എത്ര വർഷമായി അവിടെ ഷോപ്പായിട്ട്"
    },
    {
      "t": "01:42",
      "text": "ആരുമല്ലേ"
    },
    {
      "t": "01:44",
      "text": "സമയം"
    },
    {
      "t": "01:46",
      "text": "മെമ്മറി സാരി ഉണ്ട് അവിടെ"
    },
    {
      "t": "01:48",
      "text": "ആണോ"
    },
    {
      "t": "01:50",
      "text": "അഡ്രസ്സ് തയ്യാക്ക്"
    },
    {
      "t": "01:52",
      "text": "എനിക്ക് തോന്നുന്നു"
    },
    {
      "t": "01:54",
      "text": "നൈറ്റ് ആണോ അല്ലല്ലോ"
    },
    {
      "t": "01:56",
      "text": "അല്ലല്ല"
    },
    {
      "t": "01:58",
      "text": "ഇല്ല ഇല്ല ഇല്ല"
    },
    {
      "t": "02:00",
      "text": "അതെല്ലാം മാരിഡ് ആയവർക്കും"
    },
    {
      "t": "02:02",
      "text": "ഇതിനകത്ത് കൂടുതൽ മാരിഡ് ആയോ"
    },
    {
      "t": "02:04",
      "text": "ഡിവോഴ്സ് ആയൊരു കുറവാണ് ലേഡീസ്"
    },
    {
      "t": "02:06",
      "text": "ഡിസിൻ്റെ അല്ല ബോയ്സിൻ്റെ ഞാൻ പറഞ്ഞു ഡിസിനെ എനിക്കറിയില്ല"
    },
    {
      "t": "02:08",
      "text": "ഇല്ല"
    },
    {
      "t": "02:10",
      "text": "ഞങ്ങള്"
    },
    {
      "t": "02:12",
      "text": "അങ്ങനൊന്നുമില്ല എന്റെയടുത്ത് എല്ലാ ആൾക്കാരും വേറെ ഉണ്ട്"
    },
    {
      "t": "02:14",
      "text": "ഇരുപത് ഇരുപത് തൊട്ട് മേപ്പാട്ടുള്ളവരാണ്"
    },
    {
      "t": "02:16",
      "text": "ഉണ്ട്"
    },
    {
      "t": "02:18",
      "text": "വില വില കുറയും"
    },
    {
      "t": "02:20",
      "text": "ഇല്ലായ്മ എല്ലാം നടക്കുമല്ലോ"
    },
    {
      "t": "02:22",
      "text": "എന്ത് കട"
    },
    {
      "t": "02:24",
      "text": "എത്രക്കാണ് എണ്ണത്ത്"
    },
    {
      "t": "02:26",
      "text": "ആണോ"
    },
    {
      "t": "02:28",
      "text": "ചേട്ടാ എന്ത് നടക്കാനാണെന്നാണ് ചോദിച്ചത്"
    },
    {
      "t": "02:30",
      "text": "എല്ലാം നമുക്ക്"
    },
    {
      "t": "02:32",
      "text": "ഇതിനകത്ത് ഇതിനകത്ത്"
    },
    {
      "t": "02:34",
      "text": "എല്ലാ ഓമ്പിയ വർത്തമാനങ്ങളും"
    },
    {
      "t": "02:36",
      "text": "ഇതിനകത്ത് കയറുന്ന"
    },
    {
      "t": "02:38",
      "text": "എല്ലാവരും വേറൊന്നുമല്ല"
    },
    {
      "t": "02:40",
      "text": "ഈ സംസാരിക്കത്തേ ഉള്ളൂ എന്ന് പറഞ്ഞാൽ"
    },
    {
      "t": "02:42",
      "text": "പറഞ്ഞാലും പിന്നെ ഓംബിയ വർത്തമാനം കൊണ്ട് വരും"
    },
    {
      "t": "02:44",
      "text": "അത് ആരാണെന്ന് പറഞ്ഞാൽ"
    },
    {
      "t": "02:46",
      "text": "അതാണ് പറഞ്ഞത് ഇതിനകത്ത് എന്തോ"
    },
    {
      "t": "02:48",
      "text": "നടക്കാനാണ് ഇതിനകത്ത് ഷോക്കുകൾ ചെയ്യുന്നവർ"
    },
    {
      "t": "02:50",
      "text": "കാണും എന്നും പറഞ്ഞ് എല്ലാവരും ചെയ്യണമെന്നില്ല"
    },
    {
      "t": "02:52",
      "text": "അതെല്ലാം ചേട്ടൻ പറഞ്ഞില്ലേ"
    },
    {
      "t": "02:54",
      "text": "അല്ല പറഞ്ഞത്"
    },
    {
      "t": "02:56",
      "text": "താന് കൊല്ലംകാരനല്ലേ"
    },
    {
      "t": "02:58",
      "text": "പക്ഷേ നമുക്കറിയാൻ പറ്റും എങ്ങനത്തെ ടോക്കാണ് വരുന്നത്"
    },
    {
      "t": "03:00",
      "text": "എന്നായിരുന്നു കേട്ടോ"
    }
  ],
