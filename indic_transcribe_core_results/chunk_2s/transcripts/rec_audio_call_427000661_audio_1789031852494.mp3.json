  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:02",
      "text": "ആയിരുന്നോ"
    },
    {
      "t": "00:04",
      "text": "ആ"
    },
    {
      "t": "00:06",
      "text": "ഹലോ മൂവി"
    },
    {
      "t": "00:08",
      "text": "ആ കേൾക്കുന്നുണ്ടല്ലേ എവിടെ നിന്നാണ് വിളിക്കുന്നത്"
    },
    {
      "t": "00:10",
      "text": "കണ്ണൂര്"
    },
    {
      "t": "00:12",
      "text": "നൂറ് ഇന്ത്യ"
    },
    {
      "t": "00:14",
      "text": "ആയി"
    },
    {
      "t": "00:16",
      "text": "പിന്നെ റെക്കോർഡിന്റെ പേര് വർക്ക് ചെയ്യാം"
    },
    {
      "t": "00:18",
      "text": "കണ്ണൂര് മേം"
    },
    {
      "t": "00:20",
      "text": "ആ കല്ലേര്"
    },
    {
      "t": "00:22",
      "text": "വില പറക്കടവ്"
    },
    {
      "t": "00:24",
      "text": "ഇയാള്"
    },
    {
      "t": "00:26",
      "text": "ഞാൻ തീർച്ചയായിട്ടും"
    },
    {
      "t": "00:28",
      "text": "സൂര്യന് വർക്ക് ചെയ്യുന്നു"
    },
    {
      "t": "00:30",
      "text": "ആ കൃഷി"
    },
    {
      "t": "00:32",
      "text": "എത്രയാണ്"
    },
    {
      "t": "00:34",
      "text": "ഇതൊരു കെ എച്ച് ഇ ഡി അറിയാം"
    },
    {
      "t": "00:36",
      "text": "ഏ"
    },
    {
      "t": "00:38",
      "text": "കേച്ചേരി ഒരു കേച്ചേരി"
    },
    {
      "t": "00:40",
      "text": "ഇല്ലില്ല മണ്ണിരപ്പിയാണ്"
    },
    {
      "t": "00:42",
      "text": "ആയിട്ട് ബുദ്ധിമുട്ടിച്ചിട്ടുണ്ട്"
    },
    {
      "t": "00:44",
      "text": "ആ ആ"
    },
    {
      "t": "00:46",
      "text": "ആ"
    },
    {
      "t": "00:48",
      "text": "യാത്രക്കറിയായോ"
    },
    {
      "t": "00:50",
      "text": "ഞാനൊരു രണ്ടു മാസം ആവണം"
    },
    {
      "t": "00:52",
      "text": "ഇത് ഞാൻ"
    },
    {
      "t": "00:54",
      "text": "അതെ ഇന്ന് ഓഫ് എടുത്തിരിക്കുകയാണ് ഞാൻ ഒരു കാര്യം"
    },
    {
      "t": "00:56",
      "text": "ഹ്മ്"
    },
    {
      "t": "00:58",
      "text": "മ്മ്"
    },
    {
      "t": "01:00",
      "text": "ആ"
    },
    {
      "t": "01:02",
      "text": "ഉം ആപ്പ് കുറേ എടുത്തിട്ട്"
    },
    {
      "t": "01:04",
      "text": "ഇല്ല ഒരു കാര്യം"
    },
    {
      "t": "01:06",
      "text": "രണ്ടാമത് എടുത്താൽ മതി"
    },
    {
      "t": "01:08",
      "text": "ഉം ഉം ഉം ഉം"
    },
    {
      "t": "01:10",
      "text": "വേറെ എന്താ"
    },
    {
      "t": "01:12",
      "text": "ഉപയോഗിക്കുക"
    },
    {
      "t": "01:14",
      "text": "പിന്നെ"
    },
    {
      "t": "01:16",
      "text": "ഗംഗ"
    },
    {
      "t": "01:18",
      "text": "പിന്നെ"
    },
    {
      "t": "01:20",
      "text": "ഞാനൊരു"
    },
    {
      "t": "01:22",
      "text": "നിർമ്മാണം"
    },
    {
      "t": "01:24",
      "text": "ഓ മാം"
    },
    {
      "t": "01:26",
      "text": "മരണത്തിന് വയസ്സ്"
    },
    {
      "t": "01:28",
      "text": "ഞാൻ തീർച്ചയായിട്ടും"
    },
    {
      "t": "01:30",
      "text": "ട്വന്റി വൺ"
    },
    {
      "t": "01:32",
      "text": "മാരീഡ് ആണോ"
