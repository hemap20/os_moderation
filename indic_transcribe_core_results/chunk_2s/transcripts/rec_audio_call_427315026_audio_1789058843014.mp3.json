    },
    {
      "t": "00:12",
      "text": "கேட்குது கேட்குது வித்தியாசமாக"
    },
    {
      "t": "00:14",
      "text": "அப்படிங்கிறாங்க"
    },
    {
      "t": "00:16",
      "text": "புரியல ஏன் பேச மாட்டேங்கிறீங்க"
    },
    {
      "t": "00:18",
      "text": "இல்லை இல்லை"
    },
    {
      "t": "00:20",
      "text": "எனக்கு ஒழுங்காக டவர் கிடைக்கும்"
    },
    {
      "t": "00:22",
      "text": "கிடைக்கல அதனால்தான் ஓகே ஓகே"
    },
    {
      "t": "00:24",
      "text": "எந்த ஊருங்க"
    },
    {
      "t": "00:26",
      "text": "தஞ்சாவூர் நீங்கள்"
    },
    {
      "t": "00:28",
      "text": "ஆ திருச்சி துறையூருங்க"
    },
    {
      "t": "00:30",
      "text": "சரி சரி"
    },
    {
      "t": "00:32",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "00:34",
      "text": "எத்தனை"
    },
    {
      "t": "00:36",
      "text": "பேர் வருண்"
    },
    {
      "t": "00:38",
      "text": "சரிங்க"
    },
    {
      "t": "00:40",
      "text": "உங்கள் பேர் ரம்யா"
    },
    {
      "t": "00:42",
      "text": "கம்மியாக ஸ்வீட்"
    },
    {
      "t": "00:44",
      "text": "இன்னும் நல்லா தான் இருக்குது"
    },
    {
      "t": "00:46",
      "text": "ம்"
    },
    {
      "t": "00:48",
      "text": "என்ன பண்ணுறீங்க"
    },
    {
      "t": "00:50",
      "text": "இதான் காரில் வந்து பார்க்க உட்கார வைக்கிறேன்"
    },
    {
      "t": "00:52",
      "text": "கலந்துருக்கேன் படுத்துருக்கேன்"
    },
    {
      "t": "00:54",
      "text": "எங்கள் வேலை என்ன பார்க்குறீங்க என்னங்க"
    },
    {
      "t": "00:56",
      "text": "ம்"
    },
    {
      "t": "00:58",
      "text": "ஏழு ஐட்டம் இருக்குதுங்க"
    },
    {
      "t": "01:00",
      "text": "இப்போ தான் உங்கள் டைம் இருக்குமா"
    },
    {
      "t": "01:02",
      "text": "கல்யாணம்"
    },
    {
      "t": "01:04",
      "text": "இல்லைங்க கல்யாணம் ஒன்றும் பண்ணல"
    },
    {
      "t": "01:06",
      "text": "வயசு"
    },
    {
      "t": "01:08",
      "text": "ப்ரைஸ் இருபத்தி நாலு"
    },
    {
      "t": "01:10",
      "text": "சரி சரி"
    },
    {
      "t": "01:12",
      "text": "ம்"
    }
