{
  "file_id": "rec_audio_call_420847903_audio_1788453013104.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 881.739,
  "processing_time_sec": 58.295825719833374,
  "segments": [
    {
      "t": "00:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:02",
      "text": "ஓகே"
    },
    {
      "t": "00:04",
      "text": "ஹலோ"
    },
    {
      "t": "00:06",
      "text": "ஹலோ"
    },
    {
      "t": "00:08",
      "text": "ஹலோ"
    },
    {
      "t": "00:10",
      "text": "ஆமாம்"
    },
    {
      "t": "00:12",
      "text": "ஹலோ கேட்குதா"
    },
    {
      "t": "00:14",
      "text": "ம் இருக்குது"
    },
    {
      "t": "00:16",
      "text": "மாற்றி கழிஞ்சு எந்த ஒரு"
    },
    {
      "t": "00:18",
      "text": "நான் பெங்களூர்லேயும்"
    },
    {
      "t": "00:20",
      "text": "ஓகே"
    },
    {
      "t": "00:22",
      "text": "ஆ பெங்களூரா ஆ பெங்களூர்"
    },
    {
      "t": "00:24",
      "text": "நீங்கள்"
    },
    {
      "t": "00:26",
      "text": "ஆமாம் தமிழ்நாடு மதுரை"
    },
    {
      "t": "00:28",
      "text": "மதுரை"
    },
    {
      "t": "00:30",
      "text": "ம்"
    },
    {
      "t": "00:32",
      "text": "உங்கள் பேர்"
    },
    {
      "t": "00:34",
      "text": "முஸ்லீம் எம் வேல் பிரசாந்த்"
    },
    {
      "t": "00:36",
      "text": "என்னுடைய"
    },
    {
      "t": "00:38",
      "text": "என் பேர் அர்ச்சனா"
    },
    {
      "t": "00:40",
      "text": "ம் கல்யாணம் ஆயிடுச்சா"
    },
    {
      "t": "00:42",
      "text": "ம் அசிங்கம் தான்"
    },
    {
      "t": "00:44",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:46",
      "text": "சிங்கிள் தான்"
    },
    {
      "t": "00:48",
      "text": "ம்"
    },
    {
      "t": "00:50",
      "text": "ம்"
    },
    {
      "t": "00:52",
      "text": "கொஞ்சம் ஒரு மாதிரி டவுட்லாம் கேட்கணும்"
    },
    {
      "t": "00:54",
      "text": "ம் சரி"
    },
    {
      "t": "00:56",
      "text": "இல்லைங்க"
    },
    {
      "t": "00:58",
      "text": "ம்"
    },
    {
      "t": "01:00",
      "text": "கேட்கலாமா"
    },
    {
      "t": "01:02",
      "text": "வேணாமா கேளுங்கள்"
    },
    {
      "t": "01:04",
      "text": "ஓகே"
    },
    {
      "t": "01:06",
      "text": "இல்லை எந்த மாதிரி டவுட்டுன்னு உங்களுக்கு தெரியும்"
    },
    {
      "t": "01:08",
      "text": "ம்"
    },
    {
      "t": "01:10",
      "text": "ம்"
    },
    {
      "t": "01:12",
      "text": "கேட்கவா வேணாமா கேளுங்கள்"
    },
    {
      "t": "01:14",
      "text": "ஓகே"
    },
    {
      "t": "01:16",
      "text": "ம்"
    },
    {
      "t": "01:18",
      "text": "எனக்கு இதுலேயே தோணுச்சு"
    },
    {
      "t": "01:20",
      "text": "கொஞ்சம் ஒரு மாதிரியா இருக்குது எப்படி கேட்கறது"
    },
    {
      "t": "01:22",
      "text": "டிஃபரெண்ட்டாக இல்லை"
    },
    {
      "t": "01:24",
      "text": "ம்"
    },
    {
      "t": "01:26",
      "text": "ம் ஹலோ"
    },
    {
      "t": "01:28",
      "text": "ம்"
    },
    {
      "t": "01:30",
      "text": "சொல்லுங்கள் ஒன்று"
    },
    {
      "t": "01:32",
      "text": "சொல்லுங்கள் நீங்கள்"
    },
    {
      "t": "01:34",
      "text": "எனக்கு கேட்டால் தான் தெரியும்"
    },
    {
      "t": "01:36",
      "text": "நீ"
    },
    {
      "t": "01:38",
      "text": "உங்க வாய்ஸை பார்த்தா கல்யாணம் ஆன மாதிரி தெரியும்"
    },
    {
      "t": "01:40",
      "text": "ம்"
    },
    {
      "t": "01:42",
      "text": "ஓகே"
    },
    {
      "t": "01:44",
      "text": "ஹலோ ஹலோ"
    },
    {
      "t": "01:46",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "01:48",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "01:50",
      "text": "சரிங்க சார்"
    },
    {
      "t": "01:52",
      "text": "ஹலோ"
    },
    {
      "t": "01:54",
      "text": "ஹலோ"
    },
    {
      "t": "01:56",
      "text": "எக்ஸாம் ம் கேட்குது"
    },
    {
      "t": "01:58",
      "text": "சரிங்க"
    },
    {
      "t": "02:00",
      "text": "இல்லை நீங்கள்"
    },
    {
      "t": "02:02",
      "text": "எப்படி ஆரம்பிக்கிறது"
    },
    {
      "t": "02:04",
      "text": "தெரியலையே நீங்களே கொஞ்சம் ஆரம்பிக்கிறீங்களா"
    },
    {
      "t": "02:06",
      "text": "சரிங்க சார்"
    },
    {
      "t": "02:08",
      "text": "ம்"
    },
    {
      "t": "02:10",
      "text": "இல்லை இல்லை"
    },
    {
      "t": "02:12",
      "text": "சரிங்க ஐயா"
    },
    {
      "t": "02:14",
      "text": "என்ன பிடிக்கும்"
    },
    {
      "t": "02:16",
      "text": "ஓகேங்க ஓகே"
    },
    {
      "t": "02:18",
      "text": "சாப்பிட்டீங்க"
    },
    {
      "t": "02:20",
      "text": "எல்லாமே பிடிக்கும் உங்களுக்கு"
    },
    {
      "t": "02:22",
      "text": "எனக்கு என்ன"
    },
    {
      "t": "02:24",
      "text": "படிக்கலாம்"
    },
    {
      "t": "02:26",
      "text": "ம் என்ன கலர் ட்ரெஸ் போட்டிருக்கீங்க"
    },
    {
      "t": "02:28",
      "text": "ம்"
    },
    {
      "t": "02:30",
      "text": "நல்லா ரெட்டு கலரு எல்லாம்"
    },
    {
      "t": "02:32",
      "text": "ரெட் கலரு"
    },
    {
      "t": "02:34",
      "text": "ரெட் எல்லோ ரெட் ஃப்ளவர்"
    },
    {
      "t": "02:36",
      "text": "பவர்ஸு எல்லாம்"
    },
    {
      "t": "02:38",
      "text": "ஓ"
    },
    {
      "t": "02:40",
      "text": "கோவமாக பேசுகிற மாதிரி இருக்கே"
    },
    {
      "t": "02:42",
      "text": "என்னங்க"
    },
    {
      "t": "02:44",
      "text": "அப்புறம்"
    },
    {
      "t": "02:46",
      "text": "ஆ"
    },
    {
      "t": "02:48",
      "text": "ஓமா பேசுகிறீங்களா"
    },
    {
      "t": "02:50",
      "text": "இல்லைங்க நார்மலாக தானே"
    },
    {
      "t": "02:52",
      "text": "பேசிட்டு இருக்கேன்"
    },
    {
      "t": "02:54",
      "text": "ம்"
    },
    {
      "t": "02:56",
      "text": "சரி இல்லை இருக்கீங்களா"
    },
    {
      "t": "02:58",
      "text": "நைட்டில் இருக்கீங்களா"
    },
    {
      "t": "03:00",
      "text": "நைட் வேலை தான் இருக்குது"
    },
    {
      "t": "03:02",
      "text": "சரிங்க சார்"
    },
    {
      "t": "03:04",
      "text": "ம் ஓகே ஓகே"
    },
    {
      "t": "03:06",
      "text": "சூப்பர் எல்லா கலர் நைட்டி"
    },
    {
      "t": "03:08",
      "text": "ஹலோ"
    },
    {
      "t": "03:10",
      "text": "சொன்னீங்களா எல்லோ கலரு வித் ரெட்டு"
    },
    {
      "t": "03:12",
      "text": "ம்"
    },
    {
      "t": "03:14",
      "text": "ப்ரோமோ பேசுகிறாங்க ப்ரோமோ"
    },
    {
      "t": "03:16",
      "text": "ம்"
    },
    {
      "t": "03:18",
      "text": "வேறு அடுத்த கேள்வி கேட்கவா"
    },
    {
      "t": "03:20",
      "text": "ம் சரிங்க"
    },
    {
      "t": "03:22",
      "text": "ம் என்ன"
    },
    {
      "t": "03:24",
      "text": "என்ன கலர் போட்டிருக்கீங்க"
    },
    {
      "t": "03:26",
      "text": "இலக்குவன்"
    },
    {
      "t": "03:28",
      "text": "சார் நைட்டி"
    },
    {
      "t": "03:30",
      "text": "ம்"
    },
    {
      "t": "03:32",
      "text": "சரிங்க சார்"
    },
    {
      "t": "03:34",
      "text": "வேற"
    },
    {
      "t": "03:36",
      "text": "ஓகே"
    },
    {
      "t": "03:38",
      "text": "ம்"
    },
    {
      "t": "03:40",
      "text": "வேறு என்ன கல்வி போட்டிருந்தீங்க"
    },
    {
      "t": "03:42",
      "text": "வேற"
    },
    {
      "t": "03:44",
      "text": "என்ன கலரு வேறு என்ன போட்டிருக்கீங்கன்னு கேட்குறேன்"
    },
    {
      "t": "03:46",
      "text": "ம்"
    },
    {
      "t": "03:48",
      "text": "வேறு என்ன ப்ராப்ளம்"
    },
    {
      "t": "03:50",
      "text": "போட்டுருக்க முடியல"
    },
    {
      "t": "03:52",
      "text": "ம் சொல்லுங்கள்"
    },
    {
      "t": "03:54",
      "text": "கீழே பாவாடை கட்டியிருக்கேன்"
    },
    {
      "t": "03:56",
      "text": "ஓகே"
    },
    {
      "t": "03:58",
      "text": "ஓகே"
    },
    {
      "t": "04:00",
      "text": "என்ன கலர் போட்டிருக்கீங்க ரெண்டுமே"
    },
    {
      "t": "04:02",
      "text": "மாவாடை அப்புறம் எல்லாம்"
    },
    {
      "t": "04:04",
      "text": "கலர்"
    },
    {
      "t": "04:06",
      "text": "ம்"
    },
    {
      "t": "04:08",
      "text": "அப்புறம்"
    },
    {
      "t": "04:10",
      "text": "சரிங்க சார்"
    },
    {
      "t": "04:12",
      "text": "சரிங்க சார்"
    },
    {
      "t": "04:14",
      "text": "ஹலோ"
    },
    {
      "t": "04:16",
      "text": "ம்"
    },
    {
      "t": "04:18",
      "text": "அது என்ன கலர்"
    },
    {
      "t": "04:20",
      "text": "அதுவும் எல்லோ கலர் சொன்னேன்"
    },
    {
      "t": "04:22",
      "text": "ம்"
    },
    {
      "t": "04:24",
      "text": "மேலே"
    },
    {
      "t": "04:26",
      "text": "மேடம் எல்லாம்"
    },
    {
      "t": "04:28",
      "text": "எல்லாமே எல்லோ கலர்"
    },
    {
      "t": "04:30",
      "text": "உள்ளேயும் எல்லோரும் தானா"
    },
    {
      "t": "04:32",
      "text": "ம்"
    },
    {
      "t": "04:34",
      "text": "ஃபுல்லாக எல்லா கலர்"
    },
    {
      "t": "04:36",
      "text": "என்ன வேலைவா"
    },
    {
      "t": "04:38",
      "text": "ம்"
    },
    {
      "t": "04:40",
      "text": "ம்"
    },
    {
      "t": "04:42",
      "text": "உங்களுக்கு எத்தனை வயசு"
    },
    {
      "t": "04:44",
      "text": "சரி"
    },
    {
      "t": "04:46",
      "text": "எனக்கு டுவெண்ட்டி ஃபைவ்"
    },
    {
      "t": "04:48",
      "text": "டுவெண்ட்டி ஃபைவ்"
    },
    {
      "t": "04:50",
      "text": "இதுவரைக்கும் யாரு கூட இல்லை"
    },
    {
      "t": "04:52",
      "text": "பழகிருக்கீங்களா"
    },
    {
      "t": "04:54",
      "text": "ரெண்டு வருஷத்துக்கு"
    },
    {
      "t": "04:56",
      "text": "முன்னால் வருவோம் ஃப்ரெண்டு இருந்தாங்க"
    },
    {
      "t": "04:58",
      "text": "ம்"
    },
    {
      "t": "05:00",
      "text": "அங்கே கூட"
    },
    {
      "t": "05:02",
      "text": "டாக்கிங் ஏகேசிங் எல்லாம் பண்ணியிருக்கேன்"
    },
    {
      "t": "05:04",
      "text": "எப்படி"
    },
    {
      "t": "05:06",
      "text": "என்ன பண்ணியிருக்கீங்க"
    },
    {
      "t": "05:08",
      "text": "அப்படிங்கிற கேஸு இங்கேல்லாம் பண்ணியிருக்கேன்"
    },
    {
      "t": "05:10",
      "text": "ஓகே"
    },
    {
      "t": "05:12",
      "text": "பண்ணிருக்கீங்களா சரி"
    },
    {
      "t": "05:14",
      "text": "யூஸ் பண்ணிடுவீங்களா என்ன சார்"
    },
    {
      "t": "05:16",
      "text": "செலவு பண்ணலை மேரேஜ் பண்ணிடணும்"
    },
    {
      "t": "05:18",
      "text": "அமௌண்ட் இருந்தான்"
    },
    {
      "t": "05:20",
      "text": "வீட்டில் பேசியிருந்தாங்க பேச்சு"
    },
    {
      "t": "05:22",
      "text": "சுபாவத்தை நல்லா இருந்துருந்துச்சு"
    },
    {
      "t": "05:24",
      "text": "அதுக்கப்புறம் முதல்ல ஒத்துக்கிட்டாங்க"
    },
    {
      "t": "05:26",
      "text": "அதுக்கப்புறமா ரெண்டாவது வாட்டி ஆமாம்"
    },
    {
      "t": "05:28",
      "text": "மாப்பிள்ளை வீட்டில்"
    },
    {
      "t": "05:30",
      "text": "பேரண்ட்ஸ் அங்கேலாம் வேண்டாம்னு சொல்லிவிட்டாங்க"
    },
    {
      "t": "05:32",
      "text": "கிறிஸ்டியான நாங்கள் வந்து நல்லா"
    },
    {
      "t": "05:34",
      "text": "அவங்க"
    },
    {
      "t": "05:36",
      "text": "கிறிஸ்ட்டியன் பொண்ணு தான் தேவைன்னு சொல்லி"
    },
    {
      "t": "05:38",
      "text": "இன்னொரு செட் பண்ணிவிட்டாங்க"
    },
    {
      "t": "05:40",
      "text": "சரி ஓகே"
    },
    {
      "t": "05:42",
      "text": "ம்"
    },
    {
      "t": "05:44",
      "text": "சரிங்க சார்"
    },
    {
      "t": "05:46",
      "text": "சரி உங்கள் வாட்ஸ்அப் நம்பர் கிடைக்குமா"
    },
    {
      "t": "05:48",
      "text": "ம்"
    },
    {
      "t": "05:50",
      "text": "வேண்டியதில்லை பேசுங்கள்"
    },
    {
      "t": "05:52",
      "text": "எஸ்"
    },
    {
      "t": "05:54",
      "text": "எப்படி பேசுனால் உங்களுக்கு பே பண்ண முடியும் நான் ஏதோ"
    },
    {
      "t": "05:56",
      "text": "உங்களுக்கு ஏதோ பே பண்ணி விட்டு உங்களை விட்டு"
    },
    {
      "t": "05:58",
      "text": "ம்"
    },
    {
      "t": "06:00",
      "text": "எதாவது அமௌன்ட் பே பண்ணி"
    },
    {
      "t": "06:02",
      "text": "பண்ணிட்டு வீடியோ காலில் பார்க்குறேனே"
    },
    {
      "t": "06:04",
      "text": "வீடியோ காலேஜ்"
    },
    {
      "t": "06:06",
      "text": "யார் பேச சொன்னாலும் பேசுவேன் நார்மலாக தான்"
    },
    {
      "t": "06:08",
      "text": "அதான் பேசிகிட்டு இருக்கோம்"
    },
    {
      "t": "06:10",
      "text": "ம் இல்லைங்கண்ணா"
    },
    {
      "t": "06:12",
      "text": "இப்போ ஒரு இரநூறுவா ஐநூறுவா பே பண்ணி"
    },
    {
      "t": "06:14",
      "text": "பண்ணிட்டு அவங்கள வீடியோ கார்டில் பார்க்கலாம்ல அதான்"
    },
    {
      "t": "06:16",
      "text": "சரிங்க சார்"
    },
    {
      "t": "06:18",
      "text": "ம் ம் ம் ம்"
    },
    {
      "t": "06:20",
      "text": "சும்மா பேசுறேன்னா நார்மல்"
    },
    {
      "t": "06:22",
      "text": "கால் பேசுவாங்களா"
    },
    {
      "t": "06:24",
      "text": "இந்த அந்த மாதிரி பண்ண முடியாது"
    },
    {
      "t": "06:26",
      "text": "சரிங்க"
    },
    {
      "t": "06:28",
      "text": "ம்"
    },
    {
      "t": "06:30",
      "text": "என்னங்க ப்ரோ"
    },
    {
      "t": "06:32",
      "text": "அந்த மாதிரியெல்லாம் இல்லைங்க"
    },
    {
      "t": "06:34",
      "text": "இந்தியன் சமயம்"
    },
    {
      "t": "06:36",
      "text": "அந்த மாதிரி இல்லையா"
    },
    {
      "t": "06:38",
      "text": "ம்"
    },
    {
      "t": "06:40",
      "text": "ம் சரிங்க"
    },
    {
      "t": "06:42",
      "text": "வித்யார்த்தி ஜெனரல் ஆமாம் சார் இப்போ பேச"
    },
    {
      "t": "06:44",
      "text": "அப்புறமா வேகமாக சப்ளை பண்ணு"
    },
    {
      "t": "06:46",
      "text": "சரி அதுக்குள்ளேயே அது பண்ணிவிட்டு"
    },
    {
      "t": "06:48",
      "text": "பண்ணிருக்கீங்களா"
    },
    {
      "t": "06:50",
      "text": "அதான் சொன்னேங்க பண்ணதில்லை என்கிட்ட"
    },
    {
      "t": "06:52",
      "text": "செக்ஸ் பண்ணுங்கள்"
    },
    {
      "t": "06:54",
      "text": "அதெல்லாம் ஃப்ரெஷ்ஷு தவிர வேறு எதுவும் பண்ணிங்க"
    },
    {
      "t": "06:56",
      "text": "ம்"
    },
    {
      "t": "06:58",
      "text": "பண்ணுற காசு இருக்கா"
    },
    {
      "t": "07:00",
      "text": "ம் பண்ணலாம்"
    },
    {
      "t": "07:02",
      "text": "பண்ணலாமா பண்ணணும்னு ஒரு ஆசை இருக்கும்"
    },
    {
      "t": "07:04",
      "text": "ம் நன்றிங்க"
    },
    {
      "t": "07:06",
      "text": "ம்"
    },
    {
      "t": "07:08",
      "text": "இல்லைங்க சும்மா பேசிக்கலாம்"
    },
    {
      "t": "07:10",
      "text": "பேசுவோம் ஜாலியாக பேசுவோம் மனசில் பேசுவோம்"
    },
    {
      "t": "07:12",
      "text": "ஆமாம் மேடம்"
    },
    {
      "t": "07:14",
      "text": "சரி"
    },
    {
      "t": "07:16",
      "text": "நீங்கள் ஒல்லியா இருக்கீங்களா குண்டா இருக்கீங்களா உங்களை பற்றி"
    },
    {
      "t": "07:18",
      "text": "நான் வர்ணிப்பேன்"
    },
    {
      "t": "07:20",
      "text": "நம்ம மீடியமாக"
    },
    {
      "t": "07:22",
      "text": "ம்"
    },
    {
      "t": "07:24",
      "text": "சரி என்ன சைஸ் போட்டு"
    },
    {
      "t": "07:26",
      "text": "போடுறீங்க உள்ள"
    },
    {
      "t": "07:28",
      "text": "சைடு தேர்ட்டி"
    },
    {
      "t": "07:30",
      "text": "சரி ஓகே"
    },
    {
      "t": "07:32",
      "text": "இல்லை"
    },
    {
      "t": "07:34",
      "text": "கேளாட்டினுட்டி"
    },
    {
      "t": "07:36",
      "text": "நைன்டீன்"
    },
    {
      "t": "07:38",
      "text": "நைன்ட்டி"
    },
    {
      "t": "07:40",
      "text": "சரி ஓகே"
    },
    {
      "t": "07:42",
      "text": "எனக்கு ஒரே மூடர்"
    },
    {
      "t": "07:44",
      "text": "ம்"
    },
    {
      "t": "07:46",
      "text": "எனக்கு கொஞ்சம் மூடாக இருக்குது"
    },
    {
      "t": "07:48",
      "text": "மூடார்க்கா"
    },
    {
      "t": "07:50",
      "text": "ம்"
    },
    {
      "t": "07:52",
      "text": "ம்"
    },
    {
      "t": "07:54",
      "text": "ம் ஆ"
    },
    {
      "t": "07:56",
      "text": "பசங்ககளை சாரிங்க"
    },
    {
      "t": "07:58",
      "text": "எனக்கு வந்து ஒரு அந்த மூடு வந்து"
    },
    {
      "t": "08:00",
      "text": "ஒரு மாதிரி பிஹேவ் பண்ணுவாங்க அந்த மாதிரி பண்ணி"
    },
    {
      "t": "08:02",
      "text": "மன்னிச்சிக்கோங்க"
    },
    {
      "t": "08:04",
      "text": "ம் பேசுகிறேன்"
    },
    {
      "t": "08:06",
      "text": "அங்கே"
    },
    {
      "t": "08:08",
      "text": "எனக்கு ரொம்ப பிடிச்சிருக்குங்க"
    },
    {
      "t": "08:10",
      "text": "ம்"
    },
    {
      "t": "08:12",
      "text": "ஓ ம்"
    },
    {
      "t": "08:14",
      "text": "எம்பி படிச்சிருக்கேன்"
    },
    {
      "t": "08:16",
      "text": "ஐ லவ் யூ"
    },
    {
      "t": "08:18",
      "text": "நெய்யை போட்டு தருவீங்க"
    },
    {
      "t": "08:20",
      "text": "ம்"
    },
    {
      "t": "08:22",
      "text": "என்ன"
    },
    {
      "t": "08:24",
      "text": "ஹலோ"
    },
    {
      "t": "08:26",
      "text": "இல்லை"
    },
    {
      "t": "08:28",
      "text": "உங்களை கற்பனை பண்ணிட்டுருக்கேன் நான்"
    },
    {
      "t": "08:30",
      "text": "எப்படி இருப்பீங்க நான்"
    },
    {
      "t": "08:32",
      "text": "ம் ம்"
    },
    {
      "t": "08:34",
      "text": "ஹலோ"
    },
    {
      "t": "08:36",
      "text": "ஹலோ"
    },
    {
      "t": "08:38",
      "text": "ஹலோ"
    },
    {
      "t": "08:40",
      "text": "கேட்குதான்"
    },
    {
      "t": "08:42",
      "text": "ம்"
    },
    {
      "t": "08:44",
      "text": "ஹலோ"
    },
    {
      "t": "08:46",
      "text": "ஹலோ"
    },
    {
      "t": "08:48",
      "text": "ம்"
    },
    {
      "t": "08:50",
      "text": "கேட்குதா"
    },
    {
      "t": "08:52",
      "text": "ம் கேட்குது"
    },
    {
      "t": "08:54",
      "text": "ஐயோ எனக்கு"
    },
    {
      "t": "08:56",
      "text": "ஒரு மாதிரியா இருக்குங்க"
    },
    {
      "t": "08:58",
      "text": "ஆமாம்"
    },
    {
      "t": "09:00",
      "text": "பேசுங்கள்"
    },
    {
      "t": "09:02",
      "text": "நீங்கள் பேசாதீங்களா கொஞ்சம் முறை"
    },
    {
      "t": "09:04",
      "text": "சரிங்க சார்"
    },
    {
      "t": "09:06",
      "text": "சரிங்க சார்"
    },
    {
      "t": "09:08",
      "text": "ஹலோ"
    },
    {
      "t": "09:10",
      "text": "சரிங்க சார்"
    },
    {
      "t": "09:12",
      "text": "சரிங்க சார்"
    },
    {
      "t": "09:14",
      "text": "சரிங்க சார்"
    },
    {
      "t": "09:16",
      "text": "சரிங்க சார்"
    },
    {
      "t": "09:18",
      "text": "ஹலோ ஹலோ"
    },
    {
      "t": "09:20",
      "text": "ம் சொல்லுங்கள்"
    },
    {
      "t": "09:22",
      "text": "ஓகே"
    },
    {
      "t": "09:24",
      "text": "ம்"
    },
    {
      "t": "09:26",
      "text": "ஹலோ"
    },
    {
      "t": "09:28",
      "text": "ஆமாம்"
    },
    {
      "t": "09:30",
      "text": "கேட்குதா ம் கேட்குது"
    },
    {
      "t": "09:32",
      "text": "அவ்வளோதான்"
    },
    {
      "t": "09:34",
      "text": "நம்பர் தரீங்களா ப்ளீஸ்"
    },
    {
      "t": "09:36",
      "text": "இப்போ தான் சொன்னேன்"
    },
    {
      "t": "09:38",
      "text": "நான் இதிலே பேசுகிறேன் சொல்லிட்டு"
    },
    {
      "t": "09:40",
      "text": "அப்போ இதில் பேசுனவங்க"
    },
    {
      "t": "09:42",
      "text": "கொஞ்சம் நல்லா பேச மாட்றீங்களே"
    },
    {
      "t": "09:44",
      "text": "அதனால தான்"
    },
    {
      "t": "09:46",
      "text": "சவுண்டே கேட்கறது தான்"
    },
    {
      "t": "09:48",
      "text": "ம் ஆமாம் நீங்கள்"
    },
    {
      "t": "09:50",
      "text": "சரி"
    },
    {
      "t": "09:52",
      "text": "ரொம்ப ஓப்பனாக கேட்குறேன் உங்கள்கிட்ட"
    },
    {
      "t": "09:54",
      "text": "ம்"
    },
    {
      "t": "09:56",
      "text": "ரெண்டாயிரம் ரூபா ஆகுது தானே"
    },
    {
      "t": "09:58",
      "text": "என்னங்க"
    },
    {
      "t": "10:00",
      "text": "அண்ட்"
    },
    {
      "t": "10:02",
      "text": "ரூபா அமௌண்ட் தரேன் வீடியோ கால் வரைக்கும்"
    },
    {
      "t": "10:04",
      "text": "ம் ரெண்டாயிரம்"
    },
    {
      "t": "10:06",
      "text": "கொடுக்கற மாதிரி எழுதிக்கங்க எனக்கு"
    },
    {
      "t": "10:08",
      "text": "மயாங்க"
    },
    {
      "t": "10:10",
      "text": "ஜமா"
    },
    {
      "t": "10:12",
      "text": "யாரும் கொடுக்க மாட்டாங்க ரெண்டாயிரம் விற்க யாரும்"
    },
    {
      "t": "10:14",
      "text": "சாப்பிட சொன்னீங்க"
    },
    {
      "t": "10:16",
      "text": "என்ன நான் தரேன் எனக்கு வீடியோ கால் பண்ணுங்கள்"
    },
    {
      "t": "10:18",
      "text": "சரிங்க சார்"
    },
    {
      "t": "10:20",
      "text": "நான் இப்போ தான் சொன்னேன் வீடியோக்காரங்களுக்கு"
    },
    {
      "t": "10:22",
      "text": "பேசு பேசு நார்மல் பா"
    },
    {
      "t": "10:24",
      "text": "அதுலயே பேசு வேணாம் பேசுங்கன்னு சொன்னேன்"
    },
    {
      "t": "10:26",
      "text": "என்ன"
    },
    {
      "t": "10:28",
      "text": "பார்த்தா தானே நல்லா அழகாக பார்க்க முடியும்"
    },
    {
      "t": "10:30",
      "text": "முடியுங்கிறதுதான் ஆனால்"
    },
    {
      "t": "10:32",
      "text": "அவ்வளோ அளவாக எடுக்க மாட்டேங்க அதுக்கு மேலே"
    },
    {
      "t": "10:34",
      "text": "சாரி"
    },
    {
      "t": "10:36",
      "text": "கருத்துரு மாநகராட்சி"
    },
    {
      "t": "10:38",
      "text": "நல்லா தான் இருக்கும்"
    },
    {
      "t": "10:40",
      "text": "சரி நான் நல்லா"
    },
    {
      "t": "10:42",
      "text": "கொஞ்சம் ஒரு மாதிரியாக பேசட்டுமா"
    },
    {
      "t": "10:44",
      "text": "ம்"
    },
    {
      "t": "10:46",
      "text": "கொஞ்சம் பேட் வொர்க்"
    },
    {
      "t": "10:48",
      "text": "பேர்ட்ஸ் யூஸ் பண்ணி பேசட்டுமா"
    },
    {
      "t": "10:50",
      "text": "ம்"
    },
    {
      "t": "10:52",
      "text": "ம்"
    },
    {
      "t": "10:54",
      "text": "வேணாமா"
    },
    {
      "t": "10:56",
      "text": "சரிங்க சார்"
    },
    {
      "t": "10:58",
      "text": "நீங்கள் அமௌண்ட் போட்டோன்னா சொல்லுங்கள்"
    },
    {
      "t": "11:00",
      "text": "நல்லா போட்டு கொடுப்போம் முதல்ல போடுங்கள்"
    },
    {
      "t": "11:02",
      "text": "நீ"
    },
    {
      "t": "11:04",
      "text": "இப்படிலாம் பேசுனீங்கன்னா நீ"
    },
    {
      "t": "11:06",
      "text": "வீடியோ கால்ல ஃபுல்லா வர்றீங்கன்னா சொல்லுங்க நான்"
    },
    {
      "t": "11:08",
      "text": "உங்களுக்கு ரெடி பண்ணுறேன் ரெண்டாயிரம் ரூபா"
    },
    {
      "t": "11:10",
      "text": "த்ரீ"
    },
    {
      "t": "11:12",
      "text": "இல்லை இல்லை இல்லை ரொம்ப நன்றி நன்றி"
    },
    {
      "t": "11:14",
      "text": "மாத்திர காமிக்கும் அவ்வளோ தான் சும்மா"
    },
    {
      "t": "11:16",
      "text": "பேசும் ஜாலியாக பேசும் அவ்வளோ தான்"
    },
    {
      "t": "11:18",
      "text": "ரொமான்ஸாக பேசணும் அவ்வளோ தான்"
    },
    {
      "t": "11:20",
      "text": "மேலே மட்டும் காமிச்சு"
    },
    {
      "t": "11:22",
      "text": "படிக்கிறதான்னா ஃபைவ் ஹண்ட்ரட்"
    },
    {
      "t": "11:24",
      "text": "சரிங்க சார்"
    },
    {
      "t": "11:26",
      "text": "ஓகேவா ம்"
    },
    {
      "t": "11:28",
      "text": "சரி ஓகே"
    },
    {
      "t": "11:30",
      "text": "ஆமாம்லேயா ஜம்மா"
    },
    {
      "t": "11:32",
      "text": "ம் ஃபர்ஸ்ட் பே பண்ணு"
    },
    {
      "t": "11:34",
      "text": "வணக்கம்"
    },
    {
      "t": "11:36",
      "text": "ஏமாத்திட்டீங்கன்னா"
    },
    {
      "t": "11:38",
      "text": "ஏமாத்த மாட்டானே நீங்க சொன்னீங்க"
    },
    {
      "t": "11:40",
      "text": "சொன்னது நீங்கள் சொல்கிற நம்பிக்கை அதுதான் நான்"
    },
    {
      "t": "11:42",
      "text": "நானே வரேன் இப்போ நல்லா டெய்லாக இருக்கும் வந்துருக்கு"
    },
    {
      "t": "11:44",
      "text": "ஆமாம் ஸ்டார்ட்"
    },
    {
      "t": "11:46",
      "text": "அப்படின்னு சொல்லிட்டேனே"
    },
    {
      "t": "11:48",
      "text": "எனக்கு கீழே பார்த்தா தாங்க வரும்"
    },
    {
      "t": "11:50",
      "text": "அப்புறம் அதுதான் கேட்குறேன் கீழே"
    },
    {
      "t": "11:52",
      "text": "ஆ தெலுங்கு நட்சத்திரம்"
    },
    {
      "t": "11:54",
      "text": "கேளுங்கள் எல்லாம்"
    },
    {
      "t": "11:56",
      "text": "மேலே மட்டும் தானா"
    },
    {
      "t": "11:58",
      "text": "மட்டும்தான் வேலைக்கு அனுப்பிக்கிறோம் அவ்வளோதான்"
    },
    {
      "t": "12:00",
      "text": "ம்"
    },
    {
      "t": "12:02",
      "text": "சரி"
    },
    {
      "t": "12:04",
      "text": "சரி ஒரு நிமிஷம்"
    },
    {
      "t": "12:06",
      "text": "ஹலோ"
    },
    {
      "t": "12:08",
      "text": "ம்"
    },
    {
      "t": "12:10",
      "text": "சரிங்க சார்"
    },
    {
      "t": "12:12",
      "text": "நீ எப்படி"
    },
    {
      "t": "12:14",
      "text": "எப்படி இருப்பேன்னு பார்த்து நான் வந்து பண்ணிகிட்டு இருக்கேன்"
    },
    {
      "t": "12:16",
      "text": "ம்"
    },
    {
      "t": "12:18",
      "text": "ஹலோ"
    },
    {
      "t": "12:20",
      "text": "ம்"
    },
    {
      "t": "12:22",
      "text": "உங்களை நானும்"
    },
    {
      "t": "12:24",
      "text": "சரிங்க சார்"
    },
    {
      "t": "12:26",
      "text": "ஹலோ"
    },
    {
      "t": "12:28",
      "text": "கேட்க மாட்டேங்குது சார்"
    },
    {
      "t": "12:30",
      "text": "இதுவே கொரல்"
    },
    {
      "t": "12:32",
      "text": "ஐ லவ் யூ லவ் யூ"
    },
    {
      "t": "12:34",
      "text": "ம்"
    },
    {
      "t": "12:36",
      "text": "லவ் யூ"
    },
    {
      "t": "12:38",
      "text": "லவ் யூ"
    },
    {
      "t": "12:40",
      "text": "உங்களுக்கு"
    },
    {
      "t": "12:42",
      "text": "படுக்கணும் போல் இருக்குவோம் கூட"
    },
    {
      "t": "12:44",
      "text": "ம் ஆ"
    },
    {
      "t": "12:46",
      "text": "ஹலோ"
    },
    {
      "t": "12:48",
      "text": "ம்"
    },
    {
      "t": "12:50",
      "text": "உன் கூட படுக்கணும் போல இருக்க"
    },
    {
      "t": "12:52",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "12:54",
      "text": "ம்"
    },
    {
      "t": "12:56",
      "text": "ஆ"
    },
    {
      "t": "12:58",
      "text": "ஹலோ"
    },
    {
      "t": "13:00",
      "text": "சரிங்க சார்"
    },
    {
      "t": "13:02",
      "text": "சரிங்க சார்"
    },
    {
      "t": "13:04",
      "text": "ஹலோ ம்"
    },
    {
      "t": "13:06",
      "text": "சாரி"
    },
    {
      "t": "13:08",
      "text": "ஹலோ"
    },
    {
      "t": "13:10",
      "text": "ம்"
    },
    {
      "t": "13:12",
      "text": "போட்டிருந்தா சொல்லுங்க நான்"
    },
    {
      "t": "13:14",
      "text": "கொடுக்குறேன்"
    },
    {
      "t": "13:16",
      "text": "நம்பர் சொல்லுங்கள்"
    },
    {
      "t": "13:18",
      "text": "சொல்கிறீங்களா"
    },
    {
      "t": "13:20",
      "text": "ம் உங்கள்கிட்ட ஃபோன் பே இருக்குது"
    },
    {
      "t": "13:22",
      "text": "ஆ என்கிட்ட ஜீப் எதுவும்"
    },
    {
      "t": "13:24",
      "text": "இது ஆக்டிவேட் ஆகிட்டேன்"
    },
    {
      "t": "13:26",
      "text": "யா அது"
    },
    {
      "t": "13:28",
      "text": "இது கொஞ்சம் ப்ராப்ளம் ஆயிட்டு இருக்குது ஜிபே தான்"
    },
    {
      "t": "13:30",
      "text": "இந்த ஆக்டிவிட்டி இல்லாமல் போயிட்டுருக்குது"
    },
    {
      "t": "13:32",
      "text": "சரி"
    },
    {
      "t": "13:34",
      "text": "ஃபோன் போயிருக்கேன்"
    },
    {
      "t": "13:36",
      "text": "ஃபோன்பே"
    },
    {
      "t": "13:38",
      "text": "ம்"
    },
    {
      "t": "13:40",
      "text": "இருக்குது சரி"
    },
    {
      "t": "13:42",
      "text": "இப்போ ஃபோன் பேலே பே பண்ணுறீங்களா"
    },
    {
      "t": "13:44",
      "text": "நம்பர் சொல்லுங்கள்"
    },
    {
      "t": "13:46",
      "text": "நோட் பண்ணிக்கிறேன்"
    },
    {
      "t": "13:48",
      "text": "ஐயோ அம்மா"
    },
    {
      "t": "13:50",
      "text": "ம்"
    },
    {
      "t": "13:52",
      "text": "நைன் செவன்"
    },
    {
      "t": "13:54",
      "text": "நைன் செவன் த்ரீ நைன் ஜீரோ"
    },
    {
      "t": "13:56",
      "text": "டூ த்ரீ"
    },
    {
      "t": "13:58",
      "text": "நைன் ஜீரோ சிக்ஸ் ஃபோர்"
    },
    {
      "t": "14:00",
      "text": "சிக்ஸ் ஃபோர்"
    },
    {
      "t": "14:02",
      "text": "நைன் டபுள் ஒன்"
    },
    {
      "t": "14:04",
      "text": "இந்த"
    },
    {
      "t": "14:06",
      "text": "மறுபடியும் சொல்லுங்கள் நோட் பண்ணிக்கிறேன்"
    },
    {
      "t": "14:08",
      "text": "நைன் செவன்"
    },
    {
      "t": "14:10",
      "text": "எதுவும் கவர்மெண்ட் சார்"
    },
    {
      "t": "14:12",
      "text": "சரிங்க சார்"
    },
    {
      "t": "14:14",
      "text": "ம்"
    },
    {
      "t": "14:16",
      "text": "நைன் செவன்"
    },
    {
      "t": "14:18",
      "text": "த்ரீ நைன் ஜீரோ"
    },
    {
      "t": "14:20",
      "text": "த்ரீ நைன் ஜீரோ"
    },
    {
      "t": "14:22",
      "text": "சிக்ஸ் ஃபோர்"
    },
    {
      "t": "14:24",
      "text": "சிக்ஸ் ஃபோர் நைன் டபுள்"
    },
    {
      "t": "14:26",
      "text": "ம்"
    },
    {
      "t": "14:28",
      "text": "நயன் டபுள் ஒன்"
    },
    {
      "t": "14:30",
      "text": "சரி ஓகே ஆ"
    },
    {
      "t": "14:32",
      "text": "ஃபோன் பே பண்ணிவிட்டு நம்மளுக்கு ஃபோன் அடிக்கணும் இந்த நம்பருக்கு"
    },
    {
      "t": "14:34",
      "text": "ம் சரி"
    },
    {
      "t": "14:36",
      "text": "க்ளோஸ் பண்ணாதான் அது ஓப்பன் ஆகும்"
    },
    {
      "t": "14:38",
      "text": "ஓய் நகைத்தான்"
    },
    {
      "t": "14:40",
      "text": "அது"
