    },
    {
      "t": "01:34",
      "text": "ಹೆಣ್ಣು ಮಕ್ಕಳು ರೀ"
    },
    {
      "t": "01:36",
      "text": "ನಾವೆಲ್ಲ ಹಂಗೆಲ್ಲ ಮಾಡಬಾರ್ದು"
