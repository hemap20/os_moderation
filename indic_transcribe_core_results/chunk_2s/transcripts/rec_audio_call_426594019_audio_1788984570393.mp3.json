{
  "file_id": "rec_audio_call_426594019_audio_1788984570393.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 293.927,
  "processing_time_sec": 21.771942615509033,
  "segments": [
    {
      "t": "00:00",
      "text": "హలో"
    },
    {
      "t": "00:02",
      "text": "హాయ్"
    },
    {
      "t": "00:04",
      "text": "అయ్యో అయ్యో ఏమైంది"
    },
    {
      "t": "00:06",
      "text": "విజయవాడ మురళికొండ నుంచి అండి"
    },
    {
      "t": "00:08",
      "text": "నాకు భీమవరం అండి"
    },
    {
      "t": "00:10",
      "text": "అమ్మ బాబోయ్"
    },
    {
      "t": "00:12",
      "text": "ఎస్"
    },
    {
      "t": "00:14",
      "text": "ఏమండి అలా అంటున్నారు"
    },
    {
      "t": "00:16",
      "text": "భీమవరం అమ్మాయిలు"
    },
    {
      "t": "00:18",
      "text": "వెరీ ఇంటెలిజెంట్ టాలెంట్"
    },
    {
      "t": "00:20",
      "text": "చూడండి వాళ్ళతో మేము మాట్లాడలేం"
    },
    {
      "t": "00:22",
      "text": "అందుకని అలాగ అనుకోవడమే తప్ప"
    },
    {
      "t": "00:24",
      "text": "మీ అంత ఇంటెలిజెంట్ మీ అంత"
    },
    {
      "t": "00:26",
      "text": "టాలెంట్ మాకు ఉండదు కదా"
    },
    {
      "t": "00:28",
      "text": "అలాగే అయ్యబాబోయ్ మేము చాలా"
    },
    {
      "t": "00:30",
      "text": "మా తెలుగు ఇండియాలో అండి బీహార్ వాళ్ళు"
    },
    {
      "t": "00:32",
      "text": "అబ్బో"
    },
    {
      "t": "00:34",
      "text": "ఫోన్లో తెలివైన వాళ్ళము తెలివైన వాళ్ళము కాదు"
    },
    {
      "t": "00:36",
      "text": "కాదు మా వీడియో కాల్ యాక్సెప్ట్"
    },
    {
      "t": "00:38",
      "text": "ఏంటి తెలుస్తుందో"
    },
    {
      "t": "00:40",
      "text": "వద్దండి ఈ యాప్లో మాట్లాడొచ్చు కదా"
    },
    {
      "t": "00:42",
      "text": "అవ్వ"
    },
    {
      "t": "00:44",
      "text": "ఈ అప్లమ్ మార్కెట్"
    },
    {
      "t": "00:46",
      "text": "ఎట్లా అండి"
    },
    {
      "t": "00:48",
      "text": "యాప్లోనే అంటున్నా కదా నేనున్న వీడియో"
    },
    {
      "t": "00:50",
      "text": "జీవితకాలం యాక్సెప్ట్ చేయమని మాకు"
    },
    {
      "t": "00:52",
      "text": "వీడియో కాల్ ఆప్షన్ లేదండి"
    },
    {
      "t": "00:54",
      "text": "ఎందుకు ఉండదండి"
    },
    {
      "t": "00:56",
      "text": "ఎన్ ఎగ్జాక్ట్లీ"
    },
    {
      "t": "00:58",
      "text": "బటన్ వస్తుందో ఆన్ చేయండి"
    },
    {
      "t": "01:00",
      "text": "ఏం లేదండి"
    },
    {
      "t": "01:02",
      "text": "ఆ ఆప్షన్ నేను తీసుకోలేదండి"
    },
    {
      "t": "01:04",
      "text": "యా"
    },
    {
      "t": "01:06",
      "text": "ఆప్షన్ తీసుకోవాల్సిన అవసరం లేదండి"
    },
    {
      "t": "01:08",
      "text": "ఆటోమేటిక్గా ఉంటుంది అందరికి ఉన్న"
    },
    {
      "t": "01:10",
      "text": "వేద"
    },
    {
      "t": "01:12",
      "text": "దానిలో"
    },
    {
      "t": "01:14",
      "text": "ఐ యామ్ నాట్ ఇంట్రెస్టెడ్ దానికి"
    },
    {
      "t": "01:16",
      "text": "అలాగే"
    },
    {
      "t": "01:18",
      "text": "చెప్తే సరిపోద్ది కదా"
    },
    {
      "t": "01:20",
      "text": "ఆప్షన్ లేదని చెప్పడం ఎందుకు"
    },
    {
      "t": "01:22",
      "text": "అంటే నాది కీప్యాడ్"
    },
    {
      "t": "01:24",
      "text": "హెడ్ఫోన్ లాంటి ఏదో చిన్న"
    },
    {
      "t": "01:26",
      "text": "నా శాంసంగ్ ఎప్పుడు"
    },
    {
      "t": "01:28",
      "text": "ఇంకో ఫోన్ ఉండే"
    },
    {
      "t": "01:30",
      "text": "ప్యాక్"
    },
    {
      "t": "01:32",
      "text": "అరే ఎందుకు చిన్న"
    },
    {
      "t": "01:34",
      "text": "కీప్యాడ్ అంటుంటే మరి అన్లోడ్"
    },
    {
      "t": "01:36",
      "text": "నూట యాభై ఎలాగ ఎక్కించారు చెప్పండి"
    },
    {
      "t": "01:38",
      "text": "ఆహా యాప్కి"
    },
    {
      "t": "01:40",
      "text": "ప్యాడ్ కాదండి చిన్న శాంపుల్"
    },
    {
      "t": "01:42",
      "text": "సామ్సంగ్ ఫోన్ అండి"
    },
    {
      "t": "01:44",
      "text": "దానికి కెమెరా సరిగ్గా పనిచేయదు"
    },
    {
      "t": "01:46",
      "text": "అందుకని వీళ్ళు"
    },
    {
      "t": "01:48",
      "text": "చెప్పండి అంతేగాని"
    },
    {
      "t": "01:50",
      "text": "అవి అలా యాడ్ అయ్యి"
    },
    {
      "t": "01:52",
      "text": "వీడియో కాల్ యాక్ట్ చేయండి వీడియో కాల్"
    },
    {
      "t": "01:54",
      "text": "చేయడానికి అవ్వదు అని చెప్తున్నారు కదా"
    },
    {
      "t": "01:56",
      "text": "ఏవండీ నేను ఏదో"
    },
    {
      "t": "01:58",
      "text": "చిన్న ఉద్యోగస్తుడు అండి"
    },
    {
      "t": "02:00",
      "text": "ఎంత"
    },
    {
      "t": "02:02",
      "text": "నేలకు"
    },
    {
      "t": "02:04",
      "text": "నాకు"
    },
    {
      "t": "02:06",
      "text": "పన్నెండు వేలు వస్తుందండి"
    },
    {
      "t": "02:08",
      "text": "మేడం"
    },
    {
      "t": "02:10",
      "text": "అంత కష్టమైనప్పుడు యాప్ ఎందుకు డౌన్లోడ్"
    },
    {
      "t": "02:12",
      "text": "చేసుకోవడం"
    },
    {
      "t": "02:14",
      "text": "ఎవరో ఫ్రెండ్ వాడు మాట్లాడుతున్నాడు"
    },
    {
      "t": "02:16",
      "text": "వెళ్ళకుండా చేశాడండి"
    },
    {
      "t": "02:18",
      "text": "నెక్స్ట్"
    },
    {
      "t": "02:20",
      "text": "ఈ మధ్య"
    },
    {
      "t": "02:22",
      "text": "మాట్లాడుకుందాం కాసేపు సర్లే"
    },
    {
      "t": "02:24",
      "text": "సరదాగా ఆడియో కాల్ అవుతుంది కదా"
    },
    {
      "t": "02:26",
      "text": "వీడియో కాల్ కూడా"
    },
    {
      "t": "02:28",
      "text": "బాగుంటుంది కదా"
    },
    {
      "t": "02:30",
      "text": "ఎందుకు"
    },
    {
      "t": "02:32",
      "text": "చూడండి లేని వీడియో కాల్"
    },
    {
      "t": "02:34",
      "text": "ఆడియో కాల్లో ఇప్పుడు మనం మన"
    },
    {
      "t": "02:36",
      "text": "బాగానే మాట్లాడుకుంటున్నాం కదా"
    },
    {
      "t": "02:38",
      "text": "సర్లే చెప్పండి"
    },
    {
      "t": "02:40",
      "text": "ఎంత ఏజ్ మీది"
    },
    {
      "t": "02:42",
      "text": "ఇది ఎంత ఏజ్"
    },
    {
      "t": "02:44",
      "text": "ట్వంటీ టూ అండి"
    },
    {
      "t": "02:46",
      "text": "అమ్మ అబద్దానికి ఏం"
    },
    {
      "t": "02:48",
      "text": "ఒక లిమిట్ ఉండాలబ్బా"
    },
    {
      "t": "02:50",
      "text": "ఏ అబ్బా"
    },
    {
      "t": "02:52",
      "text": "మీ వాయిస్ వింటే"
    },
    {
      "t": "02:54",
      "text": "ఏ ఇరవై ఐదు ఇరవై ఆరు మనుషుల"
    },
    {
      "t": "02:56",
      "text": "ఉన్నారు మీరు చెప్తుంది"
    },
    {
      "t": "02:58",
      "text": "ఇరవై రెండు సంవత్సరాలు అంటే"
    },
    {
      "t": "03:00",
      "text": "చేతులు బాదులు వేసుకొని కూర్చున్నాను"
    },
    {
      "t": "03:02",
      "text": "చెప్పండి"
    },
    {
      "t": "03:04",
      "text": "లాజిక్లు"
    },
    {
      "t": "03:06",
      "text": "వెతుక్కోకూడదండి వచ్చిన"
    },
    {
      "t": "03:08",
      "text": "ఆనందాన్ని ఎంజాయ్ చేయాలి ఇప్పుడు"
    },
    {
      "t": "03:10",
      "text": "నాకు గొంతుకు రా"
    },
    {
      "t": "03:12",
      "text": "ట్రంపా జ్వరం రెండు రోజుల నుంచి"
    },
    {
      "t": "03:14",
      "text": "నిద్రలేవడం వల్ల"
    },
    {
      "t": "03:16",
      "text": "నిద్ర పట్టట్లేదు కాళ్ళు"
    },
    {
      "t": "03:18",
      "text": "నేరసో సరదాగా"
    },
    {
      "t": "03:20",
      "text": "యాప్లోకి వచ్చారు అంతే తప్ప"
    },
    {
      "t": "03:22",
      "text": "మీ ఇష్టం అయితే మాట్లాడను"
    },
    {
      "t": "03:24",
      "text": "కష్టమైతే"
    },
    {
      "t": "03:26",
      "text": "కట్ చేసుకోవచ్చు కదా"
    },
    {
      "t": "03:28",
      "text": "నేను"
    },
    {
      "t": "03:30",
      "text": "అది అనట్లేదమ్మా మీ బాగుంది"
    },
    {
      "t": "03:32",
      "text": "మైల్స్ చూస్తే ట్వంటీ ఫోర్ ట్వంటీ"
    },
    {
      "t": "03:34",
      "text": "ఫైవ్ ఇయర్స్లో ఉంది"
    },
    {
      "t": "03:36",
      "text": "మరి మీరు చెప్పే ఏజ్ నాకు"
    },
    {
      "t": "03:38",
      "text": "సింక్ అవ్వట్లేదబ్బా"
    },
    {
      "t": "03:40",
      "text": "అదే చెప్తున్నాను కదండీ"
    },
    {
      "t": "03:42",
      "text": "అండ్ నాకు రెండు రోజులు"
    },
    {
      "t": "03:44",
      "text": "మంచి జ్వరం గొంతుకు రంప"
    },
    {
      "t": "03:46",
      "text": "నిద్రొట్టగా సా"
    },
    {
      "t": "03:48",
      "text": "ఎంత ఉన్నా ఎంత"
    },
    {
      "t": "03:50",
      "text": "జలుబు చేసినా ఎంత ఫేవర్"
    },
    {
      "t": "03:52",
      "text": "వచ్చిన వాయిస్లో చేంజ్"
    },
    {
      "t": "03:54",
      "text": "కొంతైనా ఉంటుంది కానీ మరి ఎక్కువ"
    },
    {
      "t": "03:56",
      "text": "ఎక్కువగా చేంజ్ ఉంటుందా చెప్పండి"
    },
    {
      "t": "03:58",
      "text": "ఉండండి సరదాగా కష్టపడి"
    },
    {
      "t": "04:00",
      "text": "కాసేపు మాట్లాడుకుందామా"
    },
    {
      "t": "04:02",
      "text": "సరే చెప్పండి ఏంటి"
    },
    {
      "t": "04:04",
      "text": "మొత్తం ఏజ్"
    },
    {
      "t": "04:06",
      "text": "నేర్స్ ఫండ్ చేయండి"
    },
    {
      "t": "04:08",
      "text": "ఓకే"
    },
    {
      "t": "04:10",
      "text": "ఈ బ్రాసెస్ ఎంత"
    },
    {
      "t": "04:12",
      "text": "నేను ఆ పర్పస్ మీద రా"
    },
    {
      "t": "04:14",
      "text": "ఆ డేస్ కదా వచ్చింది ఫ్రెండ్లీగా"
    },
    {
      "t": "04:16",
      "text": "మాట్లాడదామని విత్ ఫ్రెండ్లీ"
    },
    {
      "t": "04:18",
      "text": "ఇంట్రెస్ట్ ఉంటే మాట్లాడండి లేకపోతే"
    },
    {
      "t": "04:20",
      "text": "ఓకే"
    },
    {
      "t": "04:22",
      "text": "అంతేనంటారా అయితే"
    },
    {
      "t": "04:24",
      "text": "అంతే కదా మరి"
    },
    {
      "t": "04:26",
      "text": "అవును"
    },
    {
      "t": "04:28",
      "text": "మేము ఆ రోడ్లో అనిపించుకున్నారు"
    },
    {
      "t": "04:30",
      "text": "అంతేనా"
    },
    {
      "t": "04:32",
      "text": "ఆ మాత్రం ఉండాలి కదబ్బా మా మమ్మీ"
    },
    {
      "t": "04:34",
      "text": "భీమవరం అమ్మాయిలకి"
    },
    {
      "t": "04:36",
      "text": "సో ఇంకా అందరు"
    },
    {
      "t": "04:38",
      "text": "ఏముందిలేండి"
    },
    {
      "t": "04:40",
      "text": "హ్మ్"
