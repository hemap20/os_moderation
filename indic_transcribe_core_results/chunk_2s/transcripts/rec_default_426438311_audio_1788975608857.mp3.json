  "segments": [
    {
      "t": "00:00",
      "text": "ഇല്ല"
    },
    {
      "t": "00:02",
      "text": "നോ"
    },
    {
      "t": "00:04",
      "text": "മറ്റേത് അറിയത്തുള്ളൂ"
    },
    {
      "t": "00:06",
      "text": "എവിടെ"
    },
    {
      "t": "00:08",
      "text": "ഞാൻ കണ്ണൂർ"
    },
    {
      "t": "00:10",
      "text": "എവിടെ കണ്ണൂരാണ്"
    },
    {
      "t": "00:12",
      "text": "എവിടെയൊക്കെയുള്ളത് നാട്ടിലല്ലേ"
    },
    {
      "t": "00:14",
      "text": "ഏഹ് നാട്ടിലല്ലേ"
    },
    {
      "t": "00:16",
      "text": "ഉള്ളത്"
    },
    {
      "t": "00:18",
      "text": "ബാംഗ്ലൂര് അന്നാ പപ്പൻ ബാബു ബാബു"
    },
    {
      "t": "00:20",
      "text": "ആ ഓ അങ്ങനെ ഹേഴ്സിങ്"
    },
    {
      "t": "00:22",
      "text": "ഫൈനലി റെഡി ആയിട്ടുണ്ട്"
    },
    {
      "t": "00:24",
      "text": "രാമസ്വാമിയുടെ"
    },
    {
      "t": "00:26",
      "text": "ആ കുറയ്ക്കുന്ന പട്ടിയോടൊന്നും മിണ്ടാണ്ടിരിക്കാൻ"
    },
    {
      "t": "00:28",
      "text": "അത് അടി ഉണ്ടാക്കും"
    },
    {
      "t": "00:30",
      "text": "ആ"
    },
    {
      "t": "00:32",
      "text": "എനിക്ക് തത്തമ്മ"
    },
    {
      "t": "00:34",
      "text": "കത്തമ്മ കത്തമ്മ"
    },
    {
      "t": "00:36",
      "text": "അല്ല സവാള"
    },
    {
      "t": "00:38",
      "text": "സവാള"
    },
    {
      "t": "00:40",
      "text": "ഏ"
    },
    {
      "t": "00:42",
      "text": "പക്ഷി നോട്ടമൊക്കെ ഉണ്ടോ അവിടെയൊക്കെ"
    },
    {
      "t": "00:44",
      "text": "തങ്കത്ത് താമര"
    },
    {
      "t": "00:46",
      "text": "മനസ്സിലായോ"
    },
    {
      "t": "00:48",
      "text": "ചെറുപ്പക്കാര് പാരമ്പര്യത്തിന് പോകണ്ടേ"
    },
    {
      "t": "00:50",
      "text": "ഇൻസ്റ്റാഗ്രാം"
    },
    {
      "t": "00:52",
      "text": "പങ്കജ്"
    },
    {
      "t": "00:54",
      "text": "പിഴപ്പിച്ച് പിള്ളേരെ"
    },
    {
      "t": "00:56",
      "text": "മ്മ്"
    },
    {
      "t": "00:58",
      "text": "എവിടെ സ്ഥലം മുമ്പോളും ഞാൻ"
    },
    {
      "t": "01:00",
      "text": "തൃശ്ശൂർ"
    },
    {
      "t": "01:02",
      "text": "എന്താ ചെയ്യണേ"
    },
    {
      "t": "01:04",
      "text": "ഞാനിപ്പോൾ ഗൾഫിലാണ്"
    },
    {
      "t": "01:06",
      "text": "എന്തൊക്കെയാണ്"
    },
    {
      "t": "01:08",
      "text": "ഒന്ന്"
    },
    {
      "t": "01:10",
      "text": "അല്ല കാരണം മൂന്നൊക്കെ തൊങ്ങാൻ"
    },
    {
      "t": "01:12",
      "text": "ഞാൻ പറയാം"
    },
    {
      "t": "01:14",
      "text": "ധനശ്രീ"
    },
    {
      "t": "01:16",
      "text": "ഷൂട്ട് ചെയ്യും ചെയ്യും"
    },
    {
      "t": "01:18",
      "text": "ഈ പുള്ളി രാണാദേവി ചേച്ചി ചേച്ചിയെ വിളിച്ചത്"
    },
    {
      "t": "01:20",
      "text": "വേണ്ട"
    },
    {
      "t": "01:22",
      "text": "എല്ലാം"
    },
    {
      "t": "01:24",
      "text": "ചേച്ചിക്ക് എന്താ കലിപ്പ്"
    },
    {
      "t": "01:26",
      "text": "ഞാൻ പുള്ളീനെ എപ്പോഴും ചീത്ത പറഞ്ഞു"
    },
    {
      "t": "01:28",
      "text": "ബസ്"
    },
    {
      "t": "01:30",
      "text": "ആയിരുന്നേ"
    },
    {
      "t": "01:32",
      "text": "ഇവള് അവിടെ നിന്നാ പോയി"
    },
    {
      "t": "01:34",
      "text": "വീട്ടിൽ ആരൊക്കെയുണ്ട്"
    },
    {
      "t": "01:36",
      "text": "ഫാമിലി മാത്രം"
    },
    {
      "t": "01:38",
      "text": "ഏ"
    },
    {
      "t": "01:40",
      "text": "ഫാമിലി മാത്രം"
    },
    {
      "t": "01:42",
      "text": "ആയി വേണ്ട"
    },
    {
      "t": "01:44",
      "text": "വിട്ടിട്ടുണ്ട്"
    },
    {
      "t": "01:46",
      "text": "എന്നാ ചെയ്യുന്നത്"
    },
    {
      "t": "01:48",
      "text": "മാറ്റണം"
    },
    {
      "t": "01:50",
      "text": "ഒരു നാട്ടില്"
    },
    {
      "t": "01:52",
      "text": "പിള്ളേരെന്താ അടിക്കുന്നത്"
    },
    {
      "t": "01:54",
      "text": "എൽ കെ ജി ഒരാള്"
    },
    {
      "t": "01:56",
      "text": "എൽ കെ ജിയിലോ ചേട്ടൻ എത്ര മിനിറ്റ്"
    },
    {
      "t": "01:58",
      "text": "എത്ര ഉണ്ട് പറയൂ"
    },
    {
      "t": "02:00",
      "text": "ആ"
    },
    {
      "t": "02:02",
      "text": "ഒരു നാല്പത്തഞ്ച്"
    },
    {
      "t": "02:04",
      "text": "ഇത് ആപ്പിള്"
    },
    {
      "t": "02:06",
      "text": "ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ ആ"
    },
    {
      "t": "02:08",
      "text": "നാൽപ്പത്"
    },
    {
      "t": "02:10",
      "text": "തേർട്ടി എയ്റ്റ്"
    },
    {
      "t": "02:12",
      "text": "കേട്ടേ കുഴപ്പമില്ല ഒരു വർഷം കൂടെ ഞാൻ"
    },
    {
      "t": "02:14",
      "text": "രണ്ട് ദിവസം കഴിഞ്ഞു നമ്മൾ"
    },
    {
      "t": "02:16",
      "text": "ഏജസ്"
    },
    {
      "t": "02:18",
      "text": "ഇറ്റ്സ് നോട്ട് എ മാറ്റർ"
    },
    {
      "t": "02:20",
      "text": "യാ"
    },
    {
      "t": "02:22",
      "text": "ആ"
    },
    {
      "t": "02:24",
      "text": "എങ്ങനെയുണ്ട് ബാംഗ്ലൂർ ലൈഫൊക്കെ"
    },
    {
      "t": "02:26",
      "text": "ആ"
    },
    {
      "t": "02:28",
      "text": "ആ"
    },
    {
      "t": "02:30",
      "text": "ഉം ഉള്ളതല്ലേ"
    },
    {
      "t": "02:32",
      "text": "എന്താണ്"
    },
    {
      "t": "02:34",
      "text": "ഇഷ്ടമാണ്"
    },
    {
      "t": "02:36",
      "text": "അല്ലേ"
    },
    {
      "t": "02:38",
      "text": "അല്ല"
    },
    {
      "t": "02:40",
      "text": "എന്തുപറ്റി ബാംഗ്ലൂർ ലൈഫ് ഭയങ്കര അടിപൊളിയാണല്ലോ സാർ"
    },
    {
      "t": "02:42",
      "text": "സാധാരണ എല്ലാവർക്കും"
    },
    {
      "t": "02:44",
      "text": "ഞാൻ പറയാം"
    },
    {
      "t": "02:46",
      "text": "അടിപൊളി എന്റെ കൂടെ നിൽക്കുന്നവരും പറയും"
    },
    {
      "t": "02:48",
      "text": "എന്താ കാരണം"
    },
    {
      "t": "02:50",
      "text": "കൊള്ളൂല്ല"
    },
    {
      "t": "02:52",
      "text": "നമ്മൾ അവിടുന്നൊക്കെ വരുന്ന ബിൽഡപ്പ് മാത്രം"
    },
    {
      "t": "02:54",
      "text": "എവിടെ നിന്നാണ് വന്നിട്ട്"
    },
    {
      "t": "02:56",
      "text": "ഞാൻ ബാംഗ്ലൂർ ഉണ്ടായിരുന്ന ആളാണ് എനിക്കറിയാം"
    },
    {
      "t": "02:58",
      "text": "കഥാ ടിപ്സ്"
    },
    {
      "t": "03:00",
      "text": "ആ"
    },
    {
      "t": "03:02",
      "text": "ഞാൻ ബാംഗ്ലൂർ ഉണ്ടായിരുന്നു"
    },
    {
      "t": "03:04",
      "text": "എന്നുള്ളതാണ്"
    },
    {
      "t": "03:06",
      "text": "എനിക്കിഷ്ടം"
    },
    {
      "t": "03:08",
      "text": "ആ"
    },
    {
      "t": "03:10",
      "text": "ഇതിലെന്താ കറിയൊക്കെ"
    },
    {
      "t": "03:12",
      "text": "ആ ഇല്ല ഇല്ല"
    },
    {
      "t": "03:14",
      "text": "എന്താ അറിയാത്തത്"
    },
    {
      "t": "03:16",
      "text": "അതെന്താ"
    },
    {
      "t": "03:18",
      "text": "ഭാര്യയുടെ നമ്പര് തന്നു തന്നേ"
    },
    {
      "t": "03:20",
      "text": "അങ്ങനെ അങ്ങനെ അങ്ങനെ പവറില്ല അങ്ങനെ"
    },
    {
      "t": "03:22",
      "text": "സംസാരിക്കുന്നത് എന്തോ"
    },
    {
      "t": "03:24",
      "text": "എൻ്റെ കാര്യം അറിയാമല്ലോ ഞാൻ അതിലുള്ളത്"
    },
    {
      "t": "03:26",
      "text": "ഭാര്യക്കറിയാവോ"
    },
    {
      "t": "03:28",
      "text": "ഹിന്ദു"
    },
    {
      "t": "03:30",
      "text": "തരിയുടെ ഇതെന്താണെന്ന് ചേട്ടന് അറിയാമോ"
    },
    {
      "t": "03:32",
      "text": "പാരഡൈസ്"
    },
    {
      "t": "03:34",
      "text": "പേരെന്താ പറയുക"
    },
    {
      "t": "03:36",
      "text": "അതിനെന്താ കുഴപ്പം സംസാരിക്കുന്നത്"
    },
    {
      "t": "03:38",
      "text": "എന്താ പ്രശ്നം"
    },
    {
      "t": "03:40",
      "text": "ആ"
    },
    {
      "t": "03:42",
      "text": "ഫ്രീഡം"
    },
    {
      "t": "03:44",
      "text": "പോകാം"
    },
    {
      "t": "03:46",
      "text": "ആളായിട്ടൊന്ന് സംസാരിച്ചു വെച്ചാൽ എന്താ പ്രശ്നം"
    },
    {
      "t": "03:48",
      "text": "എക്സ്പീരിയൻസ്"
    },
    {
      "t": "03:50",
      "text": "ഇതായിരിക്കും"
    },
    {
      "t": "03:52",
      "text": "എന്താ"
    },
    {
      "t": "03:54",
      "text": "സംഭവിക്കും"
    },
    {
      "t": "03:56",
      "text": "എന്തെങ്കിലും സംഭവിക്കുമോ"
    },
    {
      "t": "03:58",
      "text": "ആ"
    },
    {
      "t": "04:00",
      "text": "നല്ല പ്രശ്നം"
    },
    {
      "t": "04:02",
      "text": "ഓക്കേ"
    },
    {
      "t": "04:04",
      "text": "ഫുഡേജ്"
    },
    {
      "t": "04:06",
      "text": "ഓക്കേ"
    },
    {
      "t": "04:08",
      "text": "ചേട്ടാ ഒറ്റയ്ക്ക് അവിടെ താമസം"
    },
    {
      "t": "04:10",
      "text": "അതെ"
    },
    {
      "t": "04:12",
      "text": "സിംഗിൾ ലൈഫ്"
    },
    {
      "t": "04:14",
      "text": "അപ്പം ഫുഡ് ഒക്കെ ഉണ്ടാക്കുമോ"
    },
    {
      "t": "04:16",
      "text": "ആ"
    },
    {
      "t": "04:18",
      "text": "പട്ടിക്ക് വന്നില്ല ഓണത്തിന്"
    },
    {
      "t": "04:20",
      "text": "ഇല്ലല്ല ഞാനിപ്പോള്"
    },
    {
      "t": "04:22",
      "text": "കുറച്ച് കഴിഞ്ഞാലേ പോകുള്ളൂ"
    },
    {
      "t": "04:24",
      "text": "ഇനിയിപ്പോ എന്നാ"
    },
    {
      "t": "04:26",
      "text": "ഒന്നും അങ്ങനെ പ്ലാൻഡ് ഒന്നുമല്ല"
    },
    {
      "t": "04:28",
      "text": "എനി ടൈം"
    },
    {
      "t": "04:30",
      "text": "ഓക്കെ"
    },
    {
      "t": "04:32",
      "text": "ഞാനങ്ങനെ പ്ലാൻ ചെയ്തു"
    },
    {
      "t": "04:34",
      "text": "ചെയ്തു പോകുന്ന ആളല്ല"
    },
    {
      "t": "04:36",
      "text": "ത്രീ മന്ത്സ് അല്ലെങ്കിൽ ഫോർ മന്ത്സ് കൊണ്ട് പോകും"
    },
    {
      "t": "04:38",
      "text": "ഇല്ല"
    },
    {
      "t": "04:40",
      "text": "ഓക്കേ"
    },
    {
      "t": "04:42",
      "text": "ആ"
    },
    {
      "t": "04:44",
      "text": "ആ"
    },
    {
      "t": "04:46",
      "text": "അപ്പോള് ഓക്കേ"
    },
    {
      "t": "04:48",
      "text": "ആ"
    },
    {
      "t": "04:50",
      "text": "ആ"
    },
    {
      "t": "04:52",
      "text": "ആ"
