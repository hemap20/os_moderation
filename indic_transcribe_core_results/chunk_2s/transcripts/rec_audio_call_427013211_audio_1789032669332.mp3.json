  "segments": [
    {
      "t": "00:00",
      "text": "എന്നാലും"
    },
    {
      "t": "00:02",
      "text": "പിന്നെ"
    },
    {
      "t": "00:04",
      "text": "ഹലോ ഹായ്"
    },
    {
      "t": "00:06",
      "text": "ചെക്കൻ ലോകത്ത്"
    },
    {
      "t": "00:08",
      "text": "ഒരു മിനിറ്റ്"
    },
    {
      "t": "00:10",
      "text": "റിയ"
    },
    {
      "t": "00:12",
      "text": "എന്ത് ചെയ്യുന്നു"
    },
    {
      "t": "00:14",
      "text": "ഞാൻ പഠിക്കുന്നു എന്ത് ചെയ്യുന്നു"
    },
    {
      "t": "00:16",
      "text": "ഞാൻ വർക്ക് ചെയ്യാടാ അവിടെ"
    },
    {
      "t": "00:18",
      "text": "നേഴ്സിംഗ് പഠിക്കാൻ പറ്റും"
    },
    {
      "t": "00:20",
      "text": "ഓക്കെ എവിടെ പുറത്താണത് ആരാണ്"
    },
    {
      "t": "00:22",
      "text": "ഓക്കെ ഓക്കെ"
    },
    {
      "t": "00:24",
      "text": "ഇപ്പം ബാംഗ്ലൂരാണ്"
    },
    {
      "t": "00:26",
      "text": "ഓക്കെ കുറച്ച് നാണമെന്നേ"
    },
    {
      "t": "00:28",
      "text": "ആ അതെ അതെ ഹോസ്റ്റലിലാണ്"
    },
    {
      "t": "00:30",
      "text": "മലയാളികളൊക്കെ ഉണ്ടോ"
    },
    {
      "t": "00:32",
      "text": "ആ ഉണ്ട് എല്ലാവരും മലയാളികളാണ്"
    },
    {
      "t": "00:34",
      "text": "ഓക്കെ എന്തു ചെയ്യും എല്ലാവരും"
    },
    {
      "t": "00:36",
      "text": "ഇനി ഞാൻ മേലോട്ടേക്ക്"
    },
    {
      "t": "00:38",
      "text": "എന്തോ എല്ലാവരും എന്ത് ചെയ്യും"
    },
    {
      "t": "00:40",
      "text": "ആര് ഉണ്ടോ അവിടെ"
    },
    {
      "t": "00:42",
      "text": "കൊണ്ടുണ്ട് നമ്മൾ ഒന്ന് വെളിയിലോട്ട്"
    },
    {
      "t": "00:44",
      "text": "കിട്ടാൻ വയ്യ"
    },
    {
      "t": "00:46",
      "text": "ഷോപ്പിംഗ് തുടങ്ങിയതാണ്"
    },
    {
      "t": "00:48",
      "text": "വൃന്ദാവനിയാണ്"
    },
    {
      "t": "00:50",
      "text": "എന്താണോ ഇന്ന് സംഭവം"
    },
    {
      "t": "00:52",
      "text": "ആണ് കുറച്ച്"
    }
  ],
  "full_text": "എന്നാലും പിന്നെ ഹലോ ഹായ് ചെക്കൻ ലോകത്ത് ഒരു മിനിറ്റ് റിയ എന്ത് ചെയ്യുന്നു ഞാൻ പഠിക്കുന്നു എന്ത് ചെയ്യുന്നു ഞാൻ വർക്ക് ചെയ്യാടാ അവിടെ നേഴ്സിംഗ് പഠിക്കാൻ പറ്റും ഓക്കെ എവിടെ പുറത്താണത് ആരാണ് ഓക്കെ ഓക്കെ ഇപ്പം ബാംഗ്ലൂരാണ് ഓക്കെ കുറച്ച് നാണമെന്നേ ആ അതെ അതെ ഹോസ്റ്റലിലാണ് മലയാളികളൊക്കെ ഉണ്ടോ ആ ഉണ്ട് എല്ലാവരും മലയാളികളാണ് ഓക്കെ എന്തു ചെയ്യും എല്ലാവരും ഇനി ഞാൻ മേലോട്ടേക്ക് എന്തോ എല്ലാവരും എന്ത് ചെയ്യും ആര് ഉണ്ടോ അവിടെ കൊണ്ടുണ്ട് നമ്മൾ ഒന്ന് വെളിയിലോട്ട് കിട്ടാൻ വയ്യ ഷോപ്പിംഗ് തുടങ്ങിയതാണ് വൃന്ദാവനിയാണ് എന്താണോ ഇന്ന് സംഭവം ആണ് കുറച്ച്",
