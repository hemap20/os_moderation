{
  "file_id": "rec_default_426252346_audio_1788960080824.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 475.1970625,
  "processing_time_sec": 31.72003483772278,
  "segments": [
    {
      "t": "00:00",
      "text": "వావ్ వావ్"
    },
    {
      "t": "00:02",
      "text": "ఆన్సర్"
    },
    {
      "t": "00:04",
      "text": "సరే"
    },
    {
      "t": "00:06",
      "text": "ఎక్కడ"
    },
    {
      "t": "00:08",
      "text": "అయితే"
    },
    {
      "t": "00:10",
      "text": "ఓఎస్ అంట"
    },
    {
      "t": "00:12",
      "text": "సైడ్స్ ఆ సైడ్"
    },
    {
      "t": "00:14",
      "text": "నిన్న కూడా కాల్ చేసాను"
    },
    {
      "t": "00:16",
      "text": "సరే"
    },
    {
      "t": "00:18",
      "text": "అవునా"
    },
    {
      "t": "00:20",
      "text": "ఈరోజు"
    },
    {
      "t": "00:22",
      "text": "ఇక్కడే కూర్చొని ఉన్నాను అనుకుంటున్నావా"
    },
    {
      "t": "00:24",
      "text": "పిల్లలు"
    },
    {
      "t": "00:26",
      "text": "ఇంకా అదే సరిగ్గా"
    },
    {
      "t": "00:28",
      "text": "సరే"
    },
    {
      "t": "00:30",
      "text": "చెప్పు నిన్న కేరళ చూస్తుంటాగా"
    },
    {
      "t": "00:32",
      "text": "గ్రీన్ అండ్ బ్లూ కలర్"
    },
    {
      "t": "00:34",
      "text": "ఇంకా"
    },
    {
      "t": "00:36",
      "text": "టీచర్"
    },
    {
      "t": "00:38",
      "text": "ఓకే సార్ శివ"
    },
    {
      "t": "00:40",
      "text": "అది బాగుంది"
    },
    {
      "t": "00:42",
      "text": "బాగుంది"
    },
    {
      "t": "00:44",
      "text": "అది కూడా బాగుంది"
    },
    {
      "t": "00:46",
      "text": "దాని అందం దానిది దీని అందం"
    },
    {
      "t": "00:48",
      "text": "వేసి కనిపించట్లేదు"
    },
    {
      "t": "00:50",
      "text": "దానందం దానందం"
    },
    {
      "t": "00:52",
      "text": "గాంధీ దినందన్ దీవి"
    },
    {
      "t": "00:54",
      "text": "ఆ ఎల్"
    },
    {
      "t": "00:56",
      "text": "ఎలాగైనా ఉన్నాయి"
    },
    {
      "t": "00:58",
      "text": "అబ్బా వేసేసాను"
    },
    {
      "t": "01:00",
      "text": "ఇంకా"
    },
    {
      "t": "01:02",
      "text": "ఏమిరా నిన్న నేను వెళ్ళిపోయిన తర్వాత"
    },
    {
      "t": "01:04",
      "text": "చేస్తే మాట్లాడినట్టున్నావుగా"
    },
    {
      "t": "01:06",
      "text": "మేము"
    },
    {
      "t": "01:08",
      "text": "అయిపోయిందా"
    },
    {
      "t": "01:10",
      "text": "ఇంట్లో వేస్తావా క్యారేజ్"
    },
    {
      "t": "01:12",
      "text": "దాన్ని"
    },
    {
      "t": "01:14",
      "text": "అవినాష్"
    },
    {
      "t": "01:16",
      "text": "ఏం లేదు"
    },
    {
      "t": "01:18",
      "text": "పొయ్యి మీద అన్నం పెట్టేసుకుంటున్నాను"
    },
    {
      "t": "01:20",
      "text": "హలో"
    },
    {
      "t": "01:22",
      "text": "ఆ"
    },
    {
      "t": "01:24",
      "text": "ఎస్ సార్"
    },
    {
      "t": "01:26",
      "text": "ఓకే"
    },
    {
      "t": "01:28",
      "text": "ఓకే"
    },
    {
      "t": "01:30",
      "text": "ఓకే"
    },
    {
      "t": "01:32",
      "text": "అండ్"
    },
    {
      "t": "01:34",
      "text": "ఆ"
    },
    {
      "t": "01:36",
      "text": "అంటే"
    },
    {
      "t": "01:38",
      "text": "చెప్పు"
    },
    {
      "t": "01:40",
      "text": "చెప్పాలి నువ్వే ఏం"
    },
    {
      "t": "01:42",
      "text": "చూస్తున్నాను మీ అందరికీ"
    },
    {
      "t": "01:44",
      "text": "ఏం చూస్తుంటావు"
    },
    {
      "t": "01:46",
      "text": "నేనేం వినిపించట్లేదే"
    },
    {
      "t": "01:48",
      "text": "కనబడదు"
    },
    {
      "t": "01:50",
      "text": "చిన్న"
    },
    {
      "t": "01:52",
      "text": "పిల్లాడివి కదా"
    },
    {
      "t": "01:54",
      "text": "నాలుగు కళ్ళు కళ్ళద్దాలు నాలుగు"
    },
    {
      "t": "01:56",
      "text": "గిఫ్ట్ కూడా నీకు కనపడలేదా"
    },
    {
      "t": "01:58",
      "text": "కొంచెం చూపిస్తాను"
    },
    {
      "t": "02:00",
      "text": "ఇస్తావా"
    },
    {
      "t": "02:02",
      "text": "అవును"
    },
    {
      "t": "02:04",
      "text": "మోక్షి నీ హోంవర్క్ అయిపోతే బాగుంటుంది"
    },
    {
      "t": "02:06",
      "text": "వాటికి నీళ్ళు పట్టి సింక్లో కూడా ఉన్నాయి"
    },
    {
      "t": "02:08",
      "text": "కటింగ్స్"
    },
    {
      "t": "02:10",
      "text": "ఓకే"
    },
    {
      "t": "02:12",
      "text": "చూపిస్తావా కొంచెం"
    },
    {
      "t": "02:14",
      "text": "గుర్తుపెట్టుకుంటా"
    },
    {
      "t": "02:16",
      "text": "అబ్బా"
    },
    {
      "t": "02:18",
      "text": "ఎవరికి ఎవరికి చెప్పినా"
    },
    {
      "t": "02:20",
      "text": "మొదలవ్వదు"
    },
    {
      "t": "02:22",
      "text": "అంటే ఇందులో"
    },
    {
      "t": "02:24",
      "text": "ఇందాక చూపించలేను బంగారం"
    },
    {
      "t": "02:26",
      "text": "వాట్సాప్లో"
    },
    {
      "t": "02:28",
      "text": "వాట్సాప్"
    },
    {
      "t": "02:30",
      "text": "సార్"
    },
    {
      "t": "02:32",
      "text": "మిస్ అవ్వకుండా"
    },
    {
      "t": "02:34",
      "text": "ఓకే"
    },
    {
      "t": "02:36",
      "text": "దాంట్లో నాకు యూజింగ్ తెలీదు"
    },
    {
      "t": "02:38",
      "text": "రోమిక్లీ"
    },
    {
      "t": "02:40",
      "text": "నచ్చలేదండి"
    },
    {
      "t": "02:42",
      "text": "అది దాన్ని ఎలా"
    },
    {
      "t": "02:44",
      "text": "ట్రై చేయాలి ఫాలో చేయాలి"
    },
    {
      "t": "02:46",
      "text": "యాడ్ చేసుకోవాలి అని"
    },
    {
      "t": "02:48",
      "text": "వార్త పని"
    },
    {
      "t": "02:50",
      "text": "ముందే కామన్గా వాడతాం కాబట్టి తెలుసు"
    },
    {
      "t": "02:52",
      "text": "ఓకే"
    },
    {
      "t": "02:54",
      "text": "ఆ హోమ్ డే కావాలి"
    },
    {
      "t": "02:56",
      "text": "ఓకే"
    },
    {
      "t": "02:58",
      "text": "ఓకే"
    },
    {
      "t": "03:00",
      "text": "ట్రెండింగ్ డౌన్"
    },
    {
      "t": "03:02",
      "text": "ఇంకా హరినటన"
    },
    {
      "t": "03:04",
      "text": "అవునన్నా"
    },
    {
      "t": "03:06",
      "text": "చూపిస్తావా"
    },
    {
      "t": "03:08",
      "text": "ఆ"
    },
    {
      "t": "03:10",
      "text": "చూపిస్తాను పక్కా"
    },
    {
      "t": "03:12",
      "text": "ఎంత"
    },
    {
      "t": "03:14",
      "text": "పుస్తకాలు"
    },
    {
      "t": "03:16",
      "text": "అవ్వదు ఇది నన్ను బ్యాగ్ చేసేస్తుంది"
    },
    {
      "t": "03:18",
      "text": "చేయలేను"
    },
    {
      "t": "03:20",
      "text": "అంటే నిన్ను తప్పుగా అనుకోకు నేను"
    },
    {
      "t": "03:22",
      "text": "కావాలని కాదు"
    },
    {
      "t": "03:24",
      "text": "మేడం"
    },
    {
      "t": "03:26",
      "text": "అదేలే ఎంత"
    },
    {
      "t": "03:28",
      "text": "వాట్సాప్లో"
    },
    {
      "t": "03:30",
      "text": "నువ్వు ఇందులో ఎంత వేసావు"
    },
    {
      "t": "03:32",
      "text": "ఆ"
    },
    {
      "t": "03:34",
      "text": "నేను"
    },
    {
      "t": "03:36",
      "text": "నేను ఫైవ్ హండ్రెడ్ వేసుకుంటాను"
    },
    {
      "t": "03:38",
      "text": "ఆ"
    },
    {
      "t": "03:40",
      "text": "వెయ్యి ఉంది"
    },
    {
      "t": "03:42",
      "text": "అందులో నీకు ఫుల్ సాటిస్ఫాక్షన్"
    },
    {
      "t": "03:44",
      "text": "ఉంటుంది కదా ఇందులో ఉండదు కదా"
    },
    {
      "t": "03:46",
      "text": "మీకు కార్తీక్"
    },
    {
      "t": "03:48",
      "text": "శిక్షణ అయ్యేంత వరకు ఉంటాను కదా"
    },
    {
      "t": "03:50",
      "text": "అంటే ఐ మీన్ మీరు మా నువ్వు"
    },
    {
      "t": "03:52",
      "text": "హ్యాండ్ రబ్ చేసుకుంటూ"
    },
    {
      "t": "03:54",
      "text": "అంటే ఈ హ్యాండ్ జాబ్ చేస్తాను"
    },
    {
      "t": "03:56",
      "text": "ఎంతవరకు నీ స్వామి రిలీజ్ అయ్యేంతవరకు"
    },
    {
      "t": "03:58",
      "text": "ఉంటాను"
    },
    {
      "t": "04:00",
      "text": "కింద"
    },
    {
      "t": "04:02",
      "text": "పైన ముట్టు నువ్వు ఎలా ఉన్నావంటే అలా"
    },
    {
      "t": "04:04",
      "text": "ఉంటాను"
    },
    {
      "t": "04:06",
      "text": "ఓకే"
    },
    {
      "t": "04:08",
      "text": "ఓకే"
    },
    {
      "t": "04:10",
      "text": "వాట్సాప్ నెంబర్"
    },
    {
      "t": "04:12",
      "text": "మరెంట్"
    },
    {
      "t": "04:14",
      "text": "నెంబరా పర్లేదు కదా ఫోన్"
    },
    {
      "t": "04:16",
      "text": "ఫొటోస్ అలాంటివి ఏం తీయగలరు"
    },
    {
      "t": "04:18",
      "text": "నేను నేను నా సేఫ్టీ నేను చూసుకుంటాను"
    },
    {
      "t": "04:20",
      "text": "అలాగే అలాగే"
    },
    {
      "t": "04:22",
      "text": "ఏం పని చెప్పు నేనే ఇప్పుడు"
    },
    {
      "t": "04:24",
      "text": "తీసుకుంటే మళ్ళీ నాకు ఎప్పుడు దొరుకుతుంది"
    },
    {
      "t": "04:26",
      "text": "వర్క్ ఎప్పుడు చేస్తానో ఏమో నాకే తెలీదు"
    },
    {
      "t": "04:28",
      "text": "నైన్త్ వరకు"
    },
    {
      "t": "04:30",
      "text": "నైన్ త్రీ నైన్"
    },
    {
      "t": "04:32",
      "text": "నైన్ త్రీ నైన్"
    },
    {
      "t": "04:34",
      "text": "ఆ"
    },
    {
      "t": "04:36",
      "text": "క్లాస్"
    },
    {
      "t": "04:38",
      "text": "నైన్ త్రీ నైన్"
    },
    {
      "t": "04:40",
      "text": "నువ్వు చెప్తావా నేను చెప్పనా"
    },
    {
      "t": "04:42",
      "text": "ఒక్క నిమిషం ఆగు నేను"
    },
    {
      "t": "04:44",
      "text": "ఓకే"
    },
    {
      "t": "04:46",
      "text": "అదే"
    },
    {
      "t": "04:48",
      "text": "నైన్ త్రీ నైన్"
    },
    {
      "t": "04:50",
      "text": "డబల్ ఎయిట్"
    },
    {
      "t": "04:52",
      "text": "ఆ"
    },
    {
      "t": "04:54",
      "text": "సిక్స్ వన్"
    },
    {
      "t": "04:56",
      "text": "సిక్స్ వన్"
    },
    {
      "t": "04:58",
      "text": "డబల్ నైన్"
    },
    {
      "t": "05:00",
      "text": "అది జస్ట్ అలా కట్ చేసి"
    },
    {
      "t": "05:02",
      "text": "అక్కడ పెట్టండి"
    },
    {
      "t": "05:04",
      "text": "నైన్ త్రీ నైన్ డబల్ ఎయిట్ సిక్స్ వన్"
    },
    {
      "t": "05:06",
      "text": "అదే"
    },
    {
      "t": "05:08",
      "text": "డబల్ నైన్ సిక్స్"
    },
    {
      "t": "05:10",
      "text": "డబల్ నైన్"
    },
    {
      "t": "05:12",
      "text": "సిక్స్ ఎయిట్"
    },
    {
      "t": "05:14",
      "text": "మళ్ళీ చెప్పు"
    },
    {
      "t": "05:16",
      "text": "నువ్వు చెప్పు నువ్వేనా"
    },
    {
      "t": "05:18",
      "text": "నైన్ నైన్ త్రీ నైన్"
    },
    {
      "t": "05:20",
      "text": "డబల్ ఎయిట్ సిక్స్ వన్ డబల్ నైన్ సిక్స్"
    },
    {
      "t": "05:22",
      "text": "అంతే"
    },
    {
      "t": "05:24",
      "text": "అంతేనా"
    },
    {
      "t": "05:26",
      "text": "సరే"
    },
    {
      "t": "05:28",
