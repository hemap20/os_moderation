      "text": "ఓకే"
    },
    {
      "t": "00:02",
      "text": "ఇలా పిలవాలి"
    },
    {
      "t": "00:04",
      "text": "హలో యా ఎక్కడ నుంచి"
    },
    {
      "t": "00:06",
      "text": "సరే మ్యాడమ్"
    },
    {
      "t": "00:08",
      "text": "లేక"
    },
    {
      "t": "00:10",
      "text": "నేను యూఎస్ సండే"
    },
    {
      "t": "00:12",
      "text": "ఇక్కడ నేను యూఎస్ఏ"
    },
    {
      "t": "00:14",
      "text": "క్యూఎస్లో ఉంటా"
    },
    {
      "t": "00:16",
      "text": "మ్యారేజ్"
    },
    {
      "t": "00:18",
      "text": "ఇక్కడ"
    },
    {
      "t": "00:20",
      "text": "జాతీయ స్థాయిలో"
    },
    {
      "t": "00:22",
      "text": "యా"
    },
    {
      "t": "00:24",
      "text": "సింగిలేనా సింగిల్ అండి"
    },
    {
      "t": "00:26",
      "text": "మూడు"
    },
    {
      "t": "00:28",
      "text": "ఓకే నెక్స్ట్"
    },
    {
      "t": "00:30",
      "text": "అవుతుంది అప్పుడు వచ్చి"
    },
    {
      "t": "00:32",
      "text": "ఇది సెకండ్ డే"
    },
    {
      "t": "00:34",
      "text": "ఎలా ఉంది బాగుందా"
    },
    {
      "t": "00:36",
      "text": "బాగుందండి"
    },
    {
      "t": "00:38",
      "text": "అండ్"
    },
    {
      "t": "00:40",
      "text": "బాగుంది"
    },
    {
      "t": "00:42",
      "text": "ఎంజాయ్ చేస్తున్నారు"
    },
    {
      "t": "00:44",
      "text": "కైండ్ ఆఫ్"
    },
    {
      "t": "00:46",
      "text": "నౌ"
    },
    {
      "t": "00:48",
      "text": "మీకు మీరు"
    },
    {
      "t": "00:50",
      "text": "మీకు నచ్చిందా ఇక్కడ ఉండడం"
    },
    {
      "t": "00:52",
      "text": "నైన్"
    },
    {
      "t": "00:54",
      "text": "మొన్న ఇన్స్టాల్"
    },
    {
      "t": "00:56",
      "text": "ప్లేసా"
    },
    {
      "t": "00:58",
      "text": "ఆన్లైన్లో"
    },
    {
      "t": "01:00",
      "text": "ఓకే"
    },
    {
      "t": "01:02",
      "text": "మీ హస్బెండ్ ఉన్నారు"
    },
    {
      "t": "01:04",
      "text": "మీ హస్బెండ్"
    },
    {
      "t": "01:06",
      "text": "నారాయణ స్వామి"
    },
    {
      "t": "01:08",
      "text": "లైట్"
    },
    {
      "t": "01:10",
      "text": "ఓకే"
    },
    {
      "t": "01:12",
      "text": "ఇంటర్ ఆల్రెడీ కదా ఆన్లైన్"
    },
    {
      "t": "01:14",
      "text": "ఓకే"
    },
    {
      "t": "01:16",
      "text": "ఓపెన్గా ఉంటారా మరి ఇప్పుడు"
    },
    {
      "t": "01:18",
      "text": "ఆ"
    },
    {
      "t": "01:20",
      "text": "ఓపెన్గా ఉంటావా అంటున్నా"
    },
    {
      "t": "01:22",
      "text": "ఓపెన్గా మాట్లాడాలి"
    },
    {
      "t": "01:24",
      "text": "ఆ"
    },
    {
      "t": "01:26",
      "text": "చెప్పండి"
    },
    {
      "t": "01:28",
      "text": "సరే"
    },
    {
      "t": "01:30",
      "text": "అంటే"
    },
    {
      "t": "01:32",
      "text": "కొంచెం"
    },
    {
      "t": "01:34",
      "text": "ఎవరు ఉన్నారు"
    },
    {
      "t": "01:36",
      "text": "అంతే"
    },
    {
      "t": "01:38",
      "text": "ఓకే"
    },
    {
      "t": "01:40",
      "text": "సెక్స్ వెల్కమ్"
    },
    {
      "t": "01:42",
      "text": "మాట్లాడాలంటావు"
    },
    {
      "t": "01:44",
      "text": "ఆ"
    },
    {
      "t": "01:46",
      "text": "అదేవిధంగా"
    },
    {
      "t": "01:48",
      "text": "సారీ చెప్పండి మాట్లాడలేను"
    },
    {
      "t": "01:50",
      "text": "ఓకే"
    },
    {
      "t": "01:52",
      "text": "చూడవచ్చు కదా"
    },
    {
      "t": "01:54",
      "text": "ఆ"
    },
    {
      "t": "01:56",
      "text": "సెండ్ ఓన్లీ"
