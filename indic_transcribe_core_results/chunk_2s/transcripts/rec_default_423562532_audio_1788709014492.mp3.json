  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "ആ"
    },
    {
      "t": "00:04",
      "text": "എവിടെ ചെല്ലുമ്പോൾ"
    },
    {
      "t": "00:06",
      "text": "എല്ലാവരും ആ ഞാൻ"
    },
    {
      "t": "00:08",
      "text": "നാല് എറണാകുളം എടപ്പള്ളി എവിടെ"
    },
    {
      "t": "00:10",
      "text": "എടാ പുള്ളി"
    },
    {
      "t": "00:12",
      "text": "പിന്നെ കച്ചേരി"
    },
    {
      "t": "00:14",
      "text": "ആ"
    },
    {
      "t": "00:16",
      "text": "എന്താ ചെയ്യണേ"
    },
    {
      "t": "00:18",
      "text": "സൈക്കിൾ"
    },
    {
      "t": "00:20",
      "text": "ആ കച്ചേരിപ്പട്ടിലെ"
    },
    {
      "t": "00:22",
      "text": "എവിടെ"
    },
    {
      "t": "00:24",
      "text": "ആ ഹസ്ബൻഡൊന്ന്"
    },
    {
      "t": "00:26",
      "text": "ഒന്നുമില്ല ഇപ്പോൾ അതും കാണില്ലേ ഇങ്ങനെ രാത്രി ഫോൺ വിളിച്ച്"
    },
    {
      "t": "00:28",
      "text": "ഇല്ലടാ"
    },
    {
      "t": "00:30",
      "text": "ഉള്ളി വരുമ്പോൾ പത്തടിക്കും അതുപോലെ തന്നെ"
    },
    {
      "t": "00:32",
      "text": "ഏ"
    },
    {
      "t": "00:34",
      "text": "പിള്ളേരൊക്കെ"
    },
    {
      "t": "00:36",
      "text": "പിള്ളേര് രണ്ടാളും ഒരു കടയിൽ"
    },
    {
      "t": "00:38",
      "text": "അടിപൊളി"
    },
    {
      "t": "00:40",
      "text": "പറ്റിയ സമയമാണല്ലോ"
    },
    {
      "t": "00:42",
      "text": "അയ്യോ ഇതെല്ലാം എനിക്ക്"
    },
    {
      "t": "00:44",
      "text": "വെരി ഗുഡ്"
    },
    {
      "t": "00:46",
      "text": "കുറേ നാളായി ഉപയോഗിക്കണോ ഇല്ല ഇല്ല"
    },
    {
      "t": "00:48",
      "text": "എങ്ങനെയുണ്ട്"
    },
    {
      "t": "00:50",
      "text": "ഓക്കേ"
    },
    {
      "t": "00:52",
      "text": "എന്തു പറയും വിളിക്കുന്നവരൊക്കെ എന്തു പറയും"
    },
    {
      "t": "00:54",
      "text": "ഇവിടെ"
    },
    {
      "t": "00:56",
      "text": "വിളിക്കുന്നവരൊക്കെ എന്നാ പറയണേ"
    },
    {
      "t": "00:58",
      "text": "വിളിക്കുന്നവര്"
    },
    {
      "t": "01:00",
      "text": "എന്താ പറയുന്നതെന്ന് വെച്ചിട്ടുണ്ടെങ്കിൽ ജി പേ ചെയ്യാം"
    },
    {
      "t": "01:02",
      "text": "വാട്സപ്പ് നമ്പറ് തരൂ"
    },
    {
      "t": "01:04",
      "text": "ഡയറക്റ്റ് ആയിട്ട് തരുമോ"
    },
    {
      "t": "01:06",
      "text": "പതിനഞ്ച് ഇരുപത് ഇരുപത്തഞ്ചൊക്കെ തരാമെന്നൊക്കെ"
    },
    {
      "t": "01:08",
      "text": "പറയുന്നതായിരുന്നു"
    },
    {
      "t": "01:10",
      "text": "എന്നാ പറയും എനിക്ക്"
    },
    {
      "t": "01:12",
      "text": "താല്പര്യമില്ലാന്നു തന്നെ പറയാം"
    },
    {
      "t": "01:14",
      "text": "അപ്പം"
    },
    {
      "t": "01:16",
      "text": "അപ്പം കട്ട് ചെയ്തൊന്ന് പൊക്കോളൂ"
    },
    {
      "t": "01:18",
      "text": "ഈ ആപ്പിനെ"
    },
    {
      "t": "01:20",
      "text": "എന്നാൽ അത് ഏൺ ചെയ്യാൻ പറ്റുമോ"
    },
    {
      "t": "01:22",
      "text": "അപ്പുലത്ത് ഏൺ ചെയ്യാൻ പറ്റുമോ"
    },
    {
      "t": "01:24",
      "text": "പറ്റുമോ ഏൺ ചെയ്യാൻ പറ്റുമോ"
    },
    {
      "t": "01:26",
      "text": "പറ്റും അത് എങ്ങനെ"
    },
    {
      "t": "01:28",
      "text": "എൻ്റെ പേയ്മെൻ്റ് ഒക്കെ പറഞ്ഞേ"
    },
    {
      "t": "01:30",
      "text": "അതിങ്ങനെ"
    },
    {
      "t": "01:32",
      "text": "ഇതിനകത്ത് ഇങ്ങനെ സംസാരിച്ചുകൊണ്ടിരിക്കുമ്പോൾ ഇങ്ങനെ പഠിക്കാൻ പറ്റില്ല"
    },
    {
      "t": "01:34",
      "text": "പൈസ കയറിക്കൊണ്ടിരിക്കും അത് നമുക്ക്"
    },
    {
      "t": "01:36",
      "text": "നമുക്ക് തന്നെ ഇതിനകത്ത് നിന്ന് വിഡ്രോ ചെയ്തെടുക്കാം ലേഡീസ്"
    },
    {
      "t": "01:38",
      "text": "സ്പേസിൽ മാത്രമേ ഉള്ളൂ ബോയ്സിന് പറ്റില്ല"
    },
    {
      "t": "01:40",
      "text": "നമുക്ക് തന്നെ നമ്മൾ ഈ"
    },
    {
      "t": "01:42",
      "text": "അപ്പം"
    },
    {
      "t": "01:44",
      "text": "അപ്പം ഞാൻ അപ്പം ഇൻസ്റ്റാൾ ചെയ്യാം"
    },
    {
      "t": "01:46",
      "text": "ചെയ്യുമ്പോൾ അവർ വിളിക്കും"
    },
    {
      "t": "01:48",
      "text": "ഈ കാസർഗോഡിൽ"
    },
    {
      "t": "01:50",
      "text": "ഇത്രയും വലിയ സൗണ്ട്സ് ചെയ്യണേ"
    }
  ],
  "full_text": "ആ ആ എവിടെ ചെല്ലുമ്പോൾ എല്ലാവരും ആ ഞാൻ നാല് എറണാകുളം എടപ്പള്ളി എവിടെ എടാ പുള്ളി പിന്നെ കച്ചേരി ആ എന്താ ചെയ്യണേ സൈക്കിൾ ആ കച്ചേരിപ്പട്ടിലെ എവിടെ ആ ഹസ്ബൻഡൊന്ന് ഒന്നുമില്ല ഇപ്പോൾ അതും കാണില്ലേ ഇങ്ങനെ രാത്രി ഫോൺ വിളിച്ച് ഇല്ലടാ ഉള്ളി വരുമ്പോൾ പത്തടിക്കും അതുപോലെ തന്നെ ഏ പിള്ളേരൊക്കെ പിള്ളേര് രണ്ടാളും ഒരു കടയിൽ അടിപൊളി പറ്റിയ സമയമാണല്ലോ അയ്യോ ഇതെല്ലാം എനിക്ക് വെരി ഗുഡ് കുറേ നാളായി ഉപയോഗിക്കണോ ഇല്ല ഇല്ല എങ്ങനെയുണ്ട് ഓക്കേ എന്തു പറയും വിളിക്കുന്നവരൊക്കെ എന്തു പറയും ഇവിടെ വിളിക്കുന്നവരൊക്കെ എന്നാ പറയണേ വിളിക്കുന്നവര് എന്താ പറയുന്നതെന്ന് വെച്ചിട്ടുണ്ടെങ്കിൽ ജി പേ ചെയ്യാം വാട്സപ്പ് നമ്പറ് തരൂ ഡയറക്റ്റ് ആയിട്ട് തരുമോ പതിനഞ്ച് ഇരുപത് ഇരുപത്തഞ്ചൊക്കെ തരാമെന്നൊക്കെ പറയുന്നതായിരുന്നു എന്നാ പറയും എനിക്ക് താല്പര്യമില്ലാന്നു തന്നെ പറയാം അപ്പം അപ്പം കട്ട് ചെയ്തൊന്ന് പൊക്കോളൂ ഈ ആപ്പിനെ എന്നാൽ അത് ഏൺ ചെയ്യാൻ പറ്റുമോ അപ്പുലത്ത് ഏൺ ചെയ്യാൻ പറ്റുമോ പറ്റുമോ ഏൺ ചെയ്യാൻ പറ്റുമോ പറ്റും അത് എങ്ങനെ എൻ്റെ പേയ്മെൻ്റ് ഒക്കെ പറഞ്ഞേ അതിങ്ങനെ ഇതിനകത്ത് ഇങ്ങനെ സംസാരിച്ചുകൊണ്ടിരിക്കുമ്പോൾ ഇങ്ങനെ പഠിക്കാൻ പറ്റില്ല പൈസ കയറിക്കൊണ്ടിരിക്കും അത് നമുക്ക് നമുക്ക് തന്നെ ഇതിനകത്ത് നിന്ന് വിഡ്രോ ചെയ്തെടുക്കാം ലേഡീസ് സ്പേസിൽ മാത്രമേ ഉള്ളൂ ബോയ്സിന് പറ്റില്ല നമുക്ക് തന്നെ നമ്മൾ ഈ അപ്പം അപ്പം ഞാൻ അപ്പം ഇൻസ്റ്റാൾ ചെയ്യാം ചെയ്യുമ്പോൾ അവർ വിളിക്കും ഈ കാസർഗോഡിൽ ഇത്രയും വലിയ സൗണ്ട്സ് ചെയ്യണേ",
