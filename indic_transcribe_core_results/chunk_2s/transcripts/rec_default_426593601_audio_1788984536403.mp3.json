    },
    {
      "t": "00:10",
      "text": "எஸ் கே"
    },
    {
      "t": "00:12",
      "text": "கேட்க மாட்டேங்குதுங்க நீங்கள் பேசுகிறேன்"
    },
    {
      "t": "00:14",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:16",
      "text": "ம்"
    },
    {
      "t": "00:18",
      "text": "ம் எங்கேருந்து பேசுகிறீங்க"
    },
    {
      "t": "00:20",
      "text": "சொந்தக்காரர்கள்"
    },
    {
      "t": "00:22",
      "text": "ம் என்ன பேங்களூர்"
    },
    {
      "t": "00:24",
      "text": "ம்"
    },
    {
      "t": "00:26",
      "text": "நான் சிங்கிள்"
    },
    {
      "t": "00:28",
      "text": "நீங்கள் எங்களை மேரிடா"
    },
    {
      "t": "00:30",
      "text": "ம்"
    },
    {
      "t": "00:32",
      "text": "கேட்க மாட்டேனுங்க அம்மி பேசுகிறது கிட்ட வச்ச"
    },
    {
      "t": "00:34",
      "text": "பேசுங்க மேரிடு"
    },
    {
      "t": "00:36",
      "text": "ஓகே ஆப்பு எவ்வளோ"
    },
    {
      "t": "00:38",
      "text": "நான் எப்படி போயிட்டுருக்கேன்"
    },
    {
      "t": "00:40",
      "text": "நல்ல பைப்"
    },
    {
      "t": "00:42",
      "text": "எப்படி பேசிருக்க எப்படி பேசுறது"
    },
    {
      "t": "00:44",
      "text": "எக்ஸ்ட்ரா ஃபுல்லிக்"
    },
    {
      "t": "00:46",
      "text": "சரி"
    },
    {
      "t": "00:48",
      "text": "கேட்கல"
    },
    {
      "t": "00:50",
      "text": "எனக்கு"
    },
    {
      "t": "00:52",
      "text": "ஹலோ சொல்லுங்கள்"
    },
    {
      "t": "00:54",
      "text": "கிட்ட கிட்ட வச்சு"
    },
    {
      "t": "00:56",
      "text": "பேச வேண்டாம்"
    },
    {
      "t": "00:58",
      "text": "சரிங்க சார்"
    },
    {
      "t": "01:00",
      "text": "சரி சரி நான் பேசுகிறேன் சார்"
    },
    {
      "t": "01:02",
      "text": "கேட்க மாட்டேன்"
    },
    {
      "t": "01:04",
      "text": "வச்சு பேசுங்கள்"
    },
    {
      "t": "01:06",
      "text": "சொல்லுங்கள் ம்"
    },
    {
      "t": "01:08",
      "text": "ம்"
    },
    {
      "t": "01:10",
      "text": "எவ்வளோ நாள் எப்படி போயிட்டுருக்குன்னு"
    },
    {
      "t": "01:12",
      "text": "நான் ஒரு"
    },
    {
      "t": "01:14",
      "text": "டெக்ஸா போகும்பொழுது டெக்ஸா"
    },
    {
      "t": "01:16",
      "text": "சென்னை மெதுவாக இருக்குது"
    },
    {
      "t": "01:18",
      "text": "ஓகே ஓகே உங்களுக்கு"
    },
    {
      "t": "01:20",
      "text": "பேசிக்க அப்படி பேசிக்கலாம்"
    },
    {
      "t": "01:22",
      "text": "எப்படி"
    },
    {
      "t": "01:24",
      "text": "பேசியிருக்கேன் எப்படி பேசினா பிடிக்கும்"
    },
    {
      "t": "01:26",
      "text": "ம் நல்லா பேசலாம்"
    },
    {
      "t": "01:28",
      "text": "ராமாயணம் சேவைக்கு"
    },
    {
      "t": "01:30",
      "text": "செக் பண்ணியிருக்கீங்களா இப்போ ரீசெண்ட்டாக ஆச்சு"
    },
    {
      "t": "01:32",
      "text": "ஓகே"
    },
    {
      "t": "01:34",
      "text": "ஒன்று சொல்லுங்கள்"
    },
    {
      "t": "01:36",
      "text": "எப்போ பண்ணீங்க"
    },
    {
      "t": "01:38",
      "text": "அந்த மாதிரிலாம் இல்லை ரொம்ப நல்லா"
    },
    {
      "t": "01:40",
      "text": "இல்லை பண்ணது"
    },
    {
      "t": "01:42",
      "text": "தெரியலையா"
    },
    {
      "t": "01:44",
      "text": "சரிங்க சார்"
    },
    {
      "t": "01:46",
      "text": "கேட்கல"
    },
    {
      "t": "01:48",
      "text": "முதல்ல பண்ணி ரொம்ப நாள் ஆச்சுங்க"
    },
    {
      "t": "01:50",
      "text": "ஏன் அவர் என்னை அசைக்க மாட்டார்"
    },
    {
      "t": "01:52",
      "text": "ஆ நியூ இயர்"
    },
    {
      "t": "01:54",
      "text": "அப்போ"
    },
    {
      "t": "01:56",
      "text": "என்ன பண்ணுறீங்க கண்ட்ரோல் ஃபிங்கரிங்"
    },
    {
      "t": "01:58",
      "text": "வீடியோஸ்"
    },
    {
      "t": "02:00",
      "text": "இது வந்து சும்மா வந்து ஆப்ல வரல"
    },
    {
      "t": "02:02",
      "text": "எஸ் சூப்பர்"
    },
    {
      "t": "02:04",
      "text": "என்ன சைஸ் நெப்பல்"
    },
    {
      "t": "02:06",
      "text": "ம் தேர்ட்டி மினிட்"
    },
    {
      "t": "02:08",
      "text": "எனது கட்டளை"
    },
    {
      "t": "02:10",
      "text": "சொல்லுங்கள்"
    },
    {
      "t": "02:12",
      "text": "காட்டலாண்ணே"
    },
    {
      "t": "02:14",
      "text": "ம்"
    },
    {
      "t": "02:16",
      "text": "சரிங்க"
    },
    {
      "t": "02:18",
      "text": "சரிங்க சார்"
    },
    {
      "t": "02:20",
      "text": "ஓப்பன் பண்ணி காட்டுறேன்"
    },
    {
      "t": "02:22",
      "text": "சரிங்க சார்"
    },
    {
      "t": "02:24",
      "text": "அதனால் அந்த ஒரு"
    },
    {
      "t": "02:26",
      "text": "சரிங்க சார்"
    },
