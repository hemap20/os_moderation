{
  "file_id": "rec_audio_call_425905210_audio_1788932612192.mp3",
  "language": "telugu",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 614.5690625,
  "processing_time_sec": 41.64285159111023,
  "segments": [
    {
      "t": "00:00",
      "text": "చూసారా"
    },
    {
      "t": "00:02",
      "text": "ఓకే"
    },
    {
      "t": "00:04",
      "text": "హాయ్"
    },
    {
      "t": "00:06",
      "text": "అక్కడ నుంచి"
    },
    {
      "t": "00:08",
      "text": "సూపర్"
    },
    {
      "t": "00:10",
      "text": "ఓం గారు"
    },
    {
      "t": "00:12",
      "text": "మసూరి పట్టి"
    },
    {
      "t": "00:14",
      "text": "టెక్"
    },
    {
      "t": "00:16",
      "text": "ఏం చేసుకుంటారు"
    },
    {
      "t": "00:18",
      "text": "ఓకే"
    },
    {
      "t": "00:20",
      "text": "నేను"
    },
    {
      "t": "00:22",
      "text": "డ్రైవింగ్"
    },
    {
      "t": "00:24",
      "text": "డ్రైవింగ్ చేస్తారా"
    },
    {
      "t": "00:26",
      "text": "అండ్"
    },
    {
      "t": "00:28",
      "text": "నేను హౌస్ వైఫ్"
    },
    {
      "t": "00:30",
      "text": "హౌస్ వైఫ్ హౌస్ వైఫ్"
    },
    {
      "t": "00:32",
      "text": "ఎక్కడ ఉంటావు"
    },
    {
      "t": "00:34",
      "text": "తిరుపతి"
    },
    {
      "t": "00:36",
      "text": "ఇదిగో"
    },
    {
      "t": "00:38",
      "text": "పర్పస్ ఉండే మేడం"
    },
    {
      "t": "00:40",
      "text": "యా"
    },
    {
      "t": "00:42",
      "text": "మ్యారీడ్"
    },
    {
      "t": "00:44",
      "text": "ఎస్ ఎస్"
    },
    {
      "t": "00:46",
      "text": "అప్పుడు టైం పడుతుంది టైం పడుతుంది"
    },
    {
      "t": "00:48",
      "text": "ఎస్"
    },
    {
      "t": "00:50",
      "text": "టైం పాస్"
    },
    {
      "t": "00:52",
      "text": "ప్లీజ్"
    },
    {
      "t": "00:54",
      "text": "నారాయణ"
    },
    {
      "t": "00:56",
      "text": "అలాగే"
    },
    {
      "t": "00:58",
      "text": "ఎన్ని రోజులు అయింది వచ్చి"
    },
    {
      "t": "01:00",
      "text": "ఫైవ్ మంత్స్ సిక్స్ మంత్స్ అవుతుంది"
    },
    {
      "t": "01:02",
      "text": "సరే"
    },
    {
      "t": "01:04",
      "text": "ఓకే"
    },
    {
      "t": "01:06",
      "text": "మీరు"
    },
    {
      "t": "01:08",
      "text": "ఎలాంటి పాటలు"
    },
    {
      "t": "01:10",
      "text": "ఎలాంటి మాటలు అంటే ఇష్టం"
    },
    {
      "t": "01:12",
      "text": "ఎలాంటి నొచ్చులు అంటే"
    },
    {
      "t": "01:14",
      "text": "సిస్టమ్"
    },
    {
      "t": "01:16",
      "text": "ఉన్నాయి"
    },
    {
      "t": "01:18",
      "text": "చూద్దాం"
    },
    {
      "t": "01:20",
      "text": "ఎలాంటి ఇష్టం నీకు"
    },
    {
      "t": "01:22",
      "text": "ఎలాంటి ఇష్టమా"
    },
    {
      "t": "01:24",
      "text": "అన్నసా"
    },
    {
      "t": "01:26",
      "text": "నార్మల్గా అంటే ఇష్టం నార్మల్గా మాట్లాడడం"
    },
    {
      "t": "01:28",
      "text": "పని చేసేయచ్చు ఈ"
    },
    {
      "t": "01:30",
      "text": "నార్మల్ మాట్లాడితే"
    },
    {
      "t": "01:32",
      "text": "ప్లీజ్ కమాండ్"
    },
    {
      "t": "01:34",
      "text": "నార్మల్ ఏముంటుందబ్బా"
    },
    {
      "t": "01:36",
      "text": "ఎవరు మాట్లాడేది ఏమో ఫ్లవర్స్ లెక్క"
    },
    {
      "t": "01:38",
      "text": "మాట్లాడుతున్నాను"
    },
    {
      "t": "01:40",
      "text": "నమస్తే అమ్మ మాట్లాడలేదు"
    },
    {
      "t": "01:42",
      "text": "ఆ"
    },
    {
      "t": "01:44",
      "text": "లవర్స్ని అక్కడ మార్చేసి"
    },
    {
      "t": "01:46",
      "text": "ఏమంటే ఇంకా నుండి రవర్స్ లెక్కనే మాట్లాడుతున్నాను"
    },
    {
      "t": "01:48",
      "text": "ఎవరైనా ఉన్నారా"
    },
    {
      "t": "01:50",
      "text": "కాపాడుతున్నా"
    },
    {
      "t": "01:52",
      "text": "ఎవరు లేరు"
    },
    {
      "t": "01:54",
      "text": "అది మాట్లాడే మాటలు అన్నీ అట్టే మాట్లాడుతున్నాను"
    },
    {
      "t": "01:56",
      "text": "మన"
    },
    {
      "t": "01:58",
      "text": "ఇప్పుడు ఏంటంటే ఇప్పుడు ఏదో రొమాన్స్"
    },
    {
      "t": "02:00",
      "text": "ఏదో ఎంజాయ్ కోసం వస్తారు"
    },
    {
      "t": "02:02",
      "text": "ఆరు వందల రూపాయలు"
    },
    {
      "t": "02:04",
      "text": "ఏదో మాట్లాడితే ఏం సాటిస్ఫాక్షన్ ఉందో"
    },
    {
      "t": "02:06",
      "text": "అదే"
    },
    {
      "t": "02:08",
      "text": "తప్పేం లేదు మా చెల్లెలు ఉన్నారు"
    },
    {
      "t": "02:10",
      "text": "కారణం ఏంటంటే టైంపాస్"
    },
    {
      "t": "02:12",
      "text": "లెక్కన టైంపాస్ లెక్కన మాట్లాడేవాళ్ళు బాగా"
    },
    {
      "t": "02:14",
      "text": "బాగా అలా మాట్లాడేటప్పుడు బాగా"
    },
    {
      "t": "02:16",
      "text": "పర్లా కూడా మాట్లాడుకుంటున్నారు ఆ విధంగా"
    },
    {
      "t": "02:18",
      "text": "అవునా"
    },
    {
      "t": "02:20",
      "text": "ఆ"
    },
    {
      "t": "02:22",
      "text": "దీన్ని బట్టి మాట్లాడుకుంటే"
    },
    {
      "t": "02:24",
      "text": "దీన్ని బట్టి మాకు దీన్ని బట్టి"
    },
    {
      "t": "02:26",
      "text": "ఏజెంట్ వచ్చి ఏమీ లేదు"
    },
    {
      "t": "02:28",
      "text": "నార్మల్గా అంటే"
    },
    {
      "t": "02:30",
      "text": "మనకి అప్పటికి మార్వేడా బెండ"
    },
    {
      "t": "02:32",
      "text": "ఏ విధంగా అభిప్రాయం చెప్పాడా"
    },
    {
      "t": "02:34",
      "text": "ఏజ్ ఎంతని"
    },
    {
      "t": "02:36",
      "text": "అక్కా చెఫ్ అయ్యింది"
    },
    {
      "t": "02:38",
      "text": "ఆ"
    },
    {
      "t": "02:40",
      "text": "థర్టీ ఫైవ్ థర్టీ ఫైవ్"
    },
    {
      "t": "02:42",
      "text": "మరి ఇంత సర్వీస్ ఎన్నో ఉన్నాయి"
    },
    {
      "t": "02:44",
      "text": "వన్ ఫిఫ్టీ ఫైవ్"
    },
    {
      "t": "02:46",
      "text": "లెక్క మాట్లాడుకుంటే మజా ఉంటుంది"
    },
    {
      "t": "02:48",
      "text": "ఇంకా"
    },
    {
      "t": "02:50",
      "text": "సిక్స్ డేస్ అయింది అక్క మాట్లాడాలి"
    },
    {
      "t": "02:52",
      "text": "మళ్ళీ ఏమంటారంటే కొంచెం"
    },
    {
      "t": "02:54",
      "text": "అది సత్యకర్ మాట్లాడితే"
    },
    {
      "t": "02:56",
      "text": "కంపల్సరీ లెక్కన చదువుతారు మాట్లాడడానికి"
    },
    {
      "t": "02:58",
      "text": "అది"
    },
    {
      "t": "03:00",
      "text": "వస్తాయి"
    },
    {
      "t": "03:02",
      "text": "ఇప్పుడు"
    },
    {
      "t": "03:04",
      "text": "ఫ్లెక్స్ ఫుల్ టాక్"
    },
    {
      "t": "03:06",
      "text": "సెక్సువల్ టాక్ సెక్సువల్ టాక్ అంటారు ప్రతి ఒక్కరు"
    },
    {
      "t": "03:08",
      "text": "స్టార్ట్ చేశామంట"
    },
    {
      "t": "03:10",
      "text": "చెయ్యి నీ అమ్మమ్మ అంటే సెక్సేనా ఇక"
    },
    {
      "t": "03:12",
      "text": "ఏముండాలి ఆ జీవితం"
    },
    {
      "t": "03:14",
      "text": "ఎక్కడ అమౌంట్ రాబోతుంది"
    },
    {
      "t": "03:16",
      "text": "సార్"
    },
    {
      "t": "03:18",
      "text": "అసలు చెప్పండి"
    },
    {
      "t": "03:20",
      "text": "పది నిమిషాల పని అది"
    },
    {
      "t": "03:22",
      "text": "ప్రత్యేకించి"
    },
    {
      "t": "03:24",
      "text": "లేదంటే ఈత ఉంటుంది"
    },
    {
      "t": "03:26",
      "text": "స్థితి లేదంట గంటసేపు ఉంటుంది"
    },
    {
      "t": "03:28",
      "text": "అంతేగాని"
    },
    {
      "t": "03:30",
      "text": "బనానా చాప"
    },
    {
      "t": "03:32",
      "text": "సూట్ అవ్వవే వస్తాయి ఎక్కువగా"
    },
    {
      "t": "03:34",
      "text": "కన్ఫర్జన్ చేశామని చెప్పి"
    },
    {
      "t": "03:36",
      "text": "ఆ"
    },
    {
      "t": "03:38",
      "text": "ఇప్పుడు ఏం తక్కువ వచ్చాడు"
    },
    {
      "t": "03:40",
      "text": "ఇంటర్లో నైంటీ పర్సెంట్"
    },
    {
      "t": "03:42",
      "text": "ఆ తర్వాత తట్టెడు నెలలు వేస్తారు"
    },
    {
      "t": "03:44",
      "text": "వస్తాడు"
    },
    {
      "t": "03:46",
      "text": "పచ్చి కాపర్ మీద నార్మల్గా"
    },
    {
      "t": "03:48",
      "text": "కంటిన్యూగా బాగా మార్చి"
    },
    {
      "t": "03:50",
      "text": "సైడ్ ఇన్ వరల్డ్ కూడా వస్తారు"
    },
    {
      "t": "03:52",
      "text": "అవును"
    },
    {
      "t": "03:54",
      "text": "టైంపాస్ ప్రాక్టీస్ సినిమాకి వెళ్ళి"
    },
    {
      "t": "03:56",
      "text": "వస్తారు అంటే ఈ చక్రా తాకులు మామూలుగా ఉంటాయి"
    },
    {
      "t": "03:58",
      "text": "ఆన్లైన్ చెక్ చేయించు"
    },
    {
      "t": "04:00",
      "text": "యాప్లో ఎలా ఉంది"
    },
    {
      "t": "04:02",
      "text": "అక్కడ వాతావరణం ఎలా ఉంది"
    },
    {
      "t": "04:04",
      "text": "ఆ వార్తలలో ఇంగ్లీష్ ఫ్యామిలీ పరంగా ఇంగ్లీష్"
    },
    {
      "t": "04:06",
      "text": "వస్తున్నారు"
    },
    {
      "t": "04:08",
      "text": "అవి ఇవి అన్ని ఇవి కట్ అవి ఇవి కట్ చేసాము"
    },
    {
      "t": "04:10",
      "text": "అవి అయితే ఇలాంటివి అలాంటివి అని చెప్పేవాళ్ళు"
    },
    {
      "t": "04:12",
      "text": "అర్థం చేసుకోండి"
    },
    {
      "t": "04:14",
      "text": "హ్మ్"
    },
    {
      "t": "04:16",
      "text": "సరే"
    },
    {
      "t": "04:18",
      "text": "రెండు"
    },
    {
      "t": "04:20",
      "text": "అందరు అందరు పిల్లలు ఏం పోతారు"
    },
    {
      "t": "04:22",
      "text": "మాతా"
    },
    {
      "t": "04:24",
      "text": "ఈ"
    },
    {
      "t": "04:26",
      "text": "నాకైతే వస్తావా పాప"
    },
    {
      "t": "04:28",
      "text": "ఓకే"
    },
    {
      "t": "04:30",
      "text": "మీ ఆయన ఏం చేస్తాడు"
    },
    {
      "t": "04:32",
      "text": "పంచ్ ఆటో ఇది"
    },
    {
      "t": "04:34",
      "text": "ఇగో"
    },
    {
      "t": "04:36",
      "text": "మా ఆయన పాత డ్రైవరు"
    },
    {
      "t": "04:38",
      "text": "ఇది"
    },
    {
      "t": "04:40",
      "text": "ఇంకా"
    },
    {
      "t": "04:42",
      "text": "చెప్పండి"
    },
    {
      "t": "04:44",
      "text": "కొంచెం"
    },
    {
      "t": "04:46",
      "text": "మీరేం చేస్తే కారం పెట్టారు ఆయన"
    },
    {
      "t": "04:48",
      "text": "స్టార్ట్ అయ్యారు"
    },
    {
      "t": "04:50",
      "text": "సో"
    },
    {
      "t": "04:52",
      "text": "మ్యారేజ్ అయినా మరి"
    },
    {
      "t": "04:54",
      "text": "అందులో"
    },
    {
      "t": "04:56",
      "text": "మేము అయిపోయింది"
    },
    {
      "t": "04:58",
      "text": "చేస్తున్నాం ఇతరులని ఏం చేస్తున్నారు"
    },
    {
      "t": "05:00",
      "text": "అండ్ మనోడు జాబియా"
    },
    {
      "t": "05:02",
      "text": "సరే"
    },
    {
      "t": "05:04",
      "text": "ఏం చేస్తుంది"
    },
    {
      "t": "05:06",
      "text": "జాబ్"
    },
    {
      "t": "05:08",
      "text": "ఓకే"
    },
    {
      "t": "05:10",
      "text": "ఏం జాబు సాఫ్ట్వేర్"
    },
    {
      "t": "05:12",
      "text": "సింపుల్ ఫీచరా"
    },
    {
      "t": "05:14",
      "text": "స్టాఫ్ నర్స్"
    },
    {
      "t": "05:16",
      "text": "స్టాప్లెస్లోకి వస్తుంది"
    },
    {
      "t": "05:18",
      "text": "గవర్నమెంట్ జాబ్ అన్నమాట"
    },
    {
      "t": "05:20",
      "text": "ఇక ఆరు లెవెల్ పడుతుంది"
    },
    {
      "t": "05:22",
      "text": "ఒకటి ఒకటి నాలుగు ఒకటి ఒకటి"
    },
    {
      "t": "05:24",
      "text": "సరే"
    },
    {
      "t": "05:26",
      "text": "కలుసుకుందాం అంటే ఏమన్నా అప్పుడు నేను ఉండను"
    },
    {
      "t": "05:28",
      "text": "నేను మొక్కుకున్నాను అమ్మ బాగుంది"
    },
    {
      "t": "05:30",
      "text": "ఇది హోటల్"
    },
    {
      "t": "05:32",
      "text": "అంతేకానీ బయట"
    },
    {
      "t": "05:34",
      "text": "ఫైటింగ్ అవ్వాలి అనుకుంటున్నారు"
    },
    {
      "t": "05:36",
      "text": "ఆ"
    },
    {
      "t": "05:38",
      "text": "ఇది కూడా ఎంజాయ్మెంట్ కదా"
    },
    {
      "t": "05:40",
      "text": "రావాలి కదా అని మెల్లగా ఇంట్లోకి వచ్చాను"
    },
    {
      "t": "05:42",
      "text": "ఓకే"
    },
    {
      "t": "05:44",
      "text": "అయితే మీట్ అవుదాం అనుకుంటున్నాడు"
    },
    {
      "t": "05:46",
      "text": "అట్లాగే ఇప్పుడు మీ"
    },
    {
      "t": "05:48",
      "text": "నిజం అనుకుంటే నీకు దెబ్బ"
    },
    {
      "t": "05:50",
      "text": "దగ్గరలో ఉంటే మీట్ అవ్వగలుగుతారు"
    },
    {
      "t": "05:52",
      "text": "ఎక్కడెక్కడో జనమేటాకు వెళ్తారు"
    },
    {
      "t": "05:54",
      "text": "అర్థం కావట్లేదు"
    },
    {
      "t": "05:56",
      "text": "మీరు మీటా"
    },
    {
      "t": "05:58",
      "text": "అలా అనుకుంటే మీకు అనుగుణంగా మీకు"
    },
    {
      "t": "06:00",
      "text": "దగ్గరలో ఉంటే మీట్ అవ్వగలం చాలు"
    },
    {
      "t": "06:02",
      "text": "అవును"
    },
    {
      "t": "06:04",
      "text": "ఎక్కడ కూడా దూరం"
    },
    {
      "t": "06:06",
      "text": "డైనోమీటర్ పడతాం మీరు దాని ఫీల్డ్ మీద కూడా చూసుకోవాలి"
    },
    {
      "t": "06:08",
      "text": "అవునండి"
    },
    {
      "t": "06:10",
      "text": "అవునవును కరెక్టే చెప్తున్నాను"
    },
    {
      "t": "06:12",
      "text": "ఆ"
    },
    {
      "t": "06:14",
      "text": "మీరు వైఫ్ ఉండు కాబట్టి"
    },
    {
      "t": "06:16",
      "text": "అరే"
    },
    {
      "t": "06:18",
      "text": "అట్లా ఇప్పుడు"
    },
    {
      "t": "06:20",
      "text": "కన్నులతోటి వినే టైం మాట్లాడలేదు"
    },
    {
      "t": "06:22",
      "text": "యాప్ ఉందనుకో"
    },
    {
      "t": "06:24",
      "text": "ఎంబీఏ పట్టి"
    },
    {
      "t": "06:26",
      "text": "ఎక్స్ప్లెయిన్ చేస్తాను"
    },
    {
      "t": "06:28",
      "text": "దీని పక్కనే కాదు పక్కకు తోడు"
    },
    {
      "t": "06:30",
      "text": "ఈ"
    },
    {
      "t": "06:32",
      "text": "ఒక టూ అవర్స్ జర్నీ"
    },
    {
      "t": "06:34",
      "text": "సేమ్ జర్నీ అయితే మీకు కంఫర్ట్గా ఉంటుంది"
    },
    {
      "t": "06:36",
      "text": "ఆహా"
    },
    {
      "t": "06:38",
      "text": "ఆ"
    },
    {
      "t": "06:40",
      "text": "మార్నింగ్ అయితే రీయూనియన్ ఇవ్వచ్చు కదా"
    },
    {
      "t": "06:42",
      "text": "నైట్ ఎక్కడికి తెల్లవారుజామున ఉదయం నిన్న"
    },
    {
      "t": "06:44",
      "text": "ఓకే రెండు గంటలకు హైదరాబాద్లో"
    },
    {
      "t": "06:46",
      "text": "అండ్"
    },
    {
      "t": "06:48",
      "text": "మీరు ఎక్కడ"
    },
    {
      "t": "06:50",
      "text": "ఇప్పుడు హైదరాబాద్ కదా"
    },
    {
      "t": "06:52",
      "text": "అవును"
    },
    {
      "t": "06:54",
      "text": "ఆమె హైదరాబాద్లో ఉన్నారు ఇంకా"
    },
    {
      "t": "06:56",
      "text": "అక్కడ నుంచి మీరు ఇంకా"
    },
    {
      "t": "06:58",
      "text": "తిరుపతి లలిత కళా హై స్కూల్ లలిత కళా హై స్కూల్"
    },
    {
      "t": "07:00",
      "text": "అట్లా ఉన్నాయో అట్లా"
    },
    {
      "t": "07:02",
      "text": "యాడిబుల్ ప్యాటర్న్ చూసుకుంటే దీని ఇంకా"
    },
    {
      "t": "07:04",
      "text": "మనం ఇంకెప్పుడు చాలా వరకు రావాల్సి వస్తుంది"
    },
    {
      "t": "07:06",
      "text": "అట్లా చూసుకుంటే"
    },
    {
      "t": "07:08",
      "text": "చూసుకుంటే"
    },
    {
      "t": "07:10",
      "text": "అంత దూరం పోవాలంటే వస్తుంది కదా"
    },
    {
      "t": "07:12",
      "text": "అక్కడ ఉన్నారండి"
    },
    {
      "t": "07:14",
      "text": "ఊర్లలో మీ పక్క పక్క ఊర్లలో చూస్తాం"
    },
    {
      "t": "07:16",
      "text": "ఉంటాయి"
    },
    {
      "t": "07:18",
      "text": "బాగా"
    },
    {
      "t": "07:20",
      "text": "ఉంటుంది కదా కార్ ఇంకా ఎక్కువగా"
    },
    {
      "t": "07:22",
      "text": "బాగుంది సీఎం జగన్"
    },
    {
      "t": "07:24",
      "text": "అర్థం చేయి కదా అని చెప్తున్నాను"
    },
    {
      "t": "07:26",
      "text": "అవును కరెక్ట్"
    },
    {
      "t": "07:28",
      "text": "ఇంకా సరే"
    },
    {
      "t": "07:30",
      "text": "ఇంకా ప్రూవ్ అయినట్టున్నా"
    },
    {
      "t": "07:32",
      "text": "నరకయాతన"
    },
    {
      "t": "07:34",
      "text": "ఇప్పుడు"
    },
    {
      "t": "07:36",
      "text": "ఇప్పుడు ఏదో"
    },
    {
      "t": "07:38",
      "text": "ఏదో"
    },
    {
      "t": "07:40",
      "text": "మన నోటి ఆనందం"
    },
    {
      "t": "07:42",
      "text": "కోసం నేను తోటి మాట్లాడతాను"
    },
    {
      "t": "07:44",
      "text": "అట్లా నువ్వు రమ్మనగానే నేను రాలేదు"
    },
    {
      "t": "07:46",
      "text": "ఏం లేదు అంత ఉద్ధరణ"
    },
    {
      "t": "07:48",
      "text": "ఆ"
    },
    {
      "t": "07:50",
      "text": "రాలేము"
    },
    {
      "t": "07:52",
      "text": "నాకు"
    },
    {
      "t": "07:54",
      "text": "పోతే జర ఆనందం"
    },
    {
      "t": "07:56",
      "text": "నో ధ్యానంలో"
    },
    {
      "t": "07:58",
      "text": "అటువంటి ఆనందం"
    },
    {
      "t": "08:00",
      "text": "ఏవోలా"
    },
    {
      "t": "08:02",
      "text": "అంటాం"
    },
    {
      "t": "08:04",
      "text": "తీటా ఎవర్ తీటా"
    },
    {
      "t": "08:06",
      "text": "ఆల్రెడీ"
    },
    {
      "t": "08:08",
      "text": "డబ్బులు వేసుకోవాలి మాట్లాడాలి"
    },
    {
      "t": "08:10",
      "text": "తృప్తి పడాలి"
    },
    {
      "t": "08:12",
      "text": "మంచిగా అనిపిస్తుంది"
    },
    {
      "t": "08:14",
      "text": "దానికి తోడు అవతల పార్ట్నర్"
    },
    {
      "t": "08:16",
      "text": "కరెక్ట్ దొరికిందంట"
    },
    {
      "t": "08:18",
      "text": "బాగుంది"
    },
    {
      "t": "08:20",
      "text": "ఉంటారు"
    },
    {
      "t": "08:22",
      "text": "అంటే అక్కడ ఉంది కదా"
    },
    {
      "t": "08:24",
      "text": "మాట్లాడటం దొరకాలి"
    },
    {
      "t": "08:26",
      "text": "ముందుగా ఎట్లా చేస్తారు"
    },
    {
      "t": "08:28",
      "text": "చేస్తావు నీకు ఎట్లా ఎట్లా అంటే బాగుంటుంది"
    },
    {
      "t": "08:30",
      "text": "ఉంటుంది"
    },
    {
      "t": "08:32",
      "text": "బాగుంటుంది ఇలాంటి డిమాండ్స్ వస్తుంటే"
    },
    {
      "t": "08:34",
      "text": "ఇందులో"
    },
    {
      "t": "08:36",
      "text": "మేము డబ్బులు వేసుకొని చేసినందుకు"
    },
    {
      "t": "08:38",
      "text": "ఇందులో ఈడ మాకు"
    },
    {
      "t": "08:40",
      "text": "కొట్టుకోవడానికి ఈజీ అయిపోతుంది"
    },
    {
      "t": "08:42",
      "text": "ఆపి"
    },
    {
      "t": "08:44",
      "text": "అదే"
    },
    {
      "t": "08:46",
      "text": "అదొక నందవంశ"
    },
    {
      "t": "08:48",
      "text": "అఖిలేష్ బాబు టాప్ మోస్ట్ ఎక్స్ట్రాడినరీ"
    },
    {
      "t": "08:50",
      "text": "ట్వంటీ ఇయర్స్ అయింది అనుకున్నా పోదు"
    },
    {
      "t": "08:52",
      "text": "ఆ"
    },
    {
      "t": "08:54",
      "text": "అది లేనిది"
    },
    {
      "t": "08:56",
      "text": "డబ్బులు వేసుకొని ఎందుకు కాల్ చేస్తాము"
    },
    {
      "t": "08:58",
      "text": "చాలు"
    },
    {
      "t": "09:00",
      "text": "అదే విధంగా వచ్చి"
    },
    {
      "t": "09:02",
      "text": "పేజీని బట్టి మా"
    },
    {
      "t": "09:04",
      "text": "ఆటలు ఉంటాయి"
    },
    {
      "t": "09:06",
      "text": "నాకెంత నాది కరెక్ట్ నాది కరెక్ట్"
    },
    {
      "t": "09:08",
      "text": "ఫార్టీ త్రీ ఇయర్స్ నుండి"
    },
    {
      "t": "09:10",
      "text": "అవును"
    },
    {
      "t": "09:12",
      "text": "ఆర్టిస్ట్లు ఏం చేస్తారు"
    },
    {
      "t": "09:14",
      "text": "ఇంకోటి చెప్తుంటా అంటే"
    },
    {
      "t": "09:16",
      "text": "కావాలి ఉంటుంది బాగా"
    },
    {
      "t": "09:18",
      "text": "సరే"
    },
    {
      "t": "09:20",
      "text": "ఫార్టీ డిఎస్ గుణ"
    },
    {
      "t": "09:22",
      "text": "ఆ"
    },
    {
      "t": "09:24",
      "text": "పాత క్రియాశక్తి చాలా బాగా అనిపిస్తుంది"
    },
    {
      "t": "09:26",
      "text": "ఇంకా"
    },
    {
      "t": "09:28",
      "text": "అర్థమైంది"
    },
    {
      "t": "09:30",
      "text": "అంటే కొంతమంది చేయి"
    },
    {
      "t": "09:32",
      "text": "కొంచెం ఇవే చేయకపోతే"
    },
    {
      "t": "09:34",
      "text": "సర్వీస్లో ఉంటారు"
    },
    {
      "t": "09:36",
      "text": "అవసరం అండి"
    },
    {
      "t": "09:38",
      "text": "చెప్పలేనండి పౌడర్స్ ఇట్లా"
    },
    {
      "t": "09:40",
      "text": "ఎట్లా ఎట్లా"
    },
    {
      "t": "09:42",
      "text": "సార్"
    },
    {
      "t": "09:44",
      "text": "ఓకే"
    },
    {
      "t": "09:46",
      "text": "పండు తేకుండా"
    },
    {
      "t": "09:48",
      "text": "ఆ"
    },
    {
      "t": "09:50",
      "text": "ఓకే"
    },
    {
      "t": "09:52",
      "text": "అవును"
    },
    {
      "t": "09:54",
      "text": "అందుకని"
    },
    {
      "t": "09:56",
      "text": "డౌట్ వచ్చింది"
    },
    {
      "t": "09:58",
      "text": "అవసరం"
    },
    {
      "t": "10:00",
      "text": "అంటారు కదా"
    },
    {
      "t": "10:02",
