  "segments": [
    {
      "t": "00:00",
      "text": "ஓகே சார்"
    },
    {
      "t": "00:02",
      "text": "ம்"
    },
    {
      "t": "00:04",
      "text": "ஹலோ"
    },
    {
      "t": "00:06",
      "text": "இட்டு"
    },
    {
      "t": "00:08",
      "text": "ம்"
    },
    {
      "t": "00:10",
      "text": "ஹலோ ஆ சொல்லுங்கள்"
    },
    {
      "t": "00:12",
      "text": "எனக்கு"
    },
    {
      "t": "00:14",
      "text": "இப்படி கொடுக்கறதுக்கு தான்"
    },
    {
      "t": "00:16",
      "text": "ம் ம் ஜெயகோபி ஜெயகோபி சார்"
    },
    {
      "t": "00:18",
      "text": "நான் ஒரு சொல்"
    },
    {
      "t": "00:20",
      "text": "ம் என்ன பண்ணுறது"
    },
    {
      "t": "00:22",
      "text": "சும்மா"
    },
    {
      "t": "00:24",
      "text": "இதுதான்"
    },
    {
      "t": "00:26",
      "text": "சரி சரி ஆ மேரேஜ்"
    },
    {
      "t": "00:28",
      "text": "ரெண்டு அவுட் சைஃபாக இருக்கும்"
    },
    {
      "t": "00:30",
      "text": "சேர்த்து நான்"
    },
    {
      "t": "00:32",
      "text": "மேரிடு ஒர்க் பண்ணிட்டுருக்கேன்"
    },
    {
      "t": "00:34",
      "text": "ம்"
    },
    {
      "t": "00:36",
      "text": "போட்டாச்சுங்களா என்ன இன்னைக்கு ஒர்க்கா"
    },
    {
      "t": "00:38",
      "text": "இல்லை ஃப்ரீயா இங்கே நீ வாவ்"
    },
    {
      "t": "00:40",
      "text": "ம்"
    },
    {
      "t": "00:42",
      "text": "ஓகே"
    },
    {
      "t": "00:44",
      "text": "ம் சரி சரி"
    },
    {
      "t": "00:46",
      "text": "அப்புறம்"
    },
    {
      "t": "00:48",
      "text": "ம்"
    },
    {
      "t": "00:50",
      "text": "ஜிபேல எப்படி இருக்காங்க"
    },
    {
      "t": "00:52",
      "text": "எல்லோரும் வந்து"
    },
    {
      "t": "00:54",
      "text": "நல்லா இருக்காங்க"
    },
    {
      "t": "00:56",
      "text": "ம் சரிங்க"
    },
    {
      "t": "00:58",
      "text": "ம்"
    },
    {
      "t": "01:00",
      "text": "நீ ஏதோ ஒருத்தருக்கு போலயான்ற"
    },
    {
      "t": "01:02",
      "text": "இல்லை இல்லை ரெண்டு பசங்க இருக்காங்க"
    },
    {
      "t": "01:04",
      "text": "அவங்க பார்த்துக்குறதுக்கு"
    },
    {
      "t": "01:06",
      "text": "வீட்டில் யாரும் கிடையாது"
    },
    {
      "t": "01:08",
      "text": "சரி சரி"
    },
    {
      "t": "01:10",
      "text": "இருக்காங்க ஆனால் பார்த்துக்கறதுக்கெல்லாம்"
    },
    {
      "t": "01:12",
      "text": "நம்ம பசங்களை பார்த்துக்கறதுனால நம்ம தானே"
    },
    {
      "t": "01:14",
      "text": "பெற்றோன் நாம்தானே பார்த்தாகணும்"
    },
    {
      "t": "01:16",
      "text": "ஆமாம் ஆமாம் ஓசூரேவா உள்ள வேறு"
    },
    {
      "t": "01:18",
      "text": "ஒரு முடிவு"
    },
    {
      "t": "01:20",
      "text": "அந்த சொந்த ஊர் வந்து கிருஷ்ணகிரி"
    },
    {
      "t": "01:22",
      "text": "இங்கே ஸ்டேஷன்"
    },
    {
      "t": "01:24",
      "text": "பே பண்ணியிருக்கோம் ரூம் ரூமில்"
    },
    {
      "t": "01:26",
      "text": "ஓகே"
    },
    {
      "t": "01:28",
      "text": "ம் ம் ம் ம் ம் ம்"
    },
    {
      "t": "01:30",
      "text": "சாப்பிட்டாச்சு"
    },
    {
      "t": "01:32",
      "text": "அதனால் அப்படியே ஒரு வாக்கிங்கை போட்டு"
    },
    {
      "t": "01:34",
      "text": "அப்புறம் வந்து ஒரு லீட்டர் ஃபோனும் தூக்கிட்டு வந்துடுச்சு"
    },
    {
      "t": "01:36",
      "text": "சரி சரி"
    },
    {
      "t": "01:38",
      "text": "ம்"
    },
    {
      "t": "01:40",
      "text": "சீட்லேயே இருந்துச்சு"
    },
    {
      "t": "01:42",
      "text": "இருந்தாலும் கொஞ்சம் டிஃப்ரெண்ட்"
    },
    {
      "t": "01:44",
      "text": "டிப்ரெஷன்"
    },
    {
      "t": "01:46",
      "text": "ம் ம்"
    },
    {
      "t": "01:48",
      "text": "சரி ஆப்புக்குள்ளே வரலாமே சரி வாங்க"
    },
    {
      "t": "01:50",
      "text": "அந்த பீஸா கலர்"
    },
    {
      "t": "01:52",
      "text": "ப்ளஸ் வருவாங்க கொஞ்சம் நேரம் பேசிவிட்டு அப்படி போவாங்க"
    },
    {
      "t": "01:54",
      "text": "போவான் அப்படின்ட்டு"
    },
    {
      "t": "01:56",
      "text": "ம் சரி சரி"
    },
    {
      "t": "01:58",
      "text": "அட்ரஸ் இந்தா அப்போ"
    },
    {
      "t": "02:00",
      "text": "இந்த ஆப்பில் எல்லாமே பார்த்தீங்கன்னா"
    },
    {
      "t": "02:02",
      "text": "நான் ஒரு நைன்ட்டி"
    },
    {
      "t": "02:04",
      "text": "டூ பெர்சென்ட் வந்து"
    },
    {
      "t": "02:06",
      "text": "நைன்ட்டி டூன்றது தானே நைன்ட்டி ஃபைவ் வந்து"
    },
    {
      "t": "02:08",
      "text": "ம்"
    },
    {
      "t": "02:10",
      "text": "செக்ஸ்வல் ஹரஸ்மெண்ட்டு தான்"
    },
    {
      "t": "02:12",
      "text": "அது சரி"
    },
    {
      "t": "02:14",
      "text": "ம்"
    },
    {
      "t": "02:16",
      "text": "ம் ஏதோ நம்ம ஃபீலிங்ஸ்"
    },
    {
      "t": "02:18",
      "text": "அதாவது ஓபன் பண்ணும்போது என்ன சொன்னாங்க"
    },
    {
      "t": "02:20",
      "text": "இதில் பார்ட் டைமாக நீங்கள் ஒர்க் பண்ணிக்கலாம்"
    },
    {
      "t": "02:22",
      "text": "நம்ம பீலிங்ஸை ஷேர் பண்ணிக்கலாம்னு சொல்லிட்டு தான்"
    },
    {
      "t": "02:24",
      "text": "ஆ ம்"
    },
    {
      "t": "02:26",
      "text": "கொத்து விட்றாங்க"
    },
    {
      "t": "02:28",
      "text": "கடைசிக்கு வந்து பார்த்தீங்கன்னா அதெல்லாம் எதுவுமே உண்மைதான்"
    },
    {
      "t": "02:30",
      "text": "உண்மை கிடையாது"
    },
    {
      "t": "02:32",
      "text": "எல்லாரும் யூஸ் பண்ணுறதே இதுக்கு தான்"
    },
    {
      "t": "02:34",
      "text": "ம்"
    },
    {
      "t": "02:36",
      "text": "ஏன்னா அதுவும் காலர் வராங்க வந்துட்டு கேட்கறதுக்கு"
    },
    {
      "t": "02:38",
      "text": "எந்த இதுவும் கிடையாது"
    },
    {
      "t": "02:40",
      "text": "ம் அப்படியே வர்றாங்க"
    },
    {
      "t": "02:42",
      "text": "நீங்க இதை பண்ணுவீங்களா"
    },
    {
      "t": "02:44",
      "text": "காதல் பண்ணுவீங்களான்னு கேட்பாங்க"
    },
    {
      "t": "02:46",
      "text": "அந்த மாதிரி அப்படிங்கும்போது"
    },
    {
      "t": "02:48",
      "text": "அப்போதே உள்ளே கூட சொல்ல விடமாட்டேன்"
    },
    {
      "t": "02:50",
      "text": "போட்டாங்க காலை கட் பண்ணிட்டு போயிடுவாங்க"
    },
    {
      "t": "02:52",
      "text": "எனக்கும் காய் முடிய போகுது"
    },
    {
      "t": "02:54",
      "text": "ஆ"
    },
    {
      "t": "02:56",
      "text": "ம்"
    }
