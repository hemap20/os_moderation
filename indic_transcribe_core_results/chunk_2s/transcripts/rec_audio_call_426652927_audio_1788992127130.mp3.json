{
  "file_id": "rec_audio_call_426652927_audio_1788992127130.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 197.218,
  "processing_time_sec": 67.9660747051239,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "ആ"
    },
    {
      "t": "00:04",
      "text": "ആ"
    },
    {
      "t": "00:06",
      "text": "ഹലോ ഹലോ"
    },
    {
      "t": "00:08",
      "text": "പേരെന്താ"
    },
    {
      "t": "00:10",
      "text": "ആ"
    },
    {
      "t": "00:12",
      "text": "കേക്ക് നല്ലത് ഹലോ"
    },
    {
      "t": "00:14",
      "text": "പേരെന്താ"
    },
    {
      "t": "00:16",
      "text": "അപർണ പേരെന്താ"
    },
    {
      "t": "00:18",
      "text": "എൻ്റെ പേര് ജേക്കബ് സ്ഥലം"
    },
    {
      "t": "00:20",
      "text": "കേക്ക് അപ്പ് ഏതിന്"
    },
    {
      "t": "00:22",
      "text": "ഏ കേൾക്കുന്നില്ല"
    },
    {
      "t": "00:24",
      "text": "കേൾക്കാമോ"
    },
    {
      "t": "00:26",
      "text": "ഞാൻ റിക്വസ്റ്റ് ഇട്ടിട്ടുണ്ട് വാട്സാപ്പിൽ"
    },
    {
      "t": "00:28",
      "text": "അത്"
    },
    {
      "t": "00:30",
      "text": "പക്ഷേ എൻ്റെ കോയിൻസ് കുറവാണ് അതുകൊണ്ടാണ്"
    },
    {
      "t": "00:32",
      "text": "തനിക്ക് നമ്പറ് തരാൻ പറ്റുമോ"
    },
    {
      "t": "00:34",
      "text": "ആ"
    },
    {
      "t": "00:36",
      "text": "സൗണ്ടൊക്കെ കഴിഞ്ഞു പോകുന്നതാണേ സത്യമുള്ളൂ"
    },
    {
      "t": "00:38",
      "text": "മൂന്ന് നാട്ടുകാർ"
    },
    {
      "t": "00:40",
      "text": "പിന്നെ വാട്സാപ്പ് നമ്പറ്"
    },
    {
      "t": "00:42",
      "text": "എത്ര പിന്നെ"
    },
    {
      "t": "00:44",
      "text": "മേടിച്ചില്ലെങ്കിൽ വരും"
    },
    {
      "t": "00:46",
      "text": "ഏ"
    },
    {
      "t": "00:48",
      "text": "എത്ര"
    },
    {
      "t": "00:50",
      "text": "ആ"
    },
    {
      "t": "00:52",
      "text": "എത്രയാണ്"
    },
    {
      "t": "00:54",
      "text": "ഓക്കെയാണോ"
    },
    {
      "t": "00:56",
      "text": "ത്രീ ഹൺഡ്രഡ് ആ"
    },
    {
      "t": "00:58",
      "text": "താങ്കളുടെ നമ്പറോ"
    },
    {
      "t": "01:00",
      "text": "മ്മ്"
    },
    {
      "t": "01:02",
      "text": "എന്തെയ്യോ ചേട്ടൻ"
    },
    {
      "t": "01:04",
      "text": "ഞാനിപ്പം സൗദിയിലാണ്"
    },
    {
      "t": "01:06",
      "text": "വർക്ക് ചെയ്യുക നാട്ടിലെവിടെ"
    },
    {
      "t": "01:08",
      "text": "മാറ്റി പത്തനംതിട്ട"
    },
    {
      "t": "01:10",
      "text": "താനോ ഞാൻ ഇറങ്ങാം"
    },
    {
      "t": "01:12",
      "text": "എറണാകുളം എന്ത് ചെയ്യുന്നു എന്ത്"
    },
    {
      "t": "01:14",
      "text": "ഞാൻ ലോജിസ്റ്റിക്സ്"
    },
    {
      "t": "01:16",
      "text": "നമ്പര് പറയാം"
    },
    {
      "t": "01:18",
      "text": "പറയാവോ ഞാൻ വാട്സാപ്പിൽ മെസ്സേജ് ചെയ്യാം"
    },
    {
      "t": "01:20",
      "text": "ഞാൻ"
    },
    {
      "t": "01:22",
      "text": "എൻ്റെ എൻ്റെ സ്വാധീനം പ്രകാരം"
    },
    {
      "t": "01:24",
      "text": "കാണാറിയതിൽ താൻ പറയുകയാണെങ്കിൽ ഞാൻ അമ്പലം"
    },
    {
      "t": "01:26",
      "text": "ആ ഓക്കെ"
    },
    {
      "t": "01:28",
      "text": "പറഞ്ഞുതരാം നോട്ട് ചെയ്തോ"
    },
    {
      "t": "01:30",
      "text": "ഒരു ഒരു മിനിറ്റ്"
    },
    {
      "t": "01:32",
      "text": "ആ"
    },
    {
      "t": "01:34",
      "text": "ആ"
    },
    {
      "t": "01:36",
      "text": "പറയട്ടെ ഒരു മിനിറ്റ്"
    },
    {
      "t": "01:38",
      "text": "യെസ്"
    },
    {
      "t": "01:40",
      "text": "ആ പറ"
    },
    {
      "t": "01:42",
      "text": "സെവൻ നയൻ"
    },
    {
      "t": "01:44",
      "text": "സെവൻ എയ്റ്റ് സീറോ സെവൻ"
    },
    {
      "t": "01:46",
      "text": "സെറോസ്"
    },
    {
      "t": "01:48",
      "text": "സെവൻ നയൻ സീറോ സെവൻ"
    },
    {
      "t": "01:50",
      "text": "ടു നയൻ"
    },
    {
      "t": "01:52",
      "text": "ടു നയൻ"
    },
    {
      "t": "01:54",
      "text": "ഫൈവ് വൺ"
    },
    {
      "t": "01:56",
      "text": "ഫൈവ് വൺ ത്രീ സിക്സ്"
    },
    {
      "t": "01:58",
      "text": "ഫൈവ് ത്രീ ഫൈവ്"
    },
    {
      "t": "02:00",
      "text": "വാട്സപ്പ് വാട്സപ്പ്"
    },
    {
      "t": "02:02",
      "text": "ഉള്ളൂ കേട്ടോ വാട്സാപ്പിൽ മെസ്സേജ് അയക്കണേ"
    },
    {
      "t": "02:04",
      "text": "ഓക്കേ"
    },
    {
      "t": "02:06",
      "text": "മെസ്സേജ്"
    },
    {
      "t": "02:08",
      "text": "നമുക്ക് തന്നു വന്ന്"
    },
    {
      "t": "02:10",
      "text": "നോക്കട്ടെ"
    },
    {
      "t": "02:12",
      "text": "ആ"
    },
    {
      "t": "02:14",
      "text": "ആ വന്നു വന്നു ഓക്കെ ഓക്കെ"
    },
    {
      "t": "02:16",
      "text": "താൻ ആദ്യം ഇതിലൊന്ന് കുറച്ച് നേരം സംസാരിക്കാൻ തുടങ്ങി"
    },
    {
      "t": "02:18",
      "text": "സംസാരിക്കൂ"
    },
    {
      "t": "02:20",
      "text": "അങ്ങനെ അത് ശരി"
    },
    {
      "t": "02:22",
      "text": "ഓർമ്മയില്ല"
    },
    {
      "t": "02:24",
      "text": "ആ ശരി"
    },
    {
      "t": "02:26",
      "text": "ഓക്കെ ശരി സാർ"
    },
    {
      "t": "02:28",
      "text": "അഭിപ്രായം"
    },
    {
      "t": "02:30",
      "text": "എൻ്റെ നാട്ടിൽ"
    },
    {
      "t": "02:32",
      "text": "ബാങ്കിൽ ചെറിയൊരു ഇഷ്യൂ ആയിരുന്നു ട്രാൻസ്ഫർ ആവശ്യം"
    },
    {
      "t": "02:34",
      "text": "ബുദ്ധിമുട്ടാത്തതുകൊണ്ടാണ് ഞാൻ ചോദിച്ചത്"
    },
    {
      "t": "02:36",
      "text": "പിന്നെ"
    },
    {
      "t": "02:38",
      "text": "എന്തിനെൻ്റെ നമ്പർ ചോദിച്ചപ്പോൾ"
    },
    {
      "t": "02:40",
      "text": "അതിപ്പോൾ എപ്പോഴാണല്ലോ എനിക്ക് വിളിക്കാനുള്ളത്"
    },
    {
      "t": "02:42",
      "text": "നാളെ തന്നെ"
    },
    {
      "t": "02:44",
      "text": "ശരിയാവും അക്കൗണ്ട് ഞാനത് റിക്വസ്റ്റ് കൊടുക്കും"
    },
    {
      "t": "02:46",
      "text": "എടുത്തിട്ടുണ്ട്"
    },
    {
      "t": "02:48",
      "text": "എന്നാ വേണ്ടത് അങ്ങനെയാണെന്നുണ്ടെങ്കിൽ പറയണ്ടേ ഞാൻ"
    },
    {
      "t": "02:50",
      "text": "ഞാൻ അങ്ങനെ നമ്പർ ആർക്കും കൊടുക്കാറ് പോലുമില്ല"
    },
    {
      "t": "02:52",
      "text": "ചേട്ടാ നാളെയാണെങ്കിൽ"
    },
    {
      "t": "02:54",
      "text": "ഞാൻ വിളിച്ചാൽ മതിയല്ലോ"
    },
    {
      "t": "02:56",
      "text": "തനിക്ക് പൈസ അല്ലാതെ ഞാൻ തരും"
    },
    {
      "t": "02:58",
      "text": "പറ്റിക്കില്ല അത് ഉറപ്പാണ്"
    },
    {
      "t": "03:00",
      "text": "ഇപ്പം പഠിച്ചത്"
    },
    {
      "t": "03:02",
      "text": "ഇതിലൊന്ന് സംസാരിക്കുമോ"
    },
    {
      "t": "03:04",
      "text": "തുള്ളൽ സംസാരിക്കുന്നത്"
    },
    {
      "t": "03:06",
      "text": "അത് കുഴപ്പമൊന്നുമില്ല പക്ഷേ"
    },
    {
      "t": "03:08",
      "text": "നാളെ പേയ്മെന്റ്"
    },
    {
      "t": "03:10",
      "text": "അയ്യോ എന്ന് ഞാൻ എന്തുറപ്പ്"
    },
    {
      "t": "03:12",
      "text": "നമ്പറും തന്നിട്ട്"
    },
    {
      "t": "03:14",
      "text": "തന്നെ ചതിക്കില്ല അതുപോലെ"
    },
    {
      "t": "03:16",
      "text": "ആ"
