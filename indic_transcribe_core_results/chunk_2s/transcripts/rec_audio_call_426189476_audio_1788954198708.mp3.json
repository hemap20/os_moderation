{
  "file_id": "rec_audio_call_426189476_audio_1788954198708.mp3",
  "language": "malayalam",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 467.7496875,
  "processing_time_sec": 1730.246707201004,
  "segments": [
    {
      "t": "00:00",
      "text": "ആ"
    },
    {
      "t": "00:02",
      "text": "ഇതൊക്കെ"
    },
    {
      "t": "00:04",
      "text": "ഹലോ"
    },
    {
      "t": "00:06",
      "text": "പിന്നെ"
    },
    {
      "t": "00:08",
      "text": "ആ"
    },
    {
      "t": "00:10",
      "text": "ഹലോ"
    },
    {
      "t": "00:12",
      "text": "ആ എവിടെ നിന്നാണ്"
    },
    {
      "t": "00:14",
      "text": "വിളിക്കുന്നത്"
    },
    {
      "t": "00:16",
      "text": "ഇടക്ക്"
    },
    {
      "t": "00:18",
      "text": "എനിക്ക് ഓക്കെ എന്താ പേര്"
    },
    {
      "t": "00:20",
      "text": "ഇത് സൂസൻ"
    },
    {
      "t": "00:22",
      "text": "ഓക്കേ"
    },
    {
      "t": "00:24",
      "text": "പ്രശ്നം എന്തായിരുന്നു"
    },
    {
      "t": "00:26",
      "text": "ഹൗസ് വൈഫാ"
    },
    {
      "t": "00:28",
      "text": "ആ"
    },
    {
      "t": "00:30",
      "text": "ഓക്കേ അപ്പം വീട്ടിൽ ആരെങ്കിലും ഉണ്ടോ"
    },
    {
      "t": "00:32",
      "text": "അപ്പം"
    },
    {
      "t": "00:34",
      "text": "ഒരു കുഞ്ഞും"
    },
    {
      "t": "00:36",
      "text": "അമ്മായിപ്പനും അമ്മായിമ്മയും ഹസ്ബൻഡും"
    },
    {
      "t": "00:38",
      "text": "ആലോചിച്ചോട്ടെ"
    },
    {
      "t": "00:40",
      "text": "സന്നദ്ധയെ വാ"
    },
    {
      "t": "00:42",
      "text": "ഇത്"
    },
    {
      "t": "00:44",
      "text": "ഹസ്ബൻഡ് നാട്ടിലുണ്ടോ എന്താ ചെയ്യുന്നത്"
    },
    {
      "t": "00:46",
      "text": "തൊഴിലുറപ്പ്"
    },
    {
      "t": "00:48",
      "text": "ആണേ പോണോ"
    },
    {
      "t": "00:50",
      "text": "ശരി"
    },
    {
      "t": "00:52",
      "text": "എന്നിട്ടോ വരുന്നതിന്റെ വിശേഷങ്ങളൊക്കെ"
    },
    {
      "t": "00:54",
      "text": "കിടക്കീല്"
    },
    {
      "t": "00:56",
      "text": "ഒരു വിശേഷം ലുസുക്ക്"
    },
    {
      "t": "00:58",
      "text": "ആയിട്ടിരിക്കുന്നു"
    },
    {
      "t": "01:00",
      "text": "ആ"
    },
    {
      "t": "01:02",
      "text": "ആണല്ലേ"
    },
    {
      "t": "01:04",
      "text": "ഞാൻ ഇപ്പോൾ ഡൗൺലോഡ് ചെയ്ത ഫസ്റ്റ് കോളാണ്"
    },
    {
      "t": "01:06",
      "text": "ആ ഫസ്റ്റ് കോളാണ്"
    },
    {
      "t": "01:08",
      "text": "നല്ല എല്ലാ"
    },
    {
      "t": "01:10",
      "text": "എല്ലാവിധ ഭാവങ്ങളും നേരും"
    },
    {
      "t": "01:12",
      "text": "ആ എന്താ"
    },
    {
      "t": "01:14",
      "text": "അല്ല നോക്കിയോ"
    },
    {
      "t": "01:16",
      "text": "ആ"
    },
    {
      "t": "01:18",
      "text": "ട്രോഫി എല്ലാം കിട്ടിയാൽ ഭാഗ്യം"
    },
    {
      "t": "01:20",
      "text": "ഒക്കെ നിർത്തും കേട്ടോ"
    },
    {
      "t": "01:22",
      "text": "ആ ഡ്രോസ് അതൊക്കെ നിങ്ങളുടെ കഴിവ് പോലെ"
    },
    {
      "t": "01:24",
      "text": "ആ"
    },
    {
      "t": "01:26",
      "text": "ആ"
    },
    {
      "t": "01:28",
      "text": "ആ"
    },
    {
      "t": "01:30",
      "text": "ആ"
    },
    {
      "t": "01:32",
      "text": "അതെ"
    },
    {
      "t": "01:34",
      "text": "എന്ത്"
    },
    {
      "t": "01:36",
      "text": "ഇപ്പം എന്താണ് പരസ്യം കണ്ടു കയറിയതാണോ"
    },
    {
      "t": "01:38",
      "text": "ആ"
    },
    {
      "t": "01:40",
      "text": "എന്താണെന്ന് അറിയുമോ കുറേ നാളായി ഞങ്ങൾക്ക്"
    },
    {
      "t": "01:42",
      "text": "കാണുന്നു"
    },
    {
      "t": "01:44",
      "text": "അപ്പോൾ"
    },
    {
      "t": "01:46",
      "text": "കുറച്ച് കൂടെ മാറും അപ്പോൾ പിന്നെ എങ്ങനെയുണ്ട്"
    },
    {
      "t": "01:48",
      "text": "ചോദിച്ചിട്ട് കാര്യമില്ല"
    },
    {
      "t": "01:50",
      "text": "ഓ ആ"
    },
    {
      "t": "01:52",
      "text": "ഇതാണ്"
    },
    {
      "t": "01:54",
      "text": "ആണല്ലേ"
    },
    {
      "t": "01:56",
      "text": "ഞാനൊരു രണ്ട്"
    },
    {
      "t": "01:58",
      "text": "ആ ഒരു മാസമായി"
    },
    {
      "t": "02:00",
      "text": "എന്നിട്ട് കൊള്ളാം"
    },
    {
      "t": "02:02",
      "text": "കൃപയാ"
    },
    {
      "t": "02:04",
      "text": "ആ"
    },
    {
      "t": "02:06",
      "text": "ആ"
    },
    {
      "t": "02:08",
      "text": "നാടോടാണെന്ന് തോന്നുന്നില്ല"
    },
    {
      "t": "02:10",
      "text": "ഞാൻ കണ്ണൂരാണ് പറഞ്ഞിരുന്നത്"
    },
    {
      "t": "02:12",
      "text": "കേട്ടില്ലേ അത് കേട്ടില്ല"
    },
    {
      "t": "02:14",
      "text": "ആ കണ്ണൂര്"
    },
    {
      "t": "02:16",
      "text": "കണ്ണൂർ ആ"
    },
    {
      "t": "02:18",
      "text": "ഓക്കേ"
    },
    {
      "t": "02:20",
      "text": "എന്തുദ്ദേശിച്ചിട്ടുണ്ട് ഈ ആപ്പ് കയറി"
    },
    {
      "t": "02:22",
      "text": "ഇത് ചുമ്മാ സംസാരിക്കാനാണോ അല്ലെങ്കിൽ ഏണിങ്"
    },
    {
      "t": "02:24",
      "text": "എന്താണ്"
    },
    {
      "t": "02:26",
      "text": "അങ്ങനെ ഒന്നും ഉദ്ദേശിക്കുന്നില്ല ഇതിങ്ങനെ പരസ്പരം"
    },
    {
      "t": "02:28",
      "text": "അച്ഛൻ കണ്ടപ്പോൾ വന്ന് ജോയിൻ ചെയ്തു നോക്കിയേക്കാം"
    },
    {
      "t": "02:30",
      "text": "ജെൽസി"
    },
    {
      "t": "02:32",
      "text": "ആയിട്ട്"
    },
    {
      "t": "02:34",
      "text": "ഓക്കെ"
    },
    {
      "t": "02:36",
      "text": "വീട്ടിലോ മക്ക"
    },
    {
      "t": "02:38",
      "text": "ആ പുതിയ മുന്നോട്ടെന്നല്ല പറഞ്ഞത് പുതിയ എത്ര വയസ്സ്"
    },
    {
      "t": "02:40",
      "text": "രണ്ട് വയസ്സോ"
    },
    {
      "t": "02:42",
      "text": "ഓക്കെ"
    },
    {
      "t": "02:44",
      "text": "ഓക്കെ"
    },
    {
      "t": "02:46",
      "text": "കുഴപ്പമുണ്ടോ"
    },
    {
      "t": "02:48",
      "text": "ആ"
    },
    {
      "t": "02:50",
      "text": "ഏ"
    },
    {
      "t": "02:52",
      "text": "കുഴപ്പമുണ്ടോന്നോ"
    },
    {
      "t": "02:54",
      "text": "എന്താ"
    },
    {
      "t": "02:56",
      "text": "കുഴപ്പമുണ്ടാവുന്ന രണ്ടു വയസ്സുള്ള കുട്ടിയാണ്"
    },
    {
      "t": "02:58",
      "text": "തന്റെ കുഞ്ഞിന് രണ്ടു വർഷം ആയതിന് മുമ്പ് ഞാൻ"
    },
    {
      "t": "03:00",
      "text": "ഞാനെന്ത് കുഴപ്പം പറയാനാണ്"
    },
    {
      "t": "03:02",
      "text": "അതെന്താ പറഞ്ഞത്"
    },
    {
      "t": "03:04",
      "text": "പ്രൈസ് ഉള്ളതിപ്പോൾ ഞാൻ എന്താ ചെയ്യുക"
    },
    {
      "t": "03:06",
      "text": "രണ്ടു വയസ്സുള്ള ഏഴ്"
    },
    {
      "t": "03:08",
      "text": "വേണമെങ്കിൽ എത്ര കാലമായി"
    },
    {
      "t": "03:10",
      "text": "കല്യാണം കഴിഞ്ഞിട്ട് നാല് ദിവസം"
    },
    {
      "t": "03:12",
      "text": "ഓക്കെ"
    },
    {
      "t": "03:14",
      "text": "ആ അപ്പം കുഴപ്പമുണ്ട്"
    },
    {
      "t": "03:16",
      "text": "രണ്ടു ദിവസം ഗ്യാപ്പ് വേണമല്ലോ"
    },
    {
      "t": "03:18",
      "text": "ആ"
    },
    {
      "t": "03:20",
      "text": "അല്ല കുഴപ്പമുണ്ട്"
    },
    {
      "t": "03:22",
      "text": "ഫുഡ് കഴിച്ചാൽ പിന്നെ എന്തെങ്കിലും കുഴപ്പം പറയണ്ടേ"
    },
    {
      "t": "03:24",
      "text": "അതോർത്ത് പറഞ്ഞാലേ"
    },
    {
      "t": "03:26",
      "text": "കല്യാണം കഴിഞ്ഞാൽ"
    },
    {
      "t": "03:28",
      "text": "എന്തായാലും പറഞ്ഞില്ലേ പിന്നെ ഇങ്ങ് പോയിട്ട്"
    },
    {
      "t": "03:30",
      "text": "എന്റെ കല്യാണം"
    },
    {
      "t": "03:32",
      "text": "കഴിഞ്ഞതാണ്"
    },
    {
      "t": "03:34",
      "text": "പൊട്ടിയോളാം"
    },
    {
      "t": "03:36",
      "text": "കുട്ടികളൊന്നും"
    },
    {
      "t": "03:38",
      "text": "ആ"
    },
    {
      "t": "03:40",
      "text": "ആ"
    },
    {
      "t": "03:42",
      "text": "ഒരു വയസ്സ്"
    },
    {
      "t": "03:44",
      "text": "ഓക്കെ"
    },
    {
      "t": "03:46",
      "text": "ആ"
    },
    {
      "t": "03:48",
      "text": "ആ"
    },
    {
      "t": "03:50",
      "text": "അപ്പോൾ ഒരു കുഴപ്പവും ഇല്ല"
    },
    {
      "t": "03:52",
      "text": "എനിക്ക് ഒരു കുഴപ്പവുമില്ല"
    },
    {
      "t": "03:54",
      "text": "ടു"
    },
    {
      "t": "03:56",
      "text": "ഞവലിന്നോ"
    },
    {
      "t": "03:58",
      "text": "പിന്നെ ജോലി ഇല്ലാണ്ട്"
    },
    {
      "t": "04:00",
      "text": "പിന്നെ ഭാര്യയും മക്കളും എല്ലാം ഇന്ന് നടക്കട്ടെ"
    },
    {
      "t": "04:02",
      "text": "ആ"
    },
    {
      "t": "04:04",
      "text": "ഞാൻ ഗ്രാഫിക് ഡിസ്കസ് ചെയ്തു"
    },
    {
      "t": "04:06",
      "text": "മാഡം ഏ"
    },
    {
      "t": "04:08",
      "text": "ഗ്രാഫിക് ഡിസൈനർ ആണ് ഗ്രാഫിക് ഡിസൈനർ"
    },
    {
      "t": "04:10",
      "text": "വൗ"
    },
    {
      "t": "04:12",
      "text": "പടമൊക്കെ ഡിസ്പ്ലേ ചെയ്യാൻ അറിയാമോ"
    },
    {
      "t": "04:14",
      "text": "പിന്നെയുള്ള"
    },
    {
      "t": "04:16",
      "text": "ആ"
    },
    {
      "t": "04:18",
      "text": "നമ്മള് ഞാനൊരു"
    },
    {
      "t": "04:20",
      "text": "എന്താണ് ശ്രീലങ്കയുമായിട്ടും വർക്ക് ചെയ്യാൻ"
    },
    {
      "t": "04:22",
      "text": "അതുകൊണ്ട് ഞാൻ വേറെ ഒരു കമ്പനിയിൽ വർക്ക് ചെയ്യുന്നുണ്ട്"
    },
    {
      "t": "04:24",
      "text": "ആ"
    },
    {
      "t": "04:26",
      "text": "ഫ്രീലാൻസർ ഡോക്ടർ"
    },
    {
      "t": "04:28",
      "text": "എന്ത് എന്ത്"
    },
    {
      "t": "04:30",
      "text": "എന്ത് ഗ്രാഫിക്കാണ് ഡിസൈൻ ചെയ്യുന്നത്"
    },
    {
      "t": "04:32",
      "text": "ഗ്രാഫിറ്റി ഷെയറിങ് എന്ന് പറഞ്ഞാൽ ആഡ്സ് എല്ലാം ചെയ്തു"
    },
    {
      "t": "04:34",
      "text": "കൊടുക്കലുണ്ട്"
    },
    {
      "t": "04:36",
      "text": "ആഫ്സോ"
    },
    {
      "t": "04:38",
      "text": "ഡിജിറ്റൽ മാർക്കറ്റ് ഡിജിറ്റൽ മാർക്കറ്റിംഗ് അല്ലേ"
    },
    {
      "t": "04:40",
      "text": "ആ"
    },
    {
      "t": "04:42",
      "text": "അതിനുവേണ്ടിയുള്ള ആഡ്സ് വീഡിയോസ്"
    },
    {
      "t": "04:44",
      "text": "അങ്ങനെയൊക്കെ ചെയ്തു കൊടുക്കാറുണ്ട്"
    },
    {
      "t": "04:46",
      "text": "ആ അങ്ങനെയൊന്നും ആവില്ല"
    },
    {
      "t": "04:48",
      "text": "അറിയില്ല ആകെ അറിയാവുന്നത്"
    },
    {
      "t": "04:50",
      "text": "ആ"
    },
    {
      "t": "04:52",
      "text": "വേറെ പണികളെ ഉള്ളു അറിയത്തില്ല"
    },
    {
      "t": "04:54",
      "text": "ആകെ അറിയാനുണ്ട്"
    },
    {
      "t": "04:56",
