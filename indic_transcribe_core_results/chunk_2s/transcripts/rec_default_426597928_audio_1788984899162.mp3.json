    {
      "t": "05:20",
      "text": "ஏமாந்துலாம் போகமாட்டேன்"
    },
    {
      "t": "05:22",
      "text": "ஆனால் எல்லாருமே ஏமாந்து"
    },
    {
      "t": "05:24",
      "text": "சாப்பிட்டாங்களே இப்போ மை பாடி"
