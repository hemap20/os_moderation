{
  "file_id": "rec_default_426597928_audio_1788984899162.mp3",
  "language": "tamil",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 450.303,
  "processing_time_sec": 37.95787477493286,
  "segments": [
    {
      "t": "00:00",
      "text": "ஆ"
    },
    {
      "t": "00:02",
      "text": "ஐ"
    },
    {
      "t": "00:04",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:06",
      "text": "ஏய் என்ன ஒரு"
    },
    {
      "t": "00:08",
      "text": "சேலம்"
    },
    {
      "t": "00:10",
      "text": "ஃப்ரம் நோ நாமக்கல்"
    },
    {
      "t": "00:12",
      "text": "நாமக்கல் யோ"
    },
    {
      "t": "00:14",
      "text": "பக்கத்து டிஸ்ட்ரிக்"
    },
    {
      "t": "00:16",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:18",
      "text": "சேலத்தில்ங்க"
    },
    {
      "t": "00:20",
      "text": "நாமக்கல் ரோடு தான் ஸ்ரீநகர் பக்கம்"
    },
    {
      "t": "00:22",
      "text": "டிவைவாஸ்"
    },
    {
      "t": "00:24",
      "text": "சரிங்க சார்"
    },
    {
      "t": "00:26",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "00:28",
      "text": "ம்"
    },
    {
      "t": "00:30",
      "text": "டேட்டா மீட் பண்ணலாமா"
    },
    {
      "t": "00:32",
      "text": "ட்ரை டு சம்டைம்ஸ்"
    },
    {
      "t": "00:34",
      "text": "சம்டைம்ஸ் இது மாதிரி"
    },
    {
      "t": "00:36",
      "text": "யா யா டிவோர்ஸ்"
    },
    {
      "t": "00:38",
      "text": "டிவோர்ஸா"
    },
    {
      "t": "00:40",
      "text": "ஆ"
    },
    {
      "t": "00:42",
      "text": "குழந்தைங்க யா ஐ ஹேவ்"
    },
    {
      "t": "00:44",
      "text": "ஹேவ் எ ஒன் கேர்ள் பேபி நீங்கள்"
    },
    {
      "t": "00:46",
      "text": "வாக்கிங் ஆர் ஸ்டடிங் வாட் ஆர் யூ டூயிங்"
    },
    {
      "t": "00:48",
      "text": "ஒர்க்கிங் தமிழே பேசுங்க"
    },
    {
      "t": "00:50",
      "text": "ம்"
    },
    {
      "t": "00:52",
      "text": "ம்"
    },
    {
      "t": "00:54",
      "text": "ஓகே என்ன ஒர்க் பண்ணுறீங்க"
    },
    {
      "t": "00:56",
      "text": "ஹெச்ஆர் அச்சா"
    },
    {
      "t": "00:58",
      "text": "ஹியூமன் ரிசோர்ஸ்"
    },
    {
      "t": "01:00",
      "text": "நீங்கள்"
    },
    {
      "t": "01:02",
      "text": "ஒர்க்கிங் இன் ஐடி"
    },
    {
      "t": "01:04",
      "text": "ஐடியா எஸ்"
    },
    {
      "t": "01:06",
      "text": "பட் நவ் ஐம் நாட் ஒர்க்கிங்"
    },
    {
      "t": "01:08",
      "text": "ஸ்லே ஆஃப்"
    },
    {
      "t": "01:10",
      "text": "இப்போ நம்ம"
    },
    {
      "t": "01:12",
      "text": "சும்மா தான் இருக்கேன்"
    },
    {
      "t": "01:14",
      "text": "ஆ"
    },
    {
      "t": "01:16",
      "text": "ஜாப் சார்"
    },
    {
      "t": "01:18",
      "text": "சர்ச்சிங் ஜாப் சர்ச்சிங்கா"
    },
    {
      "t": "01:20",
      "text": "எஸ்"
    },
    {
      "t": "01:22",
      "text": "வெயிட்டிங் ஃபார் த என்டயர் கால்"
    },
    {
      "t": "01:24",
      "text": "ஆ"
    },
    {
      "t": "01:26",
      "text": "ம் ஒரு கால் பேபி இருக்குது"
    },
    {
      "t": "01:28",
      "text": "ஓகே ஓகே ஆமாங்க நான்"
    },
    {
      "t": "01:30",
      "text": "போட்டாங்க"
    },
    {
      "t": "01:32",
      "text": "பாருங்கள் இப்போ என்ன பண்ணுறது"
    },
    {
      "t": "01:34",
      "text": "ஆமாம் இப்போ"
    },
    {
      "t": "01:36",
      "text": "ஸ்டில் நவ் டு ஸ்லீப்பிங்"
    },
    {
      "t": "01:38",
      "text": "இதில் யார் யார் இருக்கா வீட்டில் யார் யார் இருக்கா"
    },
    {
      "t": "01:40",
      "text": "பரவாயில்ல நீங்கள் பேபி விட்ரோ"
    },
    {
      "t": "01:42",
      "text": "ம் ஏன்"
    },
    {
      "t": "01:44",
      "text": "நீங்கள் வரீங்களா"
    },
    {
      "t": "01:46",
      "text": "அதான் கேட்டேன்"
    },
    {
      "t": "01:48",
      "text": "ஓகே ஐம் வெயிட்டிங்"
    },
    {
      "t": "01:50",
      "text": "ஜவ்வல்லா மொன்"
    },
    {
      "t": "01:52",
      "text": "அடுத்து"
    },
    {
      "t": "01:54",
      "text": "தெரியலையே எனக்கு அப்படியெல்லாம்"
    },
    {
      "t": "01:56",
      "text": "சும்மா சொல்லுங்கள்"
    },
    {
      "t": "01:58",
      "text": "எவ்வளோ குடும்பம்"
    },
    {
      "t": "02:00",
      "text": "அப்படிங்க"
    },
    {
      "t": "02:02",
      "text": "ஐயா இப்போது உண்மையிலேயே"
    },
    {
      "t": "02:04",
      "text": "எவ்வளோ புரியல"
    },
    {
      "t": "02:06",
      "text": "இது ஃபுல் நைட்னே உள்ளே வரும்"
    },
    {
      "t": "02:08",
      "text": "எனக்கு சத்தியமாக"
    },
    {
      "t": "02:10",
      "text": "தெரியல நாம்லாம் பண்ண"
    },
    {
      "t": "02:12",
      "text": "நல்லது இல்லை சும்மா சொல்லாதீங்க"
    },
    {
      "t": "02:14",
      "text": "அட உண்மை என்ன அப்படின்னு கேட்டீங்கன்னா"
    },
    {
      "t": "02:16",
      "text": "உண்மைதாங்க"
    },
    {
      "t": "02:18",
      "text": "இந்த பணம்"
    },
    {
      "t": "02:20",
      "text": "ட்ரிங்க்ஸ் பண்ணிக்கலாம்"
    },
    {
      "t": "02:22",
      "text": "இப்போவே சரக்கு"
    },
    {
      "t": "02:24",
      "text": "கிடச்சிட்டு தான் இருக்கேன் சொல்லுங்கள்"
    },
    {
      "t": "02:26",
      "text": "அப்பா"
    },
    {
      "t": "02:28",
      "text": "அப்புறம் என்ன இது தம்மு"
    },
    {
      "t": "02:30",
      "text": "தம் ட்ரை பண்ணு"
    },
    {
      "t": "02:32",
      "text": "இதில் மேபி கொடுங்க வேணா ட்ரை"
    },
    {
      "t": "02:34",
      "text": "பண்ணுறேன் இந்தாங்க வாங்கிக்கலாம்"
    },
    {
      "t": "02:36",
      "text": "ஓகேங்க"
    },
    {
      "t": "02:38",
      "text": "தெரியலையே"
    },
    {
      "t": "02:40",
      "text": "ஓகே"
    },
    {
      "t": "02:42",
      "text": "சரிங்க சார்"
    },
    {
      "t": "02:44",
      "text": "ஓகே"
    },
    {
      "t": "02:46",
      "text": "ஓகே"
    },
    {
      "t": "02:48",
      "text": "டம்மு ட்ரை பண்ணுது"
    },
    {
      "t": "02:50",
      "text": "நாட் லைக் தட்ஸ் மோர்"
    },
    {
      "t": "02:52",
      "text": "புக்ஸ்மெல்"
    },
    {
      "t": "02:54",
      "text": "ட்ரிங்க்ஸ் நீ"
    },
    {
      "t": "02:56",
      "text": "மீன்ஸ் ஐ திங்க்"
    },
    {
      "t": "02:58",
      "text": "வைன்"
    },
    {
      "t": "03:00",
      "text": "நீ வெறும் ஒயின் தானா"
    },
    {
      "t": "03:02",
      "text": "ஆ அதுக்கே பாடி தாங்க"
    },
    {
      "t": "03:04",
      "text": "ப்ளபாஸ் ஆஃப் ஒயின் குடிச்சி"
    },
    {
      "t": "03:06",
      "text": "ஸ்டெம் ஃபுல்லாக வேறேன்னு வருது"
    },
    {
      "t": "03:08",
      "text": "ஓகே ஓகே"
    },
    {
      "t": "03:10",
      "text": "இட்ஸ் எ செகண்ட் டைம்"
    },
    {
      "t": "03:12",
      "text": "எத்தனை பாய் ஃப்ரெண்ட் இருக்காங்க"
    },
    {
      "t": "03:14",
      "text": "நோ"
    },
    {
      "t": "03:16",
      "text": "டோன்ட் ஹேவ் மோர் ஃப்ரெண்ட்ஸ்"
    },
    {
      "t": "03:18",
      "text": "தமிழே பேசுங்கண்ணே நீ எங்கே"
    },
    {
      "t": "03:20",
      "text": "நான் ரிமோட்டில் தாங்க ஒர்க்"
    },
    {
      "t": "03:22",
      "text": "பண்ணுறேன் எனக்கு பாய் ஃப்ரெண்ட்ஸ் எல்லாம் கிடையாது"
    },
    {
      "t": "03:24",
      "text": "இந்தியாவுக்கு வந்து சவுதி அண்ட்"
    },
    {
      "t": "03:26",
      "text": "சிங்கப்பூர் அந்த மாதிரி தான்"
    },
    {
      "t": "03:28",
      "text": "எனக்கு லோக்கலில் யாரையுமே தெரியாது"
    },
    {
      "t": "03:30",
      "text": "ஓகே ஓகே சார்"
    },
    {
      "t": "03:32",
      "text": "அதெல்லாம் இது பண்ணலாமா மீட் பண்ணலாமா"
    },
    {
      "t": "03:34",
      "text": "சேலம் வந்தால் மீட் பண்ணால் என்ன தப்பு"
    },
    {
      "t": "03:36",
      "text": "என்ன வேணும்"
    },
    {
      "t": "03:38",
      "text": "நீங்கள் தான் வேணும்"
    },
    {
      "t": "03:40",
      "text": "ம்"
    },
    {
      "t": "03:42",
      "text": "ம்"
    },
    {
      "t": "03:44",
      "text": "ம்"
    },
    {
      "t": "03:46",
      "text": "தாராளமாக"
    },
    {
      "t": "03:48",
      "text": "என்ன பண்ணுவீங்க சொல்லுங்கள்"
    },
    {
      "t": "03:50",
      "text": "என்ன பண்ணணும்"
    },
    {
      "t": "03:52",
      "text": "இது வாட்ஸ்அப் நம்பர் கொடுக்குறீங்களா"
    },
    {
      "t": "03:54",
      "text": "சரிங்களா வாட்ஸ்அப் நம்பர் கொடுத்துருங்க"
    },
    {
      "t": "03:56",
      "text": "வாட்ஸ்அப்"
    },
    {
      "t": "03:58",
      "text": "ம் ஆக்சுவலி இதை வாட்ஸ்அப்"
    },
    {
      "t": "04:00",
      "text": "சூப்பர் எல்லாருமே என் மாதிரி ஃபேக் ஆகிடுவாங்க"
    },
    {
      "t": "04:02",
      "text": "மாத்துறாங்க யூ கேன் ரெடி"
    },
    {
      "t": "04:04",
      "text": "சரி தமிழில் பேசணும்ல"
    },
    {
      "t": "04:06",
      "text": "நீங்கள் பே பண்ணவும்"
    },
    {
      "t": "04:08",
      "text": "ஓகேன்னா நான் வாட்ஸ்அப் நம்பர்"
    },
    {
      "t": "04:10",
      "text": "கொடுக்க ரெடி ஓகே"
    },
    {
      "t": "04:12",
      "text": "எவ்வளோ பண்ணி"
    },
    {
      "t": "04:14",
      "text": "ம் எனக்கு அப்போல்லாம் கேட்க தெரியாது"
    },
    {
      "t": "04:16",
      "text": "ம்"
    },
    {
      "t": "04:18",
      "text": "ம்"
    },
    {
      "t": "04:20",
      "text": "எனக்கு ஏமாந்துச்சு"
    },
    {
      "t": "04:22",
      "text": "டேங்கு கிரிட் இல்லாமல் இருந்தால் எனக்கு"
    },
    {
      "t": "04:24",
      "text": "ஓகே"
    },
    {
      "t": "04:26",
      "text": "நான் நம்பிக்கை இல்லாமல் கடைசி வரைக்கும் நான் எதுவும்"
    },
    {
      "t": "04:28",
      "text": "இருப்பேன் எனக்குன்னு வந்து"
    },
    {
      "t": "04:30",
      "text": "இதாகல மேரிட் ஆகல ஓகே"
    },
    {
      "t": "04:32",
      "text": "சிங்கிள் தான்"
    },
    {
      "t": "04:34",
      "text": "ஓகே எனக்கு ஆக்சுவலாக"
    },
    {
      "t": "04:36",
      "text": "எனக்கு இந்த மாதிரி ஒரு ரிலேஷன்ஷிப் தான் தேவைப்படுது"
    },
    {
      "t": "04:38",
      "text": "ஓகே"
    },
    {
      "t": "04:40",
      "text": "எனக்கு என்னென்னமோ பாய் ஃப்ரெண்ட்ஸ்"
    },
    {
      "t": "04:42",
      "text": "யாரையும் ட்ரெஸ் பண்ண மாட்டேன் எல்லாம்"
    },
    {
      "t": "04:44",
      "text": "டேக் பீப்புள் எல்லாமே ஏமாத்துகிறாங்க"
    },
    {
      "t": "04:46",
      "text": "இந்த ஆப்பில் முதக்கொண்டு"
    },
    {
      "t": "04:48",
      "text": "எல்லாருமே யாரு நம்மளால ஏமாத்த"
    },
    {
      "t": "04:50",
      "text": "பேசுகிறாங்க பேசிகிட்டு இருக்கும்போதே இப்போது"
    },
    {
      "t": "04:52",
      "text": "அதுக்குன்னு கால் கட் பண்ணிட்டு ஓடிடுறாங்க"
    },
    {
      "t": "04:54",
      "text": "ட்ரெஸ் ரிமூவ் பண்ண சொல்லுவாங்க"
    },
    {
      "t": "04:56",
      "text": "பால் பண்ணால் ஒரே"
    },
    {
      "t": "04:58",
      "text": "சரி நம்பர்"
    },
    {
      "t": "05:00",
      "text": "உங்களுக்கு நம்பிக்கை இருந்தால் நம்பர் கொடுங்க"
    },
    {
      "t": "05:02",
      "text": "ஆமாம் ஆமாம் சார் பண்றேன் சார்"
    },
    {
      "t": "05:04",
      "text": "சேலம் வந்தால் மீன்"
    },
    {
      "t": "05:06",
      "text": "மீட் பண்ணால் என்ன பண்ணுவீங்க சொல்லுங்கள்"
    },
    {
      "t": "05:08",
      "text": "ஆ"
    },
    {
      "t": "05:10",
      "text": "ஆ"
    },
    {
      "t": "05:12",
      "text": "மேட்ரு தான் ஜாலியாக இருக்கலாம்"
