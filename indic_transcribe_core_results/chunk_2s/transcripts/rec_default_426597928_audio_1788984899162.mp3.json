    {
      "t": "07:14",
      "text": "நைன் ஃபைவ் டபுள் ஜீரோ"
    },
    {
      "t": "07:16",
      "text": "நைன் டூ"
    },
    {
      "t": "07:18",
      "text": "ஆ த்ரீ நைன்"
    },
    {
      "t": "07:20",
      "text": "ஆ எயிட் ஒன்"
    },
    {
      "t": "07:22",
      "text": "ஓகே நான் கால் பண்ணிட்டேன்"
    },
    {
      "t": "07:24",
      "text": "டெக்ஸ்ட் மீ"
    },
    {
      "t": "07:26",
      "text": "தென் ஐ வில் ரியாக்ட் யூ"
    },
    {
      "t": "07:28",
      "text": "ஓகே"
    },
    {
      "t": "07:30",
      "text": "ஓகே"
