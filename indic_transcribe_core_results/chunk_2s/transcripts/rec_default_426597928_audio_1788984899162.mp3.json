    },
    {
      "t": "06:10",
      "text": "ஹலோ உங்கள் வீடு"
    },
    {
      "t": "06:12",
      "text": "ம்"
    },
    {
      "t": "06:14",
      "text": "நாட் சேஃப் பிளேஸ்"
    },
    {
      "t": "06:16",
      "text": "சரி நம்ம எங்கேயாச்சும் இது போயிடலாம் வெளியே போயிடலாம்"
    },
    {
      "t": "06:18",
      "text": "ஓகே"
    },
    {
      "t": "06:20",
      "text": "ம் இது சொல்லுங்கள் இந்த நம்பர் சொல்லுங்கள்"
    },
    {
      "t": "06:22",
      "text": "இப்போ வீடியோ கால் பண்ணி பார்க்கலாம்"
    },
    {
      "t": "06:24",
      "text": "உட்காந்து வந்தீங்கன்னா எனக்கு என்னைய அம்மா தம்பி"
    },
    {
      "t": "06:26",
      "text": "ஆமாம் எனக்கு ட்ரஸ்ட்டு தான் எனக்கு ஃபர்ஸ்ட்டு முக்கியம்"
