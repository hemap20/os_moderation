    {
      "t": "06:28",
      "text": "ம்"
    },
    {
      "t": "06:30",
      "text": "ஓகேவா ஓகே"
    },
    {
      "t": "06:32",
      "text": "ஆ"
    },
    {
      "t": "06:34",
      "text": "ஓகே டெல் யுவர் வாட்ஸ்அப் நம்பர் தென் ஐ வில்"
    },
    {
      "t": "06:36",
      "text": "ரேக்டிவ் புரியல"
    },
    {
      "t": "06:38",
      "text": "நீங்கள் உங்கள் வாட்ஸ்அப் நம்பர் சொல்கிறீங்க"
    },
    {
      "t": "06:40",
      "text": "சொல்லுங்கள் நான் ரியாக்ட் பண்ணுறேன்"
    },
    {
      "t": "06:42",
      "text": "இது டேப்லெட்"
    },
    {
      "t": "06:44",
      "text": "ம்"
    },
    {
      "t": "06:46",
      "text": "ஐயோ என்னென்னமோ தப்பி தப்பா போடுறேன்"
    },
    {
      "t": "06:48",
      "text": "இஃப் யூ டோன்ட் மைண்ட்"
    },
    {
      "t": "06:50",
      "text": "நான் சொல்லவா"
    },
    {
      "t": "06:52",
      "text": "ஆ டபுள் ஏ சரி சொல்லுங்கள்"
    },
    {
      "t": "06:54",
      "text": "நைன் ஃபைவ் டபுள் ஜீரோ"
    },
    {
      "t": "06:56",
      "text": "நைன் ஃபைவ் டபுள் ஜீரோ"
    },
    {
      "t": "06:58",
      "text": "நைன் டூ நைன் டூ"
    },
    {
      "t": "07:00",
      "text": "த்ரீ நைன்"
    },
    {
      "t": "07:02",
      "text": "த்ரீ மென்"
    },
    {
      "t": "07:04",
      "text": "எயிட் ஒன்"
    },
    {
      "t": "07:06",
      "text": "பேர்"
    },
    {
      "t": "07:08",
      "text": "என்ன துணுக"
    },
    {
      "t": "07:10",
      "text": "போட்டுக்கோங்க"
    },
    {
      "t": "07:12",
      "text": "எதுன்னு நான் நம்பர் சொல்லுங்கள்"
