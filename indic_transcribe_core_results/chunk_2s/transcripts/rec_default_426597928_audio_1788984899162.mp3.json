    {
      "t": "05:26",
      "text": "கவுண்டிஸ் த்ரீ"
    },
    {
      "t": "05:28",
      "text": "ம்"
    },
    {
      "t": "05:30",
      "text": "ஆ சரி ஓகேவா இது நம்"
    },
    {
      "t": "05:32",
      "text": "கொடுங்க என்ன வாட்ஸ்அப் நம்பர் கொடுங்க"
    },
    {
      "t": "05:34",
      "text": "வாட்ஸ்அப் நம்பர் கொடுத்தா என்ன பண்ண முடியும்"
    },
    {
      "t": "05:36",
      "text": "என்ன பண்ணுவீங்க இப்போ வீடியோ கால் வருவீங்களா"
    },
    {
      "t": "05:38",
      "text": "ம் வரேன்"
    },
    {
      "t": "05:40",
      "text": "சார் இதுவா"
    },
    {
      "t": "05:42",
      "text": "ஓகே"
    },
    {
      "t": "05:44",
      "text": "ம் நம்பர் சொல்லுங்கள்"
    },
    {
      "t": "05:46",
      "text": "பே பண்ணிட்டு வருவீங்களா"
    },
    {
      "t": "05:48",
      "text": "எவ்வளோ அமௌண்ட்டு ஏமாத்த மாட்டீங்க"
    },
    {
      "t": "05:50",
      "text": "நல்லா என்ன எவ்வளோ அமௌண்ட்டு எனக்கு"
    },
    {
      "t": "05:52",
      "text": "எனக்கு ட்ரஸ்ட்டு தான் முக்கியம்"
    },
    {
      "t": "05:54",
      "text": "அதான் அதே தான் நான் சொல்ல எனக்கு"
    },
    {
      "t": "05:56",
      "text": "அமௌண்ட் முக்கியம் எனக்கு டெஸ்ட் தான் முக்கியம்"
    },
    {
      "t": "05:58",
      "text": "எனக்கும் ட்ரஸ்ட்டு தான் முக்கியம்"
    },
    {
      "t": "06:00",
      "text": "எனக்கு வந்து இப்போ நாங்கள் நேரம் வந்தோன்னே எனக்கு"
