{
  "file_id": "rec_audio_call_426864490_audio_1789021845136.mp3",
  "language": "kannada",
  "chunk_seconds": 2.0,
  "audio_duration_sec": 411.7370625,
  "processing_time_sec": 146.04432606697083,
  "segments": [
    {
      "t": "00:00",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:04",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:06",
      "text": "ಹಲೋ ಹಾಂ ಹಲೋ"
    },
    {
      "t": "00:08",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:10",
      "text": "ಹೇಳಿ ಆಯ್ತು"
    },
    {
      "t": "00:12",
      "text": "ಆಯ್ತು"
    },
    {
      "t": "00:14",
      "text": "ಅಲ್ಲಿಂದ ನೀವು"
    },
    {
      "t": "00:16",
      "text": "ಯಾವ ಊರು"
    },
    {
      "t": "00:18",
      "text": "ಬೆಂಗಳೂರು"
    },
    {
      "t": "00:20",
      "text": "ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "00:22",
      "text": "ಮೈಸೂರು"
    },
    {
      "t": "00:24",
      "text": "ಸರ್"
    },
    {
      "t": "00:26",
      "text": "ಇದೇನು ಹೇಗಿದ್ದೀರಾ"
    },
    {
      "t": "00:28",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:30",
      "text": "ಪರಮು ನೀವು ನಿಮ್ಮ ಹೆಸರು"
    },
    {
      "t": "00:32",
      "text": "ಹ್ಞೂ ಅಷ್ಟೇ"
    },
    {
      "t": "00:34",
      "text": "ಏನು ಶಾ"
    },
    {
      "t": "00:36",
      "text": "ಓಕೆ"
    },
    {
      "t": "00:38",
      "text": "ಇಂಗ್ಲೀಷ್"
    },
    {
      "t": "00:40",
      "text": "ಸರ್"
    },
    {
      "t": "00:42",
      "text": "ಸೀತಾ ಸೀತಾ"
    },
    {
      "t": "00:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:46",
      "text": "ಹಾಂ ಚೆನ್ನಾಗಿದ್ರೆ ಸಾಕು"
    },
    {
      "t": "00:48",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:50",
      "text": "ಆದರೆ ಬುಲ್"
    },
    {
      "t": "00:52",
      "text": "ಸೇನಾ ಸೇನಾ ಸೇತಾನೆ"
    },
    {
      "t": "00:54",
      "text": "ಏನು"
    },
    {
      "t": "00:56",
      "text": "ಹಾಂ"
    },
    {
      "t": "00:58",
      "text": "ಸ್ವಾತಂತ್ರ್ಯ"
    },
    {
      "t": "01:00",
      "text": "ಹೌದು"
    },
    {
      "t": "01:02",
      "text": "ಹೌದಾ"
    },
    {
      "t": "01:04",
      "text": "ಇಟ್ಲ"
    },
    {
      "t": "01:06",
      "text": "ಅಪ್ಪು ಸರ್"
    },
    {
      "t": "01:08",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:10",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:12",
      "text": "ಹಲೋ ಏನು ಮಾಡ್ತಾ ಇರೋದು ನೀವು"
    },
    {
      "t": "01:14",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:16",
      "text": "ನಾನು ಜವಾಬ್ದಾರಿ"
    },
    {
      "t": "01:18",
      "text": "ಯಾರು"
    },
    {
      "t": "01:20",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:22",
      "text": "ಫುಲ್ ನೇಮ್ ಅಷ್ಟೇನಾ"
    },
    {
      "t": "01:24",
      "text": "ಸೀಸನ್ ಏನು"
    },
    {
      "t": "01:26",
      "text": "ಫುಲ್ ನೇಮು"
    },
    {
      "t": "01:28",
      "text": "ಸೀತಾ ಅಷ್ಟೇನೆ ನೆನೆಸ್ತು"
    },
    {
      "t": "01:30",
      "text": "ಅಷ್ಟೇ ಸೀತಾನೆ"
    },
    {
      "t": "01:32",
      "text": "ಹೀಗೆ"
    },
    {
      "t": "01:34",
      "text": "ಈ ಜನರಲ್ಲಿ ಸೀತಾ"
    },
    {
      "t": "01:36",
      "text": "ತಯಾರಿಕೆ ತಗೊಂಡು ಸ್ವಲ್ಪ ದೊಡ್ಡ ದೇಶಕ್ಕೆ"
    },
    {
      "t": "01:38",
      "text": "ರೆಮೆಮಿ ರೋಸ್ ಪೇಂಟ್"
    },
    {
      "t": "01:40",
      "text": "ಹಾಂ ಓಕೆ"
    },
    {
      "t": "01:42",
      "text": "ರೀಡನ್ ಇವು"
    },
    {
      "t": "01:44",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "01:46",
      "text": "ಹಾಂ"
    },
    {
      "t": "01:48",
      "text": "ಹಲೋ"
    },
    {
      "t": "01:50",
      "text": "ಹಲೋ"
    },
    {
      "t": "01:52",
      "text": "ಓಕೆ"
    },
    {
      "t": "01:54",
      "text": "ಪ್ಲೇನ್"
    },
    {
      "t": "01:56",
      "text": "ವಾಯ್ಸು ಬ್ರೇಕಪ್"
    },
    {
      "t": "01:58",
      "text": "ನಿಮಗೆ ತಿಳಿಸ್ತೀರಾ"
    },
    {
      "t": "02:00",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:04",
      "text": "ಪ್ರಾಯ್ಸು ಕೇಳಿಸ್ತಾ ಇಲ್ಲ ಬ್ರೇಕಪ್ ಫುಲ್"
    },
    {
      "t": "02:06",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:08",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:10",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "02:12",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:14",
      "text": "ಹಾಂ"
    },
    {
      "t": "02:16",
      "text": "ಅಲ್ಲಿಗೆ"
    },
    {
      "t": "02:18",
      "text": "ಪಿಂಕ್ ಲಿಸ್ಟ್ ಹಾಕಿದೆ"
    },
    {
      "t": "02:20",
      "text": "ತೋರಿಸ್ತೀನಿ ನೀವಾ"
    },
    {
      "t": "02:22",
      "text": "ನೆಟ್ವರ್ಕ್ ಇವಾಗ"
    },
    {
      "t": "02:24",
      "text": "ನೆಟ್ವರ್ಕ್ ಇದೆ"
    },
    {
      "t": "02:26",
      "text": "ಮತ್ತೆ ವಾಸಿದೆ"
    },
    {
      "t": "02:28",
      "text": "ವಾಯ್ಸ್ ಬ್ರೇಕ್ ಆಗ್ತದೆ"
    },
    {
      "t": "02:30",
      "text": "ಇದೆಯಾ ಓಕೆ"
    },
    {
      "t": "02:32",
      "text": "ಅವರೇ ಗೊತ್ತಿಲ್ಲ"
    },
    {
      "t": "02:34",
      "text": "ಹೌದಾ"
    },
    {
      "t": "02:36",
      "text": "ಆಗಿದೆಯಾ"
    },
    {
      "t": "02:38",
      "text": "ಏನು"
    },
    {
      "t": "02:40",
      "text": "ಮ್ಯಾರೀಡಾ"
    },
    {
      "t": "02:42",
      "text": "ಹಾಂ ಹೌಸ್ ವೈಫ್"
    },
    {
      "t": "02:44",
      "text": "ಓಕೆ"
    },
    {
      "t": "02:46",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:48",
      "text": "ಚೆಂದಾಗಿದೆಯಾ"
    },
    {
      "t": "02:50",
      "text": "ಇಲ್ಲ"
    },
    {
      "t": "02:52",
      "text": "ಹೌದು"
    },
    {
      "t": "02:54",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "02:56",
      "text": "ಯಾವ ಏರಿಯಾದಲ್ಲಿ ಇರೋದು ಬೆಂಗಳೂರಲ್ಲಿ"
    },
    {
      "t": "02:58",
      "text": "ಆಯುಷ್"
    },
    {
      "t": "03:00",
      "text": "ಕ್ಷೇತ್ರ"
    },
    {
      "t": "03:02",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:04",
      "text": "ಇವತ್ತು ಆಯ್ಕೆ ಉಂಟಲ್ಲ"
    },
    {
      "t": "03:06",
      "text": "ಊರು"
    },
    {
      "t": "03:08",
      "text": "ಶಂಕುರ ಗುಪ್ತಾ"
    },
    {
      "t": "03:10",
      "text": "ಕೇಳಿದೆ"
    },
    {
      "t": "03:12",
      "text": "ಹೌದು"
    },
    {
      "t": "03:14",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:16",
      "text": "ತಿನ್ನಕ್ಕಾಗಲ್ಲ ಮಸ್ತ್ ಎಲ್ಲರಿಗೂ"
    },
    {
      "t": "03:18",
      "text": "ತುಂಬಾ ಫೆಮಿಲಿಯರ್ ಬೆಂಗಳೂರು"
    },
    {
      "t": "03:20",
      "text": "ಇಲ್ಲ ಇದರಲ್ಲಿ"
    },
    {
      "t": "03:22",
      "text": "ಜನ್ರೇಷನ್ಸ್ ಎಲ್ಲ ಬಟ್"
    },
    {
      "t": "03:24",
      "text": "ರಿಲೇಟಿವ್ಸ್ ಎಲ್ಲ ಇದ್ದಾರೆ ಅಷ್ಟು"
    },
    {
      "t": "03:26",
      "text": "ಫೆಮಿಲಿಯರ್ ಇಲ್ಲ"
    },
    {
      "t": "03:28",
      "text": "ಶಾಂತಿ"
    },
    {
      "t": "03:30",
      "text": "ಬೆಳೆದಿದ್ದು"
    },
    {
      "t": "03:32",
      "text": "ಹುಟ್ಟಿದ್ದು ಬೆಳೆದಿದ್ದು ಪ್ರತಿಯೊಂದು"
    },
    {
      "t": "03:34",
      "text": "ಎಲ್ಲ ಇಲ್ಲೇ ಅಲ್ಲ ಸೊ"
    },
    {
      "t": "03:36",
      "text": "ಸೊ ಅಷ್ಟು ಎಕ್ಸ್ಪೋಜರ್ ಇಲ್ಲ ಬೆಂಗಳೂರು"
    },
    {
      "t": "03:38",
      "text": "ಬರ್ತಾ ಇರ್ತೀವಿ ರಿಲೇಟಿವ್ಸ್"
    },
    {
      "t": "03:40",
      "text": "ವಿದ್ಯುತ್ ಬರಲಿಲ್ಲ"
    },
    {
      "t": "03:42",
      "text": "ಹಾಂ ಹೌದು"
    },
    {
      "t": "03:44",
      "text": "ಮದುವೆ ಆಗಿದ್ದು ಅಲ್ಲೇನಾ"
    },
    {
      "t": "03:46",
      "text": "ಹಾಂ"
    },
    {
      "t": "03:48",
      "text": "ನೀವು ಎಷ್ಟು ದಿನ"
    },
    {
      "t": "03:50",
      "text": "ತೆಗ್ದಿರೋದು"
    },
    {
      "t": "03:52",
      "text": "ಹೌದು"
    },
    {
      "t": "03:54",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "03:56",
      "text": "ಸರ್"
    },
    {
      "t": "03:58",
      "text": "ಏ"
    },
    {
      "t": "04:00",
      "text": "ಹಲೋ"
    },
    {
      "t": "04:02",
      "text": "ಹಾಂ ಹೇಳಿ"
    },
    {
      "t": "04:04",
      "text": "ಏನನ್ನ ಪ್ರಮಾಣದಲ್ಲಿ ಬರಲ್ಲ"
    },
    {
      "t": "04:06",
      "text": "ಹೌದು ಎಷ್ಟೊಂದು ಯೂಸ್ ಮಾಡ್ತಾ ಇದ್ದೀರಾ"
    },
    {
      "t": "04:08",
      "text": "ಅಂದೆ ಆ್ಯಪು"
    },
    {
      "t": "04:10",
      "text": "ಇದು"
    },
    {
      "t": "04:12",
      "text": "ಒಂದು ತಿಂಗಳ ಹಿಂದೇನೆ ಮಾಡಿದ್ದೆ ಡೌನ್ಲೋಡ್"
    },
    {
      "t": "04:14",
      "text": "ಯೂಸ್ ಮಾಡಿಲ್ಲ"
    },
    {
      "t": "04:16",
      "text": "ಅಷ್ಟೇ ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "04:18",
      "text": "ಓಹೋಹೋ"
    },
    {
      "t": "04:20",
      "text": "ಒಂದು ಕಾಲ್ ಮಾತಾಡಿದೆ ಅವ್ರಿಗೆ"
    },
    {
      "t": "04:22",
      "text": "ಕಸ್ಕೋಳು ಹ್ಞೂ ಹ್ಞೂ"
    },
    {
      "t": "04:24",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "04:26",
      "text": "ನಾನು ನಾನು"
    },
    {
      "t": "04:28",
      "text": "ಈ ಆ್ಯಪ್ ಬಂದಿದ್ದು"
    },
    {
      "t": "04:30",
      "text": "ಅಂದರೆ ಬೇರೆ ಏನು ಉದ್ದೇಶ ಇಲ್ಲ ಬಟ್"
    },
    {
      "t": "04:32",
      "text": "ನಮ್ಮ ಇಂಟ್ರೆಸ್ಟ್"
    },
    {
      "t": "04:34",
      "text": "ಕಾನ್ಸೆಪ್ಟ್ಗಳು ಟಾಪಿಕ್ಗಳು"
    },
    {
      "t": "04:36",
      "text": "ಎಲ್ಲ ಇತ್ತಲ್ಲ ಆ್ಯಪಲ್ಲಿ"
    },
    {
      "t": "04:38",
      "text": "ಸೊ ಆ ಥರ ಎಲ್ಲ ಮಾತಾಡ್ಬೋದು"
    },
    {
      "t": "04:40",
      "text": "ನಾಲೆಡ್ಜ್ ಇಂಪ್ರೂವ್ ಆಗುತ್ತೆ ಆ ಥರ"
    },
    {
      "t": "04:42",
      "text": "ಥರ ಇಂಟೆನ್ಷನ್ ಇಟ್ಕೊಂಡು"
    },
    {
      "t": "04:44",
      "text": "ಮಾಡಿದ್ದು ಬಟ್ ಎಲ್ಲ ಬೇರೆ ಏನು"
    },
    {
      "t": "04:46",
      "text": "ಏನೋ ಕೆಟ್ಟ ಕೆಟ್ಟ ಇಂಟೆನ್ಷನ್ ಇಂದ ಮಾಡ್ತಾರೆ"
    },
    {
      "t": "04:48",
      "text": "ಕೆಲವರು"
    },
    {
      "t": "04:50",
      "text": "ಟೆಲರ್ ಚೆನ್ನಾಗಿ ಮಾತಾಡ್ತಾರೆ ನಿಮ್ಮ ಥರ"
    },
    {
      "t": "04:52",
      "text": "ಹಾಂ"
    },
    {
      "t": "04:54",
      "text": "ಇದೇನು ಸರ ಇದು ಹೇಳ್ತಾರೆ"
    },
    {
      "t": "04:56",
      "text": "ಹಿಂಗೂ ಇರ್ತಾರೆ ಹಂಗೆ"
    },
    {
      "t": "04:58",
      "text": "ಯಾರು"
    },
    {
      "t": "05:00",
      "text": "ಅಲ್ವಾ"
    },
    {
      "t": "05:02",
      "text": "ಹಾಂ"
    },
    {
      "t": "05:04",
      "text": "ಅಷ್ಟೇ"
    },
    {
      "t": "05:06",
      "text": "ಅಲ್ವಾ ಅಂದರೆ ಎಲ್ಲರೂ ಅದೇ ಥರ ಇರಲ್ಲ"
    },
    {
      "t": "05:08",
      "text": "ಎಲ್ಲ ಒಂದೇ ಥರ ಇರಲ್ಲ"
    },
    {
      "t": "05:10",
      "text": "ಪಾಪ ಏನೇನೋ ಅವರು"
    },
    {
      "t": "05:12",
      "text": "ಪ್ರಾಬ್ಲಮ್ಗಳು ಗೊತ್ತಿಲ್ಲ"
    },
    {
      "t": "05:14",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "05:16",
      "text": "ಅಂದರೆ ಆಲ್ಮೋಸ್ಟು"
    },
    {
      "t": "05:18",
      "text": "ಅಲ್ಲಿ ಹುಡುಗಿರೆಲ್ಲ ಬರೋದು ಇದಕ್ಕೆಲ್ಲ"
    },
    {
      "t": "05:20",
      "text": "ಹಾಂ ಬರ್ರಿ ಲೇಡೀಸು"
    },
    {
      "t": "05:22",
      "text": "ಇದು ಅವ್ರ ಖರ್ಚಿಗೆ ಏನಪ್ಪಾ ದುಡ್ಡು ಬರುತ್ತೆ"
    },
    {
      "t": "05:24",
      "text": "ಇರುತ್ತೆ ಅಂತ ಆಲ್ಮೋಸ್ಟ್ ಎಲ್ಲಾ ಅಧಿಕ ಬರ್ತಾರೆ"
    },
    {
      "t": "05:26",
      "text": "ಅಯ್ಯೋ"
    },
    {
      "t": "05:28",
