      "t": "00:30",
      "text": "பேசலாம் எப்படி வேணாலும் பேசலாம்"
    },
    {
      "t": "00:35",
      "text": "ஹலோ சார்"
    },
    {
      "t": "00:40",
      "text": "ஆறாயிரம்"
    },
    {
      "t": "00:45",
      "text": "சிங்கிள் டவுன்"
    },
    {
      "t": "00:50",
      "text": "புரியல புரியல"
    },
    {
      "t": "00:55",
      "text": "ஃபோன் பண்ணுங்கள்"
    },
    {
      "t": "01:00",
      "text": "உன்ன மல்லி நீ எங்கேருந்து பேசுற அப்பாண்டு"
    },
    {
      "t": "01:05",
      "text": "பாண்டிச்சேரியா சூப்பர்"
    },
    {
      "t": "01:10",
      "text": "எம்ஏஹெச் ட்வெண்ட்டி செவன்"
    },
    {
      "t": "01:15",
      "text": "ஓகே வணக்கம் ட்வெண்ட்டி ஃபோர்"
    },
    {
      "t": "01:20",
      "text": "உள்ளே ஒன்றும் போகல"
    },
    {
      "t": "01:25",
      "text": "உள்ளேயா போட்டிருக்கிறேன்"
    },
    {
      "t": "01:30",
      "text": "ஆறு ஆஹா இது ரொம்ப லூஸ் டீஷர்ட்"
    },
    {
      "t": "01:35",
      "text": "ஆடுது ஆயிப்போ ஆகலையே"
    },
    {
      "t": "01:40",
      "text": "அதான் பார்க்கிறேன்"
    },
    {
      "t": "01:45",
      "text": "எதுவும் ஆகலைங்க உங்கள் கண்ணு கபடிச்சது"
    },
    {
      "t": "01:50",
      "text": "கதவு மக்களா"
    }
  ],
