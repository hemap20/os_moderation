{
  "file_id": "rec_default_426565486_audio_1788982385911.mp3",
  "language": "malayalam",
  "chunk_seconds": 5.0,
  "audio_duration_sec": 444.401,
  "processing_time_sec": 290.27488899230957,
  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ എവിടെ സ്ഥലം"
    },
    {
      "t": "00:05",
      "text": "അല്ല എന്തു ചെയ്യുന്നു"
    },
    {
      "t": "00:10",
      "text": "ആയുർവേദം എടുത്തു നോക്കിയേ"
    },
    {
      "t": "00:15",
      "text": "ആയുർവേദ നഴ്സായിട്ട് വർക്ക് ചെയ്യാം എവിടെ"
    },
    {
      "t": "00:20",
      "text": "മറ്റു വേണ്ട മരീഡാ"
    },
    {
      "t": "00:25",
      "text": "ലെവൻഡോ"
    },
    {
      "t": "00:30",
      "text": "ലെമണില്"
    },
    {
      "t": "00:35",
      "text": "ഉണ്ടായിരുന്നു കേട്ടില്ല"
    },
    {
      "t": "00:40",
      "text": "ലവ് ഉണ്ടായിരുന്നോ എന്ന് ഉണ്ടായിരുന്നു പറയാം ബൈ"
    },
    {
      "t": "00:45",
      "text": "കളിച്ചിനാ കളിച്ചിട്ടുണ്ടോ ചേച്ചി"
    },
    {
      "t": "00:50",
      "text": "ആ"
    },
    {
      "t": "00:55",
      "text": "ആ ഉണ്ട് എവിടെ ലൗ"
    },
    {
      "t": "01:00",
      "text": "കളിച്ചാൽ ബ്രേക്കപ്പ് ആവും ഇപ്പോഴത്തെ ലൈഫ് ഒന്നും സീരിയസ് അല്ല കളിച്ച് കഴിഞ്ഞാൽ പോയി"
    },
    {
      "t": "01:05",
      "text": "ഓ അങ്ങനെയൊന്നുമില്ല എത്ര വർഷം കളിച്ചിട്ടുണ്ട്"
    },
    {
      "t": "01:10",
      "text": "എത്ര പ്രാവശ്യം കളിച്ചിട്ടുണ്ടാവും"
    },
    {
      "t": "01:15",
      "text": "എവിടെ കയറുന്നതാണ്"
    },
    {
      "t": "01:20",
      "text": "നിരന്തരം"
    },
    {
      "t": "01:25",
      "text": "എന്തായാലും വന്നാൽ കാണാൻ പറ്റുമോ എന്തിന്"
    },
    {
      "t": "01:30",
      "text": "എനിക്കും കളിക്കാനാ അയ്യടാ അവൻ നോക്കി"
    },
    {
      "t": "01:35",
      "text": "മടക്കി തെക്കേ തന്നേക്കുന്നത് ഇല്ല മടക്കി പോയി"
    },
    {
      "t": "01:40",
      "text": "ഇല്ല നക്കുമ്പോലെ സുഖം നക്കി കാത്ത് എന്താ"
    },
    {
      "t": "01:45",
      "text": "നന്നാക്കി തരട്ടെ"
    },
    {
      "t": "01:50",
      "text": "വേണ്ട"
    },
    {
      "t": "01:55",
      "text": "കേറ്റുമ്പോൾ വേദന ഉണ്ടോ ഇല്ല"
    },
    {
      "t": "02:00",
      "text": "ഏഹ് ഇല്ലേ എന്താ ഫേസ് ഏഹ്"
    },
    {
      "t": "02:05",
      "text": "ഇല്ല സുഖമുണ്ടോ ഇല്ല സുഖമുണ്ടോ"
    },
    {
      "t": "02:10",
      "text": "ഇല്ല ഒന്നുമില്ല"
    },
    {
      "t": "02:15",
      "text": "മനസ്സിലായില്ല ഒന്നുമില്ലായിരുന്നു"
    },
    {
      "t": "02:20",
      "text": "എന്ത് ഫേസ് കാണിക്കാത്തത്"
    },
    {
      "t": "02:25",
      "text": "കാണുന്നില്ല"
    },
    {
      "t": "02:30",
      "text": "മോഹൻലാൽ ഗാന്ധി നല്ലോ മോഹൻലാൽ ഗാന്ധി"
    },
    {
      "t": "02:35",
      "text": "എന്തിന് ഓടാ എന്തിന്"
    },
    {
      "t": "02:40",
      "text": "അതെ കാണിച്ചത്"
    },
    {
      "t": "02:45",
      "text": "ആ ഓൺലൈൻ ആണ് എക്സാം"
    },
    {
      "t": "02:50",
      "text": "ഉണ്ട് ഞാൻ"
    },
    {
      "t": "02:55",
      "text": "ഏഹ് നമുക്ക് മൂഡായി"
    },
    {
      "t": "03:00",
      "text": "ഒറ്റക്കാണോ താമസം അല്ല"
    },
    {
      "t": "03:05",
      "text": "നിന്റെ വീട്ടിലാണോ വീട് എവിടെയാണ്"
    },
    {
      "t": "03:10",
      "text": "വീട് എവിടെയാണ് വീട് കൊല്ലം കൊല്ലം കൊല്ലം കോഴിക്കോടൊക്കെ വരാറുണ്ടോ"
    },
    {
      "t": "03:15",
      "text": "ഇല്ല"
    },
    {
      "t": "03:20",
      "text": "ഇനി എപ്പോഴാണ് തിരുവനന്തപുരം കുറച്ച് ഇളങ്ങി വരും"
    },
    {
      "t": "03:25",
      "text": "മോദി"
    },
    {
      "t": "03:30",
      "text": "എന്താണ്"
    },
    {
      "t": "03:35",
      "text": "മൂടായി"
    },
    {
      "t": "03:40",
      "text": "മൂടായി കാണിക്കാം"
    },
    {
      "t": "03:45",
      "text": "മക്കിത്തൊട്ടൻ"
    },
    {
      "t": "03:50",
      "text": "അമോദ കാണിക്കും"
    },
    {
      "t": "03:55",
      "text": "ഞാൻ നോക്കട്ടെ അയ്യോ ആ കാണിക്കും"
    },
    {
      "t": "04:00",
      "text": "ഓല കാണിച്ചിടൽ"
    },
    {
      "t": "04:05",
      "text": "ആ"
    },
    {
      "t": "04:10",
      "text": "നാണക്കേട് നാണക്കേടേം ചെയ്യും"
    },
    {
      "t": "04:15",
      "text": "എന്ത് കാണിക്കണം"
    },
    {
      "t": "04:20",
      "text": "അപ്പച്ചനും കാണിക്കണേ"
    },
    {
      "t": "04:25",
      "text": "ആക്ടിങ്ങിനെ കാണിക്കുന്നതാണ് കണ്ടോ"
    },
    {
      "t": "04:30",
      "text": "ആ"
    },
    {
      "t": "04:35",
      "text": "എന്നെ കാണാൻ പറ്റുന്നില്ലല്ലോ"
    },
    {
      "t": "04:40",
      "text": "ഇല്ലല്ലോ"
    },
    {
      "t": "04:45",
      "text": "അതാണ്"
    },
    {
      "t": "04:50",
      "text": "വളരെ കണ്ടോ"
    },
    {
      "t": "04:55",
      "text": "കണ്ടോ ഇത് കിബിലി നിൽക്കുകയാണെങ്കിൽ തന്നെ"
    },
    {
      "t": "05:00",
      "text": "ആ ഇനി ജസ്റ്റ് കാണിക്കും"
    },
    {
      "t": "05:05",
      "text": "ആ അവകാശം"
    },
    {
      "t": "05:10",
      "text": "കാണിച്ചോളൂ"
    },
    {
      "t": "05:15",
      "text": "കാണിക്കും"
    },
    {
      "t": "05:20",
      "text": "നാണക്കേടിന്"
    },
    {
      "t": "05:25",
      "text": "ഇനി കാണാനൊന്നുമില്ല ആയി കാണിക്കും നോക്കട്ടെ"
    },
    {
      "t": "05:30",
      "text": "കാണുന്നവനൊക്കെ തന്നെ ആയി നോക്ക് കാണിക്കും"
    },
    {
      "t": "05:35",
      "text": "മൂഡാവും കാണിക്കുവോ"
    },
    {
      "t": "05:40",
      "text": "ആണിക്കപ്പം"
    },
    {
      "t": "05:45",
      "text": "ആ"
    },
    {
      "t": "05:50",
      "text": "അനുഭവം കാണിക്കും"
    },
    {
      "t": "05:55",
      "text": "ഞങ്ങൾക്ക് ആ ടൈം കാണിക്കാം"
    },
    {
      "t": "06:00",
      "text": "ഇതുപോലെ കട്ട് ചെയ്യുന്നത് ഓക്കെ"
    },
    {
      "t": "06:05",
      "text": "കാണിക്കും കാണിക്കില്ലേ"
    },
    {
      "t": "06:10",
      "text": "നല്ല പാത്രം"
    },
    {
      "t": "06:15",
      "text": "പാടെ നക്കിത്തരും വരവോ"
    },
    {
      "t": "06:20",
      "text": "ആര് അല്ലേ നല്ല പാട്ട്"
    },
    {
      "t": "06:25",
      "text": "വയനാട്ടിൽ തെരുവ് പോകുന്നു"
    },
    {
      "t": "06:30",
      "text": "എവിടെ കാസർഗോഡ്"
    },
    {
      "t": "06:35",
      "text": "എൻ്റെ പൂർണ്ണ ഇറക്കിത്തരും നല്ലതാണ്"
    },
    {
      "t": "06:40",
      "text": "അക്കനിസ്റ്റയാ"
    },
    {
      "t": "06:45",
      "text": "കയറ്റുന്ന മാത്രം ഇഷ്ടമോ കയറ്റുന്ന മാത്രമാണോ"
    },
    {
      "t": "06:50",
      "text": "നല്ല രസമുണ്ട് കേറ്റുമ്പോൾ ഏ"
    },
    {
      "t": "06:55",
      "text": "ഏറ്റവും വലിയ രസമുണ്ടോ"
    },
    {
      "t": "07:00",
      "text": "ടൈറ്റാണോ അതെന്നെ ടൈറ്റാണോ"
    },
    {
      "t": "07:05",
      "text": "സാധനം ടൈറ്റാണോ"
    },
    {
      "t": "07:10",
      "text": "കേട്ടിട്ടോ"
    },
    {
      "t": "07:15",
      "text": "കിണറ്റിലേക്ക് കളിക്കണം"
    },
    {
      "t": "07:20",
      "text": "ആ"
    }
  ],
