{
  "file_id": "rec_audio_call_422128803_audio_1788577048478.mp3",
  "language": "malayalam",
  "chunk_seconds": 5.0,
  "audio_duration_sec": 528.8239375,
  "processing_time_sec": 348.95364785194397,
  "segments": [
    {
      "t": "00:00",
      "text": "ഹലോ"
    },
    {
      "t": "00:05",
      "text": "ഹലോ അടിപൊളി സലാം"
    },
    {
      "t": "00:10",
      "text": "ഇത് മലപ്പുറം അല്ലാതെ തന്നെ"
    },
    {
      "t": "00:15",
      "text": "ഹൗസ് വൈഫാണോ"
    },
    {
      "t": "00:20",
      "text": "എന്തൊക്കെ എന്താ മാരേടാ"
    },
    {
      "t": "00:25",
      "text": "മാര്യേഡ് ആണ് ഇല്ല എനിക്ക് ഉണ്ടാവും"
    },
    {
      "t": "00:30",
      "text": "ആരാണുണ്ടോ"
    },
    {
      "t": "00:35",
      "text": "പിന്നെ എന്താണ് പരിപാടി പരിപാടിയൊന്നുമില്ല"
    },
    {
      "t": "00:40",
      "text": "കൗഡി കൈഞ്ഞോ"
    },
    {
      "t": "00:45",
      "text": "ഇല്ല ഇയാൾക്ക് എത്ര വയസ്സായി എത്ര വയസ്സായി"
    },
    {
      "t": "00:50",
      "text": "എന്താ ചെയ്യുന്നത് ഞാൻ അഡ്വെർടൈസിങ്ങിൻ്റെ വർക്കയാണ്"
    },
    {
      "t": "00:55",
      "text": "ആ"
    },
    {
      "t": "01:00",
      "text": "പിന്നെന്താണ് പിന്നെന്താണ് പ്രത്യേകിച്ച് എന്താണ്"
    },
    {
      "t": "01:05",
      "text": "ഹസ്ബൻഡിൻ്റെ നാട്ടിൽ തന്നെയാണ് തൃശ്ശൂർ"
    },
    {
      "t": "01:10",
      "text": "ഓക്കേ ആണോ അതെ അതെ"
    },
    {
      "t": "01:15",
      "text": "പിന്നെ വരാറില്ല വന്നില്ലേ"
    },
    {
      "t": "01:20",
      "text": "ഇല്ല വന്നില്ല"
    },
    {
      "t": "01:25",
      "text": "പിന്നെ ആരൊക്കെയുണ്ട് അവിടെ ഇവിടെ"
    },
    {
      "t": "01:30",
      "text": "കാര്യമില്ല ഞാൻ രണ്ടുപേരെ ഉള്ളു"
    },
    {
      "t": "01:35",
      "text": "പിന്നെ"
    },
    {
      "t": "01:40",
      "text": "പിന്നെന്താ പറയുക പറയുക"
    },
    {
      "t": "01:45",
      "text": "താമ്പര"
    },
    {
      "t": "01:50",
      "text": "താൻ പറ പുള്ളിക്കാരൻ അവിടെ ഇരുന്ന് കഴിഞ്ഞാൽ എങ്ങനെ"
    },
    {
      "t": "01:55",
      "text": "രാവിലെ കളിയൊന്നുമില്ലേ ഇല്ല"
    },
    {
      "t": "02:00",
      "text": "അയ്യോ കളിയില്ലാതെ എങ്ങനെയാണ്"
    },
    {
      "t": "02:05",
      "text": "അറിയത്തില്ല"
    },
    {
      "t": "02:10",
      "text": "തുള്ളി വിടത്തില്ലേ മില്ല്"
    },
    {
      "t": "02:15",
      "text": "എനിക്ക് വല്ലപ്പോഴേ ലീവ് കിട്ടത്തുള്ളൂ ആ ആ"
    },
    {
      "t": "02:20",
      "text": "എന്താ കൂടുതലിഷ്ടം എല്ലാം ഇഷ്ടമാണ്"
    },
    {
      "t": "02:25",
      "text": "എല്ലാ ഇഷ്ടപാടും"
    },
    {
      "t": "02:30",
      "text": "എന്നാലും കൂടുതലും"
    },
    {
      "t": "02:35",
      "text": "കൂടുതലും ഓവറൽ ഒക്കെയാണ് ഇഷ്ടം ഓവറൽ സെക്സ്"
    },
    {
      "t": "02:40",
      "text": "ആ"
    },
    {
      "t": "02:45",
      "text": "പിന്നെ പെണ്ണ് പറ"
    },
    {
      "t": "02:50",
      "text": "തറ"
    },
    {
      "t": "02:55",
      "text": "പാറ"
    },
    {
      "t": "03:00",
      "text": "പറ ദാ പറ"
    },
    {
      "t": "03:05",
      "text": "എല്ലാവരിലും ഉണ്ടോ ഇല്ല"
    },
    {
      "t": "03:10",
      "text": "പിന്നെന്താ മരം"
    },
    {
      "t": "03:15",
      "text": "ജോലിയിൽ നിന്ന്"
    },
    {
      "t": "03:20",
      "text": "ഉണ്ട് പത്ത് മണിയൊക്കെ ആകുമ്പോൾ പോയാൽ മതി"
    },
    {
      "t": "03:25",
      "text": "വീട്ടിൽ ആരൊക്കെയുണ്ട് മാരീഡ് ആണോ"
    },
    {
      "t": "03:30",
      "text": "എല്ലാം ശ്രീകല"
    },
    {
      "t": "03:35",
      "text": "എൻ്റെ പെട്ടി മുപ്പത് വയസ്സ് വരും ഗേറ്റാത്തെ"
    },
    {
      "t": "03:40",
      "text": "നോക്കുന്നുണ്ട്"
    },
    {
      "t": "03:45",
      "text": "നേരത്തെ ഒരെണ്ണം ഉണ്ടായിരുന്നു പ്രത്യേകിച്ച്"
    },
    {
      "t": "03:50",
      "text": "എന്താ പറ്റിയത് എന്തോ"
    },
    {
      "t": "03:55",
      "text": "പറ്റിയത് നമുക്ക് വേറെ ഉണ്ടായിരുന്നു"
    },
    {
      "t": "04:00",
      "text": "അടിപൊളി"
    },
    {
      "t": "04:05",
      "text": "അവിടെ കളിച്ചും അടുത്തവ പോയി"
    },
    {
      "t": "04:10",
      "text": "ഫോട്ടോ ഫോട്ടോ മ്മ് സാരി ലെറ്റോ"
    },
    {
      "t": "04:15",
      "text": "അവളെ കളിച്ച് മടുത്തപ്പോഴത്തേനും പോയിന്ന് പോട്ടെ പോട്ടെ സാരമില്ല"
    },
    {
      "t": "04:20",
      "text": "കെട്ടിയായിരുന്നെങ്കിൽ"
    },
    {
      "t": "04:25",
      "text": "ഇപ്പം മേശയായിട്ടിരിക്കേണ്ടി വന്നേനെ"
    },
    {
      "t": "04:30",
      "text": "ആ"
    },
    {
      "t": "04:35",
      "text": "പിന്നെ പറ"
    },
    {
      "t": "04:40",
      "text": "പറ കളിക്കാൻ മൂഡുണ്ടോ"
    },
    {
      "t": "04:45",
      "text": "മിഥു കളിക്കാൻ മൂഡുണ്ടോ"
    },
    {
      "t": "04:50",
      "text": "ഉണ്ട് എന്നാൽ"
    },
    {
      "t": "04:55",
      "text": "പ്രത്യേകത ഇതിനകത്തൂടെ കളിക്കാൻ മോളില്ല"
    },
    {
      "t": "05:00",
      "text": "ഫോണിനകത്തൂടെ കളിക്കാൻ മൂഡില്ല പിന്നെ എങ്ങനെയാണ്"
    },
    {
      "t": "05:05",
      "text": "നേരിട്ട് വീഡിയോ നോക്കാം"
    },
    {
      "t": "05:10",
      "text": "ഏറ്റവും വലിയ അവിടെ അവിടെ വരണോ എന്തുവാ"
    },
    {
      "t": "05:15",
      "text": "എവിടെന്ന് പറഞ്ഞാല് മലപ്പുറമാണോ"
    },
    {
      "t": "05:20",
      "text": "മലപ്പുറത്തു നിന്നു വന്നിട്ട് എവിടെയാണ് മലപ്പുറത്ത്"
    },
    {
      "t": "05:25",
      "text": "പെരിന്തൽമണ്ണ"
    },
    {
      "t": "05:30",
      "text": "ആ ബന്ധമാണ് ഓ ഞാനൊക്കെ അവിടെയൊക്കെ വരാറുണ്ട്"
    },
    {
      "t": "05:35",
      "text": "ആ എന്നിട്ടുതന്നെ"
    },
    {
      "t": "05:40",
      "text": "റൂമെടുക്കുമോ എന്തെങ്കിലും ചെയ്യാം"
    },
    {
      "t": "05:45",
      "text": "എന്തെങ്കിലും ചെയ്യാം"
    },
    {
      "t": "05:50",
      "text": "എന്തെങ്കിലും ചെയ്യാമെന്ന് പറഞ്ഞിട്ട് എന്താ ഞാനവിടെ വന്നിട്ട്"
    },
    {
      "t": "05:55",
      "text": "താൻ എന്നാ വീട്ടിലോട്ട് വാ ഏ"
    },
    {
      "t": "06:00",
      "text": "വീട്ടിലോട്ട് വാ വീട്ടിൽ വരത്തില്ല"
    },
    {
      "t": "06:05",
      "text": "ആ പിന്നെ താമര"
    },
    {
      "t": "06:10",
      "text": "ഏ എന്നാൽ പിന്നെ താൻ പറ"
    },
    {
      "t": "06:15",
      "text": "റൂമെടുക്കാം ഓക്കേ"
    },
    {
      "t": "06:20",
      "text": "ഉം"
    },
    {
      "t": "06:25",
      "text": "എന്നാദ്യം"
    },
    {
      "t": "06:30",
      "text": "എന്തൊക്കെയാ"
    },
    {
      "t": "06:35",
      "text": "പാറ"
    },
    {
      "t": "06:40",
      "text": "പെരുന്നാൾ മുന്നേ അല്ലേ എവിടെയാണ്"
    },
    {
      "t": "06:45",
      "text": "പുത്തനങ്ങാടി ആ"
    },
    {
      "t": "06:50",
      "text": "പുത്തനങ്ങാടി"
    },
    {
      "t": "06:55",
      "text": "പിന്നെ"
    },
    {
      "t": "07:00",
      "text": "പിന്നെന്താ"
    },
    {
      "t": "07:05",
      "text": "നഗരത്തില്"
    },
    {
      "t": "07:10",
      "text": "ഇല്ല ഇല്ല"
    },
    {
      "t": "07:15",
      "text": "അല്ല എന്തു പറ്റി ആരെയൊക്കെ"
    },
    {
      "t": "07:20",
      "text": "ആര് കളിക്കും"
    },
    {
      "t": "07:25",
      "text": "അടുത്തുനിന്ന് ആൾക്കാരില്ലേ"
    },
    {
      "t": "07:30",
      "text": "എല്ലാവരും ഇല്ല"
    },
    {
      "t": "07:35",
      "text": "പിള്ളേർ കളിക്കുന്നതാണോ പ്രായമുള്ളവർ കളിക്കുന്നതാണോ ഇഷ്ടം"
    },
    {
      "t": "07:40",
      "text": "പിള്ളേർ കളിച്ചിട്ടില്ല പിള്ളേർ"
    },
    {
      "t": "07:45",
      "text": "കളിച്ചിട്ടില്ല എന്താണ്"
    },
    {
      "t": "07:50",
      "text": "എന്താണെന്ന് ചോദിച്ചാൽ ഇപ്പം പറയുന്നില്ല"
    },
    {
      "t": "07:55",
      "text": "ആ"
    },
    {
      "t": "08:00",
      "text": "പിന്നെന്താ"
    },
    {
      "t": "08:05",
      "text": "ആ"
    },
    {
      "t": "08:10",
      "text": "വീഡിയോ കോൾ ചെയ്യാൻ മോഡുണ്ടോ"
    },
    {
      "t": "08:15",
      "text": "എന്തുവാ വീഡിയോ"
    },
    {
      "t": "08:20",
      "text": "ഗുണം ചെയ്യണമെന്ന് ഇതിലെല്ലാം"
    },
    {
      "t": "08:25",
      "text": "പിന്നെ വാട്ട്സപ്പിൽ പേ ചെയ്യണോ"
    },
    {
      "t": "08:30",
      "text": "ആഹ് കേട്ടില്ല"
    },
    {
      "t": "08:35",
      "text": "വെയിലാണോ അതെ ആ"
    },
    {
      "t": "08:40",
      "text": "അപ്പോള്"
    },
    {
      "t": "08:45",
      "text": "ആ"
    }
