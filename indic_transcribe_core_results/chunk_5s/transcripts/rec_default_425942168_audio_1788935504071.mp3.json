      "text": "ನನ್ನ ಹೆಸರು"
    },
    {
      "t": "00:20",
      "text": "ಸರೋಡ ಮತ್ತೆ"
    },
    {
      "t": "00:25",
      "text": "ಎಲ್ಲಿ ಕೇಳೋಣ ನೀವು ಮ್ಯಾರೀಡಾ ಸಿಂಗಲ್ಲಾ ಸಿಂಗಲ್"
    },
    {
      "t": "00:30",
      "text": "ನೀವು ನಾನು ಸಿಂಗಲ್ ಯುವರ್ ಏಜ್"
    },
    {
      "t": "00:35",
      "text": "ಹ್ಞೂ"
    },
    {
      "t": "00:40",
      "text": "ತರ್ಟಿ ಒನ್ ನಿಮ್ಮದು"
    },
    {
      "t": "00:45",
      "text": "ಟ್ವೆಂಟಿ ಟು ಟ್ವೆಂಟಿ"
    },
    {
      "t": "00:50",
      "text": "ಟು ಮತ್ತು"
    },
    {
      "t": "00:55",
      "text": "ಹೇಳಿ ಕೇಳೋಣ ನಿಮ್ಮ ಹೆಸರು"
    },
    {
      "t": "01:00",
      "text": "ವಿಜಯ್ ಅಂತ"
    },
    {
      "t": "01:05",
      "text": "ಸ್ವಾತಿ"
    },
    {
      "t": "01:10",
      "text": "ಸ್ವಾತಿ ಮತ್ತೆ ನೀನು ಸ್ವಾತಿ ಸಂಚಾರ"
    },
    {
      "t": "01:15",
      "text": "ಇಲ್ಲಿ ಕೇರಳ"
    },
    {
      "t": "01:20",
      "text": "ಎನಿ ಸ್ಟೇಟ್ಮೆಂಟ್"
    },
    {
      "t": "01:25",
      "text": "ಅಂದರೆ ಯಾವ ಥರ"
    },
    {
      "t": "01:30",
      "text": "ಫುಡ್ ವರ್ಕ್"
    },
    {
      "t": "01:35",
      "text": "ಫಿಟ್ಸ್ ಬಗ್ಗೆ ಏನು ಇಷ್ಟ ಅಂದರೆ ಏನು ಹೇಳಲಿ"
    },
    {
      "t": "01:40",
      "text": "ನಿಮ್ಗೆ ಯಾವ ಥರ ಇಷ್ಟ ಆಯಿತು"
    },
    {
      "t": "01:45",
      "text": "ನಾರ್ಮಲ್ ಫಿಕ್ಸಿಂಗ್ ಮಾತ್ರ ರಂಗೇಜ್"
