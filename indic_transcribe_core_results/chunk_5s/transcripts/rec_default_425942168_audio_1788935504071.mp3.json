    {
      "t": "03:15",
      "text": "ಮಾಡಿದ್ರೆ ಇನ್ನೂ ಆಸೆ"
    },
    {
      "t": "03:20",
      "text": "ಕಷ್ಟ ಆಗುತ್ತಲ್ವಾ ನಮಗೇನು ಏನಾಗಲ್ಲ"
