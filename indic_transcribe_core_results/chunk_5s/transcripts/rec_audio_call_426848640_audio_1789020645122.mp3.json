    {
      "t": "00:30",
      "text": "चालीस रुपये का"
    },
    {
      "t": "00:35",
      "text": "क्या करोगे वीडियो कॉल"
    },
    {
      "t": "00:40",
      "text": "हेलो वीडियो कॉल करूँगी मैं दिखाऊँगा नीचे वाला"
    },
    {
      "t": "00:45",
      "text": "नीचे गला देखो"
    },
    {
      "t": "00:50",
      "text": "नमस्ते नमस्ते"
    },
    {
      "t": "00:55",
      "text": "क्या नहीं देखना है बहुत देख चुका हूँ"
    },
    {
      "t": "01:00",
      "text": "नवेले लघुमती हो"
    },
    {
      "t": "01:05",
      "text": "खाना नवा बोलो हेलो"
    },
    {
      "t": "01:10",
      "text": "बच रहे हो कोवा बालो कोवा कुड़ी लिए"
    }
  ],
