      "text": "हैलो हैलो"
    },
    {
      "t": "00:05",
      "text": "हेलो हाँ भाई कैसे हो"
    },
    {
      "t": "00:10",
      "text": "हेलो कहाँ से हो बेबी"
    },
    {
      "t": "00:15",
      "text": "आप कहाँ से हो लखनऊ से हो कहाँ से हो"
    },
    {
      "t": "00:20",
      "text": "मैं असम से हूँ आप कहाँ से हो लखनऊ"
    },
    {
      "t": "00:25",
      "text": "उसका नाम क्या करती हो"
