    {
      "t": "00:00",
      "text": "ಹಲೋ ಹಾಯ್ ಎಲ್ಲಿಂದ ಇಂಗ್ಲೀಷ್ ತೆಲುಗು"
    },
    {
      "t": "00:07",
      "text": "ಹ್ಞೂ ತಿಳ್ಕೊಳ್ಳಿ ಎಕ್ನುಂಚು ಬೆಂಗ್ಳೂರು ಹಲ್ಸೂರ್ರಾ"
    },
    {
      "t": "00:14",
      "text": "ಏಜ್ ಎಂತ ಟ್ವೆಂಟಿ ಟು ಹಾಟ್ಗೂ ಅಲ್ಲ ಏನು ರಿಟರ್ನ್"
    },
    {
      "t": "00:21",
      "text": "ಟಾಪಿಕ್ ಮಾತಾಡೋದ್ಸು ಹ್ಞೂ ಏನು ರೀ ಟಾಪಿಕ್ ಯಾವುದನ್ನು ಓಕೆ ಓಕೆ"
    },
    {
      "t": "00:28",
      "text": "ಸೆಕ್ಸಿ ನಾಟಿ ವಾಟ್ಸ್ ಯು ಬ್ರೋ ಸೈಜ್ ಥರ್ಟಿ"
    },
    {
      "t": "00:35",
      "text": "ವಾವ್ ಯು ಲುಕ್ ಹಾಟ್ ಸೆಕ್ಸಿ ಎನಿ ಜಸ್ಟ್"
    },
    {
      "t": "00:42",
      "text": "ಶೋ ಯುವರ್ ಬುಕ್ಸ್ ವಾಟ್ಸಾಪಾ ಓಕೆ ಹೌ ಮಚ್ ಯು ಚಾರ್ಜ್ ಫಾರ್ ದ್ಯಾಟ್"
    },
    {
      "t": "00:49",
      "text": "ಡಬಲ್ ಶೋಕವಲ್ಲ ಡಬಲ್ ಶೋಕವಲ್ಲನಾ"
    }
  ],
