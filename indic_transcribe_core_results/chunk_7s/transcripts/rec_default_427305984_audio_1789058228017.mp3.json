    {
      "t": "00:28",
      "text": "సంగతులు"
    },
    {
      "t": "00:35",
      "text": "ఏమైంది ఎప్పటి నుంచి చేసేస్తున్నారు"
    },
    {
      "t": "00:42",
      "text": "వాట్స్ ద పర్పస్ యాక్చువల్లీ నార్మల్"
    },
    {
      "t": "00:49",
      "text": "ఇక్కడ మనీ ఎట్లా మీటింగ్ అట్లా ఉందా"
    },
    {
      "t": "00:56",
      "text": "నాట్ వీసీ కలవడం"
    },
    {
      "t": "01:03",
      "text": "పల్చగా కాదు పల్చగా కాదు"
    },
    {
      "t": "01:10",
      "text": "ఏంటి మీట్ మీట్ అవ్వడానికి అంటున్నాం"
    },
    {
      "t": "01:17",
      "text": "ఇంట్రెస్ట్ లేదా థ్యాంక్ యూ"
    },
    {
      "t": "01:24",
      "text": "ఓకే"
    }
  ],
