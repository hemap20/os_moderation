  "segments": [
    {
      "t": "00:00",
      "text": "హాయ్"
    },
    {
      "t": "00:07",
      "text": "హలో హైదరాబాద్లో హైదరాబాద్లో"
    },
    {
      "t": "00:14",
      "text": "నువ్వు పిలిచిర్రా బాబు ఎక్కడ"
    },
    {
      "t": "00:21",
      "text": "వినాయక్ నగర్ వినాయక్ నగర్"
    },
    {
      "t": "00:28",
      "text": "ఏం చేస్తుంటారు జాబ్ నువ్వు నేను జాబ్"
    },
    {
      "t": "00:35",
      "text": "ఆ"
    },
    {
      "t": "00:42",
      "text": "హలో ఏం జాబ్"
    },
    {
      "t": "00:49",
      "text": "క్యాష్ కనెక్ట్లో"
    },
    {
      "t": "00:56",
      "text": "క్యూ కనెక్ట్లో అర్థం కాలేదు క్యూ కనెక్ట్లో"
    },
    {
      "t": "01:03",
      "text": "ఎక్కడ ప్రాపర్ హైదరాబాద్ లోకలా"
    },
    {
      "t": "01:10",
      "text": "డిసెంబర్"
    },
    {
      "t": "01:17",
      "text": "మస్ట్ ఫీల్ అయింది ఫైవ్ ఇయర్స్"
    },
    {
      "t": "01:24",
      "text": "మాటలు కావు"
    },
    {
      "t": "01:31",
      "text": "మ్యారీడా లేదు ఎంత ఏజ్"
    },
    {
      "t": "01:38",
      "text": "నైన్ ట్వంటీ ఫైవ్ నైన్ ట్వంటీ టూ"
    },
    {
      "t": "01:45",
      "text": "పర్పస్ ఏంది యాప్లో పర్పస్"
    },
    {
      "t": "01:52",
      "text": "ఇంకా ఇంకా"
    },
    {
      "t": "01:59",
      "text": "మీరు ఎవరైనా పరిచయం"
    },
    {
      "t": "02:06",
      "text": "మా ఇద్దరం నచ్చుకున్నాం"
    },
    {
      "t": "02:13",
      "text": "ఓపెన్గానే యూజ్ చేస్తున్నాను ఇంట్రెస్ట్ ఉందా మరేమన్నా"
    },
    {
      "t": "02:20",
      "text": "ఉన్నావ్"
    },
    {
      "t": "02:27",
      "text": "ఇంస్టాగ్రామ్ నెంబర్ ఏమన్నా ఇస్తావా మరి"
    },
    {
      "t": "02:34",
      "text": "ఎందుకు ఎందుకు"
    },
    {
      "t": "02:41",
      "text": "వై హలో"
    },
    {
      "t": "02:48",
